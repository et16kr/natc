 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
# 테스트 케이스를 실행하는 디렉토리에 test 디렉토리를 만들고 isql 실행파일을 
# 복사해야 한다.

--+RSYSTEM target1 mkdir abc;
>>> [target1] BEGIN <<<
mkdir abc - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 put test/isql abc;
>>> [target1] BEGIN <<<
put test/isql abc - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 copy abc/isql abc/isql2;
>>> [target1] BEGIN <<<
copy abc/isql abc/isql2 - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 delete abc/isql;
>>> [target1] BEGIN <<<
delete abc/isql - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 get abc/isql2;
>>> [target1] BEGIN <<<
get abc/isql2 - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 delete abc/isql2;
>>> [target1] BEGIN <<<
delete abc/isql2 - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 rmdir abc;
>>> [target1] BEGIN <<<
rmdir abc - SUCCESS
>>> [target1] END <<<

--+RSYSTEM target1 execute /server args start return stdout;
>>> [target1] BEGIN <<<

