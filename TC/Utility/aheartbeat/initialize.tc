include stdFunc.i;

DECLARE SERVER HBP_SERVER1 DB1;
DECLARE SERVER HBP_SERVER2 DB2;
DECLARE SERVER HBP_SERVER3 DB3;

DECLARE CLIENT DEFAULT C1 ( SERVER = DB1 );
DECLARE CLIENT DEFAULT C2 ( SERVER = DB2 );
DECLARE CLIENT DEFAULT C3 ( SERVER = DB3 );	

DEF MAIN ( )
{
    $ALTIBASE_HOME_C0 = "${ALTIBASE_HOME}";

    $ALTI_HBP_HOME_C0 = "${ALTI_HBP_HOME}";

    $ALTIDEV_HOME;

    THREAD T1 C1
    {
        RM -f "db1/bin";
        RM -f "db1/msg";
        RM -f "db1/aheartbeat_home/msg";
        RM -rf "db1";

        MKDIR "db1";
        MKDIR "db1/conf";
        MKDIR "db1/dbs";
        MKDIR "db1/logs";
        MKDIR "db1/trc";
        MKDIR "db1/arch_logs";

        MKDIR "db1/aheartbeat_home";
        MKDIR "db1/aheartbeat_home/bin";
        MKDIR "db1/aheartbeat_home/conf";
        MKDIR "db1/aheartbeat_home/log";

        LN -s "${ALTIBASE_HOME_C0}/bin" "db1/bin";
        LN -s "${ALTIBASE_HOME_C0}/msg" "db1/msg";
        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db1/conf";
        CP -r "${ALTIBASE_HOME_C0}/conf/license" "db1/conf";

        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/aheartbeat" "db1/aheartbeat_home/bin";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/altibaseFailureEvent.sh" "db1/aheartbeat_home/bin";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/remoteNodeFailureEvent.sh" "db1/aheartbeat_home/bin";
        LN -s "${ALTIDEV_HOME}/ut/aheartbeat/src/msg" "db1/aheartbeat_home/msg";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/conf/.altibaseConnection.info" "db1/aheartbeat_home/conf"; 
        NODISPLAY ON; 
        CALL stdServerKill();
        CALL stdClean();

        CALL stdServerStart();
        NODISPLAY OFF;
        
    }
    THREAD T2 C2
    {
        RM -f "db2/bin";
        RM -f "db2/msg";
        RM -f "db2/aheartbeat_home/msg";
        RM -rf "db2";

        MKDIR "db2";
        MKDIR "db2/conf";
        MKDIR "db2/dbs";
        MKDIR "db2/logs";
        MKDIR "db2/trc";
        MKDIR "db2/arch_logs";
        
        MKDIR "db2/aheartbeat_home";
        MKDIR "db2/aheartbeat_home/bin";
        MKDIR "db2/aheartbeat_home/conf";
        MKDIR "db2/aheartbeat_home/log";

        LN -s "${ALTIBASE_HOME_C0}/bin" "db2/bin";
        LN -s "${ALTIBASE_HOME_C0}/msg" "db2/msg";
        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db2/conf";
        CP -r "${ALTIBASE_HOME_C0}/conf/license" "db2/conf";

        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/aheartbeat" "db2/aheartbeat_home/bin";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/altibaseFailureEvent.sh" "db2/aheartbeat_home/bin";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/remoteNodeFailureEvent.sh" "db2/aheartbeat_home/bin";
        LN -s "${ALTIDEV_HOME}/ut/aheartbeat/src/msg" "db2/aheartbeat_home/msg";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/conf/.altibaseConnection.info" "db2/aheartbeat_home/conf"; 
        NODISPLAY ON; 
        CALL stdServerKill();
        CALL stdClean();

        CALL stdServerStart();
        NODISPLAY OFF;
        
    }
    THREAD T3 C3
    {
        RM -f "db3/bin";
        RM -f "db3/msg";
        RM -f "db3/aheartbeat_home/msg";
        RM -rf "db3";

        MKDIR "db3";
        MKDIR "db3/conf";
        MKDIR "db3/dbs";
        MKDIR "db3/logs";
        MKDIR "db3/trc";
        MKDIR "db3/arch_logs";
        
        MKDIR "db3/aheartbeat_home";
        MKDIR "db3/aheartbeat_home/bin";
        MKDIR "db3/aheartbeat_home/conf";
        MKDIR "db3/aheartbeat_home/log";

        LN -s "${ALTIBASE_HOME_C0}/bin" "db3/bin";
        LN -s "${ALTIBASE_HOME_C0}/msg" "db3/msg";
        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db3/conf";
        CP -r "${ALTIBASE_HOME_C0}/conf/license" "db3/conf";

        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/aheartbeat" "db3/aheartbeat_home/bin";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/altibaseFailureEvent.sh" "db3/aheartbeat_home/bin";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/bin/remoteNodeFailureEvent.sh" "db3/aheartbeat_home/bin";
        LN -s "${ALTIDEV_HOME}/ut/aheartbeat/src/msg" "db3/aheartbeat_home/msg";
        CP -r "${ALTIDEV_HOME}/ut/aheartbeat/src/conf/.altibaseConnection.info" "db3/aheartbeat_home/conf"; 
        NODISPLAY ON; 
        CALL stdServerKill();
        CALL stdClean();

        CALL stdServerStart();
        NODISPLAY OFF;
        
    }
    JOIN;

    THREAD T1 C1
    {
        NODISPLAY ON;
        PRINT "ALTI_HBP_HOME = ${ALTI_HBP_HOME}";
        PRINT "ALTI_HBP_ALTIBASE_PORT_NO = ${ALTI_HBP_ALTIBASE_PORT_NO}";
        PRINT "ALTI_HBP_ID = ${ALTI_HBP_ID}";
        PRINT "ALTI_HBP_DETECT_INTERVAL = ${ALTI_HBP_DETECT_INTERVAL}";
        PRINT "ALTI_HBP_DETECT_HIGHWATER_MARK = ${ALTI_HBP_DETECT_HIGHWATER_MARK}";
        
        EXEC   HBP_STOP1 "${ALTI_HBP_HOME}/bin/aheartbeat -s";
        P_WAIT HBP_STOP1 -o $sResult1;
        NODISPLAY OFF;

        SLEEP 1;

        CP -r "aheartbeat.settings" "${ALTI_HBP_HOME}/conf/";

        EXEC   HBP_START1  "${ALTI_HBP_HOME}/bin/aheartbeat -r";
        P_WAIT HBP_START1 -o $sResult1;
        PRINT $sResult1;

        SLEEP 1;
    }
    THREAD T2 C2
    {
        NODISPLAY ON;
        PRINT "ALTI_HBP_HOME = ${ALTI_HBP_HOME}";
        PRINT "ALTI_HBP_ALTIBASE_PORT_NO = ${ALTI_HBP_ALTIBASE_PORT_NO}";
        PRINT "ALTI_HBP_ID = ${ALTI_HBP_ID}";
        PRINT "ALTI_HBP_DETECT_INTERVAL = ${ALTI_HBP_DETECT_INTERVAL}";
        PRINT "ALTI_HBP_DETECT_HIGHWATER_MARK = ${ALTI_HBP_DETECT_HIGHWATER_MARK}";
        
        EXEC   HBP_STOP2 "${ALTI_HBP_HOME}/bin/aheartbeat --stop";
        P_WAIT HBP_STOP2 -o $sResult2;
        NODISPLAY OFF;

        SLEEP 1;

        CP -r "aheartbeat.settings" "${ALTI_HBP_HOME}/conf/";

        EXEC   HBP_START2  "${ALTI_HBP_HOME}/bin/aheartbeat --run";
        P_WAIT HBP_START2 -o $sResult2;
        PRINT $sResult2;

        SLEEP 1;
    }
    THREAD T3 C3
    {
        NODISPLAY ON;
        PRINT "ALTI_HBP_HOME = ${ALTI_HBP_HOME}";
        PRINT "ALTI_HBP_ALTIBASE_PORT_NO = ${ALTI_HBP_ALTIBASE_PORT_NO}";
        PRINT "ALTI_HBP_ID = ${ALTI_HBP_ID}";
        PRINT "ALTI_HBP_DETECT_INTERVAL = ${ALTI_HBP_DETECT_INTERVAL}";
        PRINT "ALTI_HBP_DETECT_HIGHWATER_MARK = ${ALTI_HBP_DETECT_HIGHWATER_MARK}";
        
        EXEC   HBP_STOP3 "${ALTI_HBP_HOME}/bin/aheartbeat -s";
        P_WAIT HBP_STOP3 -o $sResult3;
        NODISPLAY OFF;

        SLEEP 1;

        CP -r "aheartbeat.settings" "${ALTI_HBP_HOME}/conf/";

        EXEC   HBP_START3  "${ALTI_HBP_HOME}/bin/aheartbeat -r";
        P_WAIT HBP_START3 -o $sResult3;
        PRINT $sResult3;
        SLEEP 1;
    }
    JOIN;
}


