include stdFunc.i;
INCLUDE stdFit.i

DEF MAIN()
{

fitclient reset;

SKIP BEGIN;
DROP TABLESPACE VOLTBS INCLUDING CONTENTS AND DATAFILES;
DROP PUBLIC SYNONYM DBMS_CONCURRENT_EXEC;
REVOKE EXECUTE ON SYS.DBMS_CONCURRENT_EXEC FROM PUBLIC;
DROP PACKAGE DBMS_CONCURRENT_EXEC;
SKIP END;
CREATE VOLATILE DATA TABLESPACE VOLTBS SIZE 100M AUTOEXTEND ON;

exec p1 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIDEV_HOME}/altibase_home/packages/dbms_concurrent_exec.sql";
p_wait p1;
print $Ret_;

exec p1 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIDEV_HOME}/altibase_home/packages/dbms_concurrent_exec.plb";
p_wait p1;
print $Ret_;

NODISPLAY ON;
CALL stdServerKill();
NODISPLAY OFF;

SET_ENV ALTIBASE_CONCURRENT_EXEC_DEGREE_MAX = 10;
SET_ENV_ALTIBASE_CONCURRENT_EXEC_DEGREE_DEFAULT = 4;
SET_ENV ALTIBASE_JOB_THREAD_COUNT = 1;
SET_ENV ALTIBASE_FETCH_TIMEOUT = 0;
SET_ENV ALTIBASE_QUERY_TIMEOUT = 0;
SET_ENV ALTIBASE_UTRANS_TIMEOUT = 0;

NODISPLAY ON;
CALL stdServerStart();
NODISPLAY OFF;
}
