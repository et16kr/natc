 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ############################################################################
$T0> # PROJ-2375 Global Meta
$T0> ############################################################################

$T0> # cluster.conf에 있는 서버를 cluster로 묶어서 등록. Test Case 내에서는 DB1, DB2로 사용.
$T0> REGISTER CLUSTER CL1 ( DDLServer as DB1, NonDDLServer as DB2 );

$T0> THREAD T1 DB1
$T0> THREAD T2 DB2

$T0> JOIN;

$T0> # stdFunc_cluster.i에 있는 함수는 cluster에 있는 모든 서버에 대해서 실행됩니다.
$T0> # 따라서 아래 처럼 한번만 호출하면 DB1, DB2 모두 서버가 시작됩니다.

