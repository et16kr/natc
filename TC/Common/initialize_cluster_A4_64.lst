 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ############################################################################
$T0> # PROJ-2375 Global Meta
$T0> ############################################################################

$T0> # cluster.conf에 있는 서버를 cluster로 묶어서 등록. Test Case 내에서는 DB1, DB2로 사용.
$T0> REGISTER CLUSTER CL1 ( DDLServer as DB1, NonDDLServer as DB2 );

$T0> THREAD T1 DB1
$T0> THREAD T2 DB2

$T0> JOIN;

$T0> THREAD T1 DB1

$T0> THREAD T2 DB2

$T0> JOIN;

$T0> OPEN F1 -m w "db1/conf/altibase.sproperties";
$T0> WRITE F1 "altibase1.INSTANCE_NUMBER=1\n";
$T0> WRITE F1 "altibase1.CLUSTER_IP=127.0.0.1\n";
$T0> WRITE F1 "altibase1.CLUSTER_PORT_NO=${ALTIBASE_CLUSTER_DDL_PORT_NO}\n";
$T0> WRITE F1 "altibase2.INSTANCE_NUMBER=2\n";
$T0> WRITE F1 "altibase2.CLUSTER_IP=127.0.0.1\n";
$T0> WRITE F1 "altibase2.CLUSTER_PORT_NO=${ALTIBASE_CLUSTER_DML_PORT_NO}\n";
$T0> CLOSE F1;

$T0> CP "db1/conf/altibase.sproperties" "db2/conf/altibase.sproperties";

$T0> # stdFunc_cluster.i에 있는 함수는 cluster에 있는 모든 서버에 대해서 실행됩니다.
$T0> # 따라서 아래 처럼 한번만 호출하면 DB1, DB2 모두 서버가 시작됩니다.
$T1> RM -rf "db1";

$T1> MKDIR "db1";
$T1> MKDIR "db1/conf";
$T1> MKDIR "db1/dbs";
$T1> MKDIR "db1/logs";
$T1> MKDIR "db1/trc";
$T1> MKDIR "db1/arch_logs";

$T1> CP -r "${ALTIBASE_HOME@DB0}/bin"                        "db1/bin";
$T1> CP -r "${ALTIBASE_HOME@DB0}/msg"                        "db1/msg";
$T1> CP -r "${ALTIBASE_HOME@DB0}/conf/altibase.properties"   "db1/conf/altibase.properties";
$T1> CP -r "${ALTIBASE_HOME@DB0}/conf/license"               "db1/conf/license";
$T1> CP -r "${ALTIBASE_HOME@DB0}/lib"                        "db1/lib";
$T1> CP -r "${ALTIBASE_HOME@DB0}/install"                    "db1/install";
$T1> CP -r "${ALTIBASE_HOME@DB0}/include"                    "db1/include";
$T2> RM -rf "db2";

$T2> MKDIR "db2";
$T2> MKDIR "db2/conf";
$T2> MKDIR "db2/dbs";
$T2> MKDIR "db2/logs";
$T2> MKDIR "db2/trc";
$T2> MKDIR "db2/arch_logs";

$T2> CP -r "${ALTIBASE_HOME@DB0}/bin"                        "db2/bin";
$T2> CP -r "${ALTIBASE_HOME@DB0}/msg"                        "db2/msg";
$T2> CP -r "${ALTIBASE_HOME@DB0}/conf/altibase.properties"   "db2/conf/altibase.properties";
$T2> CP -r "${ALTIBASE_HOME@DB0}/conf/license"               "db2/conf/license";
$T2> CP -r "${ALTIBASE_HOME@DB0}/lib"                        "db2/lib";
$T2> CP -r "${ALTIBASE_HOME@DB0}/install"                    "db2/install";
$T2> CP -r "${ALTIBASE_HOME@DB0}/include"                    "db2/include";

