############################################################################
# PROJ-2375 Global Meta
############################################################################

include stdFunc_cluster.i;

DEF MAIN()
{
    THREAD T1 DB1
    {
        # CONNECT SYS/MANAGER AS SYSDBA;
        # ALTER SYSTEM DISCONNECT CLUSTER;
        # DISCONNECT;
    }

    JOIN;

    THREAD T2 DB2
    {
        # CONNECT SYS/MANAGER AS SYSDBA;
        # ALTER SYSTEM DISCONNECT CLUSTER;
        # DISCONNECT;
    }

    JOIN;

    # stdFunc_cluster.i에 있는 함수는 cluster에 있는 모든 서버에 대해서 실행됩니다.
    # 따라서 아래 처럼 한번만 호출하면 DB1, DB2 모두 서버가 종료됩니다.
    NODISPLAY ON;
    CALL stdServerKill();
    NODISPLAY OFF;

    RM -rf "db1";
    RM -rf "db2";
    RM "*.log";

    UNREGISTER CLUSTER;
}
