def main()
{
    skip begin;
    drop package variables;
    skip end;

    create or replace package variables as
    v1N decimal;
    v1Y decimal;
    v2 decimal(38);
    v3 decimal(38 , 10);
    v4 decimal(18);
    v5 decimal(18 , 5);

    procedure initializeVariables;
    procedure showvariables;
    end;
    /

    create or replace package body variables as

    procedure initializeVariables as
    begin
    v1N := NULL;
    v1Y := NULL;
    v2 := NULL;
    v3 := NULL;
    v4 := NULL;
    v5 := NULL;
    end;

    procedure showvariables as
    begin
    println( 'v1N decimal : ' || v1N );
    println( 'v1Y decimal : ' || v1Y );
    println( 'v2 decimal(38) : ' || v2 );
    println( 'v3 decimal(38 , 10) : ' || v3 );
    println( 'v4 decimal(18) : ' || v4 );
    println( 'v5 decimal(18 , 5) : ' || v5 );
    end;

    end;
    /

    exec variables.showvariables;
}
