def main() 
{
    skip begin;
    drop procedure proc1;
    drop table t1;
    drop package variables;
    skip end;

    # basic test
    create or replace procedure proc1 as
    var1 number;
    var2 number(38);
    var3 number(38 , 10);
    var4 number(18);
    var5 number(18 , 5);
    begin

    println( 'floating poins is not exist.' );
    var1 := 12345678901;
    var2 := 12345678902;
    var3 := 12345678903;
    var4 := 12345678904;
    var5 := 12345678905;
    println( 'var1 : ' || var1 );
    println( 'var2 : ' || var2 );
    println( 'var3 : ' || var3 );
    println( 'var4 : ' || var4 );
    println( 'var5 : ' || var5 );

    println( ' ' );

    println( 'floating poins is exist.' );
    var1 := 123456.78901;
    var2 := 123456.78902;
    var3 := 123456.78903;
    var4 := 123456.78904;
    var5 := 123456.78905;
    println( 'var1 : ' || var1 );
    println( 'var2 : ' || var2 );
    println( 'var3 : ' || var3 );
    println( 'var4 : ' || var4 );
    println( 'var5 : ' || var5 );
    end;
    /

    exec proc1;

    create table t1( c1 number , c2 number(38) , c3 number(38 , 10) , c4 number(18) , c5 number(18 , 5) );

    create or replace package variables as
    type rec1 is record( c1 number , c2 number(38) , c3 number(38 , 10) , c4 number(18) , c5 number(18 , 5) );
    var1 rec1;
    var2 var1%type;
    var3 t1%rowtype;
    var4 number := 1234560789;
    var5 number(38) := 1234561789;
    var6 number(38 , 10) := 123456.2789;
    var7 number(18) :=  1234563789;
    var8 number(18 , 5) := 123456.4789;

    var_char char(30);
    var_varchar varchar(30);
    var_nchar nchar(30);
    var_nvarchar nvarchar(30);
    var_numeric numeric(18 , 5);
    var_decimal decimal(18 , 5);
    var_float float;
    var_number number(18 , 5);
    var_double double;
    var_real real;
    var_bigint bigint;
    var_integer integer;
    var_smallint smallint;
    var_date date;
    var_byte byte(10);
    var_varbyte varbyte(10);
    var_binary binary(30);
    var_nibble nibble(30);
    var_bit bit(30);
    var_varbit varbit(30);
    var_boolean boolean;

    procedure initializeVar1_pointN;
    procedure initializeVar1_pointY;
    procedure initializeVar2_pointN;
    procedure initializeVar2_pointY;
    procedure initializeVar3_pointN;
    procedure initializeVar3_pointY;
    procedure initializeForINAndINOUT;
    procedure showvariables;
    end;
    /

    create or replace package body variables as

    procedure initializeVar1_pointN as
    begin
    var1.c1 := 12345678901;
    var1.c2 := 12345678902;
    var1.c3 := 12345678903;
    var1.c4 := 12345678904;
    var1.c5 := 12345678905;

    println( 'var1.c1 : ' || var1.c1 );
    println( 'var1.c2 : ' || var1.c2 );
    println( 'var1.c3 : ' || var1.c3 );
    println( 'var1.c4 : ' || var1.c4 );
    println( 'var1.c5 : ' || var1.c5 );
    end;

    procedure initializeVar1_pointY as
    begin
    var1.c1 := 123456.78901;
    var1.c2 := 123456.78902;
    var1.c3 := 123456.78903;
    var1.c4 := 123456.78904;
    var1.c5 := 123456.78905;

    println( 'var1.c1 : ' || var1.c1 );
    println( 'var1.c2 : ' || var1.c2 );
    println( 'var1.c3 : ' || var1.c3 );
    println( 'var1.c4 : ' || var1.c4 );
    println( 'var1.c5 : ' || var1.c5 );
    end;

    procedure initializeVar2_pointN as
    begin
    var2.c1 := 12345678901;
    var2.c2 := 12345678902;
    var2.c3 := 12345678903;
    var2.c4 := 12345678904;
    var2.c5 := 12345678905;

    println( 'var2.c1 : ' || var2.c1 );
    println( 'var2.c2 : ' || var2.c2 );
    println( 'var2.c3 : ' || var2.c3 );
    println( 'var2.c4 : ' || var2.c4 );
    println( 'var2.c5 : ' || var2.c5 );
    end;

    procedure initializeVar2_pointY as
    begin
    var2.c1 := 123456.78901;
    var2.c2 := 123456.78902;
    var2.c3 := 123456.78903;
    var2.c4 := 123456.78904;
    var2.c5 := 123456.78905;

    println( 'var2.c1 : ' || var2.c1 );
    println( 'var2.c2 : ' || var2.c2 );
    println( 'var2.c3 : ' || var2.c3 );
    println( 'var2.c4 : ' || var2.c4 );
    println( 'var2.c5 : ' || var2.c5 );
    end;

    procedure initializeVar3_pointN as
    begin
    var3.c1 := 12345678901;
    var3.c2 := 12345678902;
    var3.c3 := 12345678903;
    var3.c4 := 12345678904;
    var3.c5 := 12345678905;

    println( 'var3.c1 : ' || var3.c1 );
    println( 'var3.c2 : ' || var3.c2 );
    println( 'var3.c3 : ' || var3.c3 );
    println( 'var3.c4 : ' || var3.c4 );
    println( 'var3.c5 : ' || var3.c5 );
    end;

    procedure initializeVar3_pointY as
    begin
    var3.c1 := 123456.78901;
    var3.c2 := 123456.78902;
    var3.c3 := 123456.78903;
    var3.c4 := 123456.78904;
    var3.c5 := 123456.78905;

    println( 'var3.c1 : ' || var3.c1 );
    println( 'var3.c2 : ' || var3.c2 );
    println( 'var3.c3 : ' || var3.c3 );
    println( 'var3.c4 : ' || var3.c4 );
    println( 'var3.c5 : ' || var3.c5 );
    end;

    procedure initializeForINAndINOUT as
    begin
    var_char := char'MATTHEW FINNEN DOYLE';
    var_varchar := varchar'CHRISTOPER PAUL COLFER';
    var_nchar := nchar'JEON SEONG WOO';
    var_nvarchar := nvarchar'LEE JAE KYOON';
    var_numeric := numeric'123.456';
    var_decimal := decimal'234.567';
    var_float := float'345.678';
    var_number := number'456.789';
    var_double := double'567891';
    var_real := real'678912';
    var_bigint := bigint'789123';
    var_integer := integer'100';
    var_smallint := smallint'10';
    var_date := date'01-FEB-1987';
    var_byte := byte'536f6e67';
    var_varbyte := varbyte'536f6e67';
    var_binary := binary'100001110000001000000001';
    var_nibble := nibble'536f6e67'; 
    var_bit := bit'0001100110010011';
    var_varbit := varbit'100100110000011000010100';
    var_boolean := boolean'TRUE';
    showvariables;
    end;

    procedure showvariables as
    begin
    println( 'var_char : ' || var_char );
    println( 'var_varchar : ' || var_varchar );
    println( 'var_nchar : ' || var_nchar );
    println( 'var_nvarchar : ' || var_nvarchar );
    println( 'var_numeric : ' || var_numeric );
    println( 'var_decimal : ' || var_decimal );
    println( 'var_float : ' || var_float );
    println( 'var_number : ' || var_number );
    println( 'var_double : ' || var_double );
    println( 'var_real : ' || var_real );
    println( 'var_bigint : ' || var_bigint );
    println( 'var_integer : ' || var_integer);
    println( 'var_smallint : ' || var_smallint);
    println( 'var_date : ' || var_date );
    println( 'var_byte : ' || var_byte );
    println( 'var_varbyte : ' || var_varbyte );
    println( 'var_nibble : ' || var_nibble ); 
    println( 'var_bit : ' || var_bit );
    println( 'var_varbit : ' || var_varbit );
    end;

    end;
    /

    drop procedure proc1;
}
