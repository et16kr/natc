    /

    create or replace function returnParam( p1 in number ) return number as
    begin
    return p1;
    end;
    /

    create or replace function returnFunc(p1 in number ) return number as
    begin
    return returnParam( p1 );
    end;
    /

    create or replace package functions as
    function sub_returnParam( p1 in number ) return number;
    function sub_returnFunc1(p1 in number ) return number;
    function sub_returnFunc2(p1 in number ) return number;
    end;
    /

    create or replace package body functions as

    function sub_returnParam( p1 in number ) return number as
    begin
    return p1;
    end;

    function sub_returnFunc1(p1 in number ) return number as
    begin
    return sub_returnParam( p1 );
    end;

    function sub_returnFunc2(p1 in number ) return number as
