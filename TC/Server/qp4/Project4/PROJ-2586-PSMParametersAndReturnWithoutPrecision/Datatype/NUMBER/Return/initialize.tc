def main()
{
    skip begin;
    drop table t1;
    drop package variables;
    drop function returnNumberDefaultN;
    drop function returnNumberDefaultY;
    drop function returnNumber_38;
    drop function returnNumber_38_10;
    drop function returnNumber_18;
    drop function returnNumber_18_5;
    drop function returnParam;
    drop function returnFunc;
    drop package functions;
    skip end;

    create table t1( c1 number , c2 number(38) , c3 number(38 , 10) , c4 number(18) , c5 number(18 , 5) );
    insert into t1 values ( 90052395511 , 90052395512 , 90052395513 , 90052395514 , 90052395515 );
    insert into t1 values ( 900523.95521 , 900523.95522 , 900523.95523 , 900523.95524 , 900523.95525 );
    insert into t1 values ( 90052395531 , 90052395532 , 900523.95533 , 90052395534 , 900523.95535 );
    insert into t1 values ( 900523.95541 , 90052395542 , 900523.95543 , 90052395544 , 900523.95545 );

    create or replace package variables as
    v1N number;
    v1Y number;
    v2 number(38);
    v3 number(38 , 10);
    v4 number(18);
    v5 number(18 , 5);

    revVar1 number;
    revVar2 number(38);
    revVar3 number(38 , 10);
    revVar4 number(18);
    revVar5 number(18 , 5);

    procedure initializeVariables;
    procedure showVariables;
    end;
    /

    create or replace package body variables as

    procedure initializeVariables as
    begin
    v1N := 1512086381;
    v1Y := 151208.6381;
    v2 := 1512086382;
    v3 := 151208.6382;
    v4 := 1512086383;
    v5 := 151208.6383;

    revVar1 := NULL;
    revVar2 := NULL;
    revVar3 := NULL;
    revVar4 := NULL;
    revVar5 := NULL;
    end;

    procedure showVariables as
    begin
    println( 'v1N number : ' || v1N );
    println( 'v1Y number : ' || v1Y );
    println( 'v2 number(38) : ' || v2 );
    println( 'v3 number(38 , 10) : ' || v3 );
    println( 'v4 number(18) : ' || v4 );
    println( 'v5 number(18 , 5) : ' || v5 );

