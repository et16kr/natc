def main()
{
    skip begin;
    drop table t1;
    drop package variables;
    drop function returnFloatDefaultN;
    drop function returnFloatDefaultY;
    drop function returnFloat_38N;
    drop function returnFloat_38Y;
    drop function returnFloat_18N;
    drop function returnFloat_18Y;
    drop function returnParam;
    drop function returnFunc;
    drop package functions;
    skip end;

    create table t1( c1 float , c2 float(38) , c3 float(38) , c4 float(18) , c5 float(18) );
    insert into t1 values ( 90052395511 , 90052395512 , 90052395513 , 90052395514 , 90052395515 );
    insert into t1 values ( 900523.95521 , 900523.95522 , 900523.95523 , 900523.95524 , 900523.95525 );
    insert into t1 values ( 90052395531 , 90052395532 , 900523.95533 , 90052395534 , 900523.95535 );
    insert into t1 values ( 900523.95541 , 90052395542 , 900523.95543 , 90052395544 , 900523.95545 );

    create or replace package variables as
    v0 float;
    v1 float;
    v2 float(38);
    v3 float(38);
    v4 float(18);
    v5 float(18);

    revVar1 float;
    revVar2 float(38);
    revVar3 float(38);
    revVar4 float(18);
    revVar5 float(18);

    procedure initializeVariables;
    procedure showVariables;
    end;
    /

    create or replace package body variables as

    procedure initializeVariables as
    begin
    v0 := 1512086381;
    v1 := 151208.6381;
    v2 := 1512086382;
    v3 := 151208.6382;
    v4 := 1512086383;
    v5 := 151208.6383;

    revVar1 := NULL;
    revVar2 := NULL;
    revVar3 := NULL;
    revVar4 := NULL;
    revVar5 := NULL;
    end;

    procedure showVariables as
    begin
    println( 'v0 float : ' || v0 );
    println( 'v1 float : ' || v1 );
    println( 'v2 float(38) : ' || v2 );
    println( 'v3 float(38) : ' || v3 );
    println( 'v4 float(18) : ' || v4 );
    println( 'v5 float(18) : ' || v5 );

    println( 'revVar1 float : ' || revVar1 );
    println( 'revVar2 float(38) : ' || revVar2 );
    println( 'revVar3 float(38) : ' || revVar3 );
    println( 'revVar4 float(18) : ' || revVar4 );
    println( 'revVar5 float(18) : ' || revVar5 );
    end;

    end;
    /

    create or replace function returnFloatDefaultN return float as
    begin
    return variables.v0;
    end;
    /
    create or replace function returnFloatDefaultY return float as
    begin
    return variables.v1;
    end;
    /

    create or replace function returnFloat_38N return float as
    begin
    return variables.v2;
    end;
    /

    create or replace function returnFloat_38Y return float as
    begin
    return variables.v3;
    end;
    /

    create or replace function returnFloat_18N return float as
    begin
    return variables.v4;
    end;
    /

    create or replace function returnFloat_18Y return float as
    begin
    return variables.v5;
    end;
    /

    create or replace function returnParam( p1 in float ) return float as
    begin
    return p1;
    end;
    /

    create or replace function returnFunc(p1 in float ) return float as
    begin
    return returnParam( p1 );
    end;
    /

    create or replace package functions as
    function sub_returnParam( p1 in float ) return float;
    function sub_returnFunc1(p1 in float ) return float;
    function sub_returnFunc2(p1 in float ) return float;
    end;
    /

    create or replace package body functions as

    function sub_returnParam( p1 in float ) return float as
    begin
    return p1;
    end;

    function sub_returnFunc1(p1 in float ) return float as
    begin
    return sub_returnParam( p1 );
    end;

    function sub_returnFunc2(p1 in float ) return float as
    begin
    return returnParam( p1 );
    end;

    end;
    /
} 
