################################################################################
################################################################################

INCLUDE stdFunc.i;
DEF MAIN()
{
NODISPLAY ON;
CALL stdServerStop();
NODISPLAY OFF;

NODISPLAY ON;
CALL stdClean();
NODISPLAY OFF;

NODISPLAY ON;
CALL stdServerStart();
NODISPLAY OFF;

alter system set executor_fast_simple_query = 2;
}
