 SEMI-JOIN INVERSE ( METHOD: HASH, COST: BLOCKED )
  SCAN ( TABLE: SYS.T3 $$1_$$VIEW1_$T3, FULL SCAN, ACCESS: 3, COST: BLOCKED )
  HASH ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 4, DISK_PAGE_COUNT: BLOCKED, ACCESS: 6, COST: BLOCKED )
   [ FILTER ]
   AND
    I3 = $$1_$$VIEW1_$T3.I3
