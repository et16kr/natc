$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop table t3;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

$T0> set linesize 200;

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1(i1 integer, i2 integer, i3 integer)
partition by range(i3)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values (1, 1, 1);
1 row inserted.
$T0> insert into t1 values (2, 2, 1);
1 row inserted.
$T0> insert into t1 values (3, 3, 3);
1 row inserted.
$T0> insert into t1 values (4, 4, 3);
1 row inserted.

$T0> create index t1_idx1 on t1(i1);
Create success.

$T0> create table t2(i1 integer, i2 integer, i3 integer, i4 integer)
partition by range(i4)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 values (1, 1, 1, 1);
1 row inserted.
$T0> insert into t2 values (2, 2, 2, 2);
1 row inserted.
$T0> insert into t2 values (3, 3, 3, 3);
1 row inserted.
$T0> insert into t2 values (4, 4, 4, 4);
1 row inserted.

$T0> create index t2_idx1 on t2(i3,i1,i2);
Create success.

$T0> create table t3(i1 integer, i2 integer, i3 integer);
Create success.

$T0> insert into t3 values (1, 1, 1);
1 row inserted.
$T0> insert into t3 values (2, 2, 2);
1 row inserted.
$T0> insert into t3 values (3, 3, 3);
1 row inserted.

$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; SUBQUERY KEY RANGE
$T0> ##################################

$T0> select * from t1 where i1 in (select i1 from t3);
T1.I1       T1.I2       T1.I3       
----------------------------------------
1           1           1           
2           2           1           
3           3           3           
3 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 3, TUPLE_SIZE: 12, COST: BLOCKED )
 SEMI-JOIN INVERSE ( METHOD: HASH, COST: BLOCKED )
  SCAN ( TABLE: SYS.T3 $$1_$$VIEW1_$T3, FULL SCAN, ACCESS: 3, COST: BLOCKED )
  HASH ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 4, DISK_PAGE_COUNT: BLOCKED, ACCESS: 6, COST: BLOCKED )
   [ FILTER ]
   I1 = $$1_$$VIEW1_$T3.I1
   PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, FULL SCAN, ACCESS: 4, COST: BLOCKED )
    SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
    SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> select * from t2 where (i1, i2, i3) in (select i1, i2, i3 from t3);
