$T0> create index t1_idx2 on t1(i2);
Create success.
$T0> create index t1_idx3 on t1(i3, i4 desc);
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       VARCHAR(10)                 
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_IDX2                                  BTREE                  I2 ASC
T1_IDX3                                  BTREE                  I3 ASC,
                                                                I4 DESC
T1 has no primary key

$T0> create table t2
( 
  i1 integer,
  i2 clob, 
  i3 geometry
)
partition by range(i1)
(
  partition p1 values less than (5),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 values ( 1, 'a', geometry'polygon((0 0, 1 0, 1 1, 0 1))' );
1 row inserted.
$T0> insert into t2 values ( 2, 'b', geometry'polygon((1 1, 2 1, 2 2, 1 2))' );
