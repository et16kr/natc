###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;
alter system set trclog_explain_graph = 0;

SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

set linesize 200;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer
)
partition by range(i1)
(
  partition p1 values less than (5),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t1 values ( 1, 1, 1 );
insert into t1 values ( 2, 2, 2 );
insert into t1 values ( 3, 3, 3 );
insert into t1 values ( 4, 4, 4 );
insert into t1 values ( 5, 5, 5 );
insert into t1 values ( 6, 6, 6 );
insert into t1 values ( 7, 7, 7 );
insert into t1 values ( 8, 8, 8 );
insert into t1 values ( 9, 9, 9 );
insert into t1 values ( 10, 10, 10 );

create index t1_idx2 on t1(i2);
create index t1_idx3 on t1(i3) local;

create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer
)
partition by range(i1)
(
  partition p1 values less than (5),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t2 values ( 1, 1, 1 );
insert into t2 values ( 2, 2, 2 );
insert into t2 values ( 3, 3, 3 );
insert into t2 values ( 4, 4, 4 );
insert into t2 values ( 5, 5, 5 );
insert into t2 values ( 6, 6, 6 );
insert into t2 values ( 7, 7, 7 );
insert into t2 values ( 8, 8, 8 );
insert into t2 values ( 9, 9, 9 );
insert into t2 values ( 10, 10, 10 );

desc t1;
desc t2;

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

##################################
# SECTOR; CONSTANT FILTER
##################################

select * from t1, t2 where t1.i2=t2.i2 and 1=1;
select * from t1, t2 where t1.i3=t2.i3 and 1=1;

select * from t1, t2 where t1.i2=t2.i2 and 1=0;
select * from t1, t2 where t1.i3=t2.i3 and 1=0;

##################################
# SECTOR; CONSTANT FILTER
##################################

var v1 integer;
exec :v1 := 1;

prepare select * from t1, t2 where t1.i2=t2.i2 and :v1 =1;
prepare select * from t1, t2 where t1.i3=t2.i3 and :v1 =1;

prepare select * from t1, t2 where t1.i2=t2.i2 and :v1 =0;
prepare select * from t1, t2 where t1.i3=t2.i3 and :v1 =0;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
