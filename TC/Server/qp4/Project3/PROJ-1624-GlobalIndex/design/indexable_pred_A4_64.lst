$T0> select * from t1 where i2 in (select level from dual connect by level <= 5);
T1.I1       T1.I2       T1.I3       T1.I4       
-----------------------------------------------------
1           1           abc         1           
2           2           abc         2           
3           3           abc         3           
4           4           bcd         1           
5           5           bcd         2           
5 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 24, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, FULL SCAN, ACCESS: 20, COST: BLOCKED )
  [ SUBQUERY FILTER ]
  EXISTS (SELECT '0' FROM DUAL WHERE T1.I2 = LEVEL CONNECT BY LEVEL <= 5)
  ::SUB-QUERY BEGIN
  PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 3, COST: BLOCKED )
   FILTER
    [ FILTER ]
    T1.I2 = LEVEL
    CONNECT BY ( ACCESS: 94, COST: BLOCKED )
     [ LEVEL FILTER ]
     LEVEL <= 5
     SCAN ( TABLE: DUAL, FULL SCAN, ACCESS: 94, COST: BLOCKED )
  ::SUB-QUERY END
  SCAN ( PARTITION: PD, FULL SCAN, ACCESS: 11, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 9, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

