PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 24, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, INDEX: SYS.T1_IDX3, ACCESS: 2, COST: BLOCKED )
  [ IN-SUBQUERY VARIABLE KEY ]
  OR
   AND
    I3 = (SELECT 'abc', 1 FROM DUAL UNION ALL SELECT 'def', 1 FROM DUAL)
    I4 = 
  ::SUB-QUERY BEGIN
  PROJECT ( COLUMN_COUNT: 2, TUPLE_SIZE: 12, COST: BLOCKED )
   DISTINCT ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 2, BUCKET_COUNT: 1024, ACCESS: 4, COST: BLOCKED )
    VIEW ( ACCESS: 2, COST: BLOCKED )
     PROJECT ( COLUMN_COUNT: 2, TUPLE_SIZE: 12, COST: BLOCKED )
      VIEW ( ACCESS: 2, COST: BLOCKED )
       BAG-UNION
        PROJECT ( COLUMN_COUNT: 2, TUPLE_SIZE: 8, COST: BLOCKED )
         SCAN ( TABLE: DUAL, FULL SCAN, ACCESS: 1, COST: BLOCKED )
        PROJECT ( COLUMN_COUNT: 2, TUPLE_SIZE: 8, COST: BLOCKED )
         SCAN ( TABLE: DUAL, FULL SCAN, ACCESS: 1, COST: BLOCKED )
  ::SUB-QUERY END
  SCAN ( PARTITION: PD, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( PARTITION: P1, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

