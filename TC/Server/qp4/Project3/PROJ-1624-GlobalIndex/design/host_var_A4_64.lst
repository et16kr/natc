 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

$T0> var v2 integer;
$T0> var v3 integer;
$T0> var v4 integer;
$T0> var v5 integer;

$T0> exec :v2 := 1;
Execute success.
$T0> exec :v3 := 1;
Execute success.
$T0> exec :v4 := 1;
Execute success.
$T0> exec :v5 := 1;
Execute success.

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer,
  i5 integer
)
partition by range(i1)
(
  partition p1 values less than (50),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index t1_idx2 on t1(i2) local;
Create success.
$T0> create index t1_idx3 on t1(i3) local;
Create success.
$T0> create index t1_idx4 on t1(i4);
Create success.
$T0> create index t1_idx5 on t1(i5);
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     
I4                                       INTEGER                     
I5                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_IDX2                                  BTREE                  I2 ASC
T1_IDX3                                  BTREE                  I3 ASC
T1_IDX4                                  BTREE                  I4 ASC
T1_IDX5                                  BTREE                  I5 ASC
T1 has no primary key

$T0> ##################################
$T0> # SECTOR; SCAN DECISION FACTOR
$T0> ##################################


$T0> EXEC GATHER_TABLE_STATS('SYS','T1');
Execute success.

$T0> alter session set explain plan = off;
Alter success.
$T0> alter session set trclog_detail_predicate = 0;
Alter success.

$T0> select count(distinct i1) from T1
union all
select count(distinct i2) from T1
union all
select count(distinct i3) from T1
union all
select count(distinct i4) from T1
union all
select count(distinct i5) from T1;
COUNT(distinct I1)   
