20                   
5 rows selected.


$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> prepare select /*+keep_plan*/ * from t1 where i2 = :v2 and i3 = :v3 and i4 = :v4 and i5 = :v5;
T1.I1       T1.I2       T1.I3       T1.I4       T1.I5       
------------------------------------------------------------------
1           1           1           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 5, TUPLE_SIZE: 20, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, INDEX: SYS.T1_IDX4, ACCESS: 1, COST: BLOCKED )
  [ VARIABLE KEY ]
  OR
   AND
    I4 = :v4
  [ FILTER ]
  AND
   I2 = :v2
   I5 = :v5
   I3 = :v3
