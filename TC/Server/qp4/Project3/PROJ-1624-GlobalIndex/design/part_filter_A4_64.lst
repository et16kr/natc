 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

$T0> set linesize 200;

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1(i1 integer, i2 integer, i3 integer)
partition by range(i1)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values (1, 1, 1);
1 row inserted.
$T0> insert into t1 values (2, 2, 1);
1 row inserted.
$T0> insert into t1 values (3, 3, 3);
1 row inserted.
$T0> insert into t1 values (4, 4, 3);
1 row inserted.

$T0> create table t2(i1 integer, i2 integer, i3 integer, i4 integer)
partition by hash(i1,i2,i3)
(
  partition p1,
  partition p2
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 values (1, 1, 1, 1);
1 row inserted.
$T0> insert into t2 values (2, 2, 1, 1);
1 row inserted.
$T0> insert into t2 values (3, 3, 3, 1);
1 row inserted.
$T0> insert into t2 values (4, 4, 3, 1);
1 row inserted.

$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; PARTITION FILTER + SUBQUERY FILTER
$T0> ##################################

$T0> select * from t1 where i1<3 and i1 in (select 1 from dual);
T1.I1       T1.I2       T1.I3       
----------------------------------------
1           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 3, TUPLE_SIZE: 12, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 1/2, FULL SCAN, ACCESS: 2, COST: BLOCKED )
  [ PARTITION KEY ]
  AND
   OR
    I1 < 3
  [ SUBQUERY FILTER ]
  EXISTS (SELECT '0' FROM DUAL WHERE T1.I1 = 1)
  ::SUB-QUERY BEGIN
  PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 3, COST: BLOCKED )
   SCAN ( TABLE: DUAL, FULL SCAN, ACCESS: 1, COST: BLOCKED )
    [ CONSTANT FILTER ]
    T1.I1 = 1
  ::SUB-QUERY END
  SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   [ FILTER SERIAL EXECUTE ]
   I1 < 3
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; PARTITION FILTER + GLOBAL INDEX
$T0> ##################################

$T0> create index t1_idx1 on t1(i1);
Create success.

$T0> select * from t1 where i1<3;
T1.I1       T1.I2       T1.I3       
----------------------------------------
1           1           1           
2           2           1           
2 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 3, TUPLE_SIZE: 12, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 1/2, INDEX: SYS.T1_IDX1, ACCESS: 2, COST: BLOCKED )
  [ PARTITION KEY ]
  AND
   OR
    I1 < 3
  [ FIXED KEY ]
  AND
   OR
    I1 < 3
  SCAN ( PARTITION: P1, RID SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> select * from t1 where i1<3 and i1 = 2;
T1.I1       T1.I2       T1.I3       
----------------------------------------
2           2           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 3, TUPLE_SIZE: 12, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 1/2, INDEX: SYS.T1_IDX1, ACCESS: 1, COST: BLOCKED )
  [ PARTITION KEY ]
  AND
   OR
    I1 = 2
   OR
    I1 < 3
  [ FIXED KEY ]
  AND
   OR
    I1 = 2
   OR
    I1 < 3
  SCAN ( PARTITION: P1, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; COMPOSITE PARTITION FILTER + COMPOSITE GLOBAL INDEX
$T0> ##################################

$T0> create index t2_idx1 on t2(i3,i1,i2);
Create success.

$T0> select * from t2 where i1=1 and i2=1 and i3=1;
T2.I1       T2.I2       T2.I3       T2.I4       
-----------------------------------------------------
1           1           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 16, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 1/2, INDEX: SYS.T2_IDX1, ACCESS: 1, COST: BLOCKED )
  [ PARTITION KEY ]
  AND
   OR
    I1 = 1
   OR
    I2 = 1
   OR
    I3 = 1
  [ FIXED KEY ]
  AND
   OR
    I3 = 1
   OR
    I1 = 1
   OR
    I2 = 1
  SCAN ( PARTITION: P2, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> select * from t2 where i1=1 and i2=1;
T2.I1       T2.I2       T2.I3       T2.I4       
-----------------------------------------------------
1           1           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 16, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 2/2, FULL SCAN, ACCESS: 1, COST: BLOCKED )
  SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   [ FILTER SERIAL EXECUTE ]
   AND
    I2 = 1
    I1 = 1
  SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   [ FILTER SERIAL EXECUTE ]
   AND
    I2 = 1
    I1 = 1
------------------------------------------------------------

$T0> select * from t2 where i1=1 and i3=1;
T2.I1       T2.I2       T2.I3       T2.I4       
-----------------------------------------------------
1           1           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 16, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 2/2, INDEX: SYS.T2_IDX1, ACCESS: 1, COST: BLOCKED )
  [ FIXED KEY ]
  AND
   OR
    I3 = 1
   OR
    I1 = 1
  SCAN ( PARTITION: P2, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( PARTITION: P1, RID SCAN, ACCESS: 0, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; COMPOSITE PARTITION FILTER + COMPOSITE GLOBAL INDEX
$T0> ##################################

$T0> drop index t2_idx1;
Drop success.
$T0> create index t2_idx1 on t2(i3,i2,i4);
Create success.

$T0> select * from t2 where i1=1 and i2=1 and i3=1;
T2.I1       T2.I2       T2.I3       T2.I4       
-----------------------------------------------------
1           1           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 16, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 1/2, INDEX: SYS.T2_IDX1, ACCESS: 1, COST: BLOCKED )
  [ PARTITION KEY ]
  AND
   OR
    I1 = 1
   OR
    I2 = 1
   OR
    I3 = 1
  [ FIXED KEY ]
  AND
   OR
    I3 = 1
   OR
    I2 = 1
  [ FILTER ]
  I1 = 1
  SCAN ( PARTITION: P2, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> select * from t2 where i1=2 and i3=1;
T2.I1       T2.I2       T2.I3       T2.I4       
-----------------------------------------------------
2           2           1           1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 4, TUPLE_SIZE: 16, COST: BLOCKED )
 PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 2/2, INDEX: SYS.T2_IDX1, ACCESS: 2, COST: BLOCKED )
  [ FIXED KEY ]
  AND
   OR
    I3 = 1
  [ FILTER ]
  I1 = 2
  SCAN ( PARTITION: P2, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( PARTITION: P1, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

