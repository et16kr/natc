$T0> create index idx2 on t1(i2) local;
Create success.
$T0> create index idx3 on t1(i3) local;
Create success.
$T0> create index idx4 on t1(i4);
Create success.
$T0> create index idx5 on t1(i5);
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
