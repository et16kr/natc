$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

$T0> set linesize 200;

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer
)
partition by range(i1)
(
  partition p1 values less than (6),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values ( 1, 1, 1 );
1 row inserted.
$T0> insert into t1 values ( 2, 2, 2 );
1 row inserted.
$T0> insert into t1 values ( 3, 3, 3 );
1 row inserted.
$T0> insert into t1 values ( 4, 4, 4 );
1 row inserted.
$T0> insert into t1 values ( 5, 5, 5 );
1 row inserted.
$T0> insert into t1 values ( 6, 6, 6 );
1 row inserted.
$T0> insert into t1 values ( 7, 7, 7 );
1 row inserted.
$T0> insert into t1 values ( 8, 8, 8 );
1 row inserted.

$T0> create index t1_idx2 on t1(i2);
Create success.
$T0> create index t1_idx3 on t1(i3) local;
Create success.

$T0> create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer
)
partition by range(i1)
(
  partition p1 values less than (6),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 values ( 3, 3, 3 );
