  PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 2/2, INDEX: SYS.T2_I1, ACCESS: 4, COST: BLOCKED )
   [ PARTITION FILTER ]
   OR
    AND
     T1.I1 = T2.I1
   [ VARIABLE KEY ]
   OR
    AND
     T1.I1 = T2.I1
   SCAN ( PARTITION: P2, RID SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   SCAN ( PARTITION: P1, RID SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
