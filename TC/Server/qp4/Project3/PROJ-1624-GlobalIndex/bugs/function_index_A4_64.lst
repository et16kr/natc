$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop function get_pid;
$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> SKIP END;

$T0> create function get_pid( tablename varchar(40), partname varchar(40) )
return bigint
as
  v1 bigint;
begin
  select p.partition_oid into v1
  from system_.sys_tables_ t, system_.sys_table_partitions_ p
  where t.table_name = tablename and t.user_id = user_id() and p.partition_name = partname
  and t.table_id = p.table_id;

  return v1;
end;
/
Create success.

$T0> ##################################
$T0> # SECTOR; CREATE
$T0> ##################################

$T0> create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i4)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
enable row movement
tablespace sys_tbs_disk_data;
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i1);
Alter success.
$T0> create index t1_idx1 on t1( i1+i2 );
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     NOT NULL
I2                                       INTEGER                     
I3                                       INTEGER                     
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_PK                                    BTREE    UNIQUE        I1 ASC
T1_IDX1                                  BTREE                  I1+I2 ASC
[ PRIMARY KEY ]                                                 
------------------------------------------------------------------------------
I1

$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> ###################################
$T0> # create index t1_pk;
$T0> ###################################

$T0> alter session set explain plan = off;
Alter success.

$T0> # should be no rows
$T0> select a.*, b.*
from 
(
  select nvl(i1,-1000) i1, get_pid('T1','P1') pid, cast(_prowid as bigint) rid from t1 partition (p1)
  union all
  select nvl(i1,-1000) i1, get_pid('T1','P2') pid, cast(_prowid as bigint) rid from t1 partition (p2)
  union all
  select nvl(i1,-1000) i1, get_pid('T1','P3') pid, cast(_prowid as bigint) rid from t1 partition (p3)
  union all
  select nvl(i1,-1000) i1, get_pid('T1','P4') pid, cast(_prowid as bigint) rid from t1 partition (p4)
  union all
  select nvl(i1,-1000) i1, get_pid('T1','PD') pid, cast(_prowid as bigint) rid from t1 partition (pd)
) a 
full outer join 
(
  select nvl(i1,-1000) i1, "$GIT_OID", "$GIT_RID" from "$GIT_T1_PK"
) b 
on a.i1 = b.i1 and a.pid = b."$GIT_OID" and a.rid = b."$GIT_RID"
where a.rid is null or b."$GIT_RID" is null;
[ERR-31385 : _PROWID is not supported.]

