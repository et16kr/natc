###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
alter session set explain plan = off;
alter system set trclog_detail_predicate = 0;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE
##################################

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i4)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
tablespace sys_tbs_disk_data;

create index idx1 on t1(i2);
create index idx2 on t1(i3) local;
create index idx3 on t1(i4);

desc t1;

##################################
# SECTOR; DROP TABLE
##################################

drop table t1;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
