$T0> connect user1/user1;
Connect success.

$T0> create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> alter table t2 add constraint t2_pk primary key (i3, i4) using index tablespace data1;
Alter success.
$T0> alter table t2 add constraint t2_uk unique (i5, i6) using index tablespace data2;
Alter success.

