 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;

$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop user user1 cascade;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

$T0> create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
Create success.
$T0> create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
Create success.

$T0> set linesize 200;

$T0> create user user1 identified by user1;
Create success.

$T0> grant all privileges to user1;
Grant success.

$T0> ##################################
$T0> # SECTOR; CREATE INDEX
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer constraint t1_nn not null,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index idx1 on t1(i1) tablespace sys_tbs_disk_data;
Create success.
$T0> create index idx2 on t1(i1, i2) tablespace data1;
Create success.
$T0> create index idx3 on t1(i1 desc, i2 desc, i3 asc) tablespace data1;
Create success.

$T0> create index idx4 on t1(i2 desc) tablespace data2;
Create success.
$T0> create index idx5 on t1(i2, i3) tablespace data2;
Create success.

$T0> connect user1/user1;
Connect success.

$T0> create index idx6 on sys.t1(i3);
Create success.
$T0> create index idx7 on sys.t1(i3 desc, i1 asc);
Create success.
$T0> create index idx8 on sys.t1(i3, i2 desc, i1);
Create success.

$T0> connect sys/manager;
Connect success.

$T0> select u.user_name, t.table_name, t.table_type, t.hidden, b.name tbs_name 
from system_.sys_tables_ t, system_.sys_users_ u, v$tablespaces b
where t.table_name like '$%' and t.user_id = u.user_id and t.tbs_id = b.id
order by t.table_id;
