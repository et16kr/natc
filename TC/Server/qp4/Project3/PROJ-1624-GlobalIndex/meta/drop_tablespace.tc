###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;
INCLUDE select_meta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop tablespace data1 including contents and datafiles;
drop tablespace data2 including contents and datafiles;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; BACKUP META
##################################

CALL CREATE_BACKUP_META();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  constraint t1_pk primary key (i3) using index tablespace data1,
  constraint t1_uk unique (i4) using index tablespace data2
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index idx1 on t1(i2 desc);
create index idx2 on t1(i2, i3) tablespace data2;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "IDX1" );
CALL DESC_INDEX( "IDX2" );

##################################
# SECTOR; BACKUP META
##################################

CALL CREATE_BACKUP_META();

##################################
# SECTOR; CREATE TABLE
##################################

create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  constraint t2_pk primary key (i3) using index tablespace data1,
  constraint t2_uk unique (i4)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace data2;

create index idx3 on t2(i2) tablespace sys_tbs_disk_data;
create index idx4 on t2(i2 desc, i3 desc) tablespace data2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "T2_UK" );
CALL DESC_INDEX( "IDX3" );
CALL DESC_INDEX( "IDX4" );

CALL SELECT_META();

##################################
# SECTOR; DROP TABLESPACE
##################################

drop tablespace data2 including contents and datafiles;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "IDX1" );
CALL DESC_INDEX( "IDX2" );

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "T2_UK" );
CALL DESC_INDEX( "IDX3" );
CALL DESC_INDEX( "IDX4" );

CALL SELECT_META();

##################################
# SECTOR; COMPARE META
##################################

CALL COMPARE_META();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
