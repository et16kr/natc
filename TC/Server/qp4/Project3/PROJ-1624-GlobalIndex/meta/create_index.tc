###########################################################################
# Global Index Test
###########################################################################

INCLUDE select_meta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop user user1 cascade;
drop tablespace data1 including contents and datafiles;
drop tablespace data2 including contents and datafiles;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;

set linesize 200;
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

create user user1 identified by user1;

grant all privileges to user1;

##################################
# SECTOR; CREATE INDEX
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer constraint t1_nn not null,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index idx1 on t1(i1) tablespace sys_tbs_disk_data;
create index idx2 on t1(i1, i2) tablespace data1;
create index idx3 on t1(i1 desc, i2 desc, i3 asc) tablespace data1;

create index idx4 on t1(i2 desc) tablespace data2;
create index idx5 on t1(i2, i3) tablespace data2;

connect user1/user1;

create index idx6 on sys.t1(i3);
create index idx7 on sys.t1(i3 desc, i1 asc);
create index idx8 on sys.t1(i3, i2 desc, i1);

connect sys/manager;

CALL SELECT_META();

select u.user_name, t.table_name, t.table_type, t.hidden, b.name tbs_name 
from system_.sys_tables_ t, system_.sys_users_ u, v$tablespaces b
where t.table_name = 'T1' and t.user_id = u.user_id and t.tbs_id = b.id
order by t.table_id;

select u.user_name, i.index_name, i.index_type, i.is_unique, b.name tbs_name, i.is_partitioned, i.is_global
from system_.sys_tables_ t, system_.sys_indices_ i, system_.sys_users_ u, v$tablespaces b
where t.table_name = 'T1' and t.table_id = i.table_id and i.user_id = u.user_id and i.tbs_id = b.id
order by i.index_id;

##################################
# SECTOR; CREATE INDEX
##################################

connect user1/user1;

create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer constraint t2_nn not null,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index idx1 on t2(i1) tablespace sys_tbs_disk_data;
create index idx2 on t2(i1, i2) tablespace data1;
create index idx3 on t2(i1, i2 desc, i3) tablespace data1;

create index idx4 on t2(i2) tablespace data2;
create index idx5 on t2(i2, i3 desc) tablespace data2;

connect sys/manager;

CALL SELECT_META();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
