 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;

$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop user user1 cascade;
$T0> SKIP END;

$T0> create user user1 identified by user1;
Create success.

$T0> grant all privileges to user1;
Grant success.

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> connect user1/user1;
Connect success.

$T0> create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> connect sys/manager;
Connect success.

$T0> ##################################
$T0> # SECTOR; BACKUP META
$T0> ##################################




$T0> ##################################
$T0> # SECTOR; CREATE INDEX
$T0> ##################################

$T0> connect sys/manager;
Connect success.

$T0> create index idx1 on t1(i1);
Create success.
$T0> create index idx2 on t1(i1, i2);
Create success.
$T0> create index idx3 on t1(i1, i2, i3);
Create success.

$T0> create index idx4 on t1(i2);
Create success.
$T0> create index idx5 on t1(i2, i3);
Create success.

$T0> connect user1/user1;
Connect success.

$T0> create index idx6 on sys.t1(i3);
Create success.
$T0> create index idx7 on sys.t1(i3, i1);
Create success.
$T0> create index idx8 on sys.t1(i3, i2, i1);
Create success.

$T0> create index idx1 on t2(i1);
Create success.
$T0> create index idx2 on t2(i1, i2);
Create success.
$T0> create index idx3 on t2(i1, i2, i3);
Create success.

$T0> create index idx4 on t2(i2);
Create success.
$T0> create index idx5 on t2(i2, i3);
Create success.

$T0> connect sys/manager;
Connect success.

$T0> desc t1;
