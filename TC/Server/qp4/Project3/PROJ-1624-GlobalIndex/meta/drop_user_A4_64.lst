$T0> connect user1/user1;
Connect success.

$T0> create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  constraint t2_pk primary key (i3) using index tablespace data1,
  constraint t2_uk unique (i4)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index idx1 on sys.t1(i2 desc);
Create success.
$T0> create index idx2 on sys.t1(i2, i3) tablespace data2;
Create success.

