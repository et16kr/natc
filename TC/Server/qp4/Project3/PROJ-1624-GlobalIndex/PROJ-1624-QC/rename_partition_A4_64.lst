------------------------------------------------------------
$T0> insert into t1 values(17,27,37,47);
1 row inserted.
------------------------------------------------------------
                 NO PLAN FOR INSERT SQL                     
------------------------------------------------------------
$T0> insert into t1 values(19,29,39,49);
1 row inserted.
------------------------------------------------------------
                 NO PLAN FOR INSERT SQL                     
------------------------------------------------------------

$T0> alter table t1 rename partition p1 to p1_new;
Alter success.
$T0> alter table t1 rename partition p2 to p2_new;
Alter success.
$T0> alter table t1 rename partition p3 to p3_new;
Alter success.

