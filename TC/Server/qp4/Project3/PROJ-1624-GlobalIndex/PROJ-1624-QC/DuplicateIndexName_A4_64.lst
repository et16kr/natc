 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;

$T0> #######################################################################
$T0> # Duplicate Index Name Test
$T0> #######################################################################

$T0> ###################################
$T0> #SECTOR; PREPARATION
$T0> ###################################

$T0> ###################################
$T0> # SECTOR; PR-6119
$T0> ###################################

$T0> SKIP BEGIN;
$T0> DROP TABLE T1;
$T0> DROP TABLE T2;
$T0> DROP INDEX IDX1;
$T0> SKIP END;

$T0> create table t1 (i1 integer, i2 integer)
partition by range(i1)
(
	partition p1 values less than('3'),
	partition p2 values less than('7'),
	partition p3 values default
) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> create table t2 (i1 integer, i2 integer)
partition by range(i2)
(
	partition p1 values less than('3'),
	partition p2 values less than('7'),
	partition p3 values default
) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> alter table t1 add constraint pk_t1 primary key (i1, i2);
Alter success.

$T0> select u.user_name, t.table_name, t.table_type, t.hidden, b.name tbs_name 
from system_.sys_tables_ t, system_.sys_users_ u, v$tablespaces b
where t.table_name like '$%' and t.user_id = u.user_id and t.tbs_id = b.id
order by t.table_id;
