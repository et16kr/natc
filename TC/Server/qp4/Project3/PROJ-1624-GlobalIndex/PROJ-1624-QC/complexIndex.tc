#################-
# 2.5 테이블스페이스 검사 
#################-
DROP TABLE PDT_RANGE;
CREATE TABLE PDT_RANGE
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( 10 ),
    PARTITION P2 VALUES LESS THAN ( 20 ),
    PARTITION P3 VALUES LESS THAN ( 30 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

# memory tablespace
# should be fail
CREATE LOCALUNIQUE INDEX IDX_LOCAL 
ON PDT_RANGE( F1 ) LOCAL
(
    PARTITION IDX_P1 ON P1 TABLESPACE SYS_TBS_MEM_DATA
);

# should be fail
# temporary tablespace
CREATE LOCALUNIQUE INDEX IDX_LOCAL 
ON PDT_RANGE( F1 ) LOCAL
(
    PARTITION IDX_P1 ON P1 TABLESPACE SYS_TBS_TEMP
);

# should be fail
# undo tablespace
CREATE LOCALUNIQUE INDEX IDX_LOCAL 
ON PDT_RANGE( F1 ) LOCAL
(
    PARTITION IDX_P1 ON P1 TABLESPACE SYS_TBS_UNDO
);

