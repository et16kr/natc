########################################################
# COMPOSITE INDEX ON RANGE PDT( PK:INTEGER )
########################################################

#####################################
#SECTOR; INTIALIZE
#####################################

SKIP BEGIN;
DROP TABLE PDT_RANGE;
DROP TABLE T;
SKIP END;


###########################################
#SECTOR; DO JOB #1 (1. Basic Test)
###########################################

####################
# 2.1 LOCALUNIQUE Constraint and Global Index
####################
CREATE TABLE PDT_RANGE
(
    F1   INTEGER LOCALUNIQUE,
    F2   INTEGER,
    F3	 VARCHAR(100) 
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( 10 ),
    PARTITION P2 VALUES LESS THAN ( 20 ),
    PARTITION P3 VALUES LESS THAN ( 30 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE INDEX IDX1 ON PDT_RANGE(F2); 

INSERT INTO PDT_RANGE VALUES( 35, 0, 'A');
INSERT INTO PDT_RANGE VALUES( 30, 0, 'B'  );
INSERT INTO PDT_RANGE VALUES( 25, 0, 'C' );
INSERT INTO PDT_RANGE VALUES( 20, 0, 'D' );
INSERT INTO PDT_RANGE VALUES( 15, 0, 'E' );
INSERT INTO PDT_RANGE VALUES( 10, 0, 'F' );
INSERT INTO PDT_RANGE VALUES( 5, 0, 'G' );
INSERT INTO PDT_RANGE VALUES( 0, 0, 'H' );

######################################
# DDL TABLE
######################################
# ADD Partition
ALTER TABLE PDT_RANGE ADD PARTITION P5;

# ADD COLUMN
ALTER TABLE T1 ADD COLUMN ( I4 INTEGER );
INSERT INTO T1 VALUES ( 1,1,1,1 );
INSERT INTO T1 VALUES ( 2,2,2,2 );

# COALESCE(Only Hash Table)

# DROP
ALTER TABLE PDT_RANGE DROP PARTITION P1;

# DROP COLUMN
ALTER TABLE T1 DROP COLUMN I4;


# MERGE
ALTER TABLE TEST 
MERGE PARTITIONS P1 TABLESPACE PDT_TBS2, P2 INTO
    PARTITION P1_1 TABLESPACE PDT_TBS2;
    
# RENAME
ALTER TABLE PDT_RANGE
RENAME PARTITION P1 TO P1_1;

# ROW MOVEMENT
ALTER TABLE T1
ENABLE ROW MOVEMENT;

UPDATE T1 SET I1 = I1 + 50;


# SPLIT
ALTER TABLE T1 
SPLIT PARTITION P1 AT ( 50 ) INTO
(
    PARTITION P5 TABLESPACE PDT_TBS2
        INDEX ( IDX1 PARTITION P5_IDX1 TABLESPACE PDT_TBS3,
                IDX2 PARTITION P5_IDX2 TABLESPACE PDT_TBS4 )
        LOB STORE AS ( TABLESPACE PDT_TBS2 ),
    PARTITION P6 TABLESPACE PDT_TBS3
        INDEX ( IDX1 PARTITION P6_IDX1 TABLESPACE PDT_TBS3,
                IDX2 PARTITION P6_IDX2 TABLESPACE PDT_TBS4 )
);

# TRUNCATE
ALTER TABLE TEST 
TRUNCATE PARTITION P1_1 TABLESPACE PDT_TBS2;



#############################
# DDL INDEX
#############################
# REBUILD INDEX
# DROP INDEX


#########################################
