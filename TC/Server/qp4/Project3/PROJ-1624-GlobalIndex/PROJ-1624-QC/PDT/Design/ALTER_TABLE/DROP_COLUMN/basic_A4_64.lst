$P0> INSERT INTO T1 VALUES ( 1, 1, 'FF', 1 );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 2, 2, 'FFFF', 2 );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 3, 3, 'FFFFFF', 3 );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 4, 4, 'FFFFFFFF', 4 );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 5, 5, 'FFFFFFFFFF', 5 );
1 row inserted.

-- should be 10
