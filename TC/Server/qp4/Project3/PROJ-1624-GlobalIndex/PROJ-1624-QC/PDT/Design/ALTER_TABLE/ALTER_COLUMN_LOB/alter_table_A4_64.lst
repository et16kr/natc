$P0> --+PROCESS P0;
--###################################################################
--# ALTER TABLE ... ALTER COLUMN LOB
--###################################################################

--###################################################################
--+SECTOR 1; PREPARATION
--###################################################################

--+SKIP BEGIN; 
$P0> DROP TABLE T1;
$P0> DROP TABLE T2;
--+SKIP END; 

$P0> CREATE TABLE T1( I1 INTEGER, I2 CLOB DEFAULT 'DEFAULT', I3 BLOB )
     PARTITION BY HASH (I1)
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$P0> INSERT INTO T1 VALUES ( 1, 'CLOB1', 'FF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 2, 'CLOB2', 'FFFF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 3, 'CLOB3', 'FFFFFF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 4, 'CLOB4', 'FFFFFFFF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 5, 'CLOB5', 'FFFFFFFFFF' );
1 row inserted.

$P0> CREATE TABLE T2( I1 INTEGER, I2 CLOB DEFAULT 'DEFAULT', I3 BLOB )
     PARTITION BY RANGE (I1)
     (
         PARTITION P1 VALUES LESS THAN (2),
         PARTITION P2 VALUES LESS THAN (3),
         PARTITION P3 VALUES LESS THAN (4),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$P0> INSERT INTO T2 VALUES ( 1, 'CLOB1', 'FF' );
1 row inserted.
$P0> INSERT INTO T2 VALUES ( 2, 'CLOB2', 'FFFF' );
1 row inserted.
$P0> INSERT INTO T2 VALUES ( 3, 'CLOB3', 'FFFFFF' );
1 row inserted.
$P0> INSERT INTO T2 VALUES ( 4, 'CLOB4', 'FFFFFFFF' );
1 row inserted.
$P0> INSERT INTO T2 VALUES ( 5, 'CLOB5', 'FFFFFFFFFF' );
1 row inserted.


--#########################################################################
--+SECTOR 2; 1. ADD PARTITION
--#########################################################################

---------------------------------------------------
-- 1.1 LOB STORE
---------------------------------------------------
$P0> ALTER TABLE T1 ALTER COLUMN LOB STORE AS ( NOLOGGING );
Alter success.
$P0> ALTER TABLE T1 ADD PARTITION P5;
Alter success.
-- {(P5,F,T), (P5,F,T)}
$P0> SELECT PART.PARTITION_NAME, LOBS.LOGGING, LOBS.BUFFER
     FROM SYSTEM_.SYS_TABLES_ TAB, SYSTEM_.SYS_PART_LOBS_ LOBS,
          SYSTEM_.SYS_TABLE_PARTITIONS_ PART
     WHERE TAB.TABLE_ID = LOBS.TABLE_ID AND
           TAB.TABLE_NAME = 'T1' AND 
           PART.PARTITION_ID = LOBS.PARTITION_ID AND
           PART.PARTITION_NAME = 'P5'
     ORDER BY PART.PARTITION_NAME, LOBS.COLUMN_ID;
PARTITION_NAME                            LOGGING  BUFFER  
---------------------------------------------------------------
P5                                        F  T  
P5                                        F  T  
2 rows selected.
$P0> ALTER TABLE T1 COALESCE PARTITION;
Alter success.

---------------------------------------------------
-- 초기화
---------------------------------------------------
$P0> ALTER TABLE T1 ALTER COLUMN LOB STORE AS ( LOGGING BUFFER );
Alter success.

