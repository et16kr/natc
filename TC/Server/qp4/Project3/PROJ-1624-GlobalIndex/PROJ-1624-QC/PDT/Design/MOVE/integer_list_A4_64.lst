$P0> CREATE TABLE PDT_LIST_SRC
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10, 15 ),
         PARTITION P2 VALUES ( 20, 25 ),
         PARTITION P3 VALUES ( 30, 35 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

