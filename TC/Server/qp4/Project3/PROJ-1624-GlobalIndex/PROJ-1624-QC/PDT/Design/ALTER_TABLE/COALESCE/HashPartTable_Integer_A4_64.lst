--+SECTOR 7; LOB 컬럼이 있는 경우의 COALESCE
--##############################
$P0> DROP TABLE T1;
Drop success.
$P0> CREATE TABLE T1 ( I1 INTEGER, I2 BLOB, I3 CLOB )
     PARTITION BY HASH (I1) 
     ( PARTITION P1 TABLESPACE PDT_TBS 
                             LOB(I2, I3) STORE AS ( TABLESPACE PDT_TBS2 ), 
       PARTITION P2 TABLESPACE PDT_TBS3,
       PARTITION P3
     ) TABLESPACE PDT_TBS4 LOB(I3) STORE AS ( TABLESPACE PDT_TBS5 );
Create success.

$P0> INSERT INTO T1 VALUES ( 100,   'ABC', 'DEF' );
1 row inserted.
