>>> [Schema_List_Integer.sql] BEGIN <<<
DROP TABLE T1;
DROP TABLE T2;

CREATE TABLE T1( I1 INTEGER, I2 INTEGER, I3 INTEGER )
PARTITION BY LIST (I1)
(
    PARTITION P1 VALUES (0, 50, 75) TABLESPACE PDT_TBS2,
    PARTITION P2 VALUES (100, 150, 175, NULL) TABLESPACE PDT_TBS3,
    PARTITION P3 VALUES (200, 250, 275),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

INSERT INTO T1 VALUES (NULL, 100, 100);
INSERT INTO T1 VALUES (0, 100, 100);
INSERT INTO T1 VALUES (50, 100, 100);
INSERT INTO T1 VALUES (75, 100, 100);
INSERT INTO T1 VALUES (100, 100, 100);
INSERT INTO T1 VALUES (150, 100, 100);
INSERT INTO T1 VALUES (175, 100, 100);
INSERT INTO T1 VALUES (200, 100, 100);
INSERT INTO T1 VALUES (250, 100, 100);
INSERT INTO T1 VALUES (275, 100, 100);
INSERT INTO T1 VALUES (300, 100, 100);
INSERT INTO T1 VALUES (350, 100, 100);
INSERT INTO T1 VALUES (375, 100, 100);


CREATE TABLE T2( I1 INTEGER, I2 INTEGER, I3 INTEGER )
PARTITION BY LIST (I1)
(
    PARTITION P1 VALUES (0, 50, 75) TABLESPACE PDT_TBS2,
    PARTITION P2 VALUES (100, 150, 175, NULL) TABLESPACE PDT_TBS3,
    PARTITION P3 VALUES (200, 250, 275),
    PARTITION P4 VALUES DEFAULT TABLESPACE PDT_TBS4
) TABLESPACE PDT_TBS;

INSERT INTO T2 VALUES (NULL, 100, 100);
INSERT INTO T2 VALUES (0, 100, 100);
INSERT INTO T2 VALUES (50, 100, 100);
INSERT INTO T2 VALUES (75, 100, 100);
INSERT INTO T2 VALUES (100, 100, 100);
INSERT INTO T2 VALUES (150, 100, 100);
INSERT INTO T2 VALUES (175, 100, 100);
INSERT INTO T2 VALUES (200, 100, 100);
INSERT INTO T2 VALUES (250, 100, 100);
INSERT INTO T2 VALUES (275, 100, 100);
INSERT INTO T2 VALUES (300, 100, 100);
INSERT INTO T2 VALUES (350, 100, 100);
INSERT INTO T2 VALUES (375, 100, 100);

CREATE INDEX IDX1 ON T2(I1, I3);
CREATE INDEX IDX2 ON T2(I3, I1, I2);
CREATE INDEX IDX3 ON T2(I2, I3);

CREATE INDEX IDX4 ON T2(I1) LOCAL
(
    PARTITION IDX1_P3 ON P3,
    PARTITION IDX1_P4 ON P4
);
>>> [Schema_List_Integer.sql] END <<<
