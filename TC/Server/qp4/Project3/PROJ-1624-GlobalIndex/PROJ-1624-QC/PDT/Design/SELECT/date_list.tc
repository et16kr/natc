
########################################################
## SELECT LIST PARTITIOIN ( PK:INTEGER, INDEX:PREFIXED )
########################################################

#####################################
##SECTOR; INTIALIZE
#####################################

DEF MAIN()
{
SKIP BEGIN;
DROP TABLE PDT_LIST;
SKIP END;

###########################################
##+SECTOR; DO JOB #1 (1. Basic Test)
###########################################

CREATE TABLE PDT_LIST
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) ),
    PARTITION P2 VALUES ( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ) ),
    PARTITION P3 VALUES ( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ) ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );

INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-5-10', 'YYYY-MM-DD' ), 0 );

## should be [TO_DATE( '2007-4-10', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P1 );
## should be [TO_DATE( '2007-4-20', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P2 );
## should be [TO_DATE( '2007-4-30', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P3 );
## should be [TO_DATE( '2007-5-10', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P4 );

## should be 4
SELECT COUNT(*) FROM PDT_LIST;

## should be [ '2007-4-10', '2007-4-20', '2007-4-30', '2007-5-10' ]
SELECT F1 FROM PDT_LIST;


###########################################
##+SECTOR; DO JOB #2 (2. Validation Test)
###########################################

DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) ),
    PARTITION P2 VALUES ( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ) ),
    PARTITION P3 VALUES ( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ) ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );

INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-5-10', 'YYYY-MM-DD' ), 0 );

## should be fail
SELECT COUNT(*) FROM PDT_LIST PARTITION( P5 );


###########################################
##+SECTOR; DO JOB #3 (3. Execution Test)
###########################################

####################################-
## 3.1 Partition Ordering
####################################-
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P3 VALUES ( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ) ),
    PARTITION P4 VALUES DEFAULT,
    PARTITION P1 VALUES ( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) ),
    PARTITION P2 VALUES ( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ) )
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );

INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-5-10', 'YYYY-MM-DD' ), 0 );

## should be [TO_DATE( '2007-4-10', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P1 );
## should be [TO_DATE( '2007-4-20', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P2 );
## should be [TO_DATE( '2007-4-30', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P3 );
## should be [TO_DATE( '2007-5-10', 'YYYY-MM-DD' )]
SELECT F1 FROM PDT_LIST PARTITION( P4 );

##########################################
## 3.2 Static Partition Pruning ( System )
##########################################
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) ),
    PARTITION P2 VALUES ( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ) ),
    PARTITION P3 VALUES ( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ) ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );

INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-5-10', 'YYYY-MM-DD' ), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=1;

## less than 
SELECT COUNT(*) FROM PDT_LIST WHERE F1 < TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 < TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 < TO_DATE( '2007-4-30', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 < TO_DATE( '2007-5-10', 'YYYY-MM-DD' );
## equal than 
SELECT COUNT(*) FROM PDT_LIST WHERE F1 = TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 = TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 = TO_DATE( '2007-4-30', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 = TO_DATE( '2007-5-10', 'YYYY-MM-DD' );
## greater than 
SELECT COUNT(*) FROM PDT_LIST WHERE F1 > TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 > TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 > TO_DATE( '2007-4-30', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 > TO_DATE( '2007-5-10', 'YYYY-MM-DD' );
## less equal than 
SELECT COUNT(*) FROM PDT_LIST WHERE F1 <= TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 <= TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 <= TO_DATE( '2007-4-30', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 <= TO_DATE( '2007-5-10', 'YYYY-MM-DD' );
## greater equal than 
SELECT COUNT(*) FROM PDT_LIST WHERE F1 >= TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 >= TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 >= TO_DATE( '2007-4-30', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 >= TO_DATE( '2007-5-10', 'YYYY-MM-DD' );
## not equal
SELECT COUNT(*) FROM PDT_LIST WHERE F1 != TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 != TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 != TO_DATE( '2007-4-30', 'YYYY-MM-DD' );
SELECT COUNT(*) FROM PDT_LIST WHERE F1 != TO_DATE( '2007-5-10', 'YYYY-MM-DD' );

SELECT COUNT(*) FROM PDT_LIST WHERE F1 = TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) OR F1 = TO_DATE( '2007-4-20', 'YYYY-MM-DD' );
ALTER SESSION SET EXPLAIN PLAN = OFF;

##########################################
## 3.3 Static Partition Pruning ( User )
##########################################
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) ),
    PARTITION P2 VALUES ( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ) ),
    PARTITION P3 VALUES ( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ) ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );

INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-5-10', 'YYYY-MM-DD' ), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
SELECT COUNT(*) FROM PDT_LIST PARTITION( P1 ) WHERE F1 = TO_DATE( '2007-4-10', 'YYYY-MM-DD' );
ALTER SESSION SET EXPLAIN PLAN = OFF;

####################################-
## 3.4 Partition filtering
####################################-
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ) ),
    PARTITION P2 VALUES ( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ) ),
    PARTITION P3 VALUES ( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ) ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );

INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-10', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-20', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-4-30', 'YYYY-MM-DD' ), 0 );
INSERT INTO PDT_LIST VALUES( TO_DATE( '2007-5-10', 'YYYY-MM-DD' ), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
SELECT F1 FROM PDT_LIST;
SELECT COUNT(*) FROM PDT_LIST WHERE F2 = 0;
SELECT COUNT(*) FROM PDT_LIST WHERE F1 = F1;
SELECT COUNT(*) FROM PDT_LIST WHERE F1 = F2;

ALTER SESSION SET EXPLAIN PLAN = OFF;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=0;

#####################################
##+SECTOR; FINALIZE
#####################################

DROP TABLE PDT_LIST;
}