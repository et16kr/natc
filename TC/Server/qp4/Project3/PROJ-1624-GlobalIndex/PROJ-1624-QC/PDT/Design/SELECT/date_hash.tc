########################################################
## SELECT HASH PARTITIOIN ( PK:INTEGER, INDEX:PREFIXED )
########################################################

#####################################
##SECTOR; INTIALIZE
#####################################

DEF MAIN()
{
SKIP BEGIN;
DROP TABLE PDT_HASH;
SKIP END;

###########################################
##+SECTOR; DO JOB #1 (1. Basic Test)
###########################################

CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

SELECT F1 FROM PDT_HASH PARTITION( P1 );
SELECT F1 FROM PDT_HASH PARTITION( P2 );
SELECT F1 FROM PDT_HASH PARTITION( P3 );
SELECT F1 FROM PDT_HASH PARTITION( P4 );

## should be 4
SELECT COUNT(*) FROM PDT_HASH;

## should be [0, 1, 2, 3]
SELECT F1 FROM PDT_HASH;


###########################################
##+SECTOR; DO JOB #2 (2. Validation Test)
###########################################

DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

## should be fail
SELECT COUNT(*) FROM PDT_HASH PARTITION( P5 );


###########################################
##+SECTOR; DO JOB #3 (3. Execution Test)
###########################################

####################################-
## 3.1 Partition Ordering
####################################-
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

SELECT F1 FROM PDT_HASH PARTITION( P1 );
SELECT F1 FROM PDT_HASH PARTITION( P2 );
SELECT F1 FROM PDT_HASH PARTITION( P3 );
SELECT F1 FROM PDT_HASH PARTITION( P4 );

##########################################
## 3.2 Static Partition Pruning ( System )
##########################################
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
## equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-30', 'YYYY-MM-DD');
ALTER SESSION SET EXPLAIN PLAN = OFF;

##########################################
## 3.3 Static Partition Pruning ( User )
##########################################
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=1;

SELECT COUNT(*) FROM PDT_HASH PARTITION( P2 ) WHERE F1 = 1;
ALTER SESSION SET EXPLAIN PLAN = OFF;

####################################-
## 3.4 Partition filtering
####################################-
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
## less than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-4-30', 'YYYY-MM-DD');
## equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-30', 'YYYY-MM-DD');
## greater than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-4-30', 'YYYY-MM-DD');
## less equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-4-30', 'YYYY-MM-DD');
## greater equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-4-30', 'YYYY-MM-DD');
## not equal
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-4-30', 'YYYY-MM-DD');

SELECT F1 FROM PDT_HASH;
SELECT COUNT(*) FROM PDT_HASH WHERE F2 = 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = F1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = F2;

ALTER SESSION SET EXPLAIN PLAN = OFF;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=0;

#####################################
##+SECTOR; FINALIZE
#####################################

DROP TABLE PDT_HASH;
}