$T0> CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') ),
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;
Create success.

$T0> CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );
Create success.

