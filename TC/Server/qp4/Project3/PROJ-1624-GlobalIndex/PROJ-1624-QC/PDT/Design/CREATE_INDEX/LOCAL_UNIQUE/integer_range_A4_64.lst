-----------------------------------------
-- 3.3 Local Unique violation
-----------------------------------------
$P0> DROP TABLE PDT_RANGE;
Drop success.
$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_RANGE VALUES( 35, 10 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 15 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 25, 20 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 25 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 15, 30 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 35 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 5, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 0, 5 );
1 row inserted.

$P0> CREATE UNIQUE INDEX IDX 
     ON PDT_RANGE( F2 );
Create success.

$P0> INSERT INTO PDT_RANGE VALUES( 35, 20 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 30, 25 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 25, 30 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 20, 35 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 15, 0 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 10, 5 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 5, 10 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_RANGE VALUES( 0, 15 );
[ERR-11058 : The row already exists in a unique index.]

-- should be 2
$P0> SELECT COUNT(*) FROM PDT_RANGE 
     WHERE F2 = 20;
COUNT                
-----------------------
1                    
1 row selected.

-- should be fail
$P0> INSERT INTO PDT_RANGE VALUES( 35, 10 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_RANGE VALUES( 30, 15 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
