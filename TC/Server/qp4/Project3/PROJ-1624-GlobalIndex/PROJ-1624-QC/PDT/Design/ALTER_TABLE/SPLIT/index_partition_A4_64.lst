$P0> CREATE TABLE T3 ( I1 INTEGER, I2 BLOB, I3 CLOB, I4 INTEGER )
     PARTITION BY RANGE (I1, I4)
     ( PARTITION P1 VALUES LESS THAN (100) TABLESPACE PDT_TBS2 
                                     LOB(I2, I3) STORE AS ( TABLESPACE PDT_TBS3 ), 
       PARTITION P2 VALUES LESS THAN (200) TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES DEFAULT
     ) TABLESPACE PDT_TBS LOB(I3) STORE AS ( TABLESPACE PDT_TBS5 );

