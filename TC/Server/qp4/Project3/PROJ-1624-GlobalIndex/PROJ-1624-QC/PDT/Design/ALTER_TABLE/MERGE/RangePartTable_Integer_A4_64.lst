--##############
--# Left In-place 
--##############
$P0> DROP TABLE T1;
Drop success.
$P0> CREATE TABLE T1 ( I1 INTEGER, I2 BLOB, I3 CLOB )
     PARTITION BY RANGE (I1) 
     ( PARTITION P1 VALUES LESS THAN (50) TABLESPACE PDT_TBS 
                                         LOB(I2, I3) STORE AS ( TABLESPACE PDT_TBS2 ), 
       PARTITION P2 VALUES LESS THAN (100) TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES DEFAULT
     ) TABLESPACE PDT_TBS4 LOB(I3) STORE AS ( TABLESPACE PDT_TBS5 );
Create success.

$P0> INSERT INTO T1 VALUES ( 0,   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 1,   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 50,   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 51,   'ABC', 'DEF' );
1 row inserted.

$P0> ALTER TABLE T1
     MERGE PARTITIONS P1, P2 INTO
         PARTITION P1;
Alter success.

-- result: 4
$P0> SELECT COUNT(*) FROM T1 PARTITION(P1);
