 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
--###################################################################
--# 인덱스 파티션을 직접 지정하는 경우
--###################################################################

--###################################################################
--+SECTOR 1; PREPARATION
--###################################################################

--+SKIP BEGIN; 
$P0> DROP TABLE T1;
$P0> DROP TABLE T2;
$P0> DROP TABLE T3;
--+SKIP END; 

--+APPEND_LST Schema_Index_Partition.sql;
>>> [Schema_Index_Partition.sql] BEGIN <<<
DROP TABLE T1;
DROP TABLE T2;
DROP TABLE T3;

CREATE TABLE T1( I1 INTEGER, I2 INTEGER, I3 INTEGER )
PARTITION BY HASH(I1)
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

INSERT INTO T1 VALUES (0, 100, 100);
INSERT INTO T1 VALUES (50, 100, 100);
INSERT INTO T1 VALUES (100, 100, 100);
INSERT INTO T1 VALUES (150, 100, 100);
INSERT INTO T1 VALUES (200, 100, 100);
INSERT INTO T1 VALUES (250, 100, 100);
INSERT INTO T1 VALUES (300, 100, 100);
INSERT INTO T1 VALUES (350, 100, 100);


CREATE TABLE T2( I1 INTEGER, I2 INTEGER, I3 INTEGER )
PARTITION BY HASH(I1, I2)
(
    PARTITION P1 TABLESPACE PDT_TBS2,
    PARTITION P2 TABLESPACE PDT_TBS3,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

INSERT INTO T2 VALUES (0, 100, 100);
INSERT INTO T2 VALUES (50, 100, 100);
INSERT INTO T2 VALUES (100, 100, 100);
INSERT INTO T2 VALUES (150, 100, 100);
INSERT INTO T2 VALUES (200, 100, 100);
INSERT INTO T2 VALUES (250, 100, 100);
INSERT INTO T2 VALUES (300, 100, 100);
INSERT INTO T2 VALUES (350, 100, 100);

CREATE INDEX IDX1 ON T2(I1, I3);

CREATE INDEX IDX2 ON T2(I3, I1, I2);

CREATE INDEX IDX3 ON T2(I2, I3);

CREATE INDEX IDX4 ON T2(I1) LOCAL;>>> [Schema_Index_Partition.sql] END <<<
--+SYSTEM is -silent -f Schema_Index_Partition.sql;

--###################################################################
--+SECTOR 2; 문법 체크
--###################################################################
-- should be fail
$P0> ALTER TABLE T1 
     ADD
     PARTITION P5 TABLESPACE PDT_TBS2
         INDEX ( IDX1 PARTITION P5_IDX1 TABLESPACE PDT_TBS3,
                 IDX2 PARTITION P5_IDX2 TABLESPACE PDT_TBS4 )
         LOB STORE AS ( TABLESPACE PDT_TBS2 );
[ERR-31001 : SQL syntax error 

line 6: parse error
         LOB STORE AS ( TABLESPACE PDT_TBS2 )
         ^ ^

]

-- should be fail
$P0> ALTER TABLE T1 
     ADD
     PARTITION P6 TABLESPACE PDT_TBS3
         INDEX ( IDX1 PARTITION P6_IDX1 TABLESPACE PDT_TBS3,
                 IDX2 PARTITION P6_IDX2 TABLESPACE PDT_TBS4 
                     LOB STORE AS ( TABLESPACE PDT_TBS2 ) );
[ERR-31001 : SQL syntax error 

line 6: parse error
                     LOB STORE AS ( TABLESPACE PDT_TBS2 ) )
                     ^ ^

]


