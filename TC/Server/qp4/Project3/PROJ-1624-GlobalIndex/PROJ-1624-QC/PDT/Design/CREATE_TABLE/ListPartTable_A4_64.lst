     PARTITION BY LIST (I1)
     ( PARTITION P1 VALUES (100, 110, 120),
       PARTITION P2 VALUES (200, 210, 220),
       PARTITION P3 VALUES (300, 310, 320),
       PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

