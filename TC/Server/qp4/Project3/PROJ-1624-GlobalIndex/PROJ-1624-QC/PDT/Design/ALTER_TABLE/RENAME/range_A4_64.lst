 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
--######################################################
-- RENAME PARTITIOIN
--######################################################

--###################################
--+SECTOR 1; INTIALIZE
--###################################

--+SKIP BEGIN; 
$P0> DROP TABLE PDT_RANGE;
--+SKIP END; 

$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

$P0> CREATE INDEX IDX ON PDT_RANGE(F1);
Create success.

--#########################################
--+SECTOR 2; DO JOB #1 (1. Basic Test)
--#########################################

$P0> ALTER TABLE PDT_RANGE
     RENAME PARTITION P1 TO P1_1;
Alter success.

--#########################################
--+SECTOR 3; DO JOB #2 (2. Validation Test)
--#########################################

----------------------------
-- 2.1 파티션 이름 중복 검사
----------------------------
-- should be fail
$P0> ALTER TABLE PDT_RANGE
     RENAME PARTITION P1_1 TO P1_1;
[ERR-31270 : The partition name is already used by the partitioned table 
0002 :      RENAME PARTITION P1_1 TO P1_1
                                    ^   ^
]

$P0> ALTER TABLE PDT_RANGE
     RENAME PARTITION P1_1 TO P3;
[ERR-31270 : The partition name is already used by the partitioned table 
0002 :      RENAME PARTITION P1_1 TO P3
                                    ^ ^
]


--#########################################
--+SECTOR 4; DO JOB #3 (3. Execution Test)
--#########################################

$P0> DROP TABLE PDT_RANGE;
Drop success.
$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 0 );
1 row inserted.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE PDT_RANGE
     RENAME PARTITION P1 TO P1_1;
Alter success.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
4                    
1 row selected.

-- should be 1
$P0> SELECT COUNT(*) FROM PDT_RANGE PARTITION( P1_1 );
COUNT                
-----------------------
1                    
1 row selected.
-- should be fail
$P0> SELECT COUNT(*) FROM PDT_RANGE PARTITION( P1 );
[ERR-3125B : The table partition does not exist. ]


--###################################
--+SECTOR 5; FINALIZE
--###################################

$P0> DROP TABLE PDT_RANGE;
Drop success.

