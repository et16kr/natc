$T0> CREATE TABLE PT_RANGE ( I1 INTEGER, I2 VARCHAR(1000), I3 BLOB, I4 NUMERIC(10, 5), I5 DATE )
PARTITION BY RANGE (I1, I2, I4)
( PARTITION P1 VALUES LESS THAN (100, 'ABC', 100.505 ) 
                   TABLESPACE PDT_TBS2 LOB STORE AS ( TABLESPACE PDT_TBS3 ),
  PARTITION P2 VALUES LESS THAN (200, 'DEF', 200.505)
                   TABLESPACE PDT_TBS3 LOB STORE AS ( TABLESPACE PDT_TBS4 ),
  PARTITION P3 VALUES LESS THAN (300, 'GHI', 300.505)
                   TABLESPACE PDT_TBS4 LOB STORE AS ( TABLESPACE PDT_TBS5 ),
  PARTITION P4 VALUES DEFAULT TABLESPACE PDT_TBS5
) TABLESPACE PDT_TBS;
Create success.
