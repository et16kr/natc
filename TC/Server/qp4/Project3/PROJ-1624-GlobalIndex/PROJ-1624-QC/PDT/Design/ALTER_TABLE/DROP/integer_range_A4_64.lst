 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
--######################################################
-- DROP PARTITIOIN ( PK:INTEGER )
--######################################################

--###################################
--+SECTOR 1; INTIALIZE
--###################################

--+SKIP BEGIN; 
$P0> DROP TABLE PDT_RANGE;
--+SKIP END; 

$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.


--#########################################
--+SECTOR 2; DO JOB #1 (1. Basic Test)
--#########################################

$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 0 );
1 row inserted.

$P0> SELECT F1 FROM PDT_RANGE PARTITION( P1 );
F1          
--------------
0           
1 row selected.
$P0> SELECT F1 FROM PDT_RANGE PARTITION( P2 );
F1          
--------------
10          
1 row selected.
$P0> SELECT F1 FROM PDT_RANGE PARTITION( P3 );
F1          
--------------
20          
1 row selected.
$P0> SELECT F1 FROM PDT_RANGE PARTITION( P4 );
F1          
--------------
30          
1 row selected.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P1;
Alter success.

-- should be [10, 20, 30]
$P0> SELECT F1 FROM PDT_RANGE;
F1          
--------------
10          
20          
30          
3 rows selected.


--#########################################
--+SECTOR 3; DO JOB #2 (2. Validation Test)
--#########################################

----------------------------
-- 2.1 최소 파티션 개수 유지
----------------------------
-- should be success
$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P2;
Alter success.
-- should be success
$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P3;
Alter success.
-- should be fail
$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P4;
[ERR-31276 : Cannot drop the only partition from a partitioned table]

--------------------------------------
-- 2.2 기본 파티션 삭제 허용 여부 검사
--------------------------------------
$P0> DROP TABLE PDT_RANGE;
Drop success.

$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

-- should be fail
$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P4;
[ERR-31277 : Cannot drop the default partition]


--#########################################
--+SECTOR 4; DO JOB #3 (3. Execution Test)
--#########################################

-------------------------------------
-- 3.1 이웃 파티션의 파티션 조건 수정
-------------------------------------
$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 0 );
1 row inserted.

$P0> SELECT F1 FROM PDT_RANGE PARTITION( P1 );
F1          
--------------
0           
1 row selected.
$P0> SELECT F1 FROM PDT_RANGE PARTITION( P2 );
F1          
--------------
10          
1 row selected.
$P0> SELECT F1 FROM PDT_RANGE PARTITION( P3 );
F1          
--------------
20          
1 row selected.
$P0> SELECT F1 FROM PDT_RANGE PARTITION( P4 );
F1          
--------------
30          
1 row selected.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P1;
Alter success.

-- should be 3
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
3                    
1 row selected.

$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.

-- should be 2
$P0> SELECT COUNT(*) FROM PDT_RANGE PARTITION( P2 );
COUNT                
-----------------------
2                    
1 row selected.

$P0> ALTER TABLE PDT_RANGE
     DROP PARTITION P3;
Alter success.

-- should be 3
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
3                    
1 row selected.

$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.

-- should be 2
$P0> SELECT COUNT(*) FROM PDT_RANGE PARTITION( P4 );
COUNT                
-----------------------
2                    
1 row selected.


