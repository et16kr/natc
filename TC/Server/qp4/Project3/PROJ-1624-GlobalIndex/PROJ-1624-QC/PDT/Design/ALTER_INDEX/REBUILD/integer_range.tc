########################################################
## REBUILD INDEX ON RANGE PDT( PK:INTEGER )
########################################################

#####################################
##SECTOR; INTIALIZE
#####################################

DEF MAIN()
{
SKIP BEGIN;
DROP TABLE PDT_RANGE;
SKIP END;


###########################################
##SECTOR; DO JOB #1 (1. Basic Test)
###########################################

############################
## 2.1 Unique index
############################
CREATE TABLE PDT_RANGE
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( 10 ),
    PARTITION P2 VALUES LESS THAN ( 20 ),
    PARTITION P3 VALUES LESS THAN ( 30 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;
INSERT INTO PDT_RANGE VALUES( 0, 0 );
INSERT INTO PDT_RANGE VALUES( 5, 0 );
INSERT INTO PDT_RANGE VALUES( 10, 0 );
INSERT INTO PDT_RANGE VALUES( 15, 0 );
INSERT INTO PDT_RANGE VALUES( 20, 0 );
INSERT INTO PDT_RANGE VALUES( 25, 0 );
INSERT INTO PDT_RANGE VALUES( 30, 0 );
INSERT INTO PDT_RANGE VALUES( 35, 0 );

CREATE UNIQUE INDEX IDX1 
ON PDT_RANGE( F1 );

## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P1 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P2 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P3 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P4 );

ALTER INDEX IDX1 REBUILD;

## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P1 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P2 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P3 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_RANGE, IDX1 ) */ COUNT(*)
FROM PDT_RANGE PARTITION( P4 );

############################
## 2.2 Non-Unique Index
############################
