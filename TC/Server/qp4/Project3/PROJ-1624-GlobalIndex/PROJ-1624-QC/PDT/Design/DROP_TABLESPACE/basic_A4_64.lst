$P0> --+PROCESS P0;
--###################################################################
--# DROP TABLESPACE
--###################################################################

--###################################################################
--+SECTOR 1; PREPARATION
--###################################################################
--+SKIP BEGIN; 
$P0> DROP TABLE T1;
$P0> DROP TABLE T2;
$P0> DROP TABLE T3;

$P0> DROP TABLESPACE TBS1
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;

$P0> DROP TABLESPACE TBS2
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;

$P0> DROP TABLESPACE TBS3
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;

$P0> DROP TABLESPACE TBS4
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;

$P0> DROP TABLESPACE TBS5
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;
--+SKIP END; 

$P0> CREATE TABLESPACE TBS1
     DATAFILE 'TBS1.dbf'
     SIZE 10M
     AUTOEXTEND ON;
Create success.

$P0> CREATE TABLESPACE TBS2
     DATAFILE 'TBS2.dbf'
     SIZE 10M
     AUTOEXTEND ON;
Create success.

$P0> CREATE TABLESPACE TBS3
     DATAFILE 'TBS3.dbf'
     SIZE 10M
     AUTOEXTEND ON;
