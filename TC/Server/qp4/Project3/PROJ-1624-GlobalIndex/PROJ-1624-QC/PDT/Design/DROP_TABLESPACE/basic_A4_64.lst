$P0> CREATE TABLE T1 ( I1 INTEGER, I2 INTEGER, I3 BLOB, I4 CLOB )
     PARTITION BY RANGE (I1)
     ( PARTITION P1 VALUES LESS THAN (100) TABLESPACE TBS4
                                         LOB(I3, I4) STORE AS ( TABLESPACE TBS2 ), 
       PARTITION P2 VALUES LESS THAN (200) TABLESPACE TBS3,
       PARTITION P3 VALUES LESS THAN (300),
       PARTITION P4 VALUES DEFAULT
     ) TABLESPACE TBS1 LOB(I4) STORE AS ( TABLESPACE TBS5 );
