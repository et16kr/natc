--------------------------------
-- 테이블 파티션이 하나의 TBS에 다 들어가 있는 경우
--------------------------------
$P0> DROP TABLE T1;
[ERR-31031 : Table or view was not found : 
0001 : DROP TABLE T1
                 ^ ^
]

$P0> CREATE TABLE T1 ( I1 INTEGER, I2 INTEGER )
     PARTITION BY RANGE(I1, I2)
     (
         PARTITION P1 VALUES LESS THAN (100),
         PARTITION P2 VALUES LESS THAN (200),
         PARTITION P3 VALUES LESS THAN (300),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE TBS1;
Create success.

-- should be success
$P0> DROP TABLESPACE TBS1
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;
Drop success.

-- should be 0
$P0> SELECT COUNT(*)
     FROM SYSTEM_.SYS_TABLE_PARTITIONS_ PART,
          SYSTEM_.SYS_TABLES_ TAB
     WHERE TAB.TABLE_NAME='T1' AND
           PART.TABLE_ID=TAB.TABLE_ID;
COUNT                
-----------------------
0                    
1 row selected.

-- should be 0
$P0> SELECT COUNT(*)
     FROM SYSTEM_.SYS_INDEX_PARTITIONS_ PART,
          SYSTEM_.SYS_INDICES_ IND
     WHERE PART.INDEX_ID = IND.INDEX_ID;
COUNT                
-----------------------
0                    
1 row selected.

$P0> CREATE TABLESPACE TBS1
     DATAFILE 'TBS1.dbf'
     SIZE 10M
     AUTOEXTEND ON;
Create success.

