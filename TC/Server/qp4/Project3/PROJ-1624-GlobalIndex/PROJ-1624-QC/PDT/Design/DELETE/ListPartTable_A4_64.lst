]

-- should be success
$P0> CREATE TABLE T1 ( I1 INTEGER UNIQUE, I2 BIGINT , I3 SMALLINT )
     PARTITION BY LIST (I1)
     ( PARTITION P1 VALUES (100) TABLESPACE PDT_TBS2,
       PARTITION P2 VALUES (200) TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES (300) TABLESPACE PDT_TBS4,
       PARTITION P4 VALUES DEFAULT TABLESPACE PDT_TBS5
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO T1 VALUES (NULL, 100, 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES (100, 110, 110);
1 row inserted.
$P0> INSERT INTO T1 VALUES (200, 120, 120);
1 row inserted.
$P0> INSERT INTO T1 VALUES (300, 130, 130);
1 row inserted.

$P0> DELETE FROM T1 PARTITION(P1);
1 row deleted.
$P0> DELETE FROM T1 PARTITION(P2);
1 row deleted.
$P0> DELETE FROM T1 PARTITION(P3);
1 row deleted.
$P0> DELETE FROM T1 PARTITION(P4);
1 row deleted.

-- should be {}
$P0> SELECT * FROM T1 ORDER BY I1;
T1.I1       T1.I2                T1.I3       
-------------------------------------------------
No rows selected.


