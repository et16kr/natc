$P0> CREATE TABLE T1
     (
         I1   INTEGER,
         I2   INTEGER
     )
     PARTITION BY HASH( I1 )
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
Create success.

$P0> CREATE OR REPLACE PROCEDURE PROC_INSERT( FROM_IDX IN INTEGER,
                                              TO_IDX   IN INTEGER )
     AS
     BEGIN
         FOR I IN FROM_IDX .. TO_IDX LOOP
             INSERT INTO T1 VALUES ( I, I );
         END LOOP;
     END;
     /
Create success.

