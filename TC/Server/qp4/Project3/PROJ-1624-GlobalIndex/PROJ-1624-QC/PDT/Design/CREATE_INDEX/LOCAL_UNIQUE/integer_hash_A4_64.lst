----------------------------------------
-- 2.1 CREATING INDEX USING CREATE_TABLE
----------------------------------------
$P0> CREATE TABLE PDT_HASH
     (
         F1   INTEGER UNIQUE,
         F2   INTEGER
     ) 
     PARTITION BY HASH( F1 )
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
Create success.
