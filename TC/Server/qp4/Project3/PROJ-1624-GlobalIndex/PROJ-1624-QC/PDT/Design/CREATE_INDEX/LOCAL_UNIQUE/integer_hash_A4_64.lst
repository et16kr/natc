-----------------------------------------
-- 3.3 Local Unique violation
-----------------------------------------
$P0> DROP TABLE PDT_HASH;
Drop success.
$P0> CREATE TABLE PDT_HASH
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY HASH( F1 )
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_HASH VALUES( 7, 2 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 6, 3 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 5, 4 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 4, 5 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 3, 6 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 2, 7 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 1, 0 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 0, 1 );
1 row inserted.

$P0> CREATE UNIQUE INDEX IDX 
     ON PDT_HASH( F2 );
Create success.

$P0> INSERT INTO PDT_HASH VALUES( 7, 3 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 6, 4 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 5, 5 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 4, 6 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 3, 7 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 2, 0 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 1, 1 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_HASH VALUES( 0, 2 );
[ERR-11058 : The row already exists in a unique index.]

-- should be 2
$P0> SELECT COUNT(*) FROM PDT_HASH 
     WHERE F2 = 3;
COUNT                
-----------------------
1                    
1 row selected.

-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 7, 2 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 6, 3 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 5, 4 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 4, 5 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 3, 6 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 2, 7 );
[ERR-11058 : The row already exists in a unique index.]
-- should be fail
$P0> INSERT INTO PDT_HASH VALUES( 1, 0 );
[ERR-11058 : The row already exists in a unique index.]
