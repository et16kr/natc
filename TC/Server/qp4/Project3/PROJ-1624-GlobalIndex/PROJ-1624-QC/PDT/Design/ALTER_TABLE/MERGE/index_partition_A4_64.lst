# ==> [Schema_Index_Partition.sql] BEGIN <=
--+SKIP BEGIN; 
$P0> DROP TABLE T1;
$P0> DROP TABLE T2;
$P0> DROP TABLE T3;

$P0> CREATE TABLE T1( I1 INTEGER, I2 INTEGER, I3 INTEGER )
     PARTITION BY RANGE (I1)
     (
         PARTITION P1 VALUES LESS THAN (100),
         PARTITION P2 VALUES LESS THAN (200),
         PARTITION P3 VALUES LESS THAN (300),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;

$P0> INSERT INTO T1 VALUES (0, 100, 100);
$P0> INSERT INTO T1 VALUES (50, 100, 100);
$P0> INSERT INTO T1 VALUES (100, 100, 100);
$P0> INSERT INTO T1 VALUES (150, 100, 100);
$P0> INSERT INTO T1 VALUES (200, 100, 100);
$P0> INSERT INTO T1 VALUES (250, 100, 100);
$P0> INSERT INTO T1 VALUES (300, 100, 100);
$P0> INSERT INTO T1 VALUES (350, 100, 100);


$P0> CREATE TABLE T2( I1 INTEGER, I2 INTEGER, I3 INTEGER )
     PARTITION BY RANGE (I1, I2)
     (
         PARTITION P1 VALUES LESS THAN (100) TABLESPACE PDT_TBS2,
         PARTITION P2 VALUES LESS THAN (200) TABLESPACE PDT_TBS3,
         PARTITION P3 VALUES LESS THAN (300),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;

$P0> INSERT INTO T2 VALUES (0, 100, 100);
$P0> INSERT INTO T2 VALUES (50, 100, 100);
$P0> INSERT INTO T2 VALUES (100, 100, 100);
$P0> INSERT INTO T2 VALUES (150, 100, 100);
$P0> INSERT INTO T2 VALUES (200, 100, 100);
$P0> INSERT INTO T2 VALUES (250, 100, 100);
$P0> INSERT INTO T2 VALUES (300, 100, 100);
$P0> INSERT INTO T2 VALUES (350, 100, 100);

$P0> CREATE INDEX IDX1 ON T2(I1, I3) LOCAL
     (
         PARTITION P1_IDX1 ON P1 TABLESPACE PDT_TBS2,
         PARTITION P2_IDX1 ON P2 TABLESPACE PDT_TBS3,
         PARTITION P3_IDX1 ON P3 TABLESPACE PDT_TBS4,
         PARTITION P4_IDX1 ON P4 TABLESPACE PDT_TBS5
     );

$P0> CREATE INDEX IDX2 ON T2(I3, I1, I2) LOCAL
     (
         PARTITION P1_IDX2 ON P1 TABLESPACE PDT_TBS5,
         PARTITION P2_IDX2 ON P2 TABLESPACE PDT_TBS4,
         PARTITION P3_IDX2 ON P3 TABLESPACE PDT_TBS3,
         PARTITION P4_IDX2 ON P4 TABLESPACE PDT_TBS2
     );

$P0> CREATE INDEX IDX3 ON T2(I2, I3) LOCAL
     (
         PARTITION P1_IDX3 ON P1,
         PARTITION P2_IDX3 ON P2 TABLESPACE PDT_TBS2,
         PARTITION P3_IDX3 ON P3,
         PARTITION P4_IDX3 ON P4 TABLESPACE PDT_TBS3
     );
--+SKIP END; 
# ==> [Schema_Index_Partition.sql] END <=

