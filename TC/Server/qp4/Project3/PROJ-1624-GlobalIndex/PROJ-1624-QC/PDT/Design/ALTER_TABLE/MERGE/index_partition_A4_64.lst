--##############################
--+SECTOR 9; LOB COLUMN이 있는 경우(인덱스 파티션에 TBS지정할 경우)
--##############################
--##############
--# Left In-place
--##############
# ==> [Schema_Index_Partition_Lob.sql] BEGIN <=
--+SKIP BEGIN; 
$P0> DROP TABLE T1;
$P0> DROP TABLE T2;
$P0> DROP TABLE T3;

$P0> CREATE TABLE T3 ( I1 INTEGER, I2 BLOB, I3 CLOB, I4 INTEGER )
     PARTITION BY RANGE (I1, I4)
     ( PARTITION P1 VALUES LESS THAN (100) TABLESPACE PDT_TBS2 
                                     LOB(I2, I3) STORE AS ( TABLESPACE PDT_TBS3 ), 
       PARTITION P2 VALUES LESS THAN (200) TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES LESS THAN (300),
       PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS LOB(I3) STORE AS ( TABLESPACE PDT_TBS5 );

$P0> INSERT INTO T3 VALUES (0,   'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (50,  'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (100, 'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (150, 'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (200, 'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (250, 'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (300, 'ABC', 'DEF', 100);
$P0> INSERT INTO T3 VALUES (350, 'ABC', 'DEF', 100);

$P0> CREATE INDEX IDX1 ON T3(I1) LOCAL
     (
