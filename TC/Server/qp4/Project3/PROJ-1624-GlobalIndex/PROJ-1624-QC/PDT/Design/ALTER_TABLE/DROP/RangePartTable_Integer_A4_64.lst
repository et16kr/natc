--##################################################################
--+SECTOR 7; SPLIT + MERGE + DROP
--##################################################################
--+SYSTEM is -silent -f Schema_Range_Integer.sql;

$P0> ALTER TABLE T1
     SPLIT PARTITION P1 AT (50) INTO
     (
         PARTITION P1_1, 
         PARTITION P1_2
     );
Alter success.

$P0> ALTER TABLE T1
     MERGE PARTITIONS P1_1, P1_2 INTO
     PARTITION P1;
Alter success.

$P0> ALTER TABLE T1
     DROP PARTITION P1;
Alter success.

$P0> ALTER TABLE T1
     MERGE PARTITIONS P2, P3 INTO
     PARTITION P2_3;
Alter success.

$P0> ALTER TABLE T1
     DROP PARTITION P2_3;
Alter success.

-- result: 2
$P0> SELECT COUNT(*) FROM T1;
COUNT                
-----------------------
2                    
1 row selected.

-- result: 300
$P0> SELECT /* INDEX ASC ( T1, IDX1 ) */ I1
     FROM T1 PARTITION (P4) LIMIT 1;
I1          
--------------
300         
1 row selected.


$P0> ALTER TABLE T2
     SPLIT PARTITION P1 AT (50) INTO
     (
         PARTITION P1_1, 
         PARTITION P1_2
     );
Alter success.

$P0> ALTER TABLE T2
     MERGE PARTITIONS P1_1, P1_2 INTO
     PARTITION P1;
Alter success.

$P0> ALTER TABLE T2
     DROP PARTITION P1;
Alter success.

$P0> ALTER TABLE T2
     MERGE PARTITIONS P2, P3 INTO
     PARTITION P2_3;
