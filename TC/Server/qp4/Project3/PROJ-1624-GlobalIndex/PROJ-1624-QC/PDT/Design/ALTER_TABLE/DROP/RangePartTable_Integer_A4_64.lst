--##############################
--+SECTOR 3; 문법 체크
--##############################
$P0> DROP TABLE TEST;
[ERR-31031 : Table or view was not found : 
0001 : DROP TABLE TEST
                 ^   ^
]
$P0> CREATE TABLE TEST( I1 INTEGER, I2 INTEGER )
     PARTITION BY RANGE(I1)
     (
         PARTITION P1 VALUES LESS THAN (100),
         PARTITION P2 VALUES LESS THAN (200),
         PARTITION P3 VALUES LESS THAN (300),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

-- should be fail
$P0> ALTER TABLE TEST 
     DROP PARTITION P1_1 TABLESPACE PDT_TBS2;
[ERR-31001 : SQL syntax error 

line 2: parse error
     DROP PARTITION P1_1 TABLESPACE PDT_TBS2
                         ^        ^

]

$P0> DROP TABLE TEST;
Drop success.

--##############################
--+SECTOR 4; 파티션드 테이블인지 체크
--##############################
$P0> DROP TABLE TEST;
[ERR-31031 : Table or view was not found : 
0001 : DROP TABLE TEST
                 ^   ^
]
$P0> CREATE TABLE TEST( I1 INTEGER, I2 INTEGER );
Create success.

-- should be fail
$P0> ALTER TABLE TEST 
     DROP PARTITION P1_1;
[ERR-31268 : Unable to alter table partition on non-partitioned table]

$P0> DROP TABLE TEST;
Drop success.


--##############################
--+SECTOR 5; 파티션 이름 체크
--##############################
--+SYSTEM is -silent -f Schema_Range_Integer.sql;

-- should be fail
$P0> ALTER TABLE T1 
     DROP PARTITION P5;
[ERR-3125B : The table partition does not exist. 
0002 :      DROP PARTITION P5
                          ^ ^
]

-- should be fail
$P0> ALTER TABLE T1 
     DROP PARTITION P4;
[ERR-31277 : Cannot drop the default partition]

-- should be success
$P0> ALTER TABLE T1 
     DROP PARTITION P3;
Alter success.

-- should be success
$P0> ALTER TABLE T1 
     DROP PARTITION P2;
Alter success.

-- should be success
$P0> ALTER TABLE T1 
     DROP PARTITION P1;
Alter success.



--##############################
--+SECTOR 6; LOB 컬럼이 있는 경우의 DROP PARTITION
--##############################
$P0> DROP TABLE T1;
Drop success.
$P0> CREATE TABLE T1 ( I1 INTEGER, I2 BLOB, I3 CLOB )
     PARTITION BY RANGE(I1) 
     ( PARTITION P1 VALUES LESS THAN (100) TABLESPACE PDT_TBS 
                             LOB(I2, I3) STORE AS ( TABLESPACE PDT_TBS2 ), 
       PARTITION P2 VALUES LESS THAN (200) TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES DEFAULT
     ) TABLESPACE PDT_TBS4 LOB(I3) STORE AS ( TABLESPACE PDT_TBS5 );
Create success.

$P0> INSERT INTO T1 VALUES ( 100,   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 150,   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 200,   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 250,   'ABC', 'DEF' );
1 row inserted.

-- should be fail
$P0> ALTER TABLE T1
     DROP PARTITION P3;
[ERR-31277 : Cannot drop the default partition]

-- result: 4
$P0> SELECT COUNT(*) FROM T1;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE T1
     DROP PARTITION P2;
Alter success.

-- result: 2
$P0> SELECT COUNT(*) FROM T1;
COUNT                
-----------------------
2                    
1 row selected.

