------------------------------------------
-- 3.3 DISTIBUTION
------------------------------------------
$P0> DROP TABLE PDT;
Drop success.
$P0> CREATE TABLE PDT
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY HASH( F1 )
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
Create success.

$P0> CREATE OR REPLACE PROCEDURE PROC_INSERT( FROM_IDX IN INTEGER,
                                              TO_IDX   IN INTEGER ) 
     AS
     BEGIN
         FOR I IN FROM_IDX .. TO_IDX LOOP
             INSERT INTO PDT VALUES ( I, I );
         END LOOP;
     END;
     /
Create success.

$P0> EXECUTE PROC_INSERT( 1, 10000 );
Execute success.

$P0> SELECT COUNT(*) FROM PDT PARTITION( P1 );
