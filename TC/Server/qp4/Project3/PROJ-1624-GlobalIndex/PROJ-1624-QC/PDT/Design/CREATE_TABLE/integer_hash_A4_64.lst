0001 : DROP TABLE PDT
                 ^  ^
]
$P0> CREATE TABLE PDT
     (
         F1   INTEGER PRIMARY KEY,
         F2   INTEGER
     ) 
     PARTITION BY HASH( F1 )
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
Create success.

