[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_LIST VALUES( 20, 15 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_LIST VALUES( 15, 20 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_LIST VALUES( 10, 25 );
[ERR-11058 : The row already exists in a unique index.]

-- should be 2
$P0> SELECT COUNT(*) FROM PDT_LIST 
     WHERE F2 = 20;
COUNT                
-----------------------
