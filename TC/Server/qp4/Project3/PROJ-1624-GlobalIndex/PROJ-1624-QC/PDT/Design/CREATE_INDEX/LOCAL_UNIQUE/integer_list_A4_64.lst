-----------------------------------------
-- 3.1 Preserved Order(프리픽스드 인덱스)
-----------------------------------------
$P0> DROP TABLE PDT_LIST;
Drop success.
$P0> CREATE TABLE PDT_LIST
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10, 15 ),
         PARTITION P2 VALUES ( 20, 25 ),
         PARTITION P3 VALUES ( 30, 35 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_LIST VALUES( 45, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 40, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 35, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 30, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 25, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 15, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 10, 0 );
1 row inserted.

$P0> CREATE UNIQUE INDEX IDX 
     ON PDT_LIST( F1 ) LOCAL;
Create success.

-- should be {10,15,20,25,30,35,40,45}
$P0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX ) */ F1
     FROM PDT_LIST;
F1          
--------------
40          
45          
30          
35          
20          
25          
10          
15          
8 rows selected.

