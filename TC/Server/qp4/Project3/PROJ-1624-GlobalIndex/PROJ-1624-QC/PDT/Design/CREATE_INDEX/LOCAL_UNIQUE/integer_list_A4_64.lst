1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 10, 15 );
1 row inserted.

$P0> CREATE UNIQUE INDEX IDX 
     ON PDT_LIST( F2 );
Create success.

$P0> INSERT INTO PDT_LIST VALUES( 45, 30 );
[ERR-11058 : The row already exists in a unique index.]
$P0> INSERT INTO PDT_LIST VALUES( 40, 35 );
[ERR-11058 : The row already exists in a unique index.]
