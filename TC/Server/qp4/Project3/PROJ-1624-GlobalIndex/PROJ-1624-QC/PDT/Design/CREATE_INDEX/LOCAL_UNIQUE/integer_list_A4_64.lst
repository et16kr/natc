-----------------------------------------
-- 3.3 Local Unique violation
-----------------------------------------
$P0> DROP TABLE PDT_LIST;
Drop success.
$P0> CREATE TABLE PDT_LIST
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10, 15 ),
         PARTITION P2 VALUES ( 20, 25 ),
         PARTITION P3 VALUES ( 30, 35 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_LIST VALUES( 45, 20 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 40, 25 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 35, 30 );
