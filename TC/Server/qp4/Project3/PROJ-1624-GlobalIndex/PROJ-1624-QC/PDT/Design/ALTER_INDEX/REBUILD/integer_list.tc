SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P1 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P2 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P3 );
## should be 2
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P4 );


###########################################
##SECTOR; DO JOB #2 (2. Validation Test)
###########################################

############################
## 2.1 파티셔너블 객체 검사 
############################
DROP TABLE T;
CREATE TABLE T
(
    F1   INTEGER,
    F2   INTEGER
);
CREATE INDEX IDX
ON T( F1 );

## should be fail
ALTER INDEX IDX REBUILD PARTITION T;

##################################
## 2.2 파티션 이름 검사
##################################
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( 10, 15 ),
    PARTITION P2 VALUES ( 20, 25 ),
    PARTITION P3 VALUES ( 30, 35 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE INDEX IDX1 
ON PDT_LIST( F1 );

## should be fail
ALTER INDEX IDX1 REBUILD PARTITION IDX_P5;


###########################################
##SECTOR; DO JOB #3 (3. Execution Test)
###########################################

########################################
## 3.1 프리픽스드 인덱스
########################################
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( 10, 15 ),
    PARTITION P2 VALUES ( 20, 25 ),
    PARTITION P3 VALUES ( 30, 35 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;
INSERT INTO PDT_LIST VALUES( 45, 0 );
INSERT INTO PDT_LIST VALUES( 40, 0 );
INSERT INTO PDT_LIST VALUES( 35, 0 );
INSERT INTO PDT_LIST VALUES( 30, 0 );
INSERT INTO PDT_LIST VALUES( 25, 0 );
INSERT INTO PDT_LIST VALUES( 20, 0 );
INSERT INTO PDT_LIST VALUES( 15, 0 );
INSERT INTO PDT_LIST VALUES( 10, 0 );

CREATE UNIQUE INDEX IDX1 
ON PDT_LIST( F1 );

## should be {10,15,20,25,30,35,40,45}
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ F1
FROM PDT_LIST;

ALTER INDEX IDX1 REBUILD PARTITION IDX_P1;
ALTER INDEX IDX1 REBUILD PARTITION IDX_P2;
ALTER INDEX IDX1 REBUILD PARTITION IDX_P3;
ALTER INDEX IDX1 REBUILD PARTITION IDX_P4;

## should be {10,15,20,25,30,35,40,45}
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ F1
FROM PDT_LIST;

##############################################
## 3.2 논프리픽스드 인덱스
##############################################
DROP TABLE PDT_LIST;
CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( 10, 15 ),
    PARTITION P2 VALUES ( 20, 25 ),
    PARTITION P3 VALUES ( 30, 35 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;
INSERT INTO PDT_LIST VALUES( 45, 20 );
INSERT INTO PDT_LIST VALUES( 40, 25 );
INSERT INTO PDT_LIST VALUES( 35, 30 );
INSERT INTO PDT_LIST VALUES( 30, 35 );
INSERT INTO PDT_LIST VALUES( 25, 40 );
INSERT INTO PDT_LIST VALUES( 20, 45 );
INSERT INTO PDT_LIST VALUES( 15, 10 );
INSERT INTO PDT_LIST VALUES( 10, 15 );

CREATE INDEX IDX1 
ON PDT_LIST( F2 );

## will be {20,25,30,35,40,45,10,15}
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ F2
FROM PDT_LIST;

ALTER INDEX IDX1 REBUILD;
## will be {20,25,30,35,40,45,10,15}
SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ F2
FROM PDT_LIST;


#####################################
##SECTOR; FINALIZE
#####################################

DROP TABLE PDT_LIST;
}