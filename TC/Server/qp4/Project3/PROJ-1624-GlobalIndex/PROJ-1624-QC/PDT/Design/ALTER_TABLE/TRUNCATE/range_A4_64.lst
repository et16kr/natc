$P0> --+PROCESS P0;
--######################################################
-- TRUNCATE PARTITIOIN
--######################################################

--###################################
--+SECTOR 1; INTIALIZE
--###################################

--+SKIP BEGIN; 
$P0> DROP TABLE T1 CASCADE;
$P0> DROP TABLE PDT_RANGE CASCADE;
--+SKIP END; 

$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.


--#########################################
--+SECTOR 2; DO JOB #1 (1. Basic Test)
--#########################################

$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 0 );
1 row inserted.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE PDT_RANGE
     TRUNCATE PARTITION P1;
Alter success.

-- should be 3
$P0> SELECT COUNT(*) FROM PDT_RANGE;
COUNT                
-----------------------
3                    
1 row selected.

-- should be 0
$P0> SELECT COUNT(*) FROM PDT_RANGE PARTITION( P1 );
COUNT                
-----------------------
0                    
1 row selected.


