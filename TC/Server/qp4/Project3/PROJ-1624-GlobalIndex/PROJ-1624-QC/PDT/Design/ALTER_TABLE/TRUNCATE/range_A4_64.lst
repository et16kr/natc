     TRUNCATE PARTITION P5;
[ERR-3125B : The table partition does not exist. 
0002 :      TRUNCATE PARTITION P5
                              ^ ^
]

----------------------------
-- 2.2 참조키 검사 
----------------------------
$P0> DROP TABLE PDT_RANGE CASCADE;
Drop success.
$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER PRIMARY KEY,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 0 );
1 row inserted.

$P0> CREATE TABLE T1
     (
         F1  INTEGER CONSTRAINT FK_CONST REFERENCES PDT_RANGE( F1 ),
         F2  INTEGER
     );
Create success.

-- should be fail
$P0> ALTER TABLE PDT_RANGE
     TRUNCATE PARTITION P1;
[ERR-3102A : A foreign key constraint depends on the table or column.]


