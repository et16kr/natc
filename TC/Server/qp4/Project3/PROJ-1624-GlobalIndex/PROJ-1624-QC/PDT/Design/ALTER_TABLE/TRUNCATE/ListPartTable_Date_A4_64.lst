INSERT INTO T1 VALUES (TO_DATE('2007-06-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T1 VALUES (TO_DATE('2007-07-01', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T1 VALUES (TO_DATE('2007-07-15', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T1 VALUES (TO_DATE('2007-07-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T1 VALUES (TO_DATE('2007-08-01', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T1 VALUES (TO_DATE('2007-08-15', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T1 VALUES (TO_DATE('2007-08-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);


CREATE TABLE T2( I1 DATE, I2 DATE, I3 INTEGER )
PARTITION BY LIST (I1)
(
    PARTITION P1 VALUES ( TO_DATE('2007-05-01', 'YYYY-MM-DD'), TO_DATE('2007-05-15', 'YYYY-MM-DD'), TO_DATE('2007-05-30', 'YYYY-MM-DD') ) TABLESPACE PDT_TBS2,
    PARTITION P2 VALUES ( TO_DATE('2007-06-01', 'YYYY-MM-DD'), TO_DATE('2007-06-15', 'YYYY-MM-DD'), TO_DATE('2007-06-30', 'YYYY-MM-DD'), NULL ) TABLESPACE PDT_TBS3,
    PARTITION P3 VALUES ( TO_DATE('2007-07-01', 'YYYY-MM-DD'), TO_DATE('2007-07-15', 'YYYY-MM-DD'), TO_DATE('2007-07-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT TABLESPACE PDT_TBS4
) TABLESPACE PDT_TBS;

INSERT INTO T2 VALUES (NULL, TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-05-01', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-05-15', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-05-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-06-01', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-06-15', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-06-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-07-01', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-07-15', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-07-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-08-01', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-08-15', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);
INSERT INTO T2 VALUES (TO_DATE('2007-08-30', 'YYYY-MM-DD'), TO_DATE('2007-05-01', 'YYYY-MM-DD'), 100);

CREATE INDEX IDX1 ON T2(I1, I3);

CREATE INDEX IDX2 ON T2(I3, I1, I2);

CREATE INDEX IDX3 ON T2(I2, I3);

CREATE INDEX IDX4 ON T2(I1) LOCAL
(
    PARTITION IDX1_P3 ON P3,
    PARTITION IDX1_P4 ON P4
);
