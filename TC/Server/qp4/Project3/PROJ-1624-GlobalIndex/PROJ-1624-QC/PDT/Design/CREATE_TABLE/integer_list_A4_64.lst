$P0> --+PROCESS P0;
--######################################################
-- CREATE LIST PARTITIONED DISK TABLE 
-- PARTITION KEY : INTEGER
--######################################################

--###################################
--+SECTOR 1; INTIALIZE
--###################################

--+SKIP BEGIN; 
$P0> DROP TABLE PDT;
--+SKIP END; 

--#########################################
--+SECTOR 2; DO JOB #1 (1. Basic Test)
--#########################################

$P0> CREATE TABLE PDT
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10 ),
         PARTITION P2 VALUES ( 20 ),
         PARTITION P3 VALUES ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO PDT VALUES( 10, 0 );
1 row inserted.

$P0> INSERT INTO PDT VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT VALUES( 20, 0 );
1 row inserted.

$P0> INSERT INTO PDT VALUES( 30, 0 );
1 row inserted.
$P0> INSERT INTO PDT VALUES( 30, 0 );
1 row inserted.
$P0> INSERT INTO PDT VALUES( 30, 0 );
1 row inserted.

$P0> INSERT INTO PDT VALUES( 40, 0 );
1 row inserted.
$P0> INSERT INTO PDT VALUES( 40, 0 );
1 row inserted.
$P0> INSERT INTO PDT VALUES( 40, 0 );
1 row inserted.
$P0> INSERT INTO PDT VALUES( 40, 0 );
1 row inserted.

-- are u sure that COUNT(*) is 1
$P0> SELECT COUNT(*) FROM PDT PARTITION( P1 );
COUNT                
-----------------------
1                    
1 row selected.
-- are u sure that COUNT(*) is 2
$P0> SELECT COUNT(*) FROM PDT PARTITION( P2 );
COUNT                
-----------------------
2                    
1 row selected.
-- are u sure that COUNT(*) is 3
$P0> SELECT COUNT(*) FROM PDT PARTITION( P3 );
COUNT                
-----------------------
3                    
1 row selected.
-- are u sure that COUNT(*) is 4
$P0> SELECT COUNT(*) FROM PDT PARTITION( P4 );
COUNT                
-----------------------
4                    
1 row selected.

$P0> DROP TABLE PDT;
Drop success.

