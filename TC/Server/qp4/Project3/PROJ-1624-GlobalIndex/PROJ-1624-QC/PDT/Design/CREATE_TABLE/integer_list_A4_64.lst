------------------------------------------
-- 3.1 Unique key
------------------------------------------
$P0> CREATE TABLE PDT
     (
         F1   INTEGER PRIMARY KEY,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10 ),
         PARTITION P2 VALUES ( 20 ),
         PARTITION P3 VALUES ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO PDT VALUES( 10, 0 );
1 row inserted.
-- should be fail
$P0> INSERT INTO PDT VALUES( 10, 1 );
[ERR-11058 : The row already exists in a unique index.]

$P0> INSERT INTO PDT VALUES( 20, 0 );
1 row inserted.
