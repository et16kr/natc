------------------------------------------
-- 2.1 파티션 키 컬럼 개수 체크
------------------------------------------
-- should be fail
$P0> CREATE TABLE PDT
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1, F2 )
     (
         PARTITION P1 VALUES ( 10 ),
         PARTITION P2 VALUES ( 20 ),
         PARTITION P3 VALUES ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
[ERR-31256 : Too many partition key columns]
$P0> DROP TABLE PDT;
[ERR-31031 : Table or view was not found : 
0001 : DROP TABLE PDT
                 ^  ^
]

------------------------------------------
-- 2.2 중복 파티션 조건값 체크 
------------------------------------------
-- should be fail
$P0> CREATE TABLE PDT
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10 ),
         PARTITION P2 VALUES ( 20 ),
         PARTITION P3 VALUES ( 10 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
[ERR-3125A : Duplicate partition key condition value : 
0008 :          PARTITION P1 VALUES ( 10 ),
                                     ^ ^
]
$P0> DROP TABLE PDT;
[ERR-31031 : Table or view was not found : 
0001 : DROP TABLE PDT
                 ^  ^
]

