----------------------------
-- 2.2 참조키 검사 
----------------------------
$P0> DROP TABLE PDT_HASH;
Drop success.
$P0> CREATE TABLE PDT_HASH
     (
         F1   INTEGER PRIMARY KEY,
         F2   INTEGER
     ) 
     PARTITION BY HASH( F1 )
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_HASH VALUES( 0, 0 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 1, 0 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 2, 0 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 3, 0 );
1 row inserted.
$P0> INSERT INTO PDT_HASH VALUES( 4, 0 );
1 row inserted.

$P0> CREATE TABLE T1
     (
         F1  INTEGER CONSTRAINT FK_CONST REFERENCES PDT_HASH( F1 ),
         F2  INTEGER
     );
Create success.

-- should be fail
$P0> ALTER TABLE PDT_HASH
     TRUNCATE PARTITION P1;
[ERR-3102A : A foreign key constraint depends on the table or column.]


