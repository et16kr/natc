$T0> ##SECTOR; DO JOB #1 (1. Basic Test)
$T0> ###########################################

$T0> CREATE TABLE PDT_LIST
(
    F1   INTEGER,
    F2   INTEGER
) 
PARTITION BY LIST( F1 )
(
    PARTITION P1 VALUES ( 10 ),
    PARTITION P2 VALUES ( 20 ),
    PARTITION P3 VALUES ( 30 ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;
Create success.

$T0> CREATE UNIQUE INDEX PDT_LIST_IDX ON PDT_LIST( F1 );
Create success.

