PROJECT ( COLUMN_COUNT: 3, TUPLE_SIZE: 16 )
 PARTITION-COORDINATOR ( TABLE: PROD_P_TBL, PARTITION: 1/13, INDEX: PROD_P_IDX, ACCESS: 1, SELF_ID: 2 )
  [ PARTITION KEY ]
  AND
   OR
    PROD_DATE >= TO_DATE('01-FEB-2006')
   OR
    PROD_DATE < TO_DATE('01-MAR-2006')
  [ FIXED KEY ]
  AND
   OR
    PROD_SEQ = 1
  [ FILTER ]
  AND
   PROD_DATE >= TO_DATE('01-FEB-2006')
   PROD_DATE < TO_DATE('01-MAR-2006')
  SCAN ( PARTITION: P02, RID SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, SELF_ID: 3 )
