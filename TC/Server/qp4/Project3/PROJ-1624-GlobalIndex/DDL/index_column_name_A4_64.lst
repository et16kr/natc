$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> SKIP END;

$T0> ##################################
$T0> # SECTOR; SECURITY COLUMN
$T0> ##################################


$T0> create table t1
( 
  i1         varchar(5), 
  i2         varchar(5),
  "$GIT_OID" varchar(5),
  "$GIT_RID" varchar(5)
)
partition by range(i1)
(
  partition p1 values less than ('b'),
  partition p2 values less than ('e'),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values ('a', 'a', 'abc', 'bcd');
1 row inserted.
$T0> insert into t1 values ('d', 'b', 'abcd', 'bcde');
1 row inserted.
$T0> insert into t1 values ('g', 'c', 'abcde', 'bcdef');
1 row inserted.

$T0> create index idx1 on t1(i2, "$GIT_OID");
[ERR-31023 : Duplicate column name : $GIT_OID]
$T0> create index idx2 on t1("$GIT_RID" desc, i2);
[ERR-31023 : Duplicate column name : $GIT_RID]
$T0> create unique index idx3 on t1("$GIT_OID" desc, i2, "$GIT_RID" asc);
[ERR-31023 : Duplicate column name : $GIT_OID]

$T0> desc t1;
