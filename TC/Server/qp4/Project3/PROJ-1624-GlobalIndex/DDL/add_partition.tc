###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;
INCLUDE check_global_index.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop tablespace data1 including contents and datafiles;
drop tablespace data2 including contents and datafiles;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF SELECT_TABLE()
{
alter session set explain plan = on;

select * from t1 order by i1;

alter session set explain plan = off;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();
CALL PREPARE_CHECK_GLOBAL_INDEX();

##################################
# SECTOR; HASH PARTITION
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition pd
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level, level, level from dual connect by level <= 100;

create index t1_idx1 on t1(i1);
create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i2,i3,i4);

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 add partition p3;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();
CALL CHECK_GLOBAL_INDEX();

##################################
# SECTOR; HASH PARTITION
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition pd
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level, level, level, level, level from dual connect by level <= 100;

create index t1_idx1 on t1(i1);
create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i2,i3,i4);

alter table t1 add constraint t1_pk primary key (i3, i4) using index tablespace data1;
alter table t1 add constraint t1_uk unique (i5, i6) using index tablespace data2;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 add partition p4;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();
CALL CHECK_GLOBAL_INDEX();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
CALL FINALIZE_CHECK_GLOBAL_INDEX();
}
