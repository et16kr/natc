 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> alter system set security_module_name = 'altibase';
Alter success.
$T0> alter system set security_ecc_policy_name = 'double';
Alter success.
$T0> alter system start security;
Alter success.

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> SKIP END;

$T0> ##################################
$T0> # SECTOR; SECURITY COLUMN
$T0> ##################################


$T0> create table t1
( 
  i1 varchar(5), 
  i2 varchar(5) encrypt using 'shift',
  i3 varchar(5) encrypt using 'reverse'
)
partition by range(i1)
(
  partition p1 values less than ('b'),
  partition p2 values less than ('e'),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values ('a', 'abc', 'bcd');
1 row inserted.
$T0> insert into t1 values ('d', 'abcd', 'bcde');
1 row inserted.
$T0> insert into t1 values ('g', 'abcde', 'bcdef');
1 row inserted.

$T0> create index idx1 on t1(i2);
Create success.
$T0> create index idx2 on t1(i3 desc);
Create success.
$T0> create unique index idx3 on t1(i3 desc, i2 asc);
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       VARCHAR(5)                  
I2                                       VARCHAR(5) ENCRYPT             
I3                                       VARCHAR(5) ENCRYPT             
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
IDX3                                     BTREE    UNIQUE        I3 DESC,
                                                                I2 ASC
IDX1                                     BTREE                  I2 ASC
IDX2                                     BTREE                  I3 DESC
T1 has no primary key
