###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;
INCLUDE check_global_index.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop tablespace data1 including contents and datafiles;
drop tablespace data2 including contents and datafiles;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF SELECT_TABLE()
{
alter session set explain plan = on;

select * from t1 order by i1;

alter session set explain plan = off;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();
CALL PREPARE_CHECK_GLOBAL_INDEX();

##################################
# SECTOR; RANGE PARTITION
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p11 values less than (15),
  partition p12 values less than (25),
  partition p2 values less than (50),
  partition p31 values less than (65),
  partition p32 values less than (75),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level, level, level from dual connect by level <= 100;

create index t1_idx1 on t1(i1);
create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i2,i3,i4);

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p11, p12 into partition p1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p31, p32 into partition p3 tablespace data1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();
CALL CHECK_GLOBAL_INDEX();

##################################
# SECTOR; RANGE PARTITION
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p11 values less than (15),
  partition p12 values less than (25),
  partition p2 values less than (50),
  partition p31 values less than (65),
  partition p32 values less than (75),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level, level, level, level, level from dual connect by level <= 100;

create index t1_idx1 on t1(i1);
create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i2,i3,i4);

alter table t1 add constraint t1_pk primary key (i3, i4) using index tablespace data1;
alter table t1 add constraint t1_uk unique (i5, i6) using index tablespace data2;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p11, p12 into partition p1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p31, p32 into partition p3 tablespace data1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();
CALL CHECK_GLOBAL_INDEX();

##################################
# SECTOR; LIST PARTITION
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by list(i1)
(
  partition p11 values (1,4),
  partition p12 values (7),
  partition p2 values (2,5,8),
  partition p31 values (3,6),
  partition p32 values (9),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level, level, level from dual connect by level <= 10;

create index t1_idx1 on t1(i1);
create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i2,i3,i4);

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p11, p12 into partition p1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p31, p32 into partition p3 tablespace data1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();
CALL CHECK_GLOBAL_INDEX();

##################################
# SECTOR; LIST PARTITION
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by list(i1)
(
  partition p11 values (1,4),
  partition p12 values (7),
  partition p2 values (2,5,8),
  partition p31 values (3,6),
  partition p32 values (9),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level, level, level, level, level from dual connect by level <= 10;

create index t1_idx1 on t1(i1);
create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i2,i3,i4);

alter table t1 add constraint t1_pk primary key (i3, i4) using index tablespace data1;
alter table t1 add constraint t1_uk unique (i5, i6) using index tablespace data2;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p11, p12 into partition p1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();

alter table t1 merge partitions p31, p32 into partition p3 tablespace data1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_TABLE();
CALL CHECK_GLOBAL_INDEX();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
CALL FINALIZE_CHECK_GLOBAL_INDEX();
}
