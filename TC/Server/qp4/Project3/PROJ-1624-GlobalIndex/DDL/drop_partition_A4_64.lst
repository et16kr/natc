$T0> # should be no rows
$T0> select a.*, b.*
from 
(
  select nvl(i3,-1000) i3, get_oid('T1','P1') oid, cast(_prowid as bigint) rid from t1 partition (p1)
  union all
  select nvl(i3,-1000) i3, get_oid('T1','P2') oid, cast(_prowid as bigint) rid from t1 partition (p2)
  union all
  select nvl(i3,-1000) i3, get_oid('T1','P3') oid, cast(_prowid as bigint) rid from t1 partition (p3)
  union all
  select nvl(i3,-1000) i3, get_oid('T1','PD') oid, cast(_prowid as bigint) rid from t1 partition (pd)
