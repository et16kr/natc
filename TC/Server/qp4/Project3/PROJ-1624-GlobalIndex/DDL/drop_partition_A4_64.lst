 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;

$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

$T0> create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
Create success.
$T0> create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
Create success.
$T0> SKIP BEGIN;
$T0> drop function get_oid;
$T0> SKIP END;

$T0> create function get_oid( tablename varchar(40), partname varchar(40) )
return bigint
as
  v1 bigint;
begin
  select p.partition_oid into v1
  from system_.sys_tables_ t, system_.sys_table_partitions_ p
  where t.table_name = tablename and t.user_id = user_id() and p.partition_name = partname
  and t.table_id = p.table_id;

  return v1;
end;
/
Create success.

$T0> ##################################
$T0> # SECTOR; RANGE PARTITION
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (80),
  partition p4 values less than (90),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 select level, level, level, level from dual connect by level <= 100;
100 rows inserted.

$T0> create index t1_idx1 on t1(i1);
Create success.
$T0> create index t1_idx2 on t1(i2) local;
Create success.
$T0> create index t1_idx3 on t1(i2,i3,i4);
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i3);
Alter success.
$T0> alter table t1 add constraint t1_uk unique (i4);
Alter success.

