$T0> alter session set explain plan = off;
Alter success.

$T0> ##################################
$T0> # SECTOR; RANGE PARTITION
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (80),
  partition p4 values less than (90),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 select level, level, level, level, level, level from dual connect by level <= 100;
100 rows inserted.

$T0> create index t1_idx1 on t1(i1);
Create success.
$T0> create index t1_idx2 on t1(i2) local;
Create success.
$T0> create index t1_idx3 on t1(i2,i3,i4);
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i3, i4);
Alter success.
$T0> alter table t1 add constraint t1_uk unique (i5, i6);
Alter success.

