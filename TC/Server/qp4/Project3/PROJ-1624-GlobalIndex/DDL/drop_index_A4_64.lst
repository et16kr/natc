 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop user user1 cascade;
$T0> SKIP END;

$T0> create user user1 identified by user1;
Create success.

$T0> grant all privileges to user1;
Grant success.

$T0> ##################################
$T0> # SECTOR; CREATE INDEX
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create unique index idx1 on t1(i2, i3);
Create success.

$T0> connect user1/user1;
Connect success.

$T0> create unique index idx2 on sys.t1(i3);
Create success.

$T0> create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create unique index idx3 on t2(i2, i3);
Create success.

$T0> connect sys/manager;
Connect success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
IDX1                                     BTREE    UNIQUE        I2 ASC,
                                                                I3 ASC
IDX2                                     BTREE    UNIQUE        I3 ASC
T1 has no primary key
$T0> desc "$GIT_IDX1";
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I2                                       INTEGER                     
I3                                       INTEGER                     
$GIT_OID                                 BIGINT                      
$GIT_RID                                 BIGINT                      
[ INDEX ]                                                       
------------------------------------------------------------------------------
