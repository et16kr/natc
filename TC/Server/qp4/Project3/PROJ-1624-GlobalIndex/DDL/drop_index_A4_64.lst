------------------------------------------------------------------------------
$GIK_IDX1                                BTREE    UNIQUE        I2 ASC,
                                                                I3 ASC
$GIR_IDX1                                BTREE    UNIQUE        $GIT_RID ASC
"$GIT_IDX1" has no primary key

$T0> select * from "$_TEMP";
$_TEMP.I2   $_TEMP.I3   $_TEMP.$GIT_OID      $_TEMP.$GIT_RID      
-----------------------------------------------------------------------
No rows selected.
$T0> desc "$GIT_IDX2";
[ERR-91014 : The table ($GIT_IDX2) does not exist.]

$T0> select * from "$_TEMP";
[ERR-31031 : Table or view was not found : 
0001 : select * from "$_TEMP"
                     ^     ^
]

$T0> connect user1/user1;
Connect success.

$T0> desc t2;
