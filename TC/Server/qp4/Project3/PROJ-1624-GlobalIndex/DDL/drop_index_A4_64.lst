No rows selected.

$T0> connect sys/manager;
Connect success.

$T0> ##################################
$T0> # SECTOR; DROP INDEX
$T0> ##################################

$T0> connect sys/manager;
Connect success.

$T0> insert into t1 values ( 1, 1, 1, 1 );
1 row inserted.
$T0> insert into t1 values ( 11, 1, 2, 2 );
1 row inserted.
$T0> # fail
$T0> insert into t1 values ( 21, 1, 2, 2 );
[ERR-11058 : The row already exists in a unique index.]
$T0> # fail 
$T0> insert into t1 values ( 1, 1, 3, 2 );
1 row inserted.

$T0> connect user1/user1;
Connect success.

$T0> insert into t2 values ( 1, 1, 1, 1 );
1 row inserted.
$T0> insert into t2 values ( 11, 1, 2, 2 );
1 row inserted.
$T0> # fail
$T0> insert into t2 values ( 21, 1, 2, 2 );
[ERR-11058 : The row already exists in a unique index.]

$T0> connect sys/manager;
Connect success.

$T0> drop index idx1;
Drop success.

$T0> connect user1/user1;
Connect success.

$T0> drop index idx2;
Drop success.
$T0> drop index idx3;
Drop success.

$T0> connect sys/manager;
Connect success.

$T0> insert into t1 values ( 21, 1, 2, 2 );
1 row inserted.
$T0> insert into t1 values ( 1, 1, 3, 2 );
1 row inserted.

$T0> select * from t1;
T1.I1       T1.I2       T1.I3       T1.I4       
-----------------------------------------------------
1           1           1           1           
1           1           3           2           
1           1           3           2           
11          1           2           2           
21          1           2           2           
5 rows selected.

$T0> connect user1/user1;
Connect success.

$T0> insert into t2 values ( 21, 1, 2, 2 );
1 row inserted.

$T0> select * from t2;
T2.I1       T2.I2       T2.I3       T2.I4       
-----------------------------------------------------
1           1           1           1           
11          1           2           2           
21          1           2           2           
3 rows selected.

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop user user1 cascade;
$T0> SKIP END;

