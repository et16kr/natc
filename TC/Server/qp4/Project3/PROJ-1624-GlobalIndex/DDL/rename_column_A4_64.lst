 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

$T0> create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
Create success.
$T0> create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
Create success.

$T0> ##################################
$T0> # SECTOR; RENAME COLUMN
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  constraint t1_pk primary key (i3),
  constraint t1_uk unique (i4)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> alter table t1 rename column i2 to i2_new;
Alter success.
$T0> alter table t1 rename column i3 to i3_new;
Alter success.
$T0> alter table t1 rename column i4 to i4_new;
Alter success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2_NEW                                   INTEGER                     
I3_NEW                                   INTEGER                     NOT NULL
I4_NEW                                   INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_PK                                    BTREE    UNIQUE        I3_NEW ASC
T1_UK                                    BTREE    UNIQUE        I4_NEW ASC
[ PRIMARY KEY ]                                                 
------------------------------------------------------------------------------
I3_NEW
$T0> desc "$GIT_T1_PK";
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I3_NEW                                   INTEGER                     
$GIT_OID                                 BIGINT                      
$GIT_RID                                 BIGINT                      
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
$GIK_T1_PK                               BTREE    UNIQUE        I3_NEW ASC
$GIR_T1_PK                               BTREE    UNIQUE        $GIT_RID ASC
"$GIT_T1_PK" has no primary key

$T0> select * from "$_TEMP";
$_TEMP.I3_NEW $_TEMP.$GIT_OID      $_TEMP.$GIT_RID      
------------------------------------------------------------
No rows selected.
$T0> desc "$GIT_T1_UK";
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I4_NEW                                   INTEGER                     
$GIT_OID                                 BIGINT                      
$GIT_RID                                 BIGINT                      
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
$GIK_T1_UK                               BTREE    UNIQUE        I4_NEW ASC
$GIR_T1_UK                               BTREE    UNIQUE        $GIT_RID ASC
"$GIT_T1_UK" has no primary key

$T0> select * from "$_TEMP";
$_TEMP.I4_NEW $_TEMP.$GIT_OID      $_TEMP.$GIT_RID      
------------------------------------------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

