$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;

$T0> ##################################
$T0> # SECTOR; INDEX NAME
$T0> ##################################

$T0> create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than ('100'),
  partition p2 values less than ('200'),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> ##################################
$T0> # SECTOR; INDEX NAME
$T0> ##################################

$T0> create index idx1 on t1(i2);
Create success.

$T0> create index "idx1" on t1(i3);
Create success.

$T0> desc t1;
