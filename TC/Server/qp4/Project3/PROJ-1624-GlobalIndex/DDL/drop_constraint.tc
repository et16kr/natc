###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; ONE COLUMN
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

# success
insert into t1 values (1, 1, 1, 1);
# pk error
insert into t1 values (1, 1, 1, 2);
insert into t1 values (1, 1, null, 3);
# uk error
insert into t1 values (1, 1, 2, 1);

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

alter table t1 drop constraint t1_pk;

# success
insert into t1 values (1, 1, 1, 2);
insert into t1 values (1, 1, null, 3);
# uk error
insert into t1 values (1, 1, 2, 1);

alter table t1 drop constraint t1_uk;

# success
insert into t1 values (1, 1, 2, 1);

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

##################################
# SECTOR; COMPOSITE COLUMN
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3, i4);
alter table t1 add constraint t1_uk unique (i5, i6);

# success
insert into t1 values (1, 1, 1, 1, 1, 1);
# pk error
insert into t1 values (1, 1, 1, 2, 2, 2);
insert into t1 values (1, 1, 2, null, 3, 3);
# uk error
insert into t1 values (1, 1, 2, 2, 1, 1);

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

alter table t1 drop constraint t1_pk;

# success
insert into t1 values (1, 1, 1, 2, 2, 3);
insert into t1 values (1, 1, 2, null, 3, 3);
# uk error
insert into t1 values (1, 1, 2, 2, 1, 1);

alter table t1 drop constraint t1_uk;

# success
insert into t1 values (1, 1, 2, 2, 1, 1);

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
