$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

$T0> create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
Create success.
$T0> create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
Create success.

$T0> ##################################
$T0> # SECTOR; INDEX RENAME
$T0> ##################################



$T0> create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than ('100'),
  partition p2 values less than ('200'),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.


$T0> create index idx1 on t1(i1);
Create success.
$T0> create index idx2 on t1(i1, i2);
Create success.
$T0> create index idx3 on t1(i1, i2, i3);
Create success.

$T0> create index idx4 on t1(i2) tablespace data1;
Create success.
$T0> create index idx5 on t1(i2, i3) tablespace data1;
Create success.

$T0> create index idx6 on t1(i3) tablespace data2;
Create success.
$T0> create index idx7 on t1(i3, i1) tablespace data2;
Create success.
$T0> create index idx8 on t1(i3, i2, i1) tablespace data2;
Create success.

