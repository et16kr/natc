$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop materialized view m1;
$T0> drop materialized view m2;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

$T0> create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
Create success.
$T0> create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
Create success.

$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values (1, 1, 1, 1);
1 row inserted.
$T0> insert into t1 values (2, 2, 2, 2);
1 row inserted.
$T0> insert into t1 values (3, 3, 3, 3);
1 row inserted.
$T0> insert into t1 values (4, 4, 4, 4);
1 row inserted.
$T0> insert into t1 values (5, 5, 5, 5);
1 row inserted.
$T0> insert into t1 values (6, 6, 6, 6);
1 row inserted.
$T0> insert into t1 values (7, 7, 7, 7);
1 row inserted.
$T0> insert into t1 values (8, 8, 8, 8);
1 row inserted.
$T0> insert into t1 values (9, 9, 9, 9);
1 row inserted.
$T0> insert into t1 values (10, 10, 10, 10);
1 row inserted.

$T0> ##################################
$T0> # SECTOR; CONSTRAINT
$T0> ##################################


$T0> create materialized view m1(i1, i2, i3, i4)
partition by range(i1)
(
  partition p1 values less than (5),
  partition p2 values less than (10),
  partition p3 values default
)
tablespace sys_tbs_disk_data
as
select i1, i2, i3, i4 from t1;
Create success.

$T0> alter table m1 add constraint m1_pk primary key (i2);
Alter success.
$T0> alter table m1 add constraint m1_uk unique (i3, i4);
Alter success.

$T0> desc m1;
