$T0> alter session set explain plan = off;
Alter success.

$T0> ##################################
$T0> # SECTOR; HASH PARTITION
$T0> ##################################

$T0> create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3,
  partition p4,
  partition p5
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;
100 rows inserted.

$T0> create index t2_idx1 on t2(i2, i3);
Create success.
$T0> create index t2_idx2 on t2(i2, i3 desc);
Create success.

$T0> desc t2;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
