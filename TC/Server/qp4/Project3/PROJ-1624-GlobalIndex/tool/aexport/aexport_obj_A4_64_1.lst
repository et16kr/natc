    partition "__SYS_PART_IDX_ID_263" on P4 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_264" on P3 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_265" on P2 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_266" on P1 tablespace "SYS_TBS_DISK_DATA");

alter table "T2" add constraint "T2_UK" unique("I3","I2","I1")  using index local  
