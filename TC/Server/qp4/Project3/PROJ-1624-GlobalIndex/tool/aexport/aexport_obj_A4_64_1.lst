    partition "__SYS_PART_IDX_ID_274" on P3 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_275" on P2 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_276" on P1 tablespace "SYS_TBS_DISK_DATA") indextype is btree;

create  index "T2_IDX5" on "T2"("I4") LOCAL 
(
    partition "__SYS_PART_IDX_ID_277" on PD tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_278" on P4 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_279" on P3 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_280" on P2 tablespace "SYS_TBS_DISK_DATA",
    partition "__SYS_PART_IDX_ID_281" on P1 tablespace "SYS_TBS_DISK_DATA") indextype is btree;



$T0> EXEC PROC1 "aexport -s 127.0.0.1 -u sys -p manager -object user1.t3";
$T0> P_WAIT PROC1;

$T0> CAT "USER1_T3_CRT.sql";

