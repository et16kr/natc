$T0> CAT "ALL_CRT_USER.sql";
--############################
--  USER "USER1"
--############################
create user "USER1" identified by "altibase"
 temporary tablespace "SYS_TBS_DISK_TEMP" 
 default tablespace "SYS_TBS_DISK_DATA" ;



$T0> ##################################
$T0> # SECTOR; IMPORT
$T0> ##################################

$T0> SKIP BEGIN;
$T0> connect sys/manager;
$T0> drop user user1 cascade;
$T0> SKIP END;

$T0> connect sys/manager;
Connect success.

$T0> EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f ALL_CRT_USER.sql";
$T0> P_WAIT PROC1;

$T0> EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f ALL_CRT_TBL.sql";
$T0> P_WAIT PROC1;

$T0> EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f ALL_CRT_INDEX.sql";
$T0> P_WAIT PROC1;


$T0> connect user1/altibase;
Connect success.

