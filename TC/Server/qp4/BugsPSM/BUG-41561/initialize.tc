def main()
{
    skip begin;
    drop table t1;
    drop table t2;
    drop user user1 cascade;
    drop user user2 cascade;
    skip end;

    create user user1 identified by user1;
    grant all privileges to user1;
    create user user2 identified by user2;

    create table t1( c1 integer, c2 varchar(16) );
    insert into t1 values( 1 , 'Moon' );
    insert into t1 values( 2 , 'Han');
    insert into t1 values( 3 , 'Eun' );
    insert into t1 values( 4 , 'Gi' );
    insert into t1 values( 5 , 'Ha' );
    insert into t1 values( 6 , 'Woo' );

    connect user1/user1;

    create table t1( c1 integer, c2 varchar(16) );
    insert into t1 values( 1 , 'Smith' );
    insert into t1 values( 2 , 'Kang');
    insert into t1 values( 3 , 'Na Ra' );
    insert into t1 values( 4 , 'Ko Jang' );
    insert into t1 values( 5 , 'Roo Ma' );
    insert into t1 values( 6 , 'Sa Su' );

    connect sys/manager;
}
