############################################################################
# SET UP Shard System (shard node1~3)
############################################################################

include stdFunc.i;

DECLARE SERVER SHARD_NODE1 DB1;
DECLARE SERVER SHARD_NODE2 DB2;
DECLARE SERVER SHARD_NODE3 DB3;

DECLARE CLIENT DEFAULT C1 (SERVER=DB1);
DECLARE CLIENT DEFAULT C2 (SERVER=DB2);
DECLARE CLIENT DEFAULT C3 (SERVER=DB3);

DEF MAIN()
{
    $ALTIBASE_HOME;
    $ALTIBASE_HOME_C0 = $ALTIBASE_HOME;

    THREAD T1 C1
    {
        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();

        connect sys/manager;
        CREATE USER NODE1 IDENTIFIED BY NODE1;
        GRANT ALL PRIVILEGES TO NODE1;
        CREATE USER NODE2 IDENTIFIED BY NODE2;
        GRANT ALL PRIVILEGES TO NODE2;
        CREATE USER NODE3 IDENTIFIED BY NODE3;
        GRANT ALL PRIVILEGES TO NODE3;
        CREATE USER NODE4 IDENTIFIED BY NODE4;
        GRANT ALL PRIVILEGES TO NODE4;
        CREATE USER NODE5 IDENTIFIED BY NODE5;
        GRANT ALL PRIVILEGES TO NODE5;
        CREATE USER NODE6 IDENTIFIED BY NODE6;
        GRANT ALL PRIVILEGES TO NODE6;
        CREATE USER NODE7 IDENTIFIED BY NODE7;
        GRANT ALL PRIVILEGES TO NODE7;
        CREATE USER NODE8 IDENTIFIED BY NODE8;
        GRANT ALL PRIVILEGES TO NODE8;
        CREATE USER NODE9 IDENTIFIED BY NODE9;
        GRANT ALL PRIVILEGES TO NODE9;
        CREATE USER NODE10 IDENTIFIED BY NODE10;
        GRANT ALL PRIVILEGES TO NODE10;

        NODISPLAY OFF;
    }

    ########################################
    # Initialize META
    ########################################

    SET_ENV ALTIBASE_SHARD_ENABLE = "1";
    SET_ENV ALTIBASE___SHARD_TEST_ENABLE = "1";

    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdClean();
    CALL stdServerStart();
    NODISPLAY OFF;

    EXEC p1 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIBASE_HOME}/packages/dbms_shard.sql";
    P_WAIT p1;
    PRINT $Ret_;

    EXEC p1 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIBASE_HOME}/packages/dbms_shard.plb";
    P_WAIT p1;
    PRINT $Ret_;

    EXEC DBMS_SHARD.CREATE_META(0);

    EXEC dbms_shard.set_node('NODE1', '127.0.0.1', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE2', '127.0.0.2', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE3', '127.0.0.3', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE4', '127.0.0.4', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE5', '127.0.0.5', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE6', '127.0.0.6', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE7', '127.0.0.7', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE8', '127.0.0.8', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE9', '127.0.0.9', ${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE10', '127.0.0.10', ${ALTIBASE_PORT_NO@DB1});

    SELECT memory_value1 FROM x$property WHERE name = 'SHARD_ENABLE';
    SELECT memory_value1 FROM x$property WHERE name = '__SHARD_TEST_ENABLE';

    UNSET_ENV ALTIBASE_SHARD_ENABLE;
    UNSET_ENV ALTIBASE_SHARD_TEST_ENABLE;

    JOIN;
}
