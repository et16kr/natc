############################################################################
# SET UP Shard System (shard node1~3)
############################################################################

include stdFunc.i;

DECLARE SERVER SHARD_NODE1 DB1;
DECLARE SERVER SHARD_NODE2 DB2;
DECLARE SERVER SHARD_NODE3 DB3;

DECLARE CLIENT DEFAULT C1 (SERVER=DB1);
DECLARE CLIENT DEFAULT C2 (SERVER=DB2);
DECLARE CLIENT DEFAULT C3 (SERVER=DB3);

DEF MAIN()
{
    $ALTIBASE_HOME;
    $ALTIBASE_HOME_C0 = $ALTIBASE_HOME;

    THREAD T1 C1
    {
        ########################################
        # Set Up NODE1 (PORT_NO+1000)
        ########################################

        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }

    THREAD T2 C2
    {
        ########################################
        # Set Up NODE2 (PORT_NO+2000)
        ########################################

        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }

    THREAD T3 C3
    {
        ########################################
        # Set Up NODE3 (PORT_NO+3000)
        ########################################

        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }
    JOIN;

    ########################################
    # Initialize META
    ########################################

    EXEC p1 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIBASE_HOME}/packages/dbms_shard.sql";
    P_WAIT p1;

    PRINT $Ret_;

    EXEC p1 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIBASE_HOME}/packages/dbms_shard.plb";
    P_WAIT p1;

    PRINT $Ret_;

    EXEC DBMS_SHARD.CREATE_META(0);
}
