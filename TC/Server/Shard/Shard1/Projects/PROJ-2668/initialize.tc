############################################################################
# SET UP Shard DB System
############################################################################
include stdFunc.i;

DECLARE SERVER SHARD_NODE1 DB1;
DECLARE SERVER SHARD_NODE2 DB2;
DECLARE SERVER SHARD_NODE3 DB3;
DECLARE SERVER SHARD_NODE4 DB4;

DECLARE CLIENT DEFAULT C1 (SERVER=DB1);
DECLARE CLIENT DEFAULT C2 (SERVER=DB2);
DECLARE CLIENT DEFAULT C3 (SERVER=DB3);
DECLARE CLIENT DEFAULT C4 (SERVER=DB4);

DEF MAIN()
{
    $ALTIBASE_HOME;
    $ALTIBASE_HOME_C0 = $ALTIBASE_HOME;

    ########################################
    # initialize DB 
    ########################################
    THREAD T1 C1
    {
        ########################################
        # Set Up NODE1
        ########################################
        CREATE TABLE T1 (I1 VARCHAR(20), I2 INTEGER);

        INSERT INTO T1 VALUES('F', 1);
        INSERT INTO T1 VALUES('G', 1);
        INSERT INTO T1 VALUES('F', 2);
        INSERT INTO T1 VALUES('F', 3);
        INSERT INTO T1 VALUES('F', 4);

        SELECT * FROM T1;
    }
    THREAD T2 C2
    {
        ########################################
        # Set Up NODE2
        ########################################
        CREATE TABLE T1 (I1 VARCHAR(20), I2 INTEGER);

        INSERT INTO T1 VALUES('A', 2);
        INSERT INTO T1 VALUES('B', 2);

        SELECT * FROM T1;
    }
    THREAD T3 C3
    {
        ########################################
        # Set Up NODE1 Alternative
        ########################################
        CREATE TABLE T1 (I1 VARCHAR(20), I2 INTEGER);

        INSERT INTO T1 VALUES('F', 10);
        INSERT INTO T1 VALUES('G', 10);
        INSERT INTO T1 VALUES('F', 20);
        INSERT INTO T1 VALUES('F', 30);
        INSERT INTO T1 VALUES('F', 40);

        SELECT * FROM T1;
    }
    THREAD T4 C4
    {
        ########################################
        # Set Up META Alternative
        ########################################
        SET_ENV ALTIBASE_SHARD_ENABLE = "1";

        NODISPLAY ON;
        CALL stdServerKill();
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;

        CREATE TABLE T1 (I1 VARCHAR(20), I2 INTEGER);
        SELECT * FROM T1;

        UNSET_ENV ALTIBASE_SHARD_ENABLE;
    }
    JOIN;

    ########################################
    # initialize META
    ########################################
    #exec dbms_shard.set_node('NODE1','127.0.0.1',PORT_NO+1000);
    #exec dbms_shard.set_node('NODE2','127.0.0.1',PORT_NO+2000);
    NODISPLAY ON;
    EXEC dbms_shard.set_node('NODE1','127.0.0.1',${ALTIBASE_PORT_NO@DB1});
    EXEC dbms_shard.set_node('NODE2','127.0.0.1',${ALTIBASE_PORT_NO@DB2});
    NODISPLAY OFF;

    select count(*) from sys_shard.nodes_;

    CREATE TABLE T1 (I1 VARCHAR(20), I2 INTEGER);

    EXEC dbms_shard.set_shard_table('SYS','T1','H','I1');
    select count(*) from sys_shard.objects_;

    EXEC dbms_shard.set_shard_hash('SYS','T1',1000,'NODE1');

    SELECT * FROM T1;

    THREAD T4 C4
    {
        EXEC p2 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIBASE_HOME}/packages/dbms_shard.sql";
        P_WAIT p2;
        PRINT $Ret_;

        EXEC p2 "isql -s 127.0.0.1 -u sys -p manager -silent -f ${ALTIBASE_HOME}/packages/dbms_shard.plb";
        P_WAIT p2;
        PRINT $Ret_;

        EXEC dbms_shard.create_meta(5);

        #exec dbms_shard.set_node('NODE1','127.0.0.1',PORT_NO+3000);
        #exec dbms_shard.set_node('NODE2','127.0.0.1',PORT_NO+2000);
        NODISPLAY ON;
        EXEC dbms_shard.set_node('NODE1','127.0.0.1',${ALTIBASE_PORT_NO@DB3});
        EXEC dbms_shard.set_node('NODE2','127.0.0.1',${ALTIBASE_PORT_NO@DB2});
        NODISPLAY OFF;
        select count(*) from sys_shard.nodes_;

        EXEC dbms_shard.set_shard_table('SYS','T1','H','I1');
        select count(*) from sys_shard.objects_;

        EXEC dbms_shard.set_shard_hash('SYS','T1',1000,'NODE1');
    }
    JOIN;
}
