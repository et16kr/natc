############################################################################
# SET UP three DB System
############################################################################

include stdFunc.i;

DECLARE SERVER BUG_39946_MM_SERVER1 DB1;
DECLARE SERVER BUG_39946_MM_SERVER2 DB2;
DECLARE SERVER BUG_39946_MM_SERVER3 DB3;

DECLARE CLIENT DEFAULT C1 (SERVER=DB1);
DECLARE CLIENT DEFAULT C2 (SERVER=DB2);
DECLARE CLIENT DEFAULT C3 (SERVER=DB3);

DEF MAIN()
{
    $ALTIBASE_HOME;
    $ALTIBASE_HOME_C0 = $ALTIBASE_HOME;

    THREAD T1 C1
    {
        ########################################
        # Set Up DB 1
        ########################################

        NODISPLAY ON;
        CALL stdServerKill();
        NODISPLAY OFF;

        RM -rf "db1";

        MKDIR "db1";
        MKDIR "db1/bin";
        MKDIR "db1/msg";
        MKDIR "db1/lib";
        MKDIR "db1/install";
        MKDIR "db1/include";
        MKDIR "db1/conf";
        MKDIR "db1/dbs";
        MKDIR "db1/logs";
        MKDIR "db1/trc";
        MKDIR "db1/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin/*" "db1/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg/*" "db1/msg";
        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db1/conf/altibase.properties";
        CP -r "${ALTIBASE_HOME_C0}/conf/license" "db1/conf/license";

        # for building program that uses altibase's library.
        CP -r "${ALTIBASE_HOME_C0}/lib/*" "db1/lib";
        CP -r "${ALTIBASE_HOME_C0}/install/*" "db1/install";
        CP -r "${ALTIBASE_HOME_C0}/include/*" "db1/include";

        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;

    }

    THREAD T2 C2
    {
        ########################################
        # Set Up DB 2
        ########################################

        NODISPLAY ON;
        CALL stdServerKill();
        NODISPLAY OFF;

        RM -rf "db2";

        MKDIR "db2";
        MKDIR "db2/bin";
        MKDIR "db2/msg";
        MKDIR "db2/lib";
        MKDIR "db2/install";
        MKDIR "db2/include";
        MKDIR "db2/conf";
        MKDIR "db2/dbs";
        MKDIR "db2/logs";
        MKDIR "db2/trc";
        MKDIR "db2/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin/*" "db2/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg/*" "db2/msg";
        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db2/conf/altibase.properties";
        CP -r "${ALTIBASE_HOME_C0}/conf/license" "db2/conf/license";

        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }

    THREAD T3 C3
    {
        ########################################
        # Set Up DB 3
        ########################################

        NODISPLAY ON;
        CALL stdServerKill();
        NODISPLAY OFF;

        RM -rf "db3";

        MKDIR "db3";
        MKDIR "db3/bin";
        MKDIR "db3/msg";
        MKDIR "db3/lib";
        MKDIR "db3/install";
        MKDIR "db3/include";
        MKDIR "db3/conf";
        MKDIR "db3/dbs";
        MKDIR "db3/logs";
        MKDIR "db3/trc";
        MKDIR "db3/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin/*" "db3/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg/*" "db3/msg";
        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db3/conf/altibase.properties";
        CP -r "${ALTIBASE_HOME_C0}/conf/license" "db3/conf/license";

        NODISPLAY ON;
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }

    JOIN;

    THREAD T1 C1
    {
        ########################################
        # Verify DB 1
        ########################################

        SELECT * FROM DUAL;
    }

    THREAD T2 C2
    {
        ########################################
        # Verify DB 2
        ########################################

        SELECT * FROM DUAL;
    }

    THREAD T3 C3
    {
        ########################################
        # Verify DB 3
        ########################################

        SELECT * FROM DUAL;
    }

    JOIN;
}

