############################################################################
# Replication Environment Setting
############################################################################

############################################################################
# SET UP two DB System
############################################################################

include stdFunc.i;

DECLARE SERVER BUG_39352_MM_RP_SERVER1 DB1;
DECLARE SERVER BUG_39352_MM_RP_SERVER2 DB2;

DECLARE CLIENT DEFAULT C1 (SERVER=DB1);
DECLARE CLIENT DEFAULT C2 (SERVER=DB2);


DEF MAIN()
{
    $ALTIBASE_HOME;
    $ALTIBASE_HOME_C0 = $ALTIBASE_HOME;

    THREAD T1 C1
    {
        ########################################
        # Set Up DB 1
        ########################################

        RM -rf "db1";

        MKDIR "db1";
        MKDIR "db1/conf";
        MKDIR "db1/dbs";
        MKDIR "db1/logs";
        MKDIR "db1/trc";
        MKDIR "db1/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin"          "db1/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg"          "db1/msg";
        CP -r "${ALTIBASE_HOME_C0}/lib"          "db1/lib";
        CP -r "${ALTIBASE_HOME_C0}/install"      "db1/install";
        CP -r "${ALTIBASE_HOME_C0}/include"      "db1/include";

        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties"  "db1/conf";
        CP -r "${ALTIBASE_HOME_C0}/conf/license"              "db1/conf";

        NODISPLAY ON;
        CALL stdServerKill();
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }

    THREAD T2 C2
    {
        ########################################
        # Set Up DB 2
        ########################################

        RM -rf "db2";

        MKDIR "db2";
        MKDIR "db2/conf";
        MKDIR "db2/dbs";
        MKDIR "db2/logs";
        MKDIR "db2/trc";
        MKDIR "db2/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin"          "db2/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg"          "db2/msg";
        CP -r "${ALTIBASE_HOME_C0}/lib"          "db2/lib";
        CP -r "${ALTIBASE_HOME_C0}/install"      "db2/install";
        CP -r "${ALTIBASE_HOME_C0}/include"      "db2/include";

        CP -r "${ALTIBASE_HOME_C0}/conf/altibase.properties"  "db2/conf";
        CP -r "${ALTIBASE_HOME_C0}/conf/license"              "db2/conf";

        NODISPLAY ON;
        CALL stdServerKill();
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }

    JOIN;
}

