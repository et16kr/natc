###########################################################################
# Audit Test
###########################################################################

INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
# SECTOR; CLEAN
##################################

NODISPLAY ON;
CALL stdServerKill();
CALL stdClean();
CALL stdServerStart();
NODISPLAY OFF;

create user user1 identified by user1;

create table t1(i1 integer);
create table t2(i1 integer);
create table user1.t3(i1 integer);
create table user1.t4(i1 integer);

}
