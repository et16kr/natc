include stdFunc.i;

DECLARE SERVER REPL_SERVER1 DB1;
DECLARE SERVER REPL_SERVER2 DB2;
DECLARE SERVER REPL_SERVER3 DB3;

DECLARE CLIENT REPL_CLIENT1 C1 (SERVER=DB1);
DECLARE CLIENT REPL_CLIENT2 C2 (SERVER=DB2);
DECLARE CLIENT REPL_CLIENT3 C3 (SERVER=DB3);

DEF MAIN()
{
    THREAD T1 C1
    {
        ALTER SYSTEM SET REPLICATION_DDL_ENABLE_LEVEL = 1;
        ALTER SYSTEM SET REPLICATION_SQL_APPLY_ENABLE = 1;
        ALTER SESSION SET REPLICATION_DDL_SYNC = 0;
        ALTER SYSTEM SET REPLICATION_DDL_SYNC = 0;
    }

    THREAD T2 C2
    {
        ALTER SYSTEM SET REPLICATION_DDL_ENABLE_LEVEL = 1;
        ALTER SYSTEM SET REPLICATION_SQL_APPLY_ENABLE = 1;
        ALTER SESSION SET REPLICATION_DDL_SYNC = 0;
        ALTER SYSTEM SET REPLICATION_DDL_SYNC = 0;
    }

    THREAD T3 C3
    {
        ALTER SYSTEM SET REPLICATION_DDL_ENABLE_LEVEL = 1;
        ALTER SYSTEM SET REPLICATION_SQL_APPLY_ENABLE = 1;
        ALTER SESSION SET REPLICATION_DDL_SYNC = 0;
        ALTER SYSTEM SET REPLICATION_DDL_SYNC = 0;
    }
    JOIN;
}



