INCLUDE stdFunc.i;

DEF MAIN()
{
    ################################################
    SECTOR; Declare
    ################################################

    DECLARE SERVER REPL_SERVER1 DB1;

    DECLARE CLIENT DEFAULT C1 ( SERVER = DB1 );

    ################################################
    SECTOR; DO IT
    ################################################

    THREAD T1 C1
    {
        NODISPLAY ON;
        CALL stdServerKill();
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;

        SELECT * FROM DUAL;
    }
    JOIN;
}

