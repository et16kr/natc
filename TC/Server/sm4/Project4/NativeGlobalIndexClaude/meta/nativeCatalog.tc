###########################################################################
# TestCase Description = 네이티브 글로벌 인덱스의 카탈로그 표현.
#
#                        구버전(PROJ-1624)은 숨김 테이블 $GIT_ 와 그 위의
#                        인덱스 $GIK_/$GIR_ 가 카탈로그에 보였다. 네이티브는
#                        그런 객체를 만들지 않는다. 대신 SYS_PART_INDICES_ 에
#                        판별자 행을 하나 남긴다 - 캐시 로더가
#                        IS_PARTITIONED='F' 를 보고 무조건 non-partitioned 로
#                        하드코딩하기 때문에, 재기동 후 네이티브임을
#                        알아보려면 이 행이 필요하다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; NO HIDDEN OBJECT
##################################
# 인덱스를 만들기 전과 후에 숨김 객체가 없어야 한다.

CALL CHECK_NO_HIDDEN_OBJECT();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index gidx2 on t1(i3, i4);

CALL CHECK_NO_HIDDEN_OBJECT();

##################################
# SECTOR; SYS_INDICES_
##################################
# 글로벌 인덱스는 IS_PARTITIONED = 'F' 이고 INDEX_TABLE_ID 가 0 이다.
# 로컬 인덱스는 IS_PARTITIONED = 'T' 다.

create index lidx1 on t1(i4) local;

CALL SELECT_SYS_INDICES( "t1" );

##################################
# SECTOR; SYS_PART_INDICES_
##################################
# 네이티브 글로벌 인덱스는 여기에 판별자 행을 남긴다.
# 로컬 인덱스도 여기에 행이 있지만 PARTITION_TYPE 값이 다르다.

CALL SELECT_SYS_PART_INDICES( "t1" );

##################################
# SECTOR; SYS_INDEX_PARTITIONS_
##################################
# 글로벌 인덱스는 파티션별 물리 인덱스를 만들지 않으므로 여기에
# 행이 없어야 한다. 로컬 인덱스는 파티션마다 하나씩 있다.

CALL SELECT_SYS_INDEX_PARTITIONS( "t1" );

##################################
# SECTOR; CATALOG AFTER DROP INDEX
##################################
# 인덱스를 지우면 판별자 행도 함께 사라져야 한다. 남으면 다음 기동에서
# 없는 인덱스를 네이티브로 오인한다.

drop index gidx1;

CALL SELECT_SYS_INDICES( "t1" );
CALL SELECT_SYS_PART_INDICES( "t1" );

drop index gidx2;

CALL SELECT_SYS_INDICES( "t1" );
CALL SELECT_SYS_PART_INDICES( "t1" );

##################################
# SECTOR; CATALOG AFTER DROP TABLE
##################################

create index gidx1 on t1(i2);
create index gidx2 on t1(i3);

CALL SELECT_SYS_PART_INDICES( "t1" );

drop table t1;

CALL SELECT_SYS_INDICES( "t1" );
CALL SELECT_SYS_PART_INDICES( "t1" );
CALL CHECK_NO_HIDDEN_OBJECT();

##################################
# SECTOR; PK AND UK CATALOG
##################################
# 제약으로 만들어진 글로벌 인덱스도 같은 표현이어야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

alter table t1 add constraint t1_pk primary key (i2);
alter table t1 add constraint t1_uk unique (i3);

CALL SELECT_INDEX_META( "t1" );

select c.constraint_name, c.constraint_type
from system_.sys_constraints_ c, system_.sys_tables_ t
where c.table_id = t.table_id
  and t.table_name = 'T1'
  and t.user_id = user_id()
order by c.constraint_name;

##################################
# SECTOR; CATALOG AFTER DROP CONSTRAINT
##################################

alter table t1 drop constraint t1_uk;

CALL SELECT_INDEX_META( "t1" );

alter table t1 drop constraint t1_pk;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; LOCAL INDEX ONLY
##################################
# 대조군. 로컬 인덱스만 있으면 카탈로그가 기존과 같아야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index lidx1 on t1(i2) local;
create index lidx2 on t1(i3) local;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; NON-PARTITIONED TABLE
##################################
# 대조군. 파티션드가 아닌 테이블의 인덱스.

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2( i1 integer, i2 integer ) tablespace sys_tbs_mem_data;

create index t2_idx1 on t2(i2);

CALL SELECT_INDEX_META( "t2" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
