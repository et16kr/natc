$T0> ##################################
$T0> # SECTOR; FIXED KEY, MULTI TABLESPACE (대조군)
$T0> ##################################
$T0> # variable 컬럼이 하나도 없으므로 게이트가 열린다.
$T0> # 여기서 (tableOID, rowOID) tie-break 가 실제로 시험된다: 서로 다른
$T0> # 테이블스페이스의 두 로우가 같은 rowOID 를 가질 수 있고, tie-break 가
$T0> # rowOID 단독이면 두 키를 같은 것으로 오인한다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
Create success.

$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.

$T0> alter session set explain plan = on;
Alter success.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;
COUNT                
-----------------------
90                   
1 row selected.
------------------------------------------------------------
