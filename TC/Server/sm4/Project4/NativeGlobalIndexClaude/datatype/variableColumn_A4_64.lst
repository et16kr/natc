$T0> ##################################
$T0> # SECTOR; LONG VARCHAR, MULTI TABLESPACE
$T0> ##################################
$T0> # 이 파일이 원래 겨냥한 조합. 플랜은 닫혀 있지만 인덱스는 살아 있으므로,
$T0> # 살아 있다는 증거는 다음 섹터의 유니크 제약으로 잡는다.
$T0> # 여기서는 값이 풀스캔으로 정확히 읽히는지와 플랜 부재를 기록한다.


$T0> create table t1( i1 integer, c1 varchar(2000), c2 varchar(2000), i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
Create success.

$T0> create index gidx1 on t1(c1);
Create success.

$T0> insert into t1 select level, lpad('a', 10, 'a') || level, lpad('x', 10, 'x') || level, level
  from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 100, lpad('b', 100, 'b') || level, lpad('y', 100, 'y') || level, level
  from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 200, lpad('c', 500, 'c') || level, lpad('z', 500, 'z') || level, level
  from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.

$T0> alter session set explain plan = on;
Alter success.

$T0> # 힌트를 줘도 글로벌 인덱스 스캔이 선택되지 않아야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c1 is not null;
COUNT                
-----------------------
90                   
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 8, COST: BLOCKED )
 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 3/3, FULL SCAN, ACCESS: 90, COST: BLOCKED )
   SCAN ( PARTITION: P3, FULL SCAN, ACCESS: 30, COST: BLOCKED )
   SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 30, COST: BLOCKED )
   SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 30, COST: BLOCKED )
------------------------------------------------------------

$T0> # 대조군: 명시적 풀스캔
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 is not null;
COUNT                
-----------------------
90                   
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 8, COST: BLOCKED )
 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 3/3, FULL SCAN, ACCESS: 90, COST: BLOCKED )
   SCAN ( PARTITION: P3, FULL SCAN, ACCESS: 30, COST: BLOCKED )
   SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 30, COST: BLOCKED )
   SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 30, COST: BLOCKED )
------------------------------------------------------------

$T0> alter session set explain plan = off;
Alter success.

