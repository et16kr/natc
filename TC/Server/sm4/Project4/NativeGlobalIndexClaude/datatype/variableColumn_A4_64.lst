$T0> ##################################
$T0> # SECTOR; UNIQUE ON VARCHAR, MULTI TABLESPACE
$T0> ##################################
$T0> # ★ 게이트가 닫힌 조합에서 인덱스 정합을 증명하는 유일한 수단.
$T0> #   인덱스가 어느 파티션의 키를 빠뜨렸다면 아래 중복 삽입이 성공해 버린다.
$T0> #   값이 조각으로 저장될 만큼 길게 잡아, 조각 비교가 실제로 일어나게 한다.


$T0> create table t1( i1 integer, c1 varchar(2000), c2 varchar(2000), i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
Create success.

$T0> create unique index t1_uk on t1(c1);
Create success.

$T0> insert into t1 values (10,  lpad('k', 800, 'k'), 'v1', 1);
1 row inserted.
$T0> commit;
Commit success.

$T0> # 다른 테이블스페이스의 파티션에 같은 값 -> 실패해야 한다
$T0> insert into t1 values (150, lpad('k', 800, 'k'), 'v2', 2);
[ERR-11058 : The row already exists in a unique index.]
$T0> insert into t1 values (250, lpad('k', 800, 'k'), 'v3', 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 한 글자만 달라도 다른 값이다 -> 성공
$T0> insert into t1 values (150, lpad('k', 799, 'k') || 'z', 'v2', 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> select /*+ FULL SCAN(t1) */ i1, length(c1), substr(c1, 795, 6) c1_tail
  from t1 order by i1;
I1          LENGTH(C1)           
------------------------------------
C1_TAIL                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
