$T0> # 방금 만든 값과 중복 -> 실패해야 한다
$T0> insert into t1 values (160, lpad('d', 1500, 'd'), 'x1', 1);
[ERR-11058 : The row already exists in a unique index.]

$T0> update t1 set c1 = 'short' where i1 = 10;
1 row updated.
$T0> commit;
Commit success.

$T0> # 이제 긴 값은 비었으므로 성공해야 한다
$T0> insert into t1 values (160, lpad('d', 1500, 'd'), 'x1', 1);
1 row inserted.
$T0> commit;
