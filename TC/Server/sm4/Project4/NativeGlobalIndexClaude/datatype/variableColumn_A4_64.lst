2 rows selected.

$T0> # 접두사가 같고 뒤가 다른 긴 값들 -> 전부 성공해야 한다
$T0> insert into t1 values (260, lpad('m', 1200, 'm') || 'aaa', 'w1', 1);
1 row inserted.
$T0> insert into t1 values (270, lpad('m', 1200, 'm') || 'aab', 'w2', 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> # 그중 하나와 완전히 같은 값 -> 실패해야 한다
$T0> insert into t1 values (20, lpad('m', 1200, 'm') || 'aab', 'w3', 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> select /*+ FULL SCAN(t1) */ count(*) from t1;
