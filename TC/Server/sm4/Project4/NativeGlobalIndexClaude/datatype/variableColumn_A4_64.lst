$T0> ##################################
$T0> # SECTOR; UPDATE VARCHAR KEY, MULTI TABLESPACE
$T0> ##################################
$T0> # 값을 짧은 것에서 긴 것으로, 긴 것에서 짧은 것으로 바꾼다.
$T0> # 조각 사용 여부가 바뀌는 경계다. 갱신 후에도 유일성이 유지되어야 한다.

$T0> update t1 set c1 = lpad('d', 1500, 'd') where i1 = 10;
1 row updated.
$T0> commit;
Commit success.

$T0> select /*+ FULL SCAN(t1) */ i1, length(c1) from t1 order by i1;
