$T0> ##################################
$T0> # SECTOR; RANGE SCAN ON LONG VARCHAR, ONE TABLESPACE
$T0> ##################################
$T0> # 범위 탐색은 키 비교를 많이 하므로 값 오독이 있으면 결과가 어긋난다.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c1 >= 'b';
COUNT                
-----------------------
60                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 >= 'b';
COUNT                
-----------------------
60                   
1 row selected.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c1 < 'b';
COUNT                
-----------------------
30                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 < 'b';
COUNT                
-----------------------
30                   
1 row selected.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c1 between 'b' and 'c';
COUNT                
-----------------------
30                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 between 'b' and 'c';
COUNT                
-----------------------
30                   
1 row selected.

$T0> ##################################
$T0> # SECTOR; PRUNING GATE WITH A VARIABLE KEY
$T0> ##################################
$T0> # 이 절은 한때 "프루닝 + variable 키 -> 게이트 닫힘" 을 단언했다. 닫은
$T0> # 이유는 키 레인지 콜백이 프루닝으로 잘려나간 파티션의 로우도 만나는데
$T0> # 옵티마이저가 그 파티션의 서술자를 갖고 있지 않다는 것이었다.
$T0> #
$T0> # V4 J11 (A-7 / GR-08) 이 그 게이트를 걷었다. 콜백 자신이 로우마다 owner 의
$T0> # 테이블스페이스로 colSpace 를 보정하므로(qmnSCAN::wrapGlobalKeyRange ->
$T0> # qtc::rangeCallBack*4MtdGlobal) 확인되지 않은 멤버가 남아 있어도 키 비교가
$T0> # 틀리지 않는다 -- v4-stmt-colspace.md 3.
$T0> #
$T0> # 그래서 기대를 뒤집는다. 낮춘 것이 아니라 늘렸다: 닫힌 게이트를 재던
$T0> # 자리는 "플랜에 GLOBAL-INDEX 가 없다" 하나만 볼 수 있었지만, 열린 게이트는
$T0> # 플랜이 글로벌이라는 것과 **그 답이 풀스캔과 같다는 것**을 함께 본다.
$T0> #
$T0> # i1 이 파티션 키다. i1 술어가 있으면 프루닝이 일어난다.

$T0> # 프루닝 없음 -> 열림
$T0> alter session set explain plan = on;
Alter success.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c1 >= 'a';
COUNT                
-----------------------
90                   
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 8, COST: BLOCKED )
 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  SCAN ( TABLE: SYS.T1, INDEX: SYS.GIDX1, GLOBAL-INDEX, RANGE SCAN, ACCESS: 90, COST: BLOCKED )
------------------------------------------------------------

$T0> alter session set explain plan = off;
Alter success.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, substr(c1, 1, 20) from t1 where c1 >= 'a'
    minus
    select /*+ FULL SCAN(t1) */ i1, substr(c1, 1, 20) from t1 where c1 >= 'a'
  )
  order by 1;
I1          
--------------
SUBSTR(C1, 1, 20)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, substr(c1, 1, 20) from t1 where c1 >= 'a'
    minus
    select /*+ index(t1, gidx1) */ i1, substr(c1, 1, 20) from t1 where c1 >= 'a'
  )
  order by 1;
I1          
--------------
SUBSTR(C1, 1, 20)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
