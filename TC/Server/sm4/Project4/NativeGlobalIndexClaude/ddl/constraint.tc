###########################################################################
# TestCase Description = 제약(PK / UK / FK)과 글로벌 인덱스의 상호작용.
#                        구버전 DDL/add_constraint.tc, drop_constraint.tc 에
#                        해당하며, FK 가 글로벌 PK/UK 를 참조하는 경우가
#                        새로 생긴다 - 메모리 파티션드 테이블이 참조 대상이
#                        될 수 있게 되기 때문이다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/checkGlobalIndex.i;
INCLUDE ../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t2;
drop table t1;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; ADD AND DROP CONSTRAINT
##################################

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

CALL FILL_RANGE_DATA();

alter table t1 add constraint t1_pk primary key (i2);
CALL SELECT_INDEX_META( "t1" );
CALL CHECK_GLOBAL_INDEX( "t1", "t1_pk", "i1, i2", "i2" );

alter table t1 add constraint t1_uk unique (i3, i4);
CALL SELECT_INDEX_META( "t1" );

# 제약을 지우면 그 인덱스도 사라져야 한다
alter table t1 drop constraint t1_uk;
CALL SELECT_INDEX_META( "t1" );

alter table t1 drop constraint t1_pk;
CALL SELECT_INDEX_META( "t1" );
CALL CHECK_NO_HIDDEN_OBJECT();

# 지운 뒤 다시 만든다
alter table t1 add constraint t1_pk primary key (i2);
CALL CHECK_GLOBAL_INDEX( "t1", "t1_pk", "i1, i2", "i2" );

##################################
# SECTOR; ADD CONSTRAINT ON DUPLICATE DATA
##################################
# 이미 파티션 간 중복이 있는 데이터에 PK 를 걸면 실패해야 한다.
# 로컬 인덱스로는 잡히지 않던 중복이다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

insert into t1 values (10, 777, 1, 1);
insert into t1 values (150, 777, 2, 2);
commit;

# 파티션 간 중복이 있으므로 실패해야 한다
alter table t1 add constraint t1_pk primary key (i2);

CALL SELECT_INDEX_META( "t1" );

# 중복을 없애면 성공해야 한다
update t1 set i2 = 888 where i1 = 150;
commit;

alter table t1 add constraint t1_pk primary key (i2);
CALL SELECT_INDEX_META( "t1" );
select i1, i2 from t1 order by i1;

##################################
# SECTOR; NOT NULL AND PK
##################################

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

insert into t1 values (10, null, 1, 1);
insert into t1 values (150, 200, 2, 2);
commit;

# NULL 이 있으므로 PK 는 실패해야 한다
alter table t1 add constraint t1_pk primary key (i2);

# UK 는 NULL 을 허용하므로 성공해야 한다
alter table t1 add constraint t1_uk unique (i2);
CALL SELECT_INDEX_META( "t1" );

select i1, nvl(i2, -1) from t1 order by i1;

##################################
# SECTOR; FK REFERENCING GLOBAL PK
##################################
# 자식 테이블의 FK 가 메모리 파티션드 테이블의 글로벌 PK 를 참조한다.
# 참조 검사는 글로벌 인덱스를 통해 전 파티션을 한 번에 본다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

alter table t1 add constraint t1_pk primary key (i2);

insert into t1 values (10, 1000, 1, 1);
insert into t1 values (150, 2000, 2, 2);
insert into t1 values (250, 3000, 3, 3);
commit;

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2( c1 integer, c2 integer ) tablespace sys_tbs_mem_data;

alter table t2 add constraint t2_fk foreign key (c2) references t1 (i2);

# 부모의 각 파티션에 있는 값을 참조 -> 전부 성공해야 한다
insert into t2 values (1, 1000);
insert into t2 values (2, 2000);
insert into t2 values (3, 3000);
commit;

select c1, c2 from t2 order by c1;

# 없는 값을 참조 -> 실패해야 한다
insert into t2 values (4, 9999);

commit;

##################################
# SECTOR; FK BLOCKS PARENT DELETE
##################################
# 참조되고 있는 부모 로우는 지울 수 없어야 한다.
# 부모 로우가 어느 파티션에 있든 마찬가지다.

delete from t1 where i2 = 1000;

delete from t1 where i2 = 2000;

delete from t1 where i2 = 3000;

# 참조되지 않는 값은 지울 수 있어야 한다
insert into t1 values (250, 4000, 3, 3);
commit;
delete from t1 where i2 = 4000;
commit;

select i1, i2 from t1 order by i1;

##################################
# SECTOR; FK AND ROW MOVEMENT
##################################
# 참조되는 부모 로우가 파티션 사이를 이동해도 참조는 유지되어야 한다.

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
enable row movement
tablespace sys_tbs_mem_data;

alter table t1 add constraint t1_pk primary key (i2);

insert into t1 values (10, 1000, 1, 1);
commit;

create table t2( c1 integer, c2 integer ) tablespace sys_tbs_mem_data;
alter table t2 add constraint t2_fk foreign key (c2) references t1 (i2);

insert into t2 values (1, 1000);
commit;

# 부모 로우를 다른 파티션으로 이동. PK 값은 그대로이므로 참조 유지.
update t1 set i1 = 250 where i2 = 1000;
commit;

select i1, i2 from t1 order by i1;
select c1, c2 from t2 order by c1;

# 이동 후에도 부모 삭제는 막혀야 한다
delete from t1 where i2 = 1000;

# 자식을 먼저 지우면 부모를 지울 수 있어야 한다
delete from t2;
commit;
delete from t1 where i2 = 1000;
commit;

select count(*) from t1;
select count(*) from t2;

##################################
# SECTOR; DROP CONSTRAINT WITH FK PRESENT
##################################
# 참조되고 있는 PK 는 지울 수 없어야 한다.

insert into t1 values (10, 1000, 1, 1);
commit;
insert into t2 values (1, 1000);
commit;

alter table t1 drop constraint t1_pk;

# 자식 제약을 먼저 지우면 가능해야 한다
alter table t2 drop constraint t2_fk;
alter table t1 drop constraint t1_pk;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
