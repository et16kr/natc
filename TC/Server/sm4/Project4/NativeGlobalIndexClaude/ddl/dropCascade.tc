###########################################################################
# TestCase Description = DROP USER CASCADE 와 DROP TABLESPACE INCLUDING
#                        CONTENTS. 글로벌 인덱스가 걸린 테이블이 통째로
#                        정리되는 경로다.
#                        구버전 meta/drop_user.tc, meta/drop_tablespace.tc 에
#                        해당하며, 그때는 숨김 테이블 $GIT_ 까지 함께
#                        지워지는지가 관심사였다. 네이티브는 지울 숨김 객체가
#                        없으므로 관심사가 "잔재가 남지 않는가"로 바뀐다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
SKIP BEGIN;
drop user gidxuser cascade;
SKIP END;
CALL FINALIZE_MEM_TBS();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

#
# 사용자 소유 객체를 전부 훑는다. drop 후 아무것도 남지 않아야 한다.
#
DEF SELECT_USER_OBJECT( @aUser )
{
  select t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.user_id = u.user_id and u.user_name = upper('@{aUser}')
  order by t.table_name;

  select i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where i.user_id = u.user_id and u.user_name = upper('@{aUser}')
  order by i.index_name;

  select count(*) part_index_cnt
  from system_.sys_part_indices_ p, system_.sys_users_ u
  where p.user_id = u.user_id and u.user_name = upper('@{aUser}');
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; DROP USER CASCADE
##################################
# 글로벌 인덱스와 PK 를 가진 파티션드 테이블을 소유한 사용자를 지운다.

create user gidxuser identified by gidxuser;
grant all privileges to gidxuser;

NODISPLAY ON;
$sConn = "connect gidxuser/gidxuser;";
NODISPLAY OFF;

connect gidxuser/gidxuser;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

create index gidx1 on t1(i2);
create index gidx2 on t1(i3);
create index lidx1 on t1(i4) local;
alter table t1 add constraint t1_pk primary key (i2, i3);

insert into t1 select level,       level,       level, level from dual connect by level <= 20;
insert into t1 select level + 100, level + 100, level, level from dual connect by level <= 20;
insert into t1 select level + 200, level + 200, level, level from dual connect by level <= 20;
commit;

select count(*) from t1;

connect sys/manager;

CALL SELECT_USER_OBJECT( "gidxuser" );

drop user gidxuser cascade;

# 잔재가 하나도 없어야 한다
CALL SELECT_USER_OBJECT( "gidxuser" );
CALL CHECK_NO_HIDDEN_OBJECT();

##################################
# SECTOR; DROP TABLESPACE INCLUDING CONTENTS
##################################
# 파티션이 들어 있는 테이블스페이스를 통째로 지운다.

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);

create index gidx1 on t1(i2) tablespace mem1;
create index gidx2 on t1(i3) tablespace sys_tbs_mem_data;

insert into t1 select level,       level,       level, level from dual connect by level <= 20;
insert into t1 select level + 100, level + 100, level, level from dual connect by level <= 20;
insert into t1 select level + 200, level + 200, level, level from dual connect by level <= 20;
commit;

CALL SELECT_INDEX_META( "t1" );

# 사용 중인 테이블스페이스는 그냥 지울 수 없어야 한다
drop tablespace mem2;

# 내용까지 지우면 테이블도 함께 사라진다
drop tablespace mem2 including contents and datafiles;

CALL SELECT_INDEX_META( "t1" );
CALL CHECK_NO_HIDDEN_OBJECT();

select count(*) from t1;

##################################
# SECTOR; DROP TABLESPACE HOLDING THE INDEX
##################################
# 인덱스만 들어 있는 테이블스페이스를 지운다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

CALL FINALIZE_MEM_TBS();
CALL PREPARE_MEM_TBS();

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

# 인덱스만 mem1 에 둔다
create index gidx1 on t1(i2) tablespace mem1;

insert into t1 select level, level, level, level from dual connect by level <= 20;
commit;

CALL SELECT_INDEX_META( "t1" );

drop tablespace mem1 including contents and datafiles;

CALL SELECT_INDEX_META( "t1" );

# 테이블은 남아 있어야 한다
select count(*) from t1;
select i1, i2 from t1 where i2 <= 3 order by i1;

##################################
# SECTOR; DROP TABLE THEN RECREATE SAME NAME
##################################
# 같은 이름으로 다시 만들었을 때 옛 카탈로그 잔재가 섞이면 안 된다.

drop table t1;

CALL SELECT_INDEX_META( "t1" );

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL SELECT_INDEX_META( "t1" );

CALL FILL_RANGE_DATA();
select count(*) from t1;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
