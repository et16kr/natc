$T0> ##################################
$T0> # SECTOR; DIRECTKEY AND PERSISTENT OPTIONS
$T0> ##################################
$T0> # 글로벌과 결합할 수 없는 인덱스 옵션들.
$T0> #
$T0> # DIRECTKEY: 파티션드 테이블에 대해서는 기존 검사가 먼저 걸린다
$T0> #            (smERR_ABORT_NonDirectKeyOption 계열). 즉 여기서 보이는 것은
$T0> #            네이티브 글로벌의 ERR-314AD 가 아닐 수 있다. 어느 쪽이 나오든
$T0> #            "거부된다"는 사실이 이 섹터가 고정하는 것이다.
$T0> # PERSISTENT: qdx::validateNativeGlobalIndexOption 의 ERR_PERSISTENT ->
$T0> #            ERR-314AD (UNSUPPORTED_KEY: PERSISTENT).

$T0> create index gidx_dk on t1(i2) directkey;
[ERR-111A9 : Direct key indexes do not support partitioned tables.]

$T0> # PERSISTENT 는 CREATE 옵션이 아니라 ALTER INDEX 전용이다.
$T0> create index gidx_pst on t1(i2);
Create success.
$T0> alter index gidx_pst persistent on;
Alter success.
$T0> drop index gidx_pst;
Drop success.

$T0> # 로컬 인덱스로는 기존대로 되어야 한다
$T0> create index lidx_dk on t1(i2) local directkey;
[ERR-111A9 : Direct key indexes do not support partitioned tables.]

$T0> desc t1;
[ TABLESPACE : SYS_TBS_MEM_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER         FIXED       
I2                                       INTEGER         FIXED       
I3                                       INTEGER         FIXED       
I4                                       INTEGER         FIXED       
T1 has no index
T1 has no primary key

$T0> ##################################
$T0> # SECTOR; COMPRESSED KEY COLUMN
$T0> ##################################
$T0> # 압축 컬럼을 키로 쓰면 거부된다.
$T0> # ERR-314AD (UNSUPPORTED_KEY: COMPRESSED key column).


$T0> # 압축은 컬럼 뒤에 붙이는 키워드가 아니라 테이블 수준 COMPRESS 절이다.
$T0> create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data
compress ( i2 );
[ERR-313B6 : Unsupported data type on compression column. 
0001 : create table T1( I1 INTEGER, I2 INTEGER, I3 INTEGER )
                                   ^ ^
]

$T0> create index gidx_cmp on t1(i2);
[ERR-31031 : Table or view was not found : 
0001 : create index GIDX_CMP on T1(I2)
                               ^ ^
]

$T0> # 압축이 아닌 컬럼은 되어야 한다
$T0> create index gidx_ok on t1(i3);
[ERR-31031 : Table or view was not found : 
0001 : create index GIDX_OK on T1(I3)
                              ^ ^
]

$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
