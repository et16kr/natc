$T0> # ★ t2 를 여기서 지운다. 인덱스 이름은 사용자 단위로 유일하므로, t2 의
$T0> #   GIDX1 을 살려 두면 아래 두 섹터의 "create index gidx1 on t1(i2)" 가
$T0> #   자기가 재려는 판정에 닿지 못하고 ERR-3104C(중복 인덱스 이름)로 먼저
$T0> #   죽는다. 실제로 그래 왔다 -- 매체 혼합 섹터는 ERR-314AB 를 잰다고
$T0> #   적어 두고 ERR-3104C 를 재고 있었다(D23 발견).

$T0> ##################################
$T0> # SECTOR; DISK LOGICAL TABLE WITH MEMORY PARTITIONS
$T0> ##################################
$T0> # 논리 테이블만 디스크. 매체가 섞이므로 거부되어야 한다 (ERR-314AB).
$T0> # createIndexError.tc 와 겹치지만, 여기서는 "디스크 쪽 판정" 의 일부로
$T0> # 다시 확인한다.


$T0> create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace sys_tbs_mem_data,
  partition p2 values default tablespace sys_tbs_mem_data
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index gidx1 on t1(i2);
[ERR-314AB : A native global index requires the partitioned table and every one of its partitions to reside in memory tablespaces.]

$T0> ##################################
$T0> # SECTOR; DISK NATIVE - DISK_GLOBAL_INDEX_ENABLE = 1
$T0> ##################################
$T0> # ★ D17 이 뒤집는 기대다. 위 섹터들이 고정한 "디스크는 종전 그대로" 는
$T0> #   지금도 참이지만, 그것은 MEM_GLOBAL_INDEX_ENABLE 에 대해서만이다.
$T0> #   디스크는 별도 스위치 DISK_GLOBAL_INDEX_ENABLE 을 갖고, 그것을
$T0> #   켜면 같은 문장이 $GIT_ 대신 네이티브 글로벌 인덱스를 만든다.
$T0> #   (이 섹터가 처음 적힐 때 그 스위치의 기본값은 0 이었다. 지금은 1 이라
$T0> #   앞쪽 섹터들이 0 을 못박고, 이 섹터가 1 을 되세운다 -- 머리말 참조.)
$T0> #
$T0> #   집계 컬럼에 별칭을 붙이는 것은 취향이 아니다 -- count(*) 의 헤더
$T0> #   라벨이 클라이언트에 따라 COUNT / COUNT(*) 로 갈려서, 별칭이 없으면
$T0> #   기대 출력이 서버가 아니라 클라이언트를 시험하게 된다.

$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
