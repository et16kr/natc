$T0> # SECTOR; DISK - $GIT_ 와 네이티브의 공존
$T0> ##################################
$T0> # 전환 규약: 스위치를 켜기 전에 만든 $GIT_ 인덱스는 그대로 살아 있고,
$T0> # 켠 뒤에 만든 것만 네이티브다. 둘이 한 테이블에 공존하며 둘 다 답한다.
$T0> #
$T0> # 여기서는 SELECT_INDEX_META 대신 카탈로그 뷰 셋만 본다 --
$T0> # CHECK_NO_HIDDEN_OBJECT 의 '$GIT[_]%' ESCAPE '[' 패턴은 보이는 것과
$T0> # 달리 "$GIT_]%" 를 뜻해서 숨김 테이블이 있어도 잡지 못한다. 공존을
$T0> # 가르는 진짜 필드는 INDEX_TABLE_ID 이므로 그것을 본다.

$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
0                                                                                                                                                                                                                                                                 
1 row selected.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index gidx_old on t1(i2);
Create success.

$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> create index gidx_new on t1(i3);
Create success.

$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
IS_UNIQUE  IS_PARTITIONED  INDEX_TABLE_ID_KIND  
----------------------------------------------------
GIDX_NEW                                                                                                                          
F  F  ZERO     
GIDX_OLD                                                                                                                          
F  F  NONZERO  
2 rows selected.
$T0> select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PARTITION_TYPE 
-----------------
GIDX_NEW                                                                                                                          
101         
1 row selected.
$T0> select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PART_INDEX_CNT       
-----------------------
No rows selected.

$T0> insert into t1 select level,       level,       level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 100, level + 100, level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 200, level + 200, level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx_old) */ count(*) row_cnt from t1 where i2 >= 0;
ROW_CNT              
-----------------------
90                   
1 row selected.
$T0> select /*+ index(t1, gidx_new) */ count(*) row_cnt from t1 where i3 >= 0;
ROW_CNT              
-----------------------
90                   
1 row selected.

$T0> # 한 INSERT 가 둘 다에 반영된다
$T0> insert into t1 values (150, 777, 888, 9);
1 row inserted.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx_old) */ i1 from t1 where i2 = 777;
I1          
--------------
150         
1 row selected.
$T0> select /*+ index(t1, gidx_new) */ i1 from t1 where i3 = 888;
I1          
--------------
150         
1 row selected.

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################
$T0> # 파일 기본값 1 로 되돌린다. 이 케이스는 0 을 여러 번 세우고 끝나므로,
$T0> # 되돌리지 않으면 같은 인스턴스에서 이어 도는 다음 케이스가 0 을 물려
$T0> # 받는다 -- 옛 코드가 정확히 그렇게 끝나고 있었다(마지막 문장이 0).

$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

