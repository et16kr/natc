$T0> ##################################
$T0> # SECTOR; PROPERTY ON - MUST BE IDENTICAL
$T0> ##################################
$T0> # ★ 프로퍼티를 켜도 디스크 테이블의 동작이 달라지면 안 된다.
$T0> #   위 섹터와 출력이 한 글자도 달라선 안 된다.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.


