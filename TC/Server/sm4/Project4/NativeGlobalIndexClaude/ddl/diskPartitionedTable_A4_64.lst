 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Native Global Index - environment helpers
$T0> #
$T0> # 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
$T0> # 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
$T0> #   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
$T0> #   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 허용한다.
$T0> #

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
$T0> # off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
$T0> # 기존과 동일하게 거부되어야 한다.
$T0> #

$T0> #
$T0> # 현재 설정 확인.
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - catalog inspection helpers
$T0> #
$T0> # 구버전(PROJ-1624)의 meta 테스트는 "숨김 객체가 이렇게 보인다"를
$T0> # 검증했다. 네이티브에서는 검증 방향이 정반대다: 숨김 객체가
$T0> # 생기지 않아야 하고, 대신 SYS_PART_INDICES_ 에 판별자 행이 하나 있어야
$T0> # 한다.
$T0> ###########################################################################

$T0> #
$T0> # 숨김 글로벌 인덱스 객체가 하나도 없어야 한다.
$T0> # 구버전은 여기서 $GIT_/$GIK_/$GIR_ 가 줄줄이 나왔다.
$T0> #

$T0> #
$T0> # SYS_INDICES_ 에서 본 글로벌 인덱스의 모습.
$T0> #
$T0> # 네이티브 글로벌 인덱스는 숨김 방식과 마찬가지로 IS_PARTITIONED = 'F'
$T0> # 이지만, INDEX_TABLE_ID 가 0 이어야 한다(숨김 테이블이 없으므로).
$T0> # 숨김 방식은 INDEX_TABLE_ID 가 0 이 아니다. 이것이 두 방식의
$T0> # 카탈로그 상 구분점이다.
$T0> #

$T0> #
$T0> # SYS_PART_INDICES_ 의 판별자 행.
$T0> #
$T0> # 네이티브 글로벌 인덱스는 여기에 행을 하나 남긴다. 캐시 로더가
$T0> # IS_PARTITIONED='F' 를 보고 무조건 non-partitioned 로 하드코딩하기
$T0> # 때문에, 재기동 후에도 네이티브임을 알아보려면 이 행이 필요하다.
$T0> # 숨김 방식은 이 행을 만들지 않는다.
$T0> #

$T0> #
$T0> # SYS_INDEX_PARTITIONS_ 에는 행이 없어야 한다.
$T0> # 물리 인덱스가 파티션별로 존재하지 않는 것이 로컬 인덱스와의 구분점이다.
$T0> #

$T0> #
$T0> # 한 테이블의 인덱스 카탈로그 전경.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = 디스크 파티션드 테이블의 non-partitioned index 가
$T0> #                        어느 스위치에 반응하는지.
$T0> #
$T0> #   ★ 이 파일의 전제는 D17 이 한 번 뒤집었다 (2026-08-04).
$T0> #
$T0> #   처음 이 케이스가 고정한 것은 "네이티브 글로벌 인덱스는 메모리 전용이며,
$T0> #   디스크 파티션드 테이블은 프로퍼티를 켜도 구버전(PROJ-1624)의 숨김
$T0> #   테이블 방식을 그대로 쓴다" 였다(코드 리뷰 P0-4). 그 문장의 앞 절반은
$T0> #   더 이상 참이 아니다 -- D17 이 디스크 네이티브 경로를 열었다.
$T0> #
$T0> #   뒤 절반은 여전히 참이고, 그것이 이 파일이 계속 지키는 것이다:
$T0> #   **MEM_GLOBAL_INDEX_ENABLE 은 디스크를 한 바이트도 움직이지 못한다.**
$T0> #   매체마다 스위치가 따로이기 때문이다 -- 메모리는 그 프로퍼티,
$T0> #   디스크는 DISK_GLOBAL_INDEX_ENABLE. off 의 뜻도 다르다:
$T0> #   메모리 off 는 그 문장을 실패시키고, 디스크 off 는 그 문장을 종전
$T0> #   구현으로 성공시킨다.
$T0> #
$T0> #   그래서 섹터가 두 부류다.
$T0> #     - 앞쪽(PROPERTY OFF / PROPERTY ON / PK / UK): 메모리 스위치를 켜도
$T0> #       디스크는 $GIT_ 그대로. 회귀 0 의 그물이다.
$T0> #     - 뒤쪽(DISK NATIVE ...): 디스크 스위치를 켜면 같은 문장이 네이티브를
$T0> #       만든다. 그리고 그 전에 만든 $GIT_ 인덱스는 계속 산다.
$T0> #
$T0> #   구분점:
$T0> #     네이티브  : SYS_PART_INDICES_.PARTITION_TYPE = 101, INDEX_TABLE_ID = 0
$T0> #     구버전    : SYS_PART_INDICES_ 행 없음, INDEX_TABLE_ID != 0
$T0> #
$T0> #   ★ 전제는 2026-08-06 에 한 번 더 뒤집혔다 (V3 D-4).
$T0> #
$T0> #   두 프로퍼티의 파일 기본값이 개발 기간 동안 **둘 다 1** 이 됐다
$T0> #   (idpDescResource.cpp). 이 파일은 디스크 스위치의 기본값이 0 이라고
$T0> #   믿고 앞쪽 네 섹터를 적었기 때문에, 그 전환만으로 아홉 자리가
$T0> #   어긋났다 -- 전부 같은 모양이다:
$T0> #     INDEX_TABLE_ID  NONZERO -> ZERO
$T0> #     SYS_PART_INDICES_  행 없음 -> PARTITION_TYPE 101
$T0> #     SYS_INDEX_PARTITIONS_  T1_PK 3 행 -> 없음
$T0> #   즉 $GIT_ 를 잰다고 적어 놓고 네이티브를 재고 있었다.
$T0> #
$T0> #   그래서 이제 **두 부류가 각자 자기 전제를 세운다.** 기본값이 어느
$T0> #   쪽으로 움직여도 이 파일은 자기가 재려는 것을 잰다:
$T0> #     - 앞쪽: PREPARATION 이 DISK_GLOBAL_INDEX_ENABLE = 0 을 못박는다.
$T0> #       그 사이에 값을 바꾸는 문장이 없으므로 네 섹터가 함께 덮인다.
$T0> #     - 뒤쪽: 원래도 스스로 1 을 세우고 있었다. 이제 세운 값을
$T0> #       v$property 로 전사에 남겨, 전사가 자기 전제를 적게 한다.
$T0> #     - FINALIZE: 파일 기본값 1 로 되돌려 다음 케이스에 0 이 새지 않게
$T0> #       한다. 이 프로퍼티는 비영속이라 재기동으로도 1 로 돌아가지만,
$T0> #       한 인스턴스 위에서 스위트가 이어 도는 동안은 이것이 유일한
$T0> #       복원이다.
$T0> #
$T0> # Project ID           = Native Global Index (memory + disk)
$T0> ###########################################################################

$T0> #
$T0> # 디스크 쪽 스위치. globalIndexEnv.i 의 ENABLE/DISABLE_GLOBAL_INDEX 는
$T0> # 메모리 프로퍼티만 만지므로 여기 짝을 둔다.
$T0> #
$T0> # 공유 include 에 넣지 않는 이유: ATC 는 INCLUDE 한 파일의 주석까지
$T0> # 전사에 찍는다. 거기에 한 줄이라도 넣으면 스위트 37 개의 .lst 가 전부
$T0> # 움직인다 -- 이 job 이 대지 못할 변화를 36 개에 굳히게 된다
$T0> # (disk-natc.md 4 가 같은 이유로 피한 자리다).
$T0> #
$T0> # 세운 값을 곧바로 읽는 것이 요점이다: 전사 자체가 자기 전제를 적게 된다.
$T0> #

$T0> #
$T0> # 디스크 파티션드 테이블. 파티션 키는 i1.
$T0> #

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

$T0> # 앞쪽 네 섹터(PROPERTY OFF / PROPERTY ON / PK / UK)의 전제.
$T0> # 그것들이 재는 것은 $GIT_ 구현이고, 그 구현은 이 값이 0 일 때만
$T0> # 만들어진다. 파일 기본값은 1 이므로 여기서 세우지 않으면 네 섹터가
$T0> # 이름과 다른 것(네이티브)을 재게 된다 -- 실제로 그랬다.
$T0> # 뒤쪽 DISK NATIVE 섹터들이 각자 1 로 다시 세운다.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
0                                                                                                                                                                                                                                                                 
1 row selected.

$T0> ##################################
$T0> # SECTOR; PROPERTY OFF - BASELINE
$T0> ##################################
$T0> # 프로퍼티가 꺼진 상태의 디스크 파티션드 테이블. 이것이 기준선이다.
$T0> # 아래 "PROPERTY ON" 섹터의 출력이 여기와 같아야 한다.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> # 파티션 키를 포함하지 않는 인덱스 -> 구버전 글로벌 인덱스가 만들어진다
$T0> create index gidx1 on t1(i2);
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
GIDX1                                    BTREE                  I2 ASC
T1 has no primary key
$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
