$T0> # SECTOR; OFFLINE / ONLINE WITH A UNIQUE GLOBAL INDEX
$T0> ##################################
$T0> # 유일성 강제가 되살아나는지가 이 섹터의 초점이다.


$T0> create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace sys_tbs_mem_data,
  partition p2 values default tablespace memoff
);
Create success.

$T0> create unique index t1_uk on t1(i2);
Create success.

$T0> insert into t1 values (10,  100, 1);
1 row inserted.
$T0> insert into t1 values (150, 200, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> alter tablespace memoff offline;
Alter success.
$T0> alter tablespace memoff online;
Alter success.

$T0> # 파티션을 넘는 중복 -> 여전히 실패해야 한다
$T0> insert into t1 values (250, 100, 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 새 값 -> 성공
$T0> insert into t1 values (250, 300, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;
I1          I2          
