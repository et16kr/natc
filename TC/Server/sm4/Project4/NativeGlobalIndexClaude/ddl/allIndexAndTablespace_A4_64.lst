$T0> # SECTOR; TABLESPACE OFFLINE / ONLINE
$T0> ##################################
$T0> # 파티션 하나가 별도 테이블스페이스에 있고, 그 테이블스페이스를 내렸다
$T0> # 올린다.
$T0> #
$T0> # 이전에는 ONLINE 경로가 런타임 인덱스 헤더를 다시 만들면서 네이티브
$T0> # 글로벌 인덱스를 처리하지 못해 테이블스페이스가 영영 못 올라왔다.
$T0> # 지금은 인덱스를 fail-closed 로 닫고 ONLINE 자체는 성공해야 한다.


$T0> create memory tablespace memoff size 32M autoextend on checkpoint path 'dbs';
Create success.

$T0> create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace sys_tbs_mem_data,
  partition p2 values default tablespace memoff
);
Create success.

$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 values (10,  1, 1);
1 row inserted.
$T0> insert into t1 values (150, 2, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> # 내리기 전에는 정상
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
COUNT                
-----------------------
2                    
1 row selected.

$T0> alter tablespace memoff offline;
Alter success.

$T0> # 내려간 동안의 조회. 조용히 틀린 답이 나오면 안 된다.
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
[ERR-11110 : The index is inconsistent]
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;
[ERR-110FB : Unable to use an offline tablespace. (NAME=MEMOFF)]

$T0> alter tablespace memoff online;
Alter success.

$T0> # 올라온 뒤에는 다시 정상이어야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
[ERR-11110 : The index is inconsistent]
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;
COUNT                
