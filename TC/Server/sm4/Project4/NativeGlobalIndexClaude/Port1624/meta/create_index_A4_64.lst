$T0> ##########################################################################
$T0> # PORT EDIT: ask what i.is_global was meant to ask
$T0> #
$T0> # Original lines 95-98 were this, unchanged since the project landed:
$T0> #
$T0> #   select u.user_name, i.index_name, i.index_type, i.is_unique,
$T0> #          b.name tbs_name, i.is_partitioned, i.is_global
$T0> #   from system_.sys_tables_ t, system_.sys_indices_ i,
$T0> #        system_.sys_users_ u, v$tablespaces b
$T0> #   where t.table_name = 'T1' and t.table_id = i.table_id
$T0> #     and i.user_id = u.user_id and i.tbs_id = b.id
$T0> #   order by i.index_id;
$T0> #
$T0> # SYS_INDICES_ has no IS_GLOBAL column and never had one -- 15 columns,
$T0> # USER_ID .. LAST_DDL_TIME. So the statement dies with ERR-31058 and the
$T0> # original's own expectation records the error, column caret and all
$T0> # (meta/create_index_A4_64.lst:295). It is the one place in this case that
$T0> # asks "is this index global?", and it has never once answered.
$T0> #
$T0> # Porting it unchanged would carry the dead statement onto the native path
$T0> # and freeze the same ERR-31058 as an expectation. An error frozen as an
$T0> # expectation goes green when the reason changes (v3-natc-port.md 6.1), and
$T0> # this one would go green the day someone adds the column -- which is
$T0> # exactly the day it would start mattering.
$T0> #
$T0> # So the port asks the question the column was meant to answer, out of the
$T0> # catalog that actually holds it: SYS_PART_INDICES_.PARTITION_TYPE = 101 is
$T0> # the native discriminator (globalIndexEnv.i's SHOW_INDEX_MEDIA uses the
$T0> # same three-way split). Everything else about the statement is kept --
$T0> # same join, same columns, same table -- and the order by moves from
$T0> # i.index_id to the name, because this case prints no ids (they are a
$T0> # function of how many objects the instance has ever created).
$T0> #
$T0> # TEETH: with DISK_GLOBAL_INDEX_ENABLE = 0 the eight indexes below are
$T0> # built as hidden tables, so INDEX_TABLE_ID is non-zero and KIND reads
$T0> # GIT-HIDDEN-TABLE for every one of them instead of NATIVE-GLOBAL.
$T0> ##########################################################################

$T0> select cast(u.user_name as varchar(8)) user_name,
       cast(i.index_name as varchar(8)) index_name,
       i.index_type, cast(i.is_unique as varchar(2)) is_unique,
       cast(b.name as varchar(18)) tbs_name,
       cast(i.is_partitioned as varchar(2)) is_part,
       cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                  when i.is_partitioned = 'T'         then 'LOCAL'
                  when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                  else 'UNKNOWN' end as varchar(16) ) kind
from system_.sys_tables_ t, system_.sys_indices_ i, system_.sys_users_ u, v$tablespaces b,
     ( select index_id, max(partition_type) partition_type
       from system_.sys_part_indices_ group by index_id ) p
where t.table_name = 'T1' and t.table_id = i.table_id and i.user_id = u.user_id and i.tbs_id = b.id
  and i.index_id = p.index_id(+)
order by 1, 2;
USER_NAME  INDEX_NAME  INDEX_TYPE  IS_UNIQUE  TBS_NAME            IS_PART  KIND              
-----------------------------------------------------------------------------------------------------
SYS       IDX1      1           F   SYS_TBS_DISK_DATA   F   NATIVE-GLOBAL     
SYS       IDX2      1           F   DATA1               F   NATIVE-GLOBAL     
SYS       IDX3      1           F   DATA1               F   NATIVE-GLOBAL     
SYS       IDX4      1           F   DATA2               F   NATIVE-GLOBAL     
SYS       IDX5      1           F   DATA2               F   NATIVE-GLOBAL     
USER1     IDX6      1           F   SYS_TBS_DISK_DATA   F   NATIVE-GLOBAL     
USER1     IDX7      1           F   SYS_TBS_DISK_DATA   F   NATIVE-GLOBAL     
USER1     IDX8      1           F   SYS_TBS_DISK_DATA   F   NATIVE-GLOBAL     
8 rows selected.
$T0> ##########################################################################
$T0> # PORT EDIT END
$T0> ##########################################################################

$T0> ##################################
$T0> # SECTOR; CREATE INDEX
$T0> ##################################

$T0> connect user1/user1;
Connect success.

$T0> create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer constraint t2_nn not null,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index idx1 on t2(i1) tablespace sys_tbs_disk_data;
Create success.
$T0> create index idx2 on t2(i1, i2) tablespace data1;
Create success.
$T0> create index idx3 on t2(i1, i2 desc, i3) tablespace data1;
Create success.

$T0> create index idx4 on t2(i2) tablespace data2;
Create success.
$T0> create index idx5 on t2(i2, i3 desc) tablespace data2;
Create success.

$T0> connect sys/manager;
Connect success.

$T0> # 겹 0 -- 숨김 객체가 없다 (원본 질의 1·3 의 자리)
$T0> select count(case when t.table_name like '$GIT!_%' escape '!' then 1 end) git_table,
       count(*) dollar_table
from system_.sys_tables_ t
where t.table_name like '$%';
GIT_TABLE            DOLLAR_TABLE         
---------------------------------------------
0                    0                    
1 row selected.

$T0> select count(case when i.index_name like '$GIK!_%' escape '!' then 1 end) gik_index,
       count(case when i.index_name like '$GIR!_%' escape '!' then 1 end) gir_index,
       count(*) dollar_index
from system_.sys_indices_ i
where i.index_name like '$%';
GIK_INDEX            GIR_INDEX            DOLLAR_INDEX         
-------------------------------------------------------------------
0                    0                    0                    
1 row selected.

$T0> # 겹 1 -- 그 자리에 있는 것 (파티션드 테이블 위의 인덱스 전량)
$T0> select cast(u.user_name as varchar(8)) user_name,
       cast(t.table_name as varchar(6)) table_name,
       cast(i.index_name as varchar(8)) index_name,
       cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                  when i.is_partitioned = 'T'         then 'LOCAL'
                  when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                  else 'UNKNOWN' end as varchar(16) ) kind,
       cast(i.is_unique as varchar(2)) uq,
       cast(b.name as varchar(18)) tbs_name
from system_.sys_indices_ i, system_.sys_tables_ t, system_.sys_users_ u,
     v$tablespaces b,
     ( select index_id, max(partition_type) partition_type
       from system_.sys_part_indices_ group by index_id ) p
where i.table_id = t.table_id
  and i.user_id = u.user_id
  and i.tbs_id = b.id
  and i.index_id = p.index_id(+)
  and t.table_id in ( select table_id from system_.sys_part_tables_ )
  and t.table_name in ( 'T1', 'T2', 'T3' )
order by 1, 2, 3;
USER_NAME  TABLE_NAME  INDEX_NAME  KIND              UQ  TBS_NAME            
------------------------------------------------------------------------------------
SYS       T1      IDX1      NATIVE-GLOBAL     F   SYS_TBS_DISK_DATA   
SYS       T1      IDX2      NATIVE-GLOBAL     F   DATA1               
SYS       T1      IDX3      NATIVE-GLOBAL     F   DATA1               
SYS       T1      IDX4      NATIVE-GLOBAL     F   DATA2               
SYS       T1      IDX5      NATIVE-GLOBAL     F   DATA2               
USER1     T1      IDX6      NATIVE-GLOBAL     F   SYS_TBS_DISK_DATA   
USER1     T1      IDX7      NATIVE-GLOBAL     F   SYS_TBS_DISK_DATA   
USER1     T1      IDX8      NATIVE-GLOBAL     F   SYS_TBS_DISK_DATA   
USER1     T2      IDX1      NATIVE-GLOBAL     F   SYS_TBS_DISK_DATA   
USER1     T2      IDX2      NATIVE-GLOBAL     F   DATA1               
USER1     T2      IDX3      NATIVE-GLOBAL     F   DATA1               
USER1     T2      IDX4      NATIVE-GLOBAL     F   DATA2               
USER1     T2      IDX5      NATIVE-GLOBAL     F   DATA2               
13 rows selected.

$T0> # 겹 2 -- 키 컬럼과 자료형 (원본 질의 2·4 의 자리)
$T0> select cast(u.user_name as varchar(8)) user_name,
       cast(t.table_name as varchar(6)) table_name,
       cast(i.index_name as varchar(8)) index_name,
       j.index_col_order ord,
       cast(c.column_name as varchar(8)) column_name,
       cast(d.type_name as varchar(10)) type_name,
       cast(j.sort_order as varchar(2)) sort_order
from system_.sys_indices_ i, system_.sys_tables_ t, system_.sys_users_ u,
     system_.sys_index_columns_ j, system_.sys_columns_ c, v$datatype d
where i.table_id = t.table_id
  and i.user_id = u.user_id
  and i.index_id = j.index_id
  and j.column_id = c.column_id
  and c.data_type = d.data_type
  and t.table_id in ( select table_id from system_.sys_part_tables_ )
  and t.table_name in ( 'T1', 'T2', 'T3' )
order by 1, 2, 3, 4;
USER_NAME  TABLE_NAME  INDEX_NAME  ORD         COLUMN_NAME  TYPE_NAME   SORT_ORDER  
--------------------------------------------------------------------------------------------
SYS       T1      IDX1      0           I1        INTEGER     A   
SYS       T1      IDX2      0           I1        INTEGER     A   
SYS       T1      IDX2      1           I2        INTEGER     A   
