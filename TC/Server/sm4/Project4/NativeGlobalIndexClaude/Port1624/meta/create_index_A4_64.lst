SYS       T1      IDX3      1           101         0           
SYS       T1      IDX4      1           101         0           
SYS       T1      IDX5      1           101         0           
USER1     T1      IDX6      1           101         0           
USER1     T1      IDX7      1           101         0           
USER1     T1      IDX8      1           101         0           
8 rows selected.

$T0> select u.user_name, t.table_name, t.table_type, t.hidden, b.name tbs_name 
from system_.sys_tables_ t, system_.sys_users_ u, v$tablespaces b
where t.table_name = 'T1' and t.user_id = u.user_id and t.tbs_id = b.id
order by t.table_id;
