 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
--###########################################################################
--# ported from qp4/Project3/PROJ-1624-GlobalIndex/bugs/reset_subquery_exec.sql
--#
--# Body below is byte-identical to the original. The one line this port
--# adds is the premise: the original measures these statements on the
--# $GIT_ hidden-table implementation, this file measures the same
--# statements on the native global index (F07 -- see include/pinNative.sql).
--###########################################################################
--###########################################################################
--# NativeGlobalIndexPort1624 - the premise of every ported .sql case.
--#
--# A .sql case cannot CALL a DEF the way a .tc case calls PIN_DISK_NATIVE(),
--# so the same two statements are pulled in per case with ATC's own include
--# directive:
--#
--#     --+LOAD_SQL <relative path>/include/pinNative.sql;
--#
--# ATC inlines this file into the case transcript between BEGIN/END markers,
--# which is exactly what F07 asks for: the case states its own premise at the
--# head of its own transcript instead of inheriting whatever the instance
--# happens to be configured with.
--#
--#     DISK_GLOBAL_INDEX_ENABLE = 1  -> native  (this suite)
--#     DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_   (the original suite)
--#
--# The readout below is not decoration. It is the tooth: if the property is
--# ever 0 when a case runs, this one line differs and the case is red before
--# it has measured anything, instead of quietly measuring the other
--# implementation (disk-natc.md 6 records nine assertions that drifted that
--# way).
--#
--# ASCII only, on purpose: 87 of the ported case bodies are EUC-KR and their
--# bytes must stay untouched, so nothing this port adds may introduce a
--# second encoding into a transcript.
--###########################################################################

$P0> ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$P0> SELECT CAST(VALUE1 AS VARCHAR(10)) DISK_GLOBAL_INDEX_ENABLE
     FROM V$PROPERTY WHERE NAME = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

--##########################################################################
--# BUG-31040
--#     distinct 한 하나의 value 만 필요한 부분에 subquery 가 사용되었을 경우 서버 사망
--##########################################################################

--#####################################
--# PREPARATION
--#####################################

--+SKIP BEGIN; 
$P0> DROP TABLE A;
$P0> DROP TABLE B;
$P0> DROP TABLE C;
--+SKIP END; 

$P0> CREATE TABLE A (A1 INTEGER);
Create success.
$P0> CREATE TABLE B (B1 INTEGER);
Create success.
$P0> CREATE TABLE C (C1 INTEGER)
     partition by hash(c1)
     (
       partition p1,
       partition p2
     )
     tablespace sys_tbs_disk_data;
Create success.

$P0> INSERT INTO A VALUES (1);
1 row inserted.
$P0> INSERT INTO B VALUES (1);
1 row inserted.
$P0> INSERT INTO C VALUES (1);
1 row inserted.

$P0> CREATE INDEX ADX ON A ( A1 );
Create success.

$P0> alter session set explain plan = on;
Alter success.
$P0> alter system set trclog_detail_predicate = 1;
Alter success.

--#####################################
--+SECTOR 1; TEST
--#####################################

$P0> SELECT
         (SELECT A1 FROM A
          WHERE B.B1=A1 AND A1 IN (SELECT B1 FROM B)
          LIMIT 1 )
     FROM B;
(SELECT A1 FROM A
          WHERE B.B1=A1  
---------------------------------------------
1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 4, COST: BLOCKED )
 ::SUB-QUERY BEGIN
 PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 4, COST: BLOCKED )
  SEMI-JOIN ( METHOD: HASH, COST: BLOCKED )
   SCAN ( TABLE: SYS.A, INDEX: SYS.ADX, RANGE SCAN, ACCESS: 1, COST: BLOCKED )
   HASH ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 1, BUCKET_COUNT: 1024, ACCESS: 1, COST: BLOCKED )
    SCAN ( TABLE: SYS.B $$1_$$VIEW1_$B, FULL SCAN, ACCESS: 1, COST: BLOCKED )
 ::SUB-QUERY END
 SCAN ( TABLE: SYS.B, FULL SCAN, ACCESS: 1, COST: BLOCKED )
------------------------------------------------------------

$P0> SELECT B1 FROM B ORDER BY
         (SELECT A1 FROM A WHERE B.B1 = A1 
          AND A1 IN (SELECT A1 FROM A)
          LIMIT 1);
B1          
--------------
1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 4, COST: BLOCKED )
 SORT ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  SCAN ( TABLE: SYS.B, FULL SCAN, ACCESS: 1, COST: BLOCKED )
------------------------------------------------------------

$P0> SELECT B1 FROM B GROUP BY B1 HAVING
         B1 = (SELECT A1 FROM A WHERE B.B1 = A1 
               AND A1 IN (SELECT C1 FROM C)
               LIMIT 1);
B1          
--------------
1           
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 4, COST: BLOCKED )
 FILTER
  ::SUB-QUERY BEGIN
  PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 4, COST: BLOCKED )
   SEMI-JOIN ( METHOD: HASH, COST: BLOCKED )
    SCAN ( TABLE: SYS.A, INDEX: SYS.ADX, RANGE SCAN, ACCESS: 1, COST: BLOCKED )
    HASH ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 1, DISK_PAGE_COUNT: BLOCKED, ACCESS: 1, COST: BLOCKED )
     PARTITION-COORDINATOR ( TABLE: SYS.C $$1_$$VIEW1_$C, PARTITION: 2/2, FULL SCAN, ACCESS: 1, COST: BLOCKED )
      SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
      SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 0, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  ::SUB-QUERY END
  GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1024, ACCESS: 1, COST: BLOCKED )
   SCAN ( TABLE: SYS.B, FULL SCAN, ACCESS: 1, COST: BLOCKED )
------------------------------------------------------------

