$P0> DROP TABLE A;
Drop success.
$P0> DROP TABLE B;
Drop success.
$P0> DROP TABLE C;
Drop success.

$P0> alter session set explain plan = off;
Alter success.
$P0> alter system set trclog_detail_predicate = 0;
Alter success.

