###########################################################################
# NativeGlobalIndexPort1624 - 전제와 판별자
#
# 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
# 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
# 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
#
#   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
#   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
#
# ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
#   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
#   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
#   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
#   어긋났었다(disk-natc.md 6).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
#   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
#   복원이 유일한 방벽이다.
###########################################################################

#
# 전제를 세우고, 세운 값을 전사에 남긴다.
# 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
#
DEF PIN_DISK_NATIVE()
{
  set linesize 200;
  alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
  select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
}
###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/PROJ-1624-QC/PDT/Design/SELECT/date_hash.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################

########################################################
## SELECT HASH PARTITIOIN ( PK:INTEGER, INDEX:PREFIXED )
########################################################

#####################################
##SECTOR; INTIALIZE
#####################################

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

SKIP BEGIN;
DROP TABLE PDT_HASH;
SKIP END;

###########################################
##+SECTOR; DO JOB #1 (1. Basic Test)
###########################################

CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

SELECT F1 FROM PDT_HASH PARTITION( P1 );
SELECT F1 FROM PDT_HASH PARTITION( P2 );
SELECT F1 FROM PDT_HASH PARTITION( P3 );
SELECT F1 FROM PDT_HASH PARTITION( P4 );

## should be 4
SELECT COUNT(*) FROM PDT_HASH;

## should be [0, 1, 2, 3]
SELECT F1 FROM PDT_HASH;


###########################################
##+SECTOR; DO JOB #2 (2. Validation Test)
###########################################

DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

## should be fail
SELECT COUNT(*) FROM PDT_HASH PARTITION( P5 );


###########################################
##+SECTOR; DO JOB #3 (3. Execution Test)
###########################################

####################################-
## 3.1 Partition Ordering
####################################-
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

SELECT F1 FROM PDT_HASH PARTITION( P1 );
SELECT F1 FROM PDT_HASH PARTITION( P2 );
SELECT F1 FROM PDT_HASH PARTITION( P3 );
SELECT F1 FROM PDT_HASH PARTITION( P4 );

##########################################
## 3.2 Static Partition Pruning ( System )
##########################################
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
## equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-30', 'YYYY-MM-DD');
ALTER SESSION SET EXPLAIN PLAN = OFF;

##########################################
## 3.3 Static Partition Pruning ( User )
##########################################
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=1;

SELECT COUNT(*) FROM PDT_HASH PARTITION( P2 ) WHERE F1 = 1;
ALTER SESSION SET EXPLAIN PLAN = OFF;

####################################-
## 3.4 Partition filtering
####################################-
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_HASH VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
## less than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < TO_DATE('2007-4-30', 'YYYY-MM-DD');
## equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = TO_DATE('2007-4-30', 'YYYY-MM-DD');
## greater than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > TO_DATE('2007-4-30', 'YYYY-MM-DD');
## less equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= TO_DATE('2007-4-30', 'YYYY-MM-DD');
## greater equal than 
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= TO_DATE('2007-4-30', 'YYYY-MM-DD');
## not equal
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-3-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != TO_DATE('2007-4-30', 'YYYY-MM-DD');

SELECT F1 FROM PDT_HASH;
SELECT COUNT(*) FROM PDT_HASH WHERE F2 = 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = F1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = F2;

ALTER SESSION SET EXPLAIN PLAN = OFF;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=0;

#####################################
##+SECTOR; FINALIZE
#####################################

DROP TABLE PDT_HASH;
}