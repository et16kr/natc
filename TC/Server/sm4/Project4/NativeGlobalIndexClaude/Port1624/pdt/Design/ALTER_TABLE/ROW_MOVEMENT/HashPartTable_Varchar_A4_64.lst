$P0> DROP TABLE TEST;
Drop success.

-- should be fail
$P0> CREATE TABLE TEST( I1 VARCHAR(10), I2 INTEGER )
     PARTITION BY HASH(I1)
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) TABLESPACE PDT_TBS ENABLE ROW MOVEMENT;
[ERR-31001 : SQL syntax error 

line 8: missing or invalid syntax
     ) TABLESPACE PDT_TBS ENABLE ROW MOVEMENT
                          ^    ^

]

-- should be fail
$P0> CREATE TABLE TEST( I1 VARCHAR(10), I2 INTEGER )
     PARTITION BY HASH(I1)
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3 ENABLE ROW MOVEMENT,
         PARTITION P4
     ) TABLESPACE PDT_TBS;
[ERR-31001 : SQL syntax error 

line 6: missing or invalid syntax
         PARTITION P3 ENABLE ROW MOVEMENT,
                      ^    ^

]

-- should be success
$P0> CREATE TABLE TEST( I1 VARCHAR(1000), I2 INTEGER )
     PARTITION BY HASH(I1)
     (
         PARTITION P1,
         PARTITION P2,
         PARTITION P3,
         PARTITION P4
     ) ENABLE ROW MOVEMENT TABLESPACE PDT_TBS;
Create success.


