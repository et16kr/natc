###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/PROJ-1624-QC/PDT/Design/SELECT/integer_hash.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../../../include/globalIndexEnv.i;

########################################################
## SELECT HASH PARTITIOIN ( PK:INTEGER, INDEX:PREFIXED )
########################################################

#####################################
##SECTOR; INTIALIZE
#####################################
DEF MAIN()
{
CALL PIN_DISK_NATIVE();

SKIP BEGIN;
DROP TABLE PDT_HASH;
SKIP END;

###########################################
##SECTOR; DO JOB #1 (1. Basic Test)
###########################################

CREATE TABLE PDT_HASH
(
    F1   INTEGER,
    F2   INTEGER
)
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( 0, 0 );
INSERT INTO PDT_HASH VALUES( 1, 0 );
INSERT INTO PDT_HASH VALUES( 2, 0 );
INSERT INTO PDT_HASH VALUES( 3, 0 );

SELECT F1 FROM PDT_HASH PARTITION( P1 );
SELECT F1 FROM PDT_HASH PARTITION( P2 );
SELECT F1 FROM PDT_HASH PARTITION( P3 );
SELECT F1 FROM PDT_HASH PARTITION( P4 );

## should be 4
SELECT COUNT(*) FROM PDT_HASH;

## should be [0, 1, 2, 3]
SELECT F1 FROM PDT_HASH;


###########################################
##SECTOR; DO JOB #2 (2. Validation Test)
###########################################

DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   INTEGER,
    F2   INTEGER
)
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( 0, 0 );
INSERT INTO PDT_HASH VALUES( 1, 0 );
INSERT INTO PDT_HASH VALUES( 2, 0 );
INSERT INTO PDT_HASH VALUES( 3, 0 );

## should be fail
SELECT COUNT(*) FROM PDT_HASH PARTITION( P5 );


###########################################
##SECTOR; DO JOB #3 (3. Execution Test)
###########################################

####################################-
## 3.1 Partition Ordering
####################################-
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   INTEGER,
    F2   INTEGER
)
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( 0, 0 );
INSERT INTO PDT_HASH VALUES( 1, 0 );
INSERT INTO PDT_HASH VALUES( 2, 0 );
INSERT INTO PDT_HASH VALUES( 3, 0 );

SELECT F1 FROM PDT_HASH PARTITION( P1 );
SELECT F1 FROM PDT_HASH PARTITION( P2 );
SELECT F1 FROM PDT_HASH PARTITION( P3 );
SELECT F1 FROM PDT_HASH PARTITION( P4 );

##########################################
## 3.2 Static Partition Pruning ( System )
##########################################
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   INTEGER,
    F2   INTEGER
)
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( 0, 0 );
INSERT INTO PDT_HASH VALUES( 1, 0 );
INSERT INTO PDT_HASH VALUES( 2, 0 );
INSERT INTO PDT_HASH VALUES( 3, 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
## equal than
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 3;
ALTER SESSION SET EXPLAIN PLAN = OFF;

##########################################
## 3.3 Static Partition Pruning ( User )
##########################################
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   INTEGER,
    F2   INTEGER
)
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( 0, 0 );
INSERT INTO PDT_HASH VALUES( 1, 0 );
INSERT INTO PDT_HASH VALUES( 2, 0 );
INSERT INTO PDT_HASH VALUES( 3, 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=1;

SELECT COUNT(*) FROM PDT_HASH PARTITION( P2 ) WHERE F1 = 1;
ALTER SESSION SET EXPLAIN PLAN = OFF;

####################################-
## 3.4 Partition filtering
####################################-
DROP TABLE PDT_HASH;
CREATE TABLE PDT_HASH
(
    F1   INTEGER,
    F2   INTEGER
)
PARTITION BY HASH( F1 )
(
    PARTITION P1,
    PARTITION P2,
    PARTITION P3,
    PARTITION P4
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_HASH_IDX ON PDT_HASH( F1 );

INSERT INTO PDT_HASH VALUES( 0, 0 );
INSERT INTO PDT_HASH VALUES( 1, 0 );
INSERT INTO PDT_HASH VALUES( 2, 0 );
INSERT INTO PDT_HASH VALUES( 3, 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
## less than
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 < 3;
## equal than
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = 3;
## greater than
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 > 3;
## less equal than
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 <= 3;
## greater equal than
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 >= 3;
## not equal
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != 1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != 2;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 != 3;

SELECT F1 FROM PDT_HASH;
SELECT COUNT(*) FROM PDT_HASH WHERE F2 = 0;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = F1;
SELECT COUNT(*) FROM PDT_HASH WHERE F1 = F2;

ALTER SESSION SET EXPLAIN PLAN = OFF;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=0;

#####################################
##SECTOR; FINALIZE
#####################################

DROP TABLE PDT_HASH;
}