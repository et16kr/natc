--##############################
--+SECTOR 19; Test for Table T1 (no index, single part key)
--##############################
-- should be success
$P0> ALTER TABLE T1 
     SPLIT PARTITION P1 VALUES ('050') INTO
     ( 
         PARTITION P1,
         PARTITION P1_1
     );
Alter success.

-- should be success
$P0> ALTER TABLE T1 
     SPLIT PARTITION P2 VALUES ('150') INTO
     ( 
         PARTITION P2_1,
         PARTITION P2_2
     );
Alter success.

-- should be success
$P0> ALTER TABLE T1 
     SPLIT PARTITION P2_2 VALUES (NULL) INTO
     ( 
         PARTITION P2_2_1,
         PARTITION P2_2_2
     );
Alter success.

-- should be success
$P0> ALTER TABLE T1 
     SPLIT PARTITION P3 VALUES ('250') INTO
     ( 
         PARTITION P3_1,
         PARTITION P3
     );
Alter success.

-- should be fail
$P0> ALTER TABLE T1 
     SPLIT PARTITION P1_1 VALUES ('075', 0) INTO
     ( 
         PARTITION P1_1_1,
         PARTITION P1_1_2
     );
[ERR-3126E : Split condition value does not exist for the partition to be split]

-- should be success
$P0> ALTER TABLE T1 
     SPLIT PARTITION P1_1 VALUES ('075') INTO
     ( 
         PARTITION P1_1_1,
         PARTITION P1_1_2
     );
Alter success.

-- should be fail
$P0> ALTER TABLE T1 
     SPLIT PARTITION P3_1 VALUES ('250') INTO
     ( 
         PARTITION P3_1_1,
         PARTITION P3_1
     );
[ERR-3126B : Too many split condition values]

-- should be success
$P0> ALTER TABLE T1
     SPLIT PARTITION P3 VALUES ('200') INTO
     ( 
         PARTITION P3_2,
         PARTITION P3_3
     );
Alter success.

-- should be success
$P0> ALTER TABLE T1 
     SPLIT PARTITION P4 VALUES ('300', '350') INTO
