$P0> INSERT INTO T1 VALUES ('300', '100', 100);
$P0> INSERT INTO T1 VALUES ('350', '100', 100);
$P0> INSERT INTO T1 VALUES ('375', '100', 100);


$P0> CREATE TABLE T2( I1 VARCHAR(10), I2 VARCHAR(1000), I3 INTEGER )
     PARTITION BY LIST (I1)
     (
         PARTITION P1 VALUES ('000', '050', '075') TABLESPACE PDT_TBS2,
         PARTITION P2 VALUES ('100', '150', '175', NULL) TABLESPACE PDT_TBS3,
         PARTITION P3 VALUES ('200', '250', '275'),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;

$P0> INSERT INTO T2 VALUES (NULL, '100', 100);
$P0> INSERT INTO T2 VALUES ('000', '100', 100);
