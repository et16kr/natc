$P0> DROP TABLE T1;
$P0> DROP TABLE T2;

$P0> CREATE TABLE T1( I1 VARCHAR(1000), I2 VARCHAR(10), I3 INTEGER )
     PARTITION BY LIST (I1)
     (
         PARTITION P1 VALUES ('000', '050', '075'),
         PARTITION P2 VALUES ('100', '150', '175', NULL),
         PARTITION P3 VALUES ('200', '250', '275'),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;

