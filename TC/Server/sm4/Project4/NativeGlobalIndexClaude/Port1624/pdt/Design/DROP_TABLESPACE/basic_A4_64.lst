     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;

$P0> DROP TABLESPACE TBS5
     INCLUDING CONTENTS AND DATAFILES
     CASCADE CONSTRAINTS;
--+SKIP END; 

