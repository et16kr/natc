###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/tool/isql/global_index.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i2, i1);
alter table t1 add constraint t1_uk unique (i3, i2, i1);

create index t1_idx1 on t1(i2);
create index t1_idx2 on t1(i2, i3 desc, i4);
create index t1_idx3 on t1(i3, i2 desc);

create index t1_idx4 on t1(i4 desc, i3) local;
create index t1_idx5 on t1(i4) local;

##################################
# SECTOR; DESC
##################################

desc t1;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
