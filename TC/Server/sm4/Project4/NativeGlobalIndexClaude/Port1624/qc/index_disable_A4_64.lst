 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 전제와 판별자
$T0> #
$T0> # 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
$T0> # 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
$T0> # 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
$T0> #
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
$T0> #
$T0> # ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
$T0> #   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
$T0> #   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
$T0> #   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
$T0> #   어긋났었다(disk-natc.md 6).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
$T0> #   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
$T0> #   복원이 유일한 방벽이다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고, 세운 값을 전사에 남긴다.
$T0> # 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
$T0> #
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - SELECT_META 의 네이티브 재정의 (배치 6·7)
$T0> #
$T0> # 원본 meta/select_meta.i (= PROJ-1624-QC/select_meta.i, 두 파일은 바이트
$T0> # 동일하다) 를 대신한다. 원본이 정의하던 DEF 넷을 **같은 이름, 같은 인자**
$T0> # 로 다시 정의하므로, 이 배치 11 개 케이스의 CALL 자리는 원본과 바이트
$T0> # 동일하게 남는다 -- 배치 4 의 checkFunctionIndex.i, 배치 5 의
$T0> # desc_global_index.i 가 쓴 것과 같은 수법이다.
$T0> #
$T0> # 넷 중 갈아 끼운 것은 SELECT_META() 하나다. CREATE_BACKUP_META() /
$T0> # DROP_BACKUP_META() / COMPARE_META() 는 매체를 묻지 않는다 -- 카탈로그
$T0> # 여섯 장을 통째로 떠서 DDL 앞뒤를 차집합으로 견주는 절이고, 네이티브
$T0> # 에서도 재는 것이 같다(오히려 여기서 더 값지다: 숨김 테이블이 없으므로
$T0> # 잔재가 남으면 그것을 가려 줄 것도 없다). 그래서 원본 그대로 옮겼다.
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 원본 SELECT_META() 는 무엇을 하고 있었나
$T0> # ---------------------------------------------------------------------
$T0> #   질의 1  sys_tables_   where table_name like '$%'   -> 숨김 테이블 목록
$T0> #   질의 2  sys_columns_  같은 테이블의 컬럼           -> $GIT_OID/$GIT_RID
$T0> #   질의 3  sys_indices_  where index_name like '$%'   -> $GIK_ / $GIR_
$T0> #   질의 4  sys_index_columns_ 그 인덱스들의 키 컬럼
$T0> #
$T0> # 즉 "글로벌 인덱스가 카탈로그에 **이렇게 보인다**" 이다. 네이티브에서는
$T0> # 그 넷이 전부 빈 표가 된다 -- 방향이 통째로 뒤집힌다. 빈 표만 적으면
$T0> # 질의가 깨져도 빈 표이므로(원본의 is_global 질의가 실제로 그렇게 죽어
$T0> # 있었다 -- v4-natc-port-4.md 2), 없음은 **값 0** 으로 적고 그 자리에
$T0> # 네이티브가 무엇을 두는지를 같은 수의 질의로 이어 적는다.
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 네 겹 (원본 네 질의와 자리를 맞춘다)
$T0> # ---------------------------------------------------------------------
$T0> #   겹 0  숨김 객체가 없다. $GIT_ 테이블 수와 $ 로 시작하는 테이블 수,
$T0> #         $GIK_/$GIR_ 인덱스 수와 $ 로 시작하는 인덱스 수를 따로 센다.
$T0> #         (원본 질의 1·3 의 자리. 전부 0 이어야 한다.)
$T0> #   겹 1  그 자리에 있는 것 -- 파티션드 테이블 위의 인덱스 전량과 판별자.
$T0> #         원본이 숨김 테이블의 소유자/유형/테이블스페이스를 적던 자리다.
$T0> #
$T0> # ★ 겹 1~3 은 **이 케이스가 만든 T1·T2 로 좁힌다.** 원본의 like '$%' 는
$T0> #   스스로 좁아 있었다(숨김 객체는 케이스가 만든 것뿐이다). 그것을 그대로
$T0> #   "파티션드 테이블 전량" 으로 옮기면 이웃 케이스가 남긴 테이블까지 세게
$T0> #   되고, 그러면 이 케이스의 기대값이 자기가 한 일이 아니라 스위트 순서의
$T0> #   함수가 된다 -- 배치 4 의 BUG-35460 이 실제로 그렇게 되어 있었다
$T0> #   (v4-natc-port-2.md 5.2). T1·T2·T3 은 이 조각을 INCLUDE 하는 11 개
$T0> #   케이스가 쓰는 이름 전부다(배치 6 의 여덟은 T1·T2, 배치 7 의
$T0> #   index.tc 가 T3 을 더한다). 겹 0 의 두 셈만 스위트 전역이며, 그것은
$T0> #   "이 스위트의 어느 케이스도 숨김 객체를 만들지 않는다" 라는 더 센
$T0> #   진술이라 일부러 좁히지 않았다.
$T0> #   겹 2  키 컬럼과 자료형. 원본 질의 2 가 숨김 테이블의 컬럼을 적던 자리
$T0> #         이며, 거기 있던 $GIT_OID/$GIT_RID BIGINT 두 줄이 네이티브에는
$T0> #         없다는 것이 겹 0 의 0 과 짝을 이룬다.
$T0> #   겹 3  SYS_PART_INDICES_ 의 판별자 행과 인덱스 파티션 수. 글로벌이면
$T0> #         파티션 수 0 · 판별자 101, 로컬이면 파티션 수 = 테이블 파티션 수.
$T0> #
$T0> # ★ 인덱스 ID·테이블 ID·OID 는 한 줄도 내지 않는다. 인스턴스가 여태 만든
$T0> #   객체 수의 함수라 실행마다 달라진다(NEEDS_FRESH_INSTANCE). 원본이
$T0> #   order by t.table_id / i.index_id 로 정렬하던 것도 이름 정렬로 바꿨다 --
$T0> #   ID 를 찍지 않으면서 ID 순서에 기대면 그 순서가 전사에만 남는다.
$T0> ###########################################################################

$T0> ###########################################################################
$T0> # TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/PROJ-1624-QC/index_disable.tc
$T0> #
$T0> # Body below is byte-identical to the original. What this port adds is the
$T0> # premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
$T0> # the value into the transcript, so the case states what it measures
$T0> # instead of inheriting it (F07 -- see include/globalIndexEnv.i).
$T0> #
$T0> # Project ID           = Native Global Index (disk) - PROJ-1624 port
$T0> ###########################################################################

$T0> #######################################################################
$T0> # INDEX DDL TEST
$T0> #######################################################################

$T0> #######################################################################
$T0> # SIMPLE INDEX DDL TEST
$T0> #######################################################################

$T0> ###################################
$T0> #SECTOR; PREPARATION
$T0> ###################################

$T0> set linesize 200;
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

$T0> SKIP BEGIN;
$T0> DROP TABLE T1;
$T0> SKIP END;

$T0> CREATE TABLE T1 ( I1 INTEGER, I2 INTEGER, I3 INTEGER )
partition by range(i1)
(
	partition p1 values less than('3'),
	partition p2 values less than('7'),
	partition p3 values default
) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE INDEX IDX1 On T1 (I1);
Create success.

$T0> INSERT INTO T1 VALUES (9,9,9);
1 row inserted.
$T0> INSERT INTO T1 VALUES (2,2,2);
1 row inserted.
$T0> INSERT INTO T1 VALUES (1,1,1);
1 row inserted.
$T0> INSERT INTO T1 VALUES (3,3,3);
1 row inserted.
$T0> INSERT INTO T1 VALUES (1,1,1);
1 row inserted.
$T0> INSERT INTO T1 VALUES (2,2,2);
1 row inserted.
$T0> INSERT INTO T1 VALUES (7,7,7);
1 row inserted.

$T0> ###################################
$T0> #SECTOR; WITHOUT DATA
$T0> ###################################

$T0> alter table t1 all index disable;
Alter success.
$T0> select * from t1 where i1 > 0;
