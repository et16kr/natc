#Full Outer Join
#######################################################################

###################################
#SECTOR; without Join Predicate
###################################

### with Non-Join Predicate_First Indexed Column
SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I1=1 AND J1.I2='AAA' AND J2.I1=1;
SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I1=3333 AND J2.I1>350 
                                   AND J1.I2 IS NULL AND J2.I2>'AAA' ;

