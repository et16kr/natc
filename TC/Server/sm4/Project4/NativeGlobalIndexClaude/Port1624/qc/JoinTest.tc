SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I2='AAA' AND J2.I5=-1;
SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I1!=3000000 AND J2.I1 IN (1,2,3)
                                   AND J1.I2='123' AND J2.I2='123';

