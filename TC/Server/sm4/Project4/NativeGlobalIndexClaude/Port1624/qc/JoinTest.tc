#SECTOR; 1 Join Predicate
###################################

### only Join Predicate_First Indexed Column
SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I1=J2.I1;
SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I1 IN (J2.I1);

