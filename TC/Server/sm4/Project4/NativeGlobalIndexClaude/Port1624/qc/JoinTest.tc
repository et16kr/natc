SELECT * FROM J2 FULL OUTER JOIN J1 ON J1.I2>J2.I2;
SELECT * FROM J2 FULL OUTER JOIN J1 ON J2.I3=J1.I3;

### with Other Predicate(Join Column Predicate_First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J3.I1=9;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J4.I1!=9;

### with Other Predicate(Join Column Predicate_Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I2 AND J3.I2='AAA';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I4=J4.I4 AND J4.I4 LIKE 'A4';

### with Other Predicate(Non-Join Column Predicate_First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I2 AND J4.I1=9;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J3.I4 AND J3.I1=-2;

### with Other Predicate(Non-Join Column Predicate_Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J3.I3 IS NULL;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J4.I4='AAA';

### with Other Predicate(Join Column Predicates on Both Tables_First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 
                                   AND J3.I1>=ALL(1,2) AND J4.I1 BETWEEN 1 AND 2;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1
                                   AND J4.I1 IN (1, 2, 3) AND J3.I1=1;     

### with Other Predicate(Join Column Predicates on Both Tables_Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I4
                                   AND J3.I2='조인' AND J4.I4='A3';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I3 IN ( J4.I3)
                                   AND J3.I3 IS NULL AND J4.I3 IS NOT NULL;

### with Other Predicate(Non-Join Column Predicate on Both Tables_First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2>=ANY(J4.I2) 
                                   AND J3.I1=1 AND J4.I1 > 4;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I4=J4.I4
                                   AND J3.I1 IS NOT NULL AND J4.I1 < 100; 

### with Other Predicate(Non-Join Column Predicate on Both Tables_Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1>=J4.I1 
                                   AND J3.I2='컬럼' AND J4.I4='A3';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I4
                                   AND J3.I3 IS NULL AND J4.I5=1;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I4
                                 WHERE J3.I3 IS NULL AND J4.I5=1;

##################################
#SECTOR; 2 Join Predicate
###################################

### only Join Predicate(First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J3.I1!=J4.I1;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1>J4.I1 OR J3.I1<J4.I1;

### only Join Predicate(Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I2 AND J3.I3!=J4.I3;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2 IN (J4.I4) 
                                   AND J4.I4 NOT IN (J3.I2);

### with Other Predicate(Join Column Predicate_First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J3.I2=J4.I2
                                   AND J3.I1=100 AND J3.I2='AAA';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1!=J4.I1 AND J3.I2 NOT IN(J4.I2)
                                   AND J4.I1=-2 AND J4.I2 IS NULL;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1!=J4.I1 AND J3.I2 NOT IN(J4.I2)
                                   AND J4.I1=-2 AND J4.I2 IS NULL
                                   AND J3.I1=100 AND J3.I2='AAA';

### with Other Predicate(Join Column Predicate_Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2>J4.I2 OR J3.I2=J4.I2
                                   AND J3.I2='T/티' OR J3.I2='LIKE';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I5=J4.I5 AND J3.I4=J4.I4
                                   AND J4.I5=(SELECT I5 FROM J3 WHERE I5=-1)
                                   AND J4.I4='A3';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2=J4.I2 AND J3.I4=J4.I4
                                   AND J3.I2 IS NOT NULL AND J3.I4 LIKE 'A%'
                                   AND J4.I2 NOT LIKE 'B%' AND J4.I4 IS NULL;

### with Other Predicate(Non-Join Column Predicate_First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2 LIKE J4.I2 AND J3.I4 NOT LIKE J4.I4
                                   AND J3.I1 NOT BETWEEN -1 AND -100;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2 LIKE J4.I2 AND J3.I4 NOT LIKE J4.I4
                                   AND J4.I1 NOT BETWEEN -1 AND -100;
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I2 =ALL (J4.I4) AND J3.I4 !=ALL(J4.I2)
                                   AND J3.I1!=-555 AND J4.I1 IS NOT NULL;

### with Other Predicate(Non-Join Column Predicate_Non-First Indexed Column)
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I3=J4.I3 AND J3.I3!=J4.I3
                            AND J3.I4 BETWEEN 'A2' AND 'A4'; 
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I3=J4.I3 AND J3.I3!=J4.I3 
                                   AND J3.I4 IN(J4.I4);     
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I3=J4.I3 AND J3.I3!=J4.I3 
                                   AND J3.I4 >=ALL(J4.I4);  
SELECT * FROM J3 FULL OUTER JOIN J4 ON TRIM(J3.I2)=ANY(J4.I2) 
                                   AND J3.I4=ALL(TRIM(J4.I4))
                                   AND CHR(J4.I5)='1';
SELECT * FROM J3 FULL OUTER JOIN J4 ON J3.I1=J4.I1 AND J3.I4=J4.I2
                                   AND J3.I4='A3'  AND J4.I3 IS NOT NULL
        WHERE J3.I1=100 AND J4.I1 IN (1,2,3) AND J4.I2 >=ALL (1,2,3);


###################################
#SECTOR; FINALIZATION
###################################

DROP TABLE J1;
DROP TABLE J2;
DROP TABLE J3;
DROP TABLE J4;

ALTER SYSTEM SET __DBMS_STAT_METHOD = 0;
}