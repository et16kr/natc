###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/DDL/reserved_name.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; RESERVED INDEX NAME
##################################

create table t1(i1 integer, i2 integer, i3 integer);

create index $git_idx1 on t1(i1);
create index $gik_idx1 on t1(i2);
create index $gir_idx1 on t1(i3);

desc t1;

create table t2(i1 integer, i2 integer, i3 integer);

create index "$GIT_IDX1" on t2(i1);
create index "$GIK_IDX1" on t2(i2);
create index "$GIR_IDX1" on t2(i3);

desc t2;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
