$T0> # SECTOR; COMPOSITE COLUMN
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i3, i4);
Alter success.
$T0> alter table t1 add constraint t1_uk unique (i5, i6);
Alter success.

$T0> # success
$T0> insert into t1 values (1, 1, 1, 1, 1, 1);
1 row inserted.
$T0> # pk error
$T0> insert into t1 values (1, 1, 1, 2, 2, 2);
1 row inserted.
$T0> insert into t1 values (1, 1, 2, null, 3, 3);
[ERR-31074 : Unable to insert (or update) NULL into NOT NULL column. : I4]
$T0> # uk error
$T0> insert into t1 values (1, 1, 2, 2, 1, 1);
[ERR-11058 : The row already exists in a unique index.]

$T0> select * from t1;
