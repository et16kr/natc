$T0> insert into t1 values ( '202', '202', '202' );
1 row inserted.


$T0> alter index idx1 rebuild;
Alter success.
$T0> alter index idx2 rebuild;
Alter success.
$T0> alter index idx3 rebuild;
Alter success.
$T0> alter index idx4 rebuild;
Alter success.
$T0> alter index idx5 rebuild;
Alter success.
$T0> alter index idx6 rebuild;
Alter success.
$T0> alter index idx7 rebuild;
Alter success.
$T0> alter index idx8 rebuild;
Alter success.

$T0> alter session set explain plan = on;
Alter success.

