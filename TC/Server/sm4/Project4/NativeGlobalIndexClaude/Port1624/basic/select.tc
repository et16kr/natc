###########################################################################
# NativeGlobalIndexPort1624 - 전제와 판별자
#
# 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
# 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
# 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
#
#   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
#   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
#
# ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
#   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
#   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
#   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
#   어긋났었다(disk-natc.md 6).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
#   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
#   복원이 유일한 방벽이다.
###########################################################################

#
# 전제를 세우고, 세운 값을 전사에 남긴다.
# 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
#
DEF PIN_DISK_NATIVE()
{
  set linesize 200;
  alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
  select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
}
#
# 파일 기본값(1)으로 되돌린다. 다음 케이스에 0 이 새지 않게 한다.
#
DEF RESTORE_DISK_DEFAULT()
{
  alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
}
#
# 인덱스가 어느 구현인지 카탈로그로 판별해 전사에 남긴다.
#
#   NATIVE GLOBAL : SYS_PART_INDICES_.PARTITION_TYPE = 101, INDEX_TABLE_ID = 0
#   LOCAL         : IS_PARTITIONED = 'T', SYS_INDEX_PARTITIONS_ 에 행
#   $GIT_ GLOBAL  : INDEX_TABLE_ID != 0 (숨김 테이블 OID)
#
# ★ 이 절이 이 스위트의 이빨이다. 프로퍼티가 0 이면 CREATE INDEX 로 만든
#   인덱스가 $GIT_ 로 내려가 KIND 가 통째로 바뀌고, 같은 문장을 재고 있다는
#   착각이 여기서 깨진다.
#
# ★ 원본 fixture 의 T1_PK(i2,i1) / T1_UK(i3,i2,i1) 은 파티션 키 i1 을
#   포함하므로 두 구현 어느 쪽에서도 글로벌이 아니라 LOCAL 이다. 원본
#   check_global_index.i 가 "$GIT_T1_PK" 를 조회한 것은 존재하지 않는
#   테이블을 겨눈 것이었다 -- v3-natc-port.md 3.2.
#
DEF SHOW_INDEX_MEDIA( @aTable )
{
  select cast(i.index_name as varchar(20)) index_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         i.index_table_id,
         cast(i.is_partitioned as varchar(1)) is_part,
         nvl(p.partition_type,-1) part_type
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
       ( select index_id, max(partition_type) partition_type
         from system_.sys_part_indices_ group by index_id ) p
  where i.table_id = t.table_id
    and t.table_name = upper('@{aTable}')
    and t.user_id = user_id()
    and i.index_id = p.index_id(+)
  order by 1;
}
#
# 숨김 테이블이 하나도 없다는 것을 남긴다.
# 네이티브 경로에서는 $GIT_ 가 만들어지지 않는다.
#
DEF SHOW_NO_HIDDEN_TABLE()
{
  select count(*) git_hidden_table_count
  from system_.sys_tables_
  where table_name like '$GIT!_%' escape '!'
    and user_id = user_id();
}
###########################################################################
# TestCase Description = 디스크 파티션드 테이블의 네이티브 글로벌 인덱스 SELECT / 호스트 변수 / FOR UPDATE
#
#   원본: qp4/Project3/PROJ-1624-GlobalIndex/basic/select.tc
#   원본은 같은 문장을 $GIT_ 숨김 테이블 구현으로 잰다. 이 파일은
#   같은 문장을 **네이티브 글로벌 인덱스**로 잰다.
#
#   ★ 전제: DISK_GLOBAL_INDEX_ENABLE = 1.
#     PREPARATION 이 못박고 v$property 로 전사에 남긴다. 기본값에 기대지
#     않는다 -- 기본값이 움직이면 잰다고 적어 놓은 것과 실제로 재는 것이
#     갈리기 때문이다(disk-natc.md 6, F07).
#
#   ★ 원본의 결함 하나를 고쳤다. LIST 섹터가
#       create index t3_idx1 on t1(i2, i3);
#     처럼 t3 의 인덱스를 t1 에 만들고 있어, t3 섹터가 인덱스 없는
#     테이블을 재고 있었다(초록이지만 아무것도 시험하지 않는다).
#     여기서는 t3 에 만든다 -- v3-natc-port.md 3.3.
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################


DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t3;

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;
alter system set trclog_explain_graph = 0;

SKIP END;

CALL RESTORE_DISK_DEFAULT();
}

DEF PREPARE()
{
CALL FINALIZE();

CALL PIN_DISK_NATIVE();
}

DEF SELECT( @aTable )
{
alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

##################################
# SECTOR; SELECT
##################################

select * from @{aTable};
select * from @{aTable} order by i2, i3;
select * from @{aTable} order by i2, i3 desc;

select * from @{aTable} where i2 = 10 and i3 = 1 and i4 = 1;
select * from @{aTable} where i2 = 10 and i3 = 1 and i4 = 1 order by i2, i3;
select * from @{aTable} where i2 = 10 and i3 = 1 and i4 = 1 order by i2, i3 desc;

select * from @{aTable} where i2 >= 20 and i3 = 1 and i4 = 1;
select * from @{aTable} where i2 >= 20 and i3 = 1 and i4 = 1 order by i2, i3;
select * from @{aTable} where i2 >= 20 and i3 = 1 and i4 = 1 order by i2, i3 desc;

##################################
# SECTOR; HOST VARIABLE
##################################

var v2 integer;
var v3 integer;
var v4 integer;

exec :v2 := 10;
exec :v3 := 1;
exec :v4 := 1;

prepare select * from @{aTable} where i2 = :v2 and i3 = :v3 and i4 = :v4;
prepare select * from @{aTable} where i2 = :v2 and i3 = :v3 and i4 = :v4 order by i2, i3;
prepare select * from @{aTable} where i2 = :v2 and i3 = :v3 and i4 = :v4 order by i2, i3 desc;

exec :v2 := 20;

prepare select * from @{aTable} where i2 >= :v2 and i3 = :v3 and i4 = :v4;
prepare select * from @{aTable} where i2 >= :v2 and i3 = :v3 and i4 = :v4 order by i2, i3;
prepare select * from @{aTable} where i2 >= :v2 and i3 = :v3 and i4 = :v4 order by i2, i3 desc;

##################################
# SECTOR; SELECT FOR UPDATE
##################################

select * from @{aTable} for update;
select * from @{aTable} order by i2, i3 for update;
select * from @{aTable} order by i2, i3 desc for update;

select * from @{aTable} where i2 = 10 and i3 = 1 and i4 = 1 for update;
select * from @{aTable} where i2 = 10 and i3 = 1 and i4 = 1 order by i2, i3 for update;
select * from @{aTable} where i2 = 10 and i3 = 1 and i4 = 1 order by i2, i3 desc for update;

alter session set explain plan = off;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; RANGE PARTITION
##################################

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t1 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;

create index t1_idx1 on t1(i2, i3);
create index t1_idx2 on t1(i2, i3 desc);

desc t1;

CALL SHOW_INDEX_MEDIA( "t1" );
CALL SHOW_NO_HIDDEN_TABLE();

CALL SELECT( "t1" );

##################################
# SECTOR; HASH PARTITION
##################################

create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3,
  partition p4,
  partition p5
)
tablespace sys_tbs_disk_data;

insert into t2 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;

create index t2_idx1 on t2(i2, i3);
create index t2_idx2 on t2(i2, i3 desc);

desc t2;

CALL SHOW_INDEX_MEDIA( "t2" );
CALL SHOW_NO_HIDDEN_TABLE();

CALL SELECT( "t2" );

##################################
# SECTOR; LIST PARTITION
##################################

create table t3
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by list(i1)
(
  partition p1 values (1,6,11,16,21,26,31,36,41,46,51,56,61,66,71,76,81,86,91,96),
  partition p2 values (2,7,12,17,22,27,32,37,42,47,52,57,62,67,72,77,82,87,92,97),
  partition p3 values (3,8,13,18,23,28,33,38,43,48,53,58,63,68,73,78,83,88,93,98),
  partition p4 values (4,9,14,19,24,29,34,39,44,49,54,59,64,69,74,79,84,89,94,99),
  partition pd values default
)
tablespace sys_tbs_disk_data;

insert into t3 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;

create index t3_idx1 on t3(i2, i3);
create index t3_idx2 on t3(i2, i3 desc);

desc t3;

CALL SHOW_INDEX_MEDIA( "t3" );
CALL SHOW_NO_HIDDEN_TABLE();

CALL SELECT( "t3" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
