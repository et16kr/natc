T2 has no index
T2 has no primary key

$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; CONSTANT FILTER
$T0> ##################################

$T0> select * from t1, t2 where t1.i2=t2.i2 and 1=1;
