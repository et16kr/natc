PROJECT ( COLUMN_COUNT: 6, TUPLE_SIZE: 24, COST: BLOCKED )
 JOIN ( METHOD: HASH, COST: BLOCKED )
  PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, FULL SCAN, ACCESS: 10, COST: BLOCKED )
   SCAN ( PARTITION: PD, FULL SCAN, ACCESS: 6, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  HASH ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 10, DISK_PAGE_COUNT: BLOCKED, ACCESS: 10, COST: BLOCKED )
   [ FILTER ]
   T1.I2 = T2.I2
   PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 2/2, FULL SCAN, ACCESS: 10, COST: BLOCKED )
    SCAN ( PARTITION: PD, FULL SCAN, ACCESS: 6, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
    SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
