###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/design/subq_key_range.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t3;

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;
alter system set trclog_explain_graph = 0;

SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

set linesize 200;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1(i1 integer, i2 integer, i3 integer)
partition by range(i3)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;

insert into t1 values (1, 1, 1);
insert into t1 values (2, 2, 1);
insert into t1 values (3, 3, 3);
insert into t1 values (4, 4, 3);

create index t1_idx1 on t1(i1);

create table t2(i1 integer, i2 integer, i3 integer, i4 integer)
partition by range(i4)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;

insert into t2 values (1, 1, 1, 1);
insert into t2 values (2, 2, 2, 2);
insert into t2 values (3, 3, 3, 3);
insert into t2 values (4, 4, 4, 4);

create index t2_idx1 on t2(i3,i1,i2);

create table t3(i1 integer, i2 integer, i3 integer);

insert into t3 values (1, 1, 1);
insert into t3 values (2, 2, 2);
insert into t3 values (3, 3, 3);

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

##################################
# SECTOR; SUBQUERY KEY RANGE
##################################

select * from t1 where i1 in (select i1 from t3);

select * from t2 where (i1, i2, i3) in (select i1, i2, i3 from t3);

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
