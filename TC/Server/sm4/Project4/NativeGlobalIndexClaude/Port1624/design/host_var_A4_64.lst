PROJECT ( COLUMN_COUNT: 5, TUPLE_SIZE: 20, COST: BLOCKED )
 SCAN ( TABLE: SYS.T1, INDEX: SYS.T1_IDX4, GLOBAL-INDEX, RANGE SCAN, ACCESS: 1, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
