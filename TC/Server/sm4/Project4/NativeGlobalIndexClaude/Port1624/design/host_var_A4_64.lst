 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 전제와 판별자
$T0> #
$T0> # 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
$T0> # 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
$T0> # 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
$T0> #
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
$T0> #
$T0> # ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
$T0> #   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
$T0> #   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
$T0> #   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
$T0> #   어긋났었다(disk-natc.md 6).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
$T0> #   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
$T0> #   복원이 유일한 방벽이다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고, 세운 값을 전사에 남긴다.
$T0> # 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/design/host_var.tc
$T0> #
$T0> # Body below is byte-identical to the original. What this port adds is the
$T0> # premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
$T0> # the value into the transcript, so the case states what it measures
$T0> # instead of inheriting it (F07 -- see include/globalIndexEnv.i).
$T0> #
$T0> # Project ID           = Native Global Index (disk) - PROJ-1624 port
$T0> ###########################################################################

$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> set linesize 200;
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

$T0> var v2 integer;
$T0> var v3 integer;
$T0> var v4 integer;
$T0> var v5 integer;

$T0> exec :v2 := 1;
Execute success.
$T0> exec :v3 := 1;
Execute success.
$T0> exec :v4 := 1;
Execute success.
$T0> exec :v5 := 1;
Execute success.

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer,
  i5 integer
)
partition by range(i1)
(
  partition p1 values less than (50),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index t1_idx2 on t1(i2) local;
Create success.
$T0> create index t1_idx3 on t1(i3) local;
Create success.
$T0> create index t1_idx4 on t1(i4);
Create success.
$T0> create index t1_idx5 on t1(i5);
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     
I4                                       INTEGER                     
I5                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_IDX2                                  BTREE                  I2 ASC
T1_IDX3                                  BTREE                  I3 ASC
T1_IDX4                                  BTREE                  I4 ASC
T1_IDX5                                  BTREE                  I5 ASC
T1 has no primary key

$T0> ##################################
$T0> # SECTOR; SCAN DECISION FACTOR
$T0> ##################################


$T0> EXEC GATHER_TABLE_STATS('SYS','T1');
Execute success.

$T0> alter session set explain plan = off;
Alter success.
$T0> alter session set trclog_detail_predicate = 0;
Alter success.

$T0> select count(distinct i1) from T1
union all
select count(distinct i2) from T1
union all
select count(distinct i3) from T1
union all
select count(distinct i4) from T1
union all
select count(distinct i5) from T1;
COUNT(distinct I1)   
-----------------------
100                  
30                   
20                   
20                   
20                   
5 rows selected.


$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> prepare select /*+keep_plan*/ * from t1 where i2 = :v2 and i3 = :v3 and i4 = :v4 and i5 = :v5;
T1.I1       T1.I2       T1.I3       T1.I4       T1.I5       
------------------------------------------------------------------
1           1           1           1           1           
1 row selected.
