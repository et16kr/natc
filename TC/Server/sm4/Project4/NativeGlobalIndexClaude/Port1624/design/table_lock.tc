###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/design/table_lock.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop view v1;
drop view v2;

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;
alter system set trclog_explain_graph = 0;

SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

set linesize 200;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer
)
partition by range(i1)
(
  partition t1_p1 values less than (6),
  partition t1_pd values default
)
enable row movement
tablespace sys_tbs_disk_data;

insert into t1 values ( 1, 1, 1 );
insert into t1 values ( 2, 2, 2 );
insert into t1 values ( 3, 3, 3 );
insert into t1 values ( 4, 4, 4 );
insert into t1 values ( 5, 5, 5 );
insert into t1 values ( 6, 6, 6 );
insert into t1 values ( 7, 7, 7 );
insert into t1 values ( 8, 8, 8 );

create index t1_idx2 on t1(i2);
create index t1_idx3 on t1(i3);

create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer
)
partition by range(i1)
(
  partition t2_p1 values less than (6),
  partition t2_pd values default
)
enable row movement
tablespace sys_tbs_disk_data;

insert into t2 values ( 3, 3, 3 );
insert into t2 values ( 4, 4, 4 );
insert into t2 values ( 5, 5, 5 );
insert into t2 values ( 6, 6, 6 );
insert into t2 values ( 7, 7, 7 );
insert into t2 values ( 8, 8, 8 );
insert into t2 values ( 9, 9, 9 );
insert into t2 values ( 10, 10, 10 );

create index t2_idx2 on t2(i2);
create index t2_idx3 on t2(i3);

desc t1;
desc t2;

##################################
# SECTOR; SELECT
##################################

create view v1 as
  select cast(t.table_name || ',' || v.lock_desc || ',' || v.lock_cnt as varchar(50)) as lock_info
  from system_.sys_tables_ t, v$lock v
  where t.user_id = user_id() and t.table_oid = v.table_oid
  order by t.table_name;

create view v2 as
  select cast(p.partition_name || ',' || v.lock_desc || ',' || v.lock_cnt as varchar(50)) as lock_info
  from system_.sys_tables_ t, system_.sys_table_partitions_ p, v$lock v
  where t.user_id = user_id() and t.table_id = p.table_id and p.partition_oid = v.table_oid
  order by p.partition_name;

select to_char(i1) i1 from t1
union all 
select * from v1
union all
select * from v2;

select to_char(i1) i1 from t1 where i2=1
union all 
select * from v1
union all
select * from v2;

select to_char(i1) i1 from t1 where i3=1
union all 
select * from v1
union all
select * from v2;

select to_char(i1) i1 from t1 where i2=1 and i3=1
union all 
select * from v1
union all
select * from v2;

select to_char(t1.i1) i1 from t1, t2 where t1.i2=t2.i2
union all 
select * from v1
union all
select * from v2;

select to_char(t1.i1) i1 from t1, t2 where t1.i3=t2.i3
union all 
select * from v1
union all
select * from v2;

select to_char(t1.i1) i1 from t1, t2 where t1.i2=t2.i2 and t1.i3=t2.i3
union all 
select * from v1
union all
select * from v2;

##################################
# SECTOR; INSERT
##################################

alter session set autocommit = false;

insert into t1 values ( 10, 10, 10 );

select * from v1
union all
select * from v2;

commit;
alter session set autocommit = true;

##################################
# SECTOR; UPDATE
##################################

alter session set autocommit = false;

update t1 set i1=11, i2=11, i3=11 where i1=10;

select * from v1
union all
select * from v2;

commit;
alter session set autocommit = true;

##################################
# SECTOR; UPDATE ROW MOVEMENT
##################################

alter session set autocommit = false;

update t1 set i1=0, i2=0, i3=0 where i1=11;

select * from v1
union all
select * from v2;

commit;
alter session set autocommit = true;

##################################
# SECTOR; DELETE
##################################

alter session set autocommit = false;

delete from t1 where i1=0;

select * from v1
union all
select * from v2;

commit;
alter session set autocommit = true;

##########################################################################
# PORT EDIT: what replaces the $GIT_ rows this case used to see in v$lock
#
# v1/v2 above join system_.sys_tables_ (and sys_table_partitions_) against
# v$lock, so on the $GIT_ implementation every sector of this case also
# printed rows named $GIT_T1_IDX2 / $GIT_T1_IDX3 -- the hidden tables the
# global indexes were made of, each carrying its own IS/IX lock. On the
# native path those tables do not exist and those rows are simply gone.
#
# Re-recording the transcript would freeze that as an absence, and an
# absence is the weakest expectation there is: it holds just as well when
# the view is broken, when the index was never created, or when the case
# is looking at the wrong table. So the port states it as a count, next to
# the counts that must stay non-zero -- v3-natc-port.md 6.1 (assert "none"
# with SHOW_NO_HIDDEN_TABLE / SHOW_INDEX_MEDIA, never with "an error").
#
# TEETH: with DISK_GLOBAL_INDEX_ENABLE = 0 the same INSERT locks the two
# hidden tables and GIT_LOCK_ROWS reads 2, not 0, while T1_LOCK_ROWS and
# T1_PART_LOCK_ROWS are unchanged. That is the whole difference this case
# exists to show, stated as a value instead of as a missing line.
##########################################################################

CALL SHOW_INDEX_MEDIA( "t1" );
CALL SHOW_INDEX_MEDIA( "t2" );
CALL SHOW_NO_HIDDEN_TABLE();

alter session set autocommit = false;

insert into t1 values ( 12, 12, 12 );

select count(*) git_lock_rows
from system_.sys_tables_ t, v$lock v
where t.user_id = user_id() and t.table_oid = v.table_oid
  and t.table_name like '$GIT!_%' escape '!';

select count(*) t1_lock_rows
from system_.sys_tables_ t, v$lock v
where t.user_id = user_id() and t.table_oid = v.table_oid
  and t.table_name = 'T1';

select count(*) t1_part_lock_rows
from system_.sys_tables_ t, system_.sys_table_partitions_ p, v$lock v
where t.user_id = user_id() and t.table_id = p.table_id
  and p.partition_oid = v.table_oid and t.table_name = 'T1';

rollback;

alter session set autocommit = true;

##########################################################################
# PORT EDIT END
##########################################################################
##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
