1 row selected.
$T0> # 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
$T0> select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
No rows selected.

$T0> # 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
$T0> select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t2, lidx1) */ i1, i2 from t2 where i2 is not null
    minus
    select /*+ FULL SCAN(t2) */ i1, i2 from t2 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t2) */ i1, i2 from t2 where i2 is not null
    minus
    select /*+ index(t2, lidx1) */ i1, i2 from t2 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.


$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop tablespace mem1 including contents and datafiles;
$T0> drop tablespace mem2 including contents and datafiles;
$T0> drop tablespace mem3 including contents and datafiles;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

