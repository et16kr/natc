$T0> # 껐다 켜는 동안의 DML 이 전부 반영됐는지 한 번에 확인한다.
$T0> # 껐을 때 넣은 행이 인덱스에 없으면 여기서 차집합이 어긋난다.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

$T0> insert into t1 select level + 300, level + 300, level + 300, level + 300
  from dual connect by level <= 20;
20 rows inserted.
$T0> commit;
Commit success.

$T0> delete from t1 where i1 between 1 and 10;
10 rows deleted.
$T0> commit;
Commit success.

$T0> update t1 set i2 = i2 + 1 where i1 between 100 and 110;
No rows updated.
$T0> commit;
Commit success.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> alter session set explain plan = on;
Alter success.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;
COUNT                
-----------------------
40                   
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 8, COST: BLOCKED )
 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  SCAN ( TABLE: SYS.T1, INDEX: SYS.GIDX1, GLOBAL-INDEX, RANGE SCAN, ACCESS: 40, COST: BLOCKED )
------------------------------------------------------------

$T0> alter session set explain plan = off;
Alter success.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) full_cnt,
         count(i2) full_key_cnt,
         nvl(sum(i2), -1) full_sum,
         nvl(min(i2), -1) full_min,
         nvl(max(i2), -1) full_max
  from t1;
FULL_CNT             FULL_KEY_CNT         FULL_SUM             FULL_MIN    
--------------------------------------------------------------------------------
FULL_MAX    
--------------
40                   40                   6620                 11          
320         
1 row selected.

$T0> select /*+ index(t1, gidx1) */ count(i2) idx_key_cnt,
         nvl(sum(i2), -1) idx_sum,
         nvl(min(i2), -1) idx_min,
         nvl(max(i2), -1) idx_max
  from t1
  where i2 is not null;
IDX_KEY_CNT          IDX_SUM              IDX_MIN     IDX_MAX     
-----------------------------------------------------------------------
40                   6620                 11          320         
1 row selected.
$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
40                   
1 row selected.

$T0> select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
  union all
  select 'P2', count(*) from t1 partition (p2)
  union all
  select 'P3', count(*) from t1 partition (p3)
  order by 1;
PART_NAME  PART_CNT             
-----------------------------------
P1  20                   
P2  0                    
P3  20                   
3 rows selected.

$T0> ##################################
$T0> # SECTOR; OFF DOES NOT AFFECT DDL ON OTHER TABLES
$T0> ##################################
$T0> # 껐을 때 로컬 인덱스 경로가 종전 그대로인지.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.


$T0> create table t2( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index lidx1 on t2(i2) local;
Create success.

$T0> insert into t2 select level, level from dual connect by level <= 50;
50 rows inserted.
$T0> commit;
Commit success.

$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t2')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
IS_UNIQUE  IS_PARTITIONED  INDEX_TABLE_ID_KIND  
----------------------------------------------------
LIDX1                                                                                                                             
F  T  ZERO     
1 row selected.
$T0> select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t2')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PARTITION_TYPE 
-----------------
LIDX1                                                                                                                             
0           
1 row selected.
$T0> select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t2')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PART_INDEX_CNT       
-----------------------
LIDX1                                                                                                                             
