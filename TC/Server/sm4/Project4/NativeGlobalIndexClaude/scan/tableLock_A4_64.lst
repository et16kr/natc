$T0> ##################################
$T0> # SECTOR; LOCK WAIT OPTION
$T0> ##################################

$T0> lock table t1 in exclusive mode nowait;
Lock success.
$T0> commit;
Commit success.

$T0> lock table t1 in exclusive mode wait 1;
Lock success.
$T0> commit;
Commit success.

$T0> ##################################
$T0> # SECTOR; SELECT DOES NOT BLOCK
$T0> ##################################
$T0> # 일반 조회는 잠금을 거의 잡지 않는다.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;
COUNT                
