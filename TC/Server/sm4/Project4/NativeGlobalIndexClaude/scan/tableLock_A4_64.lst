1 row selected.
$T0> commit;
Commit success.

$T0> lock table t1 in row exclusive mode;
Lock success.
$T0> # V$LOCK 이 들고 있는 것은 TABLE_ID 가 아니라 TABLE_OID 다.
$T0> # (LOCK_ITEM_TYPE, TBS_ID, TABLE_OID, DBF_ID, TRANS_ID, LOCK_DESC,
$T0> #  LOCK_CNT, IS_GRANT)
$T0> select t.table_name, l.lock_desc
  from v$lock l, system_.sys_tables_ t
  where l.table_oid = t.table_oid
    and t.user_id = user_id()
    and t.table_name like 'T1%'
  order by t.table_name, l.lock_desc;
