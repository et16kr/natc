###########################################################################
# TestCase Description = 글로벌 인덱스 스캔의 결과 정합성, 파티션 지정,
#                        정렬 순서, FOR UPDATE 잠금.
#                        글로벌 인덱스는 전 파티션 통합 정렬 순서를 주므로
#                        로컬 인덱스로는 불가능했던 ORDER BY 제거가 가능하다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/checkGlobalIndex.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL SHOW_PLAN_OFF();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index lidx1 on t1(i3) local;

CALL FILL_RANGE_DATA();

##################################
# SECTOR; RANGE PREDICATE
##################################
# 파티션 키와 무관한 술어. 프루닝이 불가능하므로 글로벌 인덱스가
# 유리한 전형적인 경우다.

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 15 and 25 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 > 220 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 < 5 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 <= 3 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 >= 228 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 in (5, 105, 205) order by i1, i2;
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 != 5;

##################################
# SECTOR; RESULT MATCHES FULL SCAN
##################################
# 같은 술어를 풀스캔으로 실행한 결과와 비교한다.

for $sPred in "i2 = 15" "i2 between 15 and 25" "i2 > 220" "i2 < 5"
{
  CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", $sPred );
}

##################################
# SECTOR; PARTITION SELECTION
##################################
# 파티션을 지정하면 그 파티션의 로우만 나와야 한다.
# 글로벌 인덱스는 전 파티션을 커버하므로, 미선택 파티션의 로우가
# 결과에 새어 나오지 않는지가 핵심이다.

select count(*) from t1 partition (p1);
select count(*) from t1 partition (p2);
select count(*) from t1 partition (p3);

select /*+ index(t1, gidx1) */ i1, i2 from t1 partition (p1) where i2 is not null order by i1;
select /*+ index(t1, gidx1) */ min(i1), max(i1) from t1 partition (p2);
select /*+ index(t1, gidx1) */ min(i1), max(i1) from t1 partition (p3);

# 지정한 파티션에 없는 값을 찾으면 결과가 없어야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 partition (p1) where i2 = 205;
select /*+ index(t1, gidx1) */ count(*) from t1 partition (p3) where i2 = 5;

##################################
# SECTOR; PARTITION PRUNING BY KEY
##################################
# 파티션 키 술어로 프루닝이 되는 경우. 이때는 로컬 인덱스가 유리하므로
# 옵티마이저 선택이 달라질 수 있다.

CALL SHOW_PLAN_ON();

select i1, i2 from t1 where i1 = 15 order by i1;
select i1, i2 from t1 where i1 < 50 order by i1;
select i1, i2 from t1 where i2 = 15 order by i1;
select i1, i2 from t1 where i1 < 50 and i2 = 15 order by i1;

CALL SHOW_PLAN_OFF();

##################################
# SECTOR; ORDER BY
##################################
# 글로벌 인덱스는 전 파티션 통합 정렬 순서를 제공한다.
# 로컬 인덱스는 파티션별로만 정렬되므로 이 최적화가 불가능하다.

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2;
select /*+ index(t1, gidx1) */ i2 from t1 where i2 > 100 order by i2;
select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2 desc;

CALL SHOW_PLAN_OFF();

# 정렬 결과 자체의 정확성
select /*+ index(t1, gidx1) */ i2 from t1 where i2 between 98 and 105 order by i2;

##################################
# SECTOR; MIN MAX
##################################

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ min(i2) from t1;
select /*+ index(t1, gidx1) */ max(i2) from t1;

CALL SHOW_PLAN_OFF();

select min(i2), max(i2) from t1;

##################################
# SECTOR; SELECT FOR UPDATE
##################################
# 글로벌 인덱스로 읽은 로우에 잠금을 건다. 잠금은 소유 파티션에서
# 걸려야 한다.

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15 for update;
commit;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 100 and 110 order by i1 for update;
commit;

# 전 파티션에 걸친 잠금
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 in (5, 105, 205) order by i1 for update;
commit;

##################################
# SECTOR; UPDATE THROUGH GLOBAL INDEX
##################################
# 글로벌 인덱스로 찾은 로우를 갱신/삭제한다. 변경은 소유 파티션
# 커서에서 일어나야 한다.

update t1 set i4 = i4 + 1 where i2 = 15;
commit;
select i1, i2, i4 from t1 where i2 = 15 order by i1;

update t1 set i4 = i4 + 1 where i2 in (5, 105, 205);
commit;
select i1, i2, i4 from t1 where i2 in (5, 105, 205) order by i1;

delete from t1 where i2 = 15;
commit;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; SCAN WITH CONCURRENT SNAPSHOT
##################################
# 커밋되지 않은 변경은 다른 문장에서 보이면 안 된다(자기 트랜잭션은 보임).

insert into t1 values (50, 50000, 1, 1);

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 50000;

rollback;

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 50000;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
