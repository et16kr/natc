###########################################################################
# TestCase Description = 호스트 변수와 prepare/execute.
#                        bind 값에 따라 접근할 파티션 집합이 달라지므로,
#                        한 번 만든 플랜을 값만 바꿔 재실행할 때 결과가
#                        정확해야 한다. 구버전 design/host_var.tc 에 해당한다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/checkGlobalIndex.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL SHOW_PLAN_OFF();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index gidx2 on t1(i3, i4);
create index lidx1 on t1(i4) local;

CALL FILL_RANGE_DATA();

# 호스트 변수는 쓰기 전에 선언해야 한다. 선언 없이 exec 하면
# ERR-91007(host variable was not defined) 이고, 뒤따르는 select 는
# ERR-31248(mismatched bind column count) 로 이어진다.
# 구버전 design/host_var.tc 가 같은 형태다.
var v1 integer;
var v2 integer;

##################################
# SECTOR; BIND ON GLOBAL INDEX KEY
##################################
# 파티션 키와 무관한 컬럼에 bind. 프루닝이 불가능하므로 전 파티션을
# 봐야 한다.
#
# 호스트 변수를 쓰는 문장은 prepare 로 내야 한다. 평범한 select 로 내면
# 바인드가 붙지 않아 ERR-31248(mismatched bind column count) 이다.

exec :v1 := 5;
prepare select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 105;
prepare select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 205;
prepare select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 99999;
prepare select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = :v1 order by i1;

##################################
# SECTOR; PREPARE AND REEXECUTE
##################################
# 값만 바꿔 같은 문장을 여러 번 실행한다. 각 실행이 서로 다른 파티션의
# 로우를 반환해야 한다.
#
# isql 에서 prepare 는 준비만 하는 것이 아니라 그 자리에서 실행하고 결과를
# 낸다. 별도의 execute 문은 없다(구버전 design/host_var.tc 와 같은 형태).
# 그래서 "값 설정 -> prepare" 를 반복한다. keep_plan 힌트가 플랜 재사용을
# 맡는다.

exec :v1 := 5;
prepare select /*+keep_plan*/ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 105;
prepare select /*+keep_plan*/ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 205;
prepare select /*+keep_plan*/ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 1;
prepare select /*+keep_plan*/ i1, i2 from t1 where i2 = :v1 order by i1;

exec :v1 := 230;
prepare select /*+keep_plan*/ i1, i2 from t1 where i2 = :v1 order by i1;

##################################
# SECTOR; BIND ON PARTITION KEY
##################################
# 파티션 키에 bind. 값에 따라 접근 파티션이 달라진다.
# 플랜을 재사용해도 파티션 선택이 값마다 다시 계산되어야 한다.

exec :v1 := 5;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 = :v1 order by i1;

exec :v1 := 105;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 = :v1 order by i1;

exec :v1 := 205;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 = :v1 order by i1;

##################################
# SECTOR; BIND ON BOTH
##################################

exec :v1 := 100;
exec :v2 := 5;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 < :v1 and i2 = :v2 order by i1;

exec :v1 := 300;
exec :v2 := 5;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 < :v1 and i2 = :v2 order by i1;

exec :v1 := 300;
exec :v2 := 205;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 < :v1 and i2 = :v2 order by i1;

exec :v1 := 100;
exec :v2 := 205;
prepare select /*+keep_plan*/ i1, i2 from t1 where i1 < :v1 and i2 = :v2 order by i1;

##################################
# SECTOR; BIND RANGE
##################################

exec :v1 := 1;
exec :v2 := 10;
prepare select /*+keep_plan*/ count(*) from t1 where i2 between :v1 and :v2;

exec :v1 := 100;
exec :v2 := 110;
prepare select /*+keep_plan*/ count(*) from t1 where i2 between :v1 and :v2;

exec :v1 := 1;
exec :v2 := 300;
prepare select /*+keep_plan*/ count(*) from t1 where i2 between :v1 and :v2;

exec :v1 := 500;
exec :v2 := 600;
prepare select /*+keep_plan*/ count(*) from t1 where i2 between :v1 and :v2;

##################################
# SECTOR; BIND WITH PARTITION SPECIFIED
##################################
# 파티션을 지정하면 bind 값이 다른 파티션을 가리켜도 결과가 없어야 한다.

exec :v1 := 5;
prepare select /*+keep_plan*/ i1, i2 from t1 partition (p1) where i2 = :v1 order by i1;

exec :v1 := 105;
prepare select /*+keep_plan*/ i1, i2 from t1 partition (p1) where i2 = :v1 order by i1;

exec :v1 := 205;
prepare select /*+keep_plan*/ i1, i2 from t1 partition (p1) where i2 = :v1 order by i1;

##################################
# SECTOR; BIND IN DML
##################################

exec :v1 := 5;
prepare update t1 set i4 = i4 + 1 where i2 = :v1;
commit;

exec :v1 := 105;
prepare update t1 set i4 = i4 + 1 where i2 = :v1;
commit;

exec :v1 := 205;
prepare update t1 set i4 = i4 + 1 where i2 = :v1;
commit;

select i1, i2, i4 from t1 where i2 in (5, 105, 205) order by i1;
CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

exec :v1 := 5;
prepare delete from t1 where i2 = :v1;
commit;

select count(*) from t1 where i2 = 5;
CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; BIND WITH NULL
##################################

insert into t1 values (50, null, 1, 1);
commit;

exec :v1 := 1;
prepare select /*+keep_plan*/ count(*) from t1 where i2 = :v1;

# NULL 과의 = 비교는 결과가 없다
select count(*) from t1 where i2 is null;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
