$T0> ##################################
$T0> # SECTOR; PK ENFORCEMENT ACROSS PARTITIONS
$T0> ##################################
$T0> # 이 섹터가 이 케이스의 핵심이다.
$T0> # PK 값이 같은 두 행을 서로 다른 파티션으로 보내면 두 번째가 실패해야
$T0> # 한다. 인덱스가 어느 파티션의 키를 빠뜨리고 있으면 이 삽입이
$T0> # 성공해 버리므로, 유니크 제약 자체가 살아 있는 정합성 검사기다.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> commit;
Commit success.

$T0> # p1 에 이미 1000 이 있다. p2 로 가는 같은 PK 값 -> 실패해야 한다
$T0> insert into t1 values (150, 1000, 2, 2);
[ERR-11058 : The row already exists in a unique index.]

$T0> # p3 로 가는 같은 PK 값 -> 실패해야 한다
$T0> insert into t1 values (250, 1000, 3, 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 다른 값은 성공해야 한다
$T0> insert into t1 values (150, 2000, 2, 2);
1 row inserted.
$T0> insert into t1 values (250, 3000, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1, i2;
I1          I2          
---------------------------
10          1000        
150         2000        
250         3000        
3 rows selected.

$T0> ##################################
$T0> # SECTOR; PK VIOLATION BY UPDATE
$T0> ##################################
$T0> # UPDATE 로 다른 파티션의 기존 PK 값과 충돌시킨다.

$T0> update t1 set i2 = 1000 where i1 = 150;
[ERR-11058 : The row already exists in a unique index.]

$T0> # 충돌하지 않는 값으로는 성공해야 한다
$T0> update t1 set i2 = 2500 where i1 = 150;
1 row updated.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1, i2;
I1          I2          
---------------------------
10          1000        
150         2500        
250         3000        
3 rows selected.

$T0> ##################################
$T0> # SECTOR; PK VIOLATION BY ROW MOVEMENT
$T0> ##################################
$T0> # 파티션 키를 바꿔 로우를 옮기면서 PK 를 충돌시킨다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
enable row movement
tablespace sys_tbs_mem_data;
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i2);
Alter success.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, 2000, 2, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> # i1 만 바꾸면 파티션 이동. PK 는 그대로이므로 성공해야 한다
$T0> update t1 set i1 = 250 where i2 = 2000;
1 row updated.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1, i2;
I1          I2          
---------------------------
10          1000        
250         2000        
2 rows selected.

$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
2                    
1 row selected.

$T0> select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
  union all
  select 'P2', count(*) from t1 partition (p2)
  union all
  select 'P3', count(*) from t1 partition (p3)
  order by 1;
PART_NAME  PART_CNT             
-----------------------------------
P1  1                    
P2  0                    
P3  1                    
3 rows selected.

$T0> # 이동하면서 PK 도 충돌시키면 실패해야 한다
$T0> update t1 set i1 = 50, i2 = 1000 where i2 = 2000;
[ERR-11058 : The row already exists in a unique index.]

$T0> select i1, i2 from t1 order by i1, i2;
I1          I2          
---------------------------
10          1000        
250         2000        
2 rows selected.

$T0> ##################################
$T0> # SECTOR; PK AFTER DELETE AND REINSERT
$T0> ##################################
$T0> # 지운 값은 다시 넣을 수 있어야 한다. ager 가 키를 늦게 지워도
$T0> # 유니크 판정이 잘못되면 안 된다.

$T0> delete from t1 where i2 = 1000;
1 row deleted.
$T0> commit;
Commit success.

$T0> insert into t1 values (250, 1000, 9, 9);
1 row inserted.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1, i2;
I1          I2          
---------------------------
250         1000        
250         2000        
2 rows selected.

$T0> ##################################
$T0> # SECTOR; COMPOSITE PK
$T0> ##################################


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i2, i3);
Alter success.

$T0> insert into t1 values (10, 1, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, 1, 2, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> # (1,1) 중복 -> 실패해야 한다
$T0> insert into t1 values (250, 1, 1, 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> # (1,3) 은 새 값 -> 성공
$T0> insert into t1 values (250, 1, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select i1, i2, i3 from t1 order by i1, i2, i3;
I1          I2          I3          
----------------------------------------
10          1           1           
150         1           2           
250         1           3           
3 rows selected.

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

