###########################################################################
# TestCase Description = 메모리 파티션드 테이블에 파티션 키를 포함하지 않는
#                        PRIMARY KEY 를 만든다. 구버전에서는 서버가 막고
#                        있던 조합이며, 이 프로젝트의 대표 성과다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/checkGlobalIndex.i;
INCLUDE ../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; PK NOT INCLUDING PARTITION KEY
##################################
# 파티션 키는 i1, PK 는 i2. 로컬 인덱스로는 파티션 간 유일성을 보장할 수
# 없으므로 글로벌 인덱스가 필요하다.

for $sPartType in "range" "hash" "list"
{
  CALL CREATE_MEM_PART_TABLE( $sPartType, "integer", "integer" );

  alter table t1 add constraint t1_pk primary key (i2);

  desc t1;
  CALL SELECT_INDEX_META( "t1" );
}

##################################
# SECTOR; PK IN CREATE TABLE
##################################
# 테이블 생성 구문에서 바로 PK 를 준다.
#
# ★ 제약 이름을 반드시 준다. 이름 없이 두면 인덱스 이름이
#   __SYS_IDX_ID_<전역 증가 번호> 로 생성되어 실행할 때마다 달라지고,
#   desc 출력이 비결정적이 되어 .lst 를 만들 수 없다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer constraint t1_pk primary key, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

desc t1;
CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; PK ENFORCEMENT ACROSS PARTITIONS
##################################
# 이 섹터가 이 케이스의 핵심이다.
# PK 값이 같은 두 행을 서로 다른 파티션으로 보내면 두 번째가 실패해야
# 한다. 인덱스가 어느 파티션의 키를 빠뜨리고 있으면 이 삽입이
# 성공해 버리므로, 유니크 제약 자체가 살아 있는 정합성 검사기다.

insert into t1 values (10, 1000, 1, 1);
commit;

# p1 에 이미 1000 이 있다. p2 로 가는 같은 PK 값 -> 실패해야 한다
insert into t1 values (150, 1000, 2, 2);

# p3 로 가는 같은 PK 값 -> 실패해야 한다
insert into t1 values (250, 1000, 3, 3);

# 다른 값은 성공해야 한다
insert into t1 values (150, 2000, 2, 2);
insert into t1 values (250, 3000, 3, 3);
commit;

select i1, i2 from t1 order by i1, i2;

##################################
# SECTOR; PK VIOLATION BY UPDATE
##################################
# UPDATE 로 다른 파티션의 기존 PK 값과 충돌시킨다.

update t1 set i2 = 1000 where i1 = 150;

# 충돌하지 않는 값으로는 성공해야 한다
update t1 set i2 = 2500 where i1 = 150;
commit;

select i1, i2 from t1 order by i1, i2;

##################################
# SECTOR; PK VIOLATION BY ROW MOVEMENT
##################################
# 파티션 키를 바꿔 로우를 옮기면서 PK 를 충돌시킨다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
enable row movement
tablespace sys_tbs_mem_data;

alter table t1 add constraint t1_pk primary key (i2);

insert into t1 values (10, 1000, 1, 1);
insert into t1 values (150, 2000, 2, 2);
commit;

# i1 만 바꾸면 파티션 이동. PK 는 그대로이므로 성공해야 한다
update t1 set i1 = 250 where i2 = 2000;
commit;

select i1, i2 from t1 order by i1, i2;

CALL CHECK_PARTITION_COUNT( "t1" );

# 이동하면서 PK 도 충돌시키면 실패해야 한다
update t1 set i1 = 50, i2 = 1000 where i2 = 2000;

select i1, i2 from t1 order by i1, i2;

##################################
# SECTOR; PK AFTER DELETE AND REINSERT
##################################
# 지운 값은 다시 넣을 수 있어야 한다. ager 가 키를 늦게 지워도
# 유니크 판정이 잘못되면 안 된다.

delete from t1 where i2 = 1000;
commit;

insert into t1 values (250, 1000, 9, 9);
commit;

select i1, i2 from t1 order by i1, i2;

##################################
# SECTOR; COMPOSITE PK
##################################

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

alter table t1 add constraint t1_pk primary key (i2, i3);

insert into t1 values (10, 1, 1, 1);
insert into t1 values (150, 1, 2, 2);
commit;

# (1,1) 중복 -> 실패해야 한다
insert into t1 values (250, 1, 1, 3);

# (1,3) 은 새 값 -> 성공
insert into t1 values (250, 1, 3, 3);
commit;

select i1, i2, i3 from t1 order by i1, i2, i3;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
