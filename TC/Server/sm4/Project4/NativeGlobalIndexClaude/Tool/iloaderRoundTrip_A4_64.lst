$T0> ##################################
$T0> SECTOR 5; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> RM "NGT_ILD.dat";
$T0> RM "NGT_ILD.fmt";
$T0> RM "NGT_ILD_IN.fmt";
$T0> SKIP END;
$T0> DROP TABLE NGT_ILD;
Drop success.
$T0> DROP TABLE NGT_ILD_IN;
Drop success.

