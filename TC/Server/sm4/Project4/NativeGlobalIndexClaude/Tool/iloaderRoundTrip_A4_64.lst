$T0> ##################################
$T0> SECTOR 4; D -- 글로벌 유일성을 어기는 적재
$T0> ##################################
$T0> # 같은 파일을 한 번 더 넣는다. 모든 키가 이미 있으므로 전부 위반이다.
$T0> # 물음은 "무엇이라 하는가" 이고, 그 답이 이 절의 산출물이다.
$T0> EXEC PROC1 "iloader in -s 127.0.0.1 -u sys -p manager -port ${ALTIBASE_PORT_NO} -T NGT_ILD_IN -f NGT_ILD_IN.fmt -d NGT_ILD.dat";
$T0> P_WAIT PROC1;

$T0> # D1. 행이 늘지 않았어야 한다. 늘었다면 유일성이 적재 경로에서
$T0> #     빠졌다는 뜻이다.
$T0> SELECT COUNT(*) AS AFTER_DUP_HEAP FROM NGT_ILD_IN;
AFTER_DUP_HEAP       
-----------------------
27                   
1 row selected.
$T0> SELECT /*+ INDEX( NGT_ILD_IN, NGT_ILD_IN_G ) */ COUNT(*)          AS AFTER_DUP_TREE     FROM NGT_ILD_IN;
AFTER_DUP_TREE       
-----------------------
27                   
1 row selected.
$T0> SELECT /*+ INDEX( NGT_ILD_IN, NGT_ILD_IN_G ) */ COUNT(DISTINCT K) AS AFTER_DUP_DISTINCT FROM NGT_ILD_IN;
AFTER_DUP_DISTINCT   
-----------------------
27                   
1 row selected.

$T0> # D2. 트리와 힙이 여전히 일치하는가 -- 실패한 적재가 반쪽을 남기면
$T0> #     여기서 갈린다.
$T0> SELECT /*+ INDEX( NGT_ILD_IN, NGT_ILD_IN_G ) */ K, P FROM NGT_ILD_IN ORDER BY K;
