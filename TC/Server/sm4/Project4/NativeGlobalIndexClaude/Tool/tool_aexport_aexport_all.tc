###########################################################################
# NativeGlobalIndexPort1624 - 전제와 판별자
#
# 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
# 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
# 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
#
#   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
#   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
#
# ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
#   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
#   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
#   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
#   어긋났었다(disk-natc.md 6).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
#   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
#   복원이 유일한 방벽이다.
###########################################################################

#
# 전제를 세우고, 세운 값을 전사에 남긴다.
# 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
#
DEF PIN_DISK_NATIVE()
{
  set linesize 200;
  alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
  select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
}
###########################################################################
# NativeGlobalIndexPort1624 - DESC_INDEX 의 네이티브 재정의 (배치 5)
#
# 원본 DDL/desc_global_index.i 를 대신한다. 원본과 **같은 이름, 같은 인자**
# 의 DEF DESC_INDEX( @aName ) 하나만 정의하므로, 이 배치 22 개 케이스의
# CALL DESC_INDEX( ... ) 자리는 원본과 바이트 동일하게 남는다.
# (checkFunctionIndex.i 가 배치 4 에서 쓴 것과 같은 수법이다.)
#
# ---------------------------------------------------------------------
# ★ 원본이 무엇을 하고 있었나
# ---------------------------------------------------------------------
#   desc "$GIT_@{aName}";                    -- 숨김 테이블의 모양
#   create table "$_TEMP" as select * from "$GIT_@{aName}";
#   update "$_TEMP" set "$GIT_OID"=0, "$GIT_RID"=0;
#   select * from "$_TEMP";                  -- 숨김 테이블의 내용
#
# 즉 "인덱스를 담은 테이블을 서술하고 그 안을 들여다본다" 이다. 네이티브
# 에는 그 테이블이 없다. 없는 것을 "에러가 난다" 로 굳히면 이유가 달라져도
# 초록이 되므로(v3-natc-port.md 6.1), 없음을 **값 0** 으로 적고 인덱스
# 자신의 서술은 네이티브 카탈로그와 런타임 헤더에서 가져온다.
#
# ---------------------------------------------------------------------
# ★ 네 겹
# ---------------------------------------------------------------------
#   겹 0  숨김 테이블이 없다. 이 이름의 것(THIS_GIT_TABLE)과 이 사용자의
#         어느 것이든(ANY_GIT_TABLE) 둘 다 센다. 0 만 적으면 조회가 깨져도
#         0 이므로, 프로퍼티 0 에서 1 이 되는 자리를 이빨로 남긴다.
#   겹 1  인덱스의 정체 -- 판별자(SYS_PART_INDICES_.PARTITION_TYPE = 101),
#         유니크, 인덱스 테이블스페이스. 인덱스가 없으면 No rows selected 다
#         (원본의 ERR-91014 자리). 인덱스 테이블스페이스는 원본이
#         desc "$GIT_X" 의 [ TABLESPACE : ... ] 줄로 재던 것과 같은 것을
#         재며, using index tablespace 절이 있는 섹터가 그것을 쓴다.
#   겹 2  글로벌의 구조 -- 인덱스 파티션 수(글로벌이면 0), 런타임 헤더
#         X$DISK_BTREE_HEADER 의 IS_GLOBAL / MEMBER_COUNT /
#         ACTIVE_MEMBER_COUNT. 카탈로그가 아니라 **도는 서버의 헤더**이므로
#         파티션 DDL 직후 카탈로그와 어긋나면 여기가 운다. DROP PARTITION 이
#         지나가면 MEMBER_COUNT 와 ACTIVE_MEMBER_COUNT 가 갈라진다.
#   겹 3  키 컬럼과 정렬 순서 -- 원본 desc 의 [ INDEX ] 절이 재던 것.
#
# ★ 페이지 ID·인덱스 ID·OID 는 한 줄도 내지 않는다. 인스턴스가 여태
#   만든 객체 수의 함수라 실행마다 달라진다(NEEDS_FRESH_INSTANCE).
#   같은 이유로 런타임 헤더는 INDEX_NAME 으로만 걸러 세고, 로컬 인덱스의
#   파티션 헤더 이름(__SYS_PART_IDX_ID_<n>)은 쳐다보지 않는다.
#
# ---------------------------------------------------------------------
# ★ 원본에 있고 여기 없는 것 -- 엔트리 목록
# ---------------------------------------------------------------------
# 원본의 넷째 줄(select * from "$_TEMP")은 인덱스가 담은 키를 줄 단위로
# 찍었다. 네이티브 b-tree 의 내용은 SQL 로 볼 수 없고, 내용을 재는 유일한
# 건전한 방법은 **힌트로 그 인덱스를 태운 스캔과 풀스캔의 차집합 + 플랜
# 증거**다(include/checkGlobalIndex.i 의 세 겹). 그것은 테이블 이름과
# 술어를 알아야 하는데 DESC_INDEX 는 인덱스 이름 하나만 받는다.
# 그래서 내용 검사는 원본이 그것을 두었던 자리에 그대로 둔다 --
# 이 배치의 파티션 DDL 여섯 케이스가 INCLUDE 하는 check_global_index.i 다
# (원본의 그 검사는 _PROWID 때문에 한 번도 돈 적이 없다. 이식본은 돈다).
# 수와 판정은 v4-natc-port-3.md 3.4.
###########################################################################

DEF DESC_INDEX( @aName )
{
  # 겹 0 -- 숨김 테이블 없음
  select count(case when table_name = '$GIT_@{aName}' then 1 end) this_git_table,
         count(*) any_git_table
  from system_.sys_tables_
  where table_name like '$GIT!_%' escape '!'
    and user_id = user_id();

  # 겹 1 -- 인덱스의 정체
  select cast(i.index_name as varchar(41)) index_name,
         cast(t.table_name as varchar(10)) table_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         cast(i.is_unique as varchar(1)) uq,
         cast(s.name as varchar(20)) index_tbs
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
       v$tablespaces s,
       ( select index_id, max(partition_type) partition_type
         from system_.sys_part_indices_ group by index_id ) p
  where i.index_name = '@{aName}'
    and i.user_id = user_id()
    and i.table_id = t.table_id
    and i.tbs_id = s.id
    and i.index_id = p.index_id(+);

  # 겹 2 -- 글로벌의 구조 (카탈로그 + 도는 서버의 헤더)
  select cast( ( select count(*) from system_.sys_index_partitions_ ip
                 where ip.index_id = i.index_id ) as integer ) index_partitions,
         cast( ( select count(*) from X$DISK_BTREE_HEADER h
                 where h.index_name = i.index_name ) as integer ) hdr_rows,
         cast( ( select max(h.is_global) from X$DISK_BTREE_HEADER h
                 where h.index_name = i.index_name ) as varchar(1) ) hdr_global,
         cast( ( select max(h.member_count) from X$DISK_BTREE_HEADER h
                 where h.index_name = i.index_name ) as integer ) member_cnt,
         cast( ( select max(h.active_member_count) from X$DISK_BTREE_HEADER h
                 where h.index_name = i.index_name ) as integer ) active_member_cnt
  from system_.sys_indices_ i
  where i.index_name = '@{aName}'
    and i.user_id = user_id();

  # 겹 3 -- 키 컬럼
  select ic.index_col_order ord,
         cast(c.column_name as varchar(20)) column_name,
         cast(ic.sort_order as varchar(1)) sort_order
  from system_.sys_indices_ i,
       system_.sys_index_columns_ ic,
       system_.sys_columns_ c
  where i.index_name = '@{aName}'
    and i.user_id = user_id()
    and ic.index_id = i.index_id
    and ic.column_id = c.column_id
  order by 1;
}
###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/tool/aexport/aexport_all.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################

###########################################################################
# Set Null Test
###########################################################################

##########################################################################
# PORT EDIT: this case exports the WHOLE database, so it has to start from
#            a database nobody else has written to
#
# Original lines 5-13 were DEF FINALIZE() with one statement in it,
# "drop user user1 cascade;".
#
# That was enough in the official harness because initialize.tc recreated
# the database (stdClean) before this case ran. This port removed that --
# see the PORT EDIT in initialize.tc -- because stdClean would rebuild the
# workflow's isolated instance as KO16KSC5601. What replaces it is the
# suite's NEEDS_FRESH_INSTANCE marker, which gives the SUITE a fresh
# database, not this CASE.
#
# The difference shows up in exactly one object. "aexport -u sys" writes
# every table in the database into ALL_CRT_TBL.sql, and this case CATs that
# file, so anything a neighbour left behind is part of this case's
# expectation. One neighbour leaks: six batch-2 cases
# (pdt/Design/CREATE_INDEX/LOCAL_UNIQUE/integer_{hash,range,list}.sql and
# pdt/Design/ALTER_INDEX/REBUILD/integer_{hash,range,list}.tc) CREATE TABLE
# T and drop it only in their own preamble, never at the end, so SYS.T
# outlives them. BUG-35460 hit the same leak from the other side and had to
# narrow a catalog listing to survive it (v4-natc-port-2.md 5.2).
#
# So FINALIZE drops it. Not because this case owns SYS.T -- it does not --
# but because this case's subject is "what does the database look like when
# aexport reads all of it", and that question has no answer while another
# case's table is still in it. SKIP BEGIN/END keeps it quiet when the table
# is not there, which is the normal case (running this .ts on its own).
#
# TEETH: this is not a silencer. If a second neighbour ever leaks, this
# case goes red on the extra CREATE TABLE in the CAT, at the line that
# names the leaking object -- which is how SYS.T was found.
##########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
SQL BEGIN;
connect sys/manager;
drop user user1 cascade;
drop table t;
SQL END;
SKIP END;
}
##########################################################################
# PORT EDIT END
##########################################################################

DEF PREPARE()
{
CALL FINALIZE();

SQL BEGIN;

connect sys/manager;

create user user1 identified by user1 default tablespace sys_tbs_disk_data;
connect user1/user1;

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i2, i1);
alter table t1 add constraint t1_uk unique (i3, i2, i1);

create index t1_idx1 on t1(i2);
create index t1_idx2 on t1(i2, i3 desc, i4);
create index t1_idx3 on t1(i3, i2 desc);

create index t1_idx4 on t1(i4 desc, i3) local;
create index t1_idx5 on t1(i4) local;

create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3,
  partition p4,
  partition pd
)
tablespace sys_tbs_disk_data;

alter table t2 add constraint t2_pk primary key (i2, i1);
alter table t2 add constraint t2_uk unique (i3, i2, i1);

create index t2_idx1 on t2(i2);
create index t2_idx2 on t2(i2, i3 desc, i4);
create index t2_idx3 on t2(i3, i2 desc);

create index t2_idx4 on t2(i4 desc, i3) local;
create index t2_idx5 on t2(i4) local;

create table t3
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by list(i1)
(
  partition p1 values (1,6,11,16,21,26,31,36,41,46,51,56,61,66,71,76,81,86,91,96),
  partition p2 values (2,7,12,17,22,27,32,37,42,47,52,57,62,67,72,77,82,87,92,97),
  partition p3 values (3,8,13,18,23,28,33,38,43,48,53,58,63,68,73,78,83,88,93,98),
  partition p4 values (4,9,14,19,24,29,34,39,44,49,54,59,64,69,74,79,84,89,94,99),
  partition pd values default
)
tablespace sys_tbs_disk_data;

alter table t3 add constraint t3_pk primary key (i2, i1);
alter table t3 add constraint t3_uk unique (i3, i2, i1);

create index t3_idx1 on t3(i2);
create index t3_idx2 on t3(i2, i3 desc, i4);
create index t3_idx3 on t3(i3, i2 desc);

create index t3_idx4 on t3(i4 desc, i3) local;
create index t3_idx5 on t3(i4) local;

SQL END;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; INITIALIZE
##################################

$ALTIBASE_HOME;

MV -f "${ALTIBASE_HOME}/conf/aexport.properties" "${ALTIBASE_HOME}/conf/aexport.properties.org";
CP "aexport.properties" "${ALTIBASE_HOME}/conf/aexport.properties";

CALL PREPARE();

##################################
# SECTOR; EXPORT
##################################

EXEC PROC1 "aexport -s 127.0.0.1 -u sys -p manager";
P_WAIT PROC1;

CAT "ALL_CRT_TBL.sql";
CAT "ALL_CRT_INDEX.sql";
CAT "ALL_CRT_USER.sql";

##################################
# SECTOR; IMPORT
##################################

CALL FINALIZE();

connect sys/manager;

EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f ALL_CRT_USER.sql";
P_WAIT PROC1;

EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f ALL_CRT_TBL.sql";
P_WAIT PROC1;

EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f ALL_CRT_INDEX.sql";
P_WAIT PROC1;

SQL BEGIN;

connect user1/altibase;

##########################################################################
# PORT EDIT: describe the indexes the export rebuilt, not the tables the
#            $GIT_ implementation kept them in
#
# The original asked, after the round trip:
#
#   desc t1;                  desc t2;                  desc t3;
#   desc "$GIT_T1_PK";        desc "$GIT_T2_PK";        desc "$GIT_T3_PK";
#   desc "$GIT_T1_UK";        ...                       ...
#   desc "$GIT_T1_IDX1..3";
#
# -- fifteen hidden tables. The native path builds none of them, and
# "[ERR-91014] does not exist" fifteen times is the shape of expectation
# this port refuses to record: it goes green for any reason at all, and
# six of the fifteen were ALREADY green for the wrong reason in the
# original (aexport_all_A4_64.lst has six ERR-91014, not fifteen).
#
# Those six are T1/T2/T3 _PK and _UK. Both carry the partition key I1, so
# they are LOCAL under BOTH implementations and the $GIT_ table never
# existed for them either -- the same mistake the original made in
# check_global_index.i (v3-natc-port.md 3.2) and in BUG-35460
# (v4-natc-port-2.md 5.1).
#
# So the port asks what this case is actually about: after export and
# re-import, is each index back, and is it back as the SAME KIND it was?
# DESC_INDEX (include/descIndex.i, the four-layer definition batch 5 built)
# prints the discriminator, so this block distinguishes
#
#   T1_PK / T1_UK        LOCAL          (partition key in the key)
#   T1_IDX1 / 2 / 3      NATIVE-GLOBAL  (no partition key -- the point)
#
# and it is that split, not an error message, that says the export did not
# quietly turn a global index into a local one. aexport writes LOCAL only
# for the local ones; measured in v4-natc-port-4.md 6.
#
# TEETH: with DISK_GLOBAL_INDEX_ENABLE = 0 the re-import builds T*_IDX1..3
# as hidden tables, KIND reads GIT-HIDDEN-TABLE for nine indexes and
# THIS_GIT_TABLE reads 1 instead of 0.
##########################################################################

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "T1_IDX1" );
CALL DESC_INDEX( "T1_IDX2" );
CALL DESC_INDEX( "T1_IDX3" );

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "T2_UK" );
CALL DESC_INDEX( "T2_IDX1" );
CALL DESC_INDEX( "T2_IDX2" );
CALL DESC_INDEX( "T2_IDX3" );

desc t3;
CALL DESC_INDEX( "T3_PK" );
CALL DESC_INDEX( "T3_UK" );
CALL DESC_INDEX( "T3_IDX1" );
CALL DESC_INDEX( "T3_IDX2" );
CALL DESC_INDEX( "T3_IDX3" );
##########################################################################
# PORT EDIT END
##########################################################################

SQL END;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();

RM "ALL_*" "USER1_*" "user1_*" "run_*";
RM "${ALTIBASE_HOME}/conf/aexport.properties";
MV -f "${ALTIBASE_HOME}/conf/aexport.properties.org" "${ALTIBASE_HOME}/conf/aexport.properties";
}
