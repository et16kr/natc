$T0> ##################################
$T0> # SECTOR; COALESCE WITH UNIQUE INDEX
$T0> ##################################
$T0> # 재분배 후에도 파티션 간 유일성이 유지되어야 한다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3,
  partition p4
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create unique index t1_uk on t1(i2);
Create success.

$T0> insert into t1 select level, level, level, level from dual connect by level <= 100;
100 rows inserted.
$T0> commit;
Commit success.

$T0> alter table t1 coalesce partition;
Alter success.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, t1_uk) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, t1_uk) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 기존 값 재삽입 -> 실패해야 한다
$T0> insert into t1 values (500, 50, 1, 1);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 새 값 -> 성공
$T0> insert into t1 values (500, 5000, 1, 1);
1 row inserted.
$T0> commit;
Commit success.

$T0> select count(*) from t1;
COUNT                
-----------------------
101                  
1 row selected.

