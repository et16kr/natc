$T0> ##################################
$T0> # SECTOR; RANGE BOUNDARY VALUES
$T0> ##################################
$T0> # 경계값이 어느 파티션으로 가는지, 그리고 인덱스가 그 로우를 옳게
$T0> # 가리키는지. VALUES LESS THAN 은 상한 미포함이다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values less than (maxvalue)
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index gidx1 on t1(i2);
Create success.

$T0> # 경계 바로 앞뒤
$T0> insert into t1 values (99,  99,  1, 1);
1 row inserted.
$T0> insert into t1 values (100, 100, 1, 1);
1 row inserted.
$T0> insert into t1 values (199, 199, 2, 2);
1 row inserted.
$T0> insert into t1 values (200, 200, 2, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> select 'P1' part_name, count(*) cnt from t1 partition (p1)
union all
select 'P2', count(*) from t1 partition (p2)
union all
select 'P3', count(*) from t1 partition (p3)
order by 1;
PART_NAME  CNT                  
-----------------------------------
P1  1                    
P2  2                    
P3  1                    
3 rows selected.

