###########################################################################
# TestCase Description = 디스크 파티션드 테이블의 non-partitioned index 가
#                        어느 스위치에 반응하는지.
#
#   ★ 이 파일의 전제는 D17 이 한 번 뒤집었다 (2026-08-04).
#
#   처음 이 케이스가 고정한 것은 "네이티브 글로벌 인덱스는 메모리 전용이며,
#   디스크 파티션드 테이블은 프로퍼티를 켜도 구버전(PROJ-1624)의 숨김
#   테이블 방식을 그대로 쓴다" 였다(코드 리뷰 P0-4). 그 문장의 앞 절반은
#   더 이상 참이 아니다 -- D17 이 디스크 네이티브 경로를 열었다.
#
#   뒤 절반은 여전히 참이고, 그것이 이 파일이 계속 지키는 것이다:
#   **MEM_GLOBAL_INDEX_ENABLE 은 디스크를 한 바이트도 움직이지 못한다.**
#   매체마다 스위치가 따로이기 때문이다 -- 메모리는 그 프로퍼티,
#   디스크는 DISK_GLOBAL_INDEX_ENABLE. off 의 뜻도 다르다:
#   메모리 off 는 그 문장을 실패시키고, 디스크 off 는 그 문장을 종전
#   구현으로 성공시킨다.
#
#   그래서 섹터가 두 부류다.
#     - 앞쪽(PROPERTY OFF / PROPERTY ON / PK / UK): 메모리 스위치를 켜도
#       디스크는 $GIT_ 그대로. 회귀 0 의 그물이다.
#     - 뒤쪽(DISK NATIVE ...): 디스크 스위치를 켜면 같은 문장이 네이티브를
#       만든다. 그리고 그 전에 만든 $GIT_ 인덱스는 계속 산다.
#
#   구분점:
#     네이티브  : SYS_PART_INDICES_.PARTITION_TYPE = 101, INDEX_TABLE_ID = 0
#     구버전    : SYS_PART_INDICES_ 행 없음, INDEX_TABLE_ID != 0
#
#   ★ 전제는 2026-08-19 에 세 번째로 뒤집혔다 (V4 D-2, GR-14 3단계).
#
#   디스크 off 의 뜻이 바뀌었다. "그 문장을 종전 구현($GIT_)으로
#   성공시킨다" 는 이제 참이 아니다 -- $GIT_ 생성 경로가 닫혔고
#   프로퍼티 0 은 ERR-314B6 으로 **실패**한다. 두 매체의 off 가 같은
#   뜻이 된 것이다(메모리 0 = ERR-313D0, 디스크 0 = ERR-314B6).
#
#   그래서 앞쪽 네 섹터는 프로퍼티만으로는 자기가 재려던 $GIT_ 를 더
#   이상 만들지 못한다. 은퇴한 구현을 재현하는 내부 스위치
#   __DISK_GLOBAL_INDEX_LEGACY_CREATE 를 이름 대고 부르게 했고,
#   그것을 DISABLE_DISK_GLOBAL_INDEX() 안에 넣었다 -- 그 DEF 의
#   호출자가 전부 "$GIT_ 를 재는 섹터" 이기 때문이다. 반대 짝인
#   ENABLE_DISK_GLOBAL_INDEX() 는 그 스위치를 끈다.
#
#   그리고 마지막에 섹터 하나가 붙었다(GIT RETIRED): 프로퍼티 0 만으로
#   $GIT_ 를 만들려는 다섯 문장이 전부 ERR-314B6 이고, LOCAL 과
#   네이티브는 그대로라는 것. 판정은
#   docs/analysis/claude-global-index/v4-git-retirement.md.
#
#   ★ 전제는 2026-08-06 에 한 번 더 뒤집혔다 (V3 D-4).
#
#   두 프로퍼티의 파일 기본값이 개발 기간 동안 **둘 다 1** 이 됐다
#   (idpDescResource.cpp). 이 파일은 디스크 스위치의 기본값이 0 이라고
#   믿고 앞쪽 네 섹터를 적었기 때문에, 그 전환만으로 아홉 자리가
#   어긋났다 -- 전부 같은 모양이다:
#     INDEX_TABLE_ID  NONZERO -> ZERO
#     SYS_PART_INDICES_  행 없음 -> PARTITION_TYPE 101
#     SYS_INDEX_PARTITIONS_  T1_PK 3 행 -> 없음
#   즉 $GIT_ 를 잰다고 적어 놓고 네이티브를 재고 있었다.
#
#   그래서 이제 **두 부류가 각자 자기 전제를 세운다.** 기본값이 어느
#   쪽으로 움직여도 이 파일은 자기가 재려는 것을 잰다:
#     - 앞쪽: PREPARATION 이 DISK_GLOBAL_INDEX_ENABLE = 0 을 못박는다.
#       그 사이에 값을 바꾸는 문장이 없으므로 네 섹터가 함께 덮인다.
#     - 뒤쪽: 원래도 스스로 1 을 세우고 있었다. 이제 세운 값을
#       v$property 로 전사에 남겨, 전사가 자기 전제를 적게 한다.
#     - FINALIZE: 파일 기본값 1 로 되돌려 다음 케이스에 0 이 새지 않게
#       한다. 이 프로퍼티는 비영속이라 재기동으로도 1 로 돌아가지만,
#       한 인스턴스 위에서 스위트가 이어 도는 동안은 이것이 유일한
#       복원이다.
#
# Project ID           = Native Global Index (memory + disk)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/selectMeta.i;

#
# 디스크 쪽 스위치. globalIndexEnv.i 의 ENABLE/DISABLE_GLOBAL_INDEX 는
# 메모리 프로퍼티만 만지므로 여기 짝을 둔다.
#
# 공유 include 에 넣지 않는 이유: ATC 는 INCLUDE 한 파일의 주석까지
# 전사에 찍는다. 거기에 한 줄이라도 넣으면 스위트 37 개의 .lst 가 전부
# 움직인다 -- 이 job 이 대지 못할 변화를 36 개에 굳히게 된다
# (disk-natc.md 4 가 같은 이유로 피한 자리다).
#
# 세운 값을 곧바로 읽는 것이 요점이다: 전사 자체가 자기 전제를 적게 된다.
#
# V4 D-2 (GR-14 3단계) 뒤로는 프로퍼티 0 만으로 $GIT_ 가 만들어지지
# 않는다(ERR-314B6). 이 DEF 의 호출자는 전부 "$GIT_ 를 재는 섹터" 이므로
# 은퇴한 구현을 재현하는 내부 스위치를 함께 세운다.
#
# 그 스위치는 __ 로 시작하는 내부 프로퍼티라 v$property 에 나오지 않는다.
# 그래서 값을 되읽어 전사에 남기는 것은 DISK_GLOBAL_INDEX_ENABLE 쪽뿐이고,
# 내부 스위치가 실제로 섰는지는 바로 뒤 섹터의 INDEX_TABLE_ID 가 말한다
# (NONZERO 면 $GIT_ 다) -- 못 섰다면 그 자리가 ERR-314B6 으로 붉어진다.
DEF DISABLE_DISK_GLOBAL_INDEX()
{
  alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
  alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 1;
  select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
}

DEF ENABLE_DISK_GLOBAL_INDEX()
{
  alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
  alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
  select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
}

# 3단계 자체를 재는 섹터가 쓰는 짝. 프로퍼티만 0 이고 내부 스위치는 0 --
# 즉 오늘의 사용자가 보는 그대로다.
DEF RETIRE_DISK_GLOBAL_INDEX()
{
  alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
  alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
  select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
}

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
}

DEF PREPARE()
{
CALL FINALIZE();
}

#
# 디스크 파티션드 테이블. 파티션 키는 i1.
#
DEF CREATE_DISK_PART_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
}

DEF FILL_DISK_DATA()
{
insert into t1 select level,       level,       level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100, level + 100, level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200, level + 200, level * 2, level * 3 from dual connect by level <= 30;
commit;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

# 앞쪽 네 섹터(PROPERTY OFF / PROPERTY ON / PK / UK)의 전제.
# 그것들이 재는 것은 $GIT_ 구현이고, 그 구현은 이 값이 0 일 때만
# 만들어진다. 파일 기본값은 1 이므로 여기서 세우지 않으면 네 섹터가
# 이름과 다른 것(네이티브)을 재게 된다 -- 실제로 그랬다.
# 뒤쪽 DISK NATIVE 섹터들이 각자 1 로 다시 세운다.
CALL DISABLE_DISK_GLOBAL_INDEX();

##################################
# SECTOR; PROPERTY OFF - BASELINE
##################################
# 프로퍼티가 꺼진 상태의 디스크 파티션드 테이블. 이것이 기준선이다.
# 아래 "PROPERTY ON" 섹터의 출력이 여기와 같아야 한다.

CALL DISABLE_GLOBAL_INDEX();

CALL CREATE_DISK_PART_TABLE();

# 파티션 키를 포함하지 않는 인덱스 -> 구버전 글로벌 인덱스가 만들어진다
create index gidx1 on t1(i2);

desc t1;
CALL SELECT_INDEX_META( "t1" );

CALL FILL_DISK_DATA();

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 100 and 110 order by i1;

##################################
# SECTOR; PROPERTY ON - MUST BE IDENTICAL
##################################
# ★ 프로퍼티를 켜도 디스크 테이블의 동작이 달라지면 안 된다.
#   위 섹터와 출력이 한 글자도 달라선 안 된다.

CALL ENABLE_GLOBAL_INDEX();

CALL CREATE_DISK_PART_TABLE();

create index gidx1 on t1(i2);

desc t1;
CALL SELECT_INDEX_META( "t1" );

CALL FILL_DISK_DATA();

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 100 and 110 order by i1;

##################################
# SECTOR; NON-PARTITION-KEY PRIMARY KEY ON DISK
##################################
# 파티션 키(i1)를 포함하지 않는 PK. 이것이 P0-4 가 겨냥한 정확한 조합이다.

CALL CREATE_DISK_PART_TABLE();

alter table t1 add constraint t1_pk primary key (i2);

CALL SELECT_INDEX_META( "t1" );

insert into t1 values (10,  1000, 1, 1);
insert into t1 values (150, 2000, 2, 2);
insert into t1 values (250, 3000, 3, 3);
commit;

# 파티션을 넘는 중복 -> 실패해야 한다
insert into t1 values (250, 1000, 4, 4);

# 새 값 -> 성공
insert into t1 values (250, 4000, 4, 4);
commit;

select i1, i2 from t1 order by i1;

##################################
# SECTOR; NON-PARTITION-KEY UNIQUE ON DISK
##################################

CALL CREATE_DISK_PART_TABLE();

create unique index t1_uk on t1(i2, i3);

CALL SELECT_INDEX_META( "t1" );

insert into t1 values (10,  1, 1, 1);
insert into t1 values (150, 1, 1, 2);

insert into t1 values (150, 1, 2, 2);
commit;

select i1, i2, i3 from t1 order by i1;

##################################
# SECTOR; MEMORY TABLE FOR CONTRAST
##################################
# 같은 문장을 메모리 파티션드 테이블에 걸면 판별자가 101 이고 숨김
# 객체가 없어야 한다. 위 디스크 섹터들과 정확히 반대다.

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

create index gidx1 on t2(i2);

CALL SELECT_INDEX_META( "t2" );

# ★ t2 를 여기서 지운다. 인덱스 이름은 사용자 단위로 유일하므로, t2 의
#   GIDX1 을 살려 두면 아래 두 섹터의 "create index gidx1 on t1(i2)" 가
#   자기가 재려는 판정에 닿지 못하고 ERR-3104C(중복 인덱스 이름)로 먼저
#   죽는다. 실제로 그래 왔다 -- 매체 혼합 섹터는 ERR-314AB 를 잰다고
#   적어 두고 ERR-3104C 를 재고 있었다(D23 발견).
NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

##################################
# SECTOR; DISK LOGICAL TABLE WITH MEMORY PARTITIONS
##################################
# 논리 테이블만 디스크. 매체가 섞이므로 거부되어야 한다 (ERR-314AB).
# createIndexError.tc 와 겹치지만, 여기서는 "디스크 쪽 판정" 의 일부로
# 다시 확인한다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace sys_tbs_mem_data,
  partition p2 values default tablespace sys_tbs_mem_data
)
tablespace sys_tbs_disk_data;

create index gidx1 on t1(i2);

##################################
# SECTOR; DISK NATIVE - DISK_GLOBAL_INDEX_ENABLE = 1
##################################
# ★ D17 이 뒤집는 기대다. 위 섹터들이 고정한 "디스크는 종전 그대로" 는
#   지금도 참이지만, 그것은 MEM_GLOBAL_INDEX_ENABLE 에 대해서만이다.
#   디스크는 별도 스위치 DISK_GLOBAL_INDEX_ENABLE 을 갖고, 그것을
#   켜면 같은 문장이 $GIT_ 대신 네이티브 글로벌 인덱스를 만든다.
#   (이 섹터가 처음 적힐 때 그 스위치의 기본값은 0 이었다. 지금은 1 이라
#   앞쪽 섹터들이 0 을 못박고, 이 섹터가 1 을 되세운다 -- 머리말 참조.)
#
#   집계 컬럼에 별칭을 붙이는 것은 취향이 아니다 -- count(*) 의 헤더
#   라벨이 클라이언트에 따라 COUNT / COUNT(*) 로 갈려서, 별칭이 없으면
#   기대 출력이 서버가 아니라 클라이언트를 시험하게 된다.

CALL ENABLE_DISK_GLOBAL_INDEX();

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index gidx1 on t1(i2);

select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;
# 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;

# 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;

insert into t1 select level,       level,       level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100, level + 100, level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200, level + 200, level * 2, level * 3 from dual connect by level <= 30;
commit;

select /*+ index(t1, gidx1) */ count(*) row_cnt from t1 where i2 >= 0;
select /*+ FULL SCAN(t1) */ count(*) row_cnt from t1 where i2 >= 0;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 100 and 110 order by i1;

##################################
# SECTOR; DISK NATIVE - NON-PARTITION-KEY PRIMARY KEY
##################################
# 위 "NON-PARTITION-KEY PRIMARY KEY ON DISK" 섹터와 같은 문장이다.
# 다른 것은 판별자가 101 이고 숨김 객체가 없다는 것뿐이며, 파티션을
# 넘는 중복 거절은 양쪽 다 성립한다 -- 그것이 전환의 요건이다.
#
# 앞 섹터가 켜 둔 값을 물려받지만 그것을 믿지 않는다 -- 자기가 재는
# 것이 네이티브이므로 자기가 세운다.

CALL ENABLE_DISK_GLOBAL_INDEX();

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;


create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i2);

select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;
# 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;

# 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;

insert into t1 values (10,  1000, 1, 1);
insert into t1 values (150, 2000, 2, 2);
insert into t1 values (250, 3000, 3, 3);
commit;

# 파티션을 넘는 중복 -> 실패해야 한다
insert into t1 values (250, 1000, 4, 4);

# 새 값 -> 성공
insert into t1 values (250, 4000, 4, 4);
commit;

select i1, i2 from t1 order by i1;

##################################
# SECTOR; DISK - $GIT_ 와 네이티브의 공존
##################################
# 전환 규약: 스위치를 켜기 전에 만든 $GIT_ 인덱스는 그대로 살아 있고,
# 켠 뒤에 만든 것만 네이티브다. 둘이 한 테이블에 공존하며 둘 다 답한다.
#
# 여기서는 SELECT_INDEX_META 대신 카탈로그 뷰 셋만 본다 --
# CHECK_NO_HIDDEN_OBJECT 의 '$GIT[_]%' ESCAPE '[' 패턴은 보이는 것과
# 달리 "$GIT_]%" 를 뜻해서 숨김 테이블이 있어도 잡지 못한다. 공존을
# 가르는 진짜 필드는 INDEX_TABLE_ID 이므로 그것을 본다.

CALL DISABLE_DISK_GLOBAL_INDEX();

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;


create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index gidx_old on t1(i2);

CALL ENABLE_DISK_GLOBAL_INDEX();

create index gidx_new on t1(i3);

select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;

insert into t1 select level,       level,       level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100, level + 100, level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200, level + 200, level * 2, level * 3 from dual connect by level <= 30;
commit;

select /*+ index(t1, gidx_old) */ count(*) row_cnt from t1 where i2 >= 0;
select /*+ index(t1, gidx_new) */ count(*) row_cnt from t1 where i3 >= 0;

# 한 INSERT 가 둘 다에 반영된다
insert into t1 values (150, 777, 888, 9);
commit;

select /*+ index(t1, gidx_old) */ i1 from t1 where i2 = 777;
select /*+ index(t1, gidx_new) */ i1 from t1 where i3 = 888;

##################################
# SECTOR; GIT RETIRED - DISK_GLOBAL_INDEX_ENABLE = 0 (V4 D-2)
##################################
# GR-14 3단계. 위 섹터들은 전부 내부 스위치로 은퇴한 구현을 재현해서
# $GIT_ 를 만들었다. 이 섹터는 그 스위치 없이, 오늘의 사용자가 보는
# 그대로를 잰다: 프로퍼티 0 은 $GIT_ 를 만들지 않고 ERR-314B6 이다.
#
# 다섯 문장을 전부 친다 -- CREATE INDEX, CREATE UNIQUE INDEX,
# ADD CONSTRAINT UNIQUE, ADD CONSTRAINT PRIMARY KEY, 그리고 CREATE TABLE
# 의 제약. 마지막 것이 있는 이유는 세 코드 자리가 ALTER 뿐 아니라
# CREATE TABLE 도 덮는다는 사실이 이 파일에는 아직 없었기 때문이다.
#
# 그리고 거절이 넓지 않다는 것을 같은 자리에서 잰다: LOCAL 은 그대로
# 만들어지고, 프로퍼티를 1 로 올리면 같은 문장이 네이티브를 만든다.

CALL RETIRE_DISK_GLOBAL_INDEX();

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

# 다섯 문장. 전부 ERR-314B6.
create index gidx1 on t1(i2);
create unique index gidx2 on t1(i2);
alter table t1 add constraint t1_uk unique (i2);
alter table t1 add constraint t1_pk primary key (i2);

create table t2( i1 integer, i2 integer,
                 constraint t2_pk primary key (i2) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_disk_data;

# 거절이 아무것도 남기지 않는다.
select i.index_name,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select t.table_name
  from system_.sys_tables_ t
  where t.table_name = upper('t2')
    and t.user_id = user_id();
select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_type = 'G'
    and t.user_id = u.user_id
  order by t.table_name;

# 거절은 넓지 않다. LOCAL 은 그대로다.
create index lidx1 on t1(i2) local;
drop index lidx1;

# 파티션 키를 포함한 PK 는 로컬이므로 거절되지 않는다.
alter table t1 add constraint t1_lpk primary key (i1);
alter table t1 drop constraint t1_lpk;

# 프로퍼티를 1 로 올리면 같은 문장이 네이티브를 만든다.
CALL ENABLE_DISK_GLOBAL_INDEX();

create index gidx1 on t1(i2);

select i.index_name,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;

# 그리고 그 네이티브 인덱스의 REBUILD 는 프로퍼티 0 에서도 그대로 돈다 --
# 3단계가 막는 것은 $GIT_ 를 만드는 자리이지 리빌드 자체가 아니다.
CALL RETIRE_DISK_GLOBAL_INDEX();

alter index gidx1 rebuild;

select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;

##################################
# SECTOR; FINALIZATION
##################################
# 파일 기본값 1 로 되돌린다. 이 케이스는 0 을 여러 번 세우고 끝나므로,
# 되돌리지 않으면 같은 인스턴스에서 이어 도는 다음 케이스가 0 을 물려
# 받는다 -- 옛 코드가 정확히 그렇게 끝나고 있었다(마지막 문장이 0).

CALL ENABLE_DISK_GLOBAL_INDEX();

CALL FINALIZE();
}
