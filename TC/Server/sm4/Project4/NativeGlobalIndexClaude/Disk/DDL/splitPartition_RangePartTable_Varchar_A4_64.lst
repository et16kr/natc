-- (P1,   NULL, '100')
-- (P2_1, '100',  '150')
-- (P2_2, '150',  '200')
-- (P3,   '200',  '300')
-- (P4,   '300',  NULL)
$P0> SELECT PART.PARTITION_NAME, PART.PARTITION_MIN_VALUE, PART.PARTITION_MAX_VALUE
     FROM SYSTEM_.SYS_TABLE_PARTITIONS_ PART,
          SYSTEM_.SYS_TABLES_ TAB
     WHERE TAB.TABLE_ID = PART.TABLE_ID AND
           TAB.TABLE_NAME='T1'
     ORDER BY PART.PARTITION_NAME;
