$P0> DROP TABLE T1;
Drop success.
$P0> DROP TABLE T2;
Drop success.

$P0> CREATE TABLE T1( I1 VARCHAR(1000), I2 VARCHAR(10), I3 INTEGER )
     PARTITION BY RANGE (I1)
     (
         PARTITION P1 VALUES LESS THAN ('100'),
         PARTITION P2 VALUES LESS THAN ('200'),
         PARTITION P3 VALUES LESS THAN ('300'),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO T1 VALUES ('000', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('050', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('100', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('150', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('200', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('250', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('300', '100', 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES ('350', '100', 100);
1 row inserted.


$P0> CREATE TABLE T2( I1 VARCHAR(10), I2 VARCHAR(1000), I3 INTEGER )
     PARTITION BY RANGE (I1, I2)
     (
         PARTITION P1 VALUES LESS THAN ('100') TABLESPACE PDT_TBS2,
         PARTITION P2 VALUES LESS THAN ('200') TABLESPACE PDT_TBS3,
         PARTITION P3 VALUES LESS THAN ('300'),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO T2 VALUES ('000', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('050', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('100', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('150', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('200', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('250', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('300', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('350', '100', 100);
1 row inserted.

$P0> CREATE INDEX IDX1 ON T2(I1, I3);
Create success.

$P0> CREATE INDEX IDX2 ON T2(I3, I1, I2);
Create success.

$P0> CREATE INDEX IDX3 ON T2(I2, I3);
Create success.

$P0> CREATE INDEX IDX4 ON T2(I1) LOCAL
     (
         PARTITION P1_IDX1 ON P1 TABLESPACE PDT_TBS2,
         PARTITION P2_IDX1 ON P2 TABLESPACE PDT_TBS3,
         PARTITION P3_IDX1 ON P3 TABLESPACE PDT_TBS4,
         PARTITION P4_IDX1 ON P4 TABLESPACE PDT_TBS5
     );
Create success.# ==> [splitPartition_RangePartTable_Varchar_Schema_Range_Varchar.sql] END <=
$P0> ALTER TABLE T1 
     SPLIT PARTITION P2 AT (150) INTO
     ( 
         PARTITION P2_1,
         PARTITION P2_2
     );
Alter success.

