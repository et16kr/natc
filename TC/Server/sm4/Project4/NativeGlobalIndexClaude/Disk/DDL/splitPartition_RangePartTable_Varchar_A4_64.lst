1 row inserted.
$P0> INSERT INTO T2 VALUES ('200', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('250', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('300', '100', 100);
1 row inserted.
$P0> INSERT INTO T2 VALUES ('350', '100', 100);
1 row inserted.

$P0> CREATE INDEX IDX1 ON T2(I1, I3);
Create success.

$P0> CREATE INDEX IDX2 ON T2(I3, I1, I2);
Create success.

$P0> CREATE INDEX IDX3 ON T2(I2, I3);
Create success.

$P0> CREATE INDEX IDX4 ON T2(I1) LOCAL
     (
         PARTITION P1_IDX1 ON P1 TABLESPACE PDT_TBS2,
         PARTITION P2_IDX1 ON P2 TABLESPACE PDT_TBS3,
         PARTITION P3_IDX1 ON P3 TABLESPACE PDT_TBS4,
         PARTITION P4_IDX1 ON P4 TABLESPACE PDT_TBS5
     );
Create success.# ==> [splitPartition_RangePartTable_Varchar_Schema_Range_Varchar.sql] END <=
