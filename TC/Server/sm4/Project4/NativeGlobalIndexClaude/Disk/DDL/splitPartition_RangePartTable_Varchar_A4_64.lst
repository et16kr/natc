$P0> DROP TABLE T1;
Drop success.
$P0> CREATE TABLE T1 ( I1 VARCHAR(10), I2 BLOB, I3 CLOB )
     PARTITION BY RANGE (I1) 
     ( PARTITION P1 VALUES LESS THAN ('100') TABLESPACE PDT_TBS 
                                         LOB(I2, I3) STORE AS ( TABLESPACE PDT_TBS2 ), 
       PARTITION P2 VALUES LESS THAN ('200') TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES DEFAULT
     ) TABLESPACE PDT_TBS4 LOB(I3) STORE AS ( TABLESPACE PDT_TBS5 );
Create success.

$P0> INSERT INTO T1 VALUES ( '000',   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( '001',   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( '050',   'ABC', 'DEF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( '051',   'ABC', 'DEF' );
1 row inserted.

$P0> ALTER TABLE T1
     SPLIT PARTITION P1 AT ('050') INTO
     (
         PARTITION P1,
         PARTITION P1_1 LOB STORE AS ( TABLESPACE PDT_TBS4 )
     );
Alter success.

