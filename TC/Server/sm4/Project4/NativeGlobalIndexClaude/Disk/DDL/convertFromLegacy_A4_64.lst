$T0> ##################################
$T0> SECTOR 3; B — ★ §3 (N9). DIRECTKEY 는 전환을 수행해선 안 된다
$T0> ##################################
$T0> # 전환이 서기 전에 이 절을 둔다 — DIRECTKEY 토글이 조용히 전환을 해 버리면
$T0> # C 절이 "무엇이 전환했는지" 를 못 가른다.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
