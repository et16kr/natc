$T0> ##################################
$T0> SECTOR 5; D — ★ §4 (N10). 전환 결과 == CREATE 결과
$T0> ##################################
$T0> # 같은 모양을 처음부터 네이티브로 만든 것과 카탈로그를 나란히 센다.
$T0> # 전환이 지우지 않은 행이 있으면 두 수가 갈린다.
$T0> CREATE TABLE NGD_CVT_REF ( P INTEGER, K INTEGER, V VARCHAR(16),
                               CONSTRAINT NGD_CVT_REF_PK PRIMARY KEY ( K ) )
    PARTITION BY RANGE ( P )
    (
        PARTITION P1 VALUES LESS THAN ( 10 ),
        PARTITION P2 VALUES LESS THAN ( 20 ),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

