$T0> select name, value1 from v$property where name = '__DISK_GLOBAL_INDEX_LEGACY_CREATE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> ##################################
$T0> SECTOR 2; A — $GIT_ 를 하나 만든다 (탈출구를 잠깐 연다)
$T0> ##################################
$T0> alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 1;
Alter success.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> select name, value1 from v$property where name = '__DISK_GLOBAL_INDEX_LEGACY_CREATE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
No rows selected.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
0                                                                                                                                                                                                                                                                 
1 row selected.

$T0> # ★ PK 는 파티션 키 P 를 **포함하면 안 된다**. 처음 (K, P) 로 잡았다가
$T0> # 파티션 키와 **부분 중첩**하도록 (K, P) 로 잡는다 — 리뷰 §4 가
$T0> #   로컬 파티션드 인덱스로 설 수 있어 글로벌이 아예 필요 없어진다.
$T0> CREATE TABLE NGD_CVT ( P INTEGER, K INTEGER, V VARCHAR(16),
                           CONSTRAINT NGD_CVT_PK PRIMARY KEY ( K ) )
    PARTITION BY RANGE ( P )
    (
        PARTITION P1 VALUES LESS THAN ( 10 ),
        PARTITION P2 VALUES LESS THAN ( 20 ),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> INSERT INTO NGD_CVT SELECT LEVEL,      100 + LEVEL, 'V' FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> INSERT INTO NGD_CVT SELECT LEVEL + 10, 200 + LEVEL, 'V' FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> INSERT INTO NGD_CVT SELECT LEVEL + 20, 300 + LEVEL, 'V' FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> COMMIT;
Commit success.

$T0> # A1. 정말 $GIT_ 인가 — 네이티브가 아니어야 한다(판별자 101 이 0 건).
$T0> SELECT COUNT(*) AS IS_NATIVE_BEFORE
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID
       AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGD_CVT_PK';
IS_NATIVE_BEFORE     
-----------------------
0                    
1 row selected.

$T0> # A2. $GIT_ 는 숨김 테이블을 갖는다 — INDEX_TABLE_ID 가 0 이 아니다.
$T0> SELECT DECODE( INDEX_TABLE_ID, 0, 'NATIVE', 'GIT' ) AS IMPL_BEFORE
      FROM SYSTEM_.SYS_INDICES_ WHERE INDEX_NAME = 'NGD_CVT_PK';
IMPL_BEFORE  
---------------
GIT     
1 row selected.

$T0> # A3. 전환 전의 메타 행 수 — B 절의 같은 자리와 대조한다.
$T0> SELECT COUNT(*) AS PART_KEY_COLS_BEFORE
      FROM SYSTEM_.SYS_PART_KEY_COLUMNS_
     WHERE OBJECT_TYPE = 1
       AND PARTITION_OBJ_ID = ( SELECT INDEX_ID FROM SYSTEM_.SYS_INDICES_
                                 WHERE INDEX_NAME = 'NGD_CVT_PK' );
PART_KEY_COLS_BEFORE 
-----------------------
0                    
1 row selected.

