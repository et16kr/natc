$T0> # B1. DIRECTKEY ON. DIRECT KEY 는 글로벌의 비목표이므로 거절이어야 하고,
$T0> #     거절 사유는 CREATE 가 같은 조합에 내는 것과 같아야 한다.
$T0> ALTER INDEX NGD_CVT_PK DIRECTKEY;
[ERR-314AD : A native global index cannot be created with this index option or key column type: DIRECT KEY.]

$T0> # B2. 여전히 $GIT_ 인가 — 거절이 맞다면 아무것도 안 바뀌었어야 한다.
$T0> #     여기서 NATIVE 가 나오면 요청하지 않은 전환이 수행된 것이다.
$T0> SELECT DECODE( INDEX_TABLE_ID, 0, 'NATIVE', 'GIT' ) AS IMPL_AFTER_DIRECTKEY
      FROM SYSTEM_.SYS_INDICES_ WHERE INDEX_NAME = 'NGD_CVT_PK';
IMPL_AFTER_DIRECTKEY  
------------------------
GIT     
1 row selected.

$T0> # B3. DIRECTKEY OFF — 종전에는 메모리 전용 가드를 아예 지나쳤다
$T0> #     (qdx.cpp 의 빈 else). 이쪽도 막혀야 한다.
$T0> ALTER INDEX NGD_CVT_PK DIRECTKEY OFF;
[ERR-314AD : A native global index cannot be created with this index option or key column type: DIRECT KEY.]
$T0> SELECT DECODE( INDEX_TABLE_ID, 0, 'NATIVE', 'GIT' ) AS IMPL_AFTER_DIRECTKEY_OFF
      FROM SYSTEM_.SYS_INDICES_ WHERE INDEX_NAME = 'NGD_CVT_PK';
IMPL_AFTER_DIRECTKEY_OFF  
----------------------------
GIT     
1 row selected.

