 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = $GIT_ -> 네이티브 전환 — DIRECTKEY 거절 · 카탈로그 동등성 · 예산 경계 (디스크).
$T0> # Project ID           = Native Global Index
$T0> #
$T0> # 출처                 = 없음. **새로 쓴 것**이다.
$T0> #                        V4 코드 리뷰(v4-code-review.md)의 §3 · §4 · §6 이
$T0> #                        각각 요구한 감시자다 — 리뷰의 마감 조건이
$T0> #                        "발견마다 감시자(검사 칸)를 함께 세울 것" 이고,
$T0> #                        셋 다 전환 축이라 픽스처를 공유한다
$T0> #                        (커버리지 공백 N9 · N10 · N11).
$T0> #
$T0> # ★ 전제 — 오늘 $GIT_ 를 어떻게 만드는가
$T0> #   J24(V4 D-2)가 $GIT_ 생성을 은퇴시켰다. 그냥 프로퍼티 0 으로 두고
$T0> #   만들면 `ERR-314B6`(은퇴한 구현) 이다. 탈출구가 따로 있다:
$T0> #
$T0> #       __DISK_GLOBAL_INDEX_LEGACY_CREATE = 1
$T0> #
$T0> #   내부 프로퍼티이고 기본값 0 이며 **디스크에만 있다**(메모리 대응 없음).
$T0> #   그래서 이 케이스의 매체는 디스크다. 전환 픽스처는
$T0> #       LEGACY_CREATE = 1  +  DISK_GLOBAL_INDEX_ENABLE = 0   -> $GIT_ 생성
$T0> #       DISK_GLOBAL_INDEX_ENABLE = 1  +  ALTER INDEX ... REBUILD -> 전환
$T0> #   이다. 이 케이스는 쓰고 나서 **반드시 0 으로 되돌린다** — 켜 둔 채로
$T0> #   끝나면 뒤 케이스가 은퇴한 구현을 만들 수 있게 된다(§계획 8.5 규약 ②).
$T0> #
$T0> # 무엇을 재는가 — 셋
$T0> #
$T0> #   §3 (N9) `ALTER INDEX ... DIRECTKEY [OFF]` 가 REBUILD 를 **경유**한다.
$T0> #       그 아래가 D-1 의 전환이므로, direct-key 토글 한 번이 사용자가
$T0> #       요청하지도 않은 전 파티션 X 잠금 전환을 수행하거나(프로퍼티 1),
$T0> #       문맥이 어긋난 `ERR-314B6` 을 낸다(프로퍼티 0). J24 가 "덮는 문장
$T0> #       다섯" 으로 회계한 목록 **밖의 여섯 번째 경로**다.
$T0> #       고친 뒤 기대값은 CREATE 가 같은 조합에 내는 것과 같은 거절이다.
$T0> #
$T0> #   §4 (N10) 전환이 `SYS_PART_KEY_COLUMNS_` 고아 행을 남겼다.
$T0> #       진짜 DROP INDEX 는 지우고 네이티브 CREATE 는 애초에 만들지
$T0> #       않으므로, 남으면 **D-1 의 "전환 결과 == CREATE 결과" 불변식이
$T0> #       카탈로그 수준에서 깨진다.** 그래서 이 절은 전환본과 신규 생성본의
$T0> #       메타 행을 나란히 센다.
$T0> #
$T0> #   §6 (N11) 전환 사전 검사의 인덱스 예산 off-by-one.
$T0> #       $GIT_ PK 는 파티션마다 같은 INDEX_ID 의 로컬 인덱스를 함께 갖고
$T0> #       전환은 그것을 새 트리 전에 걷는데, 세는 쪽이 아직 포함해서 셌다.
$T0> #       가장 붐비는 파티션이 정확히 예산 64 면 전환 후엔 들어맞는데도
$T0> #       거부됐다 — 방향이 안전한(거짓 거부) 경계 결함이다.
$T0> #
$T0> # ★ 실측 (2026-08-20) -- 전환 축 전부가 옳게 선다
$T0> #
$T0> #     IS_NATIVE_BEFORE 0 · IMPL_BEFORE GIT      탈출구로 $GIT_ 가 만들어졌다
$T0> #     IMPL_AFTER_DIRECTKEY GIT (OFF 도 GIT)     DIRECTKEY 는 거절되고 아무것도 안 바꿨다
$T0> #     IS_NATIVE_AFTER 1 · IMPL_AFTER NATIVE     REBUILD 가 판별자를 세우고
$T0> #                                               숨김 테이블 참조도 걷었다
$T0> #     PART_KEY_COLS  전환본 0 == 신규본 0        고아 행이 없다
$T0> #     IMPL_REF / IMPL_BUD NATIVE                신규 생성본·예산 경로도 네이티브
$T0> #
$T0> #   즉 **D-1 의 "전환 결과 == CREATE 결과" 불변식이 카탈로그 수준에서
$T0> #   성립한다.** 리뷰 §4 가 지목한 `SYS_PART_KEY_COLUMNS_` 고아 행은 이 키
$T0> #   모양에서 재현되지 않았다.
$T0> #
$T0> #   ★ §3(DIRECTKEY)은 **디스크로는 도달하지 않는다** --
$T0> #     `ERR-111A5 : The DIRECTKEY option is only supported for memory B-Tree
$T0> #     indexes.` 매체 가드가 전환 판정보다 **먼저** 울린다. 리뷰가 그린
$T0> #     "DIRECTKEY 가 요청 없는 전환을 수행한다" 는 메모리 $GIT_ 에서만
$T0> #     성립하는데, 탈출구 프로퍼티가 디스크 전용이라 그 조합은 오늘 이
$T0> #     스위트에서 만들 수 없다. 그 사실 자체가 이 절의 산출물이다.
$T0> #
$T0> # ★ 기대값 기록 조건
$T0> #   셋 다 altibase 작업 트리의 **미커밋 수정이 커밋된 뒤**의 빌드에서만
$T0> #   옳다. 그 전에 찍으면 결함을 기대값으로 동결한다(J19b 때 `.lst` 셋이
$T0> #   실제로 그랬다).
$T0> #
$T0> # ★ .lst 미기록 — 서버가 서면 두 번 돌려 바이트 동일을 확인한 뒤 찍을 것.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGD_CVT;
$T0> DROP TABLE NGD_CVT_REF;
$T0> DROP TABLE NGD_CVT_BUD;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION — 전제를 눈에 보이게 둔다
$T0> ##################################
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
