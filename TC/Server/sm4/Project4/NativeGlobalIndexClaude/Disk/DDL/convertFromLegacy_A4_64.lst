$T0> ##################################
$T0> SECTOR 6; E — ★ §6 (N11). 예산 경계에서 전환이 거짓으로 거부되지 않는다
$T0> ##################################
$T0> # 전환은 곧 걷어 낼 로컬 인덱스를 세는 대상에서 빼야 한다. 빼지 않으면
$T0> # 가장 붐비는 파티션이 정확히 예산에 있을 때 "개수 초과" 로 거부된다.
$T0> #
$T0> # 경계를 정확히 64 로 맞추는 것은 이 케이스가 스스로 못 한다(예산은
$T0> # SMI_INDEX_BIT_BUDGET 이고 픽스처가 그 수만큼 인덱스를 만들어야 한다).
$T0> # 그래서 여기서는 **방향만** 잰다 — 로컬 인덱스를 여럿 얹은 테이블의
$T0> # 전환이 서는가. 정확한 경계는 Boundary 축의 indexBudget 계열이 받는다.

$T0> alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 1;
Alter success.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
Alter success.

$T0> CREATE TABLE NGD_CVT_BUD ( P INTEGER, K INTEGER,
                               C1 INTEGER, C2 INTEGER, C3 INTEGER, C4 INTEGER,
                               CONSTRAINT NGD_CVT_BUD_PK PRIMARY KEY ( K ) )
    PARTITION BY RANGE ( P )
    (
        PARTITION P1 VALUES LESS THAN ( 10 ),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> INSERT INTO NGD_CVT_BUD SELECT LEVEL, LEVEL, 1, 2, 3, 4 FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> COMMIT;
Commit success.

$T0> alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
Alter success.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> # 파티션마다 로컬 인덱스를 여럿 얹는다. $GIT_ PK 의 로컬 분이 여기
$T0> # 더해져 있으므로, 전환 검사가 그것을 빼지 않으면 수가 부풀어 있다.
$T0> CREATE INDEX NGD_CVT_BUD_L1 ON NGD_CVT_BUD ( C1 ) LOCAL;
Create success.
$T0> CREATE INDEX NGD_CVT_BUD_L2 ON NGD_CVT_BUD ( C2 ) LOCAL;
Create success.
$T0> CREATE INDEX NGD_CVT_BUD_L3 ON NGD_CVT_BUD ( C3 ) LOCAL;
Create success.
$T0> CREATE INDEX NGD_CVT_BUD_L4 ON NGD_CVT_BUD ( C4 ) LOCAL;
Create success.

$T0> # E1. 파티션이 지금 몇 개의 인덱스를 갖는가 (전환 검사가 세는 수).
$T0> SELECT COUNT(*) AS LOCAL_INDEX_COUNT
      FROM SYSTEM_.SYS_INDEX_PARTITIONS_ IP, SYSTEM_.SYS_INDICES_ I
     WHERE IP.INDEX_ID = I.INDEX_ID
       AND I.TABLE_ID = ( SELECT TABLE_ID FROM SYSTEM_.SYS_TABLES_
                           WHERE TABLE_NAME = 'NGD_CVT_BUD' );
LOCAL_INDEX_COUNT    
-----------------------
10                   
1 row selected.

$T0> # E2. 전환이 서는가.
$T0> ALTER INDEX NGD_CVT_BUD_PK REBUILD;
Alter success.
$T0> SELECT DECODE( INDEX_TABLE_ID, 0, 'NATIVE', 'GIT' ) AS IMPL_BUD
      FROM SYSTEM_.SYS_INDICES_ WHERE INDEX_NAME = 'NGD_CVT_BUD_PK';
IMPL_BUD  
------------
NATIVE  
1 row selected.
$T0> SELECT COUNT(*) AS ROWS_BUD FROM NGD_CVT_BUD;
ROWS_BUD             
-----------------------
5                    
1 row selected.

$T0> ##################################
$T0> SECTOR 7; FINALIZATION — 탈출구가 닫혀 있는지 확인하고 끝낸다
$T0> ##################################
$T0> alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
Alter success.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = '__DISK_GLOBAL_INDEX_LEGACY_CREATE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
No rows selected.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> DROP TABLE NGD_CVT;
Drop success.
$T0> DROP TABLE NGD_CVT_REF;
Drop success.
$T0> DROP TABLE NGD_CVT_BUD;
Drop success.

