 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 전제와 판별자
$T0> #
$T0> # 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
$T0> # 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
$T0> # 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
$T0> #
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
$T0> #
$T0> # ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
$T0> #   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
$T0> #   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
$T0> #   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
$T0> #   어긋났었다(disk-natc.md 6).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
$T0> #   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
$T0> #   복원이 유일한 방벽이다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고, 세운 값을 전사에 남긴다.
$T0> # 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
$T0> #
$T0> #
$T0> # 인덱스가 어느 구현인지 카탈로그로 판별해 전사에 남긴다.
$T0> #
$T0> #   NATIVE GLOBAL : SYS_PART_INDICES_.PARTITION_TYPE = 101, INDEX_TABLE_ID = 0
$T0> #   LOCAL         : IS_PARTITIONED = 'T', SYS_INDEX_PARTITIONS_ 에 행
$T0> #   $GIT_ GLOBAL  : INDEX_TABLE_ID != 0 (숨김 테이블 OID)
$T0> #
$T0> # ★ 이 절이 이 스위트의 이빨이다. 프로퍼티가 0 이면 CREATE INDEX 로 만든
$T0> #   인덱스가 $GIT_ 로 내려가 KIND 가 통째로 바뀌고, 같은 문장을 재고 있다는
$T0> #   착각이 여기서 깨진다.
$T0> #
$T0> # ★ 원본 fixture 의 T1_PK(i2,i1) / T1_UK(i3,i2,i1) 은 파티션 키 i1 을
$T0> #   포함하므로 두 구현 어느 쪽에서도 글로벌이 아니라 LOCAL 이다. 원본
$T0> #   check_global_index.i 가 "$GIT_T1_PK" 를 조회한 것은 존재하지 않는
$T0> #   테이블을 겨눈 것이었다 -- v3-natc-port.md 3.2.
$T0> #
$T0> #
$T0> # 숨김 테이블이 하나도 없다는 것을 남긴다.
$T0> # 네이티브 경로에서는 $GIT_ 가 만들어지지 않는다.
$T0> #
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - DESC_INDEX 의 네이티브 재정의 (배치 5)
$T0> #
$T0> # 원본 DDL/desc_global_index.i 를 대신한다. 원본과 **같은 이름, 같은 인자**
$T0> # 의 DEF DESC_INDEX( @aName ) 하나만 정의하므로, 이 배치 22 개 케이스의
$T0> # CALL DESC_INDEX( ... ) 자리는 원본과 바이트 동일하게 남는다.
$T0> # (checkFunctionIndex.i 가 배치 4 에서 쓴 것과 같은 수법이다.)
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 원본이 무엇을 하고 있었나
$T0> # ---------------------------------------------------------------------
$T0> #   desc "$GIT_@{aName}";                    -- 숨김 테이블의 모양
$T0> #   create table "$_TEMP" as select * from "$GIT_@{aName}";
$T0> #   update "$_TEMP" set "$GIT_OID"=0, "$GIT_RID"=0;
$T0> #   select * from "$_TEMP";                  -- 숨김 테이블의 내용
$T0> #
$T0> # 즉 "인덱스를 담은 테이블을 서술하고 그 안을 들여다본다" 이다. 네이티브
$T0> # 에는 그 테이블이 없다. 없는 것을 "에러가 난다" 로 굳히면 이유가 달라져도
$T0> # 초록이 되므로(v3-natc-port.md 6.1), 없음을 **값 0** 으로 적고 인덱스
$T0> # 자신의 서술은 네이티브 카탈로그와 런타임 헤더에서 가져온다.
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 네 겹
$T0> # ---------------------------------------------------------------------
$T0> #   겹 0  숨김 테이블이 없다. 이 이름의 것(THIS_GIT_TABLE)과 이 사용자의
$T0> #         어느 것이든(ANY_GIT_TABLE) 둘 다 센다. 0 만 적으면 조회가 깨져도
$T0> #         0 이므로, 프로퍼티 0 에서 1 이 되는 자리를 이빨로 남긴다.
$T0> #   겹 1  인덱스의 정체 -- 판별자(SYS_PART_INDICES_.PARTITION_TYPE = 101),
$T0> #         유니크, 인덱스 테이블스페이스. 인덱스가 없으면 No rows selected 다
$T0> #         (원본의 ERR-91014 자리). 인덱스 테이블스페이스는 원본이
$T0> #         desc "$GIT_X" 의 [ TABLESPACE : ... ] 줄로 재던 것과 같은 것을
$T0> #         재며, using index tablespace 절이 있는 섹터가 그것을 쓴다.
$T0> #   겹 2  글로벌의 구조 -- 인덱스 파티션 수(글로벌이면 0), 런타임 헤더
$T0> #         X$DISK_BTREE_HEADER 의 IS_GLOBAL / MEMBER_COUNT /
$T0> #         ACTIVE_MEMBER_COUNT. 카탈로그가 아니라 **도는 서버의 헤더**이므로
$T0> #         파티션 DDL 직후 카탈로그와 어긋나면 여기가 운다. DROP PARTITION 이
$T0> #         지나가면 MEMBER_COUNT 와 ACTIVE_MEMBER_COUNT 가 갈라진다.
$T0> #   겹 3  키 컬럼과 정렬 순서 -- 원본 desc 의 [ INDEX ] 절이 재던 것.
$T0> #
$T0> # ★ 페이지 ID·인덱스 ID·OID 는 한 줄도 내지 않는다. 인스턴스가 여태
$T0> #   만든 객체 수의 함수라 실행마다 달라진다(NEEDS_FRESH_INSTANCE).
$T0> #   같은 이유로 런타임 헤더는 INDEX_NAME 으로만 걸러 세고, 로컬 인덱스의
$T0> #   파티션 헤더 이름(__SYS_PART_IDX_ID_<n>)은 쳐다보지 않는다.
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 원본에 있고 여기 없는 것 -- 엔트리 목록
$T0> # ---------------------------------------------------------------------
$T0> # 원본의 넷째 줄(select * from "$_TEMP")은 인덱스가 담은 키를 줄 단위로
$T0> # 찍었다. 네이티브 b-tree 의 내용은 SQL 로 볼 수 없고, 내용을 재는 유일한
$T0> # 건전한 방법은 **힌트로 그 인덱스를 태운 스캔과 풀스캔의 차집합 + 플랜
$T0> # 증거**다(include/checkGlobalIndex.i 의 세 겹). 그것은 테이블 이름과
$T0> # 술어를 알아야 하는데 DESC_INDEX 는 인덱스 이름 하나만 받는다.
$T0> # 그래서 내용 검사는 원본이 그것을 두었던 자리에 그대로 둔다 --
$T0> # 이 배치의 파티션 DDL 여섯 케이스가 INCLUDE 하는 check_global_index.i 다
$T0> # (원본의 그 검사는 _PROWID 때문에 한 번도 돈 적이 없다. 이식본은 돈다).
$T0> # 수와 판정은 v4-natc-port-3.md 3.4.
$T0> ###########################################################################

$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - DDL/ 픽스처의 정합성 검사 (배치 5)
$T0> #
$T0> # 원본 DDL/check_global_index.i 를 대신한다. 원본과 **같은 이름, 같은 인자**
$T0> # 의 DEF 셋(PREPARE_ / FINALIZE_CHECK_GLOBAL_INDEX, CHECK_GLOBAL_INDEX)만
$T0> # 정의하므로, 이 배치 파티션 DDL 여섯 케이스의 CALL 자리는 원본과 바이트
$T0> # 동일하게 남는다.
$T0> #
$T0> #   add_partition  coalesce_partition  drop_partition
$T0> #   merge_partition  split_partition  truncate_partition
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 원본은 이식할 수 없고, 무엇보다 한 번도 돈 적이 없다
$T0> # ---------------------------------------------------------------------
$T0> # 원본은 파티션별 SELECT 와 숨김 테이블 "$GIT_T1_PK" 등을 FULL OUTER JOIN
$T0> # 해서 한쪽에만 있는 행을 찾았다. 이식이 막히는 이유는 둘이다.
$T0> #
$T0> #   1. 조인할 테이블이 없다. 네이티브 b-tree 의 내용은 SQL 로 볼 수 없다.
$T0> #   2. 힙 쪽 SELECT 가 cast(_prowid as bigint) 를 쓴다. 디스크 테이블은
$T0> #      _PROWID 를 지원하지 않아 원본 .lst 의 그 자리가 전부
$T0> #      [ERR-31385 : _PROWID is not supported.] 로 굳어 있다.
$T0> #      basic/ 과 bugs/function_index 가 겪은 것과 같은 병이다
$T0> #      (v3-natc-port.md 3.1).
$T0> #
$T0> # 그래서 목적(트리와 힙이 일치하는가)만 이어받고 방법은
$T0> # include/checkGlobalIndex.i 와 같은 세 겹으로 새로 세운다. 그 파일을
$T0> # 그대로 쓰지 못하는 이유는 픽스처가 다르기 때문이다 -- 그쪽은 basic/ 의
$T0> # t1(i1..i4) + idx1..idx5 를, 이쪽은 DDL/ 의 t1 + t1_pk/t1_uk/t1_idx1/
$T0> # t1_idx3 을 검사한다. 공유 파일을 고치면 그것을 INCLUDE 한 배치 1 의 14
$T0> # 개 .lst 가 전부 움직이므로(ATC 는 INCLUDE 를 주석까지 전사에 인라인한다)
$T0> # 확장은 언제나 형제 파일에 둔다.
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ 픽스처 -- 여섯 케이스가 공유한다
$T0> # ---------------------------------------------------------------------
$T0> #   t1 : partition by {hash|range|list}(i1), 컬럼은 i1..i4 또는 i1..i6
$T0> #   t1_idx1(i1)        LOCAL 키워드 없음 -> 글로벌. 파티션 키를 담아도 그렇다
$T0> #   t1_idx2(i2) local  로컬 (검사 대상 아님 -- 대조군)
$T0> #   t1_idx3(i2,i3,i4)  글로벌
$T0> #   t1_pk  : (i3) 또는 (i3,i4)   글로벌, 유니크
$T0> #   t1_uk  : (i4) 또는 (i5,i6)   글로벌, 유니크
$T0> #
$T0> # 술어는 i1..i4 만 쓴다. 여섯 케이스의 앞 섹터는 i4 까지만 있고 뒤 섹터가
$T0> # i6 까지 있는데, 0-인자 DEF 한 벌이 양쪽에서 그대로 펼쳐져야 하기 때문이다.
$T0> # t1_uk 가 (i5,i6) 인 섹터에서 i4 술어는 키 레인지가 아니라 필터가 되지만,
$T0> # 힌트가 인덱스를 잡았다는 사실은 겹 3(플랜 증거)이 줄 단위로 남긴다.
$T0> #
$T0> # ---------------------------------------------------------------------
$T0> # ★ t1_idx1 의 술어는 파티션 키다 -- J19b 를 여기서 되받는다
$T0> # ---------------------------------------------------------------------
$T0> # 넷 모두 자기 선두 키에 "<col> is not null or <col> is null" 을 건다.
$T0> # t1_idx1 의 키는 i1 이고 그것이 **파티션 키**여서, 이 OR 체인은 DNF 로
$T0> # 갈라져 가지마다 qmgPARTITION 그래프가 서고 가지마다 파티션 집합을
$T0> # 프루닝한다 -- J19b 가 고친 바로 그 자리다(가지들이 그래프 공용
$T0> # qmsTableRef::partitionRef 를 나눠 써서 makePlan 시점에 마지막 가지의
$T0> # 집합만 남았다).
$T0> #
$T0> # 이 잡의 앞선 회차는 J19b 가 열려 있어 여기서 100 행 중 33 행을 받았고
$T0> # (해시 3 파티션에서 실측), 틀린 답을 기대로 굳히지 않으려고 술어를 i2 로
$T0> # 피해 두었다. J19b 가 닫혔으므로(altibase 1144df58) 술어를 원래 자리인
$T0> # i1 로 되돌린다. 그래서 이 여섯 케이스는 파티션 DDL 이 지나간 뒤의
$T0> # 글로벌 트리를 **파티션 키 OR 체인으로** 훑는다 -- 공식 스위트 안에서
$T0> # J19b 의 회귀를 되받는 유일한 자리다. 감시자 쪽 대응물은
$T0> # global-partfilter-check.sh G 절이다.
$T0> ###########################################################################

$T0> #
$T0> # 인덱스 하나를 세 겹으로 검사한다.
$T0> #
$T0> # @aTable : 테이블 이름
$T0> # @aIndex : 검사할 인덱스 이름
$T0> # @aPred  : 그 인덱스를 태울 술어. 전 행(널 포함)을 덮어야 한다.
$T0> #
$T0> # ★ 겹 3(플랜 증거)이 없으면 겹 1 은 "풀스캔 minus 풀스캔"이라 무조건
$T0> #   0 행이다 -- 원본이 빠진 함정의 다른 얼굴이므로 먼저 남긴다.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/DDL/split_partition.tc
$T0> #
$T0> # Body below is byte-identical to the original. What this port adds is the
$T0> # premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
$T0> # the value into the transcript, so the case states what it measures
$T0> # instead of inheriting it (F07 -- see include/globalIndexEnv.i).
$T0> #
$T0> # Project ID           = Native Global Index (disk) - PROJ-1624 port
$T0> ###########################################################################

$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> set linesize 200;
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop tablespace data1 including contents and datafiles;
$T0> drop tablespace data2 including contents and datafiles;
$T0> SKIP END;

$T0> create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
Create success.
$T0> create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
Create success.
$T0> # 원본은 여기서 get_oid 를 만들었다. 위와 같은 이유로 필요 없다.
$T0> set linesize 200;

$T0> ##################################
$T0> # SECTOR; RANGE PARTITION
$T0> ##################################


$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (50),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 select level, level, level, level from dual connect by level <= 100;
100 rows inserted.

$T0> create index t1_idx1 on t1(i1);
Create success.
$T0> create index t1_idx2 on t1(i2) local;
Create success.
$T0> create index t1_idx3 on t1(i2,i3,i4);
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i3);
Alter success.
$T0> alter table t1 add constraint t1_uk unique (i4);
Alter success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     NOT NULL
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_PK                                    BTREE    UNIQUE        I3 ASC
T1_UK                                    BTREE    UNIQUE        I4 ASC
T1_IDX1                                  BTREE                  I1 ASC
T1_IDX2                                  BTREE                  I2 ASC
T1_IDX3                                  BTREE                  I2 ASC,
                                                                I3 ASC,
                                                                I4 ASC
[ PRIMARY KEY ]                                                 
------------------------------------------------------------------------------
I3
$T0> # 겹 0 -- 숨김 테이블 없음
$T0> select count(case when table_name = '$GIT_T1_PK' then 1 end) this_git_table,
         count(*) any_git_table
  from system_.sys_tables_
  where table_name like '$GIT!_%' escape '!'
    and user_id = user_id();
THIS_GIT_TABLE       ANY_GIT_TABLE        
---------------------------------------------
0                    0                    
1 row selected.

$T0> # 겹 1 -- 인덱스의 정체
$T0> select cast(i.index_name as varchar(41)) index_name,
         cast(t.table_name as varchar(10)) table_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         cast(i.is_unique as varchar(1)) uq,
         cast(s.name as varchar(20)) index_tbs
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
