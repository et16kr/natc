$T0> create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by list(i1)
(
  partition p1 values (1,2,3,4,5,6,7,8,9),
  partition pd values default
)
tablespace sys_tbs_disk_data;
