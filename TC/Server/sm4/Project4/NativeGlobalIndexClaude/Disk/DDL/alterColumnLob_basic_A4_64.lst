 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
--###########################################################################
--# ported from qp4/Project3/PROJ-1624-GlobalIndex/PROJ-1624-QC/PDT/Design/ALTER_TABLE/ALTER_COLUMN_LOB/basic.sql
--#
--# Body below is byte-identical to the original. The one line this port
--# adds is the premise: the original measures these statements on the
--# $GIT_ hidden-table implementation, this file measures the same
--# statements on the native global index (F07 -- see include/pinNative.sql).
--###########################################################################
--###########################################################################
--# NativeGlobalIndexPort1624 - the premise of every ported .sql case.
--#
--# A .sql case cannot CALL a DEF the way a .tc case calls PIN_DISK_NATIVE(),
--# so the same two statements are pulled in per case with ATC's own include
--# directive:
--#
--#     --+LOAD_SQL <relative path>/include/pinNative.sql;
--#
--# ATC inlines this file into the case transcript between BEGIN/END markers,
--# which is exactly what F07 asks for: the case states its own premise at the
--# head of its own transcript instead of inheriting whatever the instance
--# happens to be configured with.
--#
--#     DISK_GLOBAL_INDEX_ENABLE = 1  -> native  (this suite)
--#     DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_   (the original suite)
--#
--# The readout below is not decoration. It is the tooth: if the property is
--# ever 0 when a case runs, this one line differs and the case is red before
--# it has measured anything, instead of quietly measuring the other
--# implementation (disk-natc.md 6 records nine assertions that drifted that
--# way).
--#
--# ASCII only, on purpose: 87 of the ported case bodies are EUC-KR and their
--# bytes must stay untouched, so nothing this port adds may introduce a
--# second encoding into a transcript.
--###########################################################################

$P0> ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$P0> SELECT CAST(VALUE1 AS VARCHAR(10)) DISK_GLOBAL_INDEX_ENABLE
     FROM V$PROPERTY WHERE NAME = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

--###################################################################
--# ALTER TABLE ... ALTER COLUMN LOB
--###################################################################

--###################################################################
--+SECTOR 1; PREPARATION
--###################################################################

--+SKIP BEGIN; 
$P0> DROP TABLE T1;
--+SKIP END; 

$P0> CREATE TABLE T1( I1 INTEGER, I2 CLOB DEFAULT 'DEFAULT', I3 BLOB )
     PARTITION BY RANGE (I1)
     (
         PARTITION P1 VALUES LESS THAN (2),
         PARTITION P2 VALUES LESS THAN (3),
         PARTITION P3 VALUES LESS THAN (4),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$P0> INSERT INTO T1 VALUES ( 1, 'CLOB1', 'FF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 2, 'CLOB2', 'FFFF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 3, 'CLOB3', 'FFFFFF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 4, 'CLOB4', 'FFFFFFFF' );
1 row inserted.
$P0> INSERT INTO T1 VALUES ( 5, 'CLOB5', 'FFFFFFFFFF' );
1 row inserted.

--#########################################################################
--+SECTOR 2; BASIC TEST
--#########################################################################
---------------------------------------------------
-- 문법 체크
---------------------------------------------------
-- should be fail
$P0> ALTER TABLE T1 ALTER COLUMN LOB STORE AS ( LOGGING )
     (
         PARTITION P1,
         PARTITION P2
     );
[ERR-31001 : SQL syntax error 

line 3: parse error
         PARTITION P1,
                     ^

]

-- should be fail
$P0> ALTER TABLE T1 ALTER COLUMN LOB STORE AS ( LOGGING )
     (
         PARTITION P1 LOB STORE AS ( TABLESPACE SYS_TBS_DISK_DATA ),
         PARTITION P2 LOB STORE AS ( LOGGING BUFFER )
     );
[ERR-31001 : SQL syntax error ]

-- should be fail
$P0> ALTER TABLE T1 ALTER COLUMN LOB STORE AS ( LOGGING )
     (
         PARTITION P1 LOB STORE AS ( BUFFER LOGGING BUFFER ),
         PARTITION P2 LOB STORE AS ( LOGGING BUFFER )
     );
[ERR-31242 : Only one BUFFER or NOBUFFER clause may be specified.]

-- should be fail
$P0> ALTER TABLE T1 ALTER COLUMN
     (
         PARTITION P1 LOB STORE AS ( BUFFER LOGGING BUFFER ),
         PARTITION P2 LOB STORE AS ( LOGGING BUFFER )
     );
[ERR-31001 : SQL syntax error 

line 3: missing or invalid syntax
         PARTITION P1 LOB STORE AS ( BUFFER LOGGING BUFFER ),
         ^       ^

]


---------------------------------------------------
-- 파티션드 테이블인지 체크
---------------------------------------------------
--+SKIP BEGIN; 
$P0> DROP TABLE TEST;
--+SKIP END; 

$P0> CREATE TABLE TEST ( I1 INTEGER, I2 BLOB );
Create success.

-- should be fail
$P0> ALTER TABLE TEST ALTER COLUMN LOB STORE AS ( LOGGING )
     (
         PARTITION P1 LOB STORE AS ( BUFFER ),
         PARTITION P2 LOB STORE AS ( LOGGING )
     );
[ERR-31268 : Unable to alter table partition on non-partitioned table]

--+SKIP BEGIN; 
$P0> DROP TABLE TEST;
--+SKIP END; 

---------------------------------------------------
-- 해당 파티션이 존재하는지 체크
---------------------------------------------------
-- should be fail
$P0> ALTER TABLE T1 ALTER COLUMN LOB STORE AS ( LOGGING )
     (
         PARTITION P1 LOB STORE AS ( BUFFER ),
         PARTITION P5 LOB STORE AS ( LOGGING ),
         PARTITION P3 LOB STORE AS ( LOGGING )
     );
[ERR-3125B : The table partition does not exist. 
0004 :          PARTITION P5 LOB STORE AS ( LOGGING ),
                         ^ ^
]



