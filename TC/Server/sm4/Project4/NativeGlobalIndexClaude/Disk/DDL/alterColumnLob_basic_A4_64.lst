$P0> ALTER TABLE T1 ALTER COLUMN LOB(I2) STORE AS ( LOGGING );
Alter success.
-- (P1,T,T),(P1,T,T),(P2,T,T),(P2,T,T),(P3,T,T),(P3,T,T),(P4,T,T),(P4,T,T)
$P0> SELECT PART.PARTITION_NAME, LOBS.LOGGING, LOBS.BUFFER
     FROM SYSTEM_.SYS_TABLES_ TAB, SYSTEM_.SYS_PART_LOBS_ LOBS,
          SYSTEM_.SYS_TABLE_PARTITIONS_ PART
     WHERE TAB.TABLE_ID = LOBS.TABLE_ID AND
           TAB.TABLE_NAME = 'T1' AND PART.PARTITION_ID = LOBS.PARTITION_ID
     ORDER BY PART.PARTITION_NAME, LOBS.COLUMN_ID;
