$T0> ##################################
$T0> SECTOR 4; C -- ★ 답은 무사하다. 잃는 것은 공간이지 정합성이 아니다
$T0> ##################################
$T0> select case
             when ( select /*+ FULL SCAN(NGD_O11) */ count(*) from NGD_O11 )
                = ( select /*+ index(NGD_O11, NGD_O11_G) */ count(k)
                      from NGD_O11 where k is not null )
             then 'OK' else 'NG'
           end as answer_tree_equals_heap
      from dual;
