2 rows selected.

$T0> insert into ngd_fkc2 values ( 3, 300 );
[ERR-31077 : The parent record was not found for NGD_FKC2_FK.]

$T0> # 부모의 유일성이 파티션을 가로질러 서는가 -- 부모가 글로벌인 증거다.
$T0> insert into ngd_fkp2 values ( 900, 100, 'DUP' );
[ERR-11058 : The row already exists in a unique index.]

$T0> delete from ngd_fkp2 where i2 = 100;
[ERR-31076 : Unable to modify records that have child records. Check the referential constraints. NGD_FKC2_FK]

$T0> ##################################
$T0> SECTOR 6; F -- 부모의 파티션 DDL 이 참조를 깨지 않는가
$T0> ##################################
$T0> # 파티션 DDL 은 글로벌 트리를 다시 세운다. 다시 세운 트리로 FK 검사가
$T0> # 계속 서야 한다.
$T0> alter table ngd_fkp2 split partition pd at ( 1000 ) into
        ( partition p2, partition pd );
Alter success.

$T0> select i.index_name,
           decode( p.partition_type, 101, 'NATIVE', 'LOCAL-OR-OTHER' ) as impl,
           decode( i.index_table_id, 0, 'NO-GIT', 'GIT' ) as hidden
      from system_.sys_part_indices_ p, system_.sys_indices_ i,
           system_.sys_tables_ t
     where p.index_id = i.index_id
       and i.table_id = t.table_id
       and t.table_name = 'NGD_FKP2'
     order by 1;
