$T0> insert into ngd_fkp2 values ( 500, 200, 'B' );
1 row inserted.
$T0> commit;
Commit success.

$T0> create table ngd_fkc2( c1 integer, c2 integer ) tablespace sys_tbs_disk_data;
Create success.
$T0> alter table ngd_fkc2 add constraint ngd_fkc2_fk foreign key ( c2 )
        references ngd_fkp2 ( i2 );
Alter success.

$T0> insert into ngd_fkc2 values ( 1, 100 );
1 row inserted.
$T0> insert into ngd_fkc2 values ( 2, 200 );
1 row inserted.
$T0> commit;
