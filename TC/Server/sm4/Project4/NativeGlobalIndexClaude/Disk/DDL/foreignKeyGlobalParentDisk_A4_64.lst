$T0> # F1. DDL 뒤에도 참조되는 부모는 못 지운다.
$T0> delete from ngd_fkp2 where i2 = 200;
[ERR-31076 : Unable to modify records that have child records. Check the referential constraints. NGD_FKC2_FK]

$T0> # F2. DDL 뒤에도 없는 값은 참조할 수 없다.
$T0> insert into ngd_fkc2 values ( 4, 400 );
[ERR-31077 : The parent record was not found for NGD_FKC2_FK.]

$T0> # F3. DDL 뒤에도 있는 값은 참조할 수 있다.
$T0> insert into ngd_fkc2 values ( 5, 100 );
1 row inserted.
$T0> commit;
Commit success.
$T0> select c1, c2 from ngd_fkc2 order by c1;
C1          C2          
---------------------------
1           100         
2           200         
5           100         
3 rows selected.

$T0> # F4. DDL 뒤에도 부모의 유일성이 파티션을 가로질러 선다.
