###########################################################################
# TestCase Description = Purge physical leaves and preserve live TBK counts.
# Project ID = Native Global Index
# Manuals: docs/manuals/altibase/trunk/eng/iSQL User's Manual.md
#          docs/manuals/altibase/trunk/eng/Performance Tuning Guide.md
# Empty-build statistics must not hide leaves populated later. A DEAD TBK
# has already left TBK_COUNT before partition purge physically removes it.
# The internal CTS property creates TBK keys; no fault injection is used.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    SKIP BEGIN;
    DROP TABLE NG_D_PURGE;
    SKIP END;
    ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 1;

SECTOR; EMPTY BUILD AND DEAD TBK
    CREATE TABLE NG_D_PURGE(P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN(10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NG_D_PURGE_I ON NG_D_PURGE(K) INITRANS 2 MAXTRANS 2;
    ALTER SYSTEM SET __DISABLE_TRANSACTION_BOUND_IN_CTS = 1;
    INSERT INTO NG_D_PURGE VALUES(1,101);
    INSERT INTO NG_D_PURGE VALUES(2,102);
    INSERT INTO NG_D_PURGE VALUES(11,111);
    ALTER SYSTEM SET __DISABLE_TRANSACTION_BOUND_IN_CTS = 0;
    DELETE FROM NG_D_PURGE WHERE P=1;

    # Let the oldest disk view advance before reusing the delete CTS.
    # The visible DEAD_TBK precondition below must be 1; elapsed time alone
    # is not accepted as evidence that the key reached DEAD.
    NODISPLAY ON;
    SLEEP 1;
    NODISPLAY OFF;
    INSERT INTO NG_D_PURGE VALUES(12,112);
    INSERT INTO NG_D_PURGE VALUES(13,113);
    INSERT INTO NG_D_PURGE VALUES(14,114);
    SELECT COUNT(*) AS DEAD_TBK FROM D$DISK_INDEX_BTREE_KEY(NG_D_PURGE_I)
     WHERE IS_LEAF='T' AND TB_TYPE='K' AND STATE='D';
    SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END AS HAS_LIVE_TBK
      FROM D$DISK_INDEX_BTREE_KEY(NG_D_PURGE_I)
     WHERE IS_LEAF='T' AND TB_TYPE='K' AND STATE<>'D';
    ALTER TABLE NG_D_PURGE DROP PARTITION P1;
    SELECT COUNT(*) AS PHYSICAL_KEYS FROM D$DISK_INDEX_BTREE_KEY(NG_D_PURGE_I)
     WHERE IS_LEAF='T';
    SELECT COUNT(*) AS DEAD_KEYS FROM D$DISK_INDEX_BTREE_KEY(NG_D_PURGE_I)
     WHERE IS_LEAF='T' AND STATE='D';
    SELECT COUNT(*) AS BAD_TBK_COUNTS
      FROM D$DISK_INDEX_BTREE_STRUCTURE(NG_D_PURGE_I) S
     WHERE S.IS_LEAF='T' AND S.TBK_COUNT <>
           (SELECT COUNT(*) FROM D$DISK_INDEX_BTREE_KEY(NG_D_PURGE_I) K
             WHERE K.MY_PAGEID=S.MY_PAGEID AND K.IS_LEAF='T'
               AND K.TB_TYPE='K' AND K.STATE<>'D');
    SELECT /*+ INDEX(NG_D_PURGE,NG_D_PURGE_I) */ P,K
      FROM NG_D_PURGE WHERE K>=0 ORDER BY K;
    DROP TABLE NG_D_PURGE;

SECTOR; NULL KEYS BEFORE STATISTICS MINIMUM
    CREATE TABLE NG_D_PURGE(P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN(10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_DISK_DATA;
    INSERT INTO NG_D_PURGE SELECT 1,NULL FROM DUAL CONNECT BY LEVEL<=3000;
    INSERT INTO NG_D_PURGE VALUES(11,111);
    CREATE INDEX NG_D_PURGE_I ON NG_D_PURGE(K);
    ALTER TABLE NG_D_PURGE DROP PARTITION P1;
    SELECT COUNT(*) AS LIVE_PHYSICAL_KEYS FROM D$DISK_INDEX_BTREE_KEY(NG_D_PURGE_I)
     WHERE IS_LEAF='T' AND STATE<>'D';
    SELECT /*+ INDEX(NG_D_PURGE,NG_D_PURGE_I) */ P,K
      FROM NG_D_PURGE WHERE K>=0 ORDER BY K;

SECTOR; FINALIZATION
    DROP TABLE NG_D_PURGE;
    ALTER SYSTEM SET __DISABLE_TRANSACTION_BOUND_IN_CTS = 0;
    ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 0;
}
