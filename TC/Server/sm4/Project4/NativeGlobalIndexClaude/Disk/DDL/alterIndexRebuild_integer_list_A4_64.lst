FROM PDT_LIST PARTITION( P2 );
COUNT                
-----------------------
2                    
1 row selected.
$T0> ## should be 2
$T0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P3 );
COUNT                
-----------------------
2                    
1 row selected.
$T0> ## should be 2
$T0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P4 );
COUNT                
-----------------------
2                    
1 row selected.

$T0> ALTER INDEX IDX1 REBUILD;
Alter success.

$T0> ## should be 2
$T0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P1 );
COUNT                
-----------------------
2                    
1 row selected.
$T0> ## should be 2
$T0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P2 );
COUNT                
-----------------------
2                    
1 row selected.
$T0> ## should be 2
$T0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P3 );
COUNT                
-----------------------
2                    
1 row selected.
$T0> ## should be 2
$T0> SELECT /*+ INDEX ASC ( PDT_LIST, IDX1 ) */ COUNT(*)
FROM PDT_LIST PARTITION( P4 );
COUNT                
