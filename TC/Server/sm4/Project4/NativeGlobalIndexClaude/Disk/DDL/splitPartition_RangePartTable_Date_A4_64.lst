         PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-07-01','YYYY-MM-DD') ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$P0> ALTER SESSION SET DEFAULT_DATE_FORMAT='YYYY-MM-DD';
Alter success.

-- should be fail
$P0> ALTER TABLE T1 SPLIT PARTITION P1 AT ( TO_DATE('2007-04-01') )
     INTO
     (
         PARTITION P1_1,
         PARTITION P1_2
     );
Alter success.



