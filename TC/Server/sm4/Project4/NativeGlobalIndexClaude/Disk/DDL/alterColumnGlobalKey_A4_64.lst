$T0> ##################################
$T0> SECTOR 2; A -- ★ MODIFY COLUMN 이 글로벌 키 컬럼에 (O-3 의 표적)
$T0> ##################################
$T0> # O-3 은 여기서 IDE_ASSERT 로 죽고 부팅 루프에 들어갔다. 지금은 문장이
$T0> # 성공해야 하고, 성공한 뒤의 트리가 온전해야 한다.
$T0> alter table ngd_acg modify column ( i2 varchar(100) );
Alter success.

