    (
      select /*+ index(ngd_acg, ngd_acg_g) */ i1, i2 from ngd_acg where i2 is not null
      minus
      select /*+ FULL SCAN(ngd_acg) */ i1, i2 from ngd_acg where i2 is not null
    ) order by 1;
I1          I2                    
-------------------------------------
No rows selected.

