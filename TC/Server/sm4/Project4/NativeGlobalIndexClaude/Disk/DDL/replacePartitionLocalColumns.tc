###########################################################################
# TestCase Description = REPLACE restores table and LOCAL index column IDs together.
# SQL/iSQL: docs/manuals/altibase/trunk/eng/iSQL User's Manual.md
# Hints: docs/manuals/altibase/trunk/eng/Performance Tuning Guide.md
# Composite descending keys retain their physical column order across rollback.
###########################################################################
INCLUDE stdFunc.i;

DEF checkRows(@aGlobal)
{
    SELECT /*+ INDEX(NG_D_COL_T,NG_D_COL_T_L) */ P,K,V FROM NG_D_COL_T WHERE K>=0 ORDER BY P;
    SELECT /*+ INDEX(NG_D_COL_T,NG_D_COL_T_V) */ P,K,V FROM NG_D_COL_T WHERE V>=0 ORDER BY P;
    SELECT /*+ FULL SCAN(NG_D_COL_T) */ P,K,V FROM NG_D_COL_T ORDER BY P;
    IF ( @aGlobal == 1 )
    {
        SELECT /*+ INDEX(NG_D_COL_T,NG_D_COL_T_G) */ P,K,V FROM NG_D_COL_T WHERE K>=0 ORDER BY P;
    }
    SELECT /*+ INDEX(NG_D_COL_S,NG_D_COL_S_L) */ P,K,V FROM NG_D_COL_S WHERE K>=0 ORDER BY P;
    SELECT /*+ INDEX(NG_D_COL_S,NG_D_COL_S_V) */ P,K,V FROM NG_D_COL_S WHERE V>=0 ORDER BY P;
    SELECT /*+ FULL SCAN(NG_D_COL_S) */ P,K,V FROM NG_D_COL_S ORDER BY P;
    IF ( @aGlobal == 1 )
    {
        SELECT /*+ INDEX(NG_D_COL_S,NG_D_COL_S_G) */ P,K,V FROM NG_D_COL_S WHERE K>=0 ORDER BY P;
    }
}

DEF MAIN()
{
SECTOR; INITIALIZATION
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NG_D_COL_T;
    DROP TABLE NG_D_COL_S;
    SKIP END;

SECTOR; PREPARATION
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    ALTER SESSION SET TRANSACTIONAL_DDL = 1;
    ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 1;
    ALTER SYSTEM SET GLOBAL_INDEX_EXCHANGE_REMAP = 1;

SECTOR; LOCAL COLUMN ID ROLLBACK WITH NATIVE GLOBAL INDEXES
    FOR $sGlobal IN 0 1
    {
        PRINT "GLOBAL INDEX = ${sGlobal}";
        CREATE TABLE NG_D_COL_T(P INTEGER,K INTEGER,V INTEGER)
        PARTITION BY RANGE(P)
        (PARTITION P1 VALUES LESS THAN(10),PARTITION PD VALUES DEFAULT)
        TABLESPACE SYS_TBS_DISK_DATA;
        INSERT INTO NG_D_COL_T VALUES(1,101,1101);
        INSERT INTO NG_D_COL_T VALUES(2,102,1102);
        INSERT INTO NG_D_COL_T VALUES(11,111,1111);
        CREATE INDEX NG_D_COL_T_L ON NG_D_COL_T(K DESC,P) LOCAL;
        CREATE INDEX NG_D_COL_T_V ON NG_D_COL_T(V) LOCAL;
        IF ( $sGlobal == 1 )
        {
            CREATE UNIQUE INDEX NG_D_COL_T_G ON NG_D_COL_T(K);
        }
        CREATE TABLE NG_D_COL_S(P INTEGER,K INTEGER,V INTEGER)
        PARTITION BY RANGE(P)
        (PARTITION P1 VALUES LESS THAN(10),PARTITION PD VALUES DEFAULT)
        TABLESPACE SYS_TBS_DISK_DATA;
        INSERT INTO NG_D_COL_S VALUES(1,901,1901);
        INSERT INTO NG_D_COL_S VALUES(2,902,1902);
        INSERT INTO NG_D_COL_S VALUES(11,911,1911);
        CREATE INDEX NG_D_COL_S_L ON NG_D_COL_S(K DESC,P) LOCAL;
        CREATE INDEX NG_D_COL_S_V ON NG_D_COL_S(V) LOCAL;
        IF ( $sGlobal == 1 )
        {
            CREATE UNIQUE INDEX NG_D_COL_S_G ON NG_D_COL_S(K);
        }
        AUTOCOMMIT OFF;
        CALL checkRows($sGlobal);
        SAVEPOINT S0;
        ALTER TABLE NG_D_COL_T REPLACE NG_D_COL_S PARTITION P1;
        CALL checkRows($sGlobal);
        SAVEPOINT S1;
        UPDATE NG_D_COL_T SET K=K+100,V=V+1 WHERE P=1;
        CALL checkRows($sGlobal);
        ROLLBACK TO SAVEPOINT S1;
        CALL checkRows($sGlobal);
        ROLLBACK TO SAVEPOINT S0;
        CALL checkRows($sGlobal);
        UPDATE NG_D_COL_T SET K=K+100,V=V+1 WHERE P=1;
        CALL checkRows($sGlobal);
        ROLLBACK;
        CALL checkRows($sGlobal);
        ALTER TABLE NG_D_COL_T REPLACE NG_D_COL_S PARTITION P1;
        ROLLBACK;
        CALL checkRows($sGlobal);
        ALTER TABLE NG_D_COL_T REPLACE NG_D_COL_S PARTITION P1;
        COMMIT;
        CALL checkRows($sGlobal);
        AUTOCOMMIT ON;
        DROP TABLE NG_D_COL_T;
        DROP TABLE NG_D_COL_S;
    }

SECTOR; CLEANUP
    ALTER SESSION SET TRANSACTIONAL_DDL = 0;
    ALTER SYSTEM SET GLOBAL_INDEX_EXCHANGE_REMAP = 10;
    ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 0;
}
