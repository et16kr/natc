1 row selected.

$T0> # ★ 판정 -- 중복 위에 유일 트리를 세울 수 없으므로 **정직하게 실패**해야
$T0> #   한다. 조용히 성공하고 트리가 비면 그것이 결함이다.
$T0> alter table ngd_aix_u all index enable;
[ERR-11058 : The row already exists in a unique index.]

$T0> # 실패했으므로 카탈로그는 그대로다. 이 두 줄이 그 상태를 전사에 남긴다.
$T0> select i.index_name,
           decode( p.partition_type, 101, 'NATIVE', 'LOCAL-OR-OTHER' ) as impl,
           decode( i.index_table_id, 0, 'NO-GIT', 'GIT' ) as hidden
      from system_.sys_part_indices_ p, system_.sys_indices_ i,
           system_.sys_tables_ t
     where p.index_id = i.index_id
       and i.table_id = t.table_id
       and t.table_name = 'NGD_AIX_U'
     order by 1;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
IMPL            HIDDEN  
---------------------------
NGD_AIX_U_G                                                                                                                       
NATIVE          NO-GIT  
1 row selected.
$T0> select count(*) as heap_after_failed_enable from ngd_aix_u;
HEAP_AFTER_FAILED_ENABLE 
---------------------------
3                    
1 row selected.

$T0> # E4. 중복을 걷어 내면 다시 설 수 있어야 한다 -- 회복 경로가 있는가.
$T0> delete from ngd_aix_u where i1 = 500;
1 row deleted.
$T0> commit;
Commit success.
$T0> alter table ngd_aix_u all index enable;
Alter success.

