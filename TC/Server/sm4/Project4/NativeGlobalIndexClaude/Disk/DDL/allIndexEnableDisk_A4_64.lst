$T0> # E3. 이제 되돌릴 수 **없는** 경우. DISABLE 뒤 중복을 넣는다.
$T0> #     머리말의 대조군이 보인 대로, 여기서부터는 글로벌 인덱스의 성질이
$T0> #     아니라 ALL INDEX DISABLE 이라는 문장 자체의 성질이다.
$T0> alter table ngd_aix_u all index disable;
Alter success.
$T0> insert into ngd_aix_u values ( 500, 555 );
1 row inserted.
$T0> commit;
Commit success.
