 
+----------------------------------------------------------------------+
--+SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$P0> --+PROCESS P0;
--###########################################################################
--# ported from qp4/Project3/PROJ-1624-GlobalIndex/PROJ-1624-QC/PDT/Design/ALTER_TABLE/DROP/integer_list.sql
--#
--# Body below is byte-identical to the original. The one line this port
--# adds is the premise: the original measures these statements on the
--# $GIT_ hidden-table implementation, this file measures the same
--# statements on the native global index (F07 -- see include/pinNative.sql).
--###########################################################################
--###########################################################################
--# NativeGlobalIndexPort1624 - the premise of every ported .sql case.
--#
--# A .sql case cannot CALL a DEF the way a .tc case calls PIN_DISK_NATIVE(),
--# so the same two statements are pulled in per case with ATC's own include
--# directive:
--#
--#     --+LOAD_SQL <relative path>/include/pinNative.sql;
--#
--# ATC inlines this file into the case transcript between BEGIN/END markers,
--# which is exactly what F07 asks for: the case states its own premise at the
--# head of its own transcript instead of inheriting whatever the instance
--# happens to be configured with.
--#
--#     DISK_GLOBAL_INDEX_ENABLE = 1  -> native  (this suite)
--#     DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_   (the original suite)
--#
--# The readout below is not decoration. It is the tooth: if the property is
--# ever 0 when a case runs, this one line differs and the case is red before
--# it has measured anything, instead of quietly measuring the other
--# implementation (disk-natc.md 6 records nine assertions that drifted that
--# way).
--#
--# ASCII only, on purpose: 87 of the ported case bodies are EUC-KR and their
--# bytes must stay untouched, so nothing this port adds may introduce a
--# second encoding into a transcript.
--###########################################################################

$P0> ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$P0> SELECT CAST(VALUE1 AS VARCHAR(10)) DISK_GLOBAL_INDEX_ENABLE
     FROM V$PROPERTY WHERE NAME = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

--######################################################
-- DROP PARTITIOIN ( PK:INTEGER )
--######################################################

--###################################
--+SECTOR 1; INTIALIZE
--###################################

--+SKIP BEGIN; 
$P0> DROP TABLE PDT_LIST;
--+SKIP END; 

$P0> CREATE TABLE PDT_LIST
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10 ),
         PARTITION P2 VALUES ( 20 ),
         PARTITION P3 VALUES ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.


--#########################################
--+SECTOR 2; DO JOB #1 (1. Basic Test)
--#########################################

$P0> INSERT INTO PDT_LIST VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 30, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 40, 0 );
1 row inserted.

$P0> SELECT F1 FROM PDT_LIST PARTITION( P1 );
F1          
--------------
10          
1 row selected.
$P0> SELECT F1 FROM PDT_LIST PARTITION( P2 );
F1          
--------------
20          
1 row selected.
$P0> SELECT F1 FROM PDT_LIST PARTITION( P3 );
F1          
--------------
30          
1 row selected.
$P0> SELECT F1 FROM PDT_LIST PARTITION( P4 );
F1          
--------------
40          
1 row selected.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_LIST;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P1;
Alter success.

-- should be [20, 30, 40]
$P0> SELECT F1 FROM PDT_LIST;
F1          
--------------
40          
30          
20          
3 rows selected.

--#########################################
--+SECTOR 3; DO JOB #2 (2. Validation Test)
--#########################################

----------------------------
-- 2.1 최소 파티션 개수 유지
----------------------------
-- should be success
$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P2;
Alter success.
-- should be success
$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P3;
Alter success.
-- should be fail
$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P4;
[ERR-31276 : Cannot drop the only partition from a partitioned table]

--------------------------------------
-- 2.2 기본 파티션 삭제 허용 여부 검사
--------------------------------------
$P0> DROP TABLE PDT_LIST;
Drop success.

$P0> CREATE TABLE PDT_LIST
     (
         F1   INTEGER,
         F2   INTEGER
     ) 
     PARTITION BY LIST( F1 )
     (
         PARTITION P1 VALUES ( 10 ),
         PARTITION P2 VALUES ( 20 ),
         PARTITION P3 VALUES ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.

-- should be fail
$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P4;
[ERR-31277 : Cannot drop the default partition]

--#########################################
--+SECTOR 4; DO JOB #3 (3. Execution Test)
--#########################################

-------------------------------------
-- 3.1 기본 파티션의 파티션 조건 수정
-------------------------------------
$P0> INSERT INTO PDT_LIST VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 30, 0 );
1 row inserted.
$P0> INSERT INTO PDT_LIST VALUES( 40, 0 );
1 row inserted.

$P0> SELECT F1 FROM PDT_LIST PARTITION( P1 );
F1          
--------------
10          
1 row selected.
$P0> SELECT F1 FROM PDT_LIST PARTITION( P2 );
F1          
--------------
20          
1 row selected.
$P0> SELECT F1 FROM PDT_LIST PARTITION( P3 );
F1          
--------------
30          
1 row selected.
$P0> SELECT F1 FROM PDT_LIST PARTITION( P4 );
F1          
--------------
40          
1 row selected.

-- should be 4
$P0> SELECT COUNT(*) FROM PDT_LIST;
COUNT                
-----------------------
4                    
1 row selected.

$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P1;
Alter success.

-- should be 3
$P0> SELECT COUNT(*) FROM PDT_LIST;
COUNT                
-----------------------
3                    
1 row selected.

$P0> INSERT INTO PDT_LIST VALUES( 10, 0 );
1 row inserted.

-- should be 1
$P0> SELECT COUNT(*) FROM PDT_LIST PARTITION( P2 );
COUNT                
-----------------------
1                    
1 row selected.
-- should be 2
$P0> SELECT COUNT(*) FROM PDT_LIST PARTITION( P4 );
COUNT                
-----------------------
2                    
1 row selected.

$P0> ALTER TABLE PDT_LIST
     DROP PARTITION P3;
Alter success.

-- should be 3
$P0> SELECT COUNT(*) FROM PDT_LIST;
COUNT                
-----------------------
3                    
1 row selected.

$P0> INSERT INTO PDT_LIST VALUES( 30, 0 );
1 row inserted.

-- should be 3
$P0> SELECT COUNT(*) FROM PDT_LIST PARTITION( P4 );
COUNT                
-----------------------
3                    
1 row selected.


--###################################
--+SECTOR 5; FINALIZE
--###################################

$P0> DROP TABLE PDT_LIST;
Drop success.

