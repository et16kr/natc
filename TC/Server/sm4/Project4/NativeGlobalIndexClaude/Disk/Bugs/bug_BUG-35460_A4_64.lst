 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 전제와 판별자
$T0> #
$T0> # 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
$T0> # 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
$T0> # 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
$T0> #
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
$T0> #
$T0> # ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
$T0> #   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
$T0> #   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
$T0> #   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
$T0> #   어긋났었다(disk-natc.md 6).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
$T0> #   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
$T0> #   복원이 유일한 방벽이다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고, 세운 값을 전사에 남긴다.
$T0> # 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
$T0> #
$T0> #
$T0> # 인덱스가 어느 구현인지 카탈로그로 판별해 전사에 남긴다.
$T0> #
$T0> #   NATIVE GLOBAL : SYS_PART_INDICES_.PARTITION_TYPE = 101, INDEX_TABLE_ID = 0
$T0> #   LOCAL         : IS_PARTITIONED = 'T', SYS_INDEX_PARTITIONS_ 에 행
$T0> #   $GIT_ GLOBAL  : INDEX_TABLE_ID != 0 (숨김 테이블 OID)
$T0> #
$T0> # ★ 이 절이 이 스위트의 이빨이다. 프로퍼티가 0 이면 CREATE INDEX 로 만든
$T0> #   인덱스가 $GIT_ 로 내려가 KIND 가 통째로 바뀌고, 같은 문장을 재고 있다는
$T0> #   착각이 여기서 깨진다.
$T0> #
$T0> # ★ 원본 fixture 의 T1_PK(i2,i1) / T1_UK(i3,i2,i1) 은 파티션 키 i1 을
$T0> #   포함하므로 두 구현 어느 쪽에서도 글로벌이 아니라 LOCAL 이다. 원본
$T0> #   check_global_index.i 가 "$GIT_T1_PK" 를 조회한 것은 존재하지 않는
$T0> #   테이블을 겨눈 것이었다 -- v3-natc-port.md 3.2.
$T0> #
$T0> #
$T0> # 숨김 테이블이 하나도 없다는 것을 남긴다.
$T0> # 네이티브 경로에서는 $GIT_ 가 만들어지지 않는다.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/bugs/BUG-35460/BUG-35460.tc
$T0> #
$T0> # Body below is byte-identical to the original. What this port adds is the
$T0> # premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
$T0> # the value into the transcript, so the case states what it measures
$T0> # instead of inheriting it (F07 -- see include/globalIndexEnv.i).
$T0> #
$T0> # Project ID           = Native Global Index (disk) - PROJ-1624 port
$T0> ###########################################################################

$T0> ###########################################################################
$T0> # BUG-35460
$T0> ###########################################################################

$T0> set linesize 200;
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################


$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;

$T0> ##################################
$T0> # SECTOR; RANGE PARTITION
$T0> ##################################

$T0> create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i2, i1);
Alter success.
$T0> alter table t1 add constraint t1_uk unique (i3, i2, i1);
Alter success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     NOT NULL
I2                                       INTEGER                     NOT NULL
I3                                       INTEGER                     
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T1_PK                                    BTREE    UNIQUE        I2 ASC,
                                                                I1 ASC
T1_UK                                    BTREE    UNIQUE        I3 ASC,
                                                                I2 ASC,
                                                                I1 ASC
[ PRIMARY KEY ]                                                 
------------------------------------------------------------------------------
I2, I1
$T0> desc "$GIT_T1_PK";
[ERR-91014 : The table ($GIT_T1_PK) does not exist.]
$T0> desc "$GIT_T1_UK";
[ERR-91014 : The table ($GIT_T1_UK) does not exist.]

$T0> ##################################
$T0> # SECTOR; INSERT
$T0> ##################################

$T0> select * from t1;
T1.I1       T1.I2       T1.I3       T1.I4       
-----------------------------------------------------
No rows selected.

$T0> insert into t1 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;
100 rows inserted.

$T0> select count(*) from t1;
COUNT                
-----------------------
100                  
1 row selected.

$T0> select count(*) from "$GIT_T1_PK";
[ERR-31031 : Table or view was not found : 
0001 : select COUNT(*) from "$GIT_T1_PK"
                            ^         ^
]

$T0> select count(*) from "$GIT_T1_UK";
[ERR-31031 : Table or view was not found : 
0001 : select COUNT(*) from "$GIT_T1_UK"
                            ^         ^
]

$T0> ##########################################################################
$T0> # PORT EDIT: make the case measure a global index, and stop measuring the
$T0> #            rest of the suite
$T0> #
$T0> # (1) WHAT WAS WRONG WITH THE EXPECTATION
$T0> #
$T0> # Everything above this line is byte-identical to the original, and on the
$T0> # native path it produces byte-identical RESULTS too -- only the premise
$T0> # line differs. That is not a success, it is the finding: T1_PK(i2,i1) and
$T0> # T1_UK(i3,i2,i1) both carry the partition key i1, so they are LOCAL under
$T0> # BOTH implementations. The original never created a $GIT_ table here, so
$T0> #
$T0> #   desc "$GIT_T1_PK";                    -> [ERR-91014]
$T0> #   select count(*) from "$GIT_T1_PK";    -> [ERR-31031]
$T0> #   ... where table_type = 'G' ...        -> No rows selected.
$T0> #
$T0> # were green for a reason that has nothing to do with what BUG-35460 was
$T0> # about. An error frozen as an expectation goes green when the reason
$T0> # changes; here the reason was wrong from the start (v3-natc-port.md 6.1,
$T0> # and 3.2 for the same mistake in the original's check_global_index.i).
$T0> #
$T0> # So the port adds an index that really is non-prefixed -- T1_IDX_G(i3)
$T0> # does not contain the partition key i1 -- and then asks the question the
$T0> # original meant to ask.
$T0> #
$T0> # (2) WHY THE 'T' LISTING IS NARROWED
$T0> #
$T0> # Original lines 68-70 were these two statements, unqualified:
$T0> #
$T0> #   select table_name from system_.sys_tables_
$T0> #    where table_type = 'T' and user_id = user_id() order by table_id;
$T0> #   select table_name from system_.sys_tables_
$T0> #    where table_type = 'G' and user_id = user_id() order by table_id;
$T0> #
$T0> # The first lists every table SYS has, which makes this case's expectation
$T0> # a function of what the OTHER cases in the suite left behind rather than
$T0> # of what this case did. It really does: six batch-2 cases
$T0> # (Design/CREATE_INDEX/LOCAL_UNIQUE/integer_{hash,range,list}.sql and
$T0> # Design/ALTER_INDEX/REBUILD/integer_{hash,range,list}.tc) CREATE TABLE T
$T0> # and drop it only in their own preamble, never in FINALIZE, so T outlives
$T0> # the suite. The original never noticed: PROJ-1624.ts does not reference
$T0> # PROJ-1624-QC at all, so those cases and this one never ran under one
$T0> # root. The port put them under one root and the leak arrived here.
$T0> #
$T0> # The narrowing keeps exactly the discriminating content -- this case's own
$T0> # table, plus anything named $GIT_ -- and drops the part that was reporting
$T0> # on its neighbours.
$T0> #
$T0> # The 'G' listing is NOT narrowed, on purpose: with the premise pinned to 1
$T0> # no case in this suite can create a hidden table, so "No rows selected"
$T0> # here is a statement about the whole suite and it is stable.
$T0> #
$T0> # TEETH: with DISK_GLOBAL_INDEX_ENABLE = 0 the same CREATE INDEX builds a
$T0> # hidden table, KIND reads GIT-HIDDEN-TABLE, GIT_HIDDEN_TABLE_COUNT reads 1
$T0> # and the table_type = 'G' listing returns $GIT_T1_IDX_G instead of no rows.
$T0> ##########################################################################

$T0> select table_name from system_.sys_tables_ where table_type = 'T' and user_id = user_id() and ( table_name = 'T1' or table_name like '$GIT!_%' escape '!' ) order by table_id;
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
T1                                                                                                                                
1 row selected.

$T0> select table_name from system_.sys_tables_ where table_type = 'G' and user_id = user_id() order by table_id;
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> create index t1_idx_g on t1(i3);
Create success.

$T0> select cast(i.index_name as varchar(20)) index_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         i.index_table_id,
         cast(i.is_partitioned as varchar(1)) is_part,
         nvl(p.partition_type,-1) part_type
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
       ( select index_id, max(partition_type) partition_type
         from system_.sys_part_indices_ group by index_id ) p
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
    and i.index_id = p.index_id(+)
  order by 1;
INDEX_NAME            KIND              INDEX_TABLE_ID IS_PART  PART_TYPE   
----------------------------------------------------------------------------------
T1_IDX_G              NATIVE-GLOBAL     0           F  101         
T1_PK                 LOCAL             0           T  0           
T1_UK                 LOCAL             0           T  0           
3 rows selected.

$T0> select count(*) git_hidden_table_count
  from system_.sys_tables_
  where table_name like '$GIT!_%' escape '!'
    and user_id = user_id();
GIT_HIDDEN_TABLE_COUNT 
-------------------------
0                    
1 row selected.

$T0> select table_name from system_.sys_tables_ where table_type = 'T' and user_id = user_id() and ( table_name = 'T1' or table_name like '$GIT!_%' escape '!' ) order by table_id;
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
T1                                                                                                                                
1 row selected.

$T0> select table_name from system_.sys_tables_ where table_type = 'G' and user_id = user_id() order by table_id;
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> select count(*) from t1 where i3 = 1;
COUNT                
-----------------------
34                   
1 row selected.

$T0> ##########################################################################
$T0> # PORT EDIT END
$T0> ##########################################################################

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################


$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;

