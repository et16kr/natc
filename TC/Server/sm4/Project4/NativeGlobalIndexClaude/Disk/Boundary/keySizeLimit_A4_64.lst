1 row selected.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_G5;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 3; B -- 같은 사다리를 LOCAL 로. 여기가 대조군이다
$T0> ##################################
$T0> # ★ 이 절이 케이스의 뜻을 만든다. A 에서 거절된 폭이 여기서 서면
$T0> #   "글로벌만 상한이 낮다" 가 실측된 것이고, A·B 가 같은 자리에서 갈리면
$T0> #   상한이 인덱스 종류와 무관하다는 뜻이라 셋째 인자가 죽은 코드다.

$T0> CREATE INDEX NGD_KSZ_L1 ON NGD_KSZ ( C1 ) LOCAL;
Create success.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_L1;
$T0> SKIP END;

$T0> CREATE INDEX NGD_KSZ_L2 ON NGD_KSZ ( C2 ) LOCAL;
Create success.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_L2;
$T0> SKIP END;

$T0> CREATE INDEX NGD_KSZ_L3 ON NGD_KSZ ( C3 ) LOCAL;
Create success.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_L3;
$T0> SKIP END;

$T0> CREATE INDEX NGD_KSZ_L4 ON NGD_KSZ ( C4 ) LOCAL;
Create success.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_L4;
$T0> SKIP END;

$T0> CREATE INDEX NGD_KSZ_L5 ON NGD_KSZ ( C5 ) LOCAL;
Create success.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_L5;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 4; C -- 복합 키에서도 같은 경계인가
$T0> ##################################
$T0> # 상한은 키 전체에 걸린다. 좁은 컬럼을 여럿 묶어 같은 선을 넘어 본다 --
$T0> # 단일 컬럼 경로와 복합 경로가 다른 계산을 쓰면 여기서 갈린다.

$T0> CREATE INDEX NGD_KSZ_GC ON NGD_KSZ ( C1, C2 );
Create success.
$T0> SELECT COUNT(*) AS GC_IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGD_KSZ_GC';
GC_IS_NATIVE_GLOBAL  
-----------------------
