Create success.
$T0> SELECT COUNT(*) AS G3_IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGD_KSZ_G3';
G3_IS_NATIVE_GLOBAL  
-----------------------
1                    
1 row selected.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_G3;
$T0> SKIP END;

$T0> CREATE INDEX NGD_KSZ_G4 ON NGD_KSZ ( C4 );
Create success.
$T0> SELECT COUNT(*) AS G4_IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGD_KSZ_G4';
G4_IS_NATIVE_GLOBAL  
-----------------------
