1 row selected.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_GC;
$T0> SKIP END;

$T0> CREATE INDEX NGD_KSZ_GC2 ON NGD_KSZ ( C2, C3, C4 );
[ERR-311E0 : The estimated size of the index key exceeds the maximum limit. estimated 3544, limit 3384 (native global index; non-global limit is 3386)]
$T0> SELECT COUNT(*) AS GC2_IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGD_KSZ_GC2';
GC2_IS_NATIVE_GLOBAL 
-----------------------
0                    
1 row selected.
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_GC2;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 5; D -- 프로퍼티 0 에서는 무엇이라 하는가
$T0> ##################################
$T0> # J24 가 프로퍼티 0 의 뜻을 "은퇴한 구현으로는 만들 수 없다" 로 바꿨다.
$T0> # 그러므로 여기서 나오는 것은 키 길이 오류가 아니라 거절이어야 한다 --
$T0> # 두 거절이 뒤섞이면 사용자가 원인을 못 가른다.
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
0                                                                                                                                                                                                                                                                 
1 row selected.

$T0> CREATE INDEX NGD_KSZ_OFF ON NGD_KSZ ( C1 );
[ERR-314B6 : The hidden index table implementation of a global non-partitioned index has been retired and cannot be used to create NGD_KSZ_OFF.]
$T0> SKIP BEGIN;
$T0> DROP INDEX NGD_KSZ_OFF;
$T0> SKIP END;

$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
