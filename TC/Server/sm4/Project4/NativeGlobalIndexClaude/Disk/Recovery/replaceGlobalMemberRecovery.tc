###########################################################################
# TestCase Description = Restore GLOBAL members after an uncommitted REPLACE and restart.
# Project ID = Native Global Index
# SQL/iSQL: docs/manuals/altibase/trunk/eng/iSQL User's Manual.md
# Hints: docs/manuals/altibase/trunk/eng/Performance Tuning Guide.md
# Requires an exclusive test database and stdFunc.i abort/start lifecycle.
# R5 is currently unresolved. The oracle requires the original rows through
# every access path; ERR-11110 must remain a FAIL, never a passing oracle.
# Registered separately in KnownFailures.ts; no automatic index rebuild.
###########################################################################
INCLUDE stdFunc.i;
DECLARE SERVER DEFAULT DB1;
DECLARE CLIENT DEFAULT C1 ( SERVER = DB1 );
DECLARE CLIENT DEFAULT C2 ( SERVER = DB1 );

DEF MAIN()
{
SECTOR; INITIALIZATION
    THREAD T1 C1
    {
        AUTOCOMMIT ON;
        SKIP BEGIN;
        DROP TABLE NGD_GRCV_T;
        DROP TABLE NGD_GRCV_S;
        SKIP END;
    }
    JOIN;

SECTOR; PREPARATION
    THREAD T1 C1
    {
        ALTER SYSTEM SET DISK_GLOBAL_INDEX_ENABLE = 1;
        ALTER SYSTEM SET GLOBAL_INDEX_EXCHANGE_REMAP = 1;
            CREATE TABLE NGD_GRCV_T(P INTEGER,K INTEGER,V INTEGER)
            PARTITION BY RANGE(P)
            (PARTITION P1 VALUES LESS THAN(10),PARTITION PD VALUES DEFAULT)
            TABLESPACE SYS_TBS_DISK_DATA;
            INSERT INTO NGD_GRCV_T VALUES(1,101,1101);
            INSERT INTO NGD_GRCV_T VALUES(2,102,1102);
            INSERT INTO NGD_GRCV_T VALUES(11,111,1111);
            CREATE INDEX NGD_GRCV_T_L ON NGD_GRCV_T(K DESC,P) LOCAL;
            CREATE INDEX NGD_GRCV_T_V ON NGD_GRCV_T(V) LOCAL;
            CREATE UNIQUE INDEX NGD_GRCV_T_G ON NGD_GRCV_T(K);
            CREATE TABLE NGD_GRCV_S(P INTEGER,K INTEGER,V INTEGER)
            PARTITION BY RANGE(P)
            (PARTITION P1 VALUES LESS THAN(10),PARTITION PD VALUES DEFAULT)
            TABLESPACE SYS_TBS_DISK_DATA;
            INSERT INTO NGD_GRCV_S VALUES(1,901,1901);
            INSERT INTO NGD_GRCV_S VALUES(2,902,1902);
            INSERT INTO NGD_GRCV_S VALUES(11,911,1911);
            CREATE INDEX NGD_GRCV_S_L ON NGD_GRCV_S(K DESC,P) LOCAL;
            CREATE INDEX NGD_GRCV_S_V ON NGD_GRCV_S(V) LOCAL;
            CREATE UNIQUE INDEX NGD_GRCV_S_G ON NGD_GRCV_S(K);
        ALTER SYSTEM CHECKPOINT;
        ALTER SESSION SET TRANSACTIONAL_DDL = 1;
        AUTOCOMMIT OFF;
        ALTER TABLE NGD_GRCV_T REPLACE NGD_GRCV_S PARTITION P1;
    }
    JOIN;
    THREAD T2 C2
    {
        ALTER SYSTEM CHECKPOINT;
    }
    JOIN;

SECTOR; TEST
    NODISPLAY ON;
    CALL stdServerKill();
    CALL stdServerStart();
    NODISPLAY OFF;
    THREAD T2 C2
    {
        RESTART_CLIENT;
    }
    JOIN;
    THREAD T1 C1
    {
        RESTART_CLIENT;
        AUTOCOMMIT ON;
        ALTER SESSION SET EXPLAIN PLAN = OFF;
        SELECT /*+ FULL SCAN(NGD_GRCV_T) */ P,K,V FROM NGD_GRCV_T ORDER BY P;
        SELECT /*+ INDEX(NGD_GRCV_T,NGD_GRCV_T_L) */ P,K,V FROM NGD_GRCV_T WHERE K>=0 ORDER BY P;
        SELECT /*+ INDEX(NGD_GRCV_T,NGD_GRCV_T_V) */ P,K,V FROM NGD_GRCV_T WHERE V>=0 ORDER BY P;
        SELECT /*+ INDEX(NGD_GRCV_T,NGD_GRCV_T_G) */ P,K,V FROM NGD_GRCV_T WHERE K>=0 ORDER BY P;
        SELECT /*+ FULL SCAN(NGD_GRCV_S) */ P,K,V FROM NGD_GRCV_S ORDER BY P;
        SELECT /*+ INDEX(NGD_GRCV_S,NGD_GRCV_S_L) */ P,K,V FROM NGD_GRCV_S WHERE K>=0 ORDER BY P;
        SELECT /*+ INDEX(NGD_GRCV_S,NGD_GRCV_S_V) */ P,K,V FROM NGD_GRCV_S WHERE V>=0 ORDER BY P;
        SELECT /*+ INDEX(NGD_GRCV_S,NGD_GRCV_S_G) */ P,K,V FROM NGD_GRCV_S WHERE K>=0 ORDER BY P;
    }
    JOIN;

SECTOR; FINALIZATION
    THREAD T1 C1
    {
        DROP TABLE NGD_GRCV_T;
        DROP TABLE NGD_GRCV_S;
    }
    JOIN;
    RESTART_CLIENT;
}
