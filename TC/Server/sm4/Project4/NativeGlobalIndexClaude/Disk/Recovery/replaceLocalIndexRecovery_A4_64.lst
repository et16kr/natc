 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Recover uncommitted REPLACE and LOCAL index CREATE/DROP.
$T0> # Project ID = Native Global Index
$T0> # SQL/iSQL: docs/manuals/altibase/trunk/eng/iSQL User's Manual.md
$T0> # Hints: docs/manuals/altibase/trunk/eng/Performance Tuning Guide.md
$T0> # Requires an exclusive test database: abort/restart interrupts every session.
$T0> # Lifecycle contract: stdFunc.i stdServerKill/stdServerStart use the runner's
$T0> # ALTIBASE_HOME and SYSDBA instance; RESTART_CLIENT reconnects C1/C2.
$T0> # SHUTDOWN ABORT exits without transaction cleanup (mmtCmsAdmin).
$T0> # R12/R13/R14: restore rows, old indexes and DML undo; discard the new index.
$T0> ###########################################################################
$T0> DECLARE SERVER DEFAULT DB1;
$T0> DECLARE CLIENT DEFAULT C1 ( SERVER = DB1 );
$T0> DECLARE CLIENT DEFAULT C2 ( SERVER = DB1 );

$T0> SECTOR 0; INITIALIZATION
$T0> THREAD T1 C1
$T0> JOIN;

$T0> SECTOR 1; PREPARATION
$T0> CREATE-before-DROP and DROP-before-CREATE

$T0> SECTOR 2; TEST
$T0> INDEX DDL ORDER = 0
$T0> THREAD T1 C1
$T0> JOIN;
$T0> THREAD T2 C2
$T0> JOIN;
$T0> THREAD T2 C2
$T0> JOIN;
$T0> THREAD T1 C1
$T0> JOIN;
$T0> INDEX DDL ORDER = 1
$T0> THREAD T1 C1
$T0> JOIN;
$T0> THREAD T2 C2
$T0> JOIN;
$T0> THREAD T2 C2
$T0> JOIN;
$T0> THREAD T1 C1
$T0> JOIN;

$T0> SECTOR 3; FINALIZATION
$T0> RESTART_CLIENT;
$T1> AUTOCOMMIT ON;
Set autocommit on success.
$T1> SKIP BEGIN;
$T1> DROP TABLE NGD_RCV_T;
$T1> DROP TABLE NGD_RCV_S;
$T1> SKIP END;
$T1> ALTER SESSION SET EXPLAIN PLAN = OFF;
Alter success.
$T1> CREATE TABLE NGD_RCV_T(P INTEGER,K INTEGER,V INTEGER)
            PARTITION BY RANGE(P)
            (PARTITION P1 VALUES LESS THAN(10),PARTITION PD VALUES DEFAULT)
            TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T1> INSERT INTO NGD_RCV_T VALUES(1,101,1101);
1 row inserted.
$T1> INSERT INTO NGD_RCV_T VALUES(2,102,1102);
1 row inserted.
$T1> INSERT INTO NGD_RCV_T VALUES(11,111,1111);
1 row inserted.
$T1> CREATE INDEX NGD_RCV_T_L ON NGD_RCV_T(K DESC,P) LOCAL;
Create success.
$T1> CREATE INDEX NGD_RCV_T_V ON NGD_RCV_T(V) LOCAL;
Create success.
$T1> CREATE TABLE NGD_RCV_S(P INTEGER,K INTEGER,V INTEGER)
            PARTITION BY RANGE(P)
            (PARTITION P1 VALUES LESS THAN(10),PARTITION PD VALUES DEFAULT)
