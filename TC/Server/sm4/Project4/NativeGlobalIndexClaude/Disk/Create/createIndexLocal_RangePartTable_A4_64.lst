     ( PARTITION IDX1_P1 ON P1,
       PARTITION IDX1_P2 ON P2,
       PARTITION IDX1_P3 ON P3,
       PARTITION IDX1_P4 ON P4 );
Create success.

$P0> DROP INDEX IDX2;
[ERR-31014 : Index not found]
-- should be success
$P0> CREATE INDEX IDX2 ON T1 (I3, I2, I1) LOCAL
     ( PARTITION IDX2_P1 ON P1,
