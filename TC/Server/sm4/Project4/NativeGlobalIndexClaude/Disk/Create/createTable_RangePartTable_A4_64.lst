-- Result: PDT_TBS, PDT_TBS, PDT_TBS, PDT_TBS
$P0> SELECT C.NAME
     FROM SYSTEM_.SYS_TABLE_PARTITIONS_ A, SYSTEM_.SYS_TABLES_ B, V$TABLESPACES C
     WHERE A.TABLE_ID = B.TABLE_ID AND
           A.TBS_ID = C.ID AND
           B.TABLE_NAME = 'T1'
     ORDER BY A.PARTITION_NAME ASC;
