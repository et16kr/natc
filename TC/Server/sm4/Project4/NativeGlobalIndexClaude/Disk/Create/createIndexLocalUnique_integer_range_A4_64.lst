----------------------------------------
-- 2.1 CREATING INDEX USING CREATE_TABLE
----------------------------------------
$P0> CREATE TABLE PDT_RANGE
     (
         F1   INTEGER UNIQUE,
         F2   INTEGER
     ) 
     PARTITION BY RANGE( F1 )
     (
         PARTITION P1 VALUES LESS THAN ( 10 ),
         PARTITION P2 VALUES LESS THAN ( 20 ),
         PARTITION P3 VALUES LESS THAN ( 30 ),
         PARTITION P4 VALUES DEFAULT
     ) TABLESPACE PDT_TBS;
Create success.
$P0> INSERT INTO PDT_RANGE VALUES( 35, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 30, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 25, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 20, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 15, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 10, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 5, 0 );
1 row inserted.
$P0> INSERT INTO PDT_RANGE VALUES( 0, 0 );
1 row inserted.

-- should be {0}
$P0> SELECT F1 FROM PDT_RANGE
     WHERE F1 >= 0 LIMIT 1;
