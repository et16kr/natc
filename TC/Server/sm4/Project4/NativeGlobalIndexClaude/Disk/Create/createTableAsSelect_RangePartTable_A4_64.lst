--##################################################################
--+SECTOR 38; 메타 테이블 체크
--##################################################################

$P0> DROP TABLE T2;
Drop success.
$P0> CREATE TABLE T2 ( I1, I2, I3, I4 )
     PARTITION BY RANGE (I1, I2)
     ( PARTITION P1 VALUES LESS THAN (100, 'ABC' )
                 TABLESPACE PDT_TBS LOB(I3, I4) STORE AS ( TABLESPACE PDT_TBS2 ),
       PARTITION P2 VALUES LESS THAN (200, 'ABC' )
                 TABLESPACE PDT_TBS3,
       PARTITION P3 VALUES DEFAULT
     ) TABLESPACE PDT_TBS4 LOB(I4) STORE AS ( TABLESPACE PDT_TBS5 )
     AS SELECT I1, I2, I3, I4 FROM T1;
Create success.

