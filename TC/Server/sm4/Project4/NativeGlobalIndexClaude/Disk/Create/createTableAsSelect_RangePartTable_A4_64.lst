--##############################
--+SECTOR 36; CREATE partitioned table
--##############################
$P0> DROP TABLE T2;
Drop success.
$P0> CREATE TABLE T2 ( I1, I2, I3, I4 )
     PARTITION BY HASH(I1)
     (
         PARTITION P1 TABLESPACE PDT_TBS2
                 LOB (I3) STORE AS ( TABLESPACE PDT_TBS3 ),
         PARTITION P2 
                 LOB (I4) STORE AS ( TABLESPACE PDT_TBS4 ),
         PARTITION P3
                 LOB STORE AS ( TABLESPACE PDT_TBS5 ),
         PARTITION P4
     ) TABLESPACE PDT_TBS
     AS SELECT I1, I2, I3, I4 FROM T1;
Create success.

-- result: 8
$P0> SELECT COUNT(*) FROM T2;
