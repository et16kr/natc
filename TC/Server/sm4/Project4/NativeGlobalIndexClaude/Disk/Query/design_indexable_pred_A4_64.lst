     [ LEVEL FILTER ]
     LEVEL <= 5
     SCAN ( TABLE: DUAL, FULL SCAN, ACCESS: 94, COST: BLOCKED )
  ::SUB-QUERY END
  SCAN ( PARTITION: PD, FULL SCAN, ACCESS: 11, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 9, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
