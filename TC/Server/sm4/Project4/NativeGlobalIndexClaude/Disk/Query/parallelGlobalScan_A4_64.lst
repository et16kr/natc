1 row selected.
$T0> SELECT /*+ PARALLEL(NGD_PAR_ANS, 4) */
           SUM(K)||'/'||COUNT(*) AS PARALLEL_SUBQ
      FROM NGD_PAR_ANS
     WHERE K BETWEEN 500 AND 25000 AND A > (SELECT MIN(V) FROM NGD_PAR_SUB);
