 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = 병렬 글로벌 스캔의 답이 직렬과 같다 (디스크).
$T0> # Project ID           = Native Global Index
$T0> #
$T0> # 출처                 = altibase/scripts/global-index/parallel-answer-check.sh
$T0> #                        (삭제 예정인 그물에서 건짐 -- 통합 Phase E)
$T0> #
$T0> # 무엇을 재는가
$T0> #   GR-04(V4 A 트랙)가 연 병렬 글로벌 스캔이다. PSCRD 가 b-tree 를 슬라이스로
$T0> #   갈라 워커에게 나눠 주므로, 답이 직렬과 한 자리라도 다르면 그것은 놓친
$T0> #   최적화가 아니라 **틀린 행**이다.
$T0> #
$T0> # ★ 슬라이스 분배를 기대값에 담는다 -- 재실행으로 확인한 뒤에
$T0> #   이식할 때는 "워커별 행 수는 실행마다 갈리니 박지 말자" 고 보았으나,
$T0> #   같은 픽스처로 두 번 돌려 **출력이 바이트 동일**함을 확인했다. 슬라이스
$T0> #   경계가 b-tree 의 분리키에서 유도되고 데이터가 결정적이라 그렇다(J07).
$T0> #   그래서 플랜을 통째로 담는다 -- PARALLEL-SCAN-COORDINATOR 아래 큐 넷과
$T0> #   각 워커의 GLOBAL-INDEX RANGE SCAN 까지.
$T0> #
$T0> #   다만 이 값은 **트리 모양에 매달린다**. 페이지 크기가 바뀌면(4K 축)
$T0> #   분리키가 달라져 분배도 달라진다. 이 기대값은 A4_64 의 것이다.
$T0> #
$T0> #   답 쪽은 별개다. J08b 가 찾은 결함이 "병렬 경로가 인덱스 밖 술어에서
$T0> #   **비결정적** 오답을 낸다" 였으므로, 같은 질의를 세 번 돌려 세 번 다
$T0> #   직렬과 같은 값이 나오는 것을 담는다.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> DROP TABLE NGD_PAR_ANS;
$T0> DROP TABLE NGD_PAR_SUB;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> CREATE TABLE NGD_PAR_ANS ( P INTEGER, K INTEGER, A INTEGER, B INTEGER )
    PARTITION BY RANGE ( P )
    (
        PARTITION D1 VALUES LESS THAN ( 10000 ),
        PARTITION D2 VALUES LESS THAN ( 20000 ),
        PARTITION D3 VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> INSERT INTO NGD_PAR_ANS
      SELECT LEVEL-1, MOD( (LEVEL-1) * 7919, 30000 ), LEVEL-1, MOD(LEVEL-1, 1000)
        FROM DUAL CONNECT BY LEVEL <= 30000;
30000 rows inserted.
$T0> COMMIT;
Commit success.

$T0> CREATE INDEX NGD_PAR_ANS_G ON NGD_PAR_ANS ( K, A );
Create success.

$T0> CREATE TABLE NGD_PAR_SUB ( V INTEGER ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> INSERT INTO NGD_PAR_SUB VALUES (1000);
1 row inserted.
$T0> COMMIT;
Commit success.

$T0> SELECT COUNT(*) AS IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID
       AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGD_PAR_ANS_G';
IS_NATIVE_GLOBAL     
-----------------------
1                    
1 row selected.

$T0> ##################################
$T0> SECTOR 2; A0 -- 병렬 플랜이 실제로 서는가
$T0> ##################################
$T0> ALTER SESSION SET EXPLAIN PLAN = ON;
Alter success.
$T0> SELECT /*+ PARALLEL(NGD_PAR_ANS, 4) */ COUNT(*)
      FROM NGD_PAR_ANS WHERE K BETWEEN 500 AND 25000 AND B > 500;
COUNT                
-----------------------
12224                
1 row selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 8, COST: BLOCKED )
 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  PARALLEL-SCAN-COORDINATOR ( TABLE: SYS.NGD_PAR_ANS, ACCESS: 12224 )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PAR_ANS, INDEX: SYS.NGD_PAR_ANS_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 6181, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PAR_ANS, INDEX: SYS.NGD_PAR_ANS_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 6288, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PAR_ANS, INDEX: SYS.NGD_PAR_ANS_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 5895, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PAR_ANS, INDEX: SYS.NGD_PAR_ANS_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 6137, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
------------------------------------------------------------
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
Alter success.

$T0> ##################################
$T0> SECTOR 3; 1 -- 인덱스 밖 술어, 직렬 대 병렬 (3 회)
$T0> ##################################
$T0> SELECT /*+ NO_PARALLEL(NGD_PAR_ANS) */
           SUM(K)||'/'||SUM(A)||'/'||COUNT(*) AS SERIAL_ANSWER
      FROM NGD_PAR_ANS WHERE K BETWEEN 500 AND 25000 AND B > 500;
SERIAL_ANSWER                                                   
------------------------------------------------------------------
155856000/186354000/12224                                       
1 row selected.
$T0> SELECT /*+ PARALLEL(NGD_PAR_ANS, 4) */
           SUM(K)||'/'||SUM(A)||'/'||COUNT(*) AS PARALLEL_1
      FROM NGD_PAR_ANS WHERE K BETWEEN 500 AND 25000 AND B > 500;
PARALLEL_1                                                      
------------------------------------------------------------------
155856000/186354000/12224                                       
