$T0> ##################################
$T0> SECTOR 4; 2 -- 서브쿼리 술어
$T0> ##################################
$T0> SELECT /*+ NO_PARALLEL(NGD_PAR_ANS) */
           SUM(K)||'/'||COUNT(*) AS SERIAL_SUBQ
      FROM NGD_PAR_ANS
     WHERE K BETWEEN 500 AND 25000 AND A > (SELECT MIN(V) FROM NGD_PAR_SUB);
SERIAL_SUBQ                                
