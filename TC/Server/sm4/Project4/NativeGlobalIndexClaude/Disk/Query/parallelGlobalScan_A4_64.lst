$T0> SELECT /*+ PARALLEL(NGD_PAR_ANS, 4) */
           SUM(K)||'/'||SUM(A)||'/'||COUNT(*) AS PARALLEL_2
      FROM NGD_PAR_ANS WHERE K BETWEEN 500 AND 25000 AND B > 500;
PARALLEL_2                                                      
