 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 전제와 판별자
$T0> #
$T0> # 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
$T0> # 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
$T0> # 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
$T0> #
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
$T0> #
$T0> # ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
$T0> #   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
$T0> #   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
$T0> #   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
$T0> #   어긋났었다(disk-natc.md 6).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
$T0> #   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
$T0> #   복원이 유일한 방벽이다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고, 세운 값을 전사에 남긴다.
$T0> # 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/design/join_pred2.tc
$T0> #
$T0> # Body below is byte-identical to the original. What this port adds is the
$T0> # premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
$T0> # the value into the transcript, so the case states what it measures
$T0> # instead of inheriting it (F07 -- see include/globalIndexEnv.i).
$T0> #
$T0> # Project ID           = Native Global Index (disk) - PROJ-1624 port
$T0> ###########################################################################

$T0> ###########################################################################
$T0> # Global Index Test
$T0> ###########################################################################

$T0> set linesize 200;
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;

$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;

$T0> SKIP END;

$T0> set linesize 200;

$T0> ##################################
$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t1(i1 integer, i2 integer, i3 integer)
partition by range(i1)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 values (1, 1, 1);
1 row inserted.
$T0> insert into t1 values (2, 1, 2);
1 row inserted.
$T0> insert into t1 values (3, 3, 3);
1 row inserted.
$T0> insert into t1 values (4, 3, 4);
1 row inserted.

$T0> create index t1_i2 on t1(i2);
Create success.

$T0> create table t2(i1 integer, i2 integer, i3 integer)
partition by range(i1)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 values (1, 1, 1);
1 row inserted.
$T0> insert into t2 values (2, 1, 2);
1 row inserted.
$T0> insert into t2 values (3, 3, 3);
1 row inserted.
$T0> insert into t2 values (4, 3, 4);
1 row inserted.

$T0> create index t2_i1 on t2(i1);
Create success.

$T0> alter session set explain plan = on;
Alter success.
$T0> alter session set trclog_detail_predicate = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; JOIN
$T0> ##################################

$T0> select 1 from t1,t2 where t1.i1=t2.i1;
1           
--------------
1           
1           
1           
1           
4 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 2, COST: BLOCKED )
 JOIN ( METHOD: INDEX_NL, COST: BLOCKED )
  PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, FULL SCAN, ACCESS: 4, COST: BLOCKED )
   SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( TABLE: SYS.T2, INDEX: SYS.T2_I1, GLOBAL-INDEX, RANGE SCAN, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   [ VARIABLE KEY ]
   OR
    AND
     T1.I1 = T2.I1
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; JOIN FILTER
$T0> ##################################

$T0> select 1 from t1,t2 where t1.i1=t2.i1 and t1.i2=t2.i2;
1           
--------------
1           
1           
1           
1           
4 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 2, COST: BLOCKED )
 JOIN ( METHOD: HASH, COST: BLOCKED )
  PARTITION-COORDINATOR ( TABLE: SYS.T1, PARTITION: 2/2, FULL SCAN, ACCESS: 4, COST: BLOCKED )
   SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  HASH ( ITEM_SIZE: BLOCKED, ITEM_COUNT: 4, DISK_PAGE_COUNT: BLOCKED, ACCESS: 4, COST: BLOCKED )
   [ FILTER ]
   AND
    T1.I2 = T2.I2
    T1.I1 = T2.I1
   PARTITION-COORDINATOR ( TABLE: SYS.T2, PARTITION: 2/2, FULL SCAN, ACCESS: 4, COST: BLOCKED )
    SCAN ( PARTITION: P2, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
    SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 2, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; JOIN + LEFT ORDER
$T0> ##################################

$T0> select 1 from t1,t2 where t1.i1=t2.i1 order by t1.i2;
1           
--------------
1           
1           
1           
1           
4 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 2, COST: BLOCKED )
 JOIN ( METHOD: INDEX_NL, COST: BLOCKED )
  SCAN ( TABLE: SYS.T1, INDEX: SYS.T1_I2, GLOBAL-INDEX, FULL SCAN, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( TABLE: SYS.T2, INDEX: SYS.T2_I1, GLOBAL-INDEX, RANGE SCAN, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   [ VARIABLE KEY ]
   OR
    AND
     T1.I1 = T2.I1
------------------------------------------------------------
$T0> select 1 from t1,t2 where t1.i1=t2.i1 order by t1.i2 desc;
1           
--------------
1           
1           
1           
1           
4 rows selected.
------------------------------------------------------------
PROJECT ( COLUMN_COUNT: 1, TUPLE_SIZE: 2, COST: BLOCKED )
 JOIN ( METHOD: INDEX_NL, COST: BLOCKED )
  SCAN ( TABLE: SYS.T1, INDEX: SYS.T1_I2, GLOBAL-INDEX, FULL SCAN DESC, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
  SCAN ( TABLE: SYS.T2, INDEX: SYS.T2_I1, GLOBAL-INDEX, RANGE SCAN, ACCESS: 4, DISK_PAGE_COUNT: BLOCKED, COST: BLOCKED )
   [ VARIABLE KEY ]
   OR
    AND
     T1.I1 = T2.I1
------------------------------------------------------------

$T0> ##################################
$T0> # SECTOR; JOIN FILTER + LEFT ORDER
$T0> ##################################

$T0> select 1 from t1,t2 where t1.i1=t2.i1 and t1.i2=t2.i2 order by t1.i2;
