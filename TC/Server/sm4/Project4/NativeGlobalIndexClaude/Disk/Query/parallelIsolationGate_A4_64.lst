 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  PARALLEL-SCAN-COORDINATOR ( TABLE: SYS.NGD_PIG, ACCESS: 30000 )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PIG, INDEX: SYS.NGD_PIG_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 7860, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PIG, INDEX: SYS.NGD_PIG_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 7467, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PIG, INDEX: SYS.NGD_PIG_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 7467, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PIG, INDEX: SYS.NGD_PIG_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 7206, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
------------------------------------------------------------
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
Alter success.

$T0> SELECT /*+ PARALLEL( NGD_PIG, 4 ) INDEX( NGD_PIG, NGD_PIG_G ) */
           SUM(K)||'/'||SUM(A)||'/'||COUNT(*) AS ANSWER_RC
      FROM NGD_PIG WHERE K > 0;
ANSWER_RC                                                       
------------------------------------------------------------------
450015000/90000/30000                                           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; B -- ★ R1. REPEATABLE READ 의 맨 SELECT 는 병렬로 서지 않는다
$T0> ##################################
$T0> COMMIT;
Commit success.
$T0> ALTER SESSION SET AUTOCOMMIT = FALSE;
Alter success.
$T0> SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
Command executed successfully.

$T0> # B1. 플랜. 코디네이터 노드는 서지만 **슬라이스가 나뉘지 않고 TID 가
$T0> #     찍히지 않는** 것이 게이트의 모습이다(위 ★ 실측). 여기서 A 절처럼
$T0> #     슬라이스가 나뉘면 구멍이 열린 것이다.
$T0> ALTER SESSION SET EXPLAIN PLAN = ON;
Alter success.
$T0> SELECT /*+ PARALLEL( NGD_PIG, 4 ) INDEX( NGD_PIG, NGD_PIG_G ) */ COUNT(*)
      FROM NGD_PIG WHERE K > 0;
COUNT                
