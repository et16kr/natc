   PARALLEL-QUEUE ( TID: BLOCKED )
    SCAN ( TABLE: SYS.NGD_PIG, INDEX: SYS.NGD_PIG_G, GLOBAL-INDEX, RANGE SCAN, ACCESS: 7467, DISK_PAGE_COUNT: BLOCKED, TID: BLOCKED, COST: BLOCKED )
   PARALLEL-QUEUE ( TID: BLOCKED )
