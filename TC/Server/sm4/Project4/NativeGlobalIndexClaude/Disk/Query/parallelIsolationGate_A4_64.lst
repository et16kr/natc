$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
Alter success.

$T0> # B2. 답은 A 절과 같아야 한다. 게이트는 경로를 바꾸지 정답을 바꾸지
$T0> #     않는다 -- 다르면 게이트가 아니라 결함이다.
$T0> SELECT /*+ PARALLEL( NGD_PIG, 4 ) INDEX( NGD_PIG, NGD_PIG_G ) */
           SUM(K)||'/'||SUM(A)||'/'||COUNT(*) AS ANSWER_RR
      FROM NGD_PIG WHERE K > 0;
ANSWER_RR                                                       
------------------------------------------------------------------
450015000/90000/30000                                           
1 row selected.

$T0> # B3. 힌트 없이도 같은가.
$T0> SELECT /*+ INDEX( NGD_PIG, NGD_PIG_G ) */
           SUM(K)||'/'||SUM(A)||'/'||COUNT(*) AS ANSWER_RR_NOHINT
      FROM NGD_PIG WHERE K > 0;
ANSWER_RR_NOHINT                                                
------------------------------------------------------------------
450015000/90000/30000                                           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; C -- SERIALIZABLE
$T0> ##################################
$T0> # V1 수정이 handoff 진입을 "== REPEATABLE" 로 좁혔으므로 SERIALIZABLE 은
$T0> # 넘김을 타지 않는다(isolation.tc 머리말). 그렇다면 R1 의 구멍도 이 수준엔
$T0> # 없어야 한다 -- 병렬이 서도 무방하다. 그것을 전사해 둔다.
$T0> COMMIT;
Commit success.
$T0> ALTER SESSION SET AUTOCOMMIT = FALSE;
Alter success.
$T0> SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
Command executed successfully.

$T0> ALTER SESSION SET EXPLAIN PLAN = ON;
Alter success.
$T0> SELECT /*+ PARALLEL( NGD_PIG, 4 ) INDEX( NGD_PIG, NGD_PIG_G ) */ COUNT(*)
      FROM NGD_PIG WHERE K > 0;
COUNT                
