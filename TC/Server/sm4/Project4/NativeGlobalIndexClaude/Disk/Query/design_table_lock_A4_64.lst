$T0> ##########################################################################
$T0> # PORT EDIT: what replaces the $GIT_ rows this case used to see in v$lock
$T0> #
$T0> # v1/v2 above join system_.sys_tables_ (and sys_table_partitions_) against
$T0> # v$lock, so on the $GIT_ implementation every sector of this case also
$T0> # printed rows named $GIT_T1_IDX2 / $GIT_T1_IDX3 -- the hidden tables the
$T0> # global indexes were made of, each carrying its own IS/IX lock. On the
$T0> # native path those tables do not exist and those rows are simply gone.
$T0> #
$T0> # Re-recording the transcript would freeze that as an absence, and an
$T0> # absence is the weakest expectation there is: it holds just as well when
$T0> # the view is broken, when the index was never created, or when the case
$T0> # is looking at the wrong table. So the port states it as a count, next to
$T0> # the counts that must stay non-zero -- v3-natc-port.md 6.1 (assert "none"
$T0> # with SHOW_NO_HIDDEN_TABLE / SHOW_INDEX_MEDIA, never with "an error").
$T0> #
$T0> # TEETH: with DISK_GLOBAL_INDEX_ENABLE = 0 the same INSERT locks the two
$T0> # hidden tables and GIT_LOCK_ROWS reads 2, not 0, while T1_LOCK_ROWS and
$T0> # T1_PART_LOCK_ROWS are unchanged. That is the whole difference this case
$T0> # exists to show, stated as a value instead of as a missing line.
$T0> ##########################################################################

$T0> select cast(i.index_name as varchar(20)) index_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         i.index_table_id,
         cast(i.is_partitioned as varchar(1)) is_part,
         nvl(p.partition_type,-1) part_type
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
       ( select index_id, max(partition_type) partition_type
         from system_.sys_part_indices_ group by index_id ) p
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
    and i.index_id = p.index_id(+)
  order by 1;
INDEX_NAME            KIND              INDEX_TABLE_ID IS_PART  PART_TYPE   
----------------------------------------------------------------------------------
T1_IDX2               NATIVE-GLOBAL     0           F  101         
T1_IDX3               NATIVE-GLOBAL     0           F  101         
2 rows selected.
$T0> select cast(i.index_name as varchar(20)) index_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         i.index_table_id,
         cast(i.is_partitioned as varchar(1)) is_part,
         nvl(p.partition_type,-1) part_type
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
       ( select index_id, max(partition_type) partition_type
         from system_.sys_part_indices_ group by index_id ) p
  where i.table_id = t.table_id
    and t.table_name = upper('t2')
    and t.user_id = user_id()
    and i.index_id = p.index_id(+)
  order by 1;
INDEX_NAME            KIND              INDEX_TABLE_ID IS_PART  PART_TYPE   
----------------------------------------------------------------------------------
T2_IDX2               NATIVE-GLOBAL     0           F  101         
T2_IDX3               NATIVE-GLOBAL     0           F  101         
2 rows selected.
