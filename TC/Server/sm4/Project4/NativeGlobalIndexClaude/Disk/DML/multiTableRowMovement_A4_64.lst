101         
lob-101                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
1 row selected.

$T0> # A6. 같은 문장의 **다른 테이블**도 갱신되었는가.
$T0> SELECT K, W FROM NGD_MTR_B ORDER BY K;
K           W                 
---------------------------------
101         B-1               
102         B-2               
103         B-3               
3 rows selected.

$T0> ##################################
$T0> SECTOR 3; B -- 유일성은 여전히 파티션을 가로지른다
$T0> ##################################
$T0> # B1. 진짜 중복으로 옮기려 하면 실패해야 한다(ERR-11058).
$T0> #     옛 키가 제때 걷히는지를 이것이 가른다 -- 안 걷히면 이 문장이
$T0> #     아니라 A 절이 이미 실패했을 것이고, 너무 일찍 걷히면 이것이
$T0> #     성공한다.
$T0> UPDATE NGD_MTR_A a, NGD_MTR_B b
       SET a.K = 102
     WHERE a.K = b.K AND b.K = 103;
[ERR-11058 : The row already exists in a unique index.]
$T0> COMMIT;
Commit success.

$T0> # B2. 아무것도 잃지 않았는가.
$T0> SELECT /*+ INDEX( NGD_MTR_A, NGD_MTR_A_G ) */ COUNT(*) AS AFTER_DUP_TOTAL FROM NGD_MTR_A;
AFTER_DUP_TOTAL      
-----------------------
3                    
1 row selected.
$T0> SELECT /*+ INDEX( NGD_MTR_A, NGD_MTR_A_G ) */ K, P, V FROM NGD_MTR_A ORDER BY K;
K           P           V                 
----------------------------------------------
101         15          MOVED             
102         2           A-2               
103         11          A-3               
3 rows selected.

$T0> ##################################
$T0> SECTOR 4; C -- 여러 행을 한 문장으로 옮긴다
$T0> ##################################
$T0> UPDATE NGD_MTR_A a, NGD_MTR_B b
       SET a.P = a.P + 20
     WHERE a.K = b.K AND b.K IN ( 102, 103 );
2 rows updated.
$T0> COMMIT;
Commit success.

$T0> SELECT COUNT(*) AS ALIVE_C FROM NGD_MTR_A;
ALIVE_C              
-----------------------
3                    
1 row selected.
$T0> SELECT /*+ INDEX( NGD_MTR_A, NGD_MTR_A_G ) */ COUNT(*)          AS TOTAL_C    FROM NGD_MTR_A;
TOTAL_C              
-----------------------
3                    
1 row selected.
$T0> SELECT /*+ INDEX( NGD_MTR_A, NGD_MTR_A_G ) */ COUNT(DISTINCT K) AS DISTINCT_C FROM NGD_MTR_A;
DISTINCT_C           
-----------------------
