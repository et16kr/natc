###########################################################################
# TestCase Description = 가변 폭 글로벌 키 — 디스크 인덱스 레코드의 FIXED/VARIABLE 갈림.
# Project ID           = Native Global Index
#
# 출처                 = 없음. **새로 쓴 것**이다 (매체 짝 조사 2026-08-21,
#                        커버리지 §0.6.2 의 "NVARCHAR·가변 컬럼 키 Disk 0").
#
# ★ 이 케이스는 `Memory/DML/nvarcharKey.tc` 의 **사본이 아니다**
#
#   그 케이스의 헤더가 스스로 적어 두었다 -- "디스크 가변 키는
#   `smiGetVariableColumnSize4DiskIndex` 라는 다른 계산을 쓰므로 디스크 판이
#   따로 필요하다. 이 케이스의 사본이 아니라 별건이다."  여기가 그 별건이다.
#
# ★★ 디스크에만 있는 갈림 — 무엇이 다른가
#
#   메모리 테이블의 컬럼은 FIXED/VARIABLE 속성을 **테이블 레코드에서**
#   갖는다. 디스크 테이블 레코드는 PROJ-1705 이후 가변 속성이 없다 -- 전부
#   FIXED 다. 그런데 **디스크 인덱스 레코드는 다르다.** varchar 를 인덱스에서
#   FIXED 로 다루면 선언 폭만큼의 공간을 매 키마다 잡아 페이지를 낭비하므로,
#   `qdbCommon::setIndexKeyColumnTypeFlag` 가 인덱스 키 컬럼에 한해 속성을
#   다시 매긴다:
#
#       column.size > smiGetVariableColumnSize4DiskIndex()  ->  VARIABLE
#       그 밖                                                ->  FIXED 유지
#
#   `smiGetVariableColumnSize4DiskIndex()` 는 `align8( sizeof(sdcVarColHdr) )`
#   이고 `sdcVarColHdr` 는 `UShort offset; UShort length;` 라 **8 바이트
#   고정**이다(페이지 크기와 무관 -- 4K 축에서도 같다). varchar 의
#   `SYS_COLUMNS_.SIZE` 는 선언 폭 + 2 이므로 갈림은 이렇게 떨어진다:
#
#       varchar(6)  -> size  8   8 > 8 이 거짓  ->  **FIXED**
#       varchar(7)  -> size  9   9 > 8 이 참    ->  **VARIABLE**
#
#   조건에 `module->flag & MTD_COLUMN_TYPE_MASK == MTD_COLUMN_TYPE_VARIABLE`
#   가 함께 걸려 있으므로 **CHAR 는 아무리 넓어도 FIXED 로 남는다.**
#   char(60) 과 varchar(60) 은 같은 폭인데 인덱스 레코드에서 다른 편에 선다.
#
#   그리고 두 편은 키 오프셋을 다른 규칙으로 잡는다
#   (`qdx::validateKeySizeLimit` 의 디스크 분기):
#
#       FIXED     offset = align( offset, module->align );  offset += size
#       VARIABLE  offset = align( offset, 8 );              offset += 8
#
# ★★ 무엇을 주장하는가
#
#   **글로벌 트리는 두 편 모두에서 같은 뜻이어야 한다.** 글로벌 인덱스가
#   주는 값은 둘 -- 파티션을 가로지르는 정렬과 파티션을 가로지르는 유일성 --
#   이고, 그 값이 키 컬럼의 저장 속성에 따라 달라지면 안 된다. 그래서 이
#   케이스는 갈림의 **양쪽을 나란히 세우고 같은 물음을 던진다.**
#
#     A  갈림의 양쪽이 둘 다 네이티브 글로벌로 서는가 (판별자 101)
#     B  정렬·범위·점 조회가 양쪽에서 **각각 옳은** 답인가
#        (두 컬럼은 서로 다른 값을 담으므로 계수까지 같을 이유는 없다.
#         재는 것은 각 인덱스의 경유 결과 == 그 컬럼의 풀스캔 결과다)
#     C  ★ 파티션 간 유일성이 양쪽에서 실제로 서는가 (동작으로 확인)
#     D  가변 키의 길이가 자라고 줄고 NULL 이 되는 갱신 -- VARIABLE 쪽에서만
#        의미가 있는 경로다. 갈림을 **넘나드는** 갱신도 함께 본다
#        (짧은 값 <-> 긴 값)
#     E  복합 키에서 가변과 고정을 섞는다 -- 위의 오프셋 규칙 둘이 한 키
#        안에서 번갈아 도는 자리다
#     F  NVARCHAR -- 문자 하나가 여러 바이트라 길이 계산이 varchar 와 다르다
#
# ★ 왜 "성공했다" 로는 부족한가
#   가변 키의 오프셋이 어긋나면 문장은 성공하고 **답만 틀린다.** 그래서
#   C 는 카탈로그가 아니라 INSERT 의 거절로, B 는 인덱스 경유와 풀스캔의
#   차집합으로 잰다 -- `alterColumnGlobalKey.tc` 와 같은 저울이다.
#
# ★ 폭의 절대값을 기대값에 박지 않는다
#   갈림 자체(8 바이트)는 페이지 크기와 무관하지만, 이 케이스는 그 숫자를
#   주장하지 않는다. 주장하는 것은 **양쪽이 같은 답을 낸다**는 것이고, 그것은
#   페이지 크기가 바뀌어도 그대로여야 한다.
###########################################################################
INCLUDE stdFunc.i;

#
# 전제를 세우고 전사에 남긴다 (F07 규약).
#
DEF PIN_DISK_NATIVE()
{
    alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
    alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
    select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';

    # ★ F 절(NVARCHAR)의 전제. 이 두 값이 달라지면 NVARCHAR 가 뜻하는 바가
    #   달라지므로, 기대값을 읽는 사람이 무엇 위에서 잰 것인지 알아야 한다.
    #   정식 러너의 인스턴스는 `server create UTF8 UTF8` 로 지어진다.
    #
    # ★ 이 한 줄은 **이빨이다.** 값이 다르면 케이스가 아무것도 재기 전에
    #   붉어진다 -- 조용히 다른 것을 재는 것보다 낫다(이식분의
    #   `include/pinNative.sql` 과 같은 규약).
    #
    #   대가가 하나 있다: 스위트를 끝까지 돌리면 맨 뒤 `Recovery/` 의
    #   `clean` 이 DB 를 KSC5601/UTF16 으로 다시 짓는다. 그래서 그 뒤에
    #   `--no-fresh` 로 이 케이스만 다시 돌리면 여기서 붉어진다.
    #   **인스턴스를 새로 짓고 돌릴 것**(`natc-check.sh` 를 `--no-fresh`
    #   없이).
    select distinct nls_characterset, nls_nchar_characterset from v$nls_parameters;
}

#
# 판별자. 101 이면 네이티브 글로벌이다.
#
DEF SHOW_IMPL( @aTable )
{
    select i.index_name,
           decode( p.partition_type, 101, 'NATIVE', 'OTHER' ) as impl,
           decode( i.index_table_id, 0, 'NO-GIT', 'GIT' ) as hidden
      from system_.sys_part_indices_ p, system_.sys_indices_ i,
           system_.sys_tables_ t
     where p.index_id = i.index_id
       and i.table_id = t.table_id
       and t.table_name = '@{aTable}'
     order by 1;
}

#
# 인덱스 경유 결과와 풀스캔 결과의 차집합 -- 양쪽 다 비어야 한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
    select * from
    (
      select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
      minus
      select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    ) order by 1;

    select * from
    (
      select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
      minus
      select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    ) order by 1;
}

#
# 트리가 세는 키 개수와 테이블의 로우 개수를 나란히 둔다.
#
DEF CHECK_NOT_EMPTIED( @aTable, @aIndex, @aKeyCol )
{
    select /*+ index(@{aTable}, @{aIndex}) */ count(@{aKeyCol}) as via_index
      from @{aTable} where @{aKeyCol} is not null;
    select /*+ FULL SCAN(@{aTable}) */ count(@{aKeyCol}) as via_full
      from @{aTable} where @{aKeyCol} is not null;
}

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    DROP TABLE NGD_VK;
    DROP TABLE NGD_VKU;
    SKIP END;

##################################
SECTOR; PREPARATION -- 갈림의 양쪽을 한 테이블에 세운다
##################################
    CALL PIN_DISK_NATIVE();

    # FK  varchar(6) -> SIZE 8  -> 인덱스 레코드에서 FIXED 로 남는다
    # VK  varchar(7) -> SIZE 9  -> VARIABLE 로 내려간다
    # CK  char(60)   -> 폭은 넓지만 CHAR 라 FIXED
    # WK  varchar(60)-> 같은 폭인데 VARIABLE
    # NK  nvarchar(16) -> 문자당 여러 바이트
    create table ngd_vk
    (
        p  integer,
        fk varchar(6),
        vk varchar(7),
        ck char(60),
        wk varchar(60),
        nk nvarchar(16),
        v  varchar(4)
    )
    partition by range(p)
    (
      partition p1 values less than (10),
      partition p2 values less than (20),
      partition pd values default
    ) tablespace sys_tbs_disk_data;

    # 선언 폭과 저장 크기를 전사에 남긴다 -- 갈림이 어디 떨어지는지의 근거다.
    #
    # ★ NK(nvarchar)는 **일부러 빼 두었다.** NVARCHAR 의 SIZE 는 국가 문자
    #   집합의 함수라(UTF16 이면 폭 x2 + 2, UTF8 이면 x3 + 2) DB 를 어떻게
    #   지었는지가 기대값에 새어 든다. 실측으로 걸렸다 -- 정식 러너가 짓는
    #   인스턴스(`server create UTF8 UTF8`)에서는 50 이고, 스위트 맨 뒤
    #   `Recovery/restartCatalogSurvival.sql` 의 `clean`(destroydb+createdb)이
    #   지나간 뒤의 DB 에서는 34 다. 이 절의 주장은 **varchar 의 갈림**이므로
    #   NVARCHAR 의 크기는 필요하지 않다. F 절의 전제는 아래 문자셋 한 줄이
    #   진다.
    select column_name, precision, size
      from system_.sys_columns_ c, system_.sys_tables_ t
     where c.table_id = t.table_id
       and t.table_name = 'NGD_VK'
       and column_name in ( 'FK', 'VK', 'CK', 'WK' )
     order by column_name;

    # 파티션 키(p)를 담지 않은 키들 -> 글로벌이어야만 설 수 있다
    create index ngd_vk_fk on ngd_vk(fk) tablespace sys_tbs_disk_data;
    create index ngd_vk_vk on ngd_vk(vk) tablespace sys_tbs_disk_data;
    create index ngd_vk_ck on ngd_vk(ck) tablespace sys_tbs_disk_data;
    create index ngd_vk_wk on ngd_vk(wk) tablespace sys_tbs_disk_data;
    create index ngd_vk_nk on ngd_vk(nk) tablespace sys_tbs_disk_data;

##################################
SECTOR; A -- 갈림의 양쪽이 둘 다 네이티브 글로벌로 서는가
##################################
    CALL SHOW_IMPL( "NGD_VK" );

    # 파티션 셋에 흩어 놓는다. 한 파티션에 몰리면 글로벌의 뜻이 사라진다.
    insert into ngd_vk values ( 1,  'aaa', 'aaa',    'aaa', 'aaa',    N'aaa',    'P1' );
    insert into ngd_vk values ( 2,  'bbb', 'bbbbbb', 'bbb', 'bbbbbb', N'bbbbbb', 'P1' );
    insert into ngd_vk values ( 11, 'ccc', 'ccc',    'ccc', 'ccc',    N'ccc',    'P2' );
    insert into ngd_vk values ( 12, 'ddd', 'dddddd', 'ddd', 'dddddd', N'dddddd', 'P2' );
    insert into ngd_vk values ( 21, 'eee', 'eee',    'eee', 'eee',    N'eee',    'PD' );
    commit;

##################################
SECTOR; B -- 정렬 · 범위 · 점 조회가 양쪽에서 각각 옳은 답인가
##################################
# FIXED 쪽
    select /*+ index(ngd_vk, ngd_vk_fk) */ fk, p, v from ngd_vk order by fk, p;
    select /*+ index(ngd_vk, ngd_vk_fk) */ count(*) as fk_range
      from ngd_vk where fk between 'bbb' and 'ddd';
    select /*+ index(ngd_vk, ngd_vk_fk) */ fk, p from ngd_vk where fk = 'ccc';
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_fk", "p, fk", "fk is not null" );
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_fk", "fk" );

# VARIABLE 쪽 -- 같은 물음. 두 컬럼의 값이 다르므로 계수는 다를 수
# 있고, 각자 인덱스 경유 == 풀스캔이면 된다.
    select /*+ index(ngd_vk, ngd_vk_vk) */ vk, p, v from ngd_vk order by vk, p;
    select /*+ index(ngd_vk, ngd_vk_vk) */ count(*) as vk_range
      from ngd_vk where vk between 'bbb' and 'ddd';
    select /*+ index(ngd_vk, ngd_vk_vk) */ vk, p from ngd_vk where vk = 'ccc';
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_vk", "p, vk", "vk is not null" );
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_vk", "vk" );

# 같은 폭, 다른 편 -- CHAR(60) 은 FIXED, VARCHAR(60) 은 VARIABLE
    select /*+ index(ngd_vk, ngd_vk_ck) */ p, rtrim(ck) as ck_trim from ngd_vk order by ck, p;
    select /*+ index(ngd_vk, ngd_vk_wk) */ p, wk from ngd_vk order by wk, p;
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_wk", "p, wk", "wk is not null" );
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_ck", "ck" );
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_wk", "wk" );

##################################
SECTOR; C -- ★ 파티션 간 유일성이 갈림의 양쪽에서 실제로 서는가
##################################
# 카탈로그가 아니라 동작으로 확인한다. 오프셋이 어긋나 트리가 다른 값을
# 담고 있으면 아래의 중복이 들어가 버린다.
    create table ngd_vku( p integer, fk varchar(6), vk varchar(7) )
    partition by range(p)
    ( partition p1 values less than (100), partition pd values default )
    tablespace sys_tbs_disk_data;

    create unique index ngd_vku_fk on ngd_vku(fk) tablespace sys_tbs_disk_data;
    create unique index ngd_vku_vk on ngd_vku(vk) tablespace sys_tbs_disk_data;
    CALL SHOW_IMPL( "NGD_VKU" );

    insert into ngd_vku values ( 10, 'dup', 'dupdup' );
    commit;

    # 다른 파티션에 같은 FIXED 키 -> 막혀야 한다
    insert into ngd_vku values ( 500, 'dup', 'other1' );

    # 다른 파티션에 같은 VARIABLE 키 -> 역시 막혀야 한다
    insert into ngd_vku values ( 500, 'oth', 'dupdup' );

    # 둘 다 다르면 들어가야 한다
    insert into ngd_vku values ( 500, 'oth', 'other1' );
    commit;
    select count(*) as rows_after from ngd_vku;

    # row movement 로 파티션을 넘겨도 트리는 하나다
    alter table ngd_vku enable row movement;
    update ngd_vku set p = 700 where fk = 'dup';
    commit;
    select /*+ index(ngd_vku, ngd_vku_fk) */ p, fk, vk from ngd_vku order by fk;
    insert into ngd_vku values ( 10, 'dup', 'other2' );
    select count(*) as rows_after_move from ngd_vku;

##################################
SECTOR; D -- 가변 키의 갱신. 길이가 자라고 줄고 NULL 이 된다
##################################
# VARIABLE 쪽에서만 뜻이 있는 경로다. colSpace 가 바뀌는 갱신이 키를 옳게
# 옮기는가.
    update ngd_vk set wk = 'aaa-much-much-longer-than-it-was-before' where p = 1;
    commit;
    select /*+ index(ngd_vk, ngd_vk_wk) */ p, wk from ngd_vk order by wk, p;
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_wk", "wk" );

    update ngd_vk set wk = 'a' where p = 1;
    commit;
    select /*+ index(ngd_vk, ngd_vk_wk) */ p, wk from ngd_vk order by wk, p;
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_wk", "wk" );

    update ngd_vk set wk = null where p = 1;
    commit;
    select /*+ index(ngd_vk, ngd_vk_wk) */ count(*) as null_keys
      from ngd_vk where wk is null;
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_wk", "wk" );

    update ngd_vk set wk = 'aaa' where p = 1;
    commit;
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_wk", "p, wk", "wk is not null" );

    # ★ 갈림을 넘나드는 갱신 -- FIXED 폭 안의 값과 VARIABLE 폭의 값을 오간다.
    #   컬럼의 속성은 선언으로 정해지므로 저장 편은 바뀌지 않는다. 바뀌는
    #   것은 실제 길이뿐이고, 트리는 그것을 따라와야 한다.
    update ngd_vk set vk = 'zzzzzzz' where p = 11;
    commit;
    select /*+ index(ngd_vk, ngd_vk_vk) */ p, vk from ngd_vk order by vk, p;
    update ngd_vk set vk = 'c' where p = 11;
    commit;
    select /*+ index(ngd_vk, ngd_vk_vk) */ p, vk from ngd_vk order by vk, p;
    update ngd_vk set vk = 'ccc' where p = 11;
    commit;
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_vk", "p, vk", "vk is not null" );

##################################
SECTOR; E -- 복합 키. 한 키 안에서 오프셋 규칙 둘이 번갈아 돈다
##################################
    create index ngd_vk_m1 on ngd_vk( fk, wk )     tablespace sys_tbs_disk_data;
    create index ngd_vk_m2 on ngd_vk( wk, fk )     tablespace sys_tbs_disk_data;
    create index ngd_vk_m3 on ngd_vk( ck, wk, fk ) tablespace sys_tbs_disk_data;
    CALL SHOW_IMPL( "NGD_VK" );

    select /*+ index(ngd_vk, ngd_vk_m1) */ p, fk, wk from ngd_vk order by fk, wk, p;
    select /*+ index(ngd_vk, ngd_vk_m2) */ p, wk, fk from ngd_vk order by wk, fk, p;
    select /*+ index(ngd_vk, ngd_vk_m3) */ p, rtrim(ck) as ck_trim, wk, fk
      from ngd_vk order by ck, wk, fk, p;

    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_m1", "p, fk, wk", "fk is not null" );
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_m2", "p, wk, fk", "wk is not null" );

    # 선행 컬럼만으로 여는 범위 -- 뒤 컬럼의 오프셋이 어긋나면 여기서 갈린다
    select /*+ index(ngd_vk, ngd_vk_m2) */ count(*) as m2_prefix
      from ngd_vk where wk between 'aaa' and 'dddddd';

##################################
SECTOR; F -- NVARCHAR. 문자 하나가 여러 바이트다
##################################
    select /*+ index(ngd_vk, ngd_vk_nk) */ p, nk from ngd_vk order by nk, p;
    select /*+ index(ngd_vk, ngd_vk_nk) */ count(*) as nk_range
      from ngd_vk where nk between N'bbbbbb' and N'dddddd';
    select /*+ index(ngd_vk, ngd_vk_nk) */ p, nk from ngd_vk where nk = N'ccc';
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_nk", "p, nk", "nk is not null" );
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_nk", "nk" );

    # 길이가 바뀌는 갱신 -- varchar 와 같은 답을 내야 한다
    update ngd_vk set nk = N'aaaaaaaaaaaaaaa' where p = 1;
    commit;
    select /*+ index(ngd_vk, ngd_vk_nk) */ p, nk from ngd_vk order by nk, p;
    CALL CHECK_NOT_EMPTIED( "ngd_vk", "ngd_vk_nk", "nk" );

    update ngd_vk set nk = N'aaa' where p = 1;
    commit;
    CALL CHECK_INDEX_SCAN( "ngd_vk", "ngd_vk_nk", "p, nk", "nk is not null" );

##################################
SECTOR; FINALIZATION
##################################
    alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
    alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
    DROP TABLE NGD_VKU;
    DROP TABLE NGD_VK;
}
