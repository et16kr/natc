NGD_VK_NK                                                                                                                         
NATIVE  NO-GIT  
NGD_VK_VK                                                                                                                         
NATIVE  NO-GIT  
NGD_VK_WK                                                                                                                         
NATIVE  NO-GIT  
5 rows selected.

$T0> # 파티션 셋에 흩어 놓는다. 한 파티션에 몰리면 글로벌의 뜻이 사라진다.
$T0> insert into ngd_vk values ( 1,  'aaa', 'aaa',    'aaa', 'aaa',    N'aaa',    'P1' );
1 row inserted.
$T0> insert into ngd_vk values ( 2,  'bbb', 'bbbbbb', 'bbb', 'bbbbbb', N'bbbbbb', 'P1' );
1 row inserted.
$T0> insert into ngd_vk values ( 11, 'ccc', 'ccc',    'ccc', 'ccc',    N'ccc',    'P2' );
1 row inserted.
$T0> insert into ngd_vk values ( 12, 'ddd', 'dddddd', 'ddd', 'dddddd', N'dddddd', 'P2' );
1 row inserted.
$T0> insert into ngd_vk values ( 21, 'eee', 'eee',    'eee', 'eee',    N'eee',    'PD' );
1 row inserted.
$T0> commit;
Commit success.

$T0> ##################################
