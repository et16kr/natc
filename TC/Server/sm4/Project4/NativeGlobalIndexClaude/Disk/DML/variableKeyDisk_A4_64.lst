 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = 가변 폭 글로벌 키 — 디스크 인덱스 레코드의 FIXED/VARIABLE 갈림.
$T0> # Project ID           = Native Global Index
$T0> #
$T0> # 출처                 = 없음. **새로 쓴 것**이다 (매체 짝 조사 2026-08-21,
$T0> #                        커버리지 §0.6.2 의 "NVARCHAR·가변 컬럼 키 Disk 0").
$T0> #
$T0> # ★ 이 케이스는 `Memory/DML/nvarcharKey.tc` 의 **사본이 아니다**
$T0> #
$T0> #   그 케이스의 헤더가 스스로 적어 두었다 -- "디스크 가변 키는
$T0> #   `smiGetVariableColumnSize4DiskIndex` 라는 다른 계산을 쓰므로 디스크 판이
$T0> #   따로 필요하다. 이 케이스의 사본이 아니라 별건이다."  여기가 그 별건이다.
$T0> #
$T0> # ★★ 디스크에만 있는 갈림 — 무엇이 다른가
$T0> #
$T0> #   메모리 테이블의 컬럼은 FIXED/VARIABLE 속성을 **테이블 레코드에서**
$T0> #   갖는다. 디스크 테이블 레코드는 PROJ-1705 이후 가변 속성이 없다 -- 전부
$T0> #   FIXED 다. 그런데 **디스크 인덱스 레코드는 다르다.** varchar 를 인덱스에서
$T0> #   FIXED 로 다루면 선언 폭만큼의 공간을 매 키마다 잡아 페이지를 낭비하므로,
$T0> #   `qdbCommon::setIndexKeyColumnTypeFlag` 가 인덱스 키 컬럼에 한해 속성을
$T0> #   다시 매긴다:
$T0> #
$T0> #       column.size > smiGetVariableColumnSize4DiskIndex()  ->  VARIABLE
$T0> #       그 밖                                                ->  FIXED 유지
$T0> #
$T0> #   `smiGetVariableColumnSize4DiskIndex()` 는 `align8( sizeof(sdcVarColHdr) )`
$T0> #   이고 `sdcVarColHdr` 는 `UShort offset; UShort length;` 라 **8 바이트
$T0> #   고정**이다(페이지 크기와 무관 -- 4K 축에서도 같다). varchar 의
$T0> #   `SYS_COLUMNS_.SIZE` 는 선언 폭 + 2 이므로 갈림은 이렇게 떨어진다:
$T0> #
$T0> #       varchar(6)  -> size  8   8 > 8 이 거짓  ->  **FIXED**
$T0> #       varchar(7)  -> size  9   9 > 8 이 참    ->  **VARIABLE**
$T0> #
$T0> #   조건에 `module->flag & MTD_COLUMN_TYPE_MASK == MTD_COLUMN_TYPE_VARIABLE`
$T0> #   가 함께 걸려 있으므로 **CHAR 는 아무리 넓어도 FIXED 로 남는다.**
$T0> #   char(60) 과 varchar(60) 은 같은 폭인데 인덱스 레코드에서 다른 편에 선다.
$T0> #
$T0> #   그리고 두 편은 키 오프셋을 다른 규칙으로 잡는다
$T0> #   (`qdx::validateKeySizeLimit` 의 디스크 분기):
$T0> #
$T0> #       FIXED     offset = align( offset, module->align );  offset += size
$T0> #       VARIABLE  offset = align( offset, 8 );              offset += 8
$T0> #
$T0> # ★★ 무엇을 주장하는가
$T0> #
$T0> #   **글로벌 트리는 두 편 모두에서 같은 뜻이어야 한다.** 글로벌 인덱스가
$T0> #   주는 값은 둘 -- 파티션을 가로지르는 정렬과 파티션을 가로지르는 유일성 --
$T0> #   이고, 그 값이 키 컬럼의 저장 속성에 따라 달라지면 안 된다. 그래서 이
$T0> #   케이스는 갈림의 **양쪽을 나란히 세우고 같은 물음을 던진다.**
$T0> #
$T0> #     A  갈림의 양쪽이 둘 다 네이티브 글로벌로 서는가 (판별자 101)
$T0> #     B  정렬·범위·점 조회가 양쪽에서 **각각 옳은** 답인가
$T0> #        (두 컬럼은 서로 다른 값을 담으므로 계수까지 같을 이유는 없다.
$T0> #         재는 것은 각 인덱스의 경유 결과 == 그 컬럼의 풀스캔 결과다)
$T0> #     C  ★ 파티션 간 유일성이 양쪽에서 실제로 서는가 (동작으로 확인)
$T0> #     D  가변 키의 길이가 자라고 줄고 NULL 이 되는 갱신 -- VARIABLE 쪽에서만
$T0> #        의미가 있는 경로다. 갈림을 **넘나드는** 갱신도 함께 본다
$T0> #        (짧은 값 <-> 긴 값)
$T0> #     E  복합 키에서 가변과 고정을 섞는다 -- 위의 오프셋 규칙 둘이 한 키
$T0> #        안에서 번갈아 도는 자리다
$T0> #     F  NVARCHAR -- 문자 하나가 여러 바이트라 길이 계산이 varchar 와 다르다
$T0> #
$T0> # ★ 왜 "성공했다" 로는 부족한가
$T0> #   가변 키의 오프셋이 어긋나면 문장은 성공하고 **답만 틀린다.** 그래서
$T0> #   C 는 카탈로그가 아니라 INSERT 의 거절로, B 는 인덱스 경유와 풀스캔의
$T0> #   차집합으로 잰다 -- `alterColumnGlobalKey.tc` 와 같은 저울이다.
$T0> #
$T0> # ★ 폭의 절대값을 기대값에 박지 않는다
$T0> #   갈림 자체(8 바이트)는 페이지 크기와 무관하지만, 이 케이스는 그 숫자를
$T0> #   주장하지 않는다. 주장하는 것은 **양쪽이 같은 답을 낸다**는 것이고, 그것은
$T0> #   페이지 크기가 바뀌어도 그대로여야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고 전사에 남긴다 (F07 규약).
$T0> #

$T0> #
$T0> # 판별자. 101 이면 네이티브 글로벌이다.
$T0> #

$T0> #
$T0> # 인덱스 경유 결과와 풀스캔 결과의 차집합 -- 양쪽 다 비어야 한다.
$T0> #

$T0> #
$T0> # 트리가 세는 키 개수와 테이블의 로우 개수를 나란히 둔다.
$T0> #

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGD_VK;
$T0> DROP TABLE NGD_VKU;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION -- 갈림의 양쪽을 한 테이블에 세운다
$T0> ##################################
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> # ★ F 절(NVARCHAR)의 전제. 이 두 값이 달라지면 NVARCHAR 가 뜻하는 바가
$T0> #   달라지므로, 기대값을 읽는 사람이 무엇 위에서 잰 것인지 알아야 한다.
$T0> #   표준 인스턴스는 KO16KSC5601 / UTF16 이다 -- natc/bin/createdb 가
$T0> #   인자 없이 불리면 그렇게 짓고, 스위트 맨 뒤 `Recovery/` 의 `clean`
$T0> #   (destroydb + createdb) 도 같은 경로를 탄다. 클라이언트 쪽도 같은
$T0> #   값으로 맞물려 있다: natc/conf/server.conf 의 [DEFAULT] 가
$T0> #   ALTIBASE_NLS_USE=KO16KSC5601 을 못박고 ats2 가 그것을 자기가 띄우는
$T0> #   모든 isql 에 -nls_use 로 넘긴다.
$T0> #
$T0> # ★ 이 한 줄은 **이빨이다.** 값이 다르면 케이스가 아무것도 재기 전에
$T0> #   붉어진다 -- 조용히 다른 것을 재는 것보다 낫다(이식분의
$T0> #   `include/pinNative.sql` 과 같은 규약).
$T0> #
$T0> #   실제로 한 번 물었다. 기대값이 UTF8/UTF8 로 찍혀 있던 동안 --
$T0> #   폐기된 scripts/global-index/testdb.sh 가 `server create UTF8 UTF8`
$T0> #   로 짓던 격리 인스턴스의 값이다 -- 표준 인스턴스에서 이 줄이 제일
$T0> #   먼저 붉어졌다. 2026-08-21 에 표준 값으로 되돌렸다.
$T0> select distinct nls_characterset, nls_nchar_characterset from v$nls_parameters;
NLS_CHARACTERSET                          
--------------------------------------------
NLS_NCHAR_CHARACTERSET                    
--------------------------------------------
KSC5601                                   
UTF16                                     
1 row selected.

$T0> # FK  varchar(6) -> SIZE 8  -> 인덱스 레코드에서 FIXED 로 남는다
$T0> # VK  varchar(7) -> SIZE 9  -> VARIABLE 로 내려간다
$T0> # CK  char(60)   -> 폭은 넓지만 CHAR 라 FIXED
$T0> # WK  varchar(60)-> 같은 폭인데 VARIABLE
$T0> # NK  nvarchar(16) -> 문자당 여러 바이트
$T0> create table ngd_vk
    (
        p  integer,
        fk varchar(6),
        vk varchar(7),
        ck char(60),
        wk varchar(60),
        nk nvarchar(16),
        v  varchar(4)
    )
    partition by range(p)
    (
      partition p1 values less than (10),
      partition p2 values less than (20),
      partition pd values default
    ) tablespace sys_tbs_disk_data;
Create success.

$T0> # 선언 폭과 저장 크기를 전사에 남긴다 -- 갈림이 어디 떨어지는지의 근거다.
$T0> #
$T0> # ★ NK(nvarchar)는 **일부러 빼 두었다.** NVARCHAR 의 SIZE 는 국가 문자
$T0> #   집합의 함수라(UTF16 이면 폭 x2 + 2, UTF8 이면 x3 + 2) DB 를 어떻게
$T0> #   지었는지가 기대값에 새어 든다. 실측으로 걸렸다 -- 표준 인스턴스
$T0> #   (KO16KSC5601/UTF16) 에서는 34 이고, 폐기된 격리 인스턴스
$T0> #   (`server create UTF8 UTF8`) 에서는 50 이었다.
$T0> #   이 절의 주장은 **varchar 의 갈림**이므로
$T0> #   NVARCHAR 의 크기는 필요하지 않다. F 절의 전제는 아래 문자셋 한 줄이
$T0> #   진다.
$T0> select column_name, precision, size
      from system_.sys_columns_ c, system_.sys_tables_ t
     where c.table_id = t.table_id
       and t.table_name = 'NGD_VK'
       and column_name in ( 'FK', 'VK', 'CK', 'WK' )
     order by column_name;
COLUMN_NAME                                                                                                                       
------------------------------------------------------------------------------------------------------------------------------------
PRECISION   SIZE                 
------------------------------------
CK                                                                                                                                
60          62                   
FK                                                                                                                                
6           8                    
VK                                                                                                                                
7           9                    
WK                                                                                                                                
60          62                   
4 rows selected.

$T0> # 파티션 키(p)를 담지 않은 키들 -> 글로벌이어야만 설 수 있다
$T0> create index ngd_vk_fk on ngd_vk(fk) tablespace sys_tbs_disk_data;
Create success.
$T0> create index ngd_vk_vk on ngd_vk(vk) tablespace sys_tbs_disk_data;
Create success.
$T0> create index ngd_vk_ck on ngd_vk(ck) tablespace sys_tbs_disk_data;
Create success.
$T0> create index ngd_vk_wk on ngd_vk(wk) tablespace sys_tbs_disk_data;
Create success.
$T0> create index ngd_vk_nk on ngd_vk(nk) tablespace sys_tbs_disk_data;
Create success.

$T0> ##################################
$T0> SECTOR 2; A -- 갈림의 양쪽이 둘 다 네이티브 글로벌로 서는가
$T0> ##################################
$T0> select i.index_name,
           decode( p.partition_type, 101, 'NATIVE', 'OTHER' ) as impl,
           decode( i.index_table_id, 0, 'NO-GIT', 'GIT' ) as hidden
      from system_.sys_part_indices_ p, system_.sys_indices_ i,
           system_.sys_tables_ t
     where p.index_id = i.index_id
       and i.table_id = t.table_id
       and t.table_name = 'NGD_VK'
     order by 1;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
