$T0> # 다른 파티션에 같은 FIXED 키 -> 막혀야 한다
$T0> insert into ngd_vku values ( 500, 'dup', 'other1' );
[ERR-11058 : The row already exists in a unique index.]

$T0> # 다른 파티션에 같은 VARIABLE 키 -> 역시 막혀야 한다
$T0> insert into ngd_vku values ( 500, 'oth', 'dupdup' );
[ERR-11058 : The row already exists in a unique index.]

$T0> # 둘 다 다르면 들어가야 한다
$T0> insert into ngd_vku values ( 500, 'oth', 'other1' );
1 row inserted.
$T0> commit;
Commit success.
$T0> select count(*) as rows_after from ngd_vku;
