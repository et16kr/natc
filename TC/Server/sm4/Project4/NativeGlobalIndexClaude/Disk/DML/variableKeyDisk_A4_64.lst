$T0> ##################################
$T0> SECTOR 4; C -- ★ 파티션 간 유일성이 갈림의 양쪽에서 실제로 서는가
$T0> ##################################
$T0> # 카탈로그가 아니라 동작으로 확인한다. 오프셋이 어긋나 트리가 다른 값을
$T0> # 담고 있으면 아래의 중복이 들어가 버린다.
$T0> create table ngd_vku( p integer, fk varchar(6), vk varchar(7) )
    partition by range(p)
    ( partition p1 values less than (100), partition pd values default )
    tablespace sys_tbs_disk_data;
Create success.

$T0> create unique index ngd_vku_fk on ngd_vku(fk) tablespace sys_tbs_disk_data;
Create success.
$T0> create unique index ngd_vku_vk on ngd_vku(vk) tablespace sys_tbs_disk_data;
Create success.
$T0> select i.index_name,
           decode( p.partition_type, 101, 'NATIVE', 'OTHER' ) as impl,
           decode( i.index_table_id, 0, 'NO-GIT', 'GIT' ) as hidden
      from system_.sys_part_indices_ p, system_.sys_indices_ i,
           system_.sys_tables_ t
     where p.index_id = i.index_id
       and i.table_id = t.table_id
       and t.table_name = 'NGD_VKU'
     order by 1;
