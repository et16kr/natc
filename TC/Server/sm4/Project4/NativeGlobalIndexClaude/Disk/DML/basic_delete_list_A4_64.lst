 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 전제와 판별자
$T0> #
$T0> # 이 스위트의 전 케이스가 재는 것은 **디스크 파티션드 테이블 위의 네이티브
$T0> # 글로벌 인덱스**다. 원본(qp4/Project3/PROJ-1624-GlobalIndex)이 같은 문장으로
$T0> # 재던 것은 숨김 테이블 $GIT_ 였다. 갈림길은 프로퍼티 하나다:
$T0> #
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 1  -> 네이티브 (이 스위트)
$T0> #   DISK_GLOBAL_INDEX_ENABLE = 0  -> $GIT_    (원본 스위트)
$T0> #
$T0> # ★ 그래서 케이스마다 자기 전제를 세운다(F07 규약).
$T0> #   파일 기본값은 2026-08-06 부터 1 이지만, 기본값에 기대면 그 값이 움직이는
$T0> #   날 이 스위트는 "네이티브를 잰다"고 적어 놓고 $GIT_ 를 재게 된다 --
$T0> #   원본 PROJ-1624 와 NATC ddl/diskPartitionedTable.tc 가 실제로 그렇게
$T0> #   어긋났었다(disk-natc.md 6).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 값은 재기동하면 파일 값으로
$T0> #   돌아간다. 한 인스턴스 위에서 스위트가 이어 도는 동안은 FINALIZE 의
$T0> #   복원이 유일한 방벽이다.
$T0> ###########################################################################

$T0> #
$T0> # 전제를 세우고, 세운 값을 전사에 남긴다.
$T0> # 전사가 자기 전제를 적게 하는 것이 목적이므로 v$property 조회를 뺄 수 없다.
$T0> #
$T0> #
$T0> # 파일 기본값(1)으로 되돌린다. 다음 케이스에 0 이 새지 않게 한다.
$T0> #
$T0> #
$T0> # 인덱스가 어느 구현인지 카탈로그로 판별해 전사에 남긴다.
$T0> #
$T0> #   NATIVE GLOBAL : SYS_PART_INDICES_.PARTITION_TYPE = 101, INDEX_TABLE_ID = 0
$T0> #   LOCAL         : IS_PARTITIONED = 'T', SYS_INDEX_PARTITIONS_ 에 행
$T0> #   $GIT_ GLOBAL  : INDEX_TABLE_ID != 0 (숨김 테이블 OID)
$T0> #
$T0> # ★ 이 절이 이 스위트의 이빨이다. 프로퍼티가 0 이면 CREATE INDEX 로 만든
$T0> #   인덱스가 $GIT_ 로 내려가 KIND 가 통째로 바뀌고, 같은 문장을 재고 있다는
$T0> #   착각이 여기서 깨진다.
$T0> #
$T0> # ★ 원본 fixture 의 T1_PK(i2,i1) / T1_UK(i3,i2,i1) 은 파티션 키 i1 을
$T0> #   포함하므로 두 구현 어느 쪽에서도 글로벌이 아니라 LOCAL 이다. 원본
$T0> #   check_global_index.i 가 "$GIT_T1_PK" 를 조회한 것은 존재하지 않는
$T0> #   테이블을 겨눈 것이었다 -- v3-natc-port.md 3.2.
$T0> #
$T0> #
$T0> # 숨김 테이블이 하나도 없다는 것을 남긴다.
$T0> # 네이티브 경로에서는 $GIT_ 가 만들어지지 않는다.
$T0> #
$T0> ###########################################################################
$T0> # NativeGlobalIndexPort1624 - 정합성 검사
$T0> #
$T0> # 원본(PROJ-1624)의 basic/check_global_index.i 를 대신한다.
$T0> #
$T0> # ★ 원본은 이식할 수 없다. 두 가지 이유가 겹친다.
$T0> #
$T0> #   1. 조인할 테이블이 없다. 원본은 힙(파티션별 SELECT)과 숨김 테이블
$T0> #      "$GIT_T1_IDX1" 을 FULL OUTER JOIN 해서 한쪽에만 있는 행을 찾았다.
$T0> #      네이티브에는 그 테이블이 없고 b-tree 내용을 SQL 로 볼 수 없다.
$T0> #
$T0> #   2. 원본의 그 검사는 **한 번도 동작한 적이 없다.** 힙 쪽 SELECT 가
$T0> #      cast(_prowid as bigint) 를 쓰는데 디스크 테이블은 _PROWID 를
$T0> #      지원하지 않는다. 원본 .lst 22 개가 전부
$T0> #      [ERR-31385 : _PROWID is not supported.] 로 굳어 있다 --
$T0> #      "이 패턴이 울리는 변경"이 존재하지 않는 감시자였다.
$T0> #      근거와 수는 v3-natc-port.md 3.1.
$T0> #
$T0> # 그래서 목적(트리와 힙이 일치하는가)만 이어받고 방법은 새로 세운다.
$T0> # NativeGlobalIndexClaude/include/checkGlobalIndex.i 가 메모리 쪽에서 쓰는
$T0> # 것과 같은 세 겹이다:
$T0> #
$T0> #   1. 인덱스 경유 결과와 풀스캔 결과의 양방향 차집합  (행의 유무)
$T0> #   2. 카운트와 합계의 교차 확인                        (행의 중복·유령)
$T0> #   3. 힌트가 실제로 그 글로벌 인덱스를 잡았다는 플랜 증거
$T0> #
$T0> # ★ 3 이 없으면 1·2 는 "풀스캔 minus 풀스캔"이 되어 무조건 0행이다.
$T0> #   그것이 원본이 빠진 함정의 다른 얼굴이므로, 매 인덱스마다 플랜을
$T0> #   먼저 전사에 남긴다.
$T0> ###########################################################################

$T0> #
$T0> # 인덱스 하나를 검사한다.
$T0> #
$T0> # @aTable : 테이블 이름
$T0> # @aIndex : 글로벌 인덱스 이름
$T0> # @aPred  : 그 인덱스를 태울 술어. 전 행(널 포함)을 덮어야 한다.
$T0> #
$T0> #
$T0> # 원본 fixture(i1..i4 + idx1..idx5)의 전 글로벌 인덱스를 검사한다.
$T0> #
$T0> # 호출 규약은 원본과 같은 자리에서 부르되 테이블을 인자로 받는다 --
$T0> # 원본은 t1 전용 check_global_index.i 와 t2 전용 check_global_index_t2.i
$T0> # 두 파일이었다.
$T0> #
$T0> # 인덱스별 선두 컬럼:
$T0> #   idx1(i2) idx2(i2,i3,i4) idx3(i3,i2) idx4(i4,i3) idx5(i4)
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = LIST 파티션 DELETE 후 글로벌 인덱스 정합성
$T0> #
$T0> #   원본: qp4/Project3/PROJ-1624-GlobalIndex/basic/delete_list.tc
$T0> #   원본은 같은 문장을 $GIT_ 숨김 테이블 구현으로 잰다. 이 파일은
$T0> #   같은 문장을 **네이티브 글로벌 인덱스**로 잰다.
$T0> #
$T0> #   ★ 전제: DISK_GLOBAL_INDEX_ENABLE = 1.
$T0> #     PREPARATION 이 못박고 v$property 로 전사에 남긴다. 기본값에 기대지
$T0> #     않는다 -- 기본값이 움직이면 잰다고 적어 놓은 것과 실제로 재는 것이
$T0> #     갈리기 때문이다(disk-natc.md 6, F07).
$T0> #
$T0> #   ★ 정합성 검사는 이식이 아니라 재작성이다. 원본의 FULL OUTER JOIN 은
$T0> #     디스크 테이블에서 _PROWID 를 쓰기 때문에 한 번도 동작한 적이
$T0> #     없다(ERR-31385) -- 수와 근거는 v3-natc-port.md 3.1.
$T0> #     대체물은 ../include/checkGlobalIndex.i.
$T0> #
$T0> # Project ID           = Native Global Index (disk) - PROJ-1624 port
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop table t3;
$T0> alter session set explain plan = off;
$T0> alter session set trclog_detail_predicate = 0;
$T0> alter system set trclog_explain_graph = 0;
$T0> SKIP END;

$T0> set linesize 200;
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select cast(value1 as varchar(10)) disk_global_index_enable from v$property
  where name = 'DISK_GLOBAL_INDEX_ENABLE';
DISK_GLOBAL_INDEX_ENABLE  
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> # SECTOR; LIST PARTITION
$T0> ##################################

$T0> create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by list(i1)
(
  partition p1 values (1,6,11,16,21,26,31,36,41,46,51,56,61,66,71,76,81,86,91,96),
  partition p2 values (2,7,12,17,22,27,32,37,42,47,52,57,62,67,72,77,82,87,92,97),
  partition p3 values (3,8,13,18,23,28,33,38,43,48,53,58,63,68,73,78,83,88,93,98),
  partition p4 values (4,9,14,19,24,29,34,39,44,49,54,59,64,69,74,79,84,89,94,99),
  partition pd values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t1 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;
100 rows inserted.

$T0> insert into t1 values ( 0, 0, 0, 1 );
1 row inserted.
$T0> insert into t1 values ( 0, 1, null, null );
1 row inserted.
$T0> insert into t1 values ( 101, 0, null, null );
1 row inserted.

$T0> alter table t1 add constraint t1_pk primary key (i2, i1);
Alter success.
$T0> alter table t1 add constraint t1_uk unique (i3, i2, i1);
Alter success.

$T0> create index t1_idx1 on t1(i2);
Create success.
$T0> create index t1_idx2 on t1(i2, i3, i4);
Create success.
$T0> create index t1_idx3 on t1(i3, i2);
Create success.
$T0> create index t1_idx4 on t1(i4, i3);
Create success.
$T0> create index t1_idx5 on t1(i4);
Create success.

