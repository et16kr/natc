###########################################################################
# TestCase Description = MERGE INTO 가 글로벌 인덱스 디스크 테이블에 대해 옳게 도는가.
# Project ID           = Native Global Index
#
# 출처                 = 없음. **새로 쓴 것**이다 (매체 짝 조사 2026-08-21,
#                        커버리지 §0.6.2 의 "MERGE INTO Disk 0").
#
# ★ 메모리 판(`Memory/DML/mergeInto.tc`)의 사본이 아니다 -- 두 가지가 다르다
#
#   ① 기계가 다르다. MERGE 의 MATCHED 갱신은 대상 커서로 도는 UPDATE 이고,
#      파티션 키를 건드리면 한 문장 안에서 삭제+삽입으로 갈린다. 디스크에서
#      그 갈림은 `sdc` 의 로우 경로를 타고, 글로벌 트리의 키 교체는 디스크
#      b-tree 의 memberNo 경로를 탄다. 메모리 판이 초록이어도 이쪽은 재 본
#      적이 없다.
#
#   ② ★ **DELETE 절을 더한다.** 메모리 판에 없는 절이다.
#      `WHEN MATCHED THEN UPDATE ... DELETE WHERE ...` 는 한 문장이
#      **갱신하고 곧바로 지운다.** 글로벌 트리 쪽에서 보면 키를 옮겼다가
#      바로 빼는 것이고, 그 둘이 같은 문장 안에서 순서를 지키지 못하면
#      트리에 키가 남거나 힙에 로우가 남는다. 이 조합은 스위트 어디에도
#      없었다.
#
# ★★ 무엇을 재는가
#
#   A  MATCHED 갱신 + NOT MATCHED 삽입이 트리와 힙에 **같이** 반영되는가
#   B  MERGE 의 갱신이 파티션 키를 건드릴 때 (row movement) 정확히 한 행인가
#   C  글로벌 유일성이 MERGE 의 INSERT 를 통과해도 서는가
#   D  ★ DELETE 절 -- 지운 키가 트리에서도 사라지는가
#   E  ROLLBACK 이 트리와 힙을 **함께** 되돌리는가
#
#   ★ 매 절에서 **힙과 트리를 따로 센다.** MERGE 가 인덱스를 빠뜨리면
#     문장은 성공하고 두 숫자만 갈린다 -- 오류로는 안 잡힌다.
#
# ★ 플랜을 보지 않는다
#   메모리 판의 D 절은 `TRCLOG_DETAIL_PREDICATE = 1` 로 대상 하위 플랜을
#   찍어 본다. 여기서는 그것을 옮기지 않는다 -- 플랜 문자열은 매체와
#   옵티마이저 판단에 따라 흔들리는 기대값이고, 이 케이스가 주장하려는
#   것은 **결과의 정합성**이다. 플랜 축은 메모리 판이 이미 들고 있다.
###########################################################################
INCLUDE stdFunc.i;

DEF PIN_DISK_NATIVE()
{
    alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
    alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
    select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
}

DEF SHOW_IMPL( @aIndex )
{
    select decode( p.partition_type, 101, 'NATIVE', 'OTHER' ) as impl,
           decode( i.index_table_id, 0, 'NO-GIT', 'GIT' ) as hidden
      from system_.sys_part_indices_ p, system_.sys_indices_ i
     where p.index_id = i.index_id
       and i.index_name = '@{aIndex}';
}

#
# ★ 이 케이스의 저울. 힙과 트리를 나란히 둔다 -- MERGE 가 인덱스를
#   빠뜨리면 두 숫자만 갈린다.
#
DEF HEAP_VS_TREE()
{
    select /*+ FULL SCAN(ngd_mrg) */ count(*) as total_heap from ngd_mrg;
    select /*+ index(ngd_mrg, ngd_mrg_g) */ count(*)          as total_tree from ngd_mrg;
    select /*+ index(ngd_mrg, ngd_mrg_g) */ count(distinct k) as distinct_k from ngd_mrg;
}

DEF PART_SPREAD()
{
    select count(*) as in_p1 from ngd_mrg partition( p1 );
    select count(*) as in_p2 from ngd_mrg partition( p2 );
    select count(*) as in_pd from ngd_mrg partition( pd );
}

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    DROP TABLE NGD_MRG;
    DROP TABLE NGD_MRG_S;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CALL PIN_DISK_NATIVE();

    # 대상 -- 파티션드 + 글로벌 유일 인덱스
    create table ngd_mrg ( p integer, k integer, v varchar(16) )
    partition by range ( p )
    (
      partition p1 values less than ( 10 ),
      partition p2 values less than ( 20 ),
      partition pd values default
    ) tablespace sys_tbs_disk_data;

    # 원본 -- 평범한 테이블
    create table ngd_mrg_s ( p integer, k integer, v varchar(16) )
        tablespace sys_tbs_disk_data;

    insert into ngd_mrg values ( 1,  101, 'OLD-1' );
    insert into ngd_mrg values ( 2,  102, 'OLD-2' );
    insert into ngd_mrg values ( 11, 103, 'OLD-3' );
    commit;

    # 파티션 키(p)를 담지 않은 유일 키 -> 글로벌이어야만 설 수 있다
    create unique index ngd_mrg_g on ngd_mrg ( k ) tablespace sys_tbs_disk_data;
    CALL SHOW_IMPL( "NGD_MRG_G" );

##################################
SECTOR; A -- MATCHED 갱신 + NOT MATCHED 삽입
##################################
    # 101·102 는 있고(MATCHED), 201 은 없다(NOT MATCHED).
    insert into ngd_mrg_s values ( 1,  101, 'NEW-1' );
    insert into ngd_mrg_s values ( 2,  102, 'NEW-2' );
    insert into ngd_mrg_s values ( 21, 201, 'NEW-INS' );
    commit;

    merge into ngd_mrg t using ngd_mrg_s s on ( t.k = s.k )
        when matched then update set t.v = s.v
        when not matched then insert values ( s.p, s.k, s.v );
    commit;

    # A1. 갱신이 반영됐는가 -- 트리로 읽는다.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;

    # A2. 힙과 트리가 같은 수를 말하는가.
    CALL HEAP_VS_TREE();

    # A3. 삽입된 행이 옳은 파티션으로 갔는가.
    CALL PART_SPREAD();

    # A4. 점 조회로 새 행을 트리에서 찾을 수 있는가.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg where k = 201;

##################################
SECTOR; B -- MERGE 의 갱신이 파티션 키를 건드리면 row movement 다
##################################
    delete from ngd_mrg_s;
    insert into ngd_mrg_s values ( 15, 101, 'MOVED-BY-MERGE' );
    commit;

    alter table ngd_mrg enable row movement;

    merge into ngd_mrg t using ngd_mrg_s s on ( t.k = s.k )
        when matched then update set t.p = s.p, t.v = s.v
        when not matched then insert values ( s.p, s.k, s.v );
    commit;

    # B1. ★ 정확히 한 행인가. 갈린 채로 남으면 둘이 되거나 사라진다.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ count(*) as k101_rows
      from ngd_mrg where k = 101;
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg where k = 101;

    # B2. 옮겨졌는가 -- P1 에서 P2 로.
    CALL PART_SPREAD();
    CALL HEAP_VS_TREE();

##################################
SECTOR; C -- 글로벌 유일성이 MERGE 의 INSERT 를 통과해도 서는가
##################################
# 원본이 이미 있는 키를 **다른 파티션에** 새로 넣으려 한다.
# ON 조건이 K 가 아니라 P 이므로 MATCHED 가 아니고, INSERT 가 시도된다.
    delete from ngd_mrg_s;
    insert into ngd_mrg_s values ( 25, 102, 'DUP-ACROSS-PART' );
    commit;

    merge into ngd_mrg t using ngd_mrg_s s on ( t.p = s.p )
        when matched then update set t.v = s.v
        when not matched then insert values ( s.p, s.k, s.v );

    CALL HEAP_VS_TREE();
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;

##################################
SECTOR; D -- ★ DELETE 절. 지운 키가 트리에서도 사라지는가
##################################
# 한 문장이 갱신하고 곧바로 지운다. 트리 쪽에서 보면 키를 옮겼다가 바로
# 빼는 것이다. 둘이 순서를 지키지 못하면 트리에 키가 남거나 힙에 로우가
# 남는다 -- 그것을 힙/트리 두 숫자로 잡는다.
    delete from ngd_mrg_s;
    insert into ngd_mrg_s values ( 11, 103, 'DEL-ME' );
    commit;

    # 지우기 전 상태를 전사에 남긴다.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;

    merge into ngd_mrg t using ngd_mrg_s s on ( t.k = s.k )
        when matched then update set t.v = s.v delete where t.k = 103
        when not matched then insert values ( s.p, s.k, s.v );
    commit;

    # D1. 103 이 힙에서 사라졌는가.
    select /*+ FULL SCAN(ngd_mrg) */ count(*) as k103_heap from ngd_mrg where k = 103;

    # D2. ★ 103 이 **트리에서도** 사라졌는가. 여기서 1 이 나오면 트리에
    #     유령 키가 남은 것이다.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ count(*) as k103_tree from ngd_mrg where k = 103;

    CALL HEAP_VS_TREE();
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;

    # D3. 유령 키가 없다면 같은 값을 다시 넣을 수 있어야 한다.
    insert into ngd_mrg values ( 11, 103, 'REINSERTED' );
    commit;
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg where k = 103;
    CALL HEAP_VS_TREE();

##################################
SECTOR; E -- ROLLBACK 이 트리와 힙을 함께 되돌리는가
##################################
    delete from ngd_mrg_s;
    insert into ngd_mrg_s values ( 5, 101, 'ROLLED-BACK' );
    insert into ngd_mrg_s values ( 5, 301, 'ROLLED-BACK-INS' );
    commit;

    AUTOCOMMIT OFF;

    merge into ngd_mrg t using ngd_mrg_s s on ( t.k = s.k )
        when matched then update set t.p = s.p, t.v = s.v
        when not matched then insert values ( s.p, s.k, s.v );

    # 되돌리기 전 -- 문장이 보였던 상태.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;

    ROLLBACK;
    AUTOCOMMIT ON;

    # ★ 판정 -- 힙과 트리가 **함께** 되돌아가야 한다.
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;
    CALL HEAP_VS_TREE();
    CALL PART_SPREAD();

    # 되돌린 뒤에도 유일성이 서는가 -- 트리에 유령 키가 남았다면 여기서
    # 엉뚱하게 막힌다.
    insert into ngd_mrg values ( 5, 301, 'AFTER-ROLLBACK' );
    commit;
    select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;

##################################
SECTOR; FINALIZATION
##################################
    alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
    alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
    DROP TABLE NGD_MRG;
    DROP TABLE NGD_MRG_S;
}
