$T0> ##################################
$T0> SECTOR 4; C -- 글로벌 유일성이 MERGE 의 INSERT 를 통과해도 서는가
$T0> ##################################
$T0> # 원본이 이미 있는 키를 **다른 파티션에** 새로 넣으려 한다.
$T0> # ON 조건이 K 가 아니라 P 이므로 MATCHED 가 아니고, INSERT 가 시도된다.
$T0> delete from ngd_mrg_s;
1 row deleted.
$T0> insert into ngd_mrg_s values ( 25, 102, 'DUP-ACROSS-PART' );
1 row inserted.
$T0> commit;
Commit success.

$T0> merge into ngd_mrg t using ngd_mrg_s s on ( t.p = s.p )
        when matched then update set t.v = s.v
        when not matched then insert values ( s.p, s.k, s.v );
[ERR-11058 : The row already exists in a unique index.]

