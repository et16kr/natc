$T0> ##################################
$T0> SECTOR 5; D -- ★ DELETE 절. 지운 키가 트리에서도 사라지는가
$T0> ##################################
$T0> # 한 문장이 갱신하고 곧바로 지운다. 트리 쪽에서 보면 키를 옮겼다가 바로
$T0> # 빼는 것이다. 둘이 순서를 지키지 못하면 트리에 키가 남거나 힙에 로우가
$T0> # 남는다 -- 그것을 힙/트리 두 숫자로 잡는다.
$T0> delete from ngd_mrg_s;
1 row deleted.
$T0> insert into ngd_mrg_s values ( 11, 103, 'DEL-ME' );
1 row inserted.
$T0> commit;
Commit success.

$T0> # 지우기 전 상태를 전사에 남긴다.
$T0> select /*+ index(ngd_mrg, ngd_mrg_g) */ k, p, v from ngd_mrg order by k;
K           P           V                 
----------------------------------------------
