--##############################
--+SECTOR 3; INTEGER, BIGINT, SMALLINT
--##############################
$P0> DROP TABLE T1;
[ERR-31031 : Table or view was not found : 
0001 : DROP TABLE T1
                 ^ ^
]

-- should be success
$P0> CREATE TABLE T1 ( I1 INTEGER UNIQUE, I2 BIGINT , I3 SMALLINT )
     PARTITION BY HASH (I1)
     ( PARTITION P1 TABLESPACE PDT_TBS2,
       PARTITION P2 TABLESPACE PDT_TBS3,
       PARTITION P3 TABLESPACE PDT_TBS4,
       PARTITION P4 TABLESPACE PDT_TBS5
     ) TABLESPACE PDT_TBS;
Create success.

$P0> INSERT INTO T1 VALUES (NULL, 100, 100);
1 row inserted.
$P0> INSERT INTO T1 VALUES (100, 110, 110);
1 row inserted.
$P0> INSERT INTO T1 VALUES (200, 120, 120);
1 row inserted.
$P0> INSERT INTO T1 VALUES (300, 130, 130);
1 row inserted.

$P0> DELETE FROM T1 PARTITION(P1);
2 rows deleted.
$P0> DELETE FROM T1 PARTITION(P2);
1 row deleted.
$P0> DELETE FROM T1 PARTITION(P3);
No rows deleted.
$P0> DELETE FROM T1 PARTITION(P4);
1 row deleted.

-- should be {}
$P0> SELECT * FROM T1 ORDER BY I1;
T1.I1       T1.I2                T1.I3       
-------------------------------------------------
No rows selected.


