 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = memberNo 디렉터리 — 발급 · DROPPED · 수동 회수 (디스크).
$T0> # Project ID           = Native Global Index
$T0> #
$T0> # 출처                 = 없음. **새로 쓴 것**이다 (커버리지 §0.7 의 Z3
$T0> #                        "memberNo 회수 -- GR-09 한 트랙 전체가 0").
$T0> #
$T0> # ★★ 왜 이 축이 통째로 비어 있었나
$T0> #
$T0> #   memberNo 는 디스크 네이티브 글로벌 인덱스의 **핵심 자료구조**다. 트리는
$T0> #   하나인데 로우는 파티션마다 흩어져 있으므로, 키 헤더가 소유 파티션을
$T0> #   가리키는 번호(memberNo, 2 바이트)를 싣는다. 그 번호의 발급·상태·회수를
$T0> #   담는 것이 **멤버 디렉터리**이고, 제품은 그것을 고정 뷰로 내놓는다:
$T0> #
$T0> #       V$DISK_BTREE_GLOBAL_MEMBER
$T0> #           INDEX_NAME · INDEX_ID · MEMBER_NO · PARTITION_OID ·
$T0> #           PARTITION_TBS_ID · STATE · STATE_NAME · STORAGE_TYPE · KEY_COUNT
$T0> #
$T0> #   스위트 전량에서 이 뷰를 읽는 케이스가 **0** 이었다. 즉 이 프로젝트가
$T0> #   새로 만든 자료구조를 SQL 수준에서 보는 눈이 하나도 없었다.
$T0> #
$T0> # ★★ 무엇을 주장하는가 -- 계약 넷
$T0> #
$T0> #   A  **발급은 파티션 하나에 번호 하나**다. 파티션 N 개짜리 테이블에
$T0> #      글로벌 인덱스를 만들면 0..N-1 이 ACTIVE 로 선다.
$T0> #
$T0> #   B  ★ **번호는 재사용되지 않는다.** 발급은 언제나 `mMemberCnt` 이고
$T0> #      단조 증가한다(`sdnbBTree::nextMemberNo`). 재사용하지 않는 이유가
$T0> #      그 함수의 주석에 있다 -- purge 가 중단·크래시·큐 포화로 옛 키를
$T0> #      다 지우지 못한 사이에 번호를 되팔면, **옛 파티션의 키가 새 파티션의
$T0> #      키로 보이고 오류 없이 남의 로우를 돌려준다.** 생애 발급 수라는
$T0> #      상한을 무는 대가로 그 창을 없앤다.
$T0> #
$T0> #   C  ★ 그래서 **`DROP PARTITION` 은 자리를 비우지 않는다.** 그 자리는
$T0> #      `DROPPED` 로 남고, 자리 수(slots_total)가 살아 있는 파티션 수보다
$T0> #      많아진다. 서버 로그가 같은 말을 한다 -- "Member numbers are never
$T0> #      reused, so dropping partitions frees none".
$T0> #
$T0> #   D  ★★ **자리를 되돌리는 것은 인덱스를 다시 세우는 DDL 이다.**
$T0> #      이 케이스를 쓰면서 실측으로 갈라낸 구분이고, 처음 세운 가설과
$T0> #      다르다 -- 그러므로 여기 적어 둔다:
$T0> #
$T0> #        `DROP PARTITION`          디렉터리를 손대지 않는다. DROPPED 가 남는다
$T0> #        `SPLIT PARTITION` 등      **인덱스를 통째로 다시 만든다.** 새 인덱스의
$T0> #          재구성 DDL             디렉터리는 살아 있는 파티션만으로 0..N-1 이
$T0> #                                 되므로 DROPPED 자리가 사라진다
$T0> #        `ALTER INDEX ... REBUILD` 같은 일을 명시적으로 부른다. 로그의 문구가
$T0> #                                 "resets the count to the live partition
$T0> #                                 count" 다
$T0> #
$T0> #      ★ **이것은 슬롯 재사용이 아니다.** 재사용이라면 살아 있는 인덱스의
$T0> #        DROPPED 자리에 새 파티션이 들어가는 것이고 위의 위험이 그대로
$T0> #        열린다. 실제로 일어나는 일은 **디렉터리 자체가 새로 서는 것**이며,
$T0> #        새 디렉터리에는 옛 키가 없으므로 번호가 0 부터 다시 나가도
$T0> #        안전하다. `nextMemberNo` 의 멱등 분기가 바로 그 재구성 경로를 위해
$T0> #        있다 -- "리빌드에서 만든 새 인덱스의 디렉터리에 새 파티션들을 이미
$T0> #        넣어 두고, 그 파티션들이 커밋 pending 의 등록 경로로 한 번 더
$T0> #        온다."
$T0> #
$T0> #      C 절이 이 구분을 한 화면에 담는다: DROP 뒤에 DROPPED 를 보이고,
$T0> #      곧이어 SPLIT 뒤에 그것이 사라지는 것을 보인다.
$T0> #
$T0> # ★★ 자동 회수(GLOBAL_INDEX_AUTO_RECLAIM)는 왜 여기서 못 재는가
$T0> #
$T0> #   프로퍼티는 기본값 1 이고 이 케이스가 그것을 전사에 남긴다. 그러나
$T0> #   **자동 회수가 도는 조건은 SQL 로 만들 수 없다.** 방아쇠는 발급 수가
$T0> #   상한의 90% 에 닿는 것이고(`SDNB_MEMBER_DIR_WARN_AT`), 8K 페이지에서
$T0> #   상한은 8,000 이라 임계는 **7,200 발급**이다. 그 지점에 닿으려면 파티션
$T0> #   DDL 을 7,200 번 돌려야 한다 -- 회귀 스위트의 케이스 하나가 할 일이
$T0> #   아니다.
$T0> #
$T0> #   그래서 이 케이스는 자동 회수를 **주장하지 않는다.** 주장하는 것은
$T0> #   그 아래 계층 -- 디렉터리가 실재하고, 발급이 단조이고, 수동 회수가
$T0> #   듣는다는 것 -- 이고, 자동 회수는 그 위에 얹히는 최적화다. 임계 경로는
$T0> #   FIT 이나 전용 하네스의 몫이며, 그 사실을 여기 적어 두는 것이 이
$T0> #   케이스가 그 공백에 대해 할 수 있는 정직한 일이다.
$T0> #
$T0> # ★ 기대값에 담지 않는 것 -- PARTITION_OID · PARTITION_TBS_ID · INDEX_ID
$T0> #   셋 다 실행마다 달라지는 값이라 오라클에 담으면 케이스가 환경에 묶인다.
$T0> #   담는 것은 `INDEX_NAME · MEMBER_NO · STATE_NAME · STORAGE_TYPE ·
$T0> #   KEY_COUNT` 다.
$T0> #
$T0> #   `KEY_COUNT` 는 **마지막 통계 수집이 센 값**이고 DML 이 유지하는
$T0> #   카운터가 아니다(D18 의 주석). 이 케이스는 통계를 걷지 않으므로 0 이
$T0> #   나오는 것이 옳다 -- 그 0 이 "카운터가 아니다" 를 못박는다.
$T0> ###########################################################################

$T0> #
$T0> # ★ 이 케이스의 눈. 실행마다 달라지는 컬럼은 담지 않는다.
$T0> #

$T0> #
$T0> # 살아 있는 파티션 수. 위의 slots_active 와 견주는 값이다.
$T0> #

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGD_MEM;
$T0> DROP TABLE NGD_MEM_L;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> alter system set DISK_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> alter system set __DISK_GLOBAL_INDEX_LEGACY_CREATE = 0;
Alter success.
$T0> select name, value1 from v$property where name = 'DISK_GLOBAL_INDEX_ENABLE';
