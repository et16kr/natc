--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
DISK_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                          
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> # 자동 회수의 전제를 전사에 남긴다. 머리말이 적은 대로 이 케이스는
$T0> # 자동 회수가 도는 것을 주장하지 않는다 -- 값만 못박는다.
$T0> select name, value1 from v$property where name = 'GLOBAL_INDEX_AUTO_RECLAIM';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
GLOBAL_INDEX_AUTO_RECLAIM                                                                                                                                                                                                                                         
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> create table ngd_mem( p integer, k integer )
    partition by range( p )
    (
      partition p1 values less than ( 10 ),
      partition p2 values less than ( 20 ),
      partition pd values default
    ) tablespace sys_tbs_disk_data;
Create success.

$T0> # 파티션 키(p)를 담지 않은 키 -> 글로벌이어야만 설 수 있다
$T0> create index ngd_mem_g on ngd_mem( k ) tablespace sys_tbs_disk_data;
Create success.

$T0> select decode( pi.partition_type, 101, 'NATIVE', 'OTHER' ) as impl
      from system_.sys_part_indices_ pi, system_.sys_indices_ i
     where pi.index_id = i.index_id and i.index_name = 'NGD_MEM_G';
IMPL    
----------
NATIVE  
1 row selected.

$T0> insert into ngd_mem select level,      level      from dual connect by level <= 5;
5 rows inserted.
$T0> insert into ngd_mem select level + 10, level + 10 from dual connect by level <= 5;
5 rows inserted.
$T0> insert into ngd_mem select level + 20, level + 20 from dual connect by level <= 5;
5 rows inserted.
$T0> commit;
Commit success.

