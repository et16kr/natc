 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Reject Memory native DDL across a savepoint.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Test ID              = NGI-NEG-010
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> # 출처                 = NativeGlobalIndexCodex/Memory/Unsupported/savepointDdlCombination.tc (통합 Phase D 흡수)
$T0> #                        원본은 codex 브랜치가 관리한다. 고칠 일이 생기면 그쪽도 본다.
$T0> # 흡수 시 더한 것       = (1) 프로퍼티 못박기 -- 원본은 자기 전제를 세우지 않아
$T0> #                            앞 케이스가 남긴 값을 물려받았다(계획 §5.4)
$T0> #                        (2) INDEX_IMPL_TYPE 제거 -- SYS_INDICES_ 에 없는 컬럼이라
$T0> #                            원본 질의가 ERR-31058 로 죽는다. 판별자는 INDEX_TABLE_ID
$T0> #                            (네이티브 = 0) 하나로 충분하다
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> DROP TABLE NGM_NEG_SPDDL;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'MEM_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
MEM_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                           
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> CREATE TABLE NGM_NEG_SPDDL (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_NEG_SPDDL_OK ON NGM_NEG_SPDDL(K);
Create success.
$T0> INSERT INTO NGM_NEG_SPDDL VALUES (1, 'K-101', 201);
1 row inserted.
$T0> INSERT INTO NGM_NEG_SPDDL VALUES (11, 'K-111', 211);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_SPDDL_%';
BEFORE_INDEX_COUNT   
-----------------------
1                    
1 row selected.

$T0> AUTOCOMMIT OFF;
Set autocommit off success.
$T0> INSERT INTO NGM_NEG_SPDDL VALUES (21, 'K-121', 221);
1 row inserted.
$T0> SAVEPOINT NGM_NEG_SP;
Savepoint success.
$T0> CREATE INDEX NGM_NEG_SPDDL_TRY ON NGM_NEG_SPDDL(V);
Create success.
$T0> ROLLBACK TO SAVEPOINT NGM_NEG_SP;
[ERR-11016 : Savepoint not found]
$T0> DROP INDEX NGM_NEG_SPDDL_OK;
Drop success.
$T0> ROLLBACK TO SAVEPOINT NGM_NEG_SP;
[ERR-11016 : Savepoint not found]
$T0> UPDATE NGM_NEG_SPDDL SET K = 'K-122' WHERE P = 21;
1 row updated.
$T0> ROLLBACK;
Rollback success.
$T0> AUTOCOMMIT ON;
Set autocommit on success.

$T0> SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_SPDDL_%';
AFTER_REJECT_INDEX_COUNT 
---------------------------
1                    
1 row selected.
$T0> SELECT INDEX_NAME, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_NEG_SPDDL_OK';
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
INDEX_TABLE_ID 
-----------------
No rows selected.
$T0> SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_NEG_SPDDL_%';
HIDDEN_FALLBACK_COUNT 
------------------------
0                    
1 row selected.
$T0> SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGM_NEG_SPDDL_%'
            OR INDEX_NAME LIKE '$GIR_NGM_NEG_SPDDL_%');
HIDDEN_FALLBACK_INDEX_COUNT 
------------------------------
