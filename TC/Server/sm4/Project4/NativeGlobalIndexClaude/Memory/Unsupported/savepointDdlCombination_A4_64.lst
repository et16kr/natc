$T0> ##################################
$T0> SECTOR 3; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> ROLLBACK;
$T0> AUTOCOMMIT ON;
$T0> DROP TABLE NGM_NEG_SPDDL;
$T0> SKIP END;

