$T0> CREATE TABLE NGM_NEG_DDLCOMB_TRY
    (
        P INTEGER,
        K VARCHAR(32),
        V INTEGER,
        CONSTRAINT NGM_NEG_DDLCOMB_PK PRIMARY KEY(K)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
[ERR-31022 : The name is already used by an existing object.]
