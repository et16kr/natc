$T0> select * from
  (
    select /*+ index(t1, gidx_b) */ i1, b1 from t1 where b1 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, b1 from t1 where b1 is not null
  )
  order by 1;
I1          B1                   
------------------------------------
No rows selected.

