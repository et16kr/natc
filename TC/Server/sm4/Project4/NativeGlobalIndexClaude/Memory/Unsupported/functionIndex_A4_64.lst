 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Native Global Index - environment helpers
$T0> #
$T0> # 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
$T0> # 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
$T0> #   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
$T0> #   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 허용한다.
$T0> #

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
$T0> # off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
$T0> # 기존과 동일하게 거부되어야 한다.
$T0> #

$T0> #
$T0> # 현재 설정 확인.
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - memory partitioned table helpers
$T0> #
$T0> # 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
$T0> # (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
$T0> # 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
$T0> #
$T0> # 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
$T0> # 메모리 테이블스페이스에 있다.
$T0> ###########################################################################

$T0> #
$T0> # 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
$T0> #
$T0> # @aPartType : range | hash | list
$T0> # @aKeyType  : 파티션 키 컬럼 타입
$T0> # @aColType  : 나머지 컬럼 타입
$T0> #
$T0> # 컬럼 구성: i1(파티션 키), i2, i3, i4
$T0> #

$T0> #
$T0> # 파티션을 서로 다른 메모리 테이블스페이스에 흩어 놓는다.
$T0> #
$T0> # 이 구성이 네이티브 글로벌 인덱스에서 가장 위험하다:
$T0> #   - rowOID 는 테이블스페이스 안에서만 유일하다. 서로 다른 TBS 의 두
$T0> #     로우가 같은 rowOID 를 가질 수 있고, tie-break 가 (tableOID, rowOID)
$T0> #     로 확장되지 않았다면 두 키를 같은 것으로 오인한다.
$T0> #   - variable 컬럼의 out-of-row piece 접근은 컬럼 서술자의 colSpace 로
$T0> #     테이블스페이스를 고른다. 보정이 없으면 다른 파티션 로우의 값을
$T0> #     엉뚱한 TBS 에서 읽는다(크래시가 아니라 조용한 오독).
$T0> #
$T0> # PREPARE_MEM_TBS() 로 만든 mem1/mem2/mem3 를 쓴다.
$T0> #

$T0> #
$T0> # 다중 TBS 테스트용 메모리 테이블스페이스를 만든다.
$T0> #

$T0> #
$T0> # range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
$T0> # i1: 파티션 키, i2/i3/i4: 값
$T0> #

$T0> #
$T0> # hash/list 파티션 테이블에 데이터를 넣는다.
$T0> #

$T0> ###########################################################################
$T0> # Native Global Index - integrity check helpers
$T0> #
$T0> # 구버전(PROJ-1624)은 숨김 테이블 $GIT_ 와 베이스 테이블을 FULL OUTER JOIN
$T0> # 해서 정합성을 검사했다. 네이티브 글로벌 인덱스에는 조인할 테이블이 없고
$T0> # 인덱스 내용을 SQL로 직접 볼 수 없으므로, 아래 세 가지를 조합해서 같은
$T0> # 목적을 달성한다.
$T0> #
$T0> #   1. 인덱스 경유 결과 vs 풀스캔 결과의 양방향 차집합 (CHECK_INDEX_SCAN)
$T0> #   2. 카운트/집계 교차 확인                          (CHECK_INDEX_COUNT)
$T0> #   3. 유니크 제약을 살아 있는 검사기로 사용          (각 케이스에서 직접)
$T0> #
$T0> # ★ 1번과 2번은 index 힌트가 실제로 글로벌 인덱스를 잡았을 때만 의미가
$T0> #   있다. 잡지 못하면 "풀스캔 minus 풀스캔" 이 되어 무조건 0행이고, 아무것도
$T0> #   시험하지 않으면서 통과한다.
$T0> #
$T0> #   옵티마이저가 글로벌 SCAN 후보를 아예 내지 않는 조합이 있다
$T0> #   (qmoPartition::isUsableNativeGlobalIndex):
$T0> #
$T0> #     (a) memory variable 컬럼(varchar/nvarchar/...)의 colSpace 가 논리
$T0> #         테이블과 파티션 사이에서 다를 때. 파티션이 서로 다른 메모리
$T0> #         테이블스페이스에 있으면 여기 걸린다. 키 컬럼이 아니어도,
$T0> #         테이블에 그런 컬럼이 하나라도 있으면 닫힌다.
$T0> #     (b) 파티션 프루닝이 일어났고 인덱스 키 컬럼에 variable 이 있을 때.
$T0> #     (c) PARALLEL 힌트가 붙었을 때.
$T0> #
$T0> #   이 경우 인덱스 자체는 살아 있고 유니크 제약도 계속 강제된다.
$T0> #   스캔 플랜만 후보에서 빠지고 종전대로 PCRD 가 선택된다.
$T0> #
$T0> #   그래서 위 조합에서는 CHECK_INDEX_SCAN 대신
$T0> #   CHECK_INDEX_SCAN_CLOSED_GATE 를 쓴다 — 플랜에 GLOBAL-INDEX 가
$T0> #   "없다"는 것을 .lst 에 명시적으로 남기고, 정합성은 유니크 제약과
$T0> #   풀스캔 집계로만 판정한다.
$T0> ###########################################################################

$T0> #
$T0> # 플랜 출력을 켠다. 어떤 접근 경로가 선택됐는지 .lst 에 남긴다.
$T0> #

$T0> #
$T0> # 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
$T0> # 두 select 모두 0행이어야 정상이다.
$T0> #
$T0> # @aTable  : 테이블 이름
$T0> # @aIndex  : 글로벌 인덱스 이름
$T0> # @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
$T0> # @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
$T0> #
$T0> # 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
$T0> # 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
$T0> # 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
$T0> # 출력을 위한 것뿐이다.
$T0> #
$T0> # 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
$T0> #       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
$T0> #       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
$T0> #

$T0> #
$T0> # null 행을 제외하고 비교한다. 키 컬럼에 null 이 섞인 경우에 쓴다.
$T0> #

$T0> #
$T0> # 플랜이 열리는 조합에서 쓴다.
$T0> # 차집합 비교 앞에 플랜을 먼저 남겨, 힌트가 실제로 글로벌 인덱스를
$T0> # 잡았다는 증거를 .lst 에 박아 둔다. 플랜에 GLOBAL-INDEX 가 사라지면
$T0> # 차집합이 0행이어도 이 케이스는 FAIL 이 된다.
$T0> #

$T0> #
$T0> # 플랜 게이트가 닫히는 조합에서 쓴다(위 (a)/(b)/(c)).
$T0> #
$T0> # 여기서는 차집합 비교가 무의미하다 — 양쪽 다 풀스캔이 되어 항상 0행이다.
$T0> # 대신 두 가지를 기록한다:
$T0> #   1. 힌트를 줘도 플랜에 GLOBAL-INDEX 가 나오지 않는다는 사실
$T0> #      (게이트 판정이 바뀌면 여기서 드러난다)
$T0> #   2. 값 자체는 풀스캔으로 확인
$T0> #
$T0> # 인덱스가 실제로 정합인지는 이 조합에서 유니크 제약으로만 증명할 수 있다.
$T0> # 호출하는 쪽에서 중복 삽입 시험을 반드시 함께 둘 것.
$T0> #

$T0> #
$T0> # 카운트와 집계를 교차 확인한다.
$T0> # 인덱스가 어떤 파티션의 키를 빠뜨리거나 유령 키를 갖고 있으면 어긋난다.
$T0> #

$T0> #
$T0> # 파티션별 행 수의 합이 전체와 같은지 확인한다.
$T0> # 파티션 3개 + default 구성(p1,p2,p3)을 전제한다.
$T0> #

$T0> #
$T0> # 위 검사를 한 번에 수행한다. 시나리오 끝마다 호출한다.
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - catalog inspection helpers
$T0> #
$T0> # 구버전(PROJ-1624)의 meta 테스트는 "숨김 객체가 이렇게 보인다"를
$T0> # 검증했다. 네이티브에서는 검증 방향이 정반대다: 숨김 객체가
$T0> # 생기지 않아야 하고, 대신 SYS_PART_INDICES_ 에 판별자 행이 하나 있어야
$T0> # 한다.
$T0> ###########################################################################

$T0> #
$T0> # 숨김 글로벌 인덱스 객체가 하나도 없어야 한다.
$T0> # 구버전은 여기서 $GIT_/$GIK_/$GIR_ 가 줄줄이 나왔다.
$T0> #

$T0> #
$T0> # SYS_INDICES_ 에서 본 글로벌 인덱스의 모습.
$T0> #
$T0> # 네이티브 글로벌 인덱스는 숨김 방식과 마찬가지로 IS_PARTITIONED = 'F'
$T0> # 이지만, INDEX_TABLE_ID 가 0 이어야 한다(숨김 테이블이 없으므로).
$T0> # 숨김 방식은 INDEX_TABLE_ID 가 0 이 아니다. 이것이 두 방식의
$T0> # 카탈로그 상 구분점이다.
$T0> #

$T0> #
$T0> # SYS_PART_INDICES_ 의 판별자 행.
$T0> #
$T0> # 네이티브 글로벌 인덱스는 여기에 행을 하나 남긴다. 캐시 로더가
$T0> # IS_PARTITIONED='F' 를 보고 무조건 non-partitioned 로 하드코딩하기
$T0> # 때문에, 재기동 후에도 네이티브임을 알아보려면 이 행이 필요하다.
$T0> # 숨김 방식은 이 행을 만들지 않는다.
$T0> #

$T0> #
$T0> # SYS_INDEX_PARTITIONS_ 에는 행이 없어야 한다.
$T0> # 물리 인덱스가 파티션별로 존재하지 않는 것이 로컬 인덱스와의 구분점이다.
$T0> #

$T0> #
$T0> # 한 테이블의 인덱스 카탈로그 전경.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = 함수 기반 인덱스와 그 밖의 키 컬럼 형태.
$T0> #                        구버전 bugs/function_index.tc 에 해당한다.
$T0> #
$T0> #   ★ 이 케이스가 결함을 하나 찾았다. CREATE INDEX ~ ON t( <식> ) 은
$T0> #     문장 하나로 보이지만 두 단계다 -- 식의 값을 담을 숨김 컬럼을
$T0> #     ALTER TABLE ADD COLUMN 으로 먼저 붙이고 그 컬럼에 인덱스를 만든다.
$T0> #     메모리 파티션드 테이블 + 프로퍼티 ON 에서 이 조합이 서버를 내렸다
$T0> #     (smcRecord::insertVersion 의 IDE_ERROR_MSG). 비파티션드에서도,
$T0> #     LOCAL 로도, 프로퍼티 OFF 에서도 멀쩡했으니 네이티브 글로벌 경로
$T0> #     고유였다.
$T0> #
$T0> #     설계가 다룬 적 없는 조합이라 구현이 아니라 거부로 닫혔다.
$T0> #     지금 기대는 **ERR-314AD (UNSUPPORTED_KEY: FUNCTION-BASED key)** 이고,
$T0> #     같은 식을 LOCAL 로 만드는 것은 종전대로 된다.
$T0> #     프로젝트 회귀는 sql-level-check.sh I92~I99 가 고정한다.
$T0> # Project ID           = Native Global Index (memory)
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; FUNCTION BASED GLOBAL INDEX
$T0> ##################################
$T0> # 표현식을 키로 하는 글로벌 인덱스.


$T0> create table t1( i1 integer, i2 integer, c1 varchar(50), d1 date )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index gidx1 on t1( i2 * 2 );
[ERR-314AD : A native global index cannot be created with this index option or key column type: FUNCTION-BASED key.]
$T0> create index gidx2 on t1( upper(c1) );
[ERR-314AD : A native global index cannot be created with this index option or key column type: FUNCTION-BASED key.]
$T0> create index gidx3 on t1( substr(c1, 1, 3) );
[ERR-314AD : A native global index cannot be created with this index option or key column type: FUNCTION-BASED key.]

$T0> desc t1;
[ TABLESPACE : SYS_TBS_MEM_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER         FIXED       
I2                                       INTEGER         FIXED       
C1                                       VARCHAR(50)     VARIABLE    
D1                                       DATE            FIXED       
T1 has no index
T1 has no primary key
$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
IS_UNIQUE  IS_PARTITIONED  INDEX_TABLE_ID_KIND  
----------------------------------------------------
No rows selected.
$T0> select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PARTITION_TYPE 
-----------------
No rows selected.
$T0> select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PART_INDEX_CNT       
-----------------------
No rows selected.
$T0> # 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
$T0> select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
No rows selected.

$T0> # 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
$T0> select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> insert into t1 select level,       level,       'abc' || level, sysdate from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 100, level + 100, 'DEF' || level, sysdate from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 200, level + 200, 'ghi' || level, sysdate from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.

$T0> ##################################
$T0> # SECTOR; QUERY THROUGH FUNCTION INDEX
$T0> ##################################
$T0> # 표현식과 정확히 같은 형태로 질의해야 인덱스를 쓸 수 있다.

$T0> select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 * 2 = 10 order by i1;
I1          I2          
---------------------------
5           5           
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 * 2 = 10 order by i1;
I1          I2          
---------------------------
5           5           
1 row selected.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 * 2 > 400;
COUNT                
-----------------------
30                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 * 2 > 400;
COUNT                
-----------------------
30                   
1 row selected.

$T0> select /*+ index(t1, gidx2) */ i1, c1 from t1 where upper(c1) = 'ABC5' order by i1;
I1          C1                                                  
-------------------------------------------------------------------
5           abc5                                                
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ i1, c1 from t1 where upper(c1) = 'ABC5' order by i1;
I1          C1                                                  
-------------------------------------------------------------------
5           abc5                                                
1 row selected.

$T0> select /*+ index(t1, gidx3) */ count(*) from t1 where substr(c1, 1, 3) = 'abc';
COUNT                
-----------------------
30                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where substr(c1, 1, 3) = 'abc';
COUNT                
-----------------------
30                   
1 row selected.

$T0> select /*+ index(t1, gidx3) */ count(*) from t1 where substr(c1, 1, 3) = 'DEF';
COUNT                
-----------------------
30                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where substr(c1, 1, 3) = 'DEF';
COUNT                
-----------------------
30                   
1 row selected.

$T0> ##################################
$T0> # SECTOR; FUNCTION INDEX AFTER DML
$T0> ##################################
$T0> # 기반 컬럼이 바뀌면 표현식 값도 바뀌므로 키가 갱신되어야 한다.

$T0> update t1 set i2 = i2 + 1000 where i1 < 10;
9 rows updated.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx1) */ i1, i2, i2 * 2 from t1 where i2 * 2 >= 2000 order by i1;
I1          I2          I2 * 2                 
---------------------------------------------------
1           1001        2002                   
2           1002        2004                   
3           1003        2006                   
4           1004        2008                   
5           1005        2010                   
6           1006        2012                   
7           1007        2014                   
8           1008        2016                   
9           1009        2018                   
9 rows selected.
$T0> select /*+ FULL SCAN(t1) */ i1, i2, i2 * 2 from t1 where i2 * 2 >= 2000 order by i1;
I1          I2          I2 * 2                 
---------------------------------------------------
1           1001        2002                   
2           1002        2004                   
3           1003        2006                   
4           1004        2008                   
5           1005        2010                   
6           1006        2012                   
7           1007        2014                   
8           1008        2016                   
9           1009        2018                   
9 rows selected.

$T0> update t1 set c1 = 'zzz' || i1 where i1 >= 200 and i1 < 210;
9 rows updated.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx3) */ count(*) from t1 where substr(c1, 1, 3) = 'zzz';
COUNT                
-----------------------
9                    
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where substr(c1, 1, 3) = 'zzz';
COUNT                
-----------------------
9                    
1 row selected.

$T0> delete from t1 where i1 between 100 and 110;
10 rows deleted.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 * 2 > 0;
COUNT                
-----------------------
80                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 * 2 > 0;
COUNT                
-----------------------
80                   
1 row selected.

$T0> ##################################
$T0> # SECTOR; UNIQUE FUNCTION INDEX
$T0> ##################################
$T0> # 표현식 값이 파티션을 넘어 유일해야 한다.


$T0> create table t1( i1 integer, i2 integer, c1 varchar(50) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create unique index t1_fuk on t1( upper(c1) );
[ERR-314AD : A native global index cannot be created with this index option or key column type: FUNCTION-BASED key.]

$T0> insert into t1 values (10, 1, 'abc');
1 row inserted.
$T0> commit;
Commit success.

$T0> # 다른 파티션에 대소문자만 다른 값 -> 표현식 값이 같으므로 실패해야 한다
$T0> insert into t1 values (150, 2, 'ABC');
1 row inserted.
$T0> insert into t1 values (250, 3, 'AbC');
1 row inserted.

$T0> # 다른 값 -> 성공
$T0> insert into t1 values (150, 2, 'xyz');
1 row inserted.
$T0> commit;
Commit success.

$T0> select i1, c1, upper(c1) from t1 order by i1;
I1          C1                                                  
-------------------------------------------------------------------
UPPER(C1)                                           
------------------------------------------------------
10          abc                                                 
ABC                                                 
150         ABC                                                 
ABC                                                 
150         xyz                                                 
XYZ                                                 
250         AbC                                                 
ABC                                                 
4 rows selected.

$T0> ##################################
$T0> # SECTOR; DATE AND NUMERIC KEY
$T0> ##################################
$T0> # 표현식이 아닌 일반 타입도 함께 확인한다.


$T0> create table t1( i1 integer, d1 date, n1 numeric(20,5), b1 bigint )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index gidx_d on t1(d1);
Create success.
$T0> create index gidx_n on t1(n1);
Create success.
$T0> create index gidx_b on t1(b1);
Create success.

$T0> insert into t1 values (10,  to_date('2020-01-01', 'YYYY-MM-DD'), 1.5,      1000000000);
1 row inserted.
$T0> insert into t1 values (150, to_date('2021-06-15', 'YYYY-MM-DD'), 2.25,     2000000000);
1 row inserted.
$T0> insert into t1 values (250, to_date('2022-12-31', 'YYYY-MM-DD'), -3.125,   3000000000);
1 row inserted.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx_d) */ i1, d1 from t1 order by d1;
I1          D1                   
------------------------------------
10          01-JAN-2020          
150         15-JUN-2021          
250         31-DEC-2022          
3 rows selected.
$T0> select /*+ FULL SCAN(t1) */ i1, d1 from t1 order by d1;
I1          D1                   
------------------------------------
10          01-JAN-2020          
150         15-JUN-2021          
250         31-DEC-2022          
3 rows selected.

$T0> select /*+ index(t1, gidx_n) */ i1, n1 from t1 order by n1;
I1          N1          
---------------------------
250         -3.125      
10          1.5         
150         2.25        
3 rows selected.
$T0> select /*+ FULL SCAN(t1) */ i1, n1 from t1 order by n1;
I1          N1          
---------------------------
250         -3.125      
10          1.5         
150         2.25        
3 rows selected.

$T0> select /*+ index(t1, gidx_b) */ i1, b1 from t1 order by b1;
I1          B1                   
------------------------------------
10          1000000000           
150         2000000000           
250         3000000000           
3 rows selected.
$T0> select /*+ FULL SCAN(t1) */ i1, b1 from t1 order by b1;
I1          B1                   
------------------------------------
10          1000000000           
150         2000000000           
250         3000000000           
3 rows selected.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx_n) */ i1, n1 from t1 where n1 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, n1 from t1 where n1 is not null
  )
  order by 1;
I1          N1          
---------------------------
No rows selected.

