###########################################################################
# TestCase Description = ALL INDEX ENABLE/DISABLE 와 테이블스페이스
#                        OFFLINE/ONLINE.
#
#   코드 리뷰 P1-1 이 지목한 두 지점이다. 둘 다 런타임 인덱스 헤더를
#   다시 만드는 경로이고, 네이티브 글로벌 인덱스는 그 경로에 파티션
#   디렉터리를 다시 세우는 진입점이 아직 없다.
#
#     ALL INDEX ENABLE/DISABLE -> ERR-314B2 로 명시 거부
#                                 (qdbAlter.cpp:2011, 2046-2048)
#     TABLESPACE OFFLINE/ONLINE -> 인덱스를 fail-closed 로 닫고 ONLINE 은
#                                 성공한다. 닫힌 인덱스로 조회하면 에러가
#                                 나야지, 조용히 틀린 답이 나오면 안 된다.
#
#   V2 의 J13/J14 가 이 둘을 기능으로 대체하기로 되어 있다. 그때 기대가
#   "거부" 에서 "성공" 으로 바뀌므로, 이 파일은 그 전환을 감시하는
#   자리이기도 하다.
#
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;
INCLUDE ../../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
CALL FINALIZE_MEM_TBS();
SKIP BEGIN;
drop tablespace memoff including contents and datafiles;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; ALL INDEX ON A TABLE WITH A GLOBAL INDEX
##################################
# ERR-314B2 로 거부되어야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

alter table t1 all index disable;

alter table t1 all index enable;

# 거부됐으므로 인덱스는 그대로 살아 있어야 한다
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; ALL INDEX WITH BOTH GLOBAL AND LOCAL
##################################
# 로컬 인덱스가 섞여 있어도 글로벌이 하나라도 있으면 거부되어야 한다.

create index lidx1 on t1(i3) local;

alter table t1 all index disable;
alter table t1 all index enable;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; ALL INDEX AFTER DROPPING THE GLOBAL INDEX
##################################
# 글로벌 인덱스가 없어지면 기존 동작으로 돌아가야 한다.

drop index gidx1;

alter table t1 all index disable;
alter table t1 all index enable;

CALL SELECT_INDEX_META( "t1" );
CALL CHECK_INDEX_SCAN( "t1", "lidx1", "i1, i3", "i3 is not null" );

##################################
# SECTOR; ALL INDEX ON A LOCAL-ONLY TABLE (회귀)
##################################
# 글로벌 인덱스가 전혀 없는 테이블은 종전 그대로여야 한다.

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data;

create index lidx2 on t2(i2) local;

insert into t2 select level, level, level from dual connect by level <= 50;
commit;

alter table t2 all index disable;
alter table t2 all index enable;

select count(*) from t2;
CALL SELECT_INDEX_META( "t2" );

##################################
# SECTOR; TABLESPACE OFFLINE / ONLINE
##################################
# 파티션 하나가 별도 테이블스페이스에 있고, 그 테이블스페이스를 내렸다
# 올린다.
#
# 이전에는 ONLINE 경로가 런타임 인덱스 헤더를 다시 만들면서 네이티브
# 글로벌 인덱스를 처리하지 못해 테이블스페이스가 영영 못 올라왔다.
# 지금은 인덱스를 fail-closed 로 닫고 ONLINE 자체는 성공해야 한다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create memory tablespace memoff size 32M autoextend on checkpoint path 'dbs';

create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace sys_tbs_mem_data,
  partition p2 values default tablespace memoff
);

create index gidx1 on t1(i2);

insert into t1 values (10,  1, 1);
insert into t1 values (150, 2, 2);
commit;

# 내리기 전에는 정상
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;

alter tablespace memoff offline;

# 내려간 동안의 조회. 조용히 틀린 답이 나오면 안 된다.
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;

alter tablespace memoff online;

# 올라온 뒤에는 다시 정상이어야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;

CALL SELECT_INDEX_META( "t1" );

# 올라온 뒤 DML
insert into t1 values (160, 3, 3);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

##################################
# SECTOR; OFFLINE / ONLINE WITH A UNIQUE GLOBAL INDEX
##################################
# 유일성 강제가 되살아나는지가 이 섹터의 초점이다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace sys_tbs_mem_data,
  partition p2 values default tablespace memoff
);

create unique index t1_uk on t1(i2);

insert into t1 values (10,  100, 1);
insert into t1 values (150, 200, 2);
commit;

alter tablespace memoff offline;
alter tablespace memoff online;

# ★ 2026-08-13 (V3 D-3 / O-4) 이후 이 자리의 기대가 바뀌었다.
#
#   ONLINE 은 외부(다른 테이블스페이스) 멤버 파티션을 가진 글로벌 인덱스를
#   재구축하지 못하고 INVALID 로 닫는다. 그 상태에서 DML 의 UNIQUE 검사가
#   그 인덱스를 계속 읽던 것이 O-4 였다 -- 파티션을 넘는 중복이 조용히
#   커밋되고 그 인스턴스가 다시 뜨지 못했다.
#
#   수정 뒤에는 INVALID 인덱스를 건드리는 DML 이 전부 ERR-11110 으로
#   막힌다(fail-closed). 그래서 이 섹터는 두 상태를 나눠 잰다:
#     1. INVALID 동안: 중복이든 새 값이든 DML 은 거부된다
#     2. REBUILD 뒤  : 유일성 강제가 되살아난다
#   근거: v3-online-invalid-unique.md 8.3, v3-gr03-layers.md

# 1. INVALID 동안 -- 중복도 새 값도 ERR-11110
insert into t1 values (250, 100, 3);
insert into t1 values (250, 300, 3);

# 2. 되살린다
alter index t1_uk rebuild;

# 파티션을 넘는 중복 -> 여전히 실패해야 한다
insert into t1 values (250, 100, 3);

# 새 값 -> 성공
insert into t1 values (250, 300, 3);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
