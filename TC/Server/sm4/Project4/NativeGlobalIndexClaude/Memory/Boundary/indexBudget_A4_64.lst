 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Native Global Index - environment helpers
$T0> #
$T0> # 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
$T0> # 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
$T0> #   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
$T0> #   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 허용한다.
$T0> #
$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
$T0> # off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
$T0> # 기존과 동일하게 거부되어야 한다.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = 인덱스 비트 예산 (ERR-314AC).
$T0> #
$T0> #   DML 커서는 파티션 하나를 열고 인덱스별 비트를 ULong 하나에 담는다.
$T0> #   그래서 전체 예산이 64 개다(SMI_INDEX_BIT_BUDGET).
$T0> #
$T0> #   비트 배치:
$T0> #     로컬 인덱스 i   -> 비트 (63 - i)
$T0> #     글로벌 인덱스 g -> 비트 (63 - sIndexCnt - g)
$T0> #
$T0> #   검사식 (qdx.cpp:2072):
$T0> #     ( 파티션들 중 최대 로컬 인덱스 수 ) + ( 글로벌 인덱스 수 ) + 1 > 64
$T0> #   -> ERR-314AC
$T0> #
$T0> #   경계가 정확한지가 이 파일의 초점이다. 63 + 0 + 1 = 64 는 통과하고
$T0> #   64 + 0 + 1 = 65 는 거부되어야 한다. 한 칸 어긋나면 비트가 겹쳐
$T0> #   조용히 엉뚱한 인덱스를 건드린다.
$T0> #
$T0> #   프로젝트 회귀 스크립트에는 이 경계를 실제로 미는 케이스가 없다.
$T0> #
$T0> #   주의: 이 케이스는 인덱스를 수십 개 만든다. 다른 케이스보다 느리다.
$T0> #
$T0> # Project ID           = Native Global Index (memory)
$T0> ###########################################################################

$T0> #
$T0> # 컬럼이 많은 메모리 파티션드 테이블.
$T0> #

$T0> #
$T0> # 로컬 인덱스 하나. 컬럼 번호와 인덱스 이름을 맞춘다.
$T0> #

$T0> #
$T0> # 로컬 인덱스 63 개. 여기에 글로벌 하나를 더하면 정확히 예산이다.
$T0> #

$T0> #
$T0> # 지금 테이블에 인덱스가 몇 개인지.
$T0> #

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; AT THE BOUNDARY - 63 LOCAL + 1 GLOBAL
$T0> ##################################
$T0> # 63 + 0 + 1 = 64. 예산과 정확히 같으므로 통과해야 한다.


$T0> create table t1( i1 integer, c1 integer, c2 integer, c3 integer, c4 integer, c5 integer, c6 integer, c7 integer, c8 integer, c9 integer, c10 integer, c11 integer, c12 integer, c13 integer, c14 integer, c15 integer, c16 integer, c17 integer, c18 integer, c19 integer, c20 integer, c21 integer, c22 integer, c23 integer, c24 integer, c25 integer, c26 integer, c27 integer, c28 integer, c29 integer, c30 integer, c31 integer, c32 integer, c33 integer, c34 integer, c35 integer, c36 integer, c37 integer, c38 integer, c39 integer, c40 integer, c41 integer, c42 integer, c43 integer, c44 integer, c45 integer, c46 integer, c47 integer, c48 integer, c49 integer, c50 integer, c51 integer, c52 integer, c53 integer, c54 integer, c55 integer, c56 integer, c57 integer, c58 integer, c59 integer, c60 integer, c61 integer, c62 integer, c63 integer, c64 integer, c65 integer, c66 integer, c67 integer, c68 integer, c69 integer, c70 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data;
Create success.
$T0> select count(*) index_cnt
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = 'T1'
    and t.user_id = user_id();
INDEX_CNT            
-----------------------
63                   
1 row selected.

$T0> create index gidx1 on t1(c70);
Create success.

$T0> select count(*) index_cnt
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = 'T1'
    and t.user_id = user_id();
INDEX_CNT            
-----------------------
64                   
1 row selected.

$T0> # 만들어졌으면 동작해야 한다
$T0> insert into t1 (i1, c70) values (10, 1);
1 row inserted.
$T0> insert into t1 (i1, c70) values (150, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c70 >= 0;
COUNT                
-----------------------
2                    
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where c70 >= 0;
COUNT                
-----------------------
2                    
1 row selected.

$T0> ##################################
$T0> # SECTOR; ONE OVER - A SECOND GLOBAL INDEX
$T0> ##################################
$T0> # 63 + 1 + 1 = 65 > 64. 거부되어야 한다 (ERR-314AC).

$T0> create index gidx2 on t1(c69);
[ERR-314AC : The number of indexes on a partition plus the number of global indexes on the partitioned table exceeds the maximum of 64.]

$T0> select count(*) index_cnt
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = 'T1'
    and t.user_id = user_id();
INDEX_CNT            
-----------------------
64                   
1 row selected.

$T0> # 첫 글로벌 인덱스는 그대로 살아 있어야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where c70 >= 0;
COUNT                
-----------------------
2                    
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where c70 >= 0;
COUNT                
-----------------------
2                    
1 row selected.

$T0> ##################################
