###########################################################################
# TestCase Description = 프로퍼티를 런타임에 껐다 켤 때의 동작.
#
#   코드 리뷰 P1-4 가 지목한 지점이다. MEM_GLOBAL_INDEX_ENABLE 은
#   ALTER SYSTEM 으로 바뀌는 런타임 프로퍼티다(IDP_ATTR_RD_WRITABLE).
#   프로퍼티는 "만들 수 있는가" 만 결정해야 하고, 이미 만들어진 인덱스의
#   동작을 바꿔서는 안 된다.
#
#   껐을 때 이미 있는 글로벌 인덱스가
#     - 조회에서 빠지거나
#     - 유일성 강제를 멈추거나
#     - DML 에서 갱신되지 않으면
#   데이터가 조용히 깨진다. 다시 켰을 때 그 구멍이 드러난다.
#
#   또 하나: 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은
#   재기동하면 파일 값(기본 0)으로 돌아간다. 그래서 각 케이스는 자기
#   PREPARE 에서 켠다.
#
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;
INCLUDE ../../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL FINALIZE_MEM_TBS();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();
CALL SHOW_GLOBAL_INDEX_PROPERTY();

##################################
# SECTOR; CREATE WHILE ON
##################################

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create unique index t1_uk on t1(i3);

CALL FILL_RANGE_DATA();

CALL SELECT_INDEX_META( "t1" );
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; TURN OFF - EXISTING INDEX MUST KEEP WORKING
##################################
# ★ 이 섹터가 P1-4 의 핵심이다.

CALL DISABLE_GLOBAL_INDEX();
CALL SHOW_GLOBAL_INDEX_PROPERTY();

# 카탈로그는 그대로여야 한다
CALL SELECT_INDEX_META( "t1" );

# 조회도 그대로여야 한다
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "gidx1", "i2" );

# 삽입이 인덱스에 반영되어야 한다
insert into t1 values (50, 5555, 5555, 1);
commit;

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 5555;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 = 5555;

# 유일성이 계속 강제되어야 한다 -> 실패해야 한다
insert into t1 values (150, 6666, 5555, 1);

# 갱신도 반영되어야 한다
update t1 set i2 = 7777 where i1 = 50;
commit;

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 5555;
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 7777;

# 삭제도 반영되어야 한다
delete from t1 where i1 = 50;
commit;

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 7777;
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; CREATE WHILE OFF IS REFUSED
##################################
# 껐으므로 새로 만드는 것은 거부되어야 한다 (ERR-313D0).
# 기존 인덱스가 살아 있는 것과 별개다.

create index gidx2 on t1(i4);

# LOCAL 은 프로퍼티와 무관하다
create index lidx2 on t1(i4) local;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; DROP WHILE OFF
##################################
# 지우는 것은 프로퍼티와 무관하게 되어야 한다.
# (못 지우면 껐다는 이유로 객체가 갇힌다)

drop index lidx2;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; TURN BACK ON
##################################
# 다시 켰을 때 새로 만들 수 있어야 하고, 기존 인덱스와 공존해야 한다.

CALL ENABLE_GLOBAL_INDEX();
CALL SHOW_GLOBAL_INDEX_PROPERTY();

create index gidx2 on t1(i4);

CALL SELECT_INDEX_META( "t1" );
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx2", "i1, i4", "i4 is not null" );

##################################
# SECTOR; OFF DURING DML, ON AFTER
##################################
# 껐다 켜는 동안의 DML 이 전부 반영됐는지 한 번에 확인한다.
# 껐을 때 넣은 행이 인덱스에 없으면 여기서 차집합이 어긋난다.

CALL DISABLE_GLOBAL_INDEX();

insert into t1 select level + 300, level + 300, level + 300, level + 300
  from dual connect by level <= 20;
commit;

delete from t1 where i1 between 1 and 10;
commit;

update t1 set i2 = i2 + 1 where i1 between 100 and 110;
commit;

CALL ENABLE_GLOBAL_INDEX();

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "gidx1", "i2" );
CALL CHECK_PARTITION_COUNT( "t1" );

##################################
# SECTOR; OFF DOES NOT AFFECT DDL ON OTHER TABLES
##################################
# 껐을 때 로컬 인덱스 경로가 종전 그대로인지.

CALL DISABLE_GLOBAL_INDEX();

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data;

create index lidx1 on t2(i2) local;

insert into t2 select level, level from dual connect by level <= 50;
commit;

CALL SELECT_INDEX_META( "t2" );
CALL CHECK_INDEX_SCAN( "t2", "lidx1", "i1, i2", "i2 is not null" );

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
