$T0> ##################################
$T0> # SECTOR; DISK PARTITIONED TABLE
$T0> ##################################
$T0> # 디스크 파티션드 테이블은 이 프로젝트(메모리 V1)의 대상이 아니다.
$T0> # 기존 방식이 그대로 동작해야 한다.


$T0> create table t3( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_disk_data;
Create success.

$T0> create index t3_lidx on t3(i2) local;
Create success.

$T0> insert into t3 select level,       level,       level from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t3 select level + 100, level + 100, level from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t3 select level + 200, level + 200, level from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.

$T0> select count(*) from t3;
COUNT                
-----------------------
90                   
1 row selected.
$T0> select i1, i2 from t3 where i2 = 15 order by i1;
I1          I2          
---------------------------
15          15          
1 row selected.

$T0> desc t3;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T3_LIDX                                  BTREE                  I2 ASC
T3 has no primary key

$T0> ##################################
$T0> # SECTOR; PROPERTY ON DOES NOT CHANGE LOCAL PATHS
$T0> ##################################
$T0> # 프로퍼티를 켜도 글로벌 인덱스를 만들지 않은 테이블은 동작이
$T0> # 그대로여야 한다.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

