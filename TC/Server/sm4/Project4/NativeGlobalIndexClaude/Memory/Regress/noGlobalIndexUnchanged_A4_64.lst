PROJECT ( COLUMN_COUNT: 2, TUPLE_SIZE: 8, COST: BLOCKED )
 SCAN ( TABLE: SYS.T2, INDEX: SYS.T2_IDX1, RANGE SCAN, ACCESS: 0, COST: BLOCKED )
