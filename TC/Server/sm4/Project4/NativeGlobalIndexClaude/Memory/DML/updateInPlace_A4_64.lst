 GROUP-AGGREGATION ( ITEM_SIZE: BLOCKED, GROUP_COUNT: 1, BUCKET_COUNT: 1, ACCESS: 1, COST: BLOCKED )
  SCAN ( TABLE: SYS.T1, INDEX: SYS.GIDX1, GLOBAL-INDEX, RANGE SCAN, ACCESS: 90, COST: BLOCKED )
------------------------------------------------------------

$T0> alter session set explain plan = off;
Alter success.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) full_cnt,
         count(i2) full_key_cnt,
         nvl(sum(i2), -1) full_sum,
         nvl(min(i2), -1) full_min,
         nvl(max(i2), -1) full_max
  from t1;
FULL_CNT             FULL_KEY_CNT         FULL_SUM             FULL_MIN    
--------------------------------------------------------------------------------
FULL_MAX    
--------------
90                   90                   25395                101         
530         
1 row selected.

$T0> select /*+ index(t1, gidx1) */ count(i2) idx_key_cnt,
         nvl(sum(i2), -1) idx_sum,
         nvl(min(i2), -1) idx_min,
         nvl(max(i2), -1) idx_max
  from t1
  where i2 is not null;
IDX_KEY_CNT          IDX_SUM              IDX_MIN     IDX_MAX     
-----------------------------------------------------------------------
90                   25395                101         530         
1 row selected.

$T0> # 옛 값으로 조회하면 아무것도 안 나와야 한다 (유령 키가 있으면 나온다)
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 1 and 30;
COUNT                
-----------------------
0                    
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 between 1 and 30;
COUNT                
-----------------------
0                    
1 row selected.

$T0> # 새 값으로 조회하면 다 나와야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 501 and 530;
COUNT                
-----------------------
30                   
1 row selected.
$T0> select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 between 501 and 530;
COUNT                
-----------------------
30                   
1 row selected.

$T0> ##################################
$T0> # SECTOR; UPDATE ACROSS ALL PARTITIONS
$T0> ##################################
$T0> # 전 파티션의 키를 한 문장으로 바꾼다.

