1 row selected.

$T0> ##################################
$T0> # SECTOR; UNIQUE WITH NULL
$T0> ##################################
$T0> # 유니크 인덱스에서 NULL 은 여러 개 허용된다.
$T0> # 서로 다른 파티션의 NULL 이 충돌로 판정되면 안 된다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create unique index t1_uk on t1(i2);
Create success.

$T0> insert into t1 values (10, null, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, null, 2, 2);
1 row inserted.
$T0> insert into t1 values (250, null, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select count(*) from t1 where i2 is null;
COUNT                
-----------------------
3                    
1 row selected.
$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
3                    
1 row selected.

$T0> select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
  union all
  select 'P2', count(*) from t1 partition (p2)
  union all
  select 'P3', count(*) from t1 partition (p3)
  order by 1;
PART_NAME  PART_CNT             
-----------------------------------
P1  1                    
P2  1                    
P3  1                    
3 rows selected.

$T0> # NULL 이 아닌 값은 여전히 유니크여야 한다
$T0> insert into t1 values (11, 100, 1, 1);
1 row inserted.
$T0> commit;
Commit success.
$T0> insert into t1 values (151, 100, 2, 2);
[ERR-11058 : The row already exists in a unique index.]

$T0> select count(*) from t1 where i2 = 100;
COUNT                
-----------------------
1                    
1 row selected.

$T0> ##################################
$T0> # SECTOR; COMPOSITE KEY WITH PARTIAL NULL
$T0> ##################################
$T0> # 복합 키의 일부만 NULL 인 경우.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index gidx1 on t1(i2, i3);
Create success.

$T0> insert into t1 values (10, 1, null, 1);
1 row inserted.
$T0> insert into t1 values (11, null, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, 2, null, 2);
1 row inserted.
$T0> insert into t1 values (151, null, 2, 2);
1 row inserted.
$T0> insert into t1 values (250, 3, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

