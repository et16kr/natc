$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2, i3 from t1 where i2 is not null and i3 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2, i3 from t1 where i2 is not null and i3 is not null
  )
  order by 1;
I1          I2          I3          
----------------------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2, i3 from t1 where i2 is not null and i3 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2, i3 from t1 where i2 is not null and i3 is not null
  )
  order by 1;
I1          I2          I3          
----------------------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
