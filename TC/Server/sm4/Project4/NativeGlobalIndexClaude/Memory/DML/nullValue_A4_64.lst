 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Native Global Index - environment helpers
$T0> #
$T0> # 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
$T0> # 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
$T0> #   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
$T0> #   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 허용한다.
$T0> #
$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
$T0> # off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
$T0> # 기존과 동일하게 거부되어야 한다.
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - memory partitioned table helpers
$T0> #
$T0> # 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
$T0> # (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
$T0> # 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
$T0> #
$T0> # 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
$T0> # 메모리 테이블스페이스에 있다.
$T0> ###########################################################################

$T0> #
$T0> # 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
$T0> #
$T0> # @aPartType : range | hash | list
$T0> # @aKeyType  : 파티션 키 컬럼 타입
$T0> # @aColType  : 나머지 컬럼 타입
$T0> #
$T0> # 컬럼 구성: i1(파티션 키), i2, i3, i4
$T0> #
$T0> #
$T0> # 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
$T0> # 두 select 모두 0행이어야 정상이다.
$T0> #
$T0> # @aTable  : 테이블 이름
$T0> # @aIndex  : 글로벌 인덱스 이름
$T0> # @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
$T0> # @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
$T0> #
$T0> # 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
$T0> # 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
$T0> # 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
$T0> # 출력을 위한 것뿐이다.
$T0> #
$T0> # 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
$T0> #       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
$T0> #       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
$T0> #
$T0> #
$T0> # 파티션별 행 수의 합이 전체와 같은지 확인한다.
$T0> # 파티션 3개 + default 구성(p1,p2,p3)을 전제한다.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = 인덱스 키 컬럼에 NULL 이 있을 때의 동작.
$T0> #                        인덱스 스캔이 NULL 행을 어떻게 다루는지에 따라
$T0> #                        정합성 검사 방식이 달라지므로 별도로 확인한다.
$T0> # Project ID           = Native Global Index (memory)
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; NULL IN ALL PARTITIONS
$T0> ##################################
$T0> # 파티션마다 NULL 키를 가진 행을 넣는다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 values (10, null, 1, 1);
1 row inserted.
$T0> insert into t1 values (11, 11, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, null, 2, 2);
1 row inserted.
$T0> insert into t1 values (151, 151, 2, 2);
1 row inserted.
$T0> insert into t1 values (250, null, 3, 3);
1 row inserted.
$T0> insert into t1 values (251, 251, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
6                    
1 row selected.
$T0> select count(*) null_cnt from t1 where i2 is null;
NULL_CNT             
-----------------------
3                    
1 row selected.
$T0> select count(*) notnull_cnt from t1 where i2 is not null;
NOTNULL_CNT          
-----------------------
3                    
1 row selected.

$T0> # NOT NULL 부분집합의 정합성
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # NULL 행도 조회되어야 한다
$T0> select i1, i2 from t1 where i2 is null order by i1;
I1          I2          
---------------------------
10                      
150                     
250                     
3 rows selected.
$T0> select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is null order by i1;
I1          I2          
---------------------------
10                      
150                     
250                     
3 rows selected.

$T0> # 전체(NULL 포함) 비교
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is null or i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is null or i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is null or i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is null or i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; ALL NULL
$T0> ##################################
$T0> # 전 파티션의 키가 전부 NULL 인 경우.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 values (10, null, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, null, 2, 2);
1 row inserted.
$T0> insert into t1 values (250, null, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select count(*) from t1;
COUNT                
-----------------------
3                    
1 row selected.
$T0> select count(*) from t1 where i2 is null;
COUNT                
-----------------------
3                    
1 row selected.
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is null;
COUNT                
-----------------------
3                    
1 row selected.

$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
3                    
1 row selected.

$T0> select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
  union all
  select 'P2', count(*) from t1 partition (p2)
  union all
  select 'P3', count(*) from t1 partition (p3)
  order by 1;
PART_NAME  PART_CNT             
-----------------------------------
P1  1                    
P2  1                    
P3  1                    
3 rows selected.

$T0> ##################################
$T0> # SECTOR; NULL TO VALUE AND BACK
$T0> ##################################
$T0> # NULL 키를 값으로 바꾸고 다시 NULL 로 되돌린다.

$T0> update t1 set i2 = 500 where i1 = 10;
1 row updated.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10          500         
150                     
250                     
3 rows selected.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> update t1 set i2 = null where i1 = 10;
1 row updated.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10                      
150                     
250                     
3 rows selected.
$T0> select count(*) from t1 where i2 is null;
COUNT                
-----------------------
