###########################################################################
# Native Global Index - environment helpers
#
# 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
# 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
#   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
#   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
###########################################################################

#
# 네이티브 글로벌 인덱스 생성을 허용한다.
#
DEF ENABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
}
#
# 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
# off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
# 기존과 동일하게 거부되어야 한다.
#
DEF DISABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
}
#
# 다중 TBS 테스트용 메모리 테이블스페이스를 만든다.
#
DEF PREPARE_MEM_TBS()
{
CALL FINALIZE_MEM_TBS();

create memory tablespace mem1 size 32M autoextend on checkpoint path 'dbs';
create memory tablespace mem2 size 32M autoextend on checkpoint path 'dbs';
create memory tablespace mem3 size 32M autoextend on checkpoint path 'dbs';
}
DEF FINALIZE_MEM_TBS()
{
SKIP BEGIN;
drop tablespace mem1 including contents and datafiles;
drop tablespace mem2 including contents and datafiles;
drop tablespace mem3 including contents and datafiles;
SKIP END;
}
#
# range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
# i1: 파티션 키, i2/i3/i4: 값
#
DEF FILL_RANGE_DATA()
{
insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
commit;
}
#
# 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
# 두 select 모두 0행이어야 정상이다.
#
# @aTable  : 테이블 이름
# @aIndex  : 글로벌 인덱스 이름
# @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
# @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
#
# 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
# 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
# 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
# 출력을 위한 것뿐이다.
#
# 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
#       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
#       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
  # 인덱스 경유 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;

  # 풀스캔 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;
}
#
# 플랜이 열리는 조합에서 쓴다.
# 차집합 비교 앞에 플랜을 먼저 남겨, 힌트가 실제로 글로벌 인덱스를
# 잡았다는 증거를 .lst 에 박아 둔다. 플랜에 GLOBAL-INDEX 가 사라지면
# 차집합이 0행이어도 이 케이스는 FAIL 이 된다.
#
DEF CHECK_INDEX_SCAN_OPEN_GATE( @aTable, @aIndex, @aCols, @aPred )
{
  alter session set explain plan = on;

  select /*+ index(@{aTable}, @{aIndex}) */ count(*) from @{aTable} where @{aPred};

  alter session set explain plan = off;

  CALL CHECK_INDEX_SCAN( "@{aTable}", "@{aIndex}", "@{aCols}", "@{aPred}" );
}
#
# 플랜 게이트가 닫히는 조합에서 쓴다(위 (a)/(b)/(c)).
#
# 여기서는 차집합 비교가 무의미하다 — 양쪽 다 풀스캔이 되어 항상 0행이다.
# 대신 두 가지를 기록한다:
#   1. 힌트를 줘도 플랜에 GLOBAL-INDEX 가 나오지 않는다는 사실
#      (게이트 판정이 바뀌면 여기서 드러난다)
#   2. 값 자체는 풀스캔으로 확인
#
# 인덱스가 실제로 정합인지는 이 조합에서 유니크 제약으로만 증명할 수 있다.
# 호출하는 쪽에서 중복 삽입 시험을 반드시 함께 둘 것.
#
DEF CHECK_INDEX_SCAN_CLOSED_GATE( @aTable, @aIndex, @aCols, @aPred )
{
  alter session set explain plan = on;

  # 힌트를 줘도 글로벌 인덱스 스캔이 선택되지 않아야 한다
  select /*+ index(@{aTable}, @{aIndex}) */ count(*) from @{aTable} where @{aPred};

  # 대조군: 명시적 풀스캔
  select /*+ FULL SCAN(@{aTable}) */ count(*) from @{aTable} where @{aPred};

  alter session set explain plan = off;

  # 값은 풀스캔으로 확인한다
  select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable}
   where @{aPred} order by @{aCols};
}
#
# 카운트와 집계를 교차 확인한다.
# 인덱스가 어떤 파티션의 키를 빠뜨리거나 유령 키를 갖고 있으면 어긋난다.
#
DEF CHECK_INDEX_COUNT( @aTable, @aIndex, @aKeyCol )
{
  select /*+ FULL SCAN(@{aTable}) */ count(*) full_cnt,
         count(@{aKeyCol}) full_key_cnt,
         nvl(sum(@{aKeyCol}), -1) full_sum,
         nvl(min(@{aKeyCol}), -1) full_min,
         nvl(max(@{aKeyCol}), -1) full_max
  from @{aTable};

  select /*+ index(@{aTable}, @{aIndex}) */ count(@{aKeyCol}) idx_key_cnt,
         nvl(sum(@{aKeyCol}), -1) idx_sum,
         nvl(min(@{aKeyCol}), -1) idx_min,
         nvl(max(@{aKeyCol}), -1) idx_max
  from @{aTable}
  where @{aKeyCol} is not null;
}
###########################################################################
# TestCase Description = variable 길이 컬럼(varchar, nvarchar)을 키로 쓰는
#                        글로벌 인덱스.
#
#   variable 컬럼의 값은 로우 안에 다 들어가지 않으면 별도 조각으로
#   저장되고, 그 조각을 읽을 때 컬럼 서술자가 가진 테이블스페이스 정보
#   (colSpace)를 쓴다. 인덱스는 서술자를 하나만 갖고 있으므로, 파티션이
#   서로 다른 테이블스페이스에 있으면 다른 파티션 로우의 값을 엉뚱한 곳에서
#   읽을 수 있다.
#
#   ★ 서버는 이 조합을 "고쳐서 읽는" 대신 "플랜을 열지 않는" 것으로 닫았다
#     (qmoPartition::isUsableNativeGlobalIndex). 그래서 이 파일의 검사
#     방식은 두 갈래다.
#
#       게이트 열림 : 단일 테이블스페이스 + variable 키
#                     -> CHECK_INDEX_SCAN_OPEN_GATE (차집합이 유효)
#       게이트 닫힘 : 다중 테이블스페이스 + variable 컬럼(키가 아니어도)
#                     프루닝 + variable 키
#                     -> CHECK_INDEX_SCAN_CLOSED_GATE + 유니크 제약
#
#     닫힌 조합에서 차집합을 쓰면 "풀스캔 minus 풀스캔" 이 되어 항상 0행,
#     즉 아무것도 시험하지 않으면서 통과한다. 이 파일의 초판이 그랬다.
#
#   대조를 위해 fixed 키(integer) + 다중 테이블스페이스 섹터를 함께 둔다.
#   그쪽은 게이트가 열리므로 (tableOID, rowOID) tie-break 를 실제로 시험한다.
#
# Project ID           = Native Global Index (memory)
###########################################################################


DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL FINALIZE_MEM_TBS();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

#
# varchar 키 컬럼을 가진 테이블. 파티션은 서로 다른 테이블스페이스.
# -> 플랜 게이트가 닫힌다.
#
DEF CREATE_VARCHAR_TABLE_MULTI_TBS( @aLen )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, c1 varchar(@{aLen}), c2 varchar(@{aLen}), i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
}

#
# 같은 컬럼 구성이지만 전 파티션이 같은 테이블스페이스.
# -> 플랜 게이트가 열린다.
#
DEF CREATE_VARCHAR_TABLE_ONE_TBS( @aLen )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, c1 varchar(@{aLen}), c2 varchar(@{aLen}), i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
}

#
# fixed 컬럼만 있는 다중 테이블스페이스 테이블.
# variable 컬럼이 하나도 없으므로 게이트가 열린다.
#
DEF CREATE_FIXED_TABLE_MULTI_TBS()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
}

#
# 파티션마다 길이가 다른 문자열을 넣는다.
#
DEF FILL_VARCHAR_DATA()
{
insert into t1 select level, lpad('a', 10, 'a') || level, lpad('x', 10, 'x') || level, level
  from dual connect by level <= 30;
insert into t1 select level + 100, lpad('b', 100, 'b') || level, lpad('y', 100, 'y') || level, level
  from dual connect by level <= 30;
insert into t1 select level + 200, lpad('c', 500, 'c') || level, lpad('z', 500, 'z') || level, level
  from dual connect by level <= 30;
commit;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; SHORT VARCHAR, ONE TABLESPACE
##################################
# 게이트 열림. 여기서는 차집합 비교가 유효하다.

CALL CREATE_VARCHAR_TABLE_ONE_TBS( 100 );

create index gidx1 on t1(c1);

insert into t1 select level,       'a' || level, 'x' || level, level from dual connect by level <= 30;
insert into t1 select level + 100, 'b' || level, 'y' || level, level from dual connect by level <= 30;
insert into t1 select level + 200, 'c' || level, 'z' || level, level from dual connect by level <= 30;
commit;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, c1", "c1 is not null" );

select /*+ index(t1, gidx1) */ count(*) from t1 where c1 like 'a%';
select /*+ index(t1, gidx1) */ count(*) from t1 where c1 like 'b%';
select /*+ index(t1, gidx1) */ count(*) from t1 where c1 like 'c%';

##################################
# SECTOR; LONG VARCHAR, ONE TABLESPACE
##################################
# 값이 길어져 로우 밖 조각으로 저장되는 구성. 테이블스페이스가 하나이므로
# colSpace 가 어긋날 일이 없고 게이트는 열려 있다. 조각 읽기 자체가
# 정상인지를 여기서 본다.

CALL CREATE_VARCHAR_TABLE_ONE_TBS( 2000 );

create index gidx1 on t1(c1);

CALL FILL_VARCHAR_DATA();

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, substr(c1, 1, 20)", "c1 is not null" );

# 값 자체가 정확히 읽히는지. 앞 20자만 잘라서 비교한다.
select /*+ index(t1, gidx1) */ i1, substr(c1, 1, 20) c1_head
  from t1 where c1 is not null order by i1;

select /*+ FULL SCAN(t1) */ i1, substr(c1, 1, 20) c1_head
  from t1 where c1 is not null order by i1;

# 길이가 보존되는지
select /*+ index(t1, gidx1) */ i1, length(c1) c1_len
  from t1 where c1 is not null order by i1;

select /*+ FULL SCAN(t1) */ i1, length(c1) c1_len
  from t1 where c1 is not null order by i1;

##################################
# SECTOR; RANGE SCAN ON LONG VARCHAR, ONE TABLESPACE
##################################
# 범위 탐색은 키 비교를 많이 하므로 값 오독이 있으면 결과가 어긋난다.

select /*+ index(t1, gidx1) */ count(*) from t1 where c1 >= 'b';
select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 >= 'b';

select /*+ index(t1, gidx1) */ count(*) from t1 where c1 < 'b';
select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 < 'b';

select /*+ index(t1, gidx1) */ count(*) from t1 where c1 between 'b' and 'c';
select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 between 'b' and 'c';

##################################
# SECTOR; PRUNING GATE WITH A VARIABLE KEY
##################################
# 이 절은 한때 "프루닝 + variable 키 -> 게이트 닫힘" 을 단언했다. 닫은
# 이유는 키 레인지 콜백이 프루닝으로 잘려나간 파티션의 로우도 만나는데
# 옵티마이저가 그 파티션의 서술자를 갖고 있지 않다는 것이었다.
#
# V4 J11 (A-7 / GR-08) 이 그 게이트를 걷었다. 콜백 자신이 로우마다 owner 의
# 테이블스페이스로 colSpace 를 보정하므로(qmnSCAN::wrapGlobalKeyRange ->
# qtc::rangeCallBack*4MtdGlobal) 확인되지 않은 멤버가 남아 있어도 키 비교가
# 틀리지 않는다 -- v4-stmt-colspace.md 3.
#
# 그래서 기대를 뒤집는다. 낮춘 것이 아니라 늘렸다: 닫힌 게이트를 재던
# 자리는 "플랜에 GLOBAL-INDEX 가 없다" 하나만 볼 수 있었지만, 열린 게이트는
# 플랜이 글로벌이라는 것과 **그 답이 풀스캔과 같다는 것**을 함께 본다.
#
# i1 이 파티션 키다. i1 술어가 있으면 프루닝이 일어난다.

# 프루닝 없음 -> 열림
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, substr(c1, 1, 20)", "c1 >= 'a'" );

# 프루닝 있음 + variable 키 -> J11 이후 열림
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, substr(c1, 1, 20)", "i1 < 100 and c1 >= 'a'" );

##################################
# SECTOR; SHORT VARCHAR, MULTI TABLESPACE
##################################
# 게이트 닫힘. 차집합 대신 플랜 부재와 풀스캔 값으로 확인한다.

CALL CREATE_VARCHAR_TABLE_MULTI_TBS( 100 );

create index gidx1 on t1(c1);

insert into t1 select level,       'a' || level, 'x' || level, level from dual connect by level <= 30;
insert into t1 select level + 100, 'b' || level, 'y' || level, level from dual connect by level <= 30;
insert into t1 select level + 200, 'c' || level, 'z' || level, level from dual connect by level <= 30;
commit;

CALL CHECK_INDEX_SCAN_CLOSED_GATE( "t1", "gidx1", "i1, c1", "c1 is not null" );

select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 like 'a%';
select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 like 'b%';
select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 like 'c%';

##################################
# SECTOR; LONG VARCHAR, MULTI TABLESPACE
##################################
# 이 파일이 원래 겨냥한 조합. 플랜은 닫혀 있지만 인덱스는 살아 있으므로,
# 살아 있다는 증거는 다음 섹터의 유니크 제약으로 잡는다.
# 여기서는 값이 풀스캔으로 정확히 읽히는지와 플랜 부재를 기록한다.

CALL CREATE_VARCHAR_TABLE_MULTI_TBS( 2000 );

create index gidx1 on t1(c1);

CALL FILL_VARCHAR_DATA();

CALL CHECK_INDEX_SCAN_CLOSED_GATE( "t1", "gidx1", "i1, substr(c1, 1, 20)", "c1 is not null" );

select /*+ FULL SCAN(t1) */ i1, length(c1) c1_len
  from t1 where c1 is not null order by i1;

##################################
# SECTOR; UNIQUE ON VARCHAR, MULTI TABLESPACE
##################################
# ★ 게이트가 닫힌 조합에서 인덱스 정합을 증명하는 유일한 수단.
#   인덱스가 어느 파티션의 키를 빠뜨렸다면 아래 중복 삽입이 성공해 버린다.
#   값이 조각으로 저장될 만큼 길게 잡아, 조각 비교가 실제로 일어나게 한다.

CALL CREATE_VARCHAR_TABLE_MULTI_TBS( 2000 );

create unique index t1_uk on t1(c1);

insert into t1 values (10,  lpad('k', 800, 'k'), 'v1', 1);
commit;

# 다른 테이블스페이스의 파티션에 같은 값 -> 실패해야 한다
insert into t1 values (150, lpad('k', 800, 'k'), 'v2', 2);
insert into t1 values (250, lpad('k', 800, 'k'), 'v3', 3);

# 한 글자만 달라도 다른 값이다 -> 성공
insert into t1 values (150, lpad('k', 799, 'k') || 'z', 'v2', 2);
commit;

select /*+ FULL SCAN(t1) */ i1, length(c1), substr(c1, 795, 6) c1_tail
  from t1 order by i1;

# 접두사가 같고 뒤가 다른 긴 값들 -> 전부 성공해야 한다
insert into t1 values (260, lpad('m', 1200, 'm') || 'aaa', 'w1', 1);
insert into t1 values (270, lpad('m', 1200, 'm') || 'aab', 'w2', 2);
commit;

# 그중 하나와 완전히 같은 값 -> 실패해야 한다
insert into t1 values (20, lpad('m', 1200, 'm') || 'aab', 'w3', 3);

select /*+ FULL SCAN(t1) */ count(*) from t1;

##################################
# SECTOR; UPDATE VARCHAR KEY, MULTI TABLESPACE
##################################
# 값을 짧은 것에서 긴 것으로, 긴 것에서 짧은 것으로 바꾼다.
# 조각 사용 여부가 바뀌는 경계다. 갱신 후에도 유일성이 유지되어야 한다.

update t1 set c1 = lpad('d', 1500, 'd') where i1 = 10;
commit;

select /*+ FULL SCAN(t1) */ i1, length(c1) from t1 order by i1;

# 방금 만든 값과 중복 -> 실패해야 한다
insert into t1 values (160, lpad('d', 1500, 'd'), 'x1', 1);

update t1 set c1 = 'short' where i1 = 10;
commit;

# 이제 긴 값은 비었으므로 성공해야 한다
insert into t1 values (160, lpad('d', 1500, 'd'), 'x1', 1);
commit;

select /*+ FULL SCAN(t1) */ i1, length(c1) from t1 order by i1;

##################################
# SECTOR; NULL VARCHAR
##################################

update t1 set c1 = null where i1 = 150;
commit;

select /*+ FULL SCAN(t1) */ i1, nvl(substr(c1, 1, 5), 'NULL') from t1 order by i1;
select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 is null;

# null 은 유일성 검사 대상이 아니다 -> 둘째 null 도 성공해야 한다
update t1 set c1 = null where i1 = 160;
commit;

select /*+ FULL SCAN(t1) */ count(*) from t1 where c1 is null;

##################################
# SECTOR; FIXED KEY, MULTI TABLESPACE (대조군)
##################################
# variable 컬럼이 하나도 없으므로 게이트가 열린다.
# 여기서 (tableOID, rowOID) tie-break 가 실제로 시험된다: 서로 다른
# 테이블스페이스의 두 로우가 같은 rowOID 를 가질 수 있고, tie-break 가
# rowOID 단독이면 두 키를 같은 것으로 오인한다.

CALL CREATE_FIXED_TABLE_MULTI_TBS();

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "gidx1", "i2" );

# 같은 키 값을 세 테이블스페이스에 하나씩 -> tie-break 가 셋을 구분해야 한다
insert into t1 values (10,  777, 1, 1);
insert into t1 values (150, 777, 2, 2);
insert into t1 values (250, 777, 3, 3);
commit;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 777 order by i1;
select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 = 777 order by i1;

# 그중 하나만 지운다 -> 나머지 둘은 남아야 한다
delete from t1 where i1 = 150 and i2 = 777;
commit;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 777 order by i1;
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
