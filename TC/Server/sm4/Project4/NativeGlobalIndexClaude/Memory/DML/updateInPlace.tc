###########################################################################
# Native Global Index - environment helpers
#
# 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
# 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
#   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
#   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
###########################################################################

#
# 네이티브 글로벌 인덱스 생성을 허용한다.
#
DEF ENABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
}
#
# 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
# off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
# 기존과 동일하게 거부되어야 한다.
#
DEF DISABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
}
###########################################################################
# Native Global Index - memory partitioned table helpers
#
# 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
# (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
# 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
#
# 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
# 메모리 테이블스페이스에 있다.
###########################################################################

#
# 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
#
# @aPartType : range | hash | list
# @aKeyType  : 파티션 키 컬럼 타입
# @aColType  : 나머지 컬럼 타입
#
# 컬럼 구성: i1(파티션 키), i2, i3, i4
#
DEF CREATE_MEM_PART_TABLE( @aPartType, @aKeyType, @aColType )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

if ( @aPartType == 'range' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'hash' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'list' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by list(i1)
(
  partition p1 values (100),
  partition p2 values (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
else
{
  print "error: unknown partition type @{aPartType}";
}

}
#
# 파티션을 서로 다른 메모리 테이블스페이스에 흩어 놓는다.
#
# 이 구성이 네이티브 글로벌 인덱스에서 가장 위험하다:
#   - rowOID 는 테이블스페이스 안에서만 유일하다. 서로 다른 TBS 의 두
#     로우가 같은 rowOID 를 가질 수 있고, tie-break 가 (tableOID, rowOID)
#     로 확장되지 않았다면 두 키를 같은 것으로 오인한다.
#   - variable 컬럼의 out-of-row piece 접근은 컬럼 서술자의 colSpace 로
#     테이블스페이스를 고른다. 보정이 없으면 다른 파티션 로우의 값을
#     엉뚱한 TBS 에서 읽는다(크래시가 아니라 조용한 오독).
#
# PREPARE_MEM_TBS() 로 만든 mem1/mem2/mem3 를 쓴다.
#
DEF CREATE_MEM_PART_TABLE_MULTI_TBS( @aPartType, @aKeyType, @aColType )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

if ( @aPartType == 'range' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);

}
elsif ( @aPartType == 'hash' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by hash(i1)
(
  partition p1 tablespace mem1,
  partition p2 tablespace mem2,
  partition p3 tablespace mem3
);

}
elsif ( @aPartType == 'list' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by list(i1)
(
  partition p1 values (100) tablespace mem1,
  partition p2 values (200) tablespace mem2,
  partition p3 values default tablespace mem3
);

}
else
{
  print "error: unknown partition type @{aPartType}";
}

}
#
# 다중 TBS 테스트용 메모리 테이블스페이스를 만든다.
#
DEF PREPARE_MEM_TBS()
{
CALL FINALIZE_MEM_TBS();

create memory tablespace mem1 size 32M autoextend on checkpoint path 'dbs';
create memory tablespace mem2 size 32M autoextend on checkpoint path 'dbs';
create memory tablespace mem3 size 32M autoextend on checkpoint path 'dbs';
}
DEF FINALIZE_MEM_TBS()
{
SKIP BEGIN;
drop tablespace mem1 including contents and datafiles;
drop tablespace mem2 including contents and datafiles;
drop tablespace mem3 including contents and datafiles;
SKIP END;
}
#
# range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
# i1: 파티션 키, i2/i3/i4: 값
#
DEF FILL_RANGE_DATA()
{
insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
commit;
}
#
# 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
# 두 select 모두 0행이어야 정상이다.
#
# @aTable  : 테이블 이름
# @aIndex  : 글로벌 인덱스 이름
# @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
# @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
#
# 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
# 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
# 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
# 출력을 위한 것뿐이다.
#
# 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
#       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
#       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
  # 인덱스 경유 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;

  # 풀스캔 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;
}
#
# 플랜이 열리는 조합에서 쓴다.
# 차집합 비교 앞에 플랜을 먼저 남겨, 힌트가 실제로 글로벌 인덱스를
# 잡았다는 증거를 .lst 에 박아 둔다. 플랜에 GLOBAL-INDEX 가 사라지면
# 차집합이 0행이어도 이 케이스는 FAIL 이 된다.
#
DEF CHECK_INDEX_SCAN_OPEN_GATE( @aTable, @aIndex, @aCols, @aPred )
{
  alter session set explain plan = on;

  select /*+ index(@{aTable}, @{aIndex}) */ count(*) from @{aTable} where @{aPred};

  alter session set explain plan = off;

  CALL CHECK_INDEX_SCAN( "@{aTable}", "@{aIndex}", "@{aCols}", "@{aPred}" );
}
#
# 카운트와 집계를 교차 확인한다.
# 인덱스가 어떤 파티션의 키를 빠뜨리거나 유령 키를 갖고 있으면 어긋난다.
#
DEF CHECK_INDEX_COUNT( @aTable, @aIndex, @aKeyCol )
{
  select /*+ FULL SCAN(@{aTable}) */ count(*) full_cnt,
         count(@{aKeyCol}) full_key_cnt,
         nvl(sum(@{aKeyCol}), -1) full_sum,
         nvl(min(@{aKeyCol}), -1) full_min,
         nvl(max(@{aKeyCol}), -1) full_max
  from @{aTable};

  select /*+ index(@{aTable}, @{aIndex}) */ count(@{aKeyCol}) idx_key_cnt,
         nvl(sum(@{aKeyCol}), -1) idx_sum,
         nvl(min(@{aKeyCol}), -1) idx_min,
         nvl(max(@{aKeyCol}), -1) idx_max
  from @{aTable}
  where @{aKeyCol} is not null;
}
###########################################################################
# TestCase Description = 키 컬럼을 제자리에서 갱신하는 UPDATE.
#
#   코드 리뷰 P0-1 이 지목한 지점이다. 메모리 테이블의 UPDATE 는 값이
#   같은 자리에 들어가면 새 로우를 만들지 않고 기존 로우를 제자리에서
#   고친다. 이때 인덱스에서 옛 키를 지우고 새 키를 넣는 일이 빠지면
#   트리에 유령 키가 남는다.
#
#   유령 키는 조용하다. 로우 자체는 멀쩡하므로 풀스캔은 정상이고,
#   인덱스 경유 조회만 어긋난다. 그래서 이 파일은 세 가지로 잡는다:
#
#     1. 차집합 양방향 (인덱스에만 있는 행 / 풀스캔에만 있는 행)
#     2. 집계 교차 확인 (합계가 어긋나면 유령 키나 누락 키가 있다)
#     3. 유니크 제약 — 옛 값이 트리에 남아 있으면, 그 값을 다시 넣는
#        삽입이 "중복" 으로 잘못 거부된다. 이게 가장 날카롭다.
#
#   in-place 가 되게 하려면 값의 크기가 변하지 않아야 한다. 그래서
#   integer 키와 고정 길이 char 키를 쓴다. varchar 로 길이를 바꾸는
#   경우는 datatype/variableColumn.tc 가 다룬다.
#
# Project ID           = Native Global Index (memory)
###########################################################################


DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL FINALIZE_MEM_TBS();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; IN-PLACE UPDATE OF A NON-UNIQUE KEY
##################################
# 같은 크기의 값으로 바꾼다. 파티션 키는 건드리지 않으므로 로우가
# 옮겨가지 않고 제자리에서 고쳐진다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

# 한 파티션 안의 값만 바꾼다
update t1 set i2 = i2 + 500 where i1 < 100;
commit;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "gidx1", "i2" );

# 옛 값으로 조회하면 아무것도 안 나와야 한다 (유령 키가 있으면 나온다)
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 1 and 30;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 between 1 and 30;

# 새 값으로 조회하면 다 나와야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 501 and 530;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 between 501 and 530;

##################################
# SECTOR; UPDATE ACROSS ALL PARTITIONS
##################################
# 전 파티션의 키를 한 문장으로 바꾼다.

update t1 set i2 = i2 * 2;
commit;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "gidx1", "i2" );

##################################
# SECTOR; REPEATED IN-PLACE UPDATE OF THE SAME ROW
##################################
# 같은 로우의 키를 여러 번 바꾼다. 매번 옛 키가 지워지지 않으면
# 유령 키가 쌓인다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

insert into t1 values (10, 1, 1, 1);
commit;

update t1 set i2 = 2 where i1 = 10;
commit;
update t1 set i2 = 3 where i1 = 10;
commit;
update t1 set i2 = 4 where i1 = 10;
commit;
update t1 set i2 = 5 where i1 = 10;
commit;

# 로우는 하나뿐이다. 인덱스 경유 카운트도 하나여야 한다.
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 0;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 >= 0;

# 거쳐간 값들로는 아무것도 안 나와야 한다
select /*+ index(t1, gidx1) */ i2 from t1 where i2 in (1, 2, 3, 4) order by i2;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; UNIQUE KEY IN-PLACE UPDATE
##################################
# ★ 가장 날카로운 검사.
#   옛 값이 트리에 남아 있으면 그 값을 다시 쓰려는 삽입이 "중복" 으로
#   잘못 거부된다. 즉 성공해야 할 문장이 실패하는 것으로 드러난다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10,  100, 1, 1);
insert into t1 values (150, 200, 2, 2);
insert into t1 values (250, 300, 3, 3);
commit;

# 100 -> 999 로 바꾼다. 이제 100 은 비어야 한다.
update t1 set i2 = 999 where i1 = 10;
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

# 비워진 값을 다른 파티션에서 다시 쓴다 -> 성공해야 한다.
# 실패하면 옛 키가 트리에 남아 있다는 뜻이다.
insert into t1 values (170, 100, 4, 4);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

# 살아 있는 값과의 중복 -> 실패해야 한다
insert into t1 values (260, 999, 5, 5);
insert into t1 values (260, 200, 5, 5);

# 갱신으로 만드는 중복도 실패해야 한다
update t1 set i2 = 200 where i1 = 250;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

##################################
# SECTOR; UNIQUE KEY SWAP WITHIN ONE STATEMENT
##################################
# 두 로우의 키를 맞바꾼다. 문장 중간에는 중복 상태를 지나가지만
# 문장이 끝난 시점에는 유일하다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10,  1, 1, 1);
insert into t1 values (150, 2, 2, 2);
commit;

update t1 set i2 = 3 - i2 where i2 in (1, 2);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "t1_uk", "i1, i2", "i2 is not null" );

##################################
# SECTOR; FIXED-LENGTH CHAR KEY
##################################
# char 는 고정 길이라 값이 바뀌어도 크기가 그대로다.
# integer 와 다른 비교자를 타므로 따로 본다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, c1 char(20), i3 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

create unique index t1_uk on t1(c1);

insert into t1 values (10,  'aaaaaaaaaa', 1);
insert into t1 values (150, 'bbbbbbbbbb', 2);
insert into t1 values (250, 'cccccccccc', 3);
commit;

update t1 set c1 = 'dddddddddd' where i1 = 10;
commit;

# 비워진 값을 다시 쓴다 -> 성공해야 한다
insert into t1 values (170, 'aaaaaaaaaa', 4);
commit;

select /*+ FULL SCAN(t1) */ i1, c1 from t1 order by i1;
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "t1_uk", "i1, c1", "c1 is not null" );

##################################
# SECTOR; ROLLBACK OF AN IN-PLACE UPDATE
##################################
# 되돌린 뒤에도 트리가 원래 상태여야 한다.

alter session set autocommit = false;

update t1 set c1 = 'zzzzzzzzzz' where i1 = 150;

rollback;

alter session set autocommit = true;

select /*+ FULL SCAN(t1) */ i1, c1 from t1 order by i1;

# 되돌렸으므로 'zzzzzzzzzz' 는 비어 있어야 한다 -> 성공해야 한다
insert into t1 values (180, 'zzzzzzzzzz', 5);
commit;

# 원래 값은 살아 있어야 한다 -> 실패해야 한다
insert into t1 values (190, 'bbbbbbbbbb', 6);

select /*+ FULL SCAN(t1) */ i1, c1 from t1 order by i1;
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "t1_uk", "i1, c1", "c1 is not null" );

##################################
# SECTOR; IN-PLACE UPDATE ON MULTI TABLESPACE
##################################
# 파티션이 서로 다른 테이블스페이스에 있으면 옛 키를 지울 때 owner
# 역산이 맞아야 한다. 엉뚱한 파티션에서 지우면 유령 키가 남는다.

CALL CREATE_MEM_PART_TABLE_MULTI_TBS( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10,  100, 1, 1);
insert into t1 values (150, 200, 2, 2);
insert into t1 values (250, 300, 3, 3);
commit;

update t1 set i2 = i2 + 1000;
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

# 옛 값 셋이 전부 비어야 한다 -> 전부 성공해야 한다
insert into t1 values (20,  100, 4, 4);
insert into t1 values (160, 200, 5, 5);
insert into t1 values (260, 300, 6, 6);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "t1_uk", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "t1_uk", "i2" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
