$T0> # 인덱스를 타는 갱신 (소유 파티션으로 넘겨 잠금을 잡는 경로)
$T0> update t1 set i3 = i3 + 1 where i2 between 5 and 15;
11 rows updated.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i3 > 0;
COUNT                
-----------------------
90                   
1 row selected.

$T0> # 인덱스를 타는 삭제
$T0> delete from t1 where i2 = 10;
1 row deleted.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 10;
COUNT                
-----------------------
0                    
1 row selected.

$T0> rollback;
Rollback success.

$T0> alter session set autocommit = true;
Alter success.

$T0> # 되돌렸으므로 원래대로여야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 10;
COUNT                
-----------------------
1                    
1 row selected.
