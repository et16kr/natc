###########################################################################
# TestCase Description = Query Memory indexes through joins, subqueries, views.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
# 출처                 = NativeGlobalIndexCodex/Memory/Query/joinSubqueryView.tc (통합 Phase D 흡수)
#                        원본은 codex 브랜치가 관리한다. 고칠 일이 생기면 그쪽도 본다.
# 흡수 시 더한 것       = (1) 프로퍼티 못박기 -- 원본은 자기 전제를 세우지 않아
#                            앞 케이스가 남긴 값을 물려받았다(계획 §5.4)
#                        (2) INDEX_IMPL_TYPE 제거 -- SYS_INDICES_ 에 없는 컬럼이라
#                            원본 질의가 ERR-31058 로 죽는다. 판별자는 INDEX_TABLE_ID
#                            (네이티브 = 0) 하나로 충분하다
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP VIEW NGM_QRY_JOIN_V;
    DROP TABLE NGM_QRY_JOIN_A;
    DROP TABLE NGM_QRY_JOIN_B;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
    select name, value1 from v$property where name = 'MEM_GLOBAL_INDEX_ENABLE';

    CREATE TABLE NGM_QRY_JOIN_A (P INTEGER, K VARCHAR(16), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE TABLE NGM_QRY_JOIN_B (P INTEGER, K VARCHAR(16), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_QRY_JOIN_A_I ON NGM_QRY_JOIN_A(K);
    CREATE INDEX NGM_QRY_JOIN_B_I ON NGM_QRY_JOIN_B(K);

    INSERT INTO NGM_QRY_JOIN_A VALUES (1, 'K-A', 10);
    INSERT INTO NGM_QRY_JOIN_A VALUES (11, 'K-B', 20);
    INSERT INTO NGM_QRY_JOIN_A VALUES (21, 'K-C', 30);
    INSERT INTO NGM_QRY_JOIN_A VALUES (22, 'K-D', 40);
    INSERT INTO NGM_QRY_JOIN_B VALUES (2, 'K-A', 100);
    INSERT INTO NGM_QRY_JOIN_B VALUES (12, 'K-C', 300);
    INSERT INTO NGM_QRY_JOIN_B VALUES (23, 'K-X', 900);

    CREATE VIEW NGM_QRY_JOIN_V AS
        SELECT P, K, V FROM NGM_QRY_JOIN_A WHERE V >= 20;

##################################
SECTOR; TEST
##################################
    SELECT A.P, A.K, A.V, B.P, B.V
      FROM NGM_QRY_JOIN_A A,
           NGM_QRY_JOIN_B B
     WHERE A.K = B.K
     ORDER BY A.K, A.P, B.P;

    SELECT A.P, A.K, A.V, B.P, B.V
      FROM NGM_QRY_JOIN_A A LEFT OUTER JOIN NGM_QRY_JOIN_B B
        ON A.K = B.K
     ORDER BY A.P, B.P;

    SELECT P, K, V
      FROM NGM_QRY_JOIN_A
     WHERE K IN (SELECT K FROM NGM_QRY_JOIN_B WHERE V < 500)
     ORDER BY K, P;

    SELECT A.P, A.K, A.V
      FROM NGM_QRY_JOIN_A A
     WHERE EXISTS
           (SELECT 1 FROM NGM_QRY_JOIN_B B
             WHERE B.K = A.K AND B.V > A.V)
     ORDER BY A.K, A.P;

    SELECT V.P, V.K, V.V, B.V
      FROM NGM_QRY_JOIN_V V,
           NGM_QRY_JOIN_B B
     WHERE V.K = B.K
     ORDER BY V.K, V.P;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP VIEW NGM_QRY_JOIN_V;
    DROP TABLE NGM_QRY_JOIN_A;
    DROP TABLE NGM_QRY_JOIN_B;
    SKIP END;
}

