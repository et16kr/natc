 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = PSM 이 글로벌 인덱스 테이블을 읽고 쓴다 (메모리).
$T0> # Project ID           = Native Global Index
$T0> #
$T0> # 출처                 = 없음. **새로 쓴 것**이다.
$T0> #
$T0> # ★ 왜 이식이 아니라 새로 쓰는가 -- 분류를 정정한다
$T0> #   커버리지 §2 (ㄱ) 는 PSM 을 "이식으로 채워진다" 로 놓고 근거를
$T0> #   `parallelbuild-check` · `disk-matrix-check` 로 적었다. **둘 다 근거가
$T0> #   되지 못한다 -- 실물을 열어 보니 이렇다:**
$T0> #
$T0> #     parallelbuild-check  PSM 을 **데이터 채우개로만** 쓴다
$T0> #                          (`ngi_pb_fill`). 이식해도 PSM 축은 하나도
$T0> #                          안 닫힌다 -- 재는 것은 병렬 빌드다.
$T0> #     disk-matrix-check    `d19_walk` 계열이 **진짜 PSM 축**이다. 그런데
$T0> #                          이 스크립트는 골든 참조 2 + 재기동 1 이라
$T0> #                          건지기의 가장 어려운 묶음에 있다.
$T0> #
$T0> #   즉 "소스 grep 하나만 걸림" 이라는 종전 판정은 틀렸고, 이 공백을 닫아
$T0> #   줄 이식은 가깝지 않다. 계수가 키워드 적중만 보고 **그 적중이 무엇을
$T0> #   하는지 읽지 않아** 생긴 오류이고, N1(주석을 구문으로 셈)·N7(헬퍼 뒤를
$T0> #   못 봄)과 같은 가족이다.
$T0> #
$T0> #   ★ 나중에 `disk-matrix-check` 의 `d19_walk` 절이 이식되면 **중복 판정
$T0> #     대상**이다. 이 주석이 그 표지다.
$T0> #
$T0> # 무엇을 재는가 -- PSM 은 다른 입구로 들어온다
$T0> #
$T0> #   PSM 안의 SQL 은 정적 커서로 미리 준비되고, 실행 계획이 세션이 아니라
$T0> #   프로시저에 붙는다. 그래서 물음이 셋 생긴다:
$T0> #
$T0> #     1. PSM 커서가 글로벌 인덱스를 타는가 (그리고 파티션을 가로질러
$T0> #        정렬을 받는가)
$T0> #     2. PSM 안의 DML 이 글로벌 트리를 옳게 갱신하는가 --
$T0> #        **파티션을 넘는 갱신(row movement) 포함**
$T0> #     3. 유일성 위반이 PSM 예외로 잡히고, 잡은 뒤에도 트리가 정합인가
$T0> #
$T0> #   3 이 특히 이 스위트의 몫이다. 예외를 잡아 계속 도는 경로는 실패한
$T0> #   키 삽입이 **반쪽만 남았는지**를 드러낸다 -- 그물의 FIT 절이 크래시로
$T0> #   보던 것을 여기서는 잡힌 예외로 본다.
$T0> #
$T0> # ★ .lst 미기록 -- 서버가 서면 두 번 돌려 바이트 동일을 확인한 뒤 찍을 것.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP PROCEDURE NGM_PSM_WALK;
$T0> DROP PROCEDURE NGM_PSM_MOVE;
$T0> DROP PROCEDURE NGM_PSM_DUP;
$T0> DROP TABLE NGM_PSM;
$T0> DROP TABLE NGM_PSM_LOG;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'MEM_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
MEM_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                           
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> CREATE TABLE NGM_PSM ( P INTEGER, K INTEGER, V VARCHAR(16) )
    PARTITION BY RANGE ( P )
    (
        PARTITION P1 VALUES LESS THAN ( 10 ),
        PARTITION P2 VALUES LESS THAN ( 20 ),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_PSM_LOG ( TAG VARCHAR(24), N INTEGER ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> INSERT INTO NGM_PSM SELECT LEVEL,      100 + LEVEL, 'A' FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> INSERT INTO NGM_PSM SELECT LEVEL + 10, 200 + LEVEL, 'B' FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> INSERT INTO NGM_PSM SELECT LEVEL + 20, 300 + LEVEL, 'C' FROM DUAL CONNECT BY LEVEL <= 5;
5 rows inserted.
$T0> COMMIT;
Commit success.

$T0> CREATE UNIQUE INDEX NGM_PSM_G ON NGM_PSM ( K ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> ALTER TABLE NGM_PSM ENABLE ROW MOVEMENT;
Alter success.

$T0> # A0. 전제 -- 네이티브 글로벌인가(판별자 101).
$T0> SELECT COUNT(*) AS IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I
     WHERE P.INDEX_ID = I.INDEX_ID
       AND P.PARTITION_TYPE = 101
       AND I.INDEX_NAME = 'NGM_PSM_G';
IS_NATIVE_GLOBAL     
-----------------------
1                    
1 row selected.

$T0> ##################################
$T0> SECTOR 2; A -- PSM 커서가 글로벌 트리를 순회한다
$T0> ##################################
$T0> CREATE OR REPLACE PROCEDURE NGM_PSM_WALK AS
        CURSOR C1 IS
            SELECT /*+ INDEX( NGM_PSM, NGM_PSM_G ) */ K, P
              FROM NGM_PSM ORDER BY K;
        V_CNT   INTEGER := 0;
        V_PREV  INTEGER := -1;
        V_ORDER INTEGER := 1;
    BEGIN
        FOR R IN C1 LOOP
            V_CNT := V_CNT + 1;
            -- 파티션을 가로질러 키 순서가 보존되는가. 글로벌 인덱스가
            -- 주는 값이 정확히 이것이므로, 어긋나면 0 으로 남는다.
            IF R.K <= V_PREV THEN
                V_ORDER := 0;
            END IF;
            V_PREV := R.K;
        END LOOP;
        INSERT INTO NGM_PSM_LOG VALUES ( 'WALK_COUNT', V_CNT );
        INSERT INTO NGM_PSM_LOG VALUES ( 'WALK_ORDERED', V_ORDER );
    END;
    /
Create success.

$T0> EXEC NGM_PSM_WALK();
Execute success.
$T0> COMMIT;
Commit success.

$T0> SELECT TAG, N FROM NGM_PSM_LOG ORDER BY TAG;
TAG                       N           
-----------------------------------------
WALK_COUNT                15          
WALK_ORDERED              1           
2 rows selected.
$T0> DELETE FROM NGM_PSM_LOG;
2 rows deleted.
$T0> COMMIT;
Commit success.

$T0> ##################################
$T0> SECTOR 3; B -- PSM 안의 DML 이 파티션을 넘긴다
$T0> ##################################
$T0> CREATE OR REPLACE PROCEDURE NGM_PSM_MOVE AS
        CURSOR C2 IS SELECT K FROM NGM_PSM WHERE P < 10;
        V_CNT INTEGER := 0;
    BEGIN
        -- P1 의 행들을 PD 쪽으로 민다. 한 문장이 아니라 루프 안의
        -- 갱신이므로, 커서 handoff 가 반복마다 서야 한다.
        FOR R IN C2 LOOP
            UPDATE NGM_PSM SET P = P + 20 WHERE K = R.K;
            V_CNT := V_CNT + 1;
        END LOOP;
        INSERT INTO NGM_PSM_LOG VALUES ( 'MOVED', V_CNT );
    END;
    /
Create success.

$T0> EXEC NGM_PSM_MOVE();
Execute success.
$T0> COMMIT;
Commit success.

$T0> SELECT TAG, N FROM NGM_PSM_LOG ORDER BY TAG;
TAG                       N           
-----------------------------------------
MOVED                     5           
1 row selected.

