$T0> ##################################
$T0> SECTOR 4; C -- 유일성 위반을 PSM 예외로 잡는다
$T0> ##################################
$T0> # ★ 잡은 **뒤에** 트리가 정합인지가 이 절의 핵심이다.
$T0> #   실패한 삽입이 키를 반쪽 남기면 여기서 드러난다 -- 예외를 잡고
$T0> #   계속 도는 경로는 그 반쪽을 청소할 기회가 크래시 경로와 다르다.
$T0> CREATE OR REPLACE PROCEDURE NGM_PSM_DUP AS
        V_ERR INTEGER := 0;
    BEGIN
        BEGIN
            -- 이미 있는 키를 다른 파티션에 넣는다. 트리가 하나이므로
            -- 실패해야 한다.
            INSERT INTO NGM_PSM VALUES ( 5, 301, 'DUP' );
        EXCEPTION
            WHEN OTHERS THEN
                V_ERR := 1;
        END;
        INSERT INTO NGM_PSM_LOG VALUES ( 'DUP_REJECTED', V_ERR );

        -- 예외를 잡은 뒤에도 정상 삽입이 되는가.
        INSERT INTO NGM_PSM VALUES ( 6, 901, 'AFTER-EXC' );
        INSERT INTO NGM_PSM_LOG VALUES ( 'AFTER_EXC_OK', 1 );
    END;
    /
Create success.

$T0> EXEC NGM_PSM_DUP();
Execute success.
$T0> COMMIT;
Commit success.

$T0> SELECT TAG, N FROM NGM_PSM_LOG ORDER BY TAG;
TAG                       N           
-----------------------------------------
AFTER_EXC_OK              1           
DUP_REJECTED              1           
2 rows selected.

