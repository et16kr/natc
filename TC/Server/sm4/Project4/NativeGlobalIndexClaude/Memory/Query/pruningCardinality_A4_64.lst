 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Cover Memory pruning of zero, one, many, and all partitions.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Test ID              = NGI-QRY-006
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> # 출처                 = NativeGlobalIndexCodex/Memory/Query/pruningCardinality.tc (통합 Phase D 흡수)
$T0> #                        원본은 codex 브랜치가 관리한다. 고칠 일이 생기면 그쪽도 본다.
$T0> # 흡수 시 더한 것       = (1) 프로퍼티 못박기 -- 원본은 자기 전제를 세우지 않아
$T0> #                            앞 케이스가 남긴 값을 물려받았다(계획 §5.4)
$T0> #                        (2) INDEX_IMPL_TYPE 제거 -- SYS_INDICES_ 에 없는 컬럼이라
$T0> #                            원본 질의가 ERR-31058 로 죽는다. 판별자는 INDEX_TABLE_ID
$T0> #                            (네이티브 = 0) 하나로 충분하다
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGM_QRY_PRUNE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> select name, value1 from v$property where name = 'MEM_GLOBAL_INDEX_ENABLE';
NAME                                                                                                                                                                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VALUE1                                                                                                                                                                                                                                                            
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
MEM_GLOBAL_INDEX_ENABLE                                                                                                                                                                                                                                           
1                                                                                                                                                                                                                                                                 
1 row selected.

$T0> CREATE TABLE NGM_QRY_PRUNE (P INTEGER, K VARCHAR(32), V VARCHAR(8))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION P3 VALUES LESS THAN (30),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_QRY_PRUNE_I ON NGM_QRY_PRUNE(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_QRY_PRUNE VALUES (1, 'K-101', 'P1');
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRUNE VALUES (11, 'K-111', 'P2');
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRUNE VALUES (21, 'K-121', 'P3');
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRUNE VALUES (31, 'K-131', 'PD');
1 row inserted.

$T0> ##################################
