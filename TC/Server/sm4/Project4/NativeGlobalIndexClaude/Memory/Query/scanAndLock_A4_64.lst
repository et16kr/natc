$T0> # SECTOR; SELECT FOR UPDATE
$T0> ##################################
$T0> # 글로벌 인덱스로 읽은 로우에 잠금을 건다. 잠금은 소유 파티션에서
$T0> # 걸려야 한다.

$T0> select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15 for update;
