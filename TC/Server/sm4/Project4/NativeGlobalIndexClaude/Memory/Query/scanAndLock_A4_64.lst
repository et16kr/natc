$T0> ##################################
$T0> # SECTOR; UPDATE THROUGH GLOBAL INDEX
$T0> ##################################
$T0> # 글로벌 인덱스로 찾은 로우를 갱신/삭제한다. 변경은 소유 파티션
$T0> # 커서에서 일어나야 한다.

$T0> update t1 set i4 = i4 + 1 where i2 = 15;
1 row updated.
$T0> commit;
Commit success.
$T0> select i1, i2, i4 from t1 where i2 = 15 order by i1;
I1          I2          I4          
----------------------------------------
15          15          46          
1 row selected.

$T0> update t1 set i4 = i4 + 1 where i2 in (5, 105, 205);
3 rows updated.
$T0> commit;
Commit success.
$T0> select i1, i2, i4 from t1 where i2 in (5, 105, 205) order by i1;
I1          I2          I4          
----------------------------------------
5           5           16          
105         105         16          
205         205         16          
3 rows selected.

$T0> delete from t1 where i2 = 15;
1 row deleted.
$T0> commit;
Commit success.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

