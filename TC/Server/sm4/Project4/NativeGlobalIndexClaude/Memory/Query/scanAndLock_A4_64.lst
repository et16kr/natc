$T0> ##################################
$T0> # SECTOR; RESULT MATCHES FULL SCAN
$T0> ##################################
$T0> # 같은 술어를 풀스캔으로 실행한 결과와 비교한다.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 = 15
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 = 15
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 15 and 25
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 between 15 and 25
  )
  order by 1;
I1          I2          
---------------------------
