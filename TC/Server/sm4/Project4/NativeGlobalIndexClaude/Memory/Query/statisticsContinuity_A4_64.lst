11          K-111                             3           
15          K-115                             4           
21          K-121                             5           
4 rows selected.
$T0> SELECT INDEX_NAME, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID() AND INDEX_NAME = 'NGM_QRY_STATS_I';
