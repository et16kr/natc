###########################################################################
# Native Global Index - environment helpers
#
# 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
# 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
#   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
#   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
###########################################################################

#
# 네이티브 글로벌 인덱스 생성을 허용한다.
#
DEF ENABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
}
#
# 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
# off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
# 기존과 동일하게 거부되어야 한다.
#
DEF DISABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
}
###########################################################################
# Native Global Index - memory partitioned table helpers
#
# 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
# (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
# 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
#
# 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
# 메모리 테이블스페이스에 있다.
###########################################################################

#
# 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
#
# @aPartType : range | hash | list
# @aKeyType  : 파티션 키 컬럼 타입
# @aColType  : 나머지 컬럼 타입
#
# 컬럼 구성: i1(파티션 키), i2, i3, i4
#
DEF CREATE_MEM_PART_TABLE( @aPartType, @aKeyType, @aColType )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

if ( @aPartType == 'range' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'hash' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'list' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by list(i1)
(
  partition p1 values (100),
  partition p2 values (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
else
{
  print "error: unknown partition type @{aPartType}";
}

}
#
# range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
# i1: 파티션 키, i2/i3/i4: 값
#
DEF FILL_RANGE_DATA()
{
insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
commit;
}
###########################################################################
# Native Global Index - integrity check helpers
#
# 구버전(PROJ-1624)은 숨김 테이블 $GIT_ 와 베이스 테이블을 FULL OUTER JOIN
# 해서 정합성을 검사했다. 네이티브 글로벌 인덱스에는 조인할 테이블이 없고
# 인덱스 내용을 SQL로 직접 볼 수 없으므로, 아래 세 가지를 조합해서 같은
# 목적을 달성한다.
#
#   1. 인덱스 경유 결과 vs 풀스캔 결과의 양방향 차집합 (CHECK_INDEX_SCAN)
#   2. 카운트/집계 교차 확인                          (CHECK_INDEX_COUNT)
#   3. 유니크 제약을 살아 있는 검사기로 사용          (각 케이스에서 직접)
#
# ★ 1번과 2번은 index 힌트가 실제로 글로벌 인덱스를 잡았을 때만 의미가
#   있다. 잡지 못하면 "풀스캔 minus 풀스캔" 이 되어 무조건 0행이고, 아무것도
#   시험하지 않으면서 통과한다.
#
#   옵티마이저가 글로벌 SCAN 후보를 아예 내지 않는 조합이 있다
#   (qmoPartition::isUsableNativeGlobalIndex):
#
#     (a) memory variable 컬럼(varchar/nvarchar/...)의 colSpace 가 논리
#         테이블과 파티션 사이에서 다를 때. 파티션이 서로 다른 메모리
#         테이블스페이스에 있으면 여기 걸린다. 키 컬럼이 아니어도,
#         테이블에 그런 컬럼이 하나라도 있으면 닫힌다.
#     (b) 파티션 프루닝이 일어났고 인덱스 키 컬럼에 variable 이 있을 때.
#     (c) PARALLEL 힌트가 붙었을 때.
#
#   이 경우 인덱스 자체는 살아 있고 유니크 제약도 계속 강제된다.
#   스캔 플랜만 후보에서 빠지고 종전대로 PCRD 가 선택된다.
#
#   그래서 위 조합에서는 CHECK_INDEX_SCAN 대신
#   CHECK_INDEX_SCAN_CLOSED_GATE 를 쓴다 — 플랜에 GLOBAL-INDEX 가
#   "없다"는 것을 .lst 에 명시적으로 남기고, 정합성은 유니크 제약과
#   풀스캔 집계로만 판정한다.
###########################################################################

#
# 플랜 출력을 켠다. 어떤 접근 경로가 선택됐는지 .lst 에 남긴다.
#
DEF SHOW_PLAN_ON()
{
  alter session set explain plan = on;
}
DEF SHOW_PLAN_OFF()
{
  alter session set explain plan = off;
}
#
# 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
# 두 select 모두 0행이어야 정상이다.
#
# @aTable  : 테이블 이름
# @aIndex  : 글로벌 인덱스 이름
# @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
# @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
#
# 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
# 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
# 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
# 출력을 위한 것뿐이다.
#
# 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
#       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
#       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
  # 인덱스 경유 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;

  # 풀스캔 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;
}
###########################################################################
# TestCase Description = 글로벌 인덱스 스캔의 결과 정합성, 파티션 지정,
#                        정렬 순서, FOR UPDATE 잠금.
#                        글로벌 인덱스는 전 파티션 통합 정렬 순서를 주므로
#                        로컬 인덱스로는 불가능했던 ORDER BY 제거가 가능하다.
# Project ID           = Native Global Index (memory)
###########################################################################


DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL SHOW_PLAN_OFF();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index lidx1 on t1(i3) local;

CALL FILL_RANGE_DATA();

##################################
# SECTOR; RANGE PREDICATE
##################################
# 파티션 키와 무관한 술어. 프루닝이 불가능하므로 글로벌 인덱스가
# 유리한 전형적인 경우다.

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 15 and 25 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 > 220 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 < 5 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 <= 3 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 >= 228 order by i1, i2;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 in (5, 105, 205) order by i1, i2;
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 != 5;

##################################
# SECTOR; RESULT MATCHES FULL SCAN
##################################
# 같은 술어를 풀스캔으로 실행한 결과와 비교한다.

for $sPred in "i2 = 15" "i2 between 15 and 25" "i2 > 220" "i2 < 5"
{
  CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", $sPred );
}

##################################
# SECTOR; PARTITION SELECTION
##################################
# 파티션을 지정하면 그 파티션의 로우만 나와야 한다.
# 글로벌 인덱스는 전 파티션을 커버하므로, 미선택 파티션의 로우가
# 결과에 새어 나오지 않는지가 핵심이다.

select count(*) from t1 partition (p1);
select count(*) from t1 partition (p2);
select count(*) from t1 partition (p3);

select /*+ index(t1, gidx1) */ i1, i2 from t1 partition (p1) where i2 is not null order by i1;
select /*+ index(t1, gidx1) */ min(i1), max(i1) from t1 partition (p2);
select /*+ index(t1, gidx1) */ min(i1), max(i1) from t1 partition (p3);

# 지정한 파티션에 없는 값을 찾으면 결과가 없어야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 partition (p1) where i2 = 205;
select /*+ index(t1, gidx1) */ count(*) from t1 partition (p3) where i2 = 5;

##################################
# SECTOR; PARTITION PRUNING BY KEY
##################################
# 파티션 키 술어로 프루닝이 되는 경우. 이때는 로컬 인덱스가 유리하므로
# 옵티마이저 선택이 달라질 수 있다.
#
# ★ 이 섹터의 앞 둘(i1 = 15 · i1 < 50)은 2026-08-24 에 기대 플랜을 다시
#   찍었다. 종전 기대는
#       SCAN ( ... INDEX: SYS.GIDX1, GLOBAL-INDEX, FULL SCAN, ACCESS: 30 )
#   이고 지금은
#       PARTITION-COORDINATOR ( ... PARTITION: 1/3, INDEX: SYS.LIDX1 )
#        SCAN ( PARTITION: P1, FULL SCAN, ACCESS: 30 )
#   이다. 회귀를 덮은 것이 아니라 개선을 따라간 것이다 --
#
#     gidx1 은 i2 위에 있고 이 두 술어는 파티션 키 i1 뿐이라 키 범위가
#     없다. 종전 플랜은 글로벌 인덱스 전체를 훑고 나서 버렸다. 프루닝이
#     1/3 로 좁혔는데도 그것을 골랐던 이유는 프루닝된 질의의 글로벌 후보를
#     프루닝 뒤의 행 수로 비용 계산한 데 있었고(GR-11), 그 재료를 프루닝
#     전 값으로 되돌리자 PCRD 가 이겼다. 같은 모양을 60,000 행 · 3 파티션
#     으로 키워 재면 새 플랜이 1.68 배 빠르다(1,073us 대 1,808us).
#
#   ★ 판별자는 뒤 둘이다. i2 = 15 와 i1 < 50 and i2 = 15 는 키 범위가
#     있으므로 지금도 SCAN ( ... GLOBAL-INDEX, RANGE SCAN, ACCESS: 1 )
#     이어야 한다. 그 둘까지 PCRD 로 바뀌면 그것은 개선이 아니라 회귀다 --
#     되돌리는 범위가 "훑는 엔트리가 테이블 크기에 비례할 때만" 이라는
#     가드가 무너진 것이기 때문이다.
#
#   근거: altibase docs/analysis/claude-global-index/v5-gr11-pruning.md 3.5,
#         v5-natc-scanandlock-oracle.md

CALL SHOW_PLAN_ON();

select i1, i2 from t1 where i1 = 15 order by i1;
select i1, i2 from t1 where i1 < 50 order by i1;
select i1, i2 from t1 where i2 = 15 order by i1;
select i1, i2 from t1 where i1 < 50 and i2 = 15 order by i1;

CALL SHOW_PLAN_OFF();

##################################
# SECTOR; ORDER BY
##################################
# 글로벌 인덱스는 전 파티션 통합 정렬 순서를 제공한다.
# 로컬 인덱스는 파티션별로만 정렬되므로 이 최적화가 불가능하다.

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2;
select /*+ index(t1, gidx1) */ i2 from t1 where i2 > 100 order by i2;
select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2 desc;

CALL SHOW_PLAN_OFF();

# 정렬 결과 자체의 정확성
select /*+ index(t1, gidx1) */ i2 from t1 where i2 between 98 and 105 order by i2;

##################################
# SECTOR; MIN MAX
##################################

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ min(i2) from t1;
select /*+ index(t1, gidx1) */ max(i2) from t1;

CALL SHOW_PLAN_OFF();

select min(i2), max(i2) from t1;

##################################
# SECTOR; SELECT FOR UPDATE
##################################
# 글로벌 인덱스로 읽은 로우에 잠금을 건다. 잠금은 소유 파티션에서
# 걸려야 한다.

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 15 for update;
commit;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 100 and 110 order by i1 for update;
commit;

# 전 파티션에 걸친 잠금
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 in (5, 105, 205) order by i1 for update;
commit;

##################################
# SECTOR; UPDATE THROUGH GLOBAL INDEX
##################################
# 글로벌 인덱스로 찾은 로우를 갱신/삭제한다. 변경은 소유 파티션
# 커서에서 일어나야 한다.

update t1 set i4 = i4 + 1 where i2 = 15;
commit;
select i1, i2, i4 from t1 where i2 = 15 order by i1;

update t1 set i4 = i4 + 1 where i2 in (5, 105, 205);
commit;
select i1, i2, i4 from t1 where i2 in (5, 105, 205) order by i1;

delete from t1 where i2 = 15;
commit;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; SCAN WITH CONCURRENT SNAPSHOT
##################################
# 커밋되지 않은 변경은 다른 문장에서 보이면 안 된다(자기 트랜잭션은 보임).

insert into t1 values (50, 50000, 1, 1);

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 50000;

rollback;

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 = 50000;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
