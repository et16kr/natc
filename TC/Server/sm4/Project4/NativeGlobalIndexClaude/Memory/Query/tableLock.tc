###########################################################################
# Native Global Index - environment helpers
#
# 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
# 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
#   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
#   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
###########################################################################

#
# 네이티브 글로벌 인덱스 생성을 허용한다.
#
DEF ENABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
}
#
# 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
# off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
# 기존과 동일하게 거부되어야 한다.
#
DEF DISABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
}
###########################################################################
# Native Global Index - memory partitioned table helpers
#
# 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
# (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
# 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
#
# 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
# 메모리 테이블스페이스에 있다.
###########################################################################

#
# 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
#
# @aPartType : range | hash | list
# @aKeyType  : 파티션 키 컬럼 타입
# @aColType  : 나머지 컬럼 타입
#
# 컬럼 구성: i1(파티션 키), i2, i3, i4
#
DEF CREATE_MEM_PART_TABLE( @aPartType, @aKeyType, @aColType )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

if ( @aPartType == 'range' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'hash' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'list' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by list(i1)
(
  partition p1 values (100),
  partition p2 values (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
else
{
  print "error: unknown partition type @{aPartType}";
}

}
#
# range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
# i1: 파티션 키, i2/i3/i4: 값
#
DEF FILL_RANGE_DATA()
{
insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
commit;
}
#
# 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
# 두 select 모두 0행이어야 정상이다.
#
# @aTable  : 테이블 이름
# @aIndex  : 글로벌 인덱스 이름
# @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
# @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
#
# 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
# 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
# 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
# 출력을 위한 것뿐이다.
#
# 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
#       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
#       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
  # 인덱스 경유 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;

  # 풀스캔 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;
}
#
# 카운트와 집계를 교차 확인한다.
# 인덱스가 어떤 파티션의 키를 빠뜨리거나 유령 키를 갖고 있으면 어긋난다.
#
DEF CHECK_INDEX_COUNT( @aTable, @aIndex, @aKeyCol )
{
  select /*+ FULL SCAN(@{aTable}) */ count(*) full_cnt,
         count(@{aKeyCol}) full_key_cnt,
         nvl(sum(@{aKeyCol}), -1) full_sum,
         nvl(min(@{aKeyCol}), -1) full_min,
         nvl(max(@{aKeyCol}), -1) full_max
  from @{aTable};

  select /*+ index(@{aTable}, @{aIndex}) */ count(@{aKeyCol}) idx_key_cnt,
         nvl(sum(@{aKeyCol}), -1) idx_sum,
         nvl(min(@{aKeyCol}), -1) idx_min,
         nvl(max(@{aKeyCol}), -1) idx_max
  from @{aTable}
  where @{aKeyCol} is not null;
}
#
# 파티션별 행 수의 합이 전체와 같은지 확인한다.
# 파티션 3개 + default 구성(p1,p2,p3)을 전제한다.
#
DEF CHECK_PARTITION_COUNT( @aTable )
{
  select count(*) total_cnt from @{aTable};

  select 'P1' part_name, count(*) part_cnt from @{aTable} partition (p1)
  union all
  select 'P2', count(*) from @{aTable} partition (p2)
  union all
  select 'P3', count(*) from @{aTable} partition (p3)
  order by 1;
}
#
# 위 검사를 한 번에 수행한다. 시나리오 끝마다 호출한다.
#
DEF CHECK_GLOBAL_INDEX( @aTable, @aIndex, @aCols, @aKeyCol )
{
  CALL CHECK_INDEX_SCAN( "@{aTable}", "@{aIndex}", "@{aCols}", "@{aKeyCol} is not null" );
  CALL CHECK_INDEX_COUNT( "@{aTable}", "@{aIndex}", "@{aKeyCol}" );
  CALL CHECK_PARTITION_COUNT( "@{aTable}" );
}
###########################################################################
# TestCase Description = 테이블 잠금과 글로벌 인덱스.
#
#                        글로벌 인덱스 스캔은 논리 테이블을 열고 여러
#                        파티션의 로우를 반환한다. 그래서 잠금이 논리
#                        테이블과 파티션 어느 쪽에, 어떤 모드로 걸리는지가
#                        로컬 인덱스와 다르다.
#                        구버전 design/table_lock.tc 에 해당한다.
#                        (여러 세션이 필요한 경합 시험은 deferred/ 참조)
# Project ID           = Native Global Index (memory)
###########################################################################


DEF FINALIZE()
{
# 자동 커밋을 되돌린다. 이 파일이 껐으므로 다음 케이스에 새면 안 된다.
alter session set autocommit = true;
SKIP BEGIN;
drop table t1;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

#
# 현재 세션이 잡고 있는 잠금을 보여 준다.
#
DEF SHOW_LOCK()
{
# V$LOCK 이 들고 있는 것은 TABLE_ID 가 아니라 TABLE_OID 다.
# (LOCK_ITEM_TYPE, TBS_ID, TABLE_OID, DBF_ID, TRANS_ID, LOCK_DESC,
#  LOCK_CNT, IS_GRANT)
  select t.table_name, l.lock_desc
  from v$lock l, system_.sys_tables_ t
  where l.table_oid = t.table_oid
    and t.user_id = user_id()
    and t.table_name like 'T1%'
  order by t.table_name, l.lock_desc;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index lidx1 on t1(i4) local;

CALL FILL_RANGE_DATA();

##################################
# SECTOR; EXPLICIT LOCK TABLE
##################################
# 논리 테이블에 명시적으로 잠금을 건다.
#
# LOCK TABLE 은 자동 커밋 상태에서 쓸 수 없다(ERR-41057). 잠금을 잡자마자
# 커밋되어 버리면 의미가 없기 때문이다. 이 파일은 잠금을 잡고 V$LOCK 을
# 들여다보는 것이 목적이므로 여기서부터 자동 커밋을 끈다.
alter session set autocommit = false;

lock table t1 in share mode;
CALL SHOW_LOCK();
commit;

lock table t1 in exclusive mode;
CALL SHOW_LOCK();
commit;

lock table t1 in row share mode;
CALL SHOW_LOCK();
commit;

lock table t1 in row exclusive mode;
CALL SHOW_LOCK();
commit;

##################################
# SECTOR; LOCK WITH PARTITION
##################################
# 파티션 단위 잠금.

lock table t1 partition (p1) in exclusive mode;
CALL SHOW_LOCK();
commit;

lock table t1 partition (p2) in share mode;
CALL SHOW_LOCK();
commit;

##################################
# SECTOR; LOCK WAIT OPTION
##################################

lock table t1 in exclusive mode nowait;
commit;

lock table t1 in exclusive mode wait 1;
commit;

##################################
# SECTOR; SELECT DOES NOT BLOCK
##################################
# 일반 조회는 잠금을 거의 잡지 않는다.

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;
CALL SHOW_LOCK();
commit;

##################################
# SECTOR; SELECT FOR UPDATE
##################################
# 글로벌 인덱스로 읽은 로우를 잠근다. 여러 파티션에 걸칠 수 있다.

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 = 5 for update;
CALL SHOW_LOCK();
commit;

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 in (5, 105, 205) order by i1 for update;
CALL SHOW_LOCK();
commit;

# 파티션을 지정하면 그 파티션만 대상이어야 한다
select /*+ index(t1, gidx1) */ i1, i2 from t1 partition (p1) where i2 is not null order by i1 for update;
CALL SHOW_LOCK();
commit;

##################################
# SECTOR; DML LOCK
##################################

update t1 set i4 = i4 + 1 where i2 = 5;
CALL SHOW_LOCK();
commit;

delete from t1 where i2 = 6;
CALL SHOW_LOCK();
commit;

insert into t1 values (60, 60000, 1, 1);
CALL SHOW_LOCK();
commit;

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; DDL LOCK
##################################
# 파티션 집합을 바꾸는 DDL 은 논리 테이블에 강한 잠금이 필요하다.
# 글로벌 인덱스가 있으면 스캔이 파티션 목록을 보는 중에 그 목록이
# 바뀌면 안 되기 때문이다.

alter table t1 add partition p4 values less than (400);
CALL SHOW_LOCK();
commit;

alter table t1 truncate partition p4;
commit;

alter table t1 drop partition p4;
commit;

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; LOCK AND ROLLBACK
##################################

lock table t1 in exclusive mode;
update t1 set i4 = i4 + 1 where i1 < 10;
rollback;

CALL SHOW_LOCK();
CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; ACCESS OPTION
##################################
# 읽기 전용으로 막힌 파티션에 대한 DML 은 실패해야 한다.

alter table t1 alter partition p1 access read only;

select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is not null;

update t1 set i4 = i4 + 1 where i1 < 10;

insert into t1 values (10, 70000, 1, 1);

# 다른 파티션은 여전히 갱신 가능해야 한다
update t1 set i4 = i4 + 1 where i1 >= 200;
commit;

alter table t1 alter partition p1 access read write;

update t1 set i4 = i4 + 1 where i1 < 10;
commit;

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
