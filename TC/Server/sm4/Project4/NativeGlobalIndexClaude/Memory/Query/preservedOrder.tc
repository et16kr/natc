###########################################################################
# TestCase Description = 정렬 순서 보존.
#
#                        글로벌 인덱스는 전 파티션을 아우르는 하나의 정렬
#                        순서를 제공한다. 로컬 인덱스는 파티션별로만 정렬돼
#                        있어 파티션을 넘는 순서를 보장하지 못한다. 이것이
#                        글로벌 인덱스의 대표적인 이득이므로, ORDER BY /
#                        DISTINCT / GROUP BY / ROLLUP / CUBE 에서 순서가
#                        올바른지 확인한다.
#                        구버전 design/preserved_order.tc, bugs/rollup.tc 에
#                        해당한다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL SHOW_PLAN_OFF();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index gidx2 on t1(i3, i2);
create index lidx1 on t1(i4) local;

# 파티션 사이에 값이 교차하도록 넣는다. 파티션별로만 정렬돼 있으면
# 전체 순서가 틀어지는 구성이다.
insert into t1 select level,       level * 3,     mod(level, 5), level from dual connect by level <= 30;
insert into t1 select level + 100, level * 3 + 1, mod(level, 5), level from dual connect by level <= 30;
insert into t1 select level + 200, level * 3 + 2, mod(level, 5), level from dual connect by level <= 30;
commit;

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; ORDER BY ON INDEX KEY
##################################
# 인덱스 순서를 그대로 쓸 수 있으면 별도 정렬이 필요 없다.

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2;
select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2 desc;
select /*+ index(t1, gidx1) */ i2 from t1 where i2 > 50 order by i2;

CALL SHOW_PLAN_OFF();

# 순서가 실제로 맞는지. 파티션 경계를 넘는 구간을 본다.
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 between 88 and 100 order by i2;

##################################
# SECTOR; ORDER BY COMPARED WITH LOCAL INDEX
##################################
# 같은 질의를 로컬 인덱스로 실행한 결과와 비교한다. 두 결과의 집합이
# 같아야 하고, 정렬을 명시했으므로 순서도 같아야 한다.

select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2;
select /*+ FULL SCAN(t1) */ i2 from t1 where i2 is not null order by i2;

##################################
# SECTOR; ORDER BY WITH LIMIT
##################################
# 앞쪽 몇 건만 필요할 때 인덱스 순서를 쓰면 전체 정렬을 피할 수 있다.

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null order by i2 limit 5;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null order by i2 desc limit 5;

CALL SHOW_PLAN_OFF();

##################################
# SECTOR; COMPOSITE KEY ORDER
##################################
# 복합 키의 선두 컬럼 순서, 그리고 두 컬럼 모두의 순서.

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx2) */ i3, i2 from t1 where i3 is not null order by i3;
select /*+ index(t1, gidx2) */ i3, i2 from t1 where i3 is not null order by i3, i2;

CALL SHOW_PLAN_OFF();

select /*+ index(t1, gidx2) */ i3, i2 from t1 where i3 = 1 order by i3, i2;

##################################
# SECTOR; MIN MAX
##################################

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx1) */ min(i2) from t1;
select /*+ index(t1, gidx1) */ max(i2) from t1;
select /*+ index(t1, gidx2) */ min(i3) from t1;

CALL SHOW_PLAN_OFF();

select min(i2), max(i2), min(i3), max(i3) from t1;

##################################
# SECTOR; DISTINCT
##################################
# 정렬된 입력이면 중복 제거가 싸진다.

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx2) */ distinct i3 from t1 order by i3;

CALL SHOW_PLAN_OFF();

select distinct i3 from t1 order by i3;
select count(distinct i3) from t1;
select count(distinct i2) from t1;

##################################
# SECTOR; GROUP BY
##################################

CALL SHOW_PLAN_ON();

select /*+ index(t1, gidx2) */ i3, count(*) from t1 group by i3 order by i3;

CALL SHOW_PLAN_OFF();

select i3, count(*), min(i2), max(i2) from t1 group by i3 order by i3;

##################################
# SECTOR; ROLLUP
##################################
# 소계가 붙는 집계. 정렬 보존이 잘못되면 그룹 경계가 틀어진다.

select i3, count(*) from t1 group by rollup(i3) order by i3;

select i3, mod(i2, 3) m2, count(*)
from t1
group by rollup(i3, mod(i2, 3))
order by i3, m2;

##################################
# SECTOR; CUBE
##################################

select i3, mod(i2, 3) m2, count(*)
from t1
group by cube(i3, mod(i2, 3))
order by i3, m2;

##################################
# SECTOR; GROUPING SETS
##################################

select i3, mod(i2, 3) m2, count(*)
from t1
group by grouping sets( (i3), (mod(i2, 3)), () )
order by i3, m2;

##################################
# SECTOR; ORDER BY AFTER DML
##################################
# 값이 바뀐 뒤에도 순서가 유지되어야 한다.

update t1 set i2 = i2 + 1000 where i1 < 10;
commit;

select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2;
select /*+ FULL SCAN(t1) */ i2 from t1 where i2 is not null order by i2;

delete from t1 where i1 between 100 and 110;
commit;

select /*+ index(t1, gidx1) */ i2 from t1 where i2 is not null order by i2;
select /*+ FULL SCAN(t1) */ i2 from t1 where i2 is not null order by i2;

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; ORDER BY WITH PARTITION SPECIFIED
##################################

select /*+ index(t1, gidx1) */ i2 from t1 partition (p1) where i2 is not null order by i2;
select /*+ index(t1, gidx1) */ i2 from t1 partition (p3) where i2 is not null order by i2;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
