1 row selected.

$T0> ##################################
$T0> # SECTOR; SCALAR SUBQUERY
$T0> ##################################

$T0> select /*+ index(t1, gidx1) */ i1, i2
from t1
where i2 = ( select max(c2) from t2 where c1 < 10 )
order by i1;
