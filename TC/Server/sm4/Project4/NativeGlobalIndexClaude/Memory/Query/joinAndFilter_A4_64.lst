$T0> ##################################
$T0> # SECTOR; SUBQUERY KEY RANGE
$T0> ##################################
$T0> # 서브쿼리 결과가 글로벌 인덱스의 키 레인지가 된다.

$T0> select /*+ index(t1, gidx1) */ i1, i2
from t1
where i2 in ( select c2 from t2 where c1 < 5 )
order by i1;
I1          I2          
---------------------------
1           1           
2           2           
3           3           
4           4           
4 rows selected.

$T0> select /*+ index(t1, gidx1) */ count(*)
from t1
where i2 in ( select c2 from t2 );
COUNT                
-----------------------
30                   
1 row selected.

$T0> # 서브쿼리가 여러 파티션에 걸친 값을 반환하는 경우
$T0> select /*+ index(t1, gidx1) */ i1, i2
from t1
where i2 in ( select c2 from t2 where c2 in (5, 105, 205) )
order by i1;
