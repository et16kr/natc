###########################################################################
# TestCase Description = Cover Memory pruning of zero, one, many, and all partitions.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-QRY-006
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
# 출처                 = NativeGlobalIndexCodex/Memory/Query/pruningCardinality.tc (통합 Phase D 흡수)
#                        원본은 codex 브랜치가 관리한다. 고칠 일이 생기면 그쪽도 본다.
# 흡수 시 더한 것       = (1) 프로퍼티 못박기 -- 원본은 자기 전제를 세우지 않아
#                            앞 케이스가 남긴 값을 물려받았다(계획 §5.4)
#                        (2) INDEX_IMPL_TYPE 제거 -- SYS_INDICES_ 에 없는 컬럼이라
#                            원본 질의가 ERR-31058 로 죽는다. 판별자는 INDEX_TABLE_ID
#                            (네이티브 = 0) 하나로 충분하다
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    DROP TABLE NGM_QRY_PRUNE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
    select name, value1 from v$property where name = 'MEM_GLOBAL_INDEX_ENABLE';

    CREATE TABLE NGM_QRY_PRUNE (P INTEGER, K VARCHAR(32), V VARCHAR(8))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION P3 VALUES LESS THAN (30),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_QRY_PRUNE_I ON NGM_QRY_PRUNE(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_QRY_PRUNE VALUES (1, 'K-101', 'P1');
    INSERT INTO NGM_QRY_PRUNE VALUES (11, 'K-111', 'P2');
    INSERT INTO NGM_QRY_PRUNE VALUES (21, 'K-121', 'P3');
    INSERT INTO NGM_QRY_PRUNE VALUES (31, 'K-131', 'PD');

##################################
SECTOR; TEST
##################################
    ALTER SESSION SET EXPLAIN PLAN = ON;
    SELECT 'ZERO' AS SCOPE, COUNT(*) FROM NGM_QRY_PRUNE
     WHERE P < 0 AND K >= 'K-100';
    SELECT 'ONE' AS SCOPE, COUNT(*) FROM NGM_QRY_PRUNE
     WHERE P >= 10 AND P < 20 AND K >= 'K-100';
    SELECT 'MANY' AS SCOPE, COUNT(*) FROM NGM_QRY_PRUNE
     WHERE P < 30 AND K >= 'K-100';
    SELECT 'ALL' AS SCOPE, COUNT(*) FROM NGM_QRY_PRUNE
     WHERE K >= 'K-100';
    SELECT /*+ INDEX(NGM_QRY_PRUNE, NGM_QRY_PRUNE_I) */ P, K, V
      FROM NGM_QRY_PRUNE WHERE P < 30 AND K >= 'K-100' ORDER BY K;
    ALTER SESSION SET EXPLAIN PLAN = OFF;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    DROP TABLE NGM_QRY_PRUNE;
    SKIP END;
}
