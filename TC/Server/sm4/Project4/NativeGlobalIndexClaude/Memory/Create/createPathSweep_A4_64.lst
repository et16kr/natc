$T0> ##################################
$T0> SECTOR 5; C -- CREATE TABLE 안의 PRIMARY KEY
$T0> ##################################
$T0> CREATE TABLE NGM_CPS_C ( P INTEGER, K INTEGER,
                             CONSTRAINT NGM_CPS_C_PK PRIMARY KEY ( K ) )
    PARTITION BY RANGE ( P )
    ( PARTITION P1 VALUES LESS THAN ( 10 ), PARTITION PD VALUES DEFAULT )
    TABLESPACE SYS_TBS_MEM_DATA;
[ERR-31415 : A primary key or unique key constraint can be defined for a non-partitioned index on a disk partitioned table.]

$T0> SELECT COUNT(*) AS C_TABLE_CREATED
      FROM SYSTEM_.SYS_TABLES_ WHERE TABLE_NAME = 'NGM_CPS_C';
C_TABLE_CREATED      
-----------------------
