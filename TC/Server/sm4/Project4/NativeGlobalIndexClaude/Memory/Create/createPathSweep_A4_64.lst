$T0> ##################################
$T0> SECTOR 6; D -- ★★ 표적. FROM TABLE SCHEMA 는 검증기를 안 거친다
$T0> ##################################
$T0> # 원본 NGM_CPS_SRC 에는 게이트가 열려 있을 때 만든 네이티브 글로벌 인덱스가
$T0> # 있다. 그 스키마를 복제하면 인덱스도 복제된다 -- 게이트가 닫힌 지금.
$T0> CREATE TABLE NGM_CPS_D FROM TABLE SCHEMA NGM_CPS_SRC USING PREFIX ZZ;
[ERR-313D0 : A non-partitioned index can be created on a disk partitioned table.]

$T0> SELECT COUNT(*) AS D_TABLE_CREATED
      FROM SYSTEM_.SYS_TABLES_ WHERE TABLE_NAME = 'NGM_CPS_D';
D_TABLE_CREATED      
-----------------------
0                    
1 row selected.

$T0> # ★ 여기가 판정이다. 0 이면 게이트가 이 경로도 막은 것이고(예측 ㄱ),
$T0> #   1 이상이면 **프로퍼티 0 인데 네이티브 글로벌 인덱스가 생긴 것**이다(ㄴ).
$T0> SELECT COUNT(*) AS D_IS_NATIVE_GLOBAL
      FROM SYSTEM_.SYS_PART_INDICES_ P, SYSTEM_.SYS_INDICES_ I, SYSTEM_.SYS_TABLES_ T
     WHERE P.INDEX_ID = I.INDEX_ID AND I.TABLE_ID = T.TABLE_ID
       AND P.PARTITION_TYPE = 101 AND T.TABLE_NAME = 'NGM_CPS_D';
D_IS_NATIVE_GLOBAL   
-----------------------
0                    
1 row selected.

$T0> # 만들어졌다면 그것이 실제로 도는지까지 본다 -- 게이트가 닫힌 채로
$T0> # 글로벌 유일성이 서면 회계가 완전히 새는 것이다.
$T0> SELECT COUNT(*) AS D_INDEX_ROWS
      FROM SYSTEM_.SYS_INDICES_ I, SYSTEM_.SYS_TABLES_ T
     WHERE I.TABLE_ID = T.TABLE_ID AND T.TABLE_NAME = 'NGM_CPS_D';
D_INDEX_ROWS         
-----------------------
0                    
1 row selected.

$T0> ##################################
$T0> SECTOR 7; E -- ALTER INDEX REBUILD (validateAlterRebuild)
$T0> ##################################
$T0> # 이미 있는 네이티브 글로벌 인덱스를 게이트가 닫힌 상태에서 다시 세운다.
$T0> ALTER INDEX NGM_CPS_SRC_G REBUILD;
Alter success.

$T0> SELECT COUNT(*) AS E_STILL_NATIVE_GLOBAL
