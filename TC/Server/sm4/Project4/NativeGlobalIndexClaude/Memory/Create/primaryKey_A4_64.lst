$T0> ##################################
$T0> # SECTOR; PK IN CREATE TABLE
$T0> ##################################
$T0> # 테이블 생성 구문에서 바로 PK 를 준다.
$T0> #
$T0> # ★ 제약 이름을 반드시 준다. 이름 없이 두면 인덱스 이름이
$T0> #   __SYS_IDX_ID_<전역 증가 번호> 로 생성되어 실행할 때마다 달라지고,
$T0> #   desc 출력이 비결정적이 되어 .lst 를 만들 수 없다.


$T0> create table t1( i1 integer, i2 integer constraint t1_pk primary key, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

