$T0> ##################################
$T0> # SECTOR; PREFIX AND NON-PREFIX
$T0> ##################################
$T0> # 파티션 키(i1)를 포함하는 인덱스와 포함하지 않는 인덱스.
$T0> # 글로벌 인덱스의 가치는 파티션 키를 포함하지 않는 쪽에 있다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> # prefix: 파티션 키로 시작
$T0> create index idx1 on t1(i1);
Create success.
$T0> create index idx2 on t1(i1, i2);
Create success.

$T0> # non-prefix: 파티션 키를 포함하지만 선두가 아님
$T0> create index idx3 on t1(i2, i1);
Create success.

$T0> # 파티션 키 무관
$T0> create index idx4 on t1(i2);
Create success.
$T0> create index idx5 on t1(i2, i3);
Create success.
$T0> create index idx6 on t1(i4, i3, i2);
Create success.

$T0> desc t1;
