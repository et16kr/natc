###########################################################################
# TestCase Description = 메모리 파티션드 테이블에 네이티브 글로벌 인덱스를
#                        생성한다. range/hash/list, prefix/non-prefix,
#                        unique/non-unique 조합.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; LOCAL VS GLOBAL
##################################
# LOCAL 키워드가 있으면 로컬 인덱스, 없으면 글로벌 인덱스다.
# 구버전에서는 메모리 파티션드 테이블에 글로벌 인덱스를 만들 수 없었다.

for $sPartType in "range" "hash" "list"
{
  CALL CREATE_MEM_PART_TABLE( $sPartType, "integer", "integer" );

  create index idx1 on t1(i2) local;
  create index idx2 on t1(i3);

  desc t1;
  CALL SELECT_INDEX_META( "t1" );
}

##################################
# SECTOR; PREFIX AND NON-PREFIX
##################################
# 파티션 키(i1)를 포함하는 인덱스와 포함하지 않는 인덱스.
# 글로벌 인덱스의 가치는 파티션 키를 포함하지 않는 쪽에 있다.

for $sPartType in "range" "hash" "list"
{
  CALL CREATE_MEM_PART_TABLE( $sPartType, "integer", "integer" );

  # prefix: 파티션 키로 시작
  create index idx1 on t1(i1);
  create index idx2 on t1(i1, i2);

  # non-prefix: 파티션 키를 포함하지만 선두가 아님
  create index idx3 on t1(i2, i1);

  # 파티션 키 무관
  create index idx4 on t1(i2);
  create index idx5 on t1(i2, i3);
  create index idx6 on t1(i4, i3, i2);

  desc t1;
  CALL SELECT_INDEX_META( "t1" );
}

##################################
# SECTOR; UNIQUE
##################################
# 글로벌 유니크는 파티션 간 유일성을 보장한다.
# localunique 는 파티션 안에서만 유일하다.

for $sPartType in "range" "hash" "list"
{
  CALL CREATE_MEM_PART_TABLE( $sPartType, "integer", "integer" );

  create localunique index idx1 on t1(i2) local;
  create unique index idx2 on t1(i3);

  desc t1;
  CALL SELECT_INDEX_META( "t1" );
}

##################################
# SECTOR; DATA TYPE
##################################
# 키 컬럼 타입별 생성. varchar 는 variable 컬럼이라 별도 위험이 있다
# (datatype/varcharKey.tc 참조).

for $sColType in "integer" "bigint" "numeric(10,2)" "char(10)" "varchar(20)" "date"
{
  CALL CREATE_MEM_PART_TABLE( "range", "integer", $sColType );

  create index idx1 on t1(i2);
  create index idx2 on t1(i2, i3);

  desc t1;
  CALL SELECT_INDEX_META( "t1" );
}

##################################
# SECTOR; CREATE ON EXISTING DATA
##################################
# 빈 테이블이 아니라 데이터가 있는 상태에서 만든다.
# 이 경로는 다중 파티션 로우 스트림으로 bottom-up 빌드를 수행한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );
CALL FILL_RANGE_DATA();

create index idx1 on t1(i2);

select count(*) from t1;
select /*+ index(t1, idx1) */ count(i2) from t1 where i2 is not null;

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; EMPTY PARTITION INCLUDED
##################################
# 중간 파티션이 비어 있어도 빌드가 정상이어야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

insert into t1 select level, level, level, level from dual connect by level <= 10;
insert into t1 select level + 200, level + 200, level, level from dual connect by level <= 10;
commit;

# p2 는 비어 있다
select count(*) from t1 partition (p2);

create index idx1 on t1(i2);

select /*+ index(t1, idx1) */ count(i2) from t1 where i2 is not null;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
