###########################################################################
# TestCase Description = CREATE TABLE ... FROM TABLE SCHEMA.
#
#   원본 테이블의 스키마를 그대로 복제해 새 테이블을 만든다. 인덱스도
#   함께 복제되므로, 원본에 네이티브 글로벌 인덱스가 있으면 사본에도
#   글로벌 인덱스가 만들어져야 한다.
#
#   V1 은 이 경로를 ERR-314B0 으로 거부했다. V2 의 J05 가 그 거부를
#   createGlobalIndex 호출로 대체했으므로 지금은 성공해야 한다.
#   (qpERR_ABORT_QDX_GLOBAL_INDEX_COPY_NOT_SUPPORTED 는 raise 사이트가
#    하나도 남지 않은 고아 메시지다.)
#
#   확인할 것:
#     - 사본의 인덱스도 판별자 101 이고 숨김 객체가 없다
#     - 사본의 유일성이 독립적으로 강제된다 (원본과 섞이면 안 된다)
#     - 원본과 사본의 인덱스가 서로의 로우를 가리키지 않는다
#
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;
INCLUDE ../../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
CALL FINALIZE_MEM_TBS();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; COPY A TABLE THAT HAS A GLOBAL INDEX
##################################

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();
CALL SELECT_INDEX_META( "t1" );

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2 from table schema t1 using prefix zz;

# 사본의 카탈로그. 판별자 101, 숨김 객체 없음이어야 한다.
CALL SELECT_INDEX_META( "t2" );

desc t2;

# 스키마만 복제된다. 데이터는 안 온다.
select count(*) from t1;
select count(*) from t2;

##################################
# SECTOR; THE COPY'S INDEX WORKS INDEPENDENTLY
##################################

insert into t2 select level,       level,       level, level from dual connect by level <= 20;
insert into t2 select level + 100, level + 100, level, level from dual connect by level <= 20;
commit;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t2", "zzgidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t2", "zzgidx1", "i2" );

# 원본은 영향을 받지 않아야 한다
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_COUNT( "t1", "gidx1", "i2" );

##################################
# SECTOR; COPY A TABLE THAT HAS A UNIQUE GLOBAL INDEX
##################################
# 유일성이 사본에서 독립적으로 강제되어야 한다. 원본의 값과 겹치는
# 것은 사본에 들어갈 수 있어야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10,  100, 1, 1);
insert into t1 values (150, 200, 2, 2);
commit;

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2 from table schema t1 using prefix zz;

CALL SELECT_INDEX_META( "t2" );

# 원본에 있는 값 -> 사본에는 들어가야 한다
insert into t2 values (10, 100, 1, 1);
commit;

# 사본 안에서의 중복 -> 실패해야 한다
insert into t2 values (150, 100, 2, 2);

# 사본 안의 새 값 -> 성공
insert into t2 values (150, 200, 2, 2);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;
select /*+ FULL SCAN(t2) */ i1, i2 from t2 order by i1;

# 원본의 유일성도 그대로여야 한다
insert into t1 values (250, 100, 3, 3);

insert into t1 values (250, 300, 3, 3);
commit;

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

##################################
# SECTOR; DROPPING THE COPY DOES NOT TOUCH THE ORIGINAL
##################################
# 사본을 지울 때 원본의 인덱스에서 키를 지우면 안 된다.

drop table t2;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "t1_uk", "i1, i2", "i2 is not null" );

insert into t1 values (260, 400, 4, 4);
commit;

# 원본의 유일성은 계속 살아 있어야 한다
insert into t1 values (270, 400, 5, 5);

select /*+ FULL SCAN(t1) */ i1, i2 from t1 order by i1;

##################################
# SECTOR; COPY WITH LOCAL AND GLOBAL INDEXES MIXED
##################################

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index lidx1 on t1(i3) local;

CALL FILL_RANGE_DATA();
CALL SELECT_INDEX_META( "t1" );

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2 from table schema t1 using prefix zz;

# 사본에서 글로벌은 101, 로컬은 로컬 그대로여야 한다
CALL SELECT_INDEX_META( "t2" );

##################################
# SECTOR; COPY ON MULTI TABLESPACE
##################################

CALL CREATE_MEM_PART_TABLE_MULTI_TBS( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t2 from table schema t1 using prefix zz;

CALL SELECT_INDEX_META( "t2" );

insert into t2 select level, level, level, level from dual connect by level <= 20;
commit;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t2", "zzgidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; PROPERTY OFF - COPY OF A LOCAL-ONLY TABLE (회귀)
##################################

CALL DISABLE_GLOBAL_INDEX();

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data;

create index lidx1 on t1(i2) local;

create table t2 from table schema t1 using prefix zz;

CALL SELECT_INDEX_META( "t2" );

CALL ENABLE_GLOBAL_INDEX();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
