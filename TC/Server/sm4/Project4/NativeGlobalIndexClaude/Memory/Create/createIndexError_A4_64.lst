 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Native Global Index - environment helpers
$T0> #
$T0> # 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
$T0> # 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
$T0> #   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
$T0> #   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 허용한다.
$T0> #

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
$T0> # off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
$T0> # 기존과 동일하게 거부되어야 한다.
$T0> #

$T0> #
$T0> # 현재 설정 확인.
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - memory partitioned table helpers
$T0> #
$T0> # 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
$T0> # (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
$T0> # 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
$T0> #
$T0> # 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
$T0> # 메모리 테이블스페이스에 있다.
$T0> ###########################################################################

$T0> #
$T0> # 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
$T0> #
$T0> # @aPartType : range | hash | list
$T0> # @aKeyType  : 파티션 키 컬럼 타입
$T0> # @aColType  : 나머지 컬럼 타입
$T0> #
$T0> # 컬럼 구성: i1(파티션 키), i2, i3, i4
$T0> #

$T0> #
$T0> # 파티션을 서로 다른 메모리 테이블스페이스에 흩어 놓는다.
$T0> #
$T0> # 이 구성이 네이티브 글로벌 인덱스에서 가장 위험하다:
$T0> #   - rowOID 는 테이블스페이스 안에서만 유일하다. 서로 다른 TBS 의 두
$T0> #     로우가 같은 rowOID 를 가질 수 있고, tie-break 가 (tableOID, rowOID)
$T0> #     로 확장되지 않았다면 두 키를 같은 것으로 오인한다.
$T0> #   - variable 컬럼의 out-of-row piece 접근은 컬럼 서술자의 colSpace 로
$T0> #     테이블스페이스를 고른다. 보정이 없으면 다른 파티션 로우의 값을
$T0> #     엉뚱한 TBS 에서 읽는다(크래시가 아니라 조용한 오독).
$T0> #
$T0> # PREPARE_MEM_TBS() 로 만든 mem1/mem2/mem3 를 쓴다.
$T0> #

$T0> #
$T0> # 다중 TBS 테스트용 메모리 테이블스페이스를 만든다.
$T0> #

$T0> #
$T0> # range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
$T0> # i1: 파티션 키, i2/i3/i4: 값
$T0> #

$T0> #
$T0> # hash/list 파티션 테이블에 데이터를 넣는다.
$T0> #

$T0> ###########################################################################
$T0> # TestCase Description = 네이티브 글로벌 인덱스 생성이 거부되어야 하는
$T0> #                        조합들. 각 항목은 서버가 "명시적 에러"로 막기로 한
$T0> #                        지점이다.
$T0> #
$T0> #   현재 살아 있는 거부 (altidev4 소스 기준):
$T0> #     ERR-314AB  MEDIA MISMATCH   qdx.cpp:10464, 10541-10543
$T0> #                                 논리 테이블/파티션의 매체가 섞인 경우.
$T0> #                                 hybrid, volatile 파티션도 여기로 온다.
$T0> #     ERR-313D0  PROPERTY OFF     qdx.cpp:10537-10539
$T0> #                                 기존 메시지. 프로퍼티가 꺼진 상태의
$T0> #                                 메모리 파티션드 테이블 non-partitioned
$T0> #                                 index 는 종전대로 거부된다.
$T0> #     ERR-314AD  UNSUPPORTED_KEY  qdx.cpp:2038(DIRECT KEY), 2041(PERSISTENT),
$T0> #                                 2048(COMPRESSED key column)
$T0> #     ERR-314AC  COUNT_EXCEEDED   qdx.cpp:2072  (indexBudget.tc 로 분리)
$T0> #     ERR-314B2  ALL INDEX        qdbAlter.cpp:2011  (allIndexAndTablespace.tc)
$T0> #     ERR-314B3  REPLICATION      qdx.cpp:2113       (replicationReject.tc)
$T0> #
$T0> #   V2 가 걷어낸 거부 (더 이상 나오지 않는다 — 성공해야 한다):
$T0> #     SPLIT / MERGE / ADD HASH / COALESCE      (구 ERR-314AE)
$T0> #     ADD / DROP / MODIFY / REORGANIZE COLUMN  (구 ERR-314AF)
$T0> #     TRUNCATE TABLE, CREATE TABLE ... FROM TABLE SCHEMA (구 ERR-314B0)
$T0> #
$T0> # Project ID           = Native Global Index (memory)
$T0> ###########################################################################

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop tablespace mem1 including contents and datafiles;
$T0> drop tablespace mem2 including contents and datafiles;
$T0> drop tablespace mem3 including contents and datafiles;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop tablespace disk1 including contents and datafiles;
$T0> drop tablespace vol1 including contents and datafiles;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> SKIP BEGIN;
$T0> drop tablespace mem1 including contents and datafiles;
$T0> drop tablespace mem2 including contents and datafiles;
$T0> drop tablespace mem3 including contents and datafiles;
$T0> SKIP END;

$T0> create memory tablespace mem1 size 32M autoextend on checkpoint path 'dbs';
Create success.
$T0> create memory tablespace mem2 size 32M autoextend on checkpoint path 'dbs';
Create success.
$T0> create memory tablespace mem3 size 32M autoextend on checkpoint path 'dbs';
Create success.

$T0> create tablespace disk1 datafile 'disk1.dbf' size 10M autoextend on;
Create success.
$T0> create volatile tablespace vol1 size 32M autoextend on;
Create success.

$T0> ##################################
$T0> # SECTOR; MEDIA MISMATCH
$T0> ##################################
$T0> # 논리 테이블의 테이블스페이스 매체와 파티션 매체가 다르면 커서를 열 수
$T0> # 없다. 인덱스 모듈은 테이블 타입으로 선택되는데, 논리 테이블이 다른
$T0> # 매체에 있으면 모듈과 테이블 타입이 어긋나기 때문이다.
$T0> # 인덱스는 만들어지는데 조회가 안 되는 상태가 되면 안 되므로 생성에서
$T0> # 막아야 한다. -> ERR-314AB


$T0> create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values default tablespace mem2
)
tablespace sys_tbs_disk_data;
Create success.

$T0> # 논리 테이블은 디스크, 파티션은 메모리 -> 거부되어야 한다
$T0> create index idx1 on t1(i2);
[ERR-314AB : A native global index requires the partitioned table and every one of its partitions to reside in memory tablespaces.]

$T0> ##################################
$T0> # SECTOR; HYBRID PARTITIONED TABLE
$T0> ##################################
$T0> # 메모리 파티션과 디스크 파티션이 섞인 테이블. V1/V2 범위 밖이며
$T0> # 같은 매체 검사에 걸린다. -> ERR-314AB


$T0> create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values default tablespace disk1
);
Create success.

$T0> create index idx1 on t1(i2);
[ERR-314AB : A native global index requires the partitioned table and every one of its partitions to reside in memory tablespaces.]

$T0> ##################################
$T0> # SECTOR; VOLATILE PARTITION
$T0> ##################################
$T0> # 파티션이 휘발성 테이블스페이스에 있는 구성.
$T0> #
$T0> # 주의: 'create volatile table' 이라는 구문은 없다. 휘발성 테이블은
$T0> #       'create volatile tablespace' 로 만든 테이블스페이스에 테이블을
$T0> #       두는 방식이다. 파티션드가 아닌 휘발성 테이블은 애초에 글로벌/로컬
$T0> #       구분이 없으므로 이 섹터의 시험 대상이 아니다.
$T0> #
$T0> # 기대: ERR-314AB. 메시지의 *Cause 가 "in a disk or volatile tablespace,
$T0> #       so a single index cannot span them" 이라고 명시한다.


$T0> # 전 파티션이 휘발성
$T0> create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace vol1,
  partition p2 values default tablespace vol1
);
[ERR-11117 : Log compression is not supported for volatile tablespaces.]

$T0> create index idx1 on t1(i2);
[ERR-31031 : Table or view was not found : 
0001 : create index IDX1 on T1(I2)
                           ^ ^
]

$T0> # 로컬 인덱스는 되어야 한다
$T0> create index idx2 on t1(i2) local;
[ERR-31031 : Table or view was not found : 
0001 : create index IDX2 on T1(I2) local
                           ^ ^
]

$T0> desc t1;
[ERR-91014 : The table (T1) does not exist.]


$T0> # 메모리 파티션과 휘발성 파티션이 섞인 구성
$T0> create table t1( i1 integer, i2 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values default tablespace vol1
);
[ERR-11117 : Log compression is not supported for volatile tablespaces.]

$T0> create index idx1 on t1(i2);
[ERR-31031 : Table or view was not found : 
0001 : create index IDX1 on T1(I2)
                           ^ ^
]

$T0> ##################################
$T0> # SECTOR; DIRECTKEY INDEX
$T0> ##################################
$T0> # direct key 인덱스는 글로벌로 만들 수 없다.
$T0> #
$T0> # 주의: 키워드는 DIRECTKEY 다(qcply.y:14941). 그리고 파티션드 테이블에
$T0> #       대해서는 기존 검사가 먼저 걸릴 수 있어, 여기서 보이는 것이
$T0> #       ERR-314AD 가 아닐 수 있다. 어느 쪽이 나오든 "거부된다"는 사실을
$T0> #       이 섹터가 고정한다. .lst 생성 때 실제 코드를 기록할 것.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index idx1 on t1(i2) directkey;
[ERR-111A9 : Direct key indexes do not support partitioned tables.]

$T0> ##################################
$T0> # SECTOR; PERSISTENT INDEX
$T0> ##################################
$T0> # PERSISTENT 는 CREATE INDEX 의 옵션이 아니다 -- qcply.y 에서 그 키워드는
$T0> # alter_index_set_clause(ALTER INDEX ~ PERSISTENT ON/OFF) 에만 있다.
$T0> # 그래서 만들 때가 아니라 만든 뒤에 켜는 것으로 시험한다.
$T0> # 기대: ERR-314AD (UNSUPPORTED_KEY: PERSISTENT).

$T0> create index idx1 on t1(i2);
Create success.

$T0> alter index idx1 persistent on;
Alter success.

$T0> drop index idx1;
Drop success.

$T0> ##################################
$T0> # SECTOR; COMPRESSED KEY COLUMN
$T0> ##################################
$T0> # ERR-314AD (UNSUPPORTED_KEY: COMPRESSED key column)


$T0> # 압축은 컬럼 뒤에 붙이는 키워드가 아니라 테이블 수준 COMPRESS 절이다.
$T0> create table t1( i1 integer, i2 integer, i3 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values default
)
tablespace sys_tbs_mem_data
compress ( i2 );
[ERR-313B6 : Unsupported data type on compression column. 
0001 : create table T1( I1 INTEGER, I2 INTEGER, I3 INTEGER )
                                   ^ ^
]

$T0> create index idx1 on t1(i2);
[ERR-31031 : Table or view was not found : 
0001 : create index IDX1 on T1(I2)
                           ^ ^
]

$T0> # 압축이 아닌 컬럼은 되어야 한다
$T0> create index idx2 on t1(i3);
[ERR-31031 : Table or view was not found : 
0001 : create index IDX2 on T1(I3)
                           ^ ^
]

$T0> desc t1;
[ERR-91014 : The table (T1) does not exist.]

$T0> ##################################
$T0> # SECTOR; PROPERTY OFF
$T0> ##################################
$T0> # 프로퍼티가 꺼져 있으면 메모리 파티션드 테이블의 non-partitioned index
$T0> # 는 기존과 동일하게 거부되어야 한다. -> ERR-313D0

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index idx1 on t1(i2);
[ERR-313D0 : A non-partitioned index can be created on a disk partitioned table.]

$T0> # LOCAL 은 프로퍼티와 무관하게 되어야 한다
$T0> create index idx2 on t1(i3) local;
Create success.

$T0> desc t1;
[ TABLESPACE : SYS_TBS_MEM_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER         FIXED       
I2                                       INTEGER         FIXED       
I3                                       INTEGER         FIXED       
I4                                       INTEGER         FIXED       
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
IDX2                                     BTREE                  I3 ASC
T1 has no primary key

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; NON-PARTITIONED TABLE
$T0> ##################################
$T0> # 파티션드 테이블이 아니면 글로벌/로컬 구분 자체가 없다.
$T0> # 기존 동작 그대로여야 한다.


$T0> create table t2( i1 integer, i2 integer ) tablespace sys_tbs_mem_data;
Create success.

$T0> create index idx1 on t2(i2);
Create success.

$T0> desc t2;
[ TABLESPACE : SYS_TBS_MEM_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER         FIXED       
I2                                       INTEGER         FIXED       
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
IDX1                                     BTREE                  I2 ASC
T2 has no primary key

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop tablespace mem1 including contents and datafiles;
$T0> drop tablespace mem2 including contents and datafiles;
$T0> drop tablespace mem3 including contents and datafiles;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop tablespace disk1 including contents and datafiles;
$T0> drop tablespace vol1 including contents and datafiles;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

