$T0> ##################################
$T0> # SECTOR; FK REFERENCING GLOBAL PK
$T0> ##################################
$T0> # 자식 테이블의 FK 가 메모리 파티션드 테이블의 글로벌 PK 를 참조한다.
$T0> # 참조 검사는 글로벌 인덱스를 통해 전 파티션을 한 번에 본다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> alter table t1 add constraint t1_pk primary key (i2);
Alter success.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, 2000, 2, 2);
1 row inserted.
$T0> insert into t1 values (250, 3000, 3, 3);
1 row inserted.
$T0> commit;
Commit success.


$T0> create table t2( c1 integer, c2 integer ) tablespace sys_tbs_mem_data;
Create success.

$T0> alter table t2 add constraint t2_fk foreign key (c2) references t1 (i2);
Alter success.

$T0> # 부모의 각 파티션에 있는 값을 참조 -> 전부 성공해야 한다
$T0> insert into t2 values (1, 1000);
1 row inserted.
$T0> insert into t2 values (2, 2000);
1 row inserted.
$T0> insert into t2 values (3, 3000);
1 row inserted.
$T0> commit;
Commit success.

$T0> select c1, c2 from t2 order by c1;
C1          C2          
---------------------------
1           1000        
2           2000        
3           3000        
3 rows selected.

$T0> # 없는 값을 참조 -> 실패해야 한다
$T0> insert into t2 values (4, 9999);
[ERR-31077 : The parent record was not found for T2_FK.]

$T0> commit;
Commit success.

$T0> ##################################
$T0> # SECTOR; FK BLOCKS PARENT DELETE
$T0> ##################################
$T0> # 참조되고 있는 부모 로우는 지울 수 없어야 한다.
$T0> # 부모 로우가 어느 파티션에 있든 마찬가지다.

$T0> delete from t1 where i2 = 1000;
[ERR-31076 : Unable to modify records that have child records. Check the referential constraints. T2_FK]

$T0> delete from t1 where i2 = 2000;
[ERR-31076 : Unable to modify records that have child records. Check the referential constraints. T2_FK]

$T0> delete from t1 where i2 = 3000;
[ERR-31076 : Unable to modify records that have child records. Check the referential constraints. T2_FK]

$T0> # 참조되지 않는 값은 지울 수 있어야 한다
$T0> insert into t1 values (250, 4000, 3, 3);
1 row inserted.
$T0> commit;
Commit success.
$T0> delete from t1 where i2 = 4000;
1 row deleted.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10          1000        
150         2000        
250         3000        
3 rows selected.

$T0> ##################################
$T0> # SECTOR; FK AND ROW MOVEMENT
$T0> ##################################
$T0> # 참조되는 부모 로우가 파티션 사이를 이동해도 참조는 유지되어야 한다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
enable row movement
tablespace sys_tbs_mem_data;
Create success.

$T0> alter table t1 add constraint t1_pk primary key (i2);
Alter success.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> commit;
Commit success.

$T0> create table t2( c1 integer, c2 integer ) tablespace sys_tbs_mem_data;
Create success.
$T0> alter table t2 add constraint t2_fk foreign key (c2) references t1 (i2);
Alter success.

$T0> insert into t2 values (1, 1000);
1 row inserted.
$T0> commit;
Commit success.

$T0> # 부모 로우를 다른 파티션으로 이동. PK 값은 그대로이므로 참조 유지.
$T0> update t1 set i1 = 250 where i2 = 1000;
1 row updated.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
250         1000        
1 row selected.
$T0> select c1, c2 from t2 order by c1;
C1          C2          
---------------------------
1           1000        
1 row selected.

$T0> # 이동 후에도 부모 삭제는 막혀야 한다
$T0> delete from t1 where i2 = 1000;
[ERR-31076 : Unable to modify records that have child records. Check the referential constraints. T2_FK]

$T0> # 자식을 먼저 지우면 부모를 지울 수 있어야 한다
$T0> delete from t2;
1 row deleted.
$T0> commit;
Commit success.
$T0> delete from t1 where i2 = 1000;
1 row deleted.
$T0> commit;
Commit success.

$T0> select count(*) from t1;
COUNT                
-----------------------
0                    
1 row selected.
$T0> select count(*) from t2;
COUNT                
-----------------------
0                    
1 row selected.

