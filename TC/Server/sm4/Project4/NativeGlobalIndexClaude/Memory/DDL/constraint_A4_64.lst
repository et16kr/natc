$T0> ##################################
$T0> # 참조되고 있는 PK 는 지울 수 없어야 한다.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> commit;
Commit success.
$T0> insert into t2 values (1, 1000);
1 row inserted.
$T0> commit;
Commit success.

$T0> alter table t1 drop constraint t1_pk;
[ERR-3102A : A foreign key constraint depends on the table or column.]

$T0> # 자식 제약을 먼저 지우면 가능해야 한다
$T0> alter table t2 drop constraint t2_fk;
Alter success.
$T0> alter table t1 drop constraint t1_pk;
Alter success.

