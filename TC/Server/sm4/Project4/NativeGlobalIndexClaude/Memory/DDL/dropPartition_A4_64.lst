$T0> # 살아 있는 파티션의 값은 여전히 유니크여야 한다
$T0> insert into t1 values (310, 1000, 4, 4);
[ERR-11058 : The row already exists in a unique index.]

$T0> commit;
Commit success.

$T0> ##################################
$T0> # SECTOR; DROP PARTITION MULTI TABLESPACE
$T0> ##################################
$T0> # 파티션이 서로 다른 테이블스페이스에 있을 때. 지워진 파티션의
$T0> # 테이블스페이스가 회수되어도 인덱스가 그 위치를 참조하면 안 된다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
Create success.

$T0> create index gidx1 on t1(i2);
Create success.

