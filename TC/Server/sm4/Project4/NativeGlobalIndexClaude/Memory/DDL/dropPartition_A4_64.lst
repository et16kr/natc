$T0> ##################################
$T0> # SECTOR; DROP WITH UNIQUE INDEX
$T0> ##################################
$T0> # 유니크 인덱스에서 파티션을 지우면 그 값을 다시 넣을 수 있어야 한다.
$T0> # 키가 남아 있으면 잘못 실패한다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values less than (300),
  partition p4 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create unique index t1_uk on t1(i2);
Create success.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> insert into t1 values (110, 2000, 2, 2);
1 row inserted.
$T0> insert into t1 values (210, 3000, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> # p2 를 지우면 2000 이 사라진다
$T0> alter table t1 drop partition p2;
Alter success.

$T0> # 이제 2000 을 다시 넣을 수 있어야 한다
$T0> insert into t1 values (310, 2000, 4, 4);
1 row inserted.
$T0> commit;
