$T0> # 남은 글로벌 인덱스는 정상이어야 한다
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx2) */ i1, i3 from t1 where i3 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i3 from t1 where i3 is not null
  )
  order by 1;
