###########################################################################
# TestCase Description = 네이티브 글로벌 인덱스의 DROP INDEX. 카탈로그
#                        판별자 행이 함께 지워지는지, 재생성이 되는지,
#                        인덱스가 여러 개일 때 하나만 지워지는지.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;
INCLUDE ../../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );
CALL FILL_RANGE_DATA();

##################################
# SECTOR; DROP ONE OF MANY
##################################
# 글로벌 인덱스 2개 + 로컬 인덱스 1개에서 글로벌 하나만 지운다.
# 나머지 인덱스는 그대로 동작해야 한다.

create index gidx1 on t1(i2);
create index gidx2 on t1(i3);
create index lidx1 on t1(i4) local;

CALL SELECT_INDEX_META( "t1" );

drop index gidx1;

CALL SELECT_INDEX_META( "t1" );

# 남은 글로벌 인덱스는 정상이어야 한다
CALL CHECK_GLOBAL_INDEX( "t1", "gidx2", "i1, i3", "i3" );

##################################
# SECTOR; DROP ALL GLOBAL
##################################
# 글로벌 인덱스를 전부 지우면 파티션의 부모 역링크는 남아도 되지만
# 조회는 로컬/풀스캔으로 정상이어야 한다.

drop index gidx2;

CALL SELECT_INDEX_META( "t1" );

select count(*) from t1;
select /*+ index(t1, lidx1) */ count(i4) from t1 where i4 is not null;

##################################
# SECTOR; RECREATE
##################################
# 지운 뒤 같은 이름으로 다시 만든다. 재생성 경로가 이전 잔재에
# 영향을 받지 않아야 한다.

create index gidx1 on t1(i2);

CALL SELECT_INDEX_META( "t1" );
CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

drop index gidx1;
create index gidx1 on t1(i2);
drop index gidx1;
create index gidx1 on t1(i2);

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

##################################
# SECTOR; DROP AFTER DML
##################################
# DML 로 키가 계속 바뀐 뒤에 지운다.

delete from t1 where i1 > 220;
insert into t1 values (250, 250, 1, 1);
update t1 set i2 = i2 + 1000 where i1 < 10;
commit;

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

drop index gidx1;

select count(*) from t1;

##################################
# SECTOR; DROP TABLE WITH GLOBAL INDEX
##################################
# 테이블을 지우면 글로벌 인덱스와 카탈로그 행도 함께 사라져야 한다.

create index gidx1 on t1(i2);
create index gidx2 on t1(i3);

CALL SELECT_INDEX_META( "t1" );

drop table t1;

# 지운 뒤 카탈로그에 잔재가 없어야 한다
CALL SELECT_INDEX_META( "t1" );
CALL CHECK_NO_HIDDEN_OBJECT();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
