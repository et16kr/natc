$T0> ##################################
$T0> # SECTOR; SPLIT WITH UNIQUE INDEX
$T0> ##################################
$T0> # 유니크 인덱스가 split 을 거쳐도 파티션 간 유일성을 계속 보장해야 한다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create unique index t1_uk on t1(i2);
Create success.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> insert into t1 values (60, 2000, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, 3000, 2, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> alter table t1 split partition p1 at ( 50 ) into ( partition p1a, partition p1b );
Alter success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10          1000        
60          2000        
150         3000        
3 rows selected.

$T0> # 나뉜 파티션 사이의 중복 -> 실패해야 한다
$T0> insert into t1 values (25, 2000, 1, 1);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 다른 파티션과의 중복 -> 실패해야 한다
$T0> insert into t1 values (250, 1000, 3, 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 새 값 -> 성공
$T0> insert into t1 values (250, 4000, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10          1000        
60          2000        
150         3000        
250         4000        
4 rows selected.

