$T0> ##################################
$T0> # SECTOR; REPLACE PARTITION
$T0> ##################################
$T0> # 두 파티션드 테이블이 같은 이름의 파티션을 맞바꾼다. 양쪽 파티션의
$T0> # 로우가 통째로 교체되므로, 글로벌 인덱스를 가진 쪽은 그에 맞춰
$T0> # 다시 만들어져야 한다.
$T0> #
$T0> # 여기서 걸리는 것: 인덱스 리프 슬롯은 로우를 가리키는 생 포인터이고
$T0> # 파티션은 페이지 헤더의 mTableOID 로 역산된다. 맞바꾼 뒤 옛 파티션의
$T0> # 페이지가 회수되면 남아 있는 슬롯은 재사용된 메모리를 가리킨다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.


$T0> # 맞바꿀 상대도 파티션드여야 하고 파티션 이름이 같아야 한다
$T0> create table t2( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> insert into t2 select level, level + 9000, level, level from dual connect by level <= 10;
10 rows inserted.
$T0> commit;
Commit success.

$T0> select count(*) from t1;
COUNT                
-----------------------
90                   
1 row selected.
$T0> select count(*) from t2;
COUNT                
-----------------------
10                   
1 row selected.
$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
90                   
1 row selected.

$T0> select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
  union all
  select 'P2', count(*) from t1 partition (p2)
  union all
  select 'P3', count(*) from t1 partition (p3)
  order by 1;
PART_NAME  PART_CNT             
-----------------------------------
P1  30                   
P2  30                   
P3  30                   
3 rows selected.

$T0> alter table t1 replace t2 partition p1;
Alter success.

$T0> select count(*) from t1;
COUNT                
-----------------------
70                   
1 row selected.
$T0> select count(*) from t2;
COUNT                
-----------------------
30                   
1 row selected.
$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
70                   
1 row selected.

$T0> select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
  union all
  select 'P2', count(*) from t1 partition (p2)
  union all
  select 'P3', count(*) from t1 partition (p3)
  order by 1;
PART_NAME  PART_CNT             
-----------------------------------
P1  10                   
P2  30                   
P3  30                   
3 rows selected.

$T0> # 들어온 로우는 인덱스에서 보여야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 9000;
COUNT                
-----------------------
10                   
1 row selected.

$T0> # 나간 로우는 인덱스에서 사라져야 한다
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 1 and 30;
COUNT                
-----------------------
0                    
1 row selected.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 상대 테이블(t2)에 DML 을 해도 t1 의 글로벌 인덱스가 영향을 받으면 안 된다.
$T0> insert into t2 values (1, 1, 1, 1);
1 row inserted.
$T0> commit;
Commit success.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

