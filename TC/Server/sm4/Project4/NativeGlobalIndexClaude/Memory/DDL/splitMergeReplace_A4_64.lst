$T0> ##################################
$T0> # SECTOR; MERGE PARTITION
$T0> ##################################
$T0> # 나눈 것을 다시 합친다.

$T0> alter table t1 merge partitions p1a, p1b into partition p1;
Alter success.

$T0> select count(*) total_cnt from t1;
TOTAL_CNT            
-----------------------
