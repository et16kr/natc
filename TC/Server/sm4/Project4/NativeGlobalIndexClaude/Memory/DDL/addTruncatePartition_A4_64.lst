$T0> ##################################
$T0> # SECTOR; ADD PARTITION WITH TABLESPACE
$T0> ##################################
$T0> # 기존 파티션과 다른 테이블스페이스에 추가한다.
$T0> #
$T0> # ★ 기본(default) 파티션은 나중에 추가할 수 없다. qcply.y 의
$T0> #   add_partition_spec 에서 "TR_PARTITION TI_IDENTIFIER TR_VALUES TR_DEFAULT"
$T0> #   가지가 통째로 주석 처리돼 있고 옆에 /* todo : default partition */ 이
$T0> #   달려 있다. 그래서 경계값을 주는 형태로 시험한다.

$T0> alter table t1 add partition p4 values less than (400) tablespace mem1;
Alter success.

$T0> insert into t1 select level + 300, level + 300, level, level from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.

$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 301 and 330;
COUNT                
-----------------------
30                   
1 row selected.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; ADD LIST PARTITION
$T0> ##################################


$T0> # ★ 리스트 파티션드 테이블에는 ADD PARTITION 을 쓸 수 없다.
$T0> #   qcply.y 의 add_partition_spec 에서 VALUES 뒤에 올 수 있는 것은
$T0> #   LESS THAN 뿐이고, 값 집합 형태는 파서가 받지 않는다
$T0> #   ("values (300)" 의 여는 괄호에서 parse error). 그래서 이 섹터는
$T0> #   RANGE 로 시험한다.
$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200)
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 values (10, 1, 1, 1);
1 row inserted.
$T0> insert into t1 values (150, 2, 2, 2);
1 row inserted.
$T0> commit;
Commit success.

$T0> alter table t1 add partition p3 values less than (300);
Alter success.

$T0> insert into t1 values (300, 3, 3, 3);
[ERR-3128A : Inserted partition key is not mapped to any partition.]
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10          1           
150         2           
2 rows selected.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; ADD PARTITION WITH UNIQUE INDEX
$T0> ##################################
$T0> # 추가한 파티션에 기존 값과 중복되는 키를 넣으면 실패해야 한다.


$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200)
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create unique index t1_uk on t1(i2);
Create success.

$T0> insert into t1 values (10, 1000, 1, 1);
1 row inserted.
$T0> commit;
Commit success.

$T0> # 위와 같은 이유로 default 가 아니라 경계값을 준다.
$T0> alter table t1 add partition p3 values less than (300);
Alter success.

$T0> # 새 파티션에 기존 값 -> 실패해야 한다
$T0> insert into t1 values (250, 1000, 3, 3);
[ERR-11058 : The row already exists in a unique index.]

$T0> # 새 값 -> 성공
$T0> insert into t1 values (250, 2000, 3, 3);
1 row inserted.
$T0> commit;
Commit success.

$T0> select i1, i2 from t1 order by i1;
I1          I2          
---------------------------
10          1000        
250         2000        
2 rows selected.

$T0> ##################################
$T0> # SECTOR; TRUNCATE PARTITION
$T0> ##################################
$T0> # 파티션의 데이터만 비운다. 파티션 자체는 남으므로 이후 삽입이 가능하다.



$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
