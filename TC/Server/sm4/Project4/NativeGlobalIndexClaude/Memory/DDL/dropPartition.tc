###########################################################################
# Native Global Index - environment helpers
#
# 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
# 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
#   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
#   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
###########################################################################

#
# 네이티브 글로벌 인덱스 생성을 허용한다.
#
DEF ENABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
}
#
# 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
# off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
# 기존과 동일하게 거부되어야 한다.
#
DEF DISABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
}
#
# 다중 TBS 테스트용 메모리 테이블스페이스를 만든다.
#
DEF PREPARE_MEM_TBS()
{
CALL FINALIZE_MEM_TBS();

create memory tablespace mem1 size 32M autoextend on checkpoint path 'dbs';
create memory tablespace mem2 size 32M autoextend on checkpoint path 'dbs';
create memory tablespace mem3 size 32M autoextend on checkpoint path 'dbs';
}
DEF FINALIZE_MEM_TBS()
{
SKIP BEGIN;
drop tablespace mem1 including contents and datafiles;
drop tablespace mem2 including contents and datafiles;
drop tablespace mem3 including contents and datafiles;
SKIP END;
}
#
# range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
# i1: 파티션 키, i2/i3/i4: 값
#
DEF FILL_RANGE_DATA()
{
insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
commit;
}
#
# 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
# 두 select 모두 0행이어야 정상이다.
#
# @aTable  : 테이블 이름
# @aIndex  : 글로벌 인덱스 이름
# @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
# @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
#
# 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
# 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
# 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
# 출력을 위한 것뿐이다.
#
# 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
#       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
#       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
  # 인덱스 경유 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;

  # 풀스캔 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;
}
#
# 카운트와 집계를 교차 확인한다.
# 인덱스가 어떤 파티션의 키를 빠뜨리거나 유령 키를 갖고 있으면 어긋난다.
#
DEF CHECK_INDEX_COUNT( @aTable, @aIndex, @aKeyCol )
{
  select /*+ FULL SCAN(@{aTable}) */ count(*) full_cnt,
         count(@{aKeyCol}) full_key_cnt,
         nvl(sum(@{aKeyCol}), -1) full_sum,
         nvl(min(@{aKeyCol}), -1) full_min,
         nvl(max(@{aKeyCol}), -1) full_max
  from @{aTable};

  select /*+ index(@{aTable}, @{aIndex}) */ count(@{aKeyCol}) idx_key_cnt,
         nvl(sum(@{aKeyCol}), -1) idx_sum,
         nvl(min(@{aKeyCol}), -1) idx_min,
         nvl(max(@{aKeyCol}), -1) idx_max
  from @{aTable}
  where @{aKeyCol} is not null;
}
#
# 파티션별 행 수의 합이 전체와 같은지 확인한다.
# 파티션 3개 + default 구성(p1,p2,p3)을 전제한다.
#
DEF CHECK_PARTITION_COUNT( @aTable )
{
  select count(*) total_cnt from @{aTable};

  select 'P1' part_name, count(*) part_cnt from @{aTable} partition (p1)
  union all
  select 'P2', count(*) from @{aTable} partition (p2)
  union all
  select 'P3', count(*) from @{aTable} partition (p3)
  order by 1;
}
#
# 위 검사를 한 번에 수행한다. 시나리오 끝마다 호출한다.
#
DEF CHECK_GLOBAL_INDEX( @aTable, @aIndex, @aCols, @aKeyCol )
{
  CALL CHECK_INDEX_SCAN( "@{aTable}", "@{aIndex}", "@{aCols}", "@{aKeyCol} is not null" );
  CALL CHECK_INDEX_COUNT( "@{aTable}", "@{aIndex}", "@{aKeyCol}" );
  CALL CHECK_PARTITION_COUNT( "@{aTable}" );
}
###########################################################################
# TestCase Description = DROP PARTITION 후 글로벌 인덱스에 사라진 파티션의
#                        키가 남지 않는지 확인한다. 메모리 인덱스의 리프
#                        슬롯은 로우를 가리키는 생 포인터이므로, 키를 지우기
#                        전에 페이지가 free 되면 그 슬롯은 재사용된 메모리를
#                        가리키게 된다.
# Project ID           = Native Global Index (memory)
###########################################################################


DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL FINALIZE_MEM_TBS();
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
CALL PREPARE_MEM_TBS();
}

#
# 파티션 4개짜리 테이블. 하나를 지워도 3개가 남는다.
#
DEF CREATE_FOUR_PART_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values less than (300),
  partition p4 values default
)
tablespace sys_tbs_mem_data;
}

DEF FILL_FOUR_PART()
{
insert into t1 select level,       level,       level, level from dual connect by level <= 30;
insert into t1 select level + 100, level + 100, level, level from dual connect by level <= 30;
insert into t1 select level + 200, level + 200, level, level from dual connect by level <= 30;
insert into t1 select level + 300, level + 300, level, level from dual connect by level <= 30;
commit;
}

DEF CHECK_FOUR_PART_COUNT()
{
select count(*) total_cnt from t1;

select 'P1' part_name, count(*) part_cnt from t1 partition (p1)
union all
select 'P2', count(*) from t1 partition (p2)
union all
select 'P3', count(*) from t1 partition (p3)
union all
select 'P4', count(*) from t1 partition (p4)
order by 1;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; DROP MIDDLE PARTITION
##################################
# 가운데 파티션을 지운다. 지워진 파티션의 키만 사라지고 나머지는
# 그대로여야 한다.

CALL CREATE_FOUR_PART_TABLE();

create index gidx1 on t1(i2);

CALL FILL_FOUR_PART();

CALL CHECK_FOUR_PART_COUNT();
select /*+ index(t1, gidx1) */ count(i2) from t1 where i2 is not null;

alter table t1 drop partition p2;

# p2 의 키(100~130)는 인덱스에서 사라져야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 100 and 130;
select /*+ FULL SCAN(t1) */ count(*) from t1 where i2 between 100 and 130;

# 나머지 파티션은 그대로
select /*+ index(t1, gidx1) */ count(i2) from t1 where i2 is not null;
select /*+ FULL SCAN(t1) */ count(i2) from t1 where i2 is not null;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; SCAN IMMEDIATELY AFTER DROP
##################################
# 지운 직후의 스캔이 안전해야 한다. 인덱스 키 purge 가 페이지 free 보다
# 먼저 끝나지 않으면 여기서 이상한 값이 나오거나 죽는다.

select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 < 20 order by i1, i2;
select /*+ index(t1, gidx1) */ min(i2), max(i2), count(*) from t1 where i2 is not null;

##################################
# SECTOR; DML AFTER DROP
##################################
# 지운 뒤 남은 파티션에 DML 을 한다.

insert into t1 values (10, 5000, 1, 1);
insert into t1 values (250, 6000, 3, 3);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

update t1 set i2 = i2 + 1 where i1 < 20;
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

delete from t1 where i1 > 320;
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; DROP FIRST AND LAST
##################################

CALL CREATE_FOUR_PART_TABLE();

create index gidx1 on t1(i2);

CALL FILL_FOUR_PART();

alter table t1 drop partition p1;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

alter table t1 drop partition p4;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

select /*+ index(t1, gidx1) */ min(i2), max(i2), count(*) from t1 where i2 is not null;

##################################
# SECTOR; DROP DOWN TO ONE PARTITION
##################################
# 마지막 하나만 남을 때까지 지운다.

alter table t1 drop partition p2;

select count(*) from t1;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; DROP WITH UNIQUE INDEX
##################################
# 유니크 인덱스에서 파티션을 지우면 그 값을 다시 넣을 수 있어야 한다.
# 키가 남아 있으면 잘못 실패한다.

CALL CREATE_FOUR_PART_TABLE();

create unique index t1_uk on t1(i2);

insert into t1 values (10, 1000, 1, 1);
insert into t1 values (110, 2000, 2, 2);
insert into t1 values (210, 3000, 3, 3);
commit;

# p2 를 지우면 2000 이 사라진다
alter table t1 drop partition p2;

# 이제 2000 을 다시 넣을 수 있어야 한다
insert into t1 values (310, 2000, 4, 4);
commit;

select i1, i2 from t1 order by i1;

# 살아 있는 파티션의 값은 여전히 유니크여야 한다
insert into t1 values (310, 1000, 4, 4);

commit;

##################################
# SECTOR; DROP PARTITION MULTI TABLESPACE
##################################
# 파티션이 서로 다른 테이블스페이스에 있을 때. 지워진 파티션의
# 테이블스페이스가 회수되어도 인덱스가 그 위치를 참조하면 안 된다.

NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();

CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

alter table t1 drop partition p2;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 100 and 130;

# 남은 파티션에 대량 삽입 -> 회수된 메모리를 다시 쓰게 만든다
insert into t1 select level + 200, level + 5000, level, level from dual connect by level <= 100;
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
