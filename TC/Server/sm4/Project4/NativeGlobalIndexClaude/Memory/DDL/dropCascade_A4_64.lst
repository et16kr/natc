$T0> # 사용 중인 테이블스페이스는 그냥 지울 수 없어야 한다
$T0> drop tablespace mem2;
[ERR-311DD : The tablespace has objects.]

$T0> # 내용까지 지우면 테이블도 함께 사라진다
$T0> drop tablespace mem2 including contents and datafiles;
[ERR-3128B : A partitioned table contains partitions in different tablespaces.]

