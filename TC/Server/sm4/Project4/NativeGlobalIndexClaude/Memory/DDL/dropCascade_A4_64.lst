 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;
$T0> ###########################################################################
$T0> # Native Global Index - environment helpers
$T0> #
$T0> # 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
$T0> # 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
$T0> #
$T0> # ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
$T0> #   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
$T0> #   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
$T0> ###########################################################################

$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 허용한다.
$T0> #
$T0> #
$T0> # 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
$T0> # off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
$T0> # 기존과 동일하게 거부되어야 한다.
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - memory partitioned table helpers
$T0> #
$T0> # 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
$T0> # (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
$T0> # 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
$T0> #
$T0> # 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
$T0> # 메모리 테이블스페이스에 있다.
$T0> ###########################################################################

$T0> #
$T0> # 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
$T0> #
$T0> # @aPartType : range | hash | list
$T0> # @aKeyType  : 파티션 키 컬럼 타입
$T0> # @aColType  : 나머지 컬럼 타입
$T0> #
$T0> # 컬럼 구성: i1(파티션 키), i2, i3, i4
$T0> #
$T0> #
$T0> # 다중 TBS 테스트용 메모리 테이블스페이스를 만든다.
$T0> #
$T0> #
$T0> # range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
$T0> # i1: 파티션 키, i2/i3/i4: 값
$T0> #
$T0> ###########################################################################
$T0> # Native Global Index - catalog inspection helpers
$T0> #
$T0> # 구버전(PROJ-1624)의 meta 테스트는 "숨김 객체가 이렇게 보인다"를
$T0> # 검증했다. 네이티브에서는 검증 방향이 정반대다: 숨김 객체가
$T0> # 생기지 않아야 하고, 대신 SYS_PART_INDICES_ 에 판별자 행이 하나 있어야
$T0> # 한다.
$T0> ###########################################################################

$T0> #
$T0> # 숨김 글로벌 인덱스 객체가 하나도 없어야 한다.
$T0> # 구버전은 여기서 $GIT_/$GIK_/$GIR_ 가 줄줄이 나왔다.
$T0> #
$T0> #
$T0> # SYS_INDICES_ 에서 본 글로벌 인덱스의 모습.
$T0> #
$T0> # 네이티브 글로벌 인덱스는 숨김 방식과 마찬가지로 IS_PARTITIONED = 'F'
$T0> # 이지만, INDEX_TABLE_ID 가 0 이어야 한다(숨김 테이블이 없으므로).
$T0> # 숨김 방식은 INDEX_TABLE_ID 가 0 이 아니다. 이것이 두 방식의
$T0> # 카탈로그 상 구분점이다.
$T0> #
$T0> #
$T0> # SYS_PART_INDICES_ 의 판별자 행.
$T0> #
$T0> # 네이티브 글로벌 인덱스는 여기에 행을 하나 남긴다. 캐시 로더가
$T0> # IS_PARTITIONED='F' 를 보고 무조건 non-partitioned 로 하드코딩하기
$T0> # 때문에, 재기동 후에도 네이티브임을 알아보려면 이 행이 필요하다.
$T0> # 숨김 방식은 이 행을 만들지 않는다.
$T0> #
$T0> #
$T0> # SYS_INDEX_PARTITIONS_ 에는 행이 없어야 한다.
$T0> # 물리 인덱스가 파티션별로 존재하지 않는 것이 로컬 인덱스와의 구분점이다.
$T0> #
$T0> #
$T0> # 한 테이블의 인덱스 카탈로그 전경.
$T0> #
$T0> ###########################################################################
$T0> # TestCase Description = DROP USER CASCADE 와 DROP TABLESPACE INCLUDING
$T0> #                        CONTENTS. 글로벌 인덱스가 걸린 테이블이 통째로
$T0> #                        정리되는 경로다.
$T0> #                        구버전 meta/drop_user.tc, meta/drop_tablespace.tc 에
$T0> #                        해당하며, 그때는 숨김 테이블 $GIT_ 까지 함께
$T0> #                        지워지는지가 관심사였다. 네이티브는 지울 숨김 객체가
$T0> #                        없으므로 관심사가 "잔재가 남지 않는가"로 바뀐다.
$T0> # Project ID           = Native Global Index (memory)
$T0> ###########################################################################

$T0> #
$T0> # 사용자 소유 객체를 전부 훑는다. drop 후 아무것도 남지 않아야 한다.
$T0> #

$T0> ##################################
$T0> # SECTOR; PREPARATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop user gidxuser cascade;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop tablespace mem1 including contents and datafiles;
$T0> drop tablespace mem2 including contents and datafiles;
$T0> drop tablespace mem3 including contents and datafiles;
$T0> SKIP END;
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.
$T0> SKIP BEGIN;
$T0> drop tablespace mem1 including contents and datafiles;
$T0> drop tablespace mem2 including contents and datafiles;
$T0> drop tablespace mem3 including contents and datafiles;
$T0> SKIP END;

$T0> create memory tablespace mem1 size 32M autoextend on checkpoint path 'dbs';
Create success.
$T0> create memory tablespace mem2 size 32M autoextend on checkpoint path 'dbs';
Create success.
$T0> create memory tablespace mem3 size 32M autoextend on checkpoint path 'dbs';
Create success.

$T0> ##################################
$T0> # SECTOR; DROP USER CASCADE
$T0> ##################################
$T0> # 글로벌 인덱스와 PK 를 가진 파티션드 테이블을 소유한 사용자를 지운다.

$T0> create user gidxuser identified by gidxuser;
Create success.
$T0> grant all privileges to gidxuser;
Grant success.


$T0> connect gidxuser/gidxuser;
Connect success.

$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index gidx1 on t1(i2);
Create success.
$T0> create index gidx2 on t1(i3);
Create success.
$T0> create index lidx1 on t1(i4) local;
Create success.
$T0> alter table t1 add constraint t1_pk primary key (i2, i3);
Alter success.

$T0> insert into t1 select level,       level,       level, level from dual connect by level <= 20;
20 rows inserted.
$T0> insert into t1 select level + 100, level + 100, level, level from dual connect by level <= 20;
20 rows inserted.
$T0> insert into t1 select level + 200, level + 200, level, level from dual connect by level <= 20;
20 rows inserted.
$T0> commit;
Commit success.

$T0> select count(*) from t1;
COUNT                
-----------------------
60                   
1 row selected.

$T0> connect sys/manager;
Connect success.

$T0> select t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.user_id = u.user_id and u.user_name = upper('gidxuser')
  order by t.table_name;
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
T1                                                                                                                                
T  
1 row selected.

$T0> select i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where i.user_id = u.user_id and u.user_name = upper('gidxuser')
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
GIDX1                                                                                                                             
GIDX2                                                                                                                             
LIDX1                                                                                                                             
T1_PK                                                                                                                             
4 rows selected.

$T0> select count(*) part_index_cnt
  from system_.sys_part_indices_ p, system_.sys_users_ u
  where p.user_id = u.user_id and u.user_name = upper('gidxuser');
PART_INDEX_CNT       
-----------------------
4                    
1 row selected.

$T0> drop user gidxuser cascade;
Drop success.

$T0> # 잔재가 하나도 없어야 한다
$T0> select t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.user_id = u.user_id and u.user_name = upper('gidxuser')
  order by t.table_name;
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
No rows selected.

$T0> select i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where i.user_id = u.user_id and u.user_name = upper('gidxuser')
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> select count(*) part_index_cnt
  from system_.sys_part_indices_ p, system_.sys_users_ u
  where p.user_id = u.user_id and u.user_name = upper('gidxuser');
PART_INDEX_CNT       
-----------------------
0                    
1 row selected.
$T0> # 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
$T0> select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
No rows selected.

$T0> # 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
$T0> select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; DROP TABLESPACE INCLUDING CONTENTS
$T0> ##################################
$T0> # 파티션이 들어 있는 테이블스페이스를 통째로 지운다.

$T0> create table t1( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100) tablespace mem1,
  partition p2 values less than (200) tablespace mem2,
  partition p3 values default tablespace mem3
);
Create success.

$T0> create index gidx1 on t1(i2) tablespace mem1;
Create success.
$T0> create index gidx2 on t1(i3) tablespace sys_tbs_mem_data;
Create success.

$T0> insert into t1 select level,       level,       level, level from dual connect by level <= 20;
20 rows inserted.
$T0> insert into t1 select level + 100, level + 100, level, level from dual connect by level <= 20;
20 rows inserted.
$T0> insert into t1 select level + 200, level + 200, level, level from dual connect by level <= 20;
20 rows inserted.
$T0> commit;
Commit success.

$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t1')
    and t.user_id = user_id()
  order by i.index_name;
