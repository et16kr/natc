$T0> # 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
$T0> select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
No rows selected.

$T0> # 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
$T0> select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> select /*+ index(t1, gidx1) */ i1, k2 from t1 where k2 <= 3 order by i1;
I1          K2          
---------------------------
1           1           
2           2           
3           3           
3 rows selected.
$T0> select /*+ FULL SCAN(t1) */ i1, k2 from t1 where k2 <= 3 order by i1;
I1          K2          
---------------------------
1           1           
2           2           
3           3           
3 rows selected.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, k2 from t1 where k2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, k2 from t1 where k2 is not null
  )
  order by 1;
I1          K2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, k2 from t1 where k2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, k2 from t1 where k2 is not null
  )
  order by 1;
I1          K2          
---------------------------
No rows selected.

$T0> ##################################
$T0> # SECTOR; MODIFY COLUMN TYPE
$T0> ##################################
$T0> # 키 컬럼의 타입/길이를 바꾼다.



$T0> create table t1( i1 integer, i2 varchar(20), i3 varchar(20), i4 varchar(20) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.



$T0> create index gidx1 on t1(i2);
Create success.

$T0> insert into t1 values (10, 'aaa', 'x', 'y');
1 row inserted.
$T0> insert into t1 values (150, 'bbb', 'x', 'y');
1 row inserted.
$T0> insert into t1 values (250, 'ccc', 'x', 'y');
1 row inserted.
$T0> commit;
Commit success.

$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2                    
-------------------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2                    
-------------------------------------
No rows selected.

$T0> alter table t1 modify column (i2 varchar(100));
Alter success.

