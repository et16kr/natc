$T0> # 인덱스 키 컬럼을 지우면 그 인덱스도 함께 사라져야 한다.


$T0> create table t1
(
  i1 integer,
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 varchar(50),
  i7 integer,
  i8 varchar(50)
)
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> create index gidx1 on t1(i2);
Create success.
$T0> create index gidx2 on t1(i3, i4);
Create success.

$T0> insert into t1 select level,       level,       level, level, level, 'a' || level, level, 'x' || level
  from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 100, level + 100, level, level, level, 'b' || level, level, 'y' || level
  from dual connect by level <= 30;
30 rows inserted.
$T0> insert into t1 select level + 200, level + 200, level, level, level, 'c' || level, level, 'z' || level
  from dual connect by level <= 30;
30 rows inserted.
$T0> commit;
Commit success.
