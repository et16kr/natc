$T0> ##################################
$T0> # SECTOR; PROPERTY OFF - REPLICATION PATH UNCHANGED (회귀)
$T0> ##################################
$T0> # 프로퍼티가 꺼져 있으면 글로벌 PK 픽스처 자체가 만들어지지 않는다.
$T0> # 파티션 키를 포함하지 않는 PK 는 프로퍼티 이전의 답인 ERR-31415 로
$T0> # 거부된다. 이것이 회귀 방향이고, 위 섹터들이 전부 성공 단언이 된 지금
$T0> # 스위치 off 를 재는 자리는 여기 하나다.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

$T0> drop table t3;
Drop success.

$T0> create table t3( i1 integer not null, i2 integer not null, i3 integer,
                       constraint t3_pk primary key (i2) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
[ERR-31415 : A primary key or unique key constraint can be defined for a non-partitioned index on a disk partitioned table.]

$T0> # 그리고 평범한(로컬 PK) 테이블의 복제 경로는 종전 그대로여야 한다.

$T0> create table t3( i1 integer not null, i2 integer, i3 integer,
                       constraint t3_pk primary key (i1) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

$T0> select i.index_name,
         i.is_unique,
         i.is_partitioned,
         decode(i.index_table_id, 0, 'ZERO', 'NONZERO') index_table_id_kind
  from system_.sys_indices_ i, system_.sys_tables_ t
  where i.table_id = t.table_id
    and t.table_name = upper('t3')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
IS_UNIQUE  IS_PARTITIONED  INDEX_TABLE_ID_KIND  
----------------------------------------------------
T3_PK                                                                                                                             
T  T  ZERO     
1 row selected.
$T0> select i.index_name, p.partition_type
  from system_.sys_part_indices_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t3')
    and t.user_id = user_id()
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PARTITION_TYPE 
-----------------
T3_PK                                                                                                                             
0           
1 row selected.
$T0> select i.index_name, count(*) part_index_cnt
  from system_.sys_index_partitions_ p, system_.sys_indices_ i, system_.sys_tables_ t
  where p.index_id = i.index_id
    and i.table_id = t.table_id
    and t.table_name = upper('t3')
    and t.user_id = user_id()
  group by i.index_name
  order by i.index_name;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
PART_INDEX_CNT       
-----------------------
T3_PK                                                                                                                             
