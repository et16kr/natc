$T0> # 테이블 단위
$T0> create replication rep4 with '127.0.0.1', 40004 from sys.t4 to sys.t4;
Create success.

$T0> # 파티션 단위도 된다. 이름과 상대 host:port 가 둘 다 rep4 와 달라야 한다
$T0> # (같은 이름은 ERR-61100, 같은 host:port 는 ERR-6110C).
$T0> create replication rep5 with '127.0.0.1', 40005
  from sys.t4 partition p1 to sys.t4 partition p1;
Create success.

$T0> # 둘 다 남아 있어야 한다
