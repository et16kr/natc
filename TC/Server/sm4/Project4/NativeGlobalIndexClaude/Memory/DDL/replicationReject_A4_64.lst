$T0> ##################################
$T0> # SECTOR; GLOBAL PRIMARY KEY + ROW MOVEMENT IS REPLICABLE TOO (V4 C-2)
$T0> ##################################
$T0> # V3 가 남긴 마지막 거부가 여기 있었다. 옛 순서(대상 파티션 INSERT 먼저)
$T0> # 에서는 receiver 가 이동의 두 반쪽을 따로 판정하는 사이에 글로벌 PK 가
$T0> # 아직 살아 있는 원본 로우를 보므로 INSERT 가 중복으로 버려지고 DELETE 만
$T0> # 성공했다 — 로우 소실(v3-rp-receiver.md §5.2 결함 D2).
$T0> #
$T0> # V4 는 게이트를 넓힌 것이 아니라 뿌리를 고쳤다. C-1 이 qmnUPTE::
$T0> # updateOneRowForRowmovement 의 순서를 뒤집어(원본 DELETE 먼저) 충돌할 옛
$T0> # 로우를 남기지 않게 했고, C-2 가 rpcValidate 의 조건을 걷었다.
$T0> #
$T0> # 이 파일은 한 인스턴스의 DDL 게이트만 본다 — receiver 가 이동을 정확히 한
$T0> # 행으로 apply 하는 것(D2 의 소멸)은 두 인스턴스가 필요하므로
$T0> # scripts/global-index/replication-check.sh 의 N4b 가 양 매체로 잰다.


$T0> create table t4( i1 integer not null, i2 integer not null, i3 integer,
                       constraint t4_pk primary key (i2) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
enable row movement
tablespace sys_tbs_mem_data;
Create success.

