1 row selected.
$T0> # 숨김 인덱스 테이블 ($GIT_) - 없어야 정상
$T0> select u.user_name, t.table_name, t.table_type
  from system_.sys_tables_ t, system_.sys_users_ u
  where t.table_name like '$GIT[_]%' escape '['
    and t.user_id = u.user_id
  order by t.table_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
TABLE_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
TABLE_TYPE  
--------------
No rows selected.

$T0> # 숨김 인덱스 테이블의 인덱스 ($GIK_, $GIR_) - 없어야 정상
$T0> select u.user_name, i.index_name
  from system_.sys_indices_ i, system_.sys_users_ u
  where ( i.index_name like '$GIK[_]%' escape '['
       or i.index_name like '$GIR[_]%' escape '[' )
    and i.user_id = u.user_id
  order by i.index_name;
USER_NAME                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
No rows selected.

$T0> create replication rep3 with '127.0.0.1', 40003 from sys.t3 to sys.t3;
Create success.

$T0> select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP3';
REPLICATION_NAME                          IS_STARTED  
---------------------------------------------------------
REP3                                      0           
1 row selected.

$T0> drop replication rep3;
Drop success.

$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
Alter success.

$T0> ##################################
$T0> # SECTOR; FINALIZATION
$T0> ##################################

$T0> SKIP BEGIN;
$T0> drop replication rep1;
$T0> drop replication rep2;
$T0> drop replication rep3;
$T0> drop replication rep4;
$T0> SKIP END;
$T0> SKIP BEGIN;
$T0> drop table t1;
$T0> drop table t2;
$T0> drop table t3;
$T0> drop table t4;
$T0> SKIP END;
$T0> alter system set REPLICATION_DDL_ENABLE = 0;
Alter success.
$T0> alter system set REPLICATION_DDL_ENABLE_LEVEL = 0;
Alter success.
$T0> alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
Alter success.

