$T0> ##################################
$T0> # SECTOR; A GLOBAL PRIMARY KEY IS REPLICABLE NOW (V3 B-4)
$T0> ##################################
$T0> # 여기가 뒤집힌 자리다. J18 은 이 두 문장을 ERR-314B4 로 막았고, V3 의
$T0> # B-1(논리 테이블 PK 폴백) · B-2(와이어의 PK 스코프) · B-3(receiver 의
$T0> # 글로벌 트리 탐색 + owner handoff)이 그 거부의 이유를 없앴다.
$T0> #
$T0> # 이 파일은 한 인스턴스에서 판정되는 DDL 게이트만 본다 — 실제 왕복(START,
$T0> # apply, SYNC, conflict log)은 scripts/global-index/replication-check.sh 의
$T0> # N 절이 두 인스턴스로 잰다.


$T0> create table t3( i1 integer not null, i2 integer not null, i3 integer,
                       constraint t3_pk primary key (i2) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

