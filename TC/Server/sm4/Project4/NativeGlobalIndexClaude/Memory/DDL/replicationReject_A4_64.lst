1                                                                                                                                                                                                                                                                 
REPLICATION_DDL_ENABLE_LEVEL                                                                                                                                                                                                                                      
1                                                                                                                                                                                                                                                                 
2 rows selected.

$T0> ##################################
$T0> # SECTOR; BASELINE - REPLICATION WITHOUT A GLOBAL INDEX
$T0> ##################################
$T0> # 글로벌 인덱스가 없으면 복제 객체가 만들어져야 한다. 이것이 기준선이고,
$T0> # 동시에 복제 매니저가 실제로 살아 있다는 증거다 — 꺼져 있으면 여기서
$T0> # ERR-61023 이 난다.


$T0> create table t1( i1 integer not null, i2 integer, i3 integer,
                       constraint t1_pk primary key (i1) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
Create success.

