$T0> drop replication rep4;
Drop success.

$T0> # row movement 를 꺼도 답은 같다. 그 같음이 이 섹터의 단언이다 — 켠 쪽만
$T0> # 거부되는 날 갈라진다.
$T0> #
$T0> # 끄는 것 자체는 복제가 걸려 있는 동안 ERR-31020 이다(복제 테이블의 DDL 을
$T0> # 통째로 막는 제품의 기존 거부이고 글로벌 인덱스와 무관하다). 그래서 위에서
$T0> # 먼저 떼어 냈고, 그 순서가 곧 이 조합에 들어가는 유일한 길이기도 하다 —
$T0> # row movement 를 먼저 켜고 복제를 만든다.
$T0> alter table t4 disable row movement;
Alter success.

$T0> create replication rep4 with '127.0.0.1', 40004 from sys.t4 to sys.t4;
Create success.

