###########################################################################
# TestCase Description = 복제와 네이티브 글로벌 인덱스의 DDL 게이트.
#
#   ★ 이 케이스는 한 번 통째로 다시 쓰였다. 그 전 기대파일은 복제 매니저가
#     꺼진 인스턴스(REPLICATION_PORT_NO = 0)의 전사였다. 그래서 모든 복제
#     문장이 ERR-61023 으로 먼저 죽었고, 이 케이스는 **여태 아무것도 재지
#     않으면서 통과**하고 있었다. 그 다음으로는 REPLICATION_DDL_ENABLE 이
#     0 이라 복제 대상 테이블의 CREATE INDEX 가 전부 ERR-312C4 로 먼저
#     죽었다 — 그것도 글로벌 인덱스 판정에 닿지 못한 공허한 통과다.
#
#     그래서 아래 PREPARATION 이 두 가지를 먼저 전사에 남긴다:
#       1. 복제 매니저가 살아 있는가 (ON/OFF 로 찍는다 — 포트 번호를
#          박으면 다른 포트로 띄운 인스턴스에서 거짓 실패가 난다)
#       2. REPLICATION_DDL_ENABLE 을 1 로 올렸는가
#     둘 중 하나라도 어긋나면 전사가 달라지므로 케이스가 붉게 운다.
#     '재는 것이 없는데 초록' 은 이제 만들어지지 않는다.
#
#   ★ 기대가 **세 번** 뒤집혔다. 지금은 거부가 하나도 남지 않았다.
#
#     ① V1 은 두 방향을 모두 ERR-314B3 으로 막았고, V2 의 J18 이 그 전면
#        거부를 걷었다. **PK 가 아닌 글로벌 인덱스는 복제 테이블에서
#        얼마든지 쓸 수 있다** — J17 이 파티션 DDL 에 전 파티션 X 잠금을
#        붙여, 논리 테이블을 잠그지 않는 수신자를 그 잠금으로 배제하게
#        됐기 때문이다. 아래 두 방향이 지금 성공하는 이유가 그것이다.
#
#     ② J18 이 남긴 거부 하나 — "PK 가 네이티브 글로벌 인덱스인 테이블은
#        복제할 수 없다(ERR-314B4)" — 를 **V3 의 B-1~B-4 가 걷었다.**
#        복제 메타가 파티션의 PK 를 읽던 것이 뿌리였고, 그 자리에
#        논리 테이블 PK 폴백(B-1) · 와이어의 PK 스코프(B-2) · receiver 의
#        글로벌 트리 탐색과 owner handoff(B-3) 가 들어갔다.
#
#     ③ 그때 좁게 남았던 마지막 조합 — "글로벌 PK **그리고** ROW MOVEMENT" —
#        를 **V4 의 C-1·C-2 가 걷었다.** 남겼던 이유는 이동이 대상 파티션
#        INSERT → 원본 파티션 DELETE 두 연산이고 receiver 가 그 둘을 각자
#        판정해서, 그 사이에 글로벌 PK 가 아직 살아 있는 원본을 보고 INSERT
#        를 중복으로 버려 로우가 사라지는 것이었다(D2). C-1 이 그 두 반쪽의
#        **순서를 뒤집어**(원본 DELETE 먼저) 충돌할 옛 로우를 없앴고, C-2 가
#        rpcValidate 의 조건을 지웠다.
#
#     그래서 **ERR-314B4 는 이제 아무 데서도 나지 않는다.** 메시지 파일의
#     1204 번은 은퇴 표기(*Cause: Retired)로 남아 있을 뿐이다.
#
#     아래는 row movement 를 켠 것과 끈 것 **둘 다** 찍는다. 지금 둘은 같은
#     답을 내고, 그 같음이 단언이다 — 갈라지는 날 거부가 돌아온 것이다.
#
#   주의: 복제 객체를 만드는 것만으로는 상대 서버가 필요 없다. START 는
#         하지 않는다 — 이 파일은 한 인스턴스에서 판정되는 DDL 게이트만
#         본다. 살아 있는 두 인스턴스 사이의 실제 이중화 동작은
#         scripts/global-index/replication-check.sh 가 (디스크 쪽 같은
#         거부는 M60~M65 가) 이미 재고 있다.
#
#   주의: 복제 하나는 상대 host:port 를 독점한다. 서로 다른 복제에 같은
#         '127.0.0.1', <port> 를 주면 ERR-6110C 로 먼저 죽는다 — 그래서
#         아래는 복제마다 다른 포트를 쓴다. 40001~40005 는 아무도 듣지
#         않는 포트이며, START 를 하지 않으므로 접속되지 않아도 된다.
#
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;
INCLUDE ../../include/selectMeta.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop replication rep1;
drop replication rep2;
drop replication rep3;
drop replication rep4;
SKIP END;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t3;
drop table t4;
SKIP END;
alter system set REPLICATION_DDL_ENABLE = 0;
alter system set REPLICATION_DDL_ENABLE_LEVEL = 0;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
# 복제 대상 테이블에 대한 DDL 은 두 프로퍼티가 함께 열어 준다.
#   REPLICATION_DDL_ENABLE       = 0 이면 CREATE INDEX 가 ERR-312C4
#   REPLICATION_DDL_ENABLE_LEVEL = 0 이면 ALTER TABLE ... ADD CONSTRAINT 가
#                                  ERR-6117F
# 둘 다 글로벌 인덱스 판정보다 앞에 있어서, 열지 않으면 이 케이스는
# 판정에 닿지도 못한 채 통과한다. 둘 다 FINALIZE 에서 파일 기본값 0 으로
# 되돌린다.
alter system set REPLICATION_DDL_ENABLE = 1;
alter system set REPLICATION_DDL_ENABLE_LEVEL = 1;
}

#
# 이 케이스가 무엇 위에서 도는지 전사에 남긴다.
#
# REPLICATION_PORT_NO 는 값이 아니라 0 인지 아닌지만 찍는다. 0 이면 복제
# 매니저가 뜨지 않고 모든 복제 문장이 ERR-61023 으로 죽는다 — 이 케이스가
# 오래 그 상태였다. 포트 번호 자체를 찍으면 다른 포트로 띄운 인스턴스에서
# 거짓 실패가 나므로 ON/OFF 로만 판정한다.
#
DEF SHOW_REPL_ENV()
{
select decode( value1, '0', 'REPLICATION MANAGER OFF',
                            'REPLICATION MANAGER ON' ) repl_manager
  from v$property where name = 'REPLICATION_PORT_NO';

select name, value1 from v$property
 where name in ( 'REPLICATION_DDL_ENABLE', 'REPLICATION_DDL_ENABLE_LEVEL' )
 order by name;
}

#
# 복제 대상이 되려면 PK 가 있어야 한다.
# 여기서는 파티션 키(i1)를 포함하는 PK 를 써서, PK 자체는 로컬로
# 만들어지게 한다. 그래야 "복제는 되는데 글로벌 인덱스만 문제" 인
# 상태를 만들 수 있다.
#
DEF CREATE_REPL_TABLE( @aName )
{
NODISPLAY ON;
SKIP BEGIN;
drop table @{aName};
SKIP END;
NODISPLAY OFF;

create table @{aName}( i1 integer not null, i2 integer, i3 integer,
                       constraint @{aName}_pk primary key (i1) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
}

#
# PK 가 파티션 키를 포함하지 않는 테이블. 프로퍼티가 켜져 있으면 이
# PK 자체가 네이티브 글로벌 인덱스가 된다(PARTITION_TYPE = 101).
# V3 의 B-1~B-4 이후 이 모양은 **복제할 수 있다.**
#
DEF CREATE_GLOBAL_PK_TABLE( @aName )
{
NODISPLAY ON;
SKIP BEGIN;
drop table @{aName};
SKIP END;
NODISPLAY OFF;

create table @{aName}( i1 integer not null, i2 integer not null, i3 integer,
                       constraint @{aName}_pk primary key (i2) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;
}

#
# 같은 것에 ROW MOVEMENT 를 켠 것. V3 까지 ERR-314B4 를 재던 유일한
# 픽스처였고, V4 C-2 뒤로는 "켜도 같은 답이 나온다"를 재는 자리다.
#
# 문법 순서에 주의: ENABLE ROW MOVEMENT 는 파티션 절 다음, tablespace 절
# 앞이다(qcply.y 의 table_options). 순서를 바꾸면 ERR-31001 로 먼저 죽어서
# 이 케이스가 아무것도 재지 못한다.
#
DEF CREATE_GLOBAL_PK_ROWMOVE_TABLE( @aName )
{
NODISPLAY ON;
SKIP BEGIN;
drop table @{aName};
SKIP END;
NODISPLAY OFF;

create table @{aName}( i1 integer not null, i2 integer not null, i3 integer,
                       constraint @{aName}_pk primary key (i2) )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
enable row movement
tablespace sys_tbs_mem_data;
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

# 이 두 줄이 이 케이스의 전제다. 어긋나면 아래 전부가 공허해진다.
CALL SHOW_REPL_ENV();

##################################
# SECTOR; BASELINE - REPLICATION WITHOUT A GLOBAL INDEX
##################################
# 글로벌 인덱스가 없으면 복제 객체가 만들어져야 한다. 이것이 기준선이고,
# 동시에 복제 매니저가 실제로 살아 있다는 증거다 — 꺼져 있으면 여기서
# ERR-61023 이 난다.

CALL CREATE_REPL_TABLE( "t1" );

CALL SELECT_INDEX_META( "t1" );

create replication rep1 with '127.0.0.1', 40001 from sys.t1 to sys.t1;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP1';

##################################
# SECTOR; GLOBAL INDEX ON A REPLICATED TABLE IS ALLOWED
##################################
# V1 은 여기를 ERR-314B3 으로 막았다. J18 이 그것을 걷었으므로 지금은
# 만들어져야 하고, 판별자가 101(네이티브 글로벌)이어야 한다.
#
# REPLICATION_DDL_ENABLE 이 0 이면 이 문장은 글로벌 인덱스 판정에 닿기
# 전에 ERR-312C4 로 죽는다. PREPARE 가 1 로 올려 두는 이유가 이것이다.

create index gidx1 on t1(i2);

CALL SELECT_INDEX_META( "t1" );

# 로컬 인덱스도 물론 된다. 컬럼 목록은 gidx1(i2) 과 달라야 한다 —
# 같은 컬럼 목록의 인덱스를 하나 더 만들면 ERR-31051 로 먼저 죽는다.
create index lidx1 on t1(i2, i3) local;

CALL SELECT_INDEX_META( "t1" );

# 파티션 키를 포함하지 않는 UK 도 글로벌이 된다. PK 가 아니므로 허용된다.
alter table t1 add constraint t1_uk unique (i3);

CALL SELECT_INDEX_META( "t1" );

##################################
# SECTOR; THE INDEX SURVIVES DROPPING THE REPLICATION
##################################

drop replication rep1;

insert into t1 values (10,  1, 1);
insert into t1 values (150, 2, 2);
insert into t1 values (250, 3, 3);
commit;

CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLICATION ON A TABLE THAT ALREADY HAS A GLOBAL INDEX IS ALLOWED
##################################
# 반대 방향. rpcValidate 도 V1 의 거부를 갖고 있었고 J18 이 걷었다.

create replication rep1 with '127.0.0.1', 40001 from sys.t1 to sys.t1;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP1';

# 인덱스는 그대로 살아 있어야 한다
CALL SELECT_INDEX_META( "t1" );
CALL CHECK_INDEX_SCAN_OPEN_GATE( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; TWO ITEMS IN ONE REPLICATION, ONE OF THEM GLOBAL
##################################
# 복제 항목이 여럿이고 그중 하나가 글로벌 인덱스를 가져도 만들어진다.
#
# 상대 포트는 rep1 과 달라야 한다 — 같으면 ERR-6110C(Replication hosts
# already exist)로 먼저 죽어서 이 섹터가 공허해진다.

CALL CREATE_REPL_TABLE( "t2" );

# t2 에는 글로벌 인덱스가 없다
CALL SELECT_INDEX_META( "t2" );

# 아이템이 여럿이면 각각 FROM ~ TO 를 온전히 적는다.
create replication rep2 with '127.0.0.1', 40002
  from sys.t2 to sys.t2, from sys.t1 to sys.t1;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP2';

##################################
# SECTOR; ADDING A GLOBAL INDEX TO A TABLE ALREADY IN A REPLICATION
##################################

create index gidx2 on t2(i2);

CALL SELECT_INDEX_META( "t2" );

drop replication rep2;
drop replication rep1;

##################################
# SECTOR; A GLOBAL PRIMARY KEY IS REPLICABLE NOW (V3 B-4)
##################################
# 여기가 뒤집힌 자리다. J18 은 이 두 문장을 ERR-314B4 로 막았고, V3 의
# B-1(논리 테이블 PK 폴백) · B-2(와이어의 PK 스코프) · B-3(receiver 의
# 글로벌 트리 탐색 + owner handoff)이 그 거부의 이유를 없앴다.
#
# 이 파일은 한 인스턴스에서 판정되는 DDL 게이트만 본다 — 실제 왕복(START,
# apply, SYNC, conflict log)은 scripts/global-index/replication-check.sh 의
# N 절이 두 인스턴스로 잰다.

CALL CREATE_GLOBAL_PK_TABLE( "t3" );

# PK 자신이 글로벌인지부터 확인한다. 아니면 아래가 공허해진다.
CALL SELECT_INDEX_META( "t3" );

# 테이블 단위
create replication rep3 with '127.0.0.1', 40003 from sys.t3 to sys.t3;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP3';

# 파티션 단위도 된다. 상대 host:port 는 rep3 와 달라야 한다(ERR-6110C).
create replication rep4 with '127.0.0.1', 40004
  from sys.t3 partition p1 to sys.t3 partition p1;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP4';

drop replication rep4;
drop replication rep3;

##################################
# SECTOR; GLOBAL PRIMARY KEY + ROW MOVEMENT IS REPLICABLE TOO (V4 C-2)
##################################
# V3 가 남긴 마지막 거부가 여기 있었다. 옛 순서(대상 파티션 INSERT 먼저)
# 에서는 receiver 가 이동의 두 반쪽을 따로 판정하는 사이에 글로벌 PK 가
# 아직 살아 있는 원본 로우를 보므로 INSERT 가 중복으로 버려지고 DELETE 만
# 성공했다 — 로우 소실(v3-rp-receiver.md §5.2 결함 D2).
#
# V4 는 게이트를 넓힌 것이 아니라 뿌리를 고쳤다. C-1 이 qmnUPTE::
# updateOneRowForRowmovement 의 순서를 뒤집어(원본 DELETE 먼저) 충돌할 옛
# 로우를 남기지 않게 했고, C-2 가 rpcValidate 의 조건을 걷었다.
#
# 이 파일은 한 인스턴스의 DDL 게이트만 본다 — receiver 가 이동을 정확히 한
# 행으로 apply 하는 것(D2 의 소멸)은 두 인스턴스가 필요하므로
# scripts/global-index/replication-check.sh 의 N4b 가 양 매체로 잰다.

CALL CREATE_GLOBAL_PK_ROWMOVE_TABLE( "t4" );

# PK 가 글로벌인지, row movement 가 실제로 켜졌는지 둘 다 확인한다.
CALL SELECT_INDEX_META( "t4" );

select row_movement from system_.sys_part_tables_
 where table_id = ( select table_id from system_.sys_tables_
                     where table_name = 'T4' );

# 테이블 단위
create replication rep4 with '127.0.0.1', 40004 from sys.t4 to sys.t4;

# 파티션 단위도 된다. 이름과 상대 host:port 가 둘 다 rep4 와 달라야 한다
# (같은 이름은 ERR-61100, 같은 host:port 는 ERR-6110C).
create replication rep5 with '127.0.0.1', 40005
  from sys.t4 partition p1 to sys.t4 partition p1;

# 둘 다 남아 있어야 한다
select count(*) repl_cnt from system_.sys_replications_
 where replication_name in ( 'REP4', 'REP5' );

drop replication rep5;
drop replication rep4;

# row movement 를 꺼도 답은 같다. 그 같음이 이 섹터의 단언이다 — 켠 쪽만
# 거부되는 날 갈라진다.
#
# 끄는 것 자체는 복제가 걸려 있는 동안 ERR-31020 이다(복제 테이블의 DDL 을
# 통째로 막는 제품의 기존 거부이고 글로벌 인덱스와 무관하다). 그래서 위에서
# 먼저 떼어 냈고, 그 순서가 곧 이 조합에 들어가는 유일한 길이기도 하다 —
# row movement 를 먼저 켜고 복제를 만든다.
alter table t4 disable row movement;

create replication rep4 with '127.0.0.1', 40004 from sys.t4 to sys.t4;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP4';

drop replication rep4;

# 서버가 서 있어야 한다 (죽었으면 이 문장이 나오지 않는다)
select 'ALIVE' server_state from dual;

##################################
# SECTOR; PROPERTY OFF - REPLICATION PATH UNCHANGED (회귀)
##################################
# 프로퍼티가 꺼져 있으면 글로벌 PK 픽스처 자체가 만들어지지 않는다.
# 파티션 키를 포함하지 않는 PK 는 프로퍼티 이전의 답인 ERR-31415 로
# 거부된다. 이것이 회귀 방향이고, 위 섹터들이 전부 성공 단언이 된 지금
# 스위치 off 를 재는 자리는 여기 하나다.

CALL DISABLE_GLOBAL_INDEX();

drop table t3;
CALL CREATE_GLOBAL_PK_TABLE( "t3" );

# 그리고 평범한(로컬 PK) 테이블의 복제 경로는 종전 그대로여야 한다.
CALL CREATE_REPL_TABLE( "t3" );

CALL SELECT_INDEX_META( "t3" );

create replication rep3 with '127.0.0.1', 40003 from sys.t3 to sys.t3;

select replication_name, is_started from system_.sys_replications_
 where replication_name = 'REP3';

drop replication rep3;

CALL ENABLE_GLOBAL_INDEX();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
