###########################################################################
# Native Global Index - environment helpers
#
# 네이티브 글로벌 인덱스는 프로퍼티로 게이트된다.
# 이름은 MEM_GLOBAL_INDEX_ENABLE 로 확정됐다(idpDescResource.cpp).
#
# ★ 이 프로퍼티는 비영속이다. ALTER SYSTEM 으로 바꾼 값은 재기동하면
#   파일 값(기본 0)으로 돌아간다. 그래서 각 케이스가 자기 PREPARE 에서
#   켜야 하고, FINALIZE 에서 꺼서 다음 케이스에 새지 않게 해야 한다.
###########################################################################

#
# 네이티브 글로벌 인덱스 생성을 허용한다.
#
DEF ENABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 1;
}
#
# 네이티브 글로벌 인덱스 생성을 막는다(기존 동작).
# off 상태에서 메모리 파티션드 테이블의 non-partitioned index는
# 기존과 동일하게 거부되어야 한다.
#
DEF DISABLE_GLOBAL_INDEX()
{
  alter system set MEM_GLOBAL_INDEX_ENABLE = 0;
}
###########################################################################
# Native Global Index - memory partitioned table helpers
#
# 구버전(PROJ-1624) 테스트는 파티션드 테이블을 전부 디스크
# (tablespace sys_tbs_disk_data)에 만들었다. 당시 서버가 메모리 파티션드
# 테이블의 글로벌 인덱스를 전면 금지했기 때문이다.
#
# 이 스위트가 검증하는 것은 그 반대다. 여기서 만드는 테이블은 전부
# 메모리 테이블스페이스에 있다.
###########################################################################

#
# 단일 메모리 테이블스페이스에 파티션 3개를 만든다.
#
# @aPartType : range | hash | list
# @aKeyType  : 파티션 키 컬럼 타입
# @aColType  : 나머지 컬럼 타입
#
# 컬럼 구성: i1(파티션 키), i2, i3, i4
#
DEF CREATE_MEM_PART_TABLE( @aPartType, @aKeyType, @aColType )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

if ( @aPartType == 'range' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'hash' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3
)
tablespace sys_tbs_mem_data;

}
elsif ( @aPartType == 'list' )
{

create table t1( i1 @{aKeyType}, i2 @{aColType}, i3 @{aColType}, i4 @{aColType} )
partition by list(i1)
(
  partition p1 values (100),
  partition p2 values (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

}
else
{
  print "error: unknown partition type @{aPartType}";
}

}
#
# range 파티션 기준으로 세 파티션에 고르게 데이터를 넣는다.
# i1: 파티션 키, i2/i3/i4: 값
#
DEF FILL_RANGE_DATA()
{
insert into t1 select level,        level,        level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 100,  level + 100,  level * 2, level * 3 from dual connect by level <= 30;
insert into t1 select level + 200,  level + 200,  level * 2, level * 3 from dual connect by level <= 30;
commit;
}
DEF FILL_LIST_DATA()
{
insert into t1 values (100, 1, 2, 3);
insert into t1 values (100, 4, 5, 6);
insert into t1 values (200, 7, 8, 9);
insert into t1 values (200, 10, 11, 12);
insert into t1 values (300, 13, 14, 15);
insert into t1 values (400, 16, 17, 18);
commit;
}
#
# 인덱스 경유 결과와 풀스캔 결과가 완전히 같은지 양방향으로 확인한다.
# 두 select 모두 0행이어야 정상이다.
#
# @aTable  : 테이블 이름
# @aIndex  : 글로벌 인덱스 이름
# @aCols   : 비교할 컬럼 목록 (예: "i1, i2")
# @aPred   : where 절 술어 (예: "i2 >= 0 or i2 is null")
#
# 바깥 ORDER BY 는 이름이 아니라 **위치**로 준다. @aCols 에 substr(...) 같은
# 표현식이 들어갈 수 있는데, 파생 테이블의 컬럼은 표현식 이름으로 참조할 수
# 없다(ERR-31058). 두 select 모두 0행이 정상이므로 정렬은 실패했을 때의
# 출력을 위한 것뿐이다.
#
# 주의: 인덱스 컬럼에 null 이 있으면 인덱스 스캔이 null 행을 건너뛸 수
#       있다. @aPred 를 null 행까지 포함하도록 주거나, null 케이스는
#       CHECK_INDEX_SCAN_NOTNULL 로 나눠서 확인한다.
#
DEF CHECK_INDEX_SCAN( @aTable, @aIndex, @aCols, @aPred )
{
  # 인덱스 경유 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;

  # 풀스캔 결과에만 있는 행 (없어야 정상)
  select * from
  (
    select /*+ FULL SCAN(@{aTable}) */ @{aCols} from @{aTable} where @{aPred}
    minus
    select /*+ index(@{aTable}, @{aIndex}) */ @{aCols} from @{aTable} where @{aPred}
  )
  order by 1;
}
#
# 카운트와 집계를 교차 확인한다.
# 인덱스가 어떤 파티션의 키를 빠뜨리거나 유령 키를 갖고 있으면 어긋난다.
#
DEF CHECK_INDEX_COUNT( @aTable, @aIndex, @aKeyCol )
{
  select /*+ FULL SCAN(@{aTable}) */ count(*) full_cnt,
         count(@{aKeyCol}) full_key_cnt,
         nvl(sum(@{aKeyCol}), -1) full_sum,
         nvl(min(@{aKeyCol}), -1) full_min,
         nvl(max(@{aKeyCol}), -1) full_max
  from @{aTable};

  select /*+ index(@{aTable}, @{aIndex}) */ count(@{aKeyCol}) idx_key_cnt,
         nvl(sum(@{aKeyCol}), -1) idx_sum,
         nvl(min(@{aKeyCol}), -1) idx_min,
         nvl(max(@{aKeyCol}), -1) idx_max
  from @{aTable}
  where @{aKeyCol} is not null;
}
#
# 파티션별 행 수의 합이 전체와 같은지 확인한다.
# 파티션 3개 + default 구성(p1,p2,p3)을 전제한다.
#
DEF CHECK_PARTITION_COUNT( @aTable )
{
  select count(*) total_cnt from @{aTable};

  select 'P1' part_name, count(*) part_cnt from @{aTable} partition (p1)
  union all
  select 'P2', count(*) from @{aTable} partition (p2)
  union all
  select 'P3', count(*) from @{aTable} partition (p3)
  order by 1;
}
#
# 위 검사를 한 번에 수행한다. 시나리오 끝마다 호출한다.
#
DEF CHECK_GLOBAL_INDEX( @aTable, @aIndex, @aCols, @aKeyCol )
{
  CALL CHECK_INDEX_SCAN( "@{aTable}", "@{aIndex}", "@{aCols}", "@{aKeyCol} is not null" );
  CALL CHECK_INDEX_COUNT( "@{aTable}", "@{aIndex}", "@{aKeyCol}" );
  CALL CHECK_PARTITION_COUNT( "@{aTable}" );
}
###########################################################################
# TestCase Description = SPLIT / MERGE / REPLACE PARTITION.
#                        로우가 대량으로 재배치되므로 글로벌 인덱스를
#                        리빌드해서 처리한다. 재배치 후에도 인덱스가
#                        정합인지 확인한다.
#
#   Altibase 에는 EXCHANGE PARTITION 이 없다(qcply.y 에 EXCHANGE 토큰
#   자체가 없다). 같은 일을 하는 구문은
#       ALTER TABLE <target> REPLACE <source> PARTITION <name>
#   이고, 양쪽 모두 파티션드 테이블이어야 하며 같은 이름의 파티션을
#   맞바꾼다.
#
#   V2 가 이 DDL 들의 거부(구 ERR-314AE)를 걷어냈으므로 전부 성공해야 한다.
#   프로젝트 회귀 스크립트(partition-reorg-check.sh)는 글로벌 인덱스가
#   "없는" 테이블만 다룬다. 글로벌 인덱스가 있는 쪽은 여기서만 본다.
# Project ID           = Native Global Index (memory)
###########################################################################


DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; SPLIT PARTITION
##################################
# 한 파티션을 둘로 나눈다. 로우가 두 파티션으로 흩어지므로 인덱스가
# 가리키는 위치가 전부 바뀐다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index gidx2 on t1(i3);

CALL FILL_RANGE_DATA();

CALL CHECK_PARTITION_COUNT( "t1" );
CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

alter table t1 split partition p1 at ( 50 ) into ( partition p1a, partition p1b );

select count(*) total_cnt from t1;

select 'P1A' part_name, count(*) part_cnt from t1 partition (p1a)
union all
select 'P1B', count(*) from t1 partition (p1b)
union all
select 'P2', count(*) from t1 partition (p2)
union all
select 'P3', count(*) from t1 partition (p3)
order by 1;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_SCAN( "t1", "gidx2", "i1, i3", "i3 is not null" );

# split 후 DML
insert into t1 values (25, 5000, 1, 1);
insert into t1 values (75, 6000, 1, 1);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; MERGE PARTITION
##################################
# 나눈 것을 다시 합친다.

alter table t1 merge partitions p1a, p1b into partition p1;

select count(*) total_cnt from t1;
CALL CHECK_PARTITION_COUNT( "t1" );
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

# merge 후 DML
insert into t1 values (30, 7000, 1, 1);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; SPLIT WITH UNIQUE INDEX
##################################
# 유니크 인덱스가 split 을 거쳐도 파티션 간 유일성을 계속 보장해야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10, 1000, 1, 1);
insert into t1 values (60, 2000, 1, 1);
insert into t1 values (150, 3000, 2, 2);
commit;

alter table t1 split partition p1 at ( 50 ) into ( partition p1a, partition p1b );

select i1, i2 from t1 order by i1;

# 나뉜 파티션 사이의 중복 -> 실패해야 한다
insert into t1 values (25, 2000, 1, 1);

# 다른 파티션과의 중복 -> 실패해야 한다
insert into t1 values (250, 1000, 3, 3);

# 새 값 -> 성공
insert into t1 values (250, 4000, 3, 3);
commit;

select i1, i2 from t1 order by i1;

##################################
# SECTOR; SPLIT ON LIST PARTITION
##################################
# 리스트 파티션은 AT 이 아니라 VALUES 로 나눈다.

CALL CREATE_MEM_PART_TABLE( "list", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_LIST_DATA();
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

alter table t1 split partition p1 values ( 100 ) into ( partition p1a, partition p1b );

select count(*) total_cnt from t1;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLACE PARTITION
##################################
# 두 파티션드 테이블이 같은 이름의 파티션을 맞바꾼다. 양쪽 파티션의
# 로우가 통째로 교체되므로, 글로벌 인덱스를 가진 쪽은 그에 맞춰
# 다시 만들어져야 한다.
#
# 여기서 걸리는 것: 인덱스 리프 슬롯은 로우를 가리키는 생 포인터이고
# 파티션은 페이지 헤더의 mTableOID 로 역산된다. 맞바꾼 뒤 옛 파티션의
# 페이지가 회수되면 남아 있는 슬롯은 재사용된 메모리를 가리킨다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

# 맞바꿀 상대도 파티션드여야 하고 파티션 이름이 같아야 한다
create table t2( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

insert into t2 select level, level + 9000, level, level from dual connect by level <= 10;
commit;

select count(*) from t1;
select count(*) from t2;
CALL CHECK_PARTITION_COUNT( "t1" );

alter table t1 replace t2 partition p1;

select count(*) from t1;
select count(*) from t2;
CALL CHECK_PARTITION_COUNT( "t1" );

# 들어온 로우는 인덱스에서 보여야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 9000;

# 나간 로우는 인덱스에서 사라져야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 1 and 30;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

# 상대 테이블(t2)에 DML 을 해도 t1 의 글로벌 인덱스가 영향을 받으면 안 된다.
insert into t2 values (1, 1, 1, 1);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLACE BACK
##################################

alter table t1 replace t2 partition p1;

select count(*) from t1;
select count(*) from t2;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLACE WHEN BOTH SIDES HAVE A GLOBAL INDEX
##################################
# 양쪽 다 글로벌 인덱스를 가진 경우. 두 인덱스가 모두 다시 만들어져야
# 하고, 서로의 로우를 가리키게 되면 안 된다.

create index gidx2 on t2(i2);

CALL CHECK_INDEX_SCAN( "t2", "gidx2", "i1, i2", "i2 is not null" );

alter table t1 replace t2 partition p2;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_SCAN( "t2", "gidx2", "i1, i2", "i2 is not null" );

select count(*) from t1;
select count(*) from t2;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
