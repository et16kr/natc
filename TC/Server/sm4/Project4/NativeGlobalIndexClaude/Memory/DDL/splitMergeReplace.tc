###########################################################################
# TestCase Description = SPLIT / MERGE / REPLACE PARTITION.
#                        로우가 대량으로 재배치되므로 글로벌 인덱스를
#                        리빌드해서 처리한다. 재배치 후에도 인덱스가
#                        정합인지 확인한다.
#
#   Altibase 에는 EXCHANGE PARTITION 이 없다(qcply.y 에 EXCHANGE 토큰
#   자체가 없다). 같은 일을 하는 구문은
#       ALTER TABLE <target> REPLACE <source> PARTITION <name>
#   이고, 양쪽 모두 파티션드 테이블이어야 하며 같은 이름의 파티션을
#   맞바꾼다.
#
#   V2 가 이 DDL 들의 거부(구 ERR-314AE)를 걷어냈으므로 전부 성공해야 한다.
#   프로젝트 회귀 스크립트(partition-reorg-check.sh)는 글로벌 인덱스가
#   "없는" 테이블만 다룬다. 글로벌 인덱스가 있는 쪽은 여기서만 본다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/createMemPartTable.i;
INCLUDE ../../include/checkGlobalIndex.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; SPLIT PARTITION
##################################
# 한 파티션을 둘로 나눈다. 로우가 두 파티션으로 흩어지므로 인덱스가
# 가리키는 위치가 전부 바뀐다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);
create index gidx2 on t1(i3);

CALL FILL_RANGE_DATA();

CALL CHECK_PARTITION_COUNT( "t1" );
CALL CHECK_GLOBAL_INDEX( "t1", "gidx1", "i1, i2", "i2" );

alter table t1 split partition p1 at ( 50 ) into ( partition p1a, partition p1b );

select count(*) total_cnt from t1;

select 'P1A' part_name, count(*) part_cnt from t1 partition (p1a)
union all
select 'P1B', count(*) from t1 partition (p1b)
union all
select 'P2', count(*) from t1 partition (p2)
union all
select 'P3', count(*) from t1 partition (p3)
order by 1;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_SCAN( "t1", "gidx2", "i1, i3", "i3 is not null" );

# split 후 DML
insert into t1 values (25, 5000, 1, 1);
insert into t1 values (75, 6000, 1, 1);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; MERGE PARTITION
##################################
# 나눈 것을 다시 합친다.

alter table t1 merge partitions p1a, p1b into partition p1;

select count(*) total_cnt from t1;
CALL CHECK_PARTITION_COUNT( "t1" );
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

# merge 후 DML
insert into t1 values (30, 7000, 1, 1);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; SPLIT WITH UNIQUE INDEX
##################################
# 유니크 인덱스가 split 을 거쳐도 파티션 간 유일성을 계속 보장해야 한다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10, 1000, 1, 1);
insert into t1 values (60, 2000, 1, 1);
insert into t1 values (150, 3000, 2, 2);
commit;

alter table t1 split partition p1 at ( 50 ) into ( partition p1a, partition p1b );

select i1, i2 from t1 order by i1;

# 나뉜 파티션 사이의 중복 -> 실패해야 한다
insert into t1 values (25, 2000, 1, 1);

# 다른 파티션과의 중복 -> 실패해야 한다
insert into t1 values (250, 1000, 3, 3);

# 새 값 -> 성공
insert into t1 values (250, 4000, 3, 3);
commit;

select i1, i2 from t1 order by i1;

##################################
# SECTOR; SPLIT ON LIST PARTITION
##################################
# 리스트 파티션은 AT 이 아니라 VALUES 로 나눈다.

CALL CREATE_MEM_PART_TABLE( "list", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_LIST_DATA();
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

alter table t1 split partition p1 values ( 100 ) into ( partition p1a, partition p1b );

select count(*) total_cnt from t1;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLACE PARTITION
##################################
# 두 파티션드 테이블이 같은 이름의 파티션을 맞바꾼다. 양쪽 파티션의
# 로우가 통째로 교체되므로, 글로벌 인덱스를 가진 쪽은 그에 맞춰
# 다시 만들어져야 한다.
#
# 여기서 걸리는 것: 인덱스 리프 슬롯은 로우를 가리키는 생 포인터이고
# 파티션은 페이지 헤더의 mTableOID 로 역산된다. 맞바꾼 뒤 옛 파티션의
# 페이지가 회수되면 남아 있는 슬롯은 재사용된 메모리를 가리킨다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

CALL FILL_RANGE_DATA();

NODISPLAY ON;
SKIP BEGIN;
drop table t2;
SKIP END;
NODISPLAY OFF;

# 맞바꿀 상대도 파티션드여야 하고 파티션 이름이 같아야 한다
create table t2( i1 integer, i2 integer, i3 integer, i4 integer )
partition by range(i1)
(
  partition p1 values less than (100),
  partition p2 values less than (200),
  partition p3 values default
)
tablespace sys_tbs_mem_data;

insert into t2 select level, level + 9000, level, level from dual connect by level <= 10;
commit;

select count(*) from t1;
select count(*) from t2;
CALL CHECK_PARTITION_COUNT( "t1" );

alter table t1 replace t2 partition p1;

select count(*) from t1;
select count(*) from t2;
CALL CHECK_PARTITION_COUNT( "t1" );

# 들어온 로우는 인덱스에서 보여야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 9000;

# 나간 로우는 인덱스에서 사라져야 한다
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 between 1 and 30;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

# 상대 테이블(t2)에 DML 을 해도 t1 의 글로벌 인덱스가 영향을 받으면 안 된다.
insert into t2 values (1, 1, 1, 1);
commit;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLACE BACK
##################################

alter table t1 replace t2 partition p1;

select count(*) from t1;
select count(*) from t2;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

##################################
# SECTOR; REPLACE WHEN BOTH SIDES HAVE A GLOBAL INDEX
##################################
# 양쪽 다 글로벌 인덱스를 가진 경우. 두 인덱스가 모두 다시 만들어져야
# 하고, 서로의 로우를 가리키게 되면 안 된다.

create index gidx2 on t2(i2);

CALL CHECK_INDEX_SCAN( "t2", "gidx2", "i1, i2", "i2 is not null" );

alter table t1 replace t2 partition p2;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );
CALL CHECK_INDEX_SCAN( "t2", "gidx2", "i1, i2", "i2 is not null" );

select count(*) from t1;
select count(*) from t2;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
