###########################################################################
# TestCase Description = 인덱스 키 컬럼에 NULL 이 있을 때의 동작.
#                        인덱스 스캔이 NULL 행을 어떻게 다루는지에 따라
#                        정합성 검사 방식이 달라지므로 별도로 확인한다.
# Project ID           = Native Global Index (memory)
###########################################################################

INCLUDE ../include/globalIndexEnv.i;
INCLUDE ../include/createMemPartTable.i;
INCLUDE ../include/checkGlobalIndex.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
CALL DISABLE_GLOBAL_INDEX();
}

DEF PREPARE()
{
CALL FINALIZE();
CALL ENABLE_GLOBAL_INDEX();
}

DEF MAIN()
{
##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; NULL IN ALL PARTITIONS
##################################
# 파티션마다 NULL 키를 가진 행을 넣는다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

insert into t1 values (10, null, 1, 1);
insert into t1 values (11, 11, 1, 1);
insert into t1 values (150, null, 2, 2);
insert into t1 values (151, 151, 2, 2);
insert into t1 values (250, null, 3, 3);
insert into t1 values (251, 251, 3, 3);
commit;

select count(*) total_cnt from t1;
select count(*) null_cnt from t1 where i2 is null;
select count(*) notnull_cnt from t1 where i2 is not null;

# NOT NULL 부분집합의 정합성
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

# NULL 행도 조회되어야 한다
select i1, i2 from t1 where i2 is null order by i1;
select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is null order by i1;

# 전체(NULL 포함) 비교
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is null or i2 is not null" );

##################################
# SECTOR; ALL NULL
##################################
# 전 파티션의 키가 전부 NULL 인 경우.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2);

insert into t1 values (10, null, 1, 1);
insert into t1 values (150, null, 2, 2);
insert into t1 values (250, null, 3, 3);
commit;

select count(*) from t1;
select count(*) from t1 where i2 is null;
select /*+ index(t1, gidx1) */ count(*) from t1 where i2 is null;

CALL CHECK_PARTITION_COUNT( "t1" );

##################################
# SECTOR; NULL TO VALUE AND BACK
##################################
# NULL 키를 값으로 바꾸고 다시 NULL 로 되돌린다.

update t1 set i2 = 500 where i1 = 10;
commit;

select i1, i2 from t1 order by i1;
CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2", "i2 is not null" );

update t1 set i2 = null where i1 = 10;
commit;

select i1, i2 from t1 order by i1;
select count(*) from t1 where i2 is null;

##################################
# SECTOR; UNIQUE WITH NULL
##################################
# 유니크 인덱스에서 NULL 은 여러 개 허용된다.
# 서로 다른 파티션의 NULL 이 충돌로 판정되면 안 된다.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create unique index t1_uk on t1(i2);

insert into t1 values (10, null, 1, 1);
insert into t1 values (150, null, 2, 2);
insert into t1 values (250, null, 3, 3);
commit;

select count(*) from t1 where i2 is null;
CALL CHECK_PARTITION_COUNT( "t1" );

# NULL 이 아닌 값은 여전히 유니크여야 한다
insert into t1 values (11, 100, 1, 1);
commit;
insert into t1 values (151, 100, 2, 2);

select count(*) from t1 where i2 = 100;

##################################
# SECTOR; COMPOSITE KEY WITH PARTIAL NULL
##################################
# 복합 키의 일부만 NULL 인 경우.

CALL CREATE_MEM_PART_TABLE( "range", "integer", "integer" );

create index gidx1 on t1(i2, i3);

insert into t1 values (10, 1, null, 1);
insert into t1 values (11, null, 1, 1);
insert into t1 values (150, 2, null, 2);
insert into t1 values (151, null, 2, 2);
insert into t1 values (250, 3, 3, 3);
commit;

select i1, i2, i3 from t1 order by i1;
select count(*) from t1 where i2 is not null and i3 is not null;

CALL CHECK_INDEX_SCAN( "t1", "gidx1", "i1, i2, i3", "i2 is not null and i3 is not null" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
