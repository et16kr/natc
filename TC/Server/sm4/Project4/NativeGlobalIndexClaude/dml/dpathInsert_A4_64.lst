$T0> ##################################
$T0> # SECTOR; APPEND AND ROLLBACK
$T0> ##################################
$T0> # append 적재를 롤백하면 키가 남으면 안 된다.

$T0> insert /*+append*/ into t1 select i1 + 2000, i2 + 2000, i3, i4 from t2;
90 rows inserted.
$T0> rollback;
Rollback success.

$T0> select count(*) from t1;
COUNT                
-----------------------
190                  
1 row selected.
$T0> select /*+ index(t1, gidx1) */ count(*) from t1 where i2 >= 2000;
COUNT                
-----------------------
90                   
1 row selected.
$T0> # 인덱스 경유 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.

$T0> # 풀스캔 결과에만 있는 행 (없어야 정상)
$T0> select * from
  (
    select /*+ FULL SCAN(t1) */ i1, i2 from t1 where i2 is not null
    minus
    select /*+ index(t1, gidx1) */ i1, i2 from t1 where i2 is not null
  )
  order by 1;
I1          I2          
---------------------------
No rows selected.
