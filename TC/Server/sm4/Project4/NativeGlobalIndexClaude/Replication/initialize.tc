###########################################################################
# TestCase Description = 복제 레인의 두 인스턴스를 세운다.
# Project ID           = Native Global Index
#
# ★ 이 파일이 복제 TC 의 템플릿이다 -- 새 복제 케이스는 이것을 보고 쓴다.
#
# 관례 (원본 PROJ-1624-QC/repl/initialize.tc, sm4 PROJ-2429 과 같은 모양)
#
#   프로젝트마다 **자기 서버 이름과 자기 db1/db2** 를 갖는다. repl4 의
#   REPL_SERVER1/2/3 은 conf/server.conf 가 ALTIBASE_HOME 을
#   TC/Server/repl4/db1 로 박아 두었으므로 남의 것이고, 쓰지 않는다.
#
#   우리 블록은 conf/server.conf 의 [NGI_SERVER1] / [NGI_SERVER2] 이고
#   ALTIBASE_HOME 이 이 디렉터리의 db1 / db2 를 가리킨다.
#
#   $ALTIBASE_HOME_C0 로 **컨트롤러의 home 을 먼저 잡는다.** 스레드 안에서
#   $ALTIBASE_HOME 은 그 스레드가 붙은 서버의 것이 되므로, 원본 설치에서
#   bin/msg/conf 를 복사하려면 잡아 둔 값이 필요하다.
#
# 왜 이 레인이 이제야 열렸는가
#   종전 진단은 "stdFunc.i 가 include 시점에 ALTIBASE_HOME 을 굳혀서
#   프레임워크가 막는다" 였다. 틀렸다. 막고 있던 것은 conf/server.conf 에
#   우리 블록이 없던 것 하나이고, 그것을 더해 열었다.
#   (통합 계획 §9.3 · §10.1)
###########################################################################

include stdFunc.i;

$ALTIBASE_HOME;
$ALTIBASE_HOME_C0 = $ALTIBASE_HOME;

DECLARE SERVER NGI_SERVER1 DB1;
DECLARE SERVER NGI_SERVER2 DB2;

DECLARE CLIENT DEFAULT C11 (SERVER=DB1);
DECLARE CLIENT DEFAULT C21 (SERVER=DB2);

SET_ENV ALTIBASE_REPLICATION_LOCK_TIMEOUT="30";

DEF MAIN()
{
    THREAD T11 C11
    {
        --########################################
        --# Set Up DB 1
        --########################################

        SET_ENV @DB1 ALTIBASE_REPLICATION_LOCK_TIMEOUT="30";

        RM -rf "db1";

        MKDIR "db1";
        MKDIR "db1/conf";
        MKDIR "db1/dbs";
        MKDIR "db1/logs";
        MKDIR "db1/trc";
        MKDIR "db1/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin" "db1/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg" "db1/msg";
        CP "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db1/conf/altibase.properties";
        CP "${ALTIBASE_HOME_C0}/conf/license" "db1/conf/license";

        NODISPLAY ON;
        CALL stdServerKill();
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }
    THREAD T21 C21
    {
        --########################################
        --# Set Up DB 2
        --########################################

        SET_ENV @DB2 ALTIBASE_REPLICATION_LOCK_TIMEOUT="30";

        RM -rf "db2";

        MKDIR "db2";
        MKDIR "db2/conf";
        MKDIR "db2/dbs";
        MKDIR "db2/logs";
        MKDIR "db2/trc";
        MKDIR "db2/arch_logs";

        CP -r "${ALTIBASE_HOME_C0}/bin" "db2/bin";
        CP -r "${ALTIBASE_HOME_C0}/msg" "db2/msg";
        CP "${ALTIBASE_HOME_C0}/conf/altibase.properties" "db2/conf/altibase.properties";
        CP "${ALTIBASE_HOME_C0}/conf/license" "db2/conf/license";

        NODISPLAY ON;
        CALL stdServerKill();
        CALL stdClean();
        CALL stdServerStart();
        NODISPLAY OFF;
    }
    join;
}
