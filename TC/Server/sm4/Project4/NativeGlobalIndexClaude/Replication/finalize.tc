###########################################################################
# TestCase Description = 복제 레인의 두 인스턴스를 내린다.
# Project ID           = Native Global Index
#
# initialize.tc 의 짝. 스위트가 자기가 세운 것을 자기가 걷는다 --
# 원본 PROJ-1624-QC/repl/replication.ts 와 같은 모양이다.
###########################################################################

include stdFunc.i;

DECLARE SERVER NGI_SERVER1 DB1;
DECLARE SERVER NGI_SERVER2 DB2;

DECLARE CLIENT DEFAULT C11 (SERVER=DB1);
DECLARE CLIENT DEFAULT C21 (SERVER=DB2);

DEF MAIN()
{
    THREAD T11 C11
    {
        NODISPLAY ON;
        CALL stdServerKill();
        NODISPLAY OFF;
    }
    THREAD T21 C21
    {
        NODISPLAY ON;
        CALL stdServerKill();
        NODISPLAY OFF;
    }
    join;
}
