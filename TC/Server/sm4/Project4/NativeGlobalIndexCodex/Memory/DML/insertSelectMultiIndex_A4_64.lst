$T0> DROP TABLE NGM_DML_SEL_SRC;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DML_SEL_SRC (P INTEGER, K VARCHAR(24), V VARCHAR(24))
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_DML_SEL_DST (P INTEGER, K VARCHAR(24), V VARCHAR(24))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE INDEX NGM_DML_SEL_DST_K ON NGM_DML_SEL_DST(K);
Create success.
$T0> CREATE INDEX NGM_DML_SEL_DST_V ON NGM_DML_SEL_DST(V DESC, K);
Create success.
$T0> CREATE INDEX NGM_DML_SEL_DST_L ON NGM_DML_SEL_DST(P) LOCAL;
Create success.

$T0> INSERT INTO NGM_DML_SEL_SRC VALUES (1, 'K-101', 'SRC-A');
1 row inserted.
$T0> INSERT INTO NGM_DML_SEL_SRC VALUES (11, 'K-111', 'SRC-B');
1 row inserted.
$T0> INSERT INTO NGM_DML_SEL_SRC VALUES (21, 'K-121', 'SRC-C');
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> INSERT INTO NGM_DML_SEL_DST
        SELECT P, K, V FROM NGM_DML_SEL_SRC;
3 rows inserted.

$T0> INSERT INTO NGM_DML_SEL_DST
        SELECT P + 30, K || '-COPY', V || '-COPY'
          FROM NGM_DML_SEL_SRC
         WHERE P < 10;
1 row inserted.

$T0> UPDATE NGM_DML_SEL_DST SET V = 'DST-B' WHERE K = 'K-111';
1 row updated.
$T0> DELETE FROM NGM_DML_SEL_DST WHERE K = 'K-121';
1 row deleted.

$T0> SELECT /*+ INDEX(NGM_DML_SEL_DST, NGM_DML_SEL_DST_K) */ P, K, V
      FROM NGM_DML_SEL_DST
