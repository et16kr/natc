###########################################################################
# TestCase Description = Repeatedly move one Memory row across partitions.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DML-007
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_REPEAT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DML_REPEAT (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) ENABLE ROW MOVEMENT TABLESPACE SYS_TBS_MEM_DATA;
    CREATE UNIQUE INDEX NGM_DML_REPEAT_U ON NGM_DML_REPEAT(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_DML_REPEAT VALUES (1, 'K-100', 1);

##################################
SECTOR; TEST
##################################
    UPDATE NGM_DML_REPEAT SET P = 11, V = 2 WHERE K = 'K-100';
    SELECT P, K, V FROM NGM_DML_REPEAT ORDER BY K;
    UPDATE NGM_DML_REPEAT SET P = 21, V = 3 WHERE K = 'K-100';
    SELECT P, K, V FROM NGM_DML_REPEAT ORDER BY K;
    UPDATE NGM_DML_REPEAT SET P = 5, V = 4 WHERE K = 'K-100';
    SELECT P, K, V FROM NGM_DML_REPEAT ORDER BY K;

    SELECT /*+ INDEX(NGM_DML_REPEAT, NGM_DML_REPEAT_U) */ P, K, V
      FROM NGM_DML_REPEAT WHERE K = 'K-100' ORDER BY P;
    SELECT /*+ FULL SCAN(NGM_DML_REPEAT) */ P, K, V
      FROM NGM_DML_REPEAT WHERE K = 'K-100' ORDER BY P;
    SELECT K, COUNT(*) FROM NGM_DML_REPEAT GROUP BY K ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_REPEAT;
    SKIP END;
}
