$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DML_REPEAT (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) ENABLE ROW MOVEMENT TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGM_DML_REPEAT_U ON NGM_DML_REPEAT(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_DML_REPEAT VALUES (1, 'K-100', 1);
1 row inserted.

