###########################################################################
# TestCase Description = Verify Memory row movement and global uniqueness.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_MOVE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DML_MOVE
    (
        P INTEGER,
        UKEY VARCHAR(64),
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE UNIQUE INDEX NGM_DML_MOVE_U
        ON NGM_DML_MOVE(UKEY)
        TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_DML_MOVE VALUES (1, 'U-100', 'MOVE');
    INSERT INTO NGM_DML_MOVE VALUES (11, 'U-200', 'STAY');

##################################
SECTOR; TEST
##################################
    UPDATE NGM_DML_MOVE SET P = 21 WHERE UKEY = 'U-100';

    SELECT P, UKEY, V
      FROM NGM_DML_MOVE
     ORDER BY UKEY;

    INSERT INTO NGM_DML_MOVE VALUES (5, 'U-100', 'DUPLICATE');

    SELECT /*+ INDEX(NGM_DML_MOVE, NGM_DML_MOVE_U) */
           P, UKEY, V
      FROM NGM_DML_MOVE
     ORDER BY UKEY;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_MOVE;
    SKIP END;
}

