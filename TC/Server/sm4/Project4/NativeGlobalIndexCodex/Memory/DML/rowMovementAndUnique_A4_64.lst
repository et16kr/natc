$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DML_MOVE
    (
        P INTEGER,
        UKEY VARCHAR(64),
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE UNIQUE INDEX NGM_DML_MOVE_U
        ON NGM_DML_MOVE(UKEY)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> INSERT INTO NGM_DML_MOVE VALUES (1, 'U-100', 'MOVE');
1 row inserted.
$T0> INSERT INTO NGM_DML_MOVE VALUES (11, 'U-200', 'STAY');
