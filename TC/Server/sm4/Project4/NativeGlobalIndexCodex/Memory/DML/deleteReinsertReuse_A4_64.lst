$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DML_REUSE (P INTEGER, UKEY VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGM_DML_REUSE_U ON NGM_DML_REUSE(UKEY)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_DML_REUSE VALUES (1, 'K-100', 1);
1 row inserted.
$T0> INSERT INTO NGM_DML_REUSE VALUES (11, 'K-200', 2);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> DELETE FROM NGM_DML_REUSE WHERE UKEY = 'K-100';
1 row deleted.
