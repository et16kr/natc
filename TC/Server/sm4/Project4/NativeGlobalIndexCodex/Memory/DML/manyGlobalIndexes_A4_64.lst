$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DML_MANY
    (P INTEGER, K1 VARCHAR(16), K2 VARCHAR(16), K3 VARCHAR(16), K4 VARCHAR(16),
     K5 VARCHAR(16), K6 VARCHAR(16), K7 VARCHAR(16), K8 VARCHAR(16), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) ENABLE ROW MOVEMENT TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_DML_MANY_I1 ON NGM_DML_MANY(K1) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
