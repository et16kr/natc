###########################################################################
# TestCase Description = Maintain a Memory native index across basic DML.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_BASIC;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DML_BASIC
    (
        P INTEGER,
        K VARCHAR(64),
        V INTEGER
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_DML_BASIC_I
        ON NGM_DML_BASIC(K)
        TABLESPACE SYS_TBS_MEM_DATA;

##################################
SECTOR; TEST
##################################
    INSERT INTO NGM_DML_BASIC VALUES (1, 'K-101', 1);
    INSERT INTO NGM_DML_BASIC VALUES (11, 'K-111', 1);
    INSERT INTO NGM_DML_BASIC VALUES (21, 'K-121', 1);

    SELECT P, K, V FROM NGM_DML_BASIC ORDER BY K;

    UPDATE NGM_DML_BASIC SET V = V + 10 WHERE K = 'K-111';
    SELECT P, K, V FROM NGM_DML_BASIC ORDER BY K;

    UPDATE NGM_DML_BASIC SET K = 'K-999' WHERE P >= 20;
    SELECT P, K, V FROM NGM_DML_BASIC ORDER BY K;

    DELETE FROM NGM_DML_BASIC WHERE K = 'K-101';
    SELECT P, K, V FROM NGM_DML_BASIC ORDER BY K;

    SELECT /*+ INDEX(NGM_DML_BASIC, NGM_DML_BASIC_I) */
           COUNT(*), MIN(K), MAX(K)
      FROM NGM_DML_BASIC;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_BASIC;
    SKIP END;
}

