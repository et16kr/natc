###########################################################################
# TestCase Description = Maintain a deterministic bulk Memory row set.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DML-009
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_BULK;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DML_BULK (P INTEGER, K INTEGER, G INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION P3 VALUES LESS THAN (30),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE UNIQUE INDEX NGM_DML_BULK_U ON NGM_DML_BULK(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_DML_BULK_G ON NGM_DML_BULK(G, K)
        TABLESPACE SYS_TBS_MEM_DATA;
    $sRow = 0;
    LOOP 200
    {
        $sRow = $sRow + 1;
        $sPart = $sRow % 40;
        $sGroup = $sRow % 7;
        --@INSERT INTO NGM_DML_BULK VALUES (${sPart}, ${sRow}, ${sGroup}, ${sRow});
    }

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*), MIN(K), MAX(K), SUM(P * 1000 + K) AS CHECKSUM
      FROM NGM_DML_BULK;
    SELECT G, COUNT(*), MIN(K), MAX(K)
      FROM NGM_DML_BULK GROUP BY G ORDER BY G;
    UPDATE NGM_DML_BULK SET V = V + 1000 WHERE G = 3;
    DELETE FROM NGM_DML_BULK WHERE K BETWEEN 51 AND 75;
    SELECT /*+ INDEX(NGM_DML_BULK, NGM_DML_BULK_U) */
           COUNT(*), MIN(K), MAX(K), SUM(V)
      FROM NGM_DML_BULK;
    SELECT /*+ FULL SCAN(NGM_DML_BULK) */
           COUNT(*), MIN(K), MAX(K), SUM(V)
      FROM NGM_DML_BULK;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DML_BULK;
    SKIP END;
}
