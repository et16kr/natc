$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_DML_ATOMIC_SRC;
$T0> DROP TABLE NGM_DML_ATOMIC;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DML_ATOMIC (P INTEGER, UKEY VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE TABLE NGM_DML_ATOMIC_SRC (P INTEGER, UKEY VARCHAR(32), V INTEGER)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGM_DML_ATOMIC_U ON NGM_DML_ATOMIC(UKEY)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_DML_ATOMIC VALUES (1, 'K-100', 1);
1 row inserted.
$T0> INSERT INTO NGM_DML_ATOMIC VALUES (11, 'K-200', 2);
1 row inserted.
$T0> INSERT INTO NGM_DML_ATOMIC_SRC VALUES (5, 'K-300', 3);
1 row inserted.
$T0> INSERT INTO NGM_DML_ATOMIC_SRC VALUES (15, 'K-100', 4);
1 row inserted.
$T0> INSERT INTO NGM_DML_ATOMIC_SRC VALUES (25, 'K-400', 5);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> INSERT INTO NGM_DML_ATOMIC
        SELECT P, UKEY, V FROM NGM_DML_ATOMIC_SRC;
[ERR-11058 : The row already exists in a unique index.]
$T0> SELECT P, UKEY, V FROM NGM_DML_ATOMIC ORDER BY UKEY;
P           UKEY                              V           
--------------------------------------------------------------
1           K-100                             1           
11          K-200                             2           
2 rows selected.

$T0> UPDATE NGM_DML_ATOMIC SET UKEY = 'K-500'
     WHERE UKEY IN ('K-100', 'K-200');
[ERR-11058 : The row already exists in a unique index.]
$T0> SELECT /*+ INDEX(NGM_DML_ATOMIC, NGM_DML_ATOMIC_U) */ P, UKEY, V
      FROM NGM_DML_ATOMIC ORDER BY UKEY;
P           UKEY                              V           
--------------------------------------------------------------
1           K-100                             1           
11          K-200                             2           
2 rows selected.
$T0> SELECT /*+ FULL SCAN(NGM_DML_ATOMIC) */ P, UKEY, V
      FROM NGM_DML_ATOMIC ORDER BY UKEY;
P           UKEY                              V           
--------------------------------------------------------------
1           K-100                             1           
11          K-200                             2           
2 rows selected.

