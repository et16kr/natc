$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_BND_MANY;
$T0> DROP TABLE NGM_BND_ONE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_BND_ONE (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES DEFAULT)
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE TABLE NGM_BND_MANY (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION P3 VALUES LESS THAN (30),
        PARTITION P4 VALUES LESS THAN (40),
        PARTITION P5 VALUES LESS THAN (50),
        PARTITION P6 VALUES LESS THAN (60),
        PARTITION P7 VALUES LESS THAN (70),
        PARTITION P8 VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_BND_ONE_I ON NGM_BND_ONE(K) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_BND_MANY_I ON NGM_BND_MANY(K) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
