###########################################################################
# TestCase Description = Compare Memory native indexes on one and eight partitions.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-BND-001
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_BND_MANY;
    DROP TABLE NGM_BND_ONE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_BND_ONE (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES DEFAULT)
    TABLESPACE SYS_TBS_MEM_DATA;
    CREATE TABLE NGM_BND_MANY (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION P3 VALUES LESS THAN (30),
        PARTITION P4 VALUES LESS THAN (40),
        PARTITION P5 VALUES LESS THAN (50),
        PARTITION P6 VALUES LESS THAN (60),
        PARTITION P7 VALUES LESS THAN (70),
        PARTITION P8 VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_BND_ONE_I ON NGM_BND_ONE(K) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_BND_MANY_I ON NGM_BND_MANY(K) TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_BND_ONE VALUES (1, 'K-101');
    INSERT INTO NGM_BND_ONE VALUES (81, 'K-181');
    INSERT INTO NGM_BND_MANY VALUES (1, 'K-101');
    INSERT INTO NGM_BND_MANY VALUES (11, 'K-111');
    INSERT INTO NGM_BND_MANY VALUES (21, 'K-121');
    INSERT INTO NGM_BND_MANY VALUES (31, 'K-131');
    INSERT INTO NGM_BND_MANY VALUES (41, 'K-141');
    INSERT INTO NGM_BND_MANY VALUES (51, 'K-151');
    INSERT INTO NGM_BND_MANY VALUES (61, 'K-161');
    INSERT INTO NGM_BND_MANY VALUES (71, 'K-171');

##################################
SECTOR; TEST
##################################
    SELECT /*+ INDEX(NGM_BND_ONE, NGM_BND_ONE_I) */ P, K
      FROM NGM_BND_ONE ORDER BY K;
    SELECT /*+ INDEX(NGM_BND_MANY, NGM_BND_MANY_I) */ P, K
      FROM NGM_BND_MANY ORDER BY K;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_BND_ONE_I', 'NGM_BND_MANY_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_BND_MANY;
    DROP TABLE NGM_BND_ONE;
    SKIP END;
}
