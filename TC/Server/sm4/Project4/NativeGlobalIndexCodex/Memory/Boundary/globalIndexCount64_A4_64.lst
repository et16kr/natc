$T0> INSERT INTO NGM_BND_64(P, V, K32) VALUES (21, 3, 300);
1 row inserted.
$T0> UPDATE NGM_BND_64 SET K32 = K32 + 100, V = V + 10 WHERE P = 11;
1 row updated.
$T0> SELECT /*+ INDEX(NGM_BND_64, NGM_BND_64_I32) */ P, K32, V
      FROM NGM_BND_64 WHERE K32 BETWEEN 100 AND 500 ORDER BY K32, P;
