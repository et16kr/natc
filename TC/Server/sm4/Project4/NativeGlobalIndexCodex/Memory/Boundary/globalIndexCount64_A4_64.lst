$T0> SELECT COUNT(*) AS NATIVE_INDEX_COUNT,
           MIN(INDEX_IMPL_TYPE), MAX(INDEX_IMPL_TYPE),
           MIN(INDEX_TABLE_ID), MAX(INDEX_TABLE_ID)
