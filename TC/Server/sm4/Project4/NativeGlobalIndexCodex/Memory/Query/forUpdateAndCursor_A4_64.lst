$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_QRY_LOCK (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_QRY_LOCK_I ON NGM_QRY_LOCK(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_QRY_LOCK VALUES (1, 'K-101', 1);
1 row inserted.
$T0> INSERT INTO NGM_QRY_LOCK VALUES (11, 'K-111', 2);
