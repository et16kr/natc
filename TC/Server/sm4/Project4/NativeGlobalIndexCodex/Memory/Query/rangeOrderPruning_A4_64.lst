$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Compare Memory native variable range scan results.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGM_QRY_RANGE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_QRY_RANGE
    (
        P INTEGER,
        K VARCHAR(64),
        V INTEGER
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE INDEX NGM_QRY_RANGE_I
        ON NGM_QRY_RANGE(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> INSERT INTO NGM_QRY_RANGE VALUES (1, 'K-030', 30);
1 row inserted.
$T0> INSERT INTO NGM_QRY_RANGE VALUES (5, 'K-010', 10);
1 row inserted.
$T0> INSERT INTO NGM_QRY_RANGE VALUES (11, 'K-040', 40);
1 row inserted.
$T0> INSERT INTO NGM_QRY_RANGE VALUES (15, 'K-020', 20);
1 row inserted.
$T0> INSERT INTO NGM_QRY_RANGE VALUES (21, 'K-060', 60);
1 row inserted.
$T0> INSERT INTO NGM_QRY_RANGE VALUES (25, 'K-050', 50);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
