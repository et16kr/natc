###########################################################################
# TestCase Description = Use Memory native predicates with SELECT FOR UPDATE.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-QRY-007
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NGM_QRY_LOCK;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_QRY_LOCK (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_QRY_LOCK_I ON NGM_QRY_LOCK(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_QRY_LOCK VALUES (1, 'K-101', 1);
    INSERT INTO NGM_QRY_LOCK VALUES (11, 'K-111', 2);
    INSERT INTO NGM_QRY_LOCK VALUES (21, 'K-121', 3);

##################################
SECTOR; TEST
##################################
    AUTOCOMMIT OFF;
    SELECT /*+ INDEX(NGM_QRY_LOCK, NGM_QRY_LOCK_I) */ P, K, V
      FROM NGM_QRY_LOCK
     WHERE K BETWEEN 'K-101' AND 'K-121'
     ORDER BY K
     FOR UPDATE;
    UPDATE NGM_QRY_LOCK SET V = V + 10 WHERE K = 'K-111';
    SELECT P, K, V FROM NGM_QRY_LOCK ORDER BY K;
    ROLLBACK;
    AUTOCOMMIT ON;
    SELECT P, K, V FROM NGM_QRY_LOCK ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ROLLBACK;
    AUTOCOMMIT ON;
    DROP TABLE NGM_QRY_LOCK;
    SKIP END;
}
