$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_QRY_OPT (P INTEGER, GKEY VARCHAR(32), LKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_QRY_OPT_G ON NGM_QRY_OPT(GKEY)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_QRY_OPT_L ON NGM_QRY_OPT(LKEY) LOCAL;
Create success.
$T0> INSERT INTO NGM_QRY_OPT VALUES (1, 'K-101', 1, 10);
1 row inserted.
