$T0> INSERT INTO NGM_QRY_PRED VALUES (22, 6, 'BB', 6);
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRED VALUES (23, 7, 'AB', 3);
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRED VALUES (24, NULL, NULL, NULL);
1 row inserted.

