$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGM_QRY_PRED;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> VAR V_LOW INTEGER;
$T0> VAR V_HIGH INTEGER;
$T0> EXEC :V_LOW := 3;
Execute success.
$T0> EXEC :V_HIGH := 7;
Execute success.

$T0> CREATE TABLE NGM_QRY_PRED
    (
        P INTEGER,
        K INTEGER,
        S VARCHAR(16),
        C INTEGER
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE INDEX NGM_QRY_PRED_K ON NGM_QRY_PRED(K);
Create success.
$T0> CREATE INDEX NGM_QRY_PRED_SC ON NGM_QRY_PRED(S, C DESC);
Create success.

$T0> INSERT INTO NGM_QRY_PRED VALUES (1, 1, 'AA', 1);
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRED VALUES (2, 2, 'AB', 2);
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRED VALUES (11, 3, 'AB', 1);
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRED VALUES (12, 4, 'AC', 4);
1 row inserted.
$T0> INSERT INTO NGM_QRY_PRED VALUES (21, 5, 'BA', 5);
