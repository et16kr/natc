###########################################################################
# TestCase Description = Scan Memory mixed ASC and DESC composite keys.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-QRY-010
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_QRY_DESC;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_QRY_DESC (P INTEGER, K1 VARCHAR(16), K2 INTEGER, K3 INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_QRY_DESC_I ON NGM_QRY_DESC(K1 ASC, K2 DESC, K3 ASC)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_QRY_DESC VALUES (1, 'A', 30, 1);
    INSERT INTO NGM_QRY_DESC VALUES (11, 'A', 20, 2);
    INSERT INTO NGM_QRY_DESC VALUES (21, 'A', 10, 3);
    INSERT INTO NGM_QRY_DESC VALUES (5, 'B', 30, 4);
    INSERT INTO NGM_QRY_DESC VALUES (15, 'B', 20, 5);

##################################
SECTOR; TEST
##################################
    SELECT /*+ INDEX(NGM_QRY_DESC, NGM_QRY_DESC_I) */ P, K1, K2, K3
      FROM NGM_QRY_DESC
     WHERE K1 BETWEEN 'A' AND 'B'
     ORDER BY K1 ASC, K2 DESC, K3 ASC;
    SELECT /*+ FULL SCAN(NGM_QRY_DESC) */ P, K1, K2, K3
      FROM NGM_QRY_DESC
     WHERE K1 BETWEEN 'A' AND 'B'
     ORDER BY K1 ASC, K2 DESC, K3 ASC;
    SELECT P, K1, K2, K3 FROM NGM_QRY_DESC
     WHERE K1 = 'A' AND K2 BETWEEN 10 AND 30
     ORDER BY K2 DESC, K3;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_QRY_DESC;
    SKIP END;
}
