$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_CRT_CON_CHILD;
$T0> DROP TABLE NGM_CRT_CON_PARENT;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_CRT_CON_PARENT (P INTEGER, ID VARCHAR(32), UKEY VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE TABLE NGM_CRT_CON_CHILD (ID INTEGER, PARENT_UKEY VARCHAR(32))
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> ALTER TABLE NGM_CRT_CON_PARENT
        ADD CONSTRAINT NGM_CRT_CON_PK PRIMARY KEY(ID);
Alter success.
$T0> ALTER TABLE NGM_CRT_CON_PARENT
        ADD CONSTRAINT NGM_CRT_CON_UK UNIQUE(UKEY);
Alter success.
$T0> ALTER TABLE NGM_CRT_CON_CHILD
        ADD CONSTRAINT NGM_CRT_CON_FK FOREIGN KEY(PARENT_UKEY)
        REFERENCES NGM_CRT_CON_PARENT(UKEY);
Alter success.
$T0> INSERT INTO NGM_CRT_CON_PARENT VALUES (1, 'ID-101', 'UK-201');
1 row inserted.
$T0> INSERT INTO NGM_CRT_CON_PARENT VALUES (11, 'ID-111', 'UK-211');
1 row inserted.
$T0> INSERT INTO NGM_CRT_CON_CHILD VALUES (1, 'UK-201');
1 row inserted.

