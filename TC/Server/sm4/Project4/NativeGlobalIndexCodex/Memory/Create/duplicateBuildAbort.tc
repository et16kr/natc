###########################################################################
# TestCase Description = Abort duplicate Memory unique builds without publication.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-006
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_DUP;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CRT_DUP (P INTEGER, K VARCHAR(32) NOT NULL, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_CRT_DUP VALUES (1, 'K-100', 1);
    INSERT INTO NGM_CRT_DUP VALUES (11, 'K-100', 2);
    INSERT INTO NGM_CRT_DUP VALUES (21, 'K-200', 3);

##################################
SECTOR; TEST
##################################
    CREATE UNIQUE INDEX NGM_CRT_DUP_U ON NGM_CRT_DUP(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    ALTER TABLE NGM_CRT_DUP
        ADD CONSTRAINT NGM_CRT_DUP_UK UNIQUE(K);
    ALTER TABLE NGM_CRT_DUP
        ADD CONSTRAINT NGM_CRT_DUP_PK PRIMARY KEY(K);

    SELECT COUNT(*) AS PARTIAL_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_CRT_DUP_U', 'NGM_CRT_DUP_UK', 'NGM_CRT_DUP_PK');
    SELECT COUNT(*) AS HIDDEN_TABLE_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_CRT_DUP_%';
    SELECT P, K, V FROM NGM_CRT_DUP ORDER BY P, V;

    DELETE FROM NGM_CRT_DUP WHERE P = 11;
    CREATE UNIQUE INDEX NGM_CRT_DUP_U ON NGM_CRT_DUP(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_CRT_DUP VALUES (11, 'K-300', 4);
    SELECT /*+ INDEX(NGM_CRT_DUP, NGM_CRT_DUP_U) */ P, K, V
      FROM NGM_CRT_DUP ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_DUP;
    SKIP END;
}
