$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_CRT_EMPTY (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE TABLE NGM_CRT_POP (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_CRT_POP VALUES (1, 'K-101');
1 row inserted.
$T0> INSERT INTO NGM_CRT_POP VALUES (11, 'K-111');
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> CREATE INDEX NGM_CRT_EMPTY_I ON NGM_CRT_EMPTY(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_CRT_EMPTY VALUES (1, 'K-201');
1 row inserted.
$T0> INSERT INTO NGM_CRT_EMPTY VALUES (11, 'K-211');
1 row inserted.

$T0> CREATE INDEX NGM_CRT_POP_I ON NGM_CRT_POP(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_CRT_POP VALUES (21, 'K-121');
1 row inserted.
$T0> UPDATE NGM_CRT_POP SET K = 'K-301' WHERE P = 1;
1 row updated.

