###########################################################################
# TestCase Description = Build Memory native PK and UK from table definitions.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-004
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_T_OUT_UK;
    DROP TABLE NGM_CRT_T_OUT_PK;
    DROP TABLE NGM_CRT_T_IN_UK;
    DROP TABLE NGM_CRT_T_IN_PK;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CRT_T_IN_PK
    (
        P INTEGER,
        ID VARCHAR(32) CONSTRAINT NGM_CRT_IN_PK PRIMARY KEY,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;

    CREATE TABLE NGM_CRT_T_IN_UK
    (
        P INTEGER,
        UKEY VARCHAR(32) CONSTRAINT NGM_CRT_IN_UK UNIQUE,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;

    CREATE TABLE NGM_CRT_T_OUT_PK
    (
        P INTEGER,
        K1 VARCHAR(32),
        K2 INTEGER,
        V VARCHAR(16),
        CONSTRAINT NGM_CRT_OUT_PK PRIMARY KEY(K1, K2)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;

    CREATE TABLE NGM_CRT_T_OUT_UK
    (
        P INTEGER,
        K VARCHAR(32),
        V VARCHAR(16),
        CONSTRAINT NGM_CRT_OUT_UK UNIQUE(V)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_CRT_T_IN_PK VALUES (1, 'ID-101', 'A');
    INSERT INTO NGM_CRT_T_IN_PK VALUES (11, 'ID-111', 'B');
    INSERT INTO NGM_CRT_T_IN_UK VALUES (1, 'UK-201', 'A');
    INSERT INTO NGM_CRT_T_IN_UK VALUES (11, 'UK-211', 'B');
    INSERT INTO NGM_CRT_T_OUT_PK VALUES (1, 'K-101', 1, 'X');
    INSERT INTO NGM_CRT_T_OUT_PK VALUES (21, 'K-121', 1, 'Y');
    INSERT INTO NGM_CRT_T_OUT_UK VALUES (1, 'K-101', 'X');
    INSERT INTO NGM_CRT_T_OUT_UK VALUES (21, 'K-121', 'Y');

##################################
SECTOR; TEST
##################################
    SELECT P, ID, V FROM NGM_CRT_T_IN_PK ORDER BY ID;
    SELECT P, UKEY, V FROM NGM_CRT_T_IN_UK ORDER BY UKEY;
    SELECT P, K1, K2, V FROM NGM_CRT_T_OUT_PK ORDER BY K1, K2;
    SELECT P, K, V FROM NGM_CRT_T_OUT_UK ORDER BY V;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID, IS_UNIQUE
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGM_CRT_IN_PK', 'NGM_CRT_IN_UK',
            'NGM_CRT_OUT_PK', 'NGM_CRT_OUT_UK')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_T_OUT_UK;
    DROP TABLE NGM_CRT_T_OUT_PK;
    DROP TABLE NGM_CRT_T_IN_UK;
    DROP TABLE NGM_CRT_T_IN_PK;
    SKIP END;
}
