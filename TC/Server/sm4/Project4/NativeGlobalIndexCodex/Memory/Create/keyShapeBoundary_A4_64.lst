1 row inserted.
$T0> INSERT INTO NGM_CRT_SHAPE VALUES (21, 'B', NULL, 3, 30);
1 row inserted.
$T0> INSERT INTO NGM_CRT_SHAPE VALUES (25, NULL, NULL, NULL, 40);
