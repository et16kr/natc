$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_CRT_SHAPE
    (P INTEGER, CKEY CHAR(8), VKEY VARCHAR(512), NKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_CRT_SHAPE_I
        ON NGM_CRT_SHAPE(CKEY ASC, VKEY DESC, NKEY ASC)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_CRT_SHAPE VALUES (1, 'A', RPAD('A', 400, 'A'), 1, 10);
1 row inserted.
