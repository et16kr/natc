$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Create Memory global indexes on range/list/hash tables.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_CRT_RANGE;
$T0> DROP TABLE NGM_CRT_LIST;
$T0> DROP TABLE NGM_CRT_HASH;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_CRT_RANGE (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_CRT_LIST (P INTEGER, K INTEGER)
    PARTITION BY LIST(P)
    (
        PARTITION P1 VALUES (1, 4),
        PARTITION P2 VALUES (2, 5),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_CRT_HASH (P INTEGER, K INTEGER)
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE INDEX NGM_CRT_RANGE_I
        ON NGM_CRT_RANGE(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_CRT_LIST_I
        ON NGM_CRT_LIST(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_CRT_HASH_I
        ON NGM_CRT_HASH(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> INSERT INTO NGM_CRT_RANGE VALUES (1, 101);
1 row inserted.
$T0> INSERT INTO NGM_CRT_RANGE VALUES (11, 111);
1 row inserted.
$T0> INSERT INTO NGM_CRT_RANGE VALUES (21, 121);
1 row inserted.
