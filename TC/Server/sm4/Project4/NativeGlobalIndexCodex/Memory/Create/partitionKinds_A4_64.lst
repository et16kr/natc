1 row inserted.
$T0> INSERT INTO NGM_CRT_LIST VALUES (2, 202);
1 row inserted.
$T0> INSERT INTO NGM_CRT_LIST VALUES (3, 203);
1 row inserted.
$T0> INSERT INTO NGM_CRT_HASH VALUES (1, 301);
1 row inserted.
$T0> INSERT INTO NGM_CRT_HASH VALUES (2, 302);
1 row inserted.
$T0> INSERT INTO NGM_CRT_HASH VALUES (3, 303);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT 'HASH' AS PART_KIND, P, K
      FROM NGM_CRT_HASH
    UNION ALL
    SELECT 'LIST' AS PART_KIND, P, K
      FROM NGM_CRT_LIST
    UNION ALL
    SELECT 'RANGE' AS PART_KIND, P, K
      FROM NGM_CRT_RANGE
     ORDER BY PART_KIND, P, K;
