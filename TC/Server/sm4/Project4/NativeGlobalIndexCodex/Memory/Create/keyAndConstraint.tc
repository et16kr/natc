###########################################################################
# TestCase Description = Create Memory native indexes for variable keys.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_KEY;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CRT_KEY
    (
        P INTEGER,
        ID INTEGER NOT NULL,
        UKEY VARCHAR(64),
        CKEY CHAR(8),
        VKEY VARCHAR(128)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    ALTER TABLE NGM_CRT_KEY
        ADD CONSTRAINT NGM_CRT_KEY_PK PRIMARY KEY(ID);

    ALTER TABLE NGM_CRT_KEY
        ADD CONSTRAINT NGM_CRT_KEY_UK UNIQUE(UKEY);

    CREATE INDEX NGM_CRT_KEY_I
        ON NGM_CRT_KEY(CKEY ASC, VKEY DESC)
        TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_CRT_KEY
        VALUES (1, 1, 'U-ALPHA', 'A', 'ALPHA-ALPHA-ALPHA');
    INSERT INTO NGM_CRT_KEY
        VALUES (11, 2, 'U-BETA', 'B', 'BETA-BETA-BETA');
    INSERT INTO NGM_CRT_KEY
        VALUES (21, 3, NULL, 'C', NULL);

##################################
SECTOR; TEST
##################################
    SELECT P, ID, UKEY, CKEY, VKEY
      FROM NGM_CRT_KEY
     ORDER BY CKEY, VKEY DESC, ID;

    SELECT INDEX_NAME,
           INDEX_IMPL_TYPE,
           INDEX_TABLE_ID,
           IS_UNIQUE
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGM_CRT_KEY_PK', 'NGM_CRT_KEY_UK', 'NGM_CRT_KEY_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_KEY;
    SKIP END;
}

