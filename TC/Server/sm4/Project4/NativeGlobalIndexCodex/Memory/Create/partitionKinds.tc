###########################################################################
# TestCase Description = Create Memory global indexes on range/list/hash tables.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_RANGE;
    DROP TABLE NGM_CRT_LIST;
    DROP TABLE NGM_CRT_HASH;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CRT_RANGE (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE TABLE NGM_CRT_LIST (P INTEGER, K INTEGER)
    PARTITION BY LIST(P)
    (
        PARTITION P1 VALUES (1, 4),
        PARTITION P2 VALUES (2, 5),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE TABLE NGM_CRT_HASH (P INTEGER, K INTEGER)
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_CRT_RANGE_I
        ON NGM_CRT_RANGE(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_CRT_LIST_I
        ON NGM_CRT_LIST(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_CRT_HASH_I
        ON NGM_CRT_HASH(K)
        TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_CRT_RANGE VALUES (1, 101);
    INSERT INTO NGM_CRT_RANGE VALUES (11, 111);
    INSERT INTO NGM_CRT_RANGE VALUES (21, 121);
    INSERT INTO NGM_CRT_LIST VALUES (1, 201);
    INSERT INTO NGM_CRT_LIST VALUES (2, 202);
    INSERT INTO NGM_CRT_LIST VALUES (3, 203);
    INSERT INTO NGM_CRT_HASH VALUES (1, 301);
    INSERT INTO NGM_CRT_HASH VALUES (2, 302);
    INSERT INTO NGM_CRT_HASH VALUES (3, 303);

##################################
SECTOR; TEST
##################################
    SELECT 'HASH' AS PART_KIND, P, K
      FROM NGM_CRT_HASH
    UNION ALL
    SELECT 'LIST' AS PART_KIND, P, K
      FROM NGM_CRT_LIST
    UNION ALL
    SELECT 'RANGE' AS PART_KIND, P, K
      FROM NGM_CRT_RANGE
     ORDER BY PART_KIND, P, K;

    SELECT INDEX_NAME, INDEX_IMPL_TYPE
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGM_CRT_RANGE_I', 'NGM_CRT_LIST_I', 'NGM_CRT_HASH_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_RANGE;
    DROP TABLE NGM_CRT_LIST;
    DROP TABLE NGM_CRT_HASH;
    SKIP END;
}

