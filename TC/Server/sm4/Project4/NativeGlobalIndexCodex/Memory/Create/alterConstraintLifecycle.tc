###########################################################################
# TestCase Description = Maintain Memory PK, UK, and FK constraint lifecycles.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-005
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_CON_CHILD;
    DROP TABLE NGM_CRT_CON_PARENT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CRT_CON_PARENT (P INTEGER, ID VARCHAR(32), UKEY VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE TABLE NGM_CRT_CON_CHILD (ID INTEGER, PARENT_UKEY VARCHAR(32))
        TABLESPACE SYS_TBS_MEM_DATA;
    ALTER TABLE NGM_CRT_CON_PARENT
        ADD CONSTRAINT NGM_CRT_CON_PK PRIMARY KEY(ID);
    ALTER TABLE NGM_CRT_CON_PARENT
        ADD CONSTRAINT NGM_CRT_CON_UK UNIQUE(UKEY);
    ALTER TABLE NGM_CRT_CON_CHILD
        ADD CONSTRAINT NGM_CRT_CON_FK FOREIGN KEY(PARENT_UKEY)
        REFERENCES NGM_CRT_CON_PARENT(UKEY);
    INSERT INTO NGM_CRT_CON_PARENT VALUES (1, 'ID-101', 'UK-201');
    INSERT INTO NGM_CRT_CON_PARENT VALUES (11, 'ID-111', 'UK-211');
    INSERT INTO NGM_CRT_CON_CHILD VALUES (1, 'UK-201');

##################################
SECTOR; TEST
##################################
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_CRT_CON_PK', 'NGM_CRT_CON_UK')
     ORDER BY INDEX_NAME;

    ALTER TABLE NGM_CRT_CON_PARENT DROP CONSTRAINT NGM_CRT_CON_UK;
    SELECT P, ID, UKEY FROM NGM_CRT_CON_PARENT ORDER BY ID;

    ALTER TABLE NGM_CRT_CON_CHILD DROP CONSTRAINT NGM_CRT_CON_FK;
    ALTER TABLE NGM_CRT_CON_PARENT DROP CONSTRAINT NGM_CRT_CON_UK;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_CRT_CON_%'
     ORDER BY INDEX_NAME;

    ALTER TABLE NGM_CRT_CON_PARENT
        ADD CONSTRAINT NGM_CRT_CON_UK UNIQUE(UKEY);
    ALTER TABLE NGM_CRT_CON_CHILD
        ADD CONSTRAINT NGM_CRT_CON_FK FOREIGN KEY(PARENT_UKEY)
        REFERENCES NGM_CRT_CON_PARENT(UKEY);
    SELECT C.ID, C.PARENT_UKEY, P.P
      FROM NGM_CRT_CON_CHILD C JOIN NGM_CRT_CON_PARENT P
        ON C.PARENT_UKEY = P.UKEY
     ORDER BY C.ID;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_CON_CHILD;
    DROP TABLE NGM_CRT_CON_PARENT;
    SKIP END;
}
