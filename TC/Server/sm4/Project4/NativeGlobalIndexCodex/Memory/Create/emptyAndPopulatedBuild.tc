###########################################################################
# TestCase Description = Build Memory native indexes on empty and populated tables.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-007
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_POP;
    DROP TABLE NGM_CRT_EMPTY;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CRT_EMPTY (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_MEM_DATA;
    CREATE TABLE NGM_CRT_POP (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_CRT_POP VALUES (1, 'K-101');
    INSERT INTO NGM_CRT_POP VALUES (11, 'K-111');

##################################
SECTOR; TEST
##################################
    CREATE INDEX NGM_CRT_EMPTY_I ON NGM_CRT_EMPTY(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_CRT_EMPTY VALUES (1, 'K-201');
    INSERT INTO NGM_CRT_EMPTY VALUES (11, 'K-211');

    CREATE INDEX NGM_CRT_POP_I ON NGM_CRT_POP(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_CRT_POP VALUES (21, 'K-121');
    UPDATE NGM_CRT_POP SET K = 'K-301' WHERE P = 1;

    SELECT /*+ INDEX(NGM_CRT_EMPTY, NGM_CRT_EMPTY_I) */ P, K
      FROM NGM_CRT_EMPTY ORDER BY K;
    SELECT /*+ INDEX(NGM_CRT_POP, NGM_CRT_POP_I) */ P, K
      FROM NGM_CRT_POP ORDER BY K;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_CRT_EMPTY_I', 'NGM_CRT_POP_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CRT_POP;
    DROP TABLE NGM_CRT_EMPTY;
    SKIP END;
}
