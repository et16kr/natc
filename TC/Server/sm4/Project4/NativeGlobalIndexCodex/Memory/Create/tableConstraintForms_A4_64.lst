$T0> CREATE TABLE NGM_CRT_T_IN_PK
    (
        P INTEGER,
        ID VARCHAR(32) CONSTRAINT NGM_CRT_IN_PK PRIMARY KEY,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_CRT_T_IN_UK
    (
        P INTEGER,
        UKEY VARCHAR(32) CONSTRAINT NGM_CRT_IN_UK UNIQUE,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_CRT_T_OUT_PK
    (
        P INTEGER,
        K1 VARCHAR(32),
        K2 INTEGER,
        V VARCHAR(16),
        CONSTRAINT NGM_CRT_OUT_PK PRIMARY KEY(K1, K2)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE TABLE NGM_CRT_T_OUT_UK
    (
        P INTEGER,
        K VARCHAR(32),
        V VARCHAR(16),
        CONSTRAINT NGM_CRT_OUT_UK UNIQUE(V)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.

