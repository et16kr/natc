###########################################################################
# TestCase Description = Reject Memory media and unsupported index options.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_OPTION;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_NEG_OPTION (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_NEG_OPTION VALUES (1, 'K-101');
    INSERT INTO NGM_NEG_OPTION VALUES (11, 'K-111');
    INSERT INTO NGM_NEG_OPTION VALUES (21, 'K-121');

##################################
SECTOR; TEST
##################################
    CREATE INDEX NGM_NEG_OPTION_DISK
        ON NGM_NEG_OPTION(K)
        TABLESPACE SYS_TBS_DISK_DATA;

    CREATE INDEX NGM_NEG_OPTION_PAR
        ON NGM_NEG_OPTION(K)
        PARALLEL 2;

    CREATE INDEX NGM_NEG_OPTION_OK
        ON NGM_NEG_OPTION(K)
        TABLESPACE SYS_TBS_MEM_DATA;

    ALTER INDEX NGM_NEG_OPTION_OK DISABLE;

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_OPTION_%'
     ORDER BY INDEX_NAME;

    SELECT /*+ INDEX(NGM_NEG_OPTION, NGM_NEG_OPTION_OK) */ P, K
      FROM NGM_NEG_OPTION
     ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_OPTION;
    SKIP END;
}

