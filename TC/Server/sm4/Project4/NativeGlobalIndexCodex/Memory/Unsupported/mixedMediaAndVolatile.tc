###########################################################################
# TestCase Description = Reject mixed-media and volatile Memory global indexes.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-008
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_VOL;
    DROP TABLE NGM_NEG_MIX;
    DROP TABLE NGM_NEG_MEDIA;
    DROP TABLESPACE NGM_NEG_VOL_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_NEG_MEDIA (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_NEG_MEDIA_OK ON NGM_NEG_MEDIA(K);
    INSERT INTO NGM_NEG_MEDIA VALUES (1, 'K-101', 201);
    INSERT INTO NGM_NEG_MEDIA VALUES (11, 'K-111', 211);

    CREATE TABLE NGM_NEG_MIX (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10) TABLESPACE SYS_TBS_MEM_DATA,
        PARTITION P2 VALUES LESS THAN (20) TABLESPACE SYS_TBS_DISK_DATA,
        PARTITION PD VALUES DEFAULT TABLESPACE SYS_TBS_MEM_DATA
    ) TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_NEG_MIX VALUES (1, 'K-301');
    INSERT INTO NGM_NEG_MIX VALUES (11, 'K-311');

    CREATE VOLATILE DATA TABLESPACE NGM_NEG_VOL_TS SIZE 32M AUTOEXTEND ON;
    CREATE TABLE NGM_NEG_VOL (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE NGM_NEG_VOL_TS;
    INSERT INTO NGM_NEG_VOL VALUES (1, 'K-401');

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_NEG_MEDIA_OK', 'NGM_NEG_MIX_I', 'NGM_NEG_VOL_I');

    CREATE INDEX NGM_NEG_MIX_I ON NGM_NEG_MIX(K);
    CREATE INDEX NGM_NEG_VOL_I ON NGM_NEG_VOL(K);

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_NEG_MEDIA_OK', 'NGM_NEG_MIX_I', 'NGM_NEG_VOL_I');
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_NEG_MEDIA_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND (TABLE_NAME LIKE '$GIT_NGM_NEG_MIX_%'
            OR TABLE_NAME LIKE '$GIT_NGM_NEG_VOL_%');
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGM_NEG_MIX_%'
            OR INDEX_NAME LIKE '$GIR_NGM_NEG_MIX_%'
            OR INDEX_NAME LIKE '$GIK_NGM_NEG_VOL_%'
            OR INDEX_NAME LIKE '$GIR_NGM_NEG_VOL_%');
    SELECT /*+ INDEX(NGM_NEG_MEDIA, NGM_NEG_MEDIA_OK) */ P, K, V
      FROM NGM_NEG_MEDIA ORDER BY K;
    INSERT INTO NGM_NEG_MEDIA VALUES (21, 'K-121', 221);
    SELECT /*+ INDEX(NGM_NEG_MEDIA, NGM_NEG_MEDIA_OK) */ P, K, V
      FROM NGM_NEG_MEDIA ORDER BY K;

    CREATE INDEX NGM_NEG_MIX_I ON NGM_NEG_MEDIA(V);
    CREATE INDEX NGM_NEG_VOL_I ON NGM_NEG_MEDIA(P);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_NEG_MEDIA_OK', 'NGM_NEG_MIX_I', 'NGM_NEG_VOL_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_VOL;
    DROP TABLE NGM_NEG_MIX;
    DROP TABLE NGM_NEG_MEDIA;
    DROP TABLESPACE NGM_NEG_VOL_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
