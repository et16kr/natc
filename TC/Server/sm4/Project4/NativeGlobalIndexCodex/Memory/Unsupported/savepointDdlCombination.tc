###########################################################################
# TestCase Description = Reject Memory native DDL across a savepoint.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-010
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NGM_NEG_SPDDL;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_NEG_SPDDL (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_NEG_SPDDL_OK ON NGM_NEG_SPDDL(K);
    INSERT INTO NGM_NEG_SPDDL VALUES (1, 'K-101', 201);
    INSERT INTO NGM_NEG_SPDDL VALUES (11, 'K-111', 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_SPDDL_%';

    AUTOCOMMIT OFF;
    INSERT INTO NGM_NEG_SPDDL VALUES (21, 'K-121', 221);
    SAVEPOINT NGM_NEG_SP;
    CREATE INDEX NGM_NEG_SPDDL_TRY ON NGM_NEG_SPDDL(V);
    ROLLBACK TO SAVEPOINT NGM_NEG_SP;
    DROP INDEX NGM_NEG_SPDDL_OK;
    ROLLBACK TO SAVEPOINT NGM_NEG_SP;
    UPDATE NGM_NEG_SPDDL SET K = 'K-122' WHERE P = 21;
    ROLLBACK;
    AUTOCOMMIT ON;

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_SPDDL_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_NEG_SPDDL_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_NEG_SPDDL_%';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGM_NEG_SPDDL_%'
            OR INDEX_NAME LIKE '$GIR_NGM_NEG_SPDDL_%');
    SELECT /*+ INDEX(NGM_NEG_SPDDL, NGM_NEG_SPDDL_OK) */ P, K, V
      FROM NGM_NEG_SPDDL ORDER BY K;
    INSERT INTO NGM_NEG_SPDDL VALUES (21, 'K-121', 221);
    SELECT /*+ INDEX(NGM_NEG_SPDDL, NGM_NEG_SPDDL_OK) */ P, K, V
      FROM NGM_NEG_SPDDL ORDER BY K;

    CREATE INDEX NGM_NEG_SPDDL_TRY ON NGM_NEG_SPDDL(V);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_SPDDL_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ROLLBACK;
    AUTOCOMMIT ON;
    DROP TABLE NGM_NEG_SPDDL;
    SKIP END;
}
