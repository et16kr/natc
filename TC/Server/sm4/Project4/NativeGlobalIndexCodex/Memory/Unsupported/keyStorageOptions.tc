###########################################################################
# TestCase Description = Reject unsupported key storage options for a Memory native index.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-005
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_KEYOPT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_NEG_KEYOPT (P INTEGER, K VARCHAR(64), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_NEG_KEYOPT_OK ON NGM_NEG_KEYOPT(K);
    INSERT INTO NGM_NEG_KEYOPT VALUES (1, 'K-101', 201);
    INSERT INTO NGM_NEG_KEYOPT VALUES (11, 'K-111', 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_KEYOPT_%';

    CREATE INDEX NGM_NEG_KEYOPT_DKEY ON NGM_NEG_KEYOPT(V) DIRECTKEY;
    CREATE INDEX NGM_NEG_KEYOPT_PERS ON NGM_NEG_KEYOPT(V) SET PERSISTENT = ON;

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_KEYOPT_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_NEG_KEYOPT_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_NEG_KEYOPT_%';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGM_NEG_KEYOPT_%'
            OR INDEX_NAME LIKE '$GIR_NGM_NEG_KEYOPT_%');
    SELECT /*+ INDEX(NGM_NEG_KEYOPT, NGM_NEG_KEYOPT_OK) */ P, K, V
      FROM NGM_NEG_KEYOPT ORDER BY K;
    UPDATE NGM_NEG_KEYOPT SET K = 'K-121' WHERE P = 11;
    SELECT /*+ INDEX(NGM_NEG_KEYOPT, NGM_NEG_KEYOPT_OK) */ P, K, V
      FROM NGM_NEG_KEYOPT ORDER BY K;

    CREATE INDEX NGM_NEG_KEYOPT_DKEY ON NGM_NEG_KEYOPT(V);
    CREATE INDEX NGM_NEG_KEYOPT_PERS ON NGM_NEG_KEYOPT(P);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_KEYOPT_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_KEYOPT;
    SKIP END;
}
