###########################################################################
# TestCase Description = Reject Memory partition topology and reset DDL.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_PART;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_NEG_PART (P INTEGER, K VARCHAR(32))
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_NEG_PART_I
        ON NGM_NEG_PART(K)
        TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_NEG_PART VALUES (1, 'K-101');
    INSERT INTO NGM_NEG_PART VALUES (2, 'K-102');
    INSERT INTO NGM_NEG_PART VALUES (3, 'K-103');

##################################
SECTOR; TEST
##################################
    ALTER TABLE NGM_NEG_PART ADD PARTITION P4;
    ALTER TABLE NGM_NEG_PART COALESCE PARTITION;
    ALTER TABLE NGM_NEG_PART TRUNCATE PARTITION P1;
    ALTER TABLE NGM_NEG_PART DROP PARTITION P1;

    SELECT P, K FROM NGM_NEG_PART ORDER BY K;

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_NEG_PART_I';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_PART;
    SKIP END;
}

