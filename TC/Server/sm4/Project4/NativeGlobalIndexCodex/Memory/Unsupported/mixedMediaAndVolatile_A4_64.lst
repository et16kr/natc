$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_NEG_VOL;
$T0> DROP TABLE NGM_NEG_MIX;
$T0> DROP TABLE NGM_NEG_MEDIA;
$T0> DROP TABLESPACE NGM_NEG_VOL_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_NEG_MEDIA (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_NEG_MEDIA_OK ON NGM_NEG_MEDIA(K);
Create success.
$T0> INSERT INTO NGM_NEG_MEDIA VALUES (1, 'K-101', 201);
1 row inserted.
$T0> INSERT INTO NGM_NEG_MEDIA VALUES (11, 'K-111', 211);
1 row inserted.

$T0> CREATE TABLE NGM_NEG_MIX (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10) TABLESPACE SYS_TBS_MEM_DATA,
        PARTITION P2 VALUES LESS THAN (20) TABLESPACE SYS_TBS_DISK_DATA,
        PARTITION PD VALUES DEFAULT TABLESPACE SYS_TBS_MEM_DATA
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_NEG_MIX VALUES (1, 'K-301');
1 row inserted.
$T0> INSERT INTO NGM_NEG_MIX VALUES (11, 'K-311');
1 row inserted.

$T0> CREATE VOLATILE DATA TABLESPACE NGM_NEG_VOL_TS SIZE 32M AUTOEXTEND ON;
Create success.
$T0> CREATE TABLE NGM_NEG_VOL (P INTEGER, K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE NGM_NEG_VOL_TS;
Create success.
$T0> INSERT INTO NGM_NEG_VOL VALUES (1, 'K-401');
1 row inserted.

