$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_NEG_KEYOPT;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_NEG_KEYOPT (P INTEGER, K VARCHAR(64), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_NEG_KEYOPT_OK ON NGM_NEG_KEYOPT(K);
Create success.
$T0> INSERT INTO NGM_NEG_KEYOPT VALUES (1, 'K-101', 201);
1 row inserted.
$T0> INSERT INTO NGM_NEG_KEYOPT VALUES (11, 'K-111', 211);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
