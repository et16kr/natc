###########################################################################
# TestCase Description = Reject unsupported Memory native index build modes.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-006
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_MODE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_NEG_MODE (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_NEG_MODE_OK ON NGM_NEG_MODE(K);
    INSERT INTO NGM_NEG_MODE VALUES (1, 'K-101', 201);
    INSERT INTO NGM_NEG_MODE VALUES (11, 'K-111', 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_MODE_%';

    CREATE INDEX NGM_NEG_MODE_TRY ON NGM_NEG_MODE(V) NOLOGGING FORCE;
    CREATE INDEX NGM_NEG_MODE_TRY ON NGM_NEG_MODE(V) NOLOGGING NOFORCE;
    CREATE INDEX NGM_NEG_MODE_TRY ON NGM_NEG_MODE(V) PARALLEL 2;

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_MODE_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_NEG_MODE_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_NEG_MODE_%';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGM_NEG_MODE_%'
            OR INDEX_NAME LIKE '$GIR_NGM_NEG_MODE_%');
    SELECT /*+ INDEX(NGM_NEG_MODE, NGM_NEG_MODE_OK) */ P, K, V
      FROM NGM_NEG_MODE ORDER BY K;
    DELETE FROM NGM_NEG_MODE WHERE P = 1;
    INSERT INTO NGM_NEG_MODE VALUES (21, 'K-121', 221);
    SELECT /*+ INDEX(NGM_NEG_MODE, NGM_NEG_MODE_OK) */ P, K, V
      FROM NGM_NEG_MODE ORDER BY K;

    CREATE INDEX NGM_NEG_MODE_TRY ON NGM_NEG_MODE(V);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_MODE_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_NEG_MODE;
    SKIP END;
}
