$T0> ###########################################################################
$T0> # TestCase Description = Reject unsupported index types for a Memory native global index.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Test ID              = NGI-NEG-004
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGM_NEG_TYPE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_NEG_TYPE (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_NEG_TYPE_OK ON NGM_NEG_TYPE(K) INDEXTYPE IS BTREE;
Create success.
$T0> INSERT INTO NGM_NEG_TYPE VALUES (1, 'K-101', 201);
1 row inserted.
$T0> INSERT INTO NGM_NEG_TYPE VALUES (11, 'K-111', 211);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_NEG_TYPE_%';
BEFORE_INDEX_COUNT   
-----------------------
1                    
1 row selected.

$T0> CREATE INDEX NGM_NEG_TYPE_TRY ON NGM_NEG_TYPE(V) INDEXTYPE IS RTREE;
[ERR-31237 : cannot create index in the data type.]
$T0> CREATE INDEX NGM_NEG_TYPE_TRY ON NGM_NEG_TYPE(V) INDEXTYPE IS TDRTREE;
[ERR-11059 : Index type name not found]

$T0> SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
