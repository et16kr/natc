###########################################################################
# TestCase Description = Verify native Memory implementation catalog identity.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CAT_TYPE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CAT_TYPE
    (
        P INTEGER,
        K INTEGER,
        V VARCHAR(32)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_CAT_TYPE_I
        ON NGM_CAT_TYPE(K)
        TABLESPACE SYS_TBS_MEM_DATA;

##################################
SECTOR; TEST
##################################
    SELECT I.INDEX_NAME,
           I.INDEX_IMPL_TYPE,
           I.INDEX_TABLE_ID,
           I.IS_PARTITIONED
      FROM SYSTEM_.SYS_TABLES_ T,
           SYSTEM_.SYS_INDICES_ I
     WHERE T.TABLE_NAME = 'NGM_CAT_TYPE'
       AND T.USER_ID = USER_ID()
       AND I.TABLE_ID = T.TABLE_ID
     ORDER BY I.INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CAT_TYPE;
    SKIP END;
}
