###########################################################################
# TestCase Description = Verify native Memory index creates no hidden objects.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CAT_HIDDEN;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_CAT_HIDDEN
    (
        P INTEGER,
        K INTEGER
    )
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_CAT_HIDDEN_I
        ON NGM_CAT_HIDDEN(K)
        TABLESPACE SYS_TBS_MEM_DATA;

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS HIDDEN_TABLE_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_CAT_HIDDEN_I%';

    SELECT COUNT(*) AS HIDDEN_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGM_CAT_HIDDEN_I%'
            OR INDEX_NAME LIKE '$GIR_NGM_CAT_HIDDEN_I%');

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_CAT_HIDDEN_I';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_CAT_HIDDEN;
    SKIP END;
}

