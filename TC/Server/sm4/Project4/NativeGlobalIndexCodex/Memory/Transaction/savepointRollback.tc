###########################################################################
# TestCase Description = Roll back Memory DML and row movement to a savepoint.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-TRX-002
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NGM_TRX_SAVE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_TRX_SAVE (P INTEGER, K VARCHAR(32), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_TRX_SAVE_I ON NGM_TRX_SAVE(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_TRX_SAVE VALUES (1, 'K-101', 1);
    INSERT INTO NGM_TRX_SAVE VALUES (11, 'K-111', 2);
    INSERT INTO NGM_TRX_SAVE VALUES (21, 'K-121', 3);

##################################
SECTOR; TEST
##################################
    AUTOCOMMIT OFF;
    SAVEPOINT NGM_SP1;
    INSERT INTO NGM_TRX_SAVE VALUES (5, 'K-105', 4);
    UPDATE NGM_TRX_SAVE SET P = 25, K = 'K-201' WHERE K = 'K-101';
    DELETE FROM NGM_TRX_SAVE WHERE K = 'K-111';
    SELECT P, K, V FROM NGM_TRX_SAVE ORDER BY K;

    ROLLBACK TO SAVEPOINT NGM_SP1;
    SELECT /*+ INDEX(NGM_TRX_SAVE, NGM_TRX_SAVE_I) */ P, K, V
      FROM NGM_TRX_SAVE
     ORDER BY K;
    SELECT /*+ FULL SCAN(NGM_TRX_SAVE) */ P, K, V
      FROM NGM_TRX_SAVE
     ORDER BY K;
    COMMIT;
    AUTOCOMMIT ON;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ROLLBACK;
    AUTOCOMMIT ON;
    DROP TABLE NGM_TRX_SAVE;
    SKIP END;
}
