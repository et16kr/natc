###########################################################################
# TestCase Description = Reject Memory native DDL during an active transaction.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-TRX-004
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NGM_TRX_DDL;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_TRX_DDL (P INTEGER, K1 VARCHAR(32), K2 VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_TRX_DDL_I ON NGM_TRX_DDL(K1)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_TRX_DDL VALUES (1, 'K-101', 'V-201');
    INSERT INTO NGM_TRX_DDL VALUES (11, 'K-111', 'V-211');

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_TRX_DDL_%';

    AUTOCOMMIT OFF;
    INSERT INTO NGM_TRX_DDL VALUES (21, 'K-121', 'V-221');
    CREATE INDEX NGM_TRX_DDL_NEW ON NGM_TRX_DDL(K2)
        TABLESPACE SYS_TBS_MEM_DATA;
    SELECT P, K1, K2 FROM NGM_TRX_DDL ORDER BY K1;
    ROLLBACK;
    AUTOCOMMIT ON;

    SELECT COUNT(*) AS AFTER_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_TRX_DDL_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_TRX_DDL_I';
    SELECT P, K1, K2 FROM NGM_TRX_DDL ORDER BY K1;

    CREATE INDEX NGM_TRX_DDL_NEW ON NGM_TRX_DDL(K2)
        TABLESPACE SYS_TBS_MEM_DATA;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_TRX_DDL_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ROLLBACK;
    AUTOCOMMIT ON;
    DROP TABLE NGM_TRX_DDL;
    SKIP END;
}
