$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_TRX_ALL (P INTEGER, K1 VARCHAR(32), K2 INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGM_TRX_ALL_U ON NGM_TRX_ALL(K1)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_TRX_ALL_I ON NGM_TRX_ALL(K2 DESC)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
