$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> DROP TABLE NGM_TRX_DDL;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_TRX_DDL (P INTEGER, K1 VARCHAR(32), K2 VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_TRX_DDL_I ON NGM_TRX_DDL(K1)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> INSERT INTO NGM_TRX_DDL VALUES (1, 'K-101', 'V-201');
1 row inserted.
$T0> INSERT INTO NGM_TRX_DDL VALUES (11, 'K-111', 'V-211');
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_TRX_DDL_%';
