###########################################################################
# TestCase Description = Preserve a Memory index across column changes.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_SCHEMA;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DDL_SCHEMA
    (
        P INTEGER,
        K VARCHAR(16),
        V INTEGER,
        SPARE INTEGER
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_DDL_SCHEMA_I ON NGM_DDL_SCHEMA(K, V DESC);

    INSERT INTO NGM_DDL_SCHEMA VALUES (1, 'K-101', 1, 1001);
    INSERT INTO NGM_DDL_SCHEMA VALUES (11, 'K-111', 2, 1011);
    INSERT INTO NGM_DDL_SCHEMA VALUES (21, 'K-121', 3, 1021);

##################################
SECTOR; TEST
##################################
    ALTER TABLE NGM_DDL_SCHEMA ADD COLUMN (NOTE VARCHAR(16));
    UPDATE NGM_DDL_SCHEMA SET NOTE = 'ADDED';

    ALTER TABLE NGM_DDL_SCHEMA RENAME COLUMN K TO K_NEW;
    ALTER TABLE NGM_DDL_SCHEMA DROP COLUMN (SPARE);

    SELECT /*+ INDEX(NGM_DDL_SCHEMA, NGM_DDL_SCHEMA_I) */
           P, K_NEW, V, NOTE
      FROM NGM_DDL_SCHEMA
     WHERE K_NEW BETWEEN 'K-100' AND 'K-120'
     ORDER BY K_NEW, V DESC;

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGM_DDL_SCHEMA_I';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_SCHEMA;
    SKIP END;
}

