1 row selected.

$T0> ALTER TABLE NGM_DDL_FK_CHILD DROP CONSTRAINT NGM_DDL_FK_C;
Alter success.
$T0> ALTER TABLE NGM_DDL_FK_PARENT DROP CONSTRAINT NGM_DDL_FK_UK;
Alter success.
$T0> SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
