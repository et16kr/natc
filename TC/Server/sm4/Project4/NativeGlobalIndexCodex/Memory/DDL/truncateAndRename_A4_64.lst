$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DDL_TRUNC (P INTEGER, K VARCHAR(16), V VARCHAR(16))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> CREATE UNIQUE INDEX NGM_DDL_TRUNC_OLD ON NGM_DDL_TRUNC(K);
Create success.
$T0> CREATE INDEX NGM_DDL_TRUNC_LOCAL ON NGM_DDL_TRUNC(P) LOCAL;
Create success.

