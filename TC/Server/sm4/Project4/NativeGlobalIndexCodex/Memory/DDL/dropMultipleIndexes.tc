###########################################################################
# TestCase Description = Drop several Memory native indexes and cascade the table.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DDL-009
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_DROP_MANY;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DDL_DROP_MANY
    (P INTEGER, K1 VARCHAR(16), K2 VARCHAR(16), K3 VARCHAR(16))
    PARTITION BY HASH(P)
    (PARTITION P1, PARTITION P2, PARTITION P3)
    TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_DDL_DROP_I1 ON NGM_DDL_DROP_MANY(K1) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_DDL_DROP_I2 ON NGM_DDL_DROP_MANY(K2) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_DDL_DROP_I3 ON NGM_DDL_DROP_MANY(K3) TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_DDL_DROP_MANY VALUES (1, 'A-101', 'B-201', 'C-301');
    INSERT INTO NGM_DDL_DROP_MANY VALUES (2, 'A-102', 'B-202', 'C-302');

##################################
SECTOR; TEST
##################################
    DROP INDEX NGM_DDL_DROP_I1;
    DROP INDEX NGM_DDL_DROP_I2;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_DDL_DROP_I%'
     ORDER BY INDEX_NAME;
    SELECT /*+ INDEX(NGM_DDL_DROP_MANY, NGM_DDL_DROP_I3) */ P, K1, K2, K3
      FROM NGM_DDL_DROP_MANY ORDER BY K3;
    DROP TABLE NGM_DDL_DROP_MANY;
    SELECT COUNT(*) AS REMAINING_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_DDL_DROP_I%';
    SELECT COUNT(*) AS HIDDEN_TABLE_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGM_DDL_DROP_I%';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_DROP_MANY;
    SKIP END;
}
