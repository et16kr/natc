$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DDL_REBUILD (P INTEGER, K VARCHAR(64), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_MEM_DATA;
Create success.

$T0> INSERT INTO NGM_DDL_REBUILD VALUES (1, 'K-101', 1);
1 row inserted.
$T0> INSERT INTO NGM_DDL_REBUILD VALUES (11, 'K-111', 2);
1 row inserted.
$T0> INSERT INTO NGM_DDL_REBUILD VALUES (21, 'K-121', 3);
1 row inserted.

$T0> CREATE INDEX NGM_DDL_REBUILD_I
        ON NGM_DDL_REBUILD(K)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.

