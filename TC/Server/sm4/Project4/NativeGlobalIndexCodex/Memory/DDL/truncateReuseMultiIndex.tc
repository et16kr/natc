###########################################################################
# TestCase Description = Reuse several Memory native indexes after TRUNCATE.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DDL-010
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_TRUNC_M;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DDL_TRUNC_M
    (P INTEGER, K1 VARCHAR(16), K2 VARCHAR(16), K3 VARCHAR(16))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    CREATE UNIQUE INDEX NGM_DDL_TRUNC_U ON NGM_DDL_TRUNC_M(K1)
        TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_DDL_TRUNC_I2 ON NGM_DDL_TRUNC_M(K2)
        TABLESPACE SYS_TBS_MEM_DATA;
    CREATE INDEX NGM_DDL_TRUNC_I3 ON NGM_DDL_TRUNC_M(K3 DESC)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_DDL_TRUNC_M VALUES (1, 'A-101', 'B-201', 'C-301');
    INSERT INTO NGM_DDL_TRUNC_M VALUES (11, 'A-111', 'B-211', 'C-311');
    INSERT INTO NGM_DDL_TRUNC_M VALUES (21, 'A-121', 'B-221', 'C-321');

##################################
SECTOR; TEST
##################################
    TRUNCATE TABLE NGM_DDL_TRUNC_M;
    SELECT COUNT(*) FROM NGM_DDL_TRUNC_M;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_DDL_TRUNC_%'
     ORDER BY INDEX_NAME;
    INSERT INTO NGM_DDL_TRUNC_M VALUES (5, 'A-105', 'B-205', 'C-305');
    INSERT INTO NGM_DDL_TRUNC_M VALUES (15, 'A-115', 'B-215', 'C-315');
    INSERT INTO NGM_DDL_TRUNC_M VALUES (25, 'A-125', 'B-225', 'C-325');
    SELECT /*+ INDEX(NGM_DDL_TRUNC_M, NGM_DDL_TRUNC_U) */ P, K1, K2, K3
      FROM NGM_DDL_TRUNC_M ORDER BY K1;
    SELECT /*+ INDEX(NGM_DDL_TRUNC_M, NGM_DDL_TRUNC_I3) */ P, K1, K2, K3
      FROM NGM_DDL_TRUNC_M ORDER BY K3 DESC;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_TRUNC_M;
    SKIP END;
}
