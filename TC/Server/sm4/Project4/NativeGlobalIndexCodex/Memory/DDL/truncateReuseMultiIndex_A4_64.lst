$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGM_DDL_TRUNC_M
    (P INTEGER, K1 VARCHAR(16), K2 VARCHAR(16), K3 VARCHAR(16))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGM_DDL_TRUNC_U ON NGM_DDL_TRUNC_M(K1)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_DDL_TRUNC_I2 ON NGM_DDL_TRUNC_M(K2)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
$T0> CREATE INDEX NGM_DDL_TRUNC_I3 ON NGM_DDL_TRUNC_M(K3 DESC)
        TABLESPACE SYS_TBS_MEM_DATA;
Create success.
