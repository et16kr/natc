###########################################################################
# TestCase Description = Protect Memory PK and UK backing indexes from FK drops.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DDL-007
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_FK_CHILD;
    DROP TABLE NGM_DDL_FK_PARENT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DDL_FK_PARENT
    (P INTEGER, ID VARCHAR(32), UKEY VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    ALTER TABLE NGM_DDL_FK_PARENT
        ADD CONSTRAINT NGM_DDL_FK_PK PRIMARY KEY(ID);
    ALTER TABLE NGM_DDL_FK_PARENT
        ADD CONSTRAINT NGM_DDL_FK_UK UNIQUE(UKEY);
    CREATE TABLE NGM_DDL_FK_CHILD (ID INTEGER, UKEY VARCHAR(32))
        TABLESPACE SYS_TBS_MEM_DATA;
    ALTER TABLE NGM_DDL_FK_CHILD
        ADD CONSTRAINT NGM_DDL_FK_C FOREIGN KEY(UKEY)
        REFERENCES NGM_DDL_FK_PARENT(UKEY);
    INSERT INTO NGM_DDL_FK_PARENT VALUES (1, 'ID-101', 'UK-201');
    INSERT INTO NGM_DDL_FK_CHILD VALUES (1, 'UK-201');

##################################
SECTOR; TEST
##################################
    ALTER TABLE NGM_DDL_FK_PARENT DROP CONSTRAINT NGM_DDL_FK_UK;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_DDL_FK_PK', 'NGM_DDL_FK_UK')
     ORDER BY INDEX_NAME;
    INSERT INTO NGM_DDL_FK_CHILD VALUES (2, 'UK-999');
    SELECT ID, UKEY FROM NGM_DDL_FK_CHILD ORDER BY ID;

    ALTER TABLE NGM_DDL_FK_CHILD DROP CONSTRAINT NGM_DDL_FK_C;
    ALTER TABLE NGM_DDL_FK_PARENT DROP CONSTRAINT NGM_DDL_FK_UK;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGM_DDL_FK_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_FK_CHILD;
    DROP TABLE NGM_DDL_FK_PARENT;
    SKIP END;
}
