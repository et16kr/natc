###########################################################################
# TestCase Description = Drop a Memory parent with multiple native indexes.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_CASCADE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DDL_CASCADE
    (
        P INTEGER,
        ID INTEGER NOT NULL,
        K1 VARCHAR(32),
        K2 INTEGER
    )
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_MEM_DATA;

    ALTER TABLE NGM_DDL_CASCADE
        ADD CONSTRAINT NGM_DDL_CASCADE_PK PRIMARY KEY(ID);

    CREATE INDEX NGM_DDL_CASCADE_I1
        ON NGM_DDL_CASCADE(K1)
        TABLESPACE SYS_TBS_MEM_DATA;

    CREATE INDEX NGM_DDL_CASCADE_I2
        ON NGM_DDL_CASCADE(K2)
        TABLESPACE SYS_TBS_MEM_DATA;

    INSERT INTO NGM_DDL_CASCADE VALUES (1, 1, 'K-10', 100);
    INSERT INTO NGM_DDL_CASCADE VALUES (2, 2, 'K-20', 200);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS INDEX_COUNT_BEFORE_DROP
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGM_DDL_CASCADE_PK',
            'NGM_DDL_CASCADE_I1',
            'NGM_DDL_CASCADE_I2');

    DROP TABLE NGM_DDL_CASCADE;

    SELECT COUNT(*) AS INDEX_COUNT_AFTER_DROP
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGM_DDL_CASCADE_PK',
            'NGM_DDL_CASCADE_I1',
            'NGM_DDL_CASCADE_I2');

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_CASCADE;
    SKIP END;
}

