###########################################################################
# TestCase Description = Preserve Memory constraint identity across table rename.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DDL-005
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_REN_NEW;
    DROP TABLE NGM_DDL_REN_OLD;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGM_DDL_REN_OLD (P INTEGER, UKEY VARCHAR(32), K VARCHAR(32))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_MEM_DATA;
    ALTER TABLE NGM_DDL_REN_OLD
        ADD CONSTRAINT NGM_DDL_REN_UK UNIQUE(UKEY);
    CREATE INDEX NGM_DDL_REN_I_OLD ON NGM_DDL_REN_OLD(K)
        TABLESPACE SYS_TBS_MEM_DATA;
    INSERT INTO NGM_DDL_REN_OLD VALUES (1, 'UK-101', 'K-201');
    INSERT INTO NGM_DDL_REN_OLD VALUES (11, 'UK-111', 'K-211');

##################################
SECTOR; TEST
##################################
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_DDL_REN_UK', 'NGM_DDL_REN_I_OLD')
     ORDER BY INDEX_NAME;
    ALTER TABLE NGM_DDL_REN_OLD RENAME TO NGM_DDL_REN_NEW;
    ALTER INDEX NGM_DDL_REN_I_OLD RENAME TO NGM_DDL_REN_I_NEW;
    INSERT INTO NGM_DDL_REN_NEW VALUES (21, 'UK-121', 'K-221');
    UPDATE NGM_DDL_REN_NEW SET K = 'K-311' WHERE UKEY = 'UK-111';
    SELECT /*+ INDEX(NGM_DDL_REN_NEW, NGM_DDL_REN_UK) */ P, UKEY, K
      FROM NGM_DDL_REN_NEW ORDER BY UKEY;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGM_DDL_REN_UK', 'NGM_DDL_REN_I_NEW')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGM_DDL_REN_NEW;
    DROP TABLE NGM_DDL_REN_OLD;
    SKIP END;
}
