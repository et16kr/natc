$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_CRT_CON_CHILD;
$T0> DROP TABLE NGD_CRT_CON_PARENT;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_CRT_CON_PARENT (P INTEGER, ID INTEGER, UKEY INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE TABLE NGD_CRT_CON_CHILD (ID INTEGER, PARENT_UKEY INTEGER)
        TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> ALTER TABLE NGD_CRT_CON_PARENT
        ADD CONSTRAINT NGD_CRT_CON_PK PRIMARY KEY(ID);
Alter success.
$T0> ALTER TABLE NGD_CRT_CON_PARENT
        ADD CONSTRAINT NGD_CRT_CON_UK UNIQUE(UKEY);
Alter success.
$T0> ALTER TABLE NGD_CRT_CON_CHILD
        ADD CONSTRAINT NGD_CRT_CON_FK FOREIGN KEY(PARENT_UKEY)
        REFERENCES NGD_CRT_CON_PARENT(UKEY);
Alter success.
$T0> INSERT INTO NGD_CRT_CON_PARENT VALUES (1, 101, 201);
1 row inserted.
$T0> INSERT INTO NGD_CRT_CON_PARENT VALUES (11, 111, 211);
1 row inserted.
$T0> INSERT INTO NGD_CRT_CON_CHILD VALUES (1, 201);
1 row inserted.

