 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Build a Disk native index across same-media tablespaces.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Test ID              = NGI-CRT-009
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_CRT_TBS;
$T0> DROP TABLESPACE NGD_CRT_TS2 INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE NGD_CRT_TS1 INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE NGD_CRT_TS1
        DATAFILE 'ngi_d_crt_ts1.dbf' SIZE 16M AUTOEXTEND OFF;
Create success.
$T0> CREATE DISK TABLESPACE NGD_CRT_TS2
        DATAFILE 'ngi_d_crt_ts2.dbf' SIZE 16M AUTOEXTEND OFF;
Create success.
$T0> CREATE TABLE NGD_CRT_TBS (P INTEGER, K INTEGER, V VARCHAR(16))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10) TABLESPACE NGD_CRT_TS1,
        PARTITION P2 VALUES LESS THAN (20) TABLESPACE NGD_CRT_TS2,
        PARTITION PD VALUES DEFAULT TABLESPACE NGD_CRT_TS1
    ) TABLESPACE NGD_CRT_TS1;
Create success.
$T0> CREATE INDEX NGD_CRT_TBS_I ON NGD_CRT_TBS(K)
        TABLESPACE NGD_CRT_TS2;
Create success.
$T0> INSERT INTO NGD_CRT_TBS VALUES (1, 101, 'P1');
1 row inserted.
$T0> INSERT INTO NGD_CRT_TBS VALUES (11, 111, 'P2');
1 row inserted.
$T0> INSERT INTO NGD_CRT_TBS VALUES (21, 121, 'PD');
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT /*+ INDEX(NGD_CRT_TBS, NGD_CRT_TBS_I) */ P, K, V
      FROM NGD_CRT_TBS ORDER BY K;
P           K           V                 
----------------------------------------------
1           101         P1                
11          111         P2                
21          121         PD                
3 rows selected.
$T0> SELECT I.INDEX_NAME, I.INDEX_IMPL_TYPE, I.INDEX_TABLE_ID,
           B.NAME AS INDEX_TBS_NAME
      FROM SYSTEM_.SYS_INDICES_ I, V$TABLESPACES B
     WHERE I.USER_ID = USER_ID()
       AND I.INDEX_NAME = 'NGD_CRT_TBS_I'
       AND I.TBS_ID = B.ID;
INDEX_NAME                                                                                                                        
------------------------------------------------------------------------------------------------------------------------------------
INDEX_IMPL_TYPE INDEX_TABLE_ID INDEX_TBS_NAME                            
-----------------------------------------------------------------------------
NGD_CRT_TBS_I                                                                                                                     
3           0           NGD_CRT_TS2                               
1 row selected.

$T0> ##################################
$T0> SECTOR 3; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_CRT_TBS;
$T0> DROP TABLESPACE NGD_CRT_TS2 INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE NGD_CRT_TS1 INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

