$T0> CREATE TABLE NGD_CRT_KEY
    (
        P INTEGER,
        ID INTEGER NOT NULL,
        UKEY INTEGER,
        CKEY CHAR(8),
        VKEY VARCHAR(64)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> ALTER TABLE NGD_CRT_KEY
        ADD CONSTRAINT NGD_CRT_KEY_PK PRIMARY KEY(ID);
Alter success.

$T0> ALTER TABLE NGD_CRT_KEY
        ADD CONSTRAINT NGD_CRT_KEY_UK UNIQUE(UKEY);
Alter success.

$T0> CREATE INDEX NGD_CRT_KEY_I
        ON NGD_CRT_KEY(CKEY ASC, VKEY DESC);
Create success.

