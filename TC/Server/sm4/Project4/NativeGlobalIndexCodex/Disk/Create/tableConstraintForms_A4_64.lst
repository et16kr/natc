$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_CRT_T_IN_PK
    (
        P INTEGER,
        ID INTEGER CONSTRAINT NGD_CRT_IN_PK PRIMARY KEY,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE TABLE NGD_CRT_T_IN_UK
    (
        P INTEGER,
        UKEY INTEGER CONSTRAINT NGD_CRT_IN_UK UNIQUE,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE TABLE NGD_CRT_T_OUT_PK
    (
        P INTEGER,
        K1 INTEGER,
        K2 INTEGER,
        V VARCHAR(16),
        CONSTRAINT NGD_CRT_OUT_PK PRIMARY KEY(K1, K2)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE TABLE NGD_CRT_T_OUT_UK
    (
        P INTEGER,
        K INTEGER,
        V VARCHAR(16),
        CONSTRAINT NGD_CRT_OUT_UK UNIQUE(V)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

