###########################################################################
# TestCase Description = Cover Disk NULL, mixed order, and long variable keys.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-008
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_SHAPE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_CRT_SHAPE
    (P INTEGER, CKEY CHAR(8), VKEY VARCHAR(512), NKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_CRT_SHAPE_I
        ON NGD_CRT_SHAPE(CKEY ASC, VKEY DESC, NKEY ASC);
    INSERT INTO NGD_CRT_SHAPE VALUES (1, 'A', RPAD('A', 400, 'A'), 1, 10);
    INSERT INTO NGD_CRT_SHAPE VALUES (11, 'A', RPAD('B', 400, 'B'), 2, 20);
    INSERT INTO NGD_CRT_SHAPE VALUES (21, 'B', NULL, 3, 30);
    INSERT INTO NGD_CRT_SHAPE VALUES (25, NULL, NULL, NULL, 40);

##################################
SECTOR; TEST
##################################
    SELECT /*+ INDEX(NGD_CRT_SHAPE, NGD_CRT_SHAPE_I) */
           P, CKEY, LENGTH(VKEY) AS VKEY_LEN, NKEY, V
      FROM NGD_CRT_SHAPE
     ORDER BY CKEY, VKEY DESC, NKEY, P;
    SELECT /*+ FULL SCAN(NGD_CRT_SHAPE) */
           P, CKEY, LENGTH(VKEY) AS VKEY_LEN, NKEY, V
      FROM NGD_CRT_SHAPE
     ORDER BY CKEY, VKEY DESC, NKEY, P;
    SELECT COUNT(*), COUNT(VKEY), MIN(LENGTH(VKEY)), MAX(LENGTH(VKEY))
      FROM NGD_CRT_SHAPE;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_SHAPE;
    SKIP END;
}
