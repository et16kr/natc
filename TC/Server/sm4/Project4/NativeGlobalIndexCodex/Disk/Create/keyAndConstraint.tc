###########################################################################
# TestCase Description = Create Disk native indexes for keys and constraints.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_KEY;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_CRT_KEY
    (
        P INTEGER,
        ID INTEGER NOT NULL,
        UKEY INTEGER,
        CKEY CHAR(8),
        VKEY VARCHAR(64)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;

    ALTER TABLE NGD_CRT_KEY
        ADD CONSTRAINT NGD_CRT_KEY_PK PRIMARY KEY(ID);

    ALTER TABLE NGD_CRT_KEY
        ADD CONSTRAINT NGD_CRT_KEY_UK UNIQUE(UKEY);

    CREATE INDEX NGD_CRT_KEY_I
        ON NGD_CRT_KEY(CKEY ASC, VKEY DESC);

    INSERT INTO NGD_CRT_KEY VALUES (1, 1, 101, 'A', 'ALPHA');
    INSERT INTO NGD_CRT_KEY VALUES (11, 2, 102, 'B', 'BETA');
    INSERT INTO NGD_CRT_KEY VALUES (21, 3, NULL, 'C', NULL);

##################################
SECTOR; TEST
##################################
    SELECT P, ID, UKEY, CKEY, VKEY
      FROM NGD_CRT_KEY
     ORDER BY CKEY, VKEY DESC, ID;

    SELECT INDEX_NAME,
           INDEX_IMPL_TYPE,
           INDEX_TABLE_ID,
           IS_UNIQUE
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGD_CRT_KEY_PK', 'NGD_CRT_KEY_UK', 'NGD_CRT_KEY_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_KEY;
    SKIP END;
}

