###########################################################################
# TestCase Description = Build Disk native PK and UK from table definitions.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-004
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_T_OUT_UK;
    DROP TABLE NGD_CRT_T_OUT_PK;
    DROP TABLE NGD_CRT_T_IN_UK;
    DROP TABLE NGD_CRT_T_IN_PK;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_CRT_T_IN_PK
    (
        P INTEGER,
        ID INTEGER CONSTRAINT NGD_CRT_IN_PK PRIMARY KEY,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;

    CREATE TABLE NGD_CRT_T_IN_UK
    (
        P INTEGER,
        UKEY INTEGER CONSTRAINT NGD_CRT_IN_UK UNIQUE,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;

    CREATE TABLE NGD_CRT_T_OUT_PK
    (
        P INTEGER,
        K1 INTEGER,
        K2 INTEGER,
        V VARCHAR(16),
        CONSTRAINT NGD_CRT_OUT_PK PRIMARY KEY(K1, K2)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;

    CREATE TABLE NGD_CRT_T_OUT_UK
    (
        P INTEGER,
        K INTEGER,
        V VARCHAR(16),
        CONSTRAINT NGD_CRT_OUT_UK UNIQUE(V)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;

    INSERT INTO NGD_CRT_T_IN_PK VALUES (1, 101, 'A');
    INSERT INTO NGD_CRT_T_IN_PK VALUES (11, 111, 'B');
    INSERT INTO NGD_CRT_T_IN_UK VALUES (1, 201, 'A');
    INSERT INTO NGD_CRT_T_IN_UK VALUES (11, 211, 'B');
    INSERT INTO NGD_CRT_T_OUT_PK VALUES (1, 101, 1, 'X');
    INSERT INTO NGD_CRT_T_OUT_PK VALUES (21, 121, 1, 'Y');
    INSERT INTO NGD_CRT_T_OUT_UK VALUES (1, 101, 'X');
    INSERT INTO NGD_CRT_T_OUT_UK VALUES (21, 121, 'Y');

##################################
SECTOR; TEST
##################################
    SELECT P, ID, V FROM NGD_CRT_T_IN_PK ORDER BY ID;
    SELECT P, UKEY, V FROM NGD_CRT_T_IN_UK ORDER BY UKEY;
    SELECT P, K1, K2, V FROM NGD_CRT_T_OUT_PK ORDER BY K1, K2;
    SELECT P, K, V FROM NGD_CRT_T_OUT_UK ORDER BY V;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID, IS_UNIQUE
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
           ('NGD_CRT_IN_PK', 'NGD_CRT_IN_UK',
            'NGD_CRT_OUT_PK', 'NGD_CRT_OUT_UK')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_T_OUT_UK;
    DROP TABLE NGD_CRT_T_OUT_PK;
    DROP TABLE NGD_CRT_T_IN_UK;
    DROP TABLE NGD_CRT_T_IN_PK;
    SKIP END;
}
