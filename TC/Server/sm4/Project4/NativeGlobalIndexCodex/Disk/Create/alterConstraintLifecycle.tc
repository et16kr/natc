###########################################################################
# TestCase Description = Maintain Disk PK, UK, and FK constraint lifecycles.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-005
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_CON_CHILD;
    DROP TABLE NGD_CRT_CON_PARENT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_CRT_CON_PARENT (P INTEGER, ID INTEGER, UKEY INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE TABLE NGD_CRT_CON_CHILD (ID INTEGER, PARENT_UKEY INTEGER)
        TABLESPACE SYS_TBS_DISK_DATA;
    ALTER TABLE NGD_CRT_CON_PARENT
        ADD CONSTRAINT NGD_CRT_CON_PK PRIMARY KEY(ID);
    ALTER TABLE NGD_CRT_CON_PARENT
        ADD CONSTRAINT NGD_CRT_CON_UK UNIQUE(UKEY);
    ALTER TABLE NGD_CRT_CON_CHILD
        ADD CONSTRAINT NGD_CRT_CON_FK FOREIGN KEY(PARENT_UKEY)
        REFERENCES NGD_CRT_CON_PARENT(UKEY);
    INSERT INTO NGD_CRT_CON_PARENT VALUES (1, 101, 201);
    INSERT INTO NGD_CRT_CON_PARENT VALUES (11, 111, 211);
    INSERT INTO NGD_CRT_CON_CHILD VALUES (1, 201);

##################################
SECTOR; TEST
##################################
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGD_CRT_CON_PK', 'NGD_CRT_CON_UK')
     ORDER BY INDEX_NAME;

    ALTER TABLE NGD_CRT_CON_PARENT DROP CONSTRAINT NGD_CRT_CON_UK;
    SELECT P, ID, UKEY FROM NGD_CRT_CON_PARENT ORDER BY ID;

    ALTER TABLE NGD_CRT_CON_CHILD DROP CONSTRAINT NGD_CRT_CON_FK;
    ALTER TABLE NGD_CRT_CON_PARENT DROP CONSTRAINT NGD_CRT_CON_UK;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_CRT_CON_%'
     ORDER BY INDEX_NAME;

    ALTER TABLE NGD_CRT_CON_PARENT
        ADD CONSTRAINT NGD_CRT_CON_UK UNIQUE(UKEY);
    ALTER TABLE NGD_CRT_CON_CHILD
        ADD CONSTRAINT NGD_CRT_CON_FK FOREIGN KEY(PARENT_UKEY)
        REFERENCES NGD_CRT_CON_PARENT(UKEY);
    SELECT C.ID, C.PARENT_UKEY, P.P
      FROM NGD_CRT_CON_CHILD C JOIN NGD_CRT_CON_PARENT P
        ON C.PARENT_UKEY = P.UKEY
     ORDER BY C.ID;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_CON_CHILD;
    DROP TABLE NGD_CRT_CON_PARENT;
    SKIP END;
}
