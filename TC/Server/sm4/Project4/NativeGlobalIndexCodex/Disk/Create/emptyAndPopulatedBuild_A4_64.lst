$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_CRT_EMPTY (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE TABLE NGD_CRT_POP (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> INSERT INTO NGD_CRT_POP VALUES (1, 101);
1 row inserted.
