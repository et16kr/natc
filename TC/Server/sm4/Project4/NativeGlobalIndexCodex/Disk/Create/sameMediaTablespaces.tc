###########################################################################
# TestCase Description = Build a Disk native index across same-media tablespaces.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-009
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_TBS;
    DROP TABLESPACE NGD_CRT_TS2 INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE NGD_CRT_TS1 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE NGD_CRT_TS1
        DATAFILE 'ngi_d_crt_ts1.dbf' SIZE 16M AUTOEXTEND OFF;
    CREATE DISK TABLESPACE NGD_CRT_TS2
        DATAFILE 'ngi_d_crt_ts2.dbf' SIZE 16M AUTOEXTEND OFF;
    CREATE TABLE NGD_CRT_TBS (P INTEGER, K INTEGER, V VARCHAR(16))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10) TABLESPACE NGD_CRT_TS1,
        PARTITION P2 VALUES LESS THAN (20) TABLESPACE NGD_CRT_TS2,
        PARTITION PD VALUES DEFAULT TABLESPACE NGD_CRT_TS1
    ) TABLESPACE NGD_CRT_TS1;
    CREATE INDEX NGD_CRT_TBS_I ON NGD_CRT_TBS(K)
        TABLESPACE NGD_CRT_TS2;
    INSERT INTO NGD_CRT_TBS VALUES (1, 101, 'P1');
    INSERT INTO NGD_CRT_TBS VALUES (11, 111, 'P2');
    INSERT INTO NGD_CRT_TBS VALUES (21, 121, 'PD');

##################################
SECTOR; TEST
##################################
    SELECT /*+ INDEX(NGD_CRT_TBS, NGD_CRT_TBS_I) */ P, K, V
      FROM NGD_CRT_TBS ORDER BY K;
    SELECT I.INDEX_NAME, I.INDEX_IMPL_TYPE, I.INDEX_TABLE_ID,
           B.NAME AS INDEX_TBS_NAME
      FROM SYSTEM_.SYS_INDICES_ I, V$TABLESPACES B
     WHERE I.USER_ID = USER_ID()
       AND I.INDEX_NAME = 'NGD_CRT_TBS_I'
       AND I.TBS_ID = B.ID;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_TBS;
    DROP TABLESPACE NGD_CRT_TS2 INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE NGD_CRT_TS1 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
