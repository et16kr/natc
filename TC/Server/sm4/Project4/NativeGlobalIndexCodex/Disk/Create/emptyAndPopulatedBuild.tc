###########################################################################
# TestCase Description = Build Disk native indexes on empty and populated tables.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-CRT-007
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_POP;
    DROP TABLE NGD_CRT_EMPTY;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_CRT_EMPTY (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_DISK_DATA;
    CREATE TABLE NGD_CRT_POP (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (PARTITION P1 VALUES LESS THAN (10), PARTITION PD VALUES DEFAULT)
    TABLESPACE SYS_TBS_DISK_DATA;
    INSERT INTO NGD_CRT_POP VALUES (1, 101);
    INSERT INTO NGD_CRT_POP VALUES (11, 111);

##################################
SECTOR; TEST
##################################
    CREATE INDEX NGD_CRT_EMPTY_I ON NGD_CRT_EMPTY(K);
    INSERT INTO NGD_CRT_EMPTY VALUES (1, 201);
    INSERT INTO NGD_CRT_EMPTY VALUES (11, 211);

    CREATE INDEX NGD_CRT_POP_I ON NGD_CRT_POP(K);
    INSERT INTO NGD_CRT_POP VALUES (21, 121);
    UPDATE NGD_CRT_POP SET K = K + 100 WHERE P = 1;

    SELECT /*+ INDEX(NGD_CRT_EMPTY, NGD_CRT_EMPTY_I) */ P, K
      FROM NGD_CRT_EMPTY ORDER BY K;
    SELECT /*+ INDEX(NGD_CRT_POP, NGD_CRT_POP_I) */ P, K
      FROM NGD_CRT_POP ORDER BY K;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGD_CRT_EMPTY_I', 'NGD_CRT_POP_I')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CRT_POP;
    DROP TABLE NGD_CRT_EMPTY;
    SKIP END;
}
