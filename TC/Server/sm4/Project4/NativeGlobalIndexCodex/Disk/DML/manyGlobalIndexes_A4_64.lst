$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_DML_MANY
    (P INTEGER, K1 INTEGER, K2 INTEGER, K3 INTEGER, K4 INTEGER,
     K5 INTEGER, K6 INTEGER, K7 INTEGER, K8 INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) ENABLE ROW MOVEMENT TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I1 ON NGD_DML_MANY(K1);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I2 ON NGD_DML_MANY(K2);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I3 ON NGD_DML_MANY(K3);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I4 ON NGD_DML_MANY(K4);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I5 ON NGD_DML_MANY(K5);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I6 ON NGD_DML_MANY(K6);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I7 ON NGD_DML_MANY(K7);
Create success.
$T0> CREATE INDEX NGD_DML_MANY_I8 ON NGD_DML_MANY(K8);
Create success.

