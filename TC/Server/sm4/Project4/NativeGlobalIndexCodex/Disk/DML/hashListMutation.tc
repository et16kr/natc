###########################################################################
# TestCase Description = Mutate Disk hash/list participants and index keys.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_KIND_H;
    DROP TABLE NGD_DML_KIND_L;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_DML_KIND_H (P INTEGER, K INTEGER, V VARCHAR(16))
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_DISK_DATA;

    CREATE TABLE NGD_DML_KIND_L (P INTEGER, K INTEGER, V VARCHAR(16))
    PARTITION BY LIST(P)
    (
        PARTITION P1 VALUES (1, 2),
        PARTITION P2 VALUES (3, 4),
        PARTITION PD VALUES DEFAULT
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_DISK_DATA;

    CREATE INDEX NGD_DML_KIND_H_I ON NGD_DML_KIND_H(K);
    CREATE INDEX NGD_DML_KIND_L_I ON NGD_DML_KIND_L(K);

    INSERT INTO NGD_DML_KIND_H VALUES (1, 101, 'H-A');
    INSERT INTO NGD_DML_KIND_H VALUES (2, 102, 'H-B');
    INSERT INTO NGD_DML_KIND_H VALUES (3, 103, 'H-C');
    INSERT INTO NGD_DML_KIND_H VALUES (4, 104, 'H-D');
    INSERT INTO NGD_DML_KIND_L VALUES (1, 201, 'L-A');
    INSERT INTO NGD_DML_KIND_L VALUES (2, 202, 'L-B');
    INSERT INTO NGD_DML_KIND_L VALUES (3, 203, 'L-C');
    INSERT INTO NGD_DML_KIND_L VALUES (9, 209, 'L-D');

##################################
SECTOR; TEST
##################################
    UPDATE NGD_DML_KIND_H SET P = P + 10, K = K + 1000 WHERE K = 101;
    UPDATE NGD_DML_KIND_L SET P = 3, K = K + 1000 WHERE K = 201;
    UPDATE NGD_DML_KIND_H SET V = 'H-UPDATED' WHERE K = 103;
    UPDATE NGD_DML_KIND_L SET V = 'L-UPDATED' WHERE K = 209;

    DELETE FROM NGD_DML_KIND_H WHERE K = 102;
    DELETE FROM NGD_DML_KIND_L WHERE K = 202;

    SELECT /*+ INDEX(NGD_DML_KIND_H, NGD_DML_KIND_H_I) */ P, K, V
      FROM NGD_DML_KIND_H
     ORDER BY K, P;

    SELECT /*+ INDEX(NGD_DML_KIND_L, NGD_DML_KIND_L_I) */ P, K, V
      FROM NGD_DML_KIND_L
     ORDER BY K, P;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_KIND_H;
    DROP TABLE NGD_DML_KIND_L;
    SKIP END;
}

