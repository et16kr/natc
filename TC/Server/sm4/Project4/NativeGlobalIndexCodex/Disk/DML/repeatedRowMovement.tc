###########################################################################
# TestCase Description = Repeatedly move one Disk row across partitions.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DML-007
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_REPEAT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_DML_REPEAT (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) ENABLE ROW MOVEMENT TABLESPACE SYS_TBS_DISK_DATA;
    CREATE UNIQUE INDEX NGD_DML_REPEAT_U ON NGD_DML_REPEAT(K);
    INSERT INTO NGD_DML_REPEAT VALUES (1, 100, 1);

##################################
SECTOR; TEST
##################################
    UPDATE NGD_DML_REPEAT SET P = 11, V = 2 WHERE K = 100;
    SELECT P, K, V FROM NGD_DML_REPEAT ORDER BY K;
    UPDATE NGD_DML_REPEAT SET P = 21, V = 3 WHERE K = 100;
    SELECT P, K, V FROM NGD_DML_REPEAT ORDER BY K;
    UPDATE NGD_DML_REPEAT SET P = 5, V = 4 WHERE K = 100;
    SELECT P, K, V FROM NGD_DML_REPEAT ORDER BY K;

    SELECT /*+ INDEX(NGD_DML_REPEAT, NGD_DML_REPEAT_U) */ P, K, V
      FROM NGD_DML_REPEAT WHERE K = 100 ORDER BY P;
    SELECT /*+ FULL SCAN(NGD_DML_REPEAT) */ P, K, V
      FROM NGD_DML_REPEAT WHERE K = 100 ORDER BY P;
    SELECT K, COUNT(*) FROM NGD_DML_REPEAT GROUP BY K ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_REPEAT;
    SKIP END;
}
