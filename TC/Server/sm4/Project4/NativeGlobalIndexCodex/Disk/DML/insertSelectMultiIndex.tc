###########################################################################
# TestCase Description = Maintain multiple Disk indexes during INSERT SELECT.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_SEL_DST;
    DROP TABLE NGD_DML_SEL_SRC;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_DML_SEL_SRC (P INTEGER, K INTEGER, V VARCHAR(24))
    TABLESPACE SYS_TBS_DISK_DATA;

    CREATE TABLE NGD_DML_SEL_DST (P INTEGER, K INTEGER, V VARCHAR(24))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;

    CREATE INDEX NGD_DML_SEL_DST_K ON NGD_DML_SEL_DST(K);
    CREATE INDEX NGD_DML_SEL_DST_V ON NGD_DML_SEL_DST(V DESC, K);
    CREATE INDEX NGD_DML_SEL_DST_L ON NGD_DML_SEL_DST(P) LOCAL;

    INSERT INTO NGD_DML_SEL_SRC VALUES (1, 101, 'SRC-A');
    INSERT INTO NGD_DML_SEL_SRC VALUES (11, 111, 'SRC-B');
    INSERT INTO NGD_DML_SEL_SRC VALUES (21, 121, 'SRC-C');

##################################
SECTOR; TEST
##################################
    INSERT INTO NGD_DML_SEL_DST
        SELECT P, K, V FROM NGD_DML_SEL_SRC;

    INSERT INTO NGD_DML_SEL_DST
        SELECT P + 30, K + 300, V || '-COPY'
          FROM NGD_DML_SEL_SRC
         WHERE P < 10;

    UPDATE NGD_DML_SEL_DST SET V = 'DST-B' WHERE K = 111;
    DELETE FROM NGD_DML_SEL_DST WHERE K = 121;

    SELECT /*+ INDEX(NGD_DML_SEL_DST, NGD_DML_SEL_DST_K) */ P, K, V
      FROM NGD_DML_SEL_DST
     ORDER BY K, P;

    SELECT /*+ INDEX(NGD_DML_SEL_DST, NGD_DML_SEL_DST_V) */ P, K, V
      FROM NGD_DML_SEL_DST
     ORDER BY V DESC, K, P;

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, IS_PARTITIONED
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_DML_SEL_DST_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_SEL_DST;
    DROP TABLE NGD_DML_SEL_SRC;
    SKIP END;
}

