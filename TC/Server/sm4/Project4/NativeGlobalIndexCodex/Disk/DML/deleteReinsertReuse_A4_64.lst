$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Reuse a deleted Disk global unique key.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Test ID              = NGI-DML-010
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_DML_REUSE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_DML_REUSE (P INTEGER, UKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGD_DML_REUSE_U ON NGD_DML_REUSE(UKEY);
Create success.
$T0> INSERT INTO NGD_DML_REUSE VALUES (1, 100, 1);
1 row inserted.
$T0> INSERT INTO NGD_DML_REUSE VALUES (11, 200, 2);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> DELETE FROM NGD_DML_REUSE WHERE UKEY = 100;
1 row deleted.
$T0> SELECT P, UKEY, V FROM NGD_DML_REUSE ORDER BY UKEY;
P           UKEY        V           
----------------------------------------
11          200         2           
1 row selected.
$T0> INSERT INTO NGD_DML_REUSE VALUES (21, 100, 3);
1 row inserted.
$T0> SELECT /*+ INDEX(NGD_DML_REUSE, NGD_DML_REUSE_U) */ P, UKEY, V
      FROM NGD_DML_REUSE ORDER BY UKEY;
P           UKEY        V           
----------------------------------------
21          100         3           
11          200         2           
2 rows selected.
$T0> DELETE FROM NGD_DML_REUSE WHERE UKEY = 100;
1 row deleted.
$T0> INSERT INTO NGD_DML_REUSE VALUES (5, 100, 4);
1 row inserted.
$T0> SELECT /*+ FULL SCAN(NGD_DML_REUSE) */ P, UKEY, V
      FROM NGD_DML_REUSE ORDER BY UKEY;
P           UKEY        V           
----------------------------------------
5           100         4           
11          200         2           
2 rows selected.
$T0> INSERT INTO NGD_DML_REUSE VALUES (15, 100, 5);
[ERR-11058 : The row already exists in a unique index.]
$T0> SELECT UKEY, COUNT(*) FROM NGD_DML_REUSE GROUP BY UKEY ORDER BY UKEY;
UKEY        COUNT                
------------------------------------
100         1                    
200         1                    
2 rows selected.

$T0> ##################################
$T0> SECTOR 3; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_DML_REUSE;
