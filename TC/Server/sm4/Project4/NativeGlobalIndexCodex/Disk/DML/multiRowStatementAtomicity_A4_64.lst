$T0> ###########################################################################
$T0> # TestCase Description = Keep Disk multi-row DML atomic on a unique error.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Test ID              = NGI-DML-006
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_DML_ATOMIC_SRC;
$T0> DROP TABLE NGD_DML_ATOMIC;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_DML_ATOMIC (P INTEGER, UKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE TABLE NGD_DML_ATOMIC_SRC (P INTEGER, UKEY INTEGER, V INTEGER)
        TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGD_DML_ATOMIC_U ON NGD_DML_ATOMIC(UKEY);
Create success.
$T0> INSERT INTO NGD_DML_ATOMIC VALUES (1, 100, 1);
1 row inserted.
$T0> INSERT INTO NGD_DML_ATOMIC VALUES (11, 200, 2);
1 row inserted.
$T0> INSERT INTO NGD_DML_ATOMIC_SRC VALUES (5, 300, 3);
1 row inserted.
$T0> INSERT INTO NGD_DML_ATOMIC_SRC VALUES (15, 100, 4);
1 row inserted.
$T0> INSERT INTO NGD_DML_ATOMIC_SRC VALUES (25, 400, 5);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> INSERT INTO NGD_DML_ATOMIC
        SELECT P, UKEY, V FROM NGD_DML_ATOMIC_SRC;
[ERR-11058 : The row already exists in a unique index.]
$T0> SELECT P, UKEY, V FROM NGD_DML_ATOMIC ORDER BY UKEY;
P           UKEY        V           
----------------------------------------
1           100         1           
11          200         2           
2 rows selected.

$T0> UPDATE NGD_DML_ATOMIC SET UKEY = 500 WHERE UKEY IN (100, 200);
[ERR-11058 : The row already exists in a unique index.]
$T0> SELECT /*+ INDEX(NGD_DML_ATOMIC, NGD_DML_ATOMIC_U) */ P, UKEY, V
      FROM NGD_DML_ATOMIC ORDER BY UKEY;
P           UKEY        V           
----------------------------------------
1           100         1           
11          200         2           
2 rows selected.
$T0> SELECT /*+ FULL SCAN(NGD_DML_ATOMIC) */ P, UKEY, V
      FROM NGD_DML_ATOMIC ORDER BY UKEY;
P           UKEY        V           
----------------------------------------
1           100         1           
11          200         2           
2 rows selected.

