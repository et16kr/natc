###########################################################################
# TestCase Description = Reuse a deleted Disk global unique key.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DML-010
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_REUSE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_DML_REUSE (P INTEGER, UKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE UNIQUE INDEX NGD_DML_REUSE_U ON NGD_DML_REUSE(UKEY);
    INSERT INTO NGD_DML_REUSE VALUES (1, 100, 1);
    INSERT INTO NGD_DML_REUSE VALUES (11, 200, 2);

##################################
SECTOR; TEST
##################################
    DELETE FROM NGD_DML_REUSE WHERE UKEY = 100;
    SELECT P, UKEY, V FROM NGD_DML_REUSE ORDER BY UKEY;
    INSERT INTO NGD_DML_REUSE VALUES (21, 100, 3);
    SELECT /*+ INDEX(NGD_DML_REUSE, NGD_DML_REUSE_U) */ P, UKEY, V
      FROM NGD_DML_REUSE ORDER BY UKEY;
    DELETE FROM NGD_DML_REUSE WHERE UKEY = 100;
    INSERT INTO NGD_DML_REUSE VALUES (5, 100, 4);
    SELECT /*+ FULL SCAN(NGD_DML_REUSE) */ P, UKEY, V
      FROM NGD_DML_REUSE ORDER BY UKEY;
    INSERT INTO NGD_DML_REUSE VALUES (15, 100, 5);
    SELECT UKEY, COUNT(*) FROM NGD_DML_REUSE GROUP BY UKEY ORDER BY UKEY;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DML_REUSE;
    SKIP END;
}
