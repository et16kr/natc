###########################################################################
# TestCase Description = Reject Disk native DDL across a savepoint.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-010
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NGD_NEG_SPDDL;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_NEG_SPDDL (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_NEG_SPDDL_OK ON NGD_NEG_SPDDL(K);
    INSERT INTO NGD_NEG_SPDDL VALUES (1, 101, 201);
    INSERT INTO NGD_NEG_SPDDL VALUES (11, 111, 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_SPDDL_%';

    AUTOCOMMIT OFF;
    INSERT INTO NGD_NEG_SPDDL VALUES (21, 121, 221);
    SAVEPOINT NGD_NEG_SP;
    CREATE INDEX NGD_NEG_SPDDL_TRY ON NGD_NEG_SPDDL(V);
    ROLLBACK TO SAVEPOINT NGD_NEG_SP;
    DROP INDEX NGD_NEG_SPDDL_OK;
    ROLLBACK TO SAVEPOINT NGD_NEG_SP;
    UPDATE NGD_NEG_SPDDL SET K = 122 WHERE P = 21;
    ROLLBACK;
    AUTOCOMMIT ON;

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_SPDDL_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_NEG_SPDDL_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGD_NEG_SPDDL_%';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGD_NEG_SPDDL_%'
            OR INDEX_NAME LIKE '$GIR_NGD_NEG_SPDDL_%');
    SELECT /*+ INDEX(NGD_NEG_SPDDL, NGD_NEG_SPDDL_OK) */ P, K, V
      FROM NGD_NEG_SPDDL ORDER BY K;
    INSERT INTO NGD_NEG_SPDDL VALUES (21, 121, 221);
    SELECT /*+ INDEX(NGD_NEG_SPDDL, NGD_NEG_SPDDL_OK) */ P, K, V
      FROM NGD_NEG_SPDDL ORDER BY K;

    CREATE INDEX NGD_NEG_SPDDL_TRY ON NGD_NEG_SPDDL(V);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_SPDDL_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ROLLBACK;
    AUTOCOMMIT ON;
    DROP TABLE NGD_NEG_SPDDL;
    SKIP END;
}
