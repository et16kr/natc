$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_NEG_VOL;
$T0> DROP TABLE NGD_NEG_MIX;
$T0> DROP TABLE NGD_NEG_MEDIA;
$T0> DROP TABLESPACE NGD_NEG_VOL_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_NEG_MEDIA (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE INDEX NGD_NEG_MEDIA_OK ON NGD_NEG_MEDIA(K);
Create success.
$T0> INSERT INTO NGD_NEG_MEDIA VALUES (1, 101, 201);
1 row inserted.
$T0> INSERT INTO NGD_NEG_MEDIA VALUES (11, 111, 211);
1 row inserted.

$T0> CREATE TABLE NGD_NEG_MIX (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10) TABLESPACE SYS_TBS_DISK_DATA,
        PARTITION P2 VALUES LESS THAN (20) TABLESPACE SYS_TBS_MEM_DATA,
        PARTITION PD VALUES DEFAULT TABLESPACE SYS_TBS_DISK_DATA
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> INSERT INTO NGD_NEG_MIX VALUES (1, 301);
1 row inserted.
$T0> INSERT INTO NGD_NEG_MIX VALUES (11, 311);
1 row inserted.

$T0> CREATE VOLATILE DATA TABLESPACE NGD_NEG_VOL_TS SIZE 32M AUTOEXTEND ON;
Create success.
$T0> CREATE TABLE NGD_NEG_VOL (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE NGD_NEG_VOL_TS;
Create success.
$T0> INSERT INTO NGD_NEG_VOL VALUES (1, 401);
1 row inserted.

