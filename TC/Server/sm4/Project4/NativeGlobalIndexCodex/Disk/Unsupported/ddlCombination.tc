###########################################################################
# TestCase Description = Reject multiple Disk native index creates in one statement.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-009
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_NEG_DDLCOMB_TRY;
    DROP TABLE NGD_NEG_DDLCOMB;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_NEG_DDLCOMB (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_NEG_DDLCOMB_OK ON NGD_NEG_DDLCOMB(K);
    INSERT INTO NGD_NEG_DDLCOMB VALUES (1, 101, 201);
    INSERT INTO NGD_NEG_DDLCOMB VALUES (11, 111, 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_DDLCOMB_%';

    CREATE TABLE NGD_NEG_DDLCOMB_TRY
    (
        P INTEGER,
        K INTEGER,
        V INTEGER,
        CONSTRAINT NGD_NEG_DDLCOMB_PK PRIMARY KEY(K),
        CONSTRAINT NGD_NEG_DDLCOMB_UK UNIQUE(V)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_DDLCOMB_%';
    SELECT COUNT(*) AS FAILED_TABLE_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME = 'NGD_NEG_DDLCOMB_TRY';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_NEG_DDLCOMB_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGD_NEG_DDLCOMB_%';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGD_NEG_DDLCOMB_%'
            OR INDEX_NAME LIKE '$GIR_NGD_NEG_DDLCOMB_%');
    SELECT /*+ INDEX(NGD_NEG_DDLCOMB, NGD_NEG_DDLCOMB_OK) */ P, K, V
      FROM NGD_NEG_DDLCOMB ORDER BY K;
    INSERT INTO NGD_NEG_DDLCOMB VALUES (21, 121, 221);
    SELECT /*+ INDEX(NGD_NEG_DDLCOMB, NGD_NEG_DDLCOMB_OK) */ P, K, V
      FROM NGD_NEG_DDLCOMB ORDER BY K;

    CREATE TABLE NGD_NEG_DDLCOMB_TRY
    (
        P INTEGER,
        K INTEGER,
        V INTEGER,
        CONSTRAINT NGD_NEG_DDLCOMB_PK PRIMARY KEY(K)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_NEG_DDLCOMB_UK ON NGD_NEG_DDLCOMB_TRY(V);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_DDLCOMB_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_NEG_DDLCOMB_TRY;
    DROP TABLE NGD_NEG_DDLCOMB;
    SKIP END;
}
