$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> DROP TABLE NGD_NEG_SPDDL;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_NEG_SPDDL (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE INDEX NGD_NEG_SPDDL_OK ON NGD_NEG_SPDDL(K);
Create success.
$T0> INSERT INTO NGD_NEG_SPDDL VALUES (1, 101, 201);
1 row inserted.
$T0> INSERT INTO NGD_NEG_SPDDL VALUES (11, 111, 211);
1 row inserted.

