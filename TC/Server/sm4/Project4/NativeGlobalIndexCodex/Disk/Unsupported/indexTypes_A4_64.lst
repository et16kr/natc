$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_NEG_TYPE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_NEG_TYPE (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE INDEX NGD_NEG_TYPE_OK ON NGD_NEG_TYPE(K) INDEXTYPE IS BTREE;
Create success.
$T0> INSERT INTO NGD_NEG_TYPE VALUES (1, 101, 201);
1 row inserted.
$T0> INSERT INTO NGD_NEG_TYPE VALUES (11, 111, 211);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_TYPE_%';
BEFORE_INDEX_COUNT   
-----------------------
1                    
1 row selected.

$T0> CREATE INDEX NGD_NEG_TYPE_TRY ON NGD_NEG_TYPE(V) INDEXTYPE IS RTREE;
[ERR-31237 : cannot create index in the data type.]
$T0> CREATE INDEX NGD_NEG_TYPE_TRY ON NGD_NEG_TYPE(V) INDEXTYPE IS TDRTREE;
[ERR-11059 : Index type name not found]

