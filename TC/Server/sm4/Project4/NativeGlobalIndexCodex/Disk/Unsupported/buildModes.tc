###########################################################################
# TestCase Description = Reject unsupported Disk native index build modes.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-NEG-006
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_NEG_MODE;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_NEG_MODE (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_NEG_MODE_OK ON NGD_NEG_MODE(K);
    INSERT INTO NGD_NEG_MODE VALUES (1, 101, 201);
    INSERT INTO NGD_NEG_MODE VALUES (11, 111, 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_MODE_%';

    CREATE INDEX NGD_NEG_MODE_TRY ON NGD_NEG_MODE(V) NOLOGGING FORCE;
    CREATE INDEX NGD_NEG_MODE_TRY ON NGD_NEG_MODE(V) NOLOGGING NOFORCE;
    CREATE INDEX NGD_NEG_MODE_TRY ON NGD_NEG_MODE(V) PARALLEL 2;

    SELECT COUNT(*) AS AFTER_REJECT_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_MODE_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_NEG_MODE_OK';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGD_NEG_MODE_%';
    SELECT COUNT(*) AS HIDDEN_FALLBACK_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGD_NEG_MODE_%'
            OR INDEX_NAME LIKE '$GIR_NGD_NEG_MODE_%');
    SELECT /*+ INDEX(NGD_NEG_MODE, NGD_NEG_MODE_OK) */ P, K, V
      FROM NGD_NEG_MODE ORDER BY K;
    DELETE FROM NGD_NEG_MODE WHERE P = 1;
    INSERT INTO NGD_NEG_MODE VALUES (21, 121, 221);
    SELECT /*+ INDEX(NGD_NEG_MODE, NGD_NEG_MODE_OK) */ P, K, V
      FROM NGD_NEG_MODE ORDER BY K;

    CREATE INDEX NGD_NEG_MODE_TRY ON NGD_NEG_MODE(V);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_NEG_MODE_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_NEG_MODE;
    SKIP END;
}
