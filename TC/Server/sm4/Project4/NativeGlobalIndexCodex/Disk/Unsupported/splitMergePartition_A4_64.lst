$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_NEG_SPLIT (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P11 VALUES LESS THAN (10),
        PARTITION P12 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE TABLE NGD_NEG_MERGE (P INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P11 VALUES LESS THAN (10),
        PARTITION P12 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE INDEX NGD_NEG_SPLIT_I ON NGD_NEG_SPLIT(K);
Create success.
$T0> CREATE INDEX NGD_NEG_MERGE_I ON NGD_NEG_MERGE(K);
Create success.

