$T0> ALTER TABLE NGD_NEG_SPLIT
        SPLIT PARTITION P11 AT (5) INTO
        (
            PARTITION P111,
            PARTITION P112
        );
[ERR-31481 : A rollbackable DDL execution fails, because the table has global non partitioned index ( NGD_NEG_SPLIT_I ).]

$T0> ALTER TABLE NGD_NEG_MERGE
        MERGE PARTITIONS P11, P12 INTO PARTITION P1;
[ERR-31481 : A rollbackable DDL execution fails, because the table has global non partitioned index ( NGD_NEG_MERGE_I ).]

