$T0> CREATE TABLE NGD_TRX_ALL (P INTEGER, K1 INTEGER, K2 INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    ENABLE ROW MOVEMENT
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE UNIQUE INDEX NGD_TRX_ALL_U ON NGD_TRX_ALL(K1);
Create success.
$T0> CREATE INDEX NGD_TRX_ALL_I ON NGD_TRX_ALL(K2 DESC);
