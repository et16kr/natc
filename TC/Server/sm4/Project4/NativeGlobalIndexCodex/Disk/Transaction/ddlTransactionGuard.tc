###########################################################################
# TestCase Description = Reject Disk native DDL during an active transaction.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-TRX-004
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    AUTOCOMMIT ON;
    DROP TABLE NGD_TRX_DDL;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_TRX_DDL (P INTEGER, K1 INTEGER, K2 INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_TRX_DDL_I ON NGD_TRX_DDL(K1);
    INSERT INTO NGD_TRX_DDL VALUES (1, 101, 201);
    INSERT INTO NGD_TRX_DDL VALUES (11, 111, 211);

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_TRX_DDL_%';

    AUTOCOMMIT OFF;
    INSERT INTO NGD_TRX_DDL VALUES (21, 121, 221);
    CREATE INDEX NGD_TRX_DDL_NEW ON NGD_TRX_DDL(K2);
    SELECT P, K1, K2 FROM NGD_TRX_DDL ORDER BY K1;
    ROLLBACK;
    AUTOCOMMIT ON;

    SELECT COUNT(*) AS AFTER_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_TRX_DDL_%';
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_TRX_DDL_I';
    SELECT P, K1, K2 FROM NGD_TRX_DDL ORDER BY K1;

    CREATE INDEX NGD_TRX_DDL_NEW ON NGD_TRX_DDL(K2);
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_TRX_DDL_%'
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ROLLBACK;
    AUTOCOMMIT ON;
    DROP TABLE NGD_TRX_DDL;
    SKIP END;
}
