$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> AUTOCOMMIT ON;
$T0> DROP TABLE NGD_TRX_DDL;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_TRX_DDL (P INTEGER, K1 INTEGER, K2 INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE INDEX NGD_TRX_DDL_I ON NGD_TRX_DDL(K1);
Create success.
$T0> INSERT INTO NGD_TRX_DDL VALUES (1, 101, 201);
1 row inserted.
$T0> INSERT INTO NGD_TRX_DDL VALUES (11, 111, 211);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT COUNT(*) AS BEFORE_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME LIKE 'NGD_TRX_DDL_%';
BEFORE_INDEX_COUNT   
-----------------------
1                    
1 row selected.

$T0> AUTOCOMMIT OFF;
Set autocommit off success.
$T0> INSERT INTO NGD_TRX_DDL VALUES (21, 121, 221);
1 row inserted.
$T0> CREATE INDEX NGD_TRX_DDL_NEW ON NGD_TRX_DDL(K2);
Create success.
