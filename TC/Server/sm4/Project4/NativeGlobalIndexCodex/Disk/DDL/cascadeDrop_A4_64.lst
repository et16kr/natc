$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_DDL_CASCADE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_DDL_CASCADE
    (
        P INTEGER,
        ID INTEGER NOT NULL,
        K1 INTEGER,
        K2 INTEGER
    )
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> ALTER TABLE NGD_DDL_CASCADE
        ADD CONSTRAINT NGD_DDL_CASCADE_PK PRIMARY KEY(ID);
Alter success.

$T0> CREATE INDEX NGD_DDL_CASCADE_I1 ON NGD_DDL_CASCADE(K1);
Create success.
$T0> CREATE INDEX NGD_DDL_CASCADE_I2 ON NGD_DDL_CASCADE(K2);
Create success.

$T0> INSERT INTO NGD_DDL_CASCADE VALUES (1, 1, 10, 100);
1 row inserted.
$T0> INSERT INTO NGD_DDL_CASCADE VALUES (2, 2, 20, 200);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT COUNT(*) AS INDEX_COUNT_BEFORE_DROP
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN
