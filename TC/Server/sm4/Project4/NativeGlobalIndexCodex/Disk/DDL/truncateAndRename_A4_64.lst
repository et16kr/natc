$T0> CREATE TABLE NGD_DDL_TRUNC (P INTEGER, K INTEGER, V VARCHAR(16))
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE UNIQUE INDEX NGD_DDL_TRUNC_OLD ON NGD_DDL_TRUNC(K);
Create success.
$T0> CREATE INDEX NGD_DDL_TRUNC_LOCAL ON NGD_DDL_TRUNC(P) LOCAL;
Create success.

