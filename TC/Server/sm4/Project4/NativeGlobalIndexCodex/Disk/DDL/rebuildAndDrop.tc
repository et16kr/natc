###########################################################################
# TestCase Description = Rebuild and drop a Disk native global index.
# Project ID           = NativeGlobalIndexCodex
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DDL_REBUILD;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_DDL_REBUILD (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;

    INSERT INTO NGD_DDL_REBUILD VALUES (1, 101, 1);
    INSERT INTO NGD_DDL_REBUILD VALUES (11, 111, 2);
    INSERT INTO NGD_DDL_REBUILD VALUES (21, 121, 3);

    CREATE INDEX NGD_DDL_REBUILD_I ON NGD_DDL_REBUILD(K);

##################################
SECTOR; TEST
##################################
    ALTER INDEX NGD_DDL_REBUILD_I REBUILD;

    SELECT /*+ INDEX(NGD_DDL_REBUILD, NGD_DDL_REBUILD_I) */
           P, K, V
      FROM NGD_DDL_REBUILD
     ORDER BY K;

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_DDL_REBUILD_I';

    DROP INDEX NGD_DDL_REBUILD_I;

    SELECT COUNT(*) AS INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_DDL_REBUILD_I';

    SELECT P, K, V FROM NGD_DDL_REBUILD ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DDL_REBUILD;
    SKIP END;
}

