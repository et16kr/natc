$T0> ###########################################################################
$T0> # TestCase Description = Preserve a Disk index across column schema changes.
$T0> # Project ID           = NativeGlobalIndexCodex
$T0> # Verification Status  = RuntimeVerified; A4_64 oracle recorded.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLE NGD_DDL_SCHEMA;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_DDL_SCHEMA
    (
        P INTEGER,
        K INTEGER,
        V INTEGER,
        SPARE INTEGER
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE INDEX NGD_DDL_SCHEMA_I ON NGD_DDL_SCHEMA(K, V DESC);
Create success.

$T0> INSERT INTO NGD_DDL_SCHEMA VALUES (1, 101, 1, 1001);
1 row inserted.
$T0> INSERT INTO NGD_DDL_SCHEMA VALUES (11, 111, 2, 1011);
1 row inserted.
$T0> INSERT INTO NGD_DDL_SCHEMA VALUES (21, 121, 3, 1021);
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> ALTER TABLE NGD_DDL_SCHEMA ADD COLUMN (NOTE VARCHAR(16));
Alter success.
$T0> UPDATE NGD_DDL_SCHEMA SET NOTE = 'ADDED';
3 rows updated.

$T0> ALTER TABLE NGD_DDL_SCHEMA RENAME COLUMN K TO K_NEW;
Alter success.
$T0> ALTER TABLE NGD_DDL_SCHEMA DROP COLUMN (SPARE);
[ERR-31481 : A rollbackable DDL execution fails, because the table has global non partitioned index ( NGD_DDL_SCHEMA_I ).]

$T0> SELECT /*+ INDEX(NGD_DDL_SCHEMA, NGD_DDL_SCHEMA_I) */
           P, K_NEW, V, NOTE
      FROM NGD_DDL_SCHEMA
     WHERE K_NEW BETWEEN 100 AND 120
     ORDER BY K_NEW, V DESC;
