###########################################################################
# TestCase Description = Preserve Disk constraint identity across table rename.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-DDL-005
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DDL_REN_NEW;
    DROP TABLE NGD_DDL_REN_OLD;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_DDL_REN_OLD (P INTEGER, UKEY INTEGER, K INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    ALTER TABLE NGD_DDL_REN_OLD
        ADD CONSTRAINT NGD_DDL_REN_UK UNIQUE(UKEY);
    CREATE INDEX NGD_DDL_REN_I_OLD ON NGD_DDL_REN_OLD(K);
    INSERT INTO NGD_DDL_REN_OLD VALUES (1, 101, 201);
    INSERT INTO NGD_DDL_REN_OLD VALUES (11, 111, 211);

##################################
SECTOR; TEST
##################################
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGD_DDL_REN_UK', 'NGD_DDL_REN_I_OLD')
     ORDER BY INDEX_NAME;
    ALTER TABLE NGD_DDL_REN_OLD RENAME TO NGD_DDL_REN_NEW;
    ALTER INDEX NGD_DDL_REN_I_OLD RENAME TO NGD_DDL_REN_I_NEW;
    INSERT INTO NGD_DDL_REN_NEW VALUES (21, 121, 221);
    UPDATE NGD_DDL_REN_NEW SET K = 311 WHERE UKEY = 111;
    SELECT /*+ INDEX(NGD_DDL_REN_NEW, NGD_DDL_REN_UK) */ P, UKEY, K
      FROM NGD_DDL_REN_NEW ORDER BY UKEY;
    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME IN ('NGD_DDL_REN_UK', 'NGD_DDL_REN_I_NEW')
     ORDER BY INDEX_NAME;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_DDL_REN_NEW;
    DROP TABLE NGD_DDL_REN_OLD;
    SKIP END;
}
