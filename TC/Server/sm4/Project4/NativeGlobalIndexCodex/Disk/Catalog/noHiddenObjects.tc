###########################################################################
# TestCase Description = Verify native Disk index creates no hidden objects.
# Project ID           = NativeGlobalIndexCodex
# Prototype Status     = SourceOnly; tagged oracle pending server gate.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CAT_HIDDEN;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_CAT_HIDDEN
    (
        P INTEGER,
        K INTEGER
    )
    PARTITION BY HASH(P)
    (
        PARTITION P1,
        PARTITION P2,
        PARTITION P3
    )
    TABLESPACE SYS_TBS_DISK_DATA;

    CREATE INDEX NGD_CAT_HIDDEN_I
        ON NGD_CAT_HIDDEN(K)
        TABLESPACE SYS_TBS_DISK_DATA;

##################################
SECTOR; TEST
##################################
    SELECT COUNT(*) AS HIDDEN_TABLE_COUNT
      FROM SYSTEM_.SYS_TABLES_
     WHERE USER_ID = USER_ID()
       AND TABLE_NAME LIKE '$GIT_NGD_CAT_HIDDEN_I%';

    SELECT COUNT(*) AS HIDDEN_INDEX_COUNT
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND (INDEX_NAME LIKE '$GIK_NGD_CAT_HIDDEN_I%'
            OR INDEX_NAME LIKE '$GIR_NGD_CAT_HIDDEN_I%');

    SELECT INDEX_NAME, INDEX_IMPL_TYPE, INDEX_TABLE_ID
      FROM SYSTEM_.SYS_INDICES_
     WHERE USER_ID = USER_ID()
       AND INDEX_NAME = 'NGD_CAT_HIDDEN_I';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_CAT_HIDDEN;
    SKIP END;
}

