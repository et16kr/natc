$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_QRY_OPT (P INTEGER, GKEY INTEGER, LKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.
$T0> CREATE INDEX NGD_QRY_OPT_G ON NGD_QRY_OPT(GKEY);
Create success.
$T0> CREATE INDEX NGD_QRY_OPT_L ON NGD_QRY_OPT(LKEY) LOCAL;
Create success.
