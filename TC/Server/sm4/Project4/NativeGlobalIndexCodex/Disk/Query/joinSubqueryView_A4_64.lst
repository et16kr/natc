$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_QRY_JOIN_A (P INTEGER, K VARCHAR(16), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE TABLE NGD_QRY_JOIN_B (P INTEGER, K VARCHAR(16), V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE INDEX NGD_QRY_JOIN_A_I ON NGD_QRY_JOIN_A(K);
Create success.
$T0> CREATE INDEX NGD_QRY_JOIN_B_I ON NGD_QRY_JOIN_B(K);
Create success.

