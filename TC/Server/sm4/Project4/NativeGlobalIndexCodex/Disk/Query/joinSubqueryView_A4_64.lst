$T0> CREATE VIEW NGD_QRY_JOIN_V AS
        SELECT P, K, V FROM NGD_QRY_JOIN_A WHERE V >= 20;
Create success.

$T0> ##################################
$T0> SECTOR 2; TEST
$T0> ##################################
$T0> SELECT A.P, A.K, A.V, B.P, B.V
      FROM NGD_QRY_JOIN_A A,
           NGD_QRY_JOIN_B B
     WHERE A.K = B.K
     ORDER BY A.K, A.P, B.P;
P           K                 V           P           V           
------------------------------------------------------------------------
1           K-A               10          2           100         
21          K-C               30          12          300         
2 rows selected.

$T0> SELECT A.P, A.K, A.V, B.P, B.V
      FROM NGD_QRY_JOIN_A A LEFT OUTER JOIN NGD_QRY_JOIN_B B
        ON A.K = B.K
     ORDER BY A.P, B.P;
P           K                 V           P           V           
------------------------------------------------------------------------
1           K-A               10          2           100         
11          K-B               20                                  
21          K-C               30          12          300         
22          K-D               40                                  
4 rows selected.

$T0> SELECT P, K, V
      FROM NGD_QRY_JOIN_A
     WHERE K IN (SELECT K FROM NGD_QRY_JOIN_B WHERE V < 500)
     ORDER BY K, P;
P           K                 V           
----------------------------------------------
1           K-A               10          
21          K-C               30          
2 rows selected.

$T0> SELECT A.P, A.K, A.V
      FROM NGD_QRY_JOIN_A A
     WHERE EXISTS
           (SELECT 1 FROM NGD_QRY_JOIN_B B
             WHERE B.K = A.K AND B.V > A.V)
     ORDER BY A.K, A.P;
P           K                 V           
----------------------------------------------
1           K-A               10          
21          K-C               30          
2 rows selected.

$T0> SELECT V.P, V.K, V.V, B.V
