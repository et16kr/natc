###########################################################################
# TestCase Description = Search Disk NULL, skew, and duplicate native keys.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-QRY-009
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_QRY_SKEW;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_QRY_SKEW (P INTEGER, K INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_QRY_SKEW_I ON NGD_QRY_SKEW(K);
    INSERT INTO NGD_QRY_SKEW VALUES (1, NULL, 1);
    INSERT INTO NGD_QRY_SKEW VALUES (2, NULL, 2);
    INSERT INTO NGD_QRY_SKEW VALUES (3, 10, 3);
    INSERT INTO NGD_QRY_SKEW VALUES (11, 10, 4);
    INSERT INTO NGD_QRY_SKEW VALUES (12, 10, 5);
    INSERT INTO NGD_QRY_SKEW VALUES (21, 20, 6);

##################################
SECTOR; TEST
##################################
    SELECT /*+ INDEX(NGD_QRY_SKEW, NGD_QRY_SKEW_I) */ P, K, V
      FROM NGD_QRY_SKEW WHERE K = 10 ORDER BY P, V;
    SELECT /*+ FULL SCAN(NGD_QRY_SKEW) */ P, K, V
      FROM NGD_QRY_SKEW WHERE K = 10 ORDER BY P, V;
    SELECT P, K, V FROM NGD_QRY_SKEW WHERE K IS NULL ORDER BY P, V;
    SELECT K, COUNT(*) FROM NGD_QRY_SKEW
     GROUP BY K ORDER BY K;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_QRY_SKEW;
    SKIP END;
}
