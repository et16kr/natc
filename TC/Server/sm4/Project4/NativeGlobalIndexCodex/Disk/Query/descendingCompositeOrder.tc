###########################################################################
# TestCase Description = Scan Disk mixed ASC and DESC composite keys.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-QRY-010
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_QRY_DESC;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_QRY_DESC (P INTEGER, K1 INTEGER, K2 INTEGER, K3 INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_QRY_DESC_I ON NGD_QRY_DESC(K1 ASC, K2 DESC, K3 ASC);
    INSERT INTO NGD_QRY_DESC VALUES (1, 1, 30, 1);
    INSERT INTO NGD_QRY_DESC VALUES (11, 1, 20, 2);
    INSERT INTO NGD_QRY_DESC VALUES (21, 1, 10, 3);
    INSERT INTO NGD_QRY_DESC VALUES (5, 2, 30, 4);
    INSERT INTO NGD_QRY_DESC VALUES (15, 2, 20, 5);

##################################
SECTOR; TEST
##################################
    SELECT /*+ INDEX(NGD_QRY_DESC, NGD_QRY_DESC_I) */ P, K1, K2, K3
      FROM NGD_QRY_DESC
     WHERE K1 BETWEEN 1 AND 2
     ORDER BY K1 ASC, K2 DESC, K3 ASC;
    SELECT /*+ FULL SCAN(NGD_QRY_DESC) */ P, K1, K2, K3
      FROM NGD_QRY_DESC
     WHERE K1 BETWEEN 1 AND 2
     ORDER BY K1 ASC, K2 DESC, K3 ASC;
    SELECT P, K1, K2, K3 FROM NGD_QRY_DESC
     WHERE K1 = 1 AND K2 BETWEEN 10 AND 30
     ORDER BY K2 DESC, K3;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE NGD_QRY_DESC;
    SKIP END;
}
