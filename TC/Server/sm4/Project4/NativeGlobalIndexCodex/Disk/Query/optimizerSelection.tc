###########################################################################
# TestCase Description = Compare unhinted, local, native, and full Disk scans.
# Project ID           = NativeGlobalIndexCodex
# Test ID              = NGI-QRY-005
# Verification Status  = RuntimeVerified; A4_64 oracle recorded.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    SKIP BEGIN;
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    DROP TABLE NGD_QRY_OPT;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TABLE NGD_QRY_OPT (P INTEGER, GKEY INTEGER, LKEY INTEGER, V INTEGER)
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    ) TABLESPACE SYS_TBS_DISK_DATA;
    CREATE INDEX NGD_QRY_OPT_G ON NGD_QRY_OPT(GKEY);
    CREATE INDEX NGD_QRY_OPT_L ON NGD_QRY_OPT(LKEY) LOCAL;
    INSERT INTO NGD_QRY_OPT VALUES (1, 101, 1, 10);
    INSERT INTO NGD_QRY_OPT VALUES (5, 105, 5, 20);
    INSERT INTO NGD_QRY_OPT VALUES (11, 111, 1, 30);
    INSERT INTO NGD_QRY_OPT VALUES (15, 115, 5, 40);
    INSERT INTO NGD_QRY_OPT VALUES (21, 121, 1, 50);

##################################
SECTOR; TEST
##################################
    ALTER SESSION SET EXPLAIN PLAN = ON;
    SELECT P, GKEY, LKEY, V FROM NGD_QRY_OPT
     WHERE GKEY BETWEEN 105 AND 121 ORDER BY GKEY;
    SELECT /*+ INDEX(NGD_QRY_OPT, NGD_QRY_OPT_G) */ P, GKEY, LKEY, V
      FROM NGD_QRY_OPT WHERE GKEY BETWEEN 105 AND 121 ORDER BY GKEY;
    SELECT /*+ FULL SCAN(NGD_QRY_OPT) */ P, GKEY, LKEY, V
      FROM NGD_QRY_OPT WHERE GKEY BETWEEN 105 AND 121 ORDER BY GKEY;
    SELECT /*+ INDEX(NGD_QRY_OPT, NGD_QRY_OPT_L) */ P, GKEY, LKEY, V
      FROM NGD_QRY_OPT WHERE LKEY = 1 ORDER BY GKEY;
    ALTER SESSION SET EXPLAIN PLAN = OFF;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    ALTER SESSION SET EXPLAIN PLAN = OFF;
    DROP TABLE NGD_QRY_OPT;
    SKIP END;
}
