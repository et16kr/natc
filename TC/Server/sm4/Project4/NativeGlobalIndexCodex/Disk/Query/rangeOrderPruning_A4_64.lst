$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> ALTER SESSION SET EXPLAIN PLAN = OFF;
$T0> DROP TABLE NGD_QRY_RANGE;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TABLE NGD_QRY_RANGE
    (
        P INTEGER,
        K INTEGER,
        V VARCHAR(16)
    )
    PARTITION BY RANGE(P)
    (
        PARTITION P1 VALUES LESS THAN (10),
        PARTITION P2 VALUES LESS THAN (20),
        PARTITION PD VALUES DEFAULT
    )
    TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$T0> CREATE INDEX NGD_QRY_RANGE_I ON NGD_QRY_RANGE(K);
Create success.

$T0> INSERT INTO NGD_QRY_RANGE VALUES (1, 30, 'P1-C');
1 row inserted.
$T0> INSERT INTO NGD_QRY_RANGE VALUES (5, 10, 'P1-A');
1 row inserted.
$T0> INSERT INTO NGD_QRY_RANGE VALUES (11, 40, 'P2-D');
1 row inserted.
$T0> INSERT INTO NGD_QRY_RANGE VALUES (15, 20, 'P2-B');
1 row inserted.
$T0> INSERT INTO NGD_QRY_RANGE VALUES (21, 60, 'PD-F');
1 row inserted.
$T0> INSERT INTO NGD_QRY_RANGE VALUES (25, 50, 'PD-E');
1 row inserted.

$T0> ##################################
$T0> SECTOR 2; TEST
