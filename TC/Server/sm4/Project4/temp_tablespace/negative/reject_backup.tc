###########################################################################
# TestCase Description = Preserve TEMP state when NOARCHIVELOG rejects backup first.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = NOARCHIVELOG precedence and TEMP state preservation.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# iSQL Manual          = /home/et16/work/altidev4_gi/docs/manuals/altibase/Altibase_7.1/eng/iSQL User's Manual.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    # BACKUP DDL requires a SYSDBA session; see the SQL Reference manual.
    CONNECT SYS/MANAGER AS SYSDBA;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_BG_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_BG_TS
        TEMPFILE 'sdpte_bg_01.dbf' SIZE 8M AUTOEXTEND OFF;

##################################
SECTOR; BACKUP REJECTIONS
##################################
    # ERR-11098 is the expected first guard in this NOARCHIVELOG environment.
    # TEMP-specific ERR-11091 requires a separate ARCHIVELOG configuration.
    ALTER TABLESPACE SDPTE_BG_TS BEGIN BACKUP;
    ALTER TABLESPACE SDPTE_BG_TS END BACKUP;
    ALTER TABLESPACE SYS_TBS_DISK_TEMP BEGIN BACKUP;

    SELECT CASE
               WHEN T.TYPE = 6
                AND T.STATE = 2
                AND T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND D.CURRSIZE = 1024
                AND D.OPENED = 0
               THEN 1 ELSE 0
           END AS PASS_BACKUP_REJECTIONS_UNCHANGED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_BG_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_BG_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
