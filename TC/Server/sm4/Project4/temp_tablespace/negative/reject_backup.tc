###########################################################################
# TestCase Description = Reject TEMP backup commands without changing its public state.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T-DDL-32, T-ND-01, T-REG-02, S-03.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_BG_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_BG_TS
        TEMPFILE 'sdpte_bg_01.dbf' SIZE 8M AUTOEXTEND OFF;

##################################
SECTOR; BACKUP REJECTIONS
##################################
    # Expected errors: temporary tablespaces do not enter online backup.
    ALTER TABLESPACE SDPTE_BG_TS BEGIN BACKUP;
    ALTER TABLESPACE SDPTE_BG_TS END BACKUP;
    ALTER TABLESPACE SYS_TBS_DISK_TEMP BEGIN BACKUP;

    SELECT CASE
               WHEN T.TYPE = 6
                AND T.STATE = 2
                AND T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND D.CURRSIZE = 1024
                AND D.OPENED = 1
               THEN 1 ELSE 0
           END AS PASS_BACKUP_REJECTIONS_UNCHANGED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_BG_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_BG_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
