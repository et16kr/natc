$T0> #                        design 9.11 USER-only DISCARD; the new manager must not widen any of them
$T0> #                        into a successful no-op.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteReject.cpp sdpteReject::operation
$T0> #                        src/qp/qdt/qdtAlter.cpp validateTBSOnlineOrOffline / validateBackupTBS
