###########################################################################
# TestCase Description = Keep the DATAFILE/TEMPFILE keyword guard on every ALTER TABLESPACE form.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 2.3 and A-20: the existing QP validator decides the keyword/type
#                        match, and the statement-sized TEMP DROP path must not bypass it.
# Product Reference    = src/qp/qdt/qdtAlter.cpp isDiskTBSType, validateRenameOrDropFile,
#                        validateAddFile, validateModifyFile, executeDropFile
#                        src/sm/sdp/sdpTableSpace.cpp sdpTableSpace::removeDataFiles
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_KM_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_KM_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_03.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_new.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_bad.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_KM_DATA
        DATAFILE 'sdptec_km_data_01.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_km_data_02.dbf' SIZE 4M AUTOEXTEND OFF;

    CREATE TEMPORARY TABLESPACE SDPTEC_KM_TS
        TEMPFILE 'sdptec_km_01.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_km_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_km_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

##################################
SECTOR; DATAFILE FORMS AGAINST A TEMP TABLESPACE
##################################
    ALTER TABLESPACE SDPTEC_KM_TS ADD DATAFILE
        'sdptec_km_bad.dbf' SIZE 4M AUTOEXTEND OFF;

    ALTER TABLESPACE SDPTEC_KM_TS
        DROP DATAFILE 'sdptec_km_02.dbf';

    ALTER TABLESPACE SDPTEC_KM_TS
        DROP DATAFILE 'sdptec_km_02.dbf', 'sdptec_km_03.dbf';

    ALTER TABLESPACE SDPTEC_KM_TS
        ALTER DATAFILE 'sdptec_km_01.dbf' SIZE 8M;

    ALTER TABLESPACE SDPTEC_KM_TS
        ALTER DATAFILE 'sdptec_km_01.dbf'
            AUTOEXTEND ON NEXT 1M MAXSIZE 32M;

    ALTER TABLESPACE SDPTEC_KM_TS
        RENAME DATAFILE 'sdptec_km_02.dbf' TO 'sdptec_km_new.dbf';

##################################
SECTOR; TEMPFILE FORMS AGAINST A DATA TABLESPACE
##################################
    ALTER TABLESPACE SDPTEC_KM_DATA ADD TEMPFILE
        'sdptec_km_bad.dbf' SIZE 4M AUTOEXTEND OFF;

    ALTER TABLESPACE SDPTEC_KM_DATA
        DROP TEMPFILE 'sdptec_km_data_02.dbf';

    ALTER TABLESPACE SDPTEC_KM_DATA
        ALTER TEMPFILE 'sdptec_km_data_01.dbf' SIZE 8M;

    ALTER TABLESPACE SDPTEC_KM_DATA
        RENAME TEMPFILE 'sdptec_km_data_02.dbf' TO 'sdptec_km_new.dbf';

##################################
SECTOR; VERIFY NO MUTATION ON EITHER SIDE
##################################
    SELECT CASE
               WHEN T.TYPE = 6
                AND T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.NEXT_FILE_ID = 3
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 1536
                AND F.AUTOEXTEND_ON_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_TEMP_SIDE_UNCHANGED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.AUTOEXTEND = 1 THEN 1 ELSE 0 END)
                        AS AUTOEXTEND_ON_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_KM_TS' ) F
     WHERE T.NAME = 'SDPTEC_KM_TS';

    SELECT CASE
               WHEN T.TYPE = 4
                AND T.DATAFILE_COUNT = 2
                AND F.FILE_COUNT = 2
                AND F.TOTAL_CURRENT = 1024
                AND F.AUTOEXTEND_ON_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DATA_SIDE_UNCHANGED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.AUTOEXTEND = 1 THEN 1 ELSE 0 END)
                        AS AUTOEXTEND_ON_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_KM_DATA' ) F
     WHERE T.NAME = 'SDPTEC_KM_DATA';

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_km_bad.dbf" )
    {
        PRINT "FAIL_REJECTED_FILE_CREATED";
    }
    ELSE
    {
        PRINT "PASS_REJECTED_FILE_NOT_CREATED";
    }

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_KM_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_KM_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    # Refused ADD/RENAME targets never belong to either tablespace.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_new.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_km_bad.dbf";
}
