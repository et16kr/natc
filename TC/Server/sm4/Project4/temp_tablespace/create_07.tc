###########################################################################
# TestCase Description = Independent CREATE TEMP case 07.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_CREATE_07
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE07 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_CRE07 TEMPFILE 'sdpte_create_07_01.dbf' SIZE 8M AUTOEXTEND OFF EXTENTSIZE 1M;

    SELECT CASE WHEN D.EXTENT_PAGE_COUNT=128 THEN 1 ELSE 0 END AS PASS_CREATE_07 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_CRE07' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE07 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
