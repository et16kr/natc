###########################################################################
# TestCase Description = Independent ADDDROP TEMP case 05.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_ADDDROP_05
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ADD05 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_ADD05 TEMPFILE 'sdpte_adddrop_05_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_ADD05 ADD TEMPFILE 'sdpte_adddrop_05_02.dbf' SIZE 4M AUTOEXTEND OFF, 'sdpte_adddrop_05_03.dbf' SIZE 8M AUTOEXTEND OFF; ALTER TABLESPACE SDPTE_ADD05 DROP TEMPFILE 'sdpte_adddrop_05_02.dbf','sdpte_adddrop_05_03.dbf';
    SELECT CASE WHEN D.DATAFILE_COUNT=1 THEN 1 ELSE 0 END AS PASS_ADDDROP_05 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_ADD05' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ADD05 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

