###########################################################################
# TestCase Description = Refuse CONTROL CREATE DATAFILE when the target path already exists.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = the CONTROL recreate lane never adopts or overwrites an existing inode. A
#                        refused recreate leaves the registered pathname unchanged, so a later
#                        recreate onto a free path still succeeds and survives a restart.
# Product Reference    = src/sm/sdp/sdpte/sdpteHandler.cpp:3606 smERR_ABORT_AlreadyExistFile on
#                        SDPTE_CONTROL_LANE_TARGET_EXISTS
#                        src/sm/sdp/sdpte/sdpteControlLane.cpp createDataFile
# Oracle Note          = control/createDatafile.tc runs this rejection under NODISPLAY and asserts
#                        only the aggregate outcome, so the error itself never reaches an oracle.
#                        Here the CONTROL session output is visible, following
#                        control/phaseBoundaryForTempCommands.tc.
# Admin Manual         = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Administrator's Manual.md
# iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
# ATAF Process Ref     = TC/Server/sm4/Bugs/BUG-35443/initialize.tc
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_TE_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_squatter.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_free.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_TE_TS
        TEMPFILE 'sdpte_te_01.dbf' SIZE 8M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    NODISPLAY ON;
    CALL stdServerStop();

    # A squatter occupies a path the recreate could be pointed at, and the
    # registered file itself is removed so the space needs a recreate.
    CP "${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf" "${ALTIBASE_HOME}/dbs/sdpte_te_squatter.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf";
    NODISPLAY OFF;

##################################
SECTOR; CONTROL RECREATE REFUSES EVERY OCCUPIED TARGET
##################################
    $sPrompt = "$$EOF$$";

    NODISPLAY ON;
    EXEC SDPTE_TE_CONTROL -t 1800 $gStdIsqlSys;
    SEND SDPTE_TE_CONTROL "startup control";
    P_WAIT SDPTE_TE_CONTROL $sPrompt;
    NODISPLAY OFF;

    # An occupied AS target is refused even though the registered path is free.
    SEND SDPTE_TE_CONTROL "ALTER DATABASE CREATE DATAFILE '${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf' AS '${ALTIBASE_HOME}/dbs/sdpte_te_squatter.dbf';";
    P_WAIT SDPTE_TE_CONTROL $sPrompt;

    # The registered path is still free, so a plain recreate succeeds.
    SEND SDPTE_TE_CONTROL "ALTER DATABASE CREATE DATAFILE '${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf';";
    P_WAIT SDPTE_TE_CONTROL $sPrompt;

    # Now the registered path is occupied by the file just created, so a repeat
    # of the same command is refused.
    SEND SDPTE_TE_CONTROL "ALTER DATABASE CREATE DATAFILE '${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf';";
    P_WAIT SDPTE_TE_CONTROL $sPrompt;

    # A rename onto a free path still works after those refusals.
    SEND SDPTE_TE_CONTROL "ALTER DATABASE CREATE DATAFILE '${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf' AS '${ALTIBASE_HOME}/dbs/sdpte_te_free.dbf';";
    P_WAIT SDPTE_TE_CONTROL $sPrompt;

    NODISPLAY ON;
    SEND SDPTE_TE_CONTROL "ALTER DATABASE MYDB SERVICE;";
    P_WAIT SDPTE_TE_CONTROL $sPrompt;
    SEND SDPTE_TE_CONTROL "quit";
    P_WAIT SDPTE_TE_CONTROL;
    NODISPLAY OFF;

##################################
SECTOR; ONLY THE FREE PATH WAS ADOPTED
##################################
    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 1
                AND SUM(CASE WHEN D.NAME LIKE '%sdpte_te_free.dbf'
                              AND D.CURRSIZE = 1024
                              AND D.AUTOEXTEND = 0 THEN 1 ELSE 0 END) = 1
                AND MIN(T.TOTAL_PAGE_COUNT) = 1024
                AND MIN(T.ALLOCATED_PAGE_COUNT) = 0
               THEN 1 ELSE 0
           END AS PASS_ONLY_FREE_PATH_ADOPTED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_TE_TS';

    # The squatter was never adopted and was never unlinked.
    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdpte_te_squatter.dbf" )
    {
        PRINT "PASS_SQUATTER_UNTOUCHED";
    }
    ELSE
    {
        PRINT "FAIL_SQUATTER_UNTOUCHED";
    }

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_SQUATTER_NOT_REGISTERED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND D.NAME LIKE '%sdpte_te_squatter.dbf';

##################################
SECTOR; THE ADOPTED PATH IS DURABLE AND THE SPACE IS USABLE
##################################
    ALTER TABLESPACE SDPTE_TE_TS
        ALTER TEMPFILE 'sdpte_te_free.dbf' SIZE 16M;

    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 1
                AND SUM(CASE WHEN D.NAME LIKE '%sdpte_te_free.dbf'
                              AND D.CURRSIZE = 2048 THEN 1 ELSE 0 END) = 1
                AND MIN(T.TOTAL_PAGE_COUNT) = 2048
                AND MIN(T.ALLOCATED_PAGE_COUNT) = 0
               THEN 1 ELSE 0
           END AS PASS_ADOPTED_PATH_DURABLE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_TE_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_TE_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_squatter.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_te_free.dbf";
}
