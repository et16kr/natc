###########################################################################
# TestCase Description = Keep TEMP path commands in CONTROL and TEMP file DDL in SERVICE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.10 and 9.11 place RENAME TEMPFILE, CREATE DATAFILE and DISCARD in
#                        the CONTROL phase, while ADD/DROP/ALTER TEMPFILE are transactional SERVICE
#                        DDL; the new manager must not make either side succeed in the other phase.
# Product Reference    = src/qp/qdt/qdtAlter.cpp phase-gated execute entries
#                        src/sm/sdp/sdpte/sdpteControlLane.cpp, src/sm/sdp/sdpte/sdpteOperation.cpp
# Admin Manual         = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Administrator's Manual.md
# iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
# ATAF Process Ref     = TC/Server/sm4/Project4/temp_tablespace/control/discardLifecycle.tc
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_PB_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_pb_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_pb_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_pb_new.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_PB_TS
        TEMPFILE 'sdptec_pb_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_pb_02.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

##################################
SECTOR; CONTROL COMMANDS ARE REFUSED IN SERVICE
##################################
    ALTER TABLESPACE SDPTEC_PB_TS
        RENAME TEMPFILE '${ALTIBASE_HOME}/dbs/sdptec_pb_02.dbf'
                     TO '${ALTIBASE_HOME}/dbs/sdptec_pb_new.dbf';

    ALTER TABLESPACE SDPTEC_PB_TS DISCARD;

    CONNECT SYS/MANAGER AS SYSDBA;

    ALTER DATABASE CREATE DATAFILE '${ALTIBASE_HOME}/dbs/sdptec_pb_02.dbf';

    # Release the local SYSDBA/admin connection before stdServerStop() opens
    # its own admin iSQL process.
    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.STATE = 2
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
                AND F.NEW_PATH_COUNT = 0
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_CONTROL_COMMANDS_REFUSED_IN_SERVICE
      FROM V$TABLESPACES T,
           ( SELECT SUM(CASE WHEN D.NAME LIKE '%sdptec_pb_new.dbf' THEN 1 ELSE 0 END)
                        AS NEW_PATH_COUNT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_PB_TS' ) F
     WHERE T.NAME = 'SDPTEC_PB_TS';

##################################
SECTOR; SERVICE DDL IS REFUSED IN CONTROL
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    NODISPLAY OFF;

    $sPrompt = "$$EOF$$";

    NODISPLAY ON;
    EXEC SDPTEC_PB_CONTROL -t 1800 $gStdIsqlSys;
    SEND SDPTEC_PB_CONTROL "startup control";
    P_WAIT SDPTEC_PB_CONTROL $sPrompt;
    NODISPLAY OFF;

    SEND SDPTEC_PB_CONTROL "ALTER TABLESPACE SDPTEC_PB_TS ADD TEMPFILE '${ALTIBASE_HOME}/dbs/sdptec_pb_new.dbf' SIZE 4M AUTOEXTEND OFF;";
    P_WAIT SDPTEC_PB_CONTROL $sPrompt;
    PRINT $Ret_;

    SEND SDPTEC_PB_CONTROL "ALTER TABLESPACE SDPTEC_PB_TS DROP TEMPFILE '${ALTIBASE_HOME}/dbs/sdptec_pb_02.dbf';";
    P_WAIT SDPTEC_PB_CONTROL $sPrompt;
    PRINT $Ret_;

    SEND SDPTEC_PB_CONTROL "ALTER TABLESPACE SDPTEC_PB_TS ALTER TEMPFILE '${ALTIBASE_HOME}/dbs/sdptec_pb_01.dbf' SIZE 16M;";
    P_WAIT SDPTEC_PB_CONTROL $sPrompt;
    PRINT $Ret_;

    SEND SDPTEC_PB_CONTROL "DROP TABLESPACE SDPTEC_PB_TS INCLUDING CONTENTS AND DATAFILES;";
    P_WAIT SDPTEC_PB_CONTROL $sPrompt;
    PRINT $Ret_;

    NODISPLAY ON;
    SEND SDPTEC_PB_CONTROL "ALTER DATABASE MYDB SERVICE;";
    P_WAIT SDPTEC_PB_CONTROL $sPrompt;
    SEND SDPTEC_PB_CONTROL "quit";
    P_WAIT SDPTEC_PB_CONTROL;
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.STATE = 2
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.NEXT_FILE_ID = 2
                AND F.TOTAL_CURRENT = 1536
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_SERVICE_DDL_REFUSED_IN_CONTROL
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_PB_TS' ) F
     WHERE T.NAME = 'SDPTEC_PB_TS';

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_pb_new.dbf" )
    {
        PRINT "FAIL_CONTROL_ADD_CREATED_FILE";
    }
    ELSE
    {
        PRINT "PASS_CONTROL_ADD_CREATED_NO_FILE";
    }

##################################
SECTOR; SERVICE DDL STILL WORKS AFTERWARDS
##################################
    ALTER TABLESPACE SDPTEC_PB_TS ADD TEMPFILE
        'sdptec_pb_new.dbf' SIZE 4M AUTOEXTEND OFF;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND T.NEXT_FILE_ID = 3
               THEN 1 ELSE 0
           END AS PASS_SERVICE_DDL_ACCEPTED
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_PB_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_PB_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
