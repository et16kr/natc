###########################################################################
# TestCase Description = Refuse a second DISCARD of a TEMP tablespace that is already discarded.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = DISCARD is idempotent only in outcome, not in acceptance. A space that is
#                        already discarded rejects a repeat command and stays in the same state, and
#                        the rejection does not disturb a live sibling TEMP tablespace.
# Product Reference    = src/sm/sdp/sdpte/sdpteHandler.cpp:1518 smERR_ABORT_TBS_ALREADY_DISCARDED
#                        src/sm/sdp/sdpte/sdpteControlLane.cpp discard entry point
# Oracle Note          = A CONTROL session runs inside an EXEC process, so its replies do not reach
#                        this case's output. The repeated DISCARD is therefore verified through the
#                        state it leaves behind and through the SERVICE-phase rejections below,
#                        not through the CONTROL error text.
# Admin Manual         = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Administrator's Manual.md
# iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
# ATAF Process Ref     = TC/Server/sm4/Bugs/BUG-35443/initialize.tc
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_DD_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_DD_LIVE INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_DD_TS
        TEMPFILE 'sdpte_dd_01.dbf' SIZE 8M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    # A sibling that must stay untouched by every command below.
    CREATE TEMPORARY TABLESPACE SDPTE_DD_LIVE
        TEMPFILE 'sdpte_dd_live.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    NODISPLAY ON;
    CALL stdServerStop();
    NODISPLAY OFF;

##################################
SECTOR; THE SECOND DISCARD IS REJECTED
##################################
    $sPrompt = "$$EOF$$";

    NODISPLAY ON;
    EXEC SDPTE_DD_CONTROL -t 1800 $gStdIsqlSys;
    SEND SDPTE_DD_CONTROL "startup control";
    P_WAIT SDPTE_DD_CONTROL $sPrompt;
    NODISPLAY OFF;

    SEND SDPTE_DD_CONTROL "ALTER TABLESPACE SDPTE_DD_TS DISCARD;";
    P_WAIT SDPTE_DD_CONTROL $sPrompt;

    # Already discarded. This must be refused, not silently accepted.
    SEND SDPTE_DD_CONTROL "ALTER TABLESPACE SDPTE_DD_TS DISCARD;";
    P_WAIT SDPTE_DD_CONTROL $sPrompt;

    # A third attempt behaves the same way.
    SEND SDPTE_DD_CONTROL "ALTER TABLESPACE SDPTE_DD_TS DISCARD;";
    P_WAIT SDPTE_DD_CONTROL $sPrompt;

    # A space that never existed is refused on its own terms. The live sibling
    # is deliberately never named here: the point of this case is that repeated
    # rejections on one space leave every other space alone.
    SEND SDPTE_DD_CONTROL "ALTER TABLESPACE SDPTE_DD_NO_SUCH_TS DISCARD;";
    P_WAIT SDPTE_DD_CONTROL $sPrompt;

    NODISPLAY ON;
    SEND SDPTE_DD_CONTROL "ALTER DATABASE MYDB SERVICE;";
    P_WAIT SDPTE_DD_CONTROL $sPrompt;
    SEND SDPTE_DD_CONTROL "quit";
    P_WAIT SDPTE_DD_CONTROL;
    NODISPLAY OFF;

##################################
SECTOR; THE DISCARDED SPACE IS STILL DISCARDED AND ONLY DROPPABLE
##################################
    CONNECT SYS/MANAGER;

    SELECT NAME, STATE, DATAFILE_COUNT, TOTAL_PAGE_COUNT, ALLOCATED_PAGE_COUNT
      FROM V$TABLESPACES
     WHERE NAME IN ('SDPTE_DD_TS', 'SDPTE_DD_LIVE')
     ORDER BY NAME;

    # Repeated rejections left exactly one discarded space and one live one.
    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(CASE WHEN NAME = 'SDPTE_DD_TS'
                              AND ALLOCATED_PAGE_COUNT = 0 THEN 1 ELSE 0 END) = 1
                AND SUM(CASE WHEN NAME = 'SDPTE_DD_LIVE'
                              AND DATAFILE_COUNT = 1
                              AND TOTAL_PAGE_COUNT = 512
                              AND ALLOCATED_PAGE_COUNT = 0 THEN 1 ELSE 0 END) = 1
               THEN 1 ELSE 0
           END AS PASS_STATE_AFTER_REPEATED_DISCARD
      FROM V$TABLESPACES
     WHERE NAME IN ('SDPTE_DD_TS', 'SDPTE_DD_LIVE');

    # A discarded space accepts nothing but DROP.
    ALTER TABLESPACE SDPTE_DD_TS
        ALTER TEMPFILE 'sdpte_dd_01.dbf' SIZE 16M;

    ALTER TABLESPACE SDPTE_DD_TS ADD TEMPFILE
        'sdpte_dd_02.dbf' SIZE 4M AUTOEXTEND OFF;

    SELECT CASE WHEN COUNT(*) = 1 THEN 1 ELSE 0 END AS PASS_DISCARDED_ALTER_STILL_REJECTED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_DD_TS';

    DROP TABLESPACE SDPTE_DD_TS;

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_DISCARDED_SPACE_DROPPED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_DD_TS';

##################################
SECTOR; THE LIVE SIBLING WAS NEVER TOUCHED
##################################
    ALTER TABLESPACE SDPTE_DD_LIVE
        ALTER TEMPFILE 'sdpte_dd_live.dbf' SIZE 8M;

    SELECT CASE
               WHEN D.CURRSIZE = 1024
                AND T.TOTAL_PAGE_COUNT = 1024
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_LIVE_SIBLING_STILL_ALTERABLE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_DD_LIVE';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_DD_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_DD_LIVE INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_dd_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_dd_02.dbf";
}
