###########################################################################
# TestCase Description = Crash before CONTROL CREATE DATAFILE AS reaches a whole-Anchor rewrite.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = AS binding-before-path order, zero immediate Anchor force, orphan preservation.
# Admin Manual         = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Administrator's Manual.md
# iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
# Repo iSQL Fallback   = /home/et16/work/altidev4_gi/docs/manuals/altibase/trunk/eng/iSQL User's Manual.md
# ATAF Process Ref     = TC/Server/sm4/Bugs/BUG-35443/initialize.tc
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CC_PROBE INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_CC_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_cc_old.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_cc_new.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_CC_TS
        TEMPFILE 'sdpte_cc_old.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 4M MAXSIZE 32M;

    NODISPLAY ON;
    CALL stdServerStop();
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_cc_old.dbf";
    NODISPLAY OFF;

##################################
SECTOR; CREATE AS THEN ABORT CONTROL
##################################
    $sPrompt = "$$EOF$$";

    NODISPLAY ON;
    EXEC SDPTE_CC_CONTROL -t 1800 $gStdIsqlSys;
    SEND SDPTE_CC_CONTROL "startup control";
    P_WAIT SDPTE_CC_CONTROL $sPrompt;
    SEND SDPTE_CC_CONTROL "ALTER DATABASE CREATE DATAFILE '${ALTIBASE_HOME}/dbs/sdpte_cc_old.dbf' AS '${ALTIBASE_HOME}/dbs/sdpte_cc_new.dbf';";
    P_WAIT SDPTE_CC_CONTROL $sPrompt;
    SEND SDPTE_CC_CONTROL "quit";
    P_WAIT SDPTE_CC_CONTROL;

    # CREATE DATAFILE forces no file Anchor. An abort before SERVICE must load
    # the old registered path and leave the already-bound new file orphaned.
    CALL stdServerKill();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 1
                AND SUM(CASE
                            WHEN D.NAME LIKE '%sdpte_cc_old.dbf'
                             AND D.CURRSIZE = 1024
                             AND D.AUTOEXTEND = 1
                             AND D.NEXTSIZE = 512
                             AND D.MAXSIZE = 4096
                            AND D.OPENED = 0
                            THEN 1 ELSE 0
                        END) = 1
               THEN 1 ELSE 0
           END AS PASS_OLD_ANCHOR_AUTHORITATIVE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_CC_TS';

    # The new file was durably bound before the in-memory path change. It is
    # still present as a same-definition orphan.  REUSE is intentionally not
    # specified here: explicit REUSE is the documented operation that may
    # adopt a non-active orphan, while an ordinary CREATE must reject it.
    NODISPLAY ON;
    CREATE TEMPORARY TABLESPACE SDPTE_CC_PROBE
        TEMPFILE 'sdpte_cc_new.dbf' SIZE 8M AUTOEXTEND OFF;
    NODISPLAY OFF;

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_ACTIVE_ORPHAN_REJECTED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_CC_PROBE';

    SELECT CASE WHEN DATAFILE_COUNT = 1 THEN 1 ELSE 0 END AS PASS_ORIGINAL_UNCHANGED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_CC_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CC_PROBE INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_CC_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_cc_old.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_cc_new.dbf";
}
