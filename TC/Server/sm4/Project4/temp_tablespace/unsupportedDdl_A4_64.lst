 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Preserve TEMP-specific DDL rejection and error ordering at public entries.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = TEMP ONLINE/OFFLINE, file ONLINE/OFFLINE, tablespace AUTOEXTEND,
$T0> #                        DATAFILE/TEMPFILE mismatch, primary tempfile and SYSTEM TEMP guards.
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_NEG_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTE_NEG_TS
        TEMPFILE 'sdpte_neg_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdpte_neg_02.dbf' SIZE 8M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> ##################################
$T0> SECTOR 2; EXPECTED REJECTIONS
$T0> ##################################
$T0> ALTER TABLESPACE SDPTE_NEG_TS OFFLINE;
[ERR-311E7 : Unable to bring the specified tablespace online or offline.]
$T0> ALTER TABLESPACE SDPTE_NEG_TS ONLINE;
[ERR-311E7 : Unable to bring the specified tablespace online or offline.]

$T0> ALTER TABLESPACE SDPTE_NEG_TS
        ALTER TEMPFILE 'sdpte_neg_01.dbf' OFFLINE;
[ERR-41088 : Unable to execute the query in the current start-up phase]
$T0> ALTER TABLESPACE SDPTE_NEG_TS
        ALTER TEMPFILE 'sdpte_neg_01.dbf' ONLINE;
[ERR-41088 : Unable to execute the query in the current start-up phase]

$T0> ALTER TABLESPACE SDPTE_NEG_TS
        ALTER AUTOEXTEND ON NEXT 8M MAXSIZE 32M;
[ERR-31254 : Invalid ALTER TABLESPACE Statement. The tablespace to alter is neither a volatile tablespace nor a memory tablespace.]

$T0> ALTER TABLESPACE SDPTE_NEG_TS ADD DATAFILE
        'sdpte_neg_bad.dbf' SIZE 8M AUTOEXTEND OFF;
[ERR-311DA : Mismatched tablespace type. The type of the tablespace and the type of the file are different.]

$T0> ALTER TABLESPACE SDPTE_NEG_TS
        ALTER DATAFILE 'sdpte_neg_01.dbf' SIZE 16M;
[ERR-311DA : Mismatched tablespace type. The type of the tablespace and the type of the file are different.]

$T0> ALTER TABLESPACE SDPTE_NEG_TS
        DROP TEMPFILE 'sdpte_neg_01.dbf';
[ERR-11036 : The data file is in use.]

$T0> ALTER TABLESPACE SDPTE_NEG_TS
        ALTER TEMPFILE 'sdpte_neg_01.dbf'
            AUTOEXTEND ON NEXT 1M MAXSIZE 4M;
[ERR-1101F : The MAXSIZE of the data file cannot be less than its current size. ( Request Max Size : 512 pages, Current Size : 1024 pages )]

$T0> DROP TABLESPACE SYS_TBS_DISK_TEMP;
[ERR-311DB : Unable to drop the SYSTEM tablespace.]

$T0> ##################################
$T0> SECTOR 3; VERIFY NO MUTATION
$T0> ##################################
$T0> SELECT CASE
               WHEN T.TYPE = 6
                AND T.STATE = 2
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 2
                AND F.TOTAL_CURRENT = 2048
                AND F.AUTOEXTEND_ON_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_REJECTIONS_UNCHANGED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.AUTOEXTEND = 1 THEN 1 ELSE 0 END)
                        AS AUTOEXTEND_ON_COUNT
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_NEG_TS' ) F
     WHERE T.NAME = 'SDPTE_NEG_TS';
PASS_REJECTIONS_UNCHANGED 
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_NEG_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

