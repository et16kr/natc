 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Recreate a missing committed tempfile during restart and reset allocation state.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = committed D persistence, missing-file binding, post-recovery zero-allocation projection.
$T0> # Regression Focus     = recreate at the committed resized D, never at the original INIT size.
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> # ATAF Runtime         = stdFunc.i stdServerStop/stdServerStart and exact RM target.
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_RS_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTE_RS_TS
        TEMPFILE 'sdpte_rs_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdpte_rs_02.dbf' SIZE 4M
                     AUTOEXTEND ON NEXT 4M MAXSIZE 16M
        EXTENTSIZE 512K;
Create success.

$T0> ALTER TABLESPACE SDPTE_RS_TS
        ALTER TEMPFILE 'sdpte_rs_01.dbf' SIZE 12M;
Alter success.

$T0> ##################################
$T0> SECTOR 2; RESTART WITH MISSING TEMPFILE
$T0> ##################################

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> ##################################
$T0> SECTOR 3; TEST
$T0> ##################################
$T0> SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(D.CURRSIZE) = 2048
                AND SUM(CASE
                            WHEN D.NAME LIKE '%sdpte_rs_01.dbf'
                             AND D.CURRSIZE = 1536
                             AND D.AUTOEXTEND = 0
                            THEN 1 ELSE 0
                        END) = 1
                AND SUM(CASE
                            WHEN D.NAME LIKE '%sdpte_rs_02.dbf'
                             AND D.CURRSIZE = 512
                             AND D.AUTOEXTEND = 1
                             AND D.NEXTSIZE = 512
                             AND D.MAXSIZE = 2048
                            THEN 1 ELSE 0
                        END) = 1
               THEN 1 ELSE 0
           END AS PASS_RECREATE_FILES
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RS_TS';
PASS_RECREATE_FILES 
----------------------
1           
1 row selected.

$T0> SELECT CASE
               WHEN DATAFILE_COUNT = 2
                AND TOTAL_PAGE_COUNT = 2048
                AND ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RESTART_PROJECTION
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_RS_TS';
PASS_RESTART_PROJECTION 
--------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_RS_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

