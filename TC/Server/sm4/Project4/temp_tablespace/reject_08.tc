###########################################################################
# TestCase Description = Independent REJECT TEMP case 08.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_REJECT_08
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_REJ08 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_REJ08 TEMPFILE 'sdpte_reject_08_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_REJ08 ALTER TEMPFILE 'sdpte_reject_08_01.dbf' AUTOEXTEND ON NEXT 1M MAXSIZE 2M;
    SELECT CASE WHEN F.CURRSIZE=1024 THEN 1 ELSE 0 END AS PASS_REJECT_08 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_REJ08' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_REJ08 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

