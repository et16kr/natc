###########################################################################
# TestCase Description = Exclude a sub-page physical tail from the published TEMP capacity.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 6.1 and 8.3: only complete pages count as `P`, a sub-page tail is a
#                        diagnostic value that startup must neither publish nor truncate away.
# Product Reference    = src/sm/sdp/sdpte/sdpteFile.cpp physical page accounting
#                        src/sm/sdp/sdpte/sdpteReconcile.cpp startup size reconcile
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_TL_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_tl_01.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_TL_TS
        TEMPFILE 'sdptec_tl_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND T.TOTAL_PAGE_COUNT = 512
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 7
               THEN 1 ELSE 0
           END AS PASS_CREATE_BASELINE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';

##################################
SECTOR; APPEND A SUB PAGE TAIL
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    NODISPLAY OFF;

    # Fewer bytes than one disk page, so the file length is no longer a whole
    # number of pages.
    OPEN SDPTEC_TL_APPEND -m a "${ALTIBASE_HOME}/dbs/sdptec_tl_01.dbf";
    WRITE SDPTEC_TL_APPEND "SDPTEC-PARTIAL-PAGE-TAIL";
    CLOSE SDPTEC_TL_APPEND;

    NODISPLAY ON;
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND D.OPENED = 0
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 7
               THEN 1 ELSE 0
           END AS PASS_TAIL_NOT_PUBLISHED
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';

    # The tail must not stop ordinary DDL either.
    ALTER TABLESPACE SDPTEC_TL_TS
        ALTER TEMPFILE 'sdptec_tl_01.dbf' SIZE 8M;

    SELECT CASE
               WHEN D.CURRSIZE = 1024
                AND T.TOTAL_PAGE_COUNT = 1024
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 15
               THEN 1 ELSE 0
           END AS PASS_RESIZE_OVER_TAIL
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';

##################################
SECTOR; RESTART AFTER THE AUTHORIZED RESIZE
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.CURRSIZE = 1024
                AND D.OPENED = 0
                AND T.TOTAL_PAGE_COUNT = 1024
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 15
               THEN 1 ELSE 0
           END AS PASS_RESTART_AFTER_RESIZE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_TL_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
