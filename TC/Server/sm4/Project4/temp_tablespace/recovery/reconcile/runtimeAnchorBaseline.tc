###########################################################################
# TestCase Description = Recreate a missing TEMP file at committed D, not runtime-grown R.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = runtime-only R, checkpoint durability boundary, missing-file reconcile.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# ATAF Runtime         = stdFunc.i clean stop/start and exact RM target.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_AB_U CASCADE;
    DROP TABLESPACE SDPTE_AB_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_AB_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_AB_DATA
        DATAFILE 'sdpte_ab_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_AB_TS
        TEMPFILE 'sdpte_ab_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_AB_U IDENTIFIED BY SDPTE_AB_U
        DEFAULT TABLESPACE SDPTE_AB_DATA
        TEMPORARY TABLESPACE SDPTE_AB_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_AB_U/SDPTE_AB_U;

    CREATE TABLE SDPTE_AB_SOURCE
    (
        ID INTEGER,
        K1 VARCHAR(2000)
    ) TABLESPACE SDPTE_AB_DATA;

    INSERT INTO SDPTE_AB_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('B', 1790, 'B')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;

    COMMIT;

##################################
SECTOR; RUNTIME GROWTH IS NOT ANCHOR D
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_RUNTIME_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_AB_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.CURRSIZE > D.INITSIZE
                AND D.INITSIZE = 128
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_R_GT_D
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_AB_TS';

    # Even an explicit checkpoint must not turn runtime R into committed D.
    ALTER SYSTEM CHECKPOINT;

    NODISPLAY ON;
    CALL stdServerStop();
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ab_01.dbf";
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 128
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 16384
                AND D.OPENED = 1
                AND T.TOTAL_PAGE_COUNT = 128
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RECREATE_FROM_ANCHOR_D
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_AB_TS';

    CONNECT SDPTE_AB_U/SDPTE_AB_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_RECREATED_FILE_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_AB_SOURCE
           ) D;

##################################
SECTOR; FINALIZATION
##################################
    CONNECT SYS/MANAGER;
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_AB_U CASCADE;
    DROP TABLESPACE SDPTE_AB_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_AB_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
