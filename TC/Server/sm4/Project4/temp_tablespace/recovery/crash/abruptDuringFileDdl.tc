###########################################################################
# TestCase Description = Abort the server around ADD and DROP TEMPFILE and reconcile to one
#                        consistent file set after restart.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = file-set membership is all-or-nothing across an abrupt stop. After restart
#                        the catalog file count, the published total and the live file sizes must
#                        agree, no half-joined file may be bound, and the space must still serve a
#                        spill and further file DDL.
# Product Reference    = src/sm/sdp/sdpte/sdpteAddTempFile.cpp, sdpteDropTempFile.cpp
#                        src/sm/sdp/sdpte/sdpteReconcile.cpp post-recovery membership reconciliation
#                        src/sm/sdp/sdpte/sdpteBinding.cpp startup binding
# Oracle Note          = Whether each DDL commits before the abort is not controllable, so the case
#                        asserts the invariant that holds for every outcome: the file count is one
#                        of the legal values and TOTAL_PAGE_COUNT equals the sum of live CURRSIZE.
# ATAF Runtime         = stdFunc.i stdServerKill/stdServerStart.
# ATAF Process Ref     = TC/Server/sm4/Project4/temp_tablespace/recovery/crash/abruptRuntimeRestart.tc
# Manual Reference     = ALTIBASE/Documents/Manuals/Altibase_7.1/eng/SQL Reference.md,
#                        ALTER TABLESPACE (datafile_tempfile_clause). DROP
#                        TEMPFILE removes the catalog member, not the physical file.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_CK_U CASCADE;
    DROP TABLESPACE SDPTE_CK_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_CK_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ck_03.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ck_04.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_CK_DATA
        DATAFILE 'sdpte_ck_data.dbf' SIZE 16M
            AUTOEXTEND ON NEXT 16M MAXSIZE 512M;

    CREATE TEMPORARY TABLESPACE SDPTE_CK_TS
        TEMPFILE 'sdpte_ck_01.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdpte_ck_02.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE USER SDPTE_CK_U IDENTIFIED BY SDPTE_CK_U
        DEFAULT TABLESPACE SDPTE_CK_DATA
        TEMPORARY TABLESPACE SDPTE_CK_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_CK_U/SDPTE_CK_U;

    CREATE TABLE SDPTE_CK_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_CK_DATA;

    INSERT INTO SDPTE_CK_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('K', 1790, 'K')
      FROM DUAL
    CONNECT BY LEVEL <= 5000;

    COMMIT;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN DATAFILE_COUNT = 2
                AND TOTAL_PAGE_COUNT = 1024
               THEN 1 ELSE 0
           END AS PASS_PRE_ABORT_FILESET
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_CK_TS';

##################################
SECTOR; ABORT AROUND ADD TEMPFILE
##################################
    $sPrompt = "$$EOF$$";

    NODISPLAY ON;
    EXEC SDPTE_CK_ADD -t 1800 $gStdIsql;
    SEND SDPTE_CK_ADD "ALTER TABLESPACE SDPTE_CK_TS ADD TEMPFILE 'sdpte_ck_03.dbf' SIZE 64M AUTOEXTEND OFF;";
    sleep 1;
    CALL stdServerKill();
    P_WAIT SDPTE_CK_ADD $sPrompt;
    SEND SDPTE_CK_ADD "quit";
    P_WAIT SDPTE_CK_ADD;
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    # Either the add committed (3 files) or it did not (2 files). In both cases
    # the published total must equal the sum of the live file sizes.
    SELECT CASE
               WHEN T.DATAFILE_COUNT IN ( 2, 3 )
                AND T.DATAFILE_COUNT = F.FILE_COUNT
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.MIN_ID = 0
               THEN 1 ELSE 0
           END AS PASS_ADD_RECONCILED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    MIN(D.ID) AS MIN_ID
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_CK_TS' ) F
     WHERE T.NAME = 'SDPTE_CK_TS';

    CONNECT SDPTE_CK_U/SDPTE_CK_U;

    SELECT CASE WHEN COUNT(*) = 100 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_ADD_ABORT
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_CK_SOURCE
             WHERE ID <= 100
           ) D;

##################################
SECTOR; VERIFY THE LEGAL FILE SET BEFORE THE SECOND ABORT
##################################
    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.DATAFILE_COUNT IN ( 2, 3 )
                AND T.DATAFILE_COUNT = F.FILE_COUNT
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_FILESET_READY_FOR_DROP_ABORT
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_CK_TS' ) F
     WHERE T.NAME = 'SDPTE_CK_TS';

##################################
SECTOR; ABORT AROUND DROP TEMPFILE
##################################
    NODISPLAY ON;
    EXEC SDPTE_CK_DROP -t 1800 $gStdIsql;
    SEND SDPTE_CK_DROP "ALTER TABLESPACE SDPTE_CK_TS DROP TEMPFILE 'sdpte_ck_02.dbf';";
    sleep 1;
    CALL stdServerKill();
    P_WAIT SDPTE_CK_DROP $sPrompt;
    SEND SDPTE_CK_DROP "quit";
    P_WAIT SDPTE_CK_DROP;
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    # ADD may have committed or aborted, independently of this DROP. Therefore
    # one, two or three files are legal; membership, total size and OPENED state
    # must still describe one complete published file set.
    SELECT CASE
               WHEN T.DATAFILE_COUNT IN ( 1, 2, 3 )
                AND T.DATAFILE_COUNT = F.FILE_COUNT
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DROP_RECONCILED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_CK_TS' ) F
     WHERE T.NAME = 'SDPTE_CK_TS';

##################################
SECTOR; THE SPACE STILL SPILLS AND STILL ACCEPTS FILE DDL
##################################
    CONNECT SDPTE_CK_U/SDPTE_CK_U;

    SELECT CASE WHEN COUNT(*) = 100 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_DROP_ABORT
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_CK_SOURCE
             WHERE ID <= 100
           ) D;

    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_CK_TS ADD TEMPFILE
        'sdpte_ck_04.dbf' SIZE 8M AUTOEXTEND OFF;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = F.FILE_COUNT
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.HAS_NEW_FILE = 1
               THEN 1 ELSE 0
           END AS PASS_FILE_DDL_ACCEPTED_AFTER_ABORT
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.NAME LIKE '%sdpte_ck_04.dbf'
                              AND D.CURRSIZE = 1024 THEN 1 ELSE 0 END) AS HAS_NEW_FILE
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_CK_TS' ) F
     WHERE T.NAME = 'SDPTE_CK_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_CK_U CASCADE;
    DROP TABLESPACE SDPTE_CK_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_CK_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

}
