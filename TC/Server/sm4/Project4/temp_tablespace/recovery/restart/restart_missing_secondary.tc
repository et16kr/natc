###########################################################################
# TestCase Description = Independent RESTART TEMP case 03.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_RESTART_03
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_RST03 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_RST03 TEMPFILE 'sdpte_restart_03_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_RST03 ADD TEMPFILE 'sdpte_restart_03_02.dbf' SIZE 4M AUTOEXTEND OFF; RM -f "${ALTIBASE_HOME}/dbs/sdpte_restart_03_02.dbf"; NODISPLAY ON; CALL stdServerStop(); CALL stdServerStart(); NODISPLAY OFF; CONNECT SYS/MANAGER;
    SELECT CASE WHEN D.DATAFILE_COUNT=2 THEN 1 ELSE 0 END AS PASS_RESTART_03 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_RST03' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_RST03 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_restart_03_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_restart_03_02.dbf";
}
