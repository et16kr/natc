 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Add and drop multiple TEMP files as one statement.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = ADD/DROP TEMPFILE, multi-file publication, failure atomicity, primary retention.
$T0> # Regression Focus     = a later file failure must not leave an earlier file partially published or dropped.
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_AD_PROBE INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_AD_ORPHAN INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_AD_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> # Remove test-owned orphans left by an interrupted earlier run.
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_fail.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_collision.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_03.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTE_AD_TS
        TEMPFILE 'sdpte_ad_01.dbf' SIZE 8M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> # Leave a valid retired tempfile on disk but outside the path registry.
$T0> # It makes the second target fail in the physical binding lane.
$T0> CREATE TEMPORARY TABLESPACE SDPTE_AD_ORPHAN
        TEMPFILE 'sdpte_ad_collision.dbf' SIZE 4M AUTOEXTEND OFF;
Create success.

$T0> DROP TABLESPACE SDPTE_AD_ORPHAN;
Drop success.

$T0> ##################################
$T0> SECTOR 2; ADD TEMPFILE
$T0> ##################################
$T0> # The second file exists as a retired orphan.  The first file in the same
$T0> # statement must not remain partially published or on disk after failure.
$T0> ALTER TABLESPACE SDPTE_AD_TS ADD TEMPFILE
        'sdpte_ad_fail.dbf' SIZE 4M AUTOEXTEND OFF,
        'sdpte_ad_collision.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdpte_ad_collision.dbf )]

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.NEXT_FILE_ID = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND F.FILE_COUNT = 1
                AND F.FAIL_FILE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_FAILED_ADD_ATOMIC
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(CASE
                            WHEN D.NAME LIKE '%sdpte_ad_fail.dbf'
                            THEN 1 ELSE 0
                        END) AS FAIL_FILE_COUNT
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_AD_TS' ) F
     WHERE T.NAME = 'SDPTE_AD_TS';
PASS_FAILED_ADD_ATOMIC 
-------------------------
1           
1 row selected.

$T0> # A CREATE without REUSE proves the aborted first ADD target was removed
$T0> # physically as well as from the published definition.
$T0> CREATE TEMPORARY TABLESPACE SDPTE_AD_PROBE
        TEMPFILE 'sdpte_ad_fail.dbf' SIZE 4M AUTOEXTEND OFF;
Create success.

$T0> DROP TABLESPACE SDPTE_AD_PROBE INCLUDING CONTENTS AND DATAFILES;
Drop success.

$T0> ALTER TABLESPACE SDPTE_AD_TS ADD TEMPFILE
        'sdpte_ad_02.dbf' SIZE 4M AUTOEXTEND OFF,
        'sdpte_ad_03.dbf' SIZE 8M AUTOEXTEND ON NEXT 4M MAXSIZE 32M;
Alter success.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.NEXT_FILE_ID = 3
                AND T.TOTAL_PAGE_COUNT = 2560
                AND F.FILE_COUNT = 3
                AND F.MIN_FILE_ID = 0
                AND F.MAX_FILE_ID = 2
               THEN 1 ELSE 0
           END AS PASS_ADD_TEMPFILES
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    MIN(D.ID) AS MIN_FILE_ID,
                    MAX(D.ID) AS MAX_FILE_ID
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_AD_TS' ) F
     WHERE T.NAME = 'SDPTE_AD_TS';
PASS_ADD_TEMPFILES 
---------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; DROP TEMPFILE
$T0> ##################################
$T0> # The primary file makes the statement fail.  The secondary file listed
$T0> # before it must still be present after transaction rollback.
$T0> ALTER TABLESPACE SDPTE_AD_TS DROP TEMPFILE
        'sdpte_ad_02.dbf', 'sdpte_ad_01.dbf';
[ERR-11036 : The data file is in use.]

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.NEXT_FILE_ID = 3
                AND T.TOTAL_PAGE_COUNT = 2560
                AND F.FILE_COUNT = 3
                AND F.MIN_FILE_ID = 0
                AND F.MAX_FILE_ID = 2
               THEN 1 ELSE 0
           END AS PASS_FAILED_DROP_ATOMIC
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    MIN(D.ID) AS MIN_FILE_ID,
                    MAX(D.ID) AS MAX_FILE_ID
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_AD_TS' ) F
     WHERE T.NAME = 'SDPTE_AD_TS';
PASS_FAILED_DROP_ATOMIC 
--------------------------
1           
1 row selected.

$T0> ALTER TABLESPACE SDPTE_AD_TS DROP TEMPFILE
        'sdpte_ad_02.dbf', 'sdpte_ad_03.dbf';
Alter success.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.NEXT_FILE_ID = 3
                AND T.TOTAL_PAGE_COUNT = 1024
                AND F.FILE_COUNT = 1
                AND F.MIN_FILE_ID = 0
                AND F.MAX_FILE_ID = 0
               THEN 1 ELSE 0
           END AS PASS_DROP_TEMPFILES
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    MIN(D.ID) AS MIN_FILE_ID,
                    MAX(D.ID) AS MAX_FILE_ID
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_AD_TS' ) F
     WHERE T.NAME = 'SDPTE_AD_TS';
PASS_DROP_TEMPFILES 
----------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_AD_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> # DROP TEMPFILE preserves physical files by contract.
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_fail.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_collision.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ad_03.dbf";

