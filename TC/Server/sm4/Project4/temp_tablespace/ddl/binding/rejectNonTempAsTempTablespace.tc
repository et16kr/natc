###########################################################################
# TestCase Description = Refuse any non-TEMP tablespace as a user TEMPORARY TABLESPACE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = only SMI_DISK_SYSTEM_TEMP and SMI_DISK_USER_TEMP are bindable; a refused
#                        binding leaves the previous one intact.
# Product Reference    = src/qp/qdr/qdr.cpp validateCreate/validateAlter ERR_INVALID_TEMP_TBS
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_UN_U CASCADE;
    DROP USER SDPTE_UN_BAD CASCADE;
    DROP TABLESPACE SDPTE_UN_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_UN_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_UN_DATA
        DATAFILE 'sdpte_un_data.dbf' SIZE 4M AUTOEXTEND OFF;

    CREATE TEMPORARY TABLESPACE SDPTE_UN_TS
        TEMPFILE 'sdpte_un_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE USER SDPTE_UN_U IDENTIFIED BY SDPTE_UN_U
        DEFAULT TABLESPACE SDPTE_UN_DATA
        TEMPORARY TABLESPACE SDPTE_UN_TS;

##################################
SECTOR; CREATE USER REFUSES A NON-TEMP TARGET
##################################
    # A disk DATA tablespace is not a temporary tablespace.
    CREATE USER SDPTE_UN_BAD IDENTIFIED BY SDPTE_UN_BAD
        DEFAULT TABLESPACE SDPTE_UN_DATA
        TEMPORARY TABLESPACE SDPTE_UN_DATA;

    # Neither is a memory tablespace.
    CREATE USER SDPTE_UN_BAD IDENTIFIED BY SDPTE_UN_BAD
        DEFAULT TABLESPACE SDPTE_UN_DATA
        TEMPORARY TABLESPACE SYS_TBS_MEM_DATA;

    # The undo tablespace is not bindable either.
    CREATE USER SDPTE_UN_BAD IDENTIFIED BY SDPTE_UN_BAD
        DEFAULT TABLESPACE SDPTE_UN_DATA
        TEMPORARY TABLESPACE SYS_TBS_DISK_UNDO;

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_NO_USER_CREATED
      FROM SYSTEM_.SYS_USERS_
     WHERE USER_NAME = 'SDPTE_UN_BAD';

##################################
SECTOR; ALTER USER REFUSES THE SAME TARGETS AND KEEPS THE OLD BINDING
##################################
    ALTER USER SDPTE_UN_U TEMPORARY TABLESPACE SDPTE_UN_DATA;

    ALTER USER SDPTE_UN_U TEMPORARY TABLESPACE SYS_TBS_MEM_DATA;

    ALTER USER SDPTE_UN_U TEMPORARY TABLESPACE SYS_TBS_MEM_DIC;

    ALTER USER SDPTE_UN_U TEMPORARY TABLESPACE SYS_TBS_DISK_DATA;

    SELECT CASE
               WHEN COUNT(*) = 1
               THEN 1 ELSE 0
           END AS PASS_BINDING_UNCHANGED
      FROM SYSTEM_.SYS_USERS_ U, V$TABLESPACES T
     WHERE U.TEMP_TBS_ID = T.ID
       AND U.USER_NAME = 'SDPTE_UN_U'
       AND T.NAME = 'SDPTE_UN_TS';

##################################
SECTOR; A NAME THAT IS NOT A TABLESPACE IS REFUSED BEFORE THE TYPE CHECK
##################################
    ALTER USER SDPTE_UN_U TEMPORARY TABLESPACE SDPTE_UN_NO_SUCH_TS;

    SELECT CASE
               WHEN COUNT(*) = 1
               THEN 1 ELSE 0
           END AS PASS_BINDING_STILL_UNCHANGED
      FROM SYSTEM_.SYS_USERS_ U, V$TABLESPACES T
     WHERE U.TEMP_TBS_ID = T.ID
       AND U.USER_NAME = 'SDPTE_UN_U'
       AND T.NAME = 'SDPTE_UN_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP USER SDPTE_UN_U CASCADE;
    DROP USER SDPTE_UN_BAD CASCADE;
    DROP TABLESPACE SDPTE_UN_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_UN_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
