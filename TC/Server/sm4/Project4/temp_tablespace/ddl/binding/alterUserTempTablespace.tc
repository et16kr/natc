###########################################################################
# TestCase Description = Rebind a user to another TEMP tablespace and route its spills to the new one.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = the user-to-TEMP binding is catalog state, and a spill resolves its space
#                        from that binding at session start rather than from a cached identity.
# Product Reference    = src/qp/qdr/qdr.cpp validateAlter TEMPORARY TABLESPACE branch and the
#                        DBA_USERS_.TEMP_TBS_ID update in executeAlter
#                        src/qp/qcm/qcmTableSpace.cpp checkAccessTBS temp-TBS exemption
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_UB_U CASCADE;
    DROP TABLESPACE SDPTE_UB_TS1 INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_UB_TS2 INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_UB_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_UB_DATA
        DATAFILE 'sdpte_ub_data.dbf' SIZE 16M
            AUTOEXTEND ON NEXT 16M MAXSIZE 512M;

    CREATE TEMPORARY TABLESPACE SDPTE_UB_TS1
        TEMPFILE 'sdpte_ub_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE TEMPORARY TABLESPACE SDPTE_UB_TS2
        TEMPFILE 'sdpte_ub_02.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_UB_U IDENTIFIED BY SDPTE_UB_U
        DEFAULT TABLESPACE SDPTE_UB_DATA
        TEMPORARY TABLESPACE SDPTE_UB_TS1;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_UB_U/SDPTE_UB_U;

    CREATE TABLE SDPTE_UB_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_UB_DATA;

    INSERT INTO SDPTE_UB_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('B', 1790, 'B')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;

    COMMIT;

##################################
SECTOR; THE CREATE-TIME BINDING ROUTES THE SPILL
##################################
    CONNECT SYS/MANAGER;

    SELECT U.USER_NAME, T.NAME AS TEMP_TBS
      FROM SYSTEM_.SYS_USERS_ U, V$TABLESPACES T
     WHERE U.TEMP_TBS_ID = T.ID
       AND U.USER_NAME = 'SDPTE_UB_U';

    CONNECT SDPTE_UB_U/SDPTE_UB_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_ON_TS1
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_UB_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    # Only the bound space grew. The sibling is still at its initial size.
    SELECT CASE
               WHEN ( SELECT D.CURRSIZE FROM V$TABLESPACES T, V$DATAFILES D
                       WHERE T.ID = D.SPACEID AND T.NAME = 'SDPTE_UB_TS1' ) > 128
                AND ( SELECT D.CURRSIZE FROM V$TABLESPACES T, V$DATAFILES D
                       WHERE T.ID = D.SPACEID AND T.NAME = 'SDPTE_UB_TS2' ) = 128
               THEN 1 ELSE 0
           END AS PASS_ONLY_TS1_GREW
      FROM DUAL;

##################################
SECTOR; REBINDING MOVES THE CATALOG AND THE ROUTING
##################################
    ALTER USER SDPTE_UB_U TEMPORARY TABLESPACE SDPTE_UB_TS2;

    SELECT U.USER_NAME, T.NAME AS TEMP_TBS
      FROM SYSTEM_.SYS_USERS_ U, V$TABLESPACES T
     WHERE U.TEMP_TBS_ID = T.ID
       AND U.USER_NAME = 'SDPTE_UB_U';

    SELECT CASE
               WHEN COUNT(*) = 1
               THEN 1 ELSE 0
           END AS PASS_CATALOG_REBOUND
      FROM SYSTEM_.SYS_USERS_ U, V$TABLESPACES T
     WHERE U.TEMP_TBS_ID = T.ID
       AND U.USER_NAME = 'SDPTE_UB_U'
       AND T.NAME = 'SDPTE_UB_TS2';

    # A session started after the rebinding spills into the new space.
    CONNECT SDPTE_UB_U/SDPTE_UB_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_ON_TS2
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_UB_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN ( SELECT D.CURRSIZE FROM V$TABLESPACES T, V$DATAFILES D
                       WHERE T.ID = D.SPACEID AND T.NAME = 'SDPTE_UB_TS2' ) > 128
                AND ( SELECT T.ALLOCATED_PAGE_COUNT FROM V$TABLESPACES T
                       WHERE T.NAME = 'SDPTE_UB_TS1' ) = 0
                AND ( SELECT T.ALLOCATED_PAGE_COUNT FROM V$TABLESPACES T
                       WHERE T.NAME = 'SDPTE_UB_TS2' ) = 0
               THEN 1 ELSE 0
           END AS PASS_ROUTING_FOLLOWED_REBINDING
      FROM DUAL;

##################################
SECTOR; THE SYSTEM TEMP SPACE IS A VALID REBINDING TARGET
##################################
    ALTER USER SDPTE_UB_U TEMPORARY TABLESPACE SYS_TBS_DISK_TEMP;

    SELECT CASE
               WHEN COUNT(*) = 1
               THEN 1 ELSE 0
           END AS PASS_REBOUND_TO_SYSTEM_TEMP
      FROM SYSTEM_.SYS_USERS_ U, V$TABLESPACES T
     WHERE U.TEMP_TBS_ID = T.ID
       AND U.USER_NAME = 'SDPTE_UB_U'
       AND T.NAME = 'SYS_TBS_DISK_TEMP';

    CONNECT SDPTE_UB_U/SDPTE_UB_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_ON_SYSTEM_TEMP
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_UB_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    # Neither user space is left holding runtime after the binding moved away.
    SELECT CASE
               WHEN SUM(T.ALLOCATED_PAGE_COUNT) = 0
                AND COUNT(*) = 2
               THEN 1 ELSE 0
           END AS PASS_USER_SPACES_QUIESCED
      FROM V$TABLESPACES T
     WHERE T.NAME IN ('SDPTE_UB_TS1', 'SDPTE_UB_TS2');

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_UB_U CASCADE;
    DROP TABLESPACE SDPTE_UB_TS1 INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_UB_TS2 INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_UB_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
