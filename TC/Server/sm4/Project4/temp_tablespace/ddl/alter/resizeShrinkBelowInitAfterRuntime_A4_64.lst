 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Shrink a runtime-grown TEMP file below its INITSIZE.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 9.6 row `T < B`: SHRINK record carries after INIT = min(INIT,T)
$T0> #                        together with after current T, and 8.3 keeps INITSIZE a public field only.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteAlterSize.cpp
$T0> #                        src/sm/sdd/sddUpdate.cpp redo/undo_SCT_UPDATE_DRDB_SHRINK_DBF TEMP wrapper
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTEC_SB_U CASCADE;
$T0> DROP TABLE SDPTEC_SB_SNAP;
$T0> DROP TABLESPACE SDPTEC_SB_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_SB_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE SDPTEC_SB_DATA
        DATAFILE 'sdptec_sb_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTEC_SB_TS
        TEMPFILE 'sdptec_sb_01.dbf' SIZE 4M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;
Create success.

$T0> CREATE TABLE SDPTEC_SB_SNAP ( TAG VARCHAR(32), V INTEGER )
        TABLESPACE SDPTEC_SB_DATA;
Create success.

$T0> CREATE USER SDPTEC_SB_U IDENTIFIED BY SDPTEC_SB_U
        DEFAULT TABLESPACE SDPTEC_SB_DATA
        TEMPORARY TABLESPACE SDPTEC_SB_TS;
Create success.

$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;
Alter success.

$T0> CONNECT SDPTEC_SB_U/SDPTEC_SB_U;
Connect success.

$T0> CREATE TABLE SDPTEC_SB_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_SB_DATA;
Create success.

$T0> INSERT INTO SDPTEC_SB_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('S', 1790, 'S')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
30000 rows inserted.
$T0> COMMIT;
Commit success.

$T0> ##################################
$T0> SECTOR 2; RUNTIME GROWTH
$T0> ##################################
$T0> SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_RUNTIME_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_SB_SOURCE
           ) D;
PASS_RUNTIME_SPILL 
---------------------
1           
1 row selected.

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> INSERT INTO SDPTEC_SB_SNAP
    SELECT 'R_AFTER_SPILL', D.CURRSIZE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SB_TS'
       AND D.ID = 0;
1 row inserted.
$T0> COMMIT;
Commit success.

$T0> SELECT CASE
               WHEN ( SELECT V FROM SDPTEC_SB_SNAP WHERE TAG = 'R_AFTER_SPILL' ) > 512
               THEN 1 ELSE 0
           END AS PASS_R_ABOVE_INIT
      FROM DUAL;
PASS_R_ABOVE_INIT 
--------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; SHRINK BELOW INITSIZE
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_SB_TS
        ALTER TEMPFILE 'sdptec_sb_01.dbf' SIZE 1M;
Alter success.

$T0> SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 128
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 16384
                AND T.TOTAL_PAGE_COUNT = 128
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_INIT_FOLLOWS_TARGET
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SB_TS';
PASS_INIT_FOLLOWS_TARGET 
---------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; RESTART KEEPS THE REDUCED INIT AND D
$T0> ##################################

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 128
                AND D.OPENED = 0
                AND T.TOTAL_PAGE_COUNT = 128
               THEN 1 ELSE 0
           END AS PASS_RESTART_KEEPS_REDUCED_INIT
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SB_TS';
PASS_RESTART_KEEPS_REDUCED_INIT 
----------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 5; FINALIZATION
$T0> ##################################
$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;
Alter success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTEC_SB_U CASCADE;
$T0> DROP TABLE SDPTEC_SB_SNAP;
$T0> DROP TABLESPACE SDPTEC_SB_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_SB_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

