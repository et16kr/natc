###########################################################################
# TestCase Description = Refuse a multi-file DROP TEMPFILE that names the primary tempfile.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.4 primary tempfile guard inside one statement-sized target set.
# Product Reference    = src/sm/sdp/sdpte/sdpteDropTempFile.cpp
#                        sdpteDropTempFileValidateTargets SDPTE_DROP_TEMPFILE_PRIMARY_FILE
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DP_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_DP_TS
        TEMPFILE 'sdptec_dp_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dp_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dp_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

##################################
SECTOR; PRIMARY TARGET REJECTS THE SET
##################################
    # The primary tempfile carries file ID 0 and can never be a DROP target,
    # so neither position in the list may be published.
    ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_01.dbf', 'sdptec_dp_02.dbf';

    ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_02.dbf', 'sdptec_dp_01.dbf';

    ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_01.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
                AND F.ID_SUM = 3
               THEN 1 ELSE 0
           END AS PASS_PRIMARY_GUARD_KEPT_ALL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(D.ID) AS ID_SUM
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DP_TS' ) F
     WHERE T.NAME = 'SDPTEC_DP_TS';

##################################
SECTOR; SECONDARY ONLY TARGET SET IS ACCEPTED
##################################
    ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_02.dbf', 'sdptec_dp_03.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND F.FILE_COUNT = 1
                AND F.ID_SUM = 0
               THEN 1 ELSE 0
           END AS PASS_SECONDARY_SET_COMMITTED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.ID) AS ID_SUM
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DP_TS' ) F
     WHERE T.NAME = 'SDPTEC_DP_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DP_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    # DROP TEMPFILE intentionally detached these files without unlinking them.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_03.dbf";
}
