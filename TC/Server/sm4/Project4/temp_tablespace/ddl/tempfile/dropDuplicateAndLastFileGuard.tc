###########################################################################
# TestCase Description = Reject duplicate DROP TEMPFILE targets without weakening the last-file guard.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.4 validates a unique target set before applying the minimum-file guard.
# Product Reference    = src/sm/sdp/sdpte/sdpteDropTempFile.cpp
#                        sdpteDropTempFileValidateTargets SDPTE_DROP_TEMPFILE_LAST_FILE
#                        sdpteDropTempFileBuildAfterImage
# Review Note          = A duplicate target is an invalid statement, not a second removal of the
#                        same file. Both duplicate shapes below must be rejected atomically.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DD_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dd_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dd_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dd_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_DD_TS
        TEMPFILE 'sdptec_dd_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dd_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dd_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

##################################
SECTOR; TARGET COUNT REACHES THE FILE COUNT
##################################
    # Three targets against a three-file definition. The guard refuses the
    # statement even though only two distinct files are named.
    ALTER TABLESPACE SDPTEC_DD_TS
        DROP TEMPFILE 'sdptec_dd_02.dbf',
                      'sdptec_dd_02.dbf',
                      'sdptec_dd_03.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
               THEN 1 ELSE 0
           END AS PASS_LAST_FILE_GUARD_KEPT_ALL
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_DD_TS';

##################################
SECTOR; DUPLICATE TARGET IS REJECTED
##################################
    # Two targets naming the same file are invalid even though removing that
    # one distinct file would leave two files behind.
    ALTER TABLESPACE SDPTEC_DD_TS
        DROP TEMPFILE 'sdptec_dd_02.dbf', 'sdptec_dd_02.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
               THEN 1 ELSE 0
           END AS PASS_DUPLICATE_TARGET_REJECTED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DD_TS' ) F
     WHERE T.NAME = 'SDPTEC_DD_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DD_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
