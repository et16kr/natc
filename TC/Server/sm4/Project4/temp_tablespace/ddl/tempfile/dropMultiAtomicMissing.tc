###########################################################################
# TestCase Description = Refuse a multi-file DROP TEMPFILE whose second target does not exist.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.4 statement boundary, one-target-set validation before mutation.
# Product Reference    = src/qp/qdt/qdtAlter.cpp qdtAlter::executeDropFile
#                        src/sm/smi/smiTableSpace.cpp smiTableSpace::removeDataFiles
#                        src/sm/sdp/sdpTableSpace.cpp sdpTableSpace::removeDataFiles
#                        src/sm/sdp/sdpte/sdpteDropTempFile.cpp sdpteDropTempFileValidateTargets
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DM_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_DM_TS
        TEMPFILE 'sdptec_dm_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dm_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dm_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

##################################
SECTOR; REJECT THE WHOLE TARGET SET
##################################
    # The first target is valid and the second is not registered. The single
    # statement must publish no definition at all, not the first target alone.
    ALTER TABLESPACE SDPTEC_DM_TS
        DROP TEMPFILE 'sdptec_dm_02.dbf', 'sdptec_dm_absent.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
               THEN 1 ELSE 0
           END AS PASS_MISSING_TARGET_KEPT_ALL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DM_TS' ) F
     WHERE T.NAME = 'SDPTEC_DM_TS';

##################################
SECTOR; ACCEPT THE WHOLE TARGET SET
##################################
    ALTER TABLESPACE SDPTEC_DM_TS
        DROP TEMPFILE 'sdptec_dm_02.dbf', 'sdptec_dm_03.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND F.FILE_COUNT = 1
                AND F.TOTAL_CURRENT = 1024
                AND F.PRIMARY_ID = 0
               THEN 1 ELSE 0
           END AS PASS_MULTI_DROP_COMMITTED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    MIN(D.ID) AS PRIMARY_ID
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DM_TS' ) F
     WHERE T.NAME = 'SDPTEC_DM_TS';

    # Design 9.4: an ordinary DROP TEMPFILE leaves the physical file behind.
    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_dm_02.dbf" )
    {
        PRINT "PASS_DROPPED_FILE_02_PRESERVED";
    }
    ELSE
    {
        PRINT "FAIL_DROPPED_FILE_02_PRESERVED";
    }

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_dm_03.dbf" )
    {
        PRINT "PASS_DROPPED_FILE_03_PRESERVED";
    }
    ELSE
    {
        PRINT "FAIL_DROPPED_FILE_03_PRESERVED";
    }

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DM_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    # DROP TEMPFILE intentionally detached these files without unlinking them.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_03.dbf";
}
