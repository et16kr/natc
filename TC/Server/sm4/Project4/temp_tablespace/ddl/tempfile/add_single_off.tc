###########################################################################
# TestCase Description = Independent ADDDROP TEMP case 01.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_ADDDROP_01
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ADD01 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_ADD01 TEMPFILE 'sdpte_adddrop_01_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_ADD01 ADD TEMPFILE 'sdpte_adddrop_01_02.dbf' SIZE 4M AUTOEXTEND OFF;
    SELECT CASE WHEN D.DATAFILE_COUNT=2 THEN 1 ELSE 0 END AS PASS_ADDDROP_01 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_ADD01' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ADD01 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
