 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Refuse a multi-file DROP TEMPFILE that names the primary tempfile.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 9.4 primary tempfile guard inside one statement-sized target set.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteDropTempFile.cpp
$T0> #                        sdpteDropTempFileValidateTargets SDPTE_DROP_TEMPFILE_PRIMARY_FILE
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DP_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_03.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DP_TS
        TEMPFILE 'sdptec_dp_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dp_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dp_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> ##################################
$T0> SECTOR 2; PRIMARY TARGET REJECTS THE SET
$T0> ##################################
$T0> # The primary tempfile carries file ID 0 and can never be a DROP target,
$T0> # so neither position in the list may be published.
$T0> ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_01.dbf', 'sdptec_dp_02.dbf';
[ERR-11036 : The data file is in use.]

$T0> ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_02.dbf', 'sdptec_dp_01.dbf';
[ERR-11036 : The data file is in use.]

$T0> ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_01.dbf';
[ERR-11036 : The data file is in use.]

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
                AND F.ID_SUM = 3
               THEN 1 ELSE 0
           END AS PASS_PRIMARY_GUARD_KEPT_ALL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(D.ID) AS ID_SUM
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DP_TS' ) F
     WHERE T.NAME = 'SDPTEC_DP_TS';
PASS_PRIMARY_GUARD_KEPT_ALL 
------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; SECONDARY ONLY TARGET SET IS ACCEPTED
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_DP_TS
        DROP TEMPFILE 'sdptec_dp_02.dbf', 'sdptec_dp_03.dbf';
Alter success.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND F.FILE_COUNT = 1
                AND F.ID_SUM = 0
               THEN 1 ELSE 0
           END AS PASS_SECONDARY_SET_COMMITTED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.ID) AS ID_SUM
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DP_TS' ) F
     WHERE T.NAME = 'SDPTEC_DP_TS';
PASS_SECONDARY_SET_COMMITTED 
-------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DP_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> # DROP TEMPFILE intentionally detached these files without unlinking them.
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dp_03.dbf";

