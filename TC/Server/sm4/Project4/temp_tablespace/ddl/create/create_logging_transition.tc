###########################################################################
# TestCase Description = Independent CREATE TEMP case 08.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_CREATE_08
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE08 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_CRE08
        TEMPFILE 'sdpte_create_08_01.dbf' SIZE 8M AUTOEXTEND OFF;

    ALTER TABLESPACE SDPTE_CRE08 UNCOMPRESSED LOGGING;

    SELECT CASE WHEN D.ATTR_LOG_COMPRESS = 0 THEN 1 ELSE 0 END AS PASS_CREATE_08_UNCOMPRESSED
      FROM V$TABLESPACES D
     WHERE D.NAME = 'SDPTE_CRE08';

    ALTER TABLESPACE SDPTE_CRE08 COMPRESSED LOGGING;

    SELECT CASE WHEN D.ATTR_LOG_COMPRESS = 1 THEN 1 ELSE 0 END AS PASS_CREATE_08_COMPRESSED
      FROM V$TABLESPACES D
     WHERE D.NAME = 'SDPTE_CRE08';
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE08 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
