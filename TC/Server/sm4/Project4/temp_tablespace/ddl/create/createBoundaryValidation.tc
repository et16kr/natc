###########################################################################
# TestCase Description = Refuse impossible TEMP geometry at CREATE without leaving a file behind.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 2.4: the safety checks `sdpte` duplicates are page/byte overflow, a
#                        representable header page and body offset, `extentPages > 0` with a
#                        computable complete extent, OS/page-ID limits, and design 12 requires a
#                        refused CREATE to publish nothing and to own no leftover file.
# Product Reference    = src/sm/sdp/sdpte/sdpteCreate.cpp, src/sm/sdp/sdpte/sdpteFile.cpp
#                        smERR_ABORT_FILE_IS_TOO_SMALL, smERR_ABORT_InitSizeExceedMaxSize,
#                        smERR_ABORT_InvalidAutoExtFileSize
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_BV_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_BV_OK INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_bv_bad.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_bv_ok.dbf";

##################################
SECTOR; PREPARATION
##################################

##################################
SECTOR; REFUSED GEOMETRY
##################################
    # MAXSIZE below the initial size.
    CREATE TEMPORARY TABLESPACE SDPTEC_BV_TS
        TEMPFILE 'sdptec_bv_bad.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 1M MAXSIZE 4M
        EXTENTSIZE 512K;

    # An extent larger than the whole file leaves no complete extent.
    CREATE TEMPORARY TABLESPACE SDPTEC_BV_TS
        TEMPFILE 'sdptec_bv_bad.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 8M;

    # AUTOEXTEND ON with a zero NEXT can never make progress.
    CREATE TEMPORARY TABLESPACE SDPTEC_BV_TS
        TEMPFILE 'sdptec_bv_bad.dbf' SIZE 4M
            AUTOEXTEND ON NEXT 0M MAXSIZE 32M
        EXTENTSIZE 512K;

    # A file smaller than one header page plus one extent.
    CREATE TEMPORARY TABLESPACE SDPTEC_BV_TS
        TEMPFILE 'sdptec_bv_bad.dbf' SIZE 8K AUTOEXTEND OFF
        EXTENTSIZE 512K;

    # A zero extent size has no complete extent to compute.
    CREATE TEMPORARY TABLESPACE SDPTEC_BV_TS
        TEMPFILE 'sdptec_bv_bad.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 0K;

##################################
SECTOR; VERIFY NOTHING WAS PUBLISHED
##################################
    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_NO_DEFINITION_PUBLISHED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_BV_TS';

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_bv_bad.dbf" )
    {
        PRINT "FAIL_REFUSED_CREATE_LEFT_FILE";
    }
    ELSE
    {
        PRINT "PASS_REFUSED_CREATE_LEFT_NO_FILE";
    }

##################################
SECTOR; A VALID GEOMETRY IS STILL ACCEPTED
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_BV_OK
        TEMPFILE 'sdptec_bv_ok.dbf' SIZE 4M
            AUTOEXTEND ON NEXT 1M MAXSIZE 32M
        EXTENTSIZE 512K;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.EXTENT_PAGE_COUNT = 64
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 7
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 4096
                AND D.AUTOEXTEND = 1
                AND D.OPENED = 0
               THEN 1 ELSE 0
           END AS PASS_VALID_GEOMETRY_ACCEPTED
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_BV_OK';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_BV_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_BV_OK INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    # A refused CREATE is outside any definition if a regression leaves it behind.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_bv_bad.dbf";
}
