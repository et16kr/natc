###########################################################################
# TestCase Description = Create user TEMP tablespaces and verify public catalog projection.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = CREATE, multi-file definition, extent/segment attributes, public views.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CT_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_CT_DISK_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_CT_TS
        TEMPFILE 'sdpte_ct_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdpte_ct_02.dbf' SIZE 16M
                     AUTOEXTEND ON NEXT 8M MAXSIZE 64M
        EXTENTSIZE 512K
        SEGMENT MANAGEMENT MANUAL;

    CREATE DISK TEMPORARY TABLESPACE SDPTE_CT_DISK_TS
        TEMPFILE 'sdpte_ct_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 256K
        SEGMENT MANAGEMENT AUTO;

##################################
SECTOR; TEST
##################################
    SELECT NAME,
           TYPE,
           STATE,
           DATAFILE_COUNT,
           TOTAL_PAGE_COUNT,
           EXTENT_PAGE_COUNT,
           SEGMENT_MANAGEMENT
      FROM V$TABLESPACES
     WHERE NAME IN ('SDPTE_CT_TS', 'SDPTE_CT_DISK_TS')
     ORDER BY NAME;

    SELECT CASE
               WHEN COUNT(*) = 2
                AND MIN(TYPE) = 6
                AND MAX(TYPE) = 6
                AND MIN(STATE) = 2
                AND MAX(STATE) = 2
                AND SUM(DATAFILE_COUNT) = 3
                AND SUM(TOTAL_PAGE_COUNT) = 3584
                AND SUM(ALLOCATED_PAGE_COUNT) = 0
               THEN 1 ELSE 0
           END AS PASS_CREATE_CATALOG
      FROM V$TABLESPACES
     WHERE NAME IN ('SDPTE_CT_TS', 'SDPTE_CT_DISK_TS');

    SELECT T.NAME AS TBS_NAME,
           D.ID AS FILE_ID,
           D.INITSIZE,
           D.CURRSIZE,
           D.AUTOEXTEND,
           D.NEXTSIZE,
           D.MAXSIZE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME IN ('SDPTE_CT_TS', 'SDPTE_CT_DISK_TS')
     ORDER BY T.NAME, D.ID;

    SELECT CASE
               WHEN COUNT(*) = 3
                AND SUM(D.INITSIZE) = 3584
                AND SUM(D.CURRSIZE) = 3584
                AND SUM(CASE WHEN D.AUTOEXTEND = 1 THEN 1 ELSE 0 END) = 1
               THEN 1 ELSE 0
           END AS PASS_CREATE_FILES
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME IN ('SDPTE_CT_TS', 'SDPTE_CT_DISK_TS');

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CT_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_CT_DISK_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
