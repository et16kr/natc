###########################################################################
# TestCase Description = Independent CREATE TEMP case 05.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_CREATE_05
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE05 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_CRE05 TEMPFILE 'sdpte_create_05_01.dbf' SIZE 8M AUTOEXTEND ON NEXT 1M MAXSIZE UNLIMITED;

    SELECT CASE WHEN F.MAXSIZE>F.CURRSIZE THEN 1 ELSE 0 END AS PASS_CREATE_05 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_CRE05' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE05 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
