###########################################################################
# TestCase Description = Independent CREATE TEMP case 06.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_CREATE_06
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE06 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_CRE06 TEMPFILE 'sdpte_create_06_01.dbf' SIZE 8M AUTOEXTEND OFF EXTENTSIZE 256K;

    SELECT CASE WHEN D.EXTENT_PAGE_COUNT=32 THEN 1 ELSE 0 END AS PASS_CREATE_06 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_CRE06' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_CRE06 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
