###########################################################################
# TestCase Description = Reject DROP TABLESPACE before it can unlink a substituted path.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T-DDL-04 preflight subset; foreign-path refusal before commit.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# iSQL Manual          = /home/et16/work/altidev4_gi/docs/manuals/altibase/Altibase_7.1/eng/iSQL User's Manual.md
# Unit Coverage        = unittestSdpteStandardLane: post-commit path replacement preserves the foreign inode.
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLE SDPTE_PS_DATA_T;
    DROP TABLESPACE SDPTE_PS_DATA INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_PS_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ps_02_saved.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_PS_DATA
        DATAFILE 'sdpte_ps_data.dbf' SIZE 8M AUTOEXTEND OFF;

    CREATE TABLE SDPTE_PS_DATA_T
    (
        ID INTEGER PRIMARY KEY,
        C1 VARCHAR(32)
    ) TABLESPACE SDPTE_PS_DATA;

    INSERT INTO SDPTE_PS_DATA_T VALUES (1, 'PATH_SOURCE');
    COMMIT;

    CREATE TEMPORARY TABLESPACE SDPTE_PS_TS
        TEMPFILE 'sdpte_ps_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdpte_ps_02.dbf' SIZE 8M AUTOEXTEND OFF;

##################################
SECTOR; DROP TABLESPACE PATH PREFLIGHT
##################################
    # Replace only the registered pathname. The runtime still owns the
    # original open inode now parked under the saved name.
    MV "${ALTIBASE_HOME}/dbs/sdpte_ps_02.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ps_02_saved.dbf";
    CP "${ALTIBASE_HOME}/dbs/sdpte_ps_data.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ps_02.dbf";

    # DROP TABLESPACE INCLUDING CONTENTS AND DATAFILES is the touch-mode
    # cleanup path.  Its preflight must reject a foreign inode before any
    # metadata or physical file is removed.
    NODISPLAY ON;
    DROP TABLESPACE SDPTE_PS_TS INCLUDING CONTENTS AND DATAFILES;
    NODISPLAY OFF;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND COUNT(D.ID) = 2
               THEN 1 ELSE 0
           END AS PASS_DROP_PREFLIGHT_REFUSED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_PS_TS'
     GROUP BY T.DATAFILE_COUNT;

    SELECT CASE
               WHEN COUNT(*) = 1
                AND MIN(C1) = 'PATH_SOURCE'
               THEN 1 ELSE 0
           END AS PASS_DATA_SOURCE_UNCHANGED
      FROM SDPTE_PS_DATA_T;

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdpte_ps_02.dbf" )
    {
        PRINT "PASS_FOREIGN_PATH_PRESERVED";
    }
    ELSE
    {
        PRINT "FAIL_FOREIGN_PATH_REMOVED";
    }

    # Restore the owned inode and prove the tablespace can then be removed.
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ps_02.dbf";
    MV "${ALTIBASE_HOME}/dbs/sdpte_ps_02_saved.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ps_02.dbf";

    DROP TABLESPACE SDPTE_PS_TS INCLUDING CONTENTS AND DATAFILES;

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_DROP_AFTER_RESTORE
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_PS_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLE SDPTE_PS_DATA_T;
    DROP TABLESPACE SDPTE_PS_DATA INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_PS_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ps_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ps_02_saved.dbf";
}
