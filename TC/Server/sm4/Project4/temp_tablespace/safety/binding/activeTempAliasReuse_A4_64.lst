 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Reject hard-link aliases of active TEMP files from TEMP CREATE and ADD.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = Active TEMP path/inode collision, non-REUSE and explicit REUSE.
$T0> # Regression Focus     = A TEMP binding must never adopt an inode owned by another active TEMP file.
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_ATA_CREATE INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_ATA_TARGET INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_ATA_CREATE_SOURCE INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_ATA_ADD_SOURCE INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_create_alias.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_add_alias.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTE_ATA_CREATE_SOURCE
        TEMPFILE 'sdpte_ata_create_source.dbf' SIZE 8M AUTOEXTEND OFF;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTE_ATA_ADD_SOURCE
        TEMPFILE 'sdpte_ata_add_source.dbf' SIZE 8M AUTOEXTEND OFF;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTE_ATA_TARGET
        TEMPFILE 'sdpte_ata_target.dbf' SIZE 8M AUTOEXTEND OFF;
Create success.

$T0> LN "${ALTIBASE_HOME}/dbs/sdpte_ata_create_source.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ata_create_alias.dbf";
$T0> LN "${ALTIBASE_HOME}/dbs/sdpte_ata_add_source.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ata_add_alias.dbf";

$T0> ##################################
$T0> SECTOR 2; ACTIVE TEMP ALIAS REJECTION
$T0> ##################################
$T0> # Expected error: an existing active inode is never a CREATE target.
$T0> CREATE TEMPORARY TABLESPACE SDPTE_ATA_CREATE
        TEMPFILE 'sdpte_ata_create_alias.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdpte_ata_create_alias.dbf )]

$T0> # Expected error: explicit REUSE must not authorize the active TEMP inode.
$T0> CREATE TEMPORARY TABLESPACE SDPTE_ATA_CREATE
        TEMPFILE 'sdpte_ata_create_alias.dbf'
            SIZE 4M REUSE AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdpte_ata_create_alias.dbf )]

$T0> # Expected error: ADD applies the same active-inode rule without REUSE.
$T0> ALTER TABLESPACE SDPTE_ATA_TARGET ADD TEMPFILE
        'sdpte_ata_add_alias.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdpte_ata_add_alias.dbf )]

$T0> # Expected error: explicit REUSE must not bypass the ADD collision check.
$T0> ALTER TABLESPACE SDPTE_ATA_TARGET ADD TEMPFILE
        'sdpte_ata_add_alias.dbf' SIZE 4M REUSE AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdpte_ata_add_alias.dbf )]

$T0> ##################################
$T0> SECTOR 3; VERIFY ACTIVE TEMP UNCHANGED
$T0> ##################################
$T0> SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_NO_CREATE
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_ATA_CREATE';
PASS_NO_CREATE 
-----------------
1           
1 row selected.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND COUNT(D.ID) = 1
                AND MIN(D.CURRSIZE) = 1024
               THEN 1 ELSE 0
           END AS PASS_CREATE_SOURCE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_ATA_CREATE_SOURCE'
     GROUP BY T.DATAFILE_COUNT;
PASS_CREATE_SOURCE 
---------------------
1           
1 row selected.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND COUNT(D.ID) = 1
                AND MIN(D.CURRSIZE) = 1024
               THEN 1 ELSE 0
           END AS PASS_ADD_SOURCE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_ATA_ADD_SOURCE'
     GROUP BY T.DATAFILE_COUNT;
PASS_ADD_SOURCE 
------------------
1           
1 row selected.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND COUNT(D.ID) = 1
                AND MIN(D.CURRSIZE) = 1024
               THEN 1 ELSE 0
           END AS PASS_NO_ADD
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_ATA_TARGET'
     GROUP BY T.DATAFILE_COUNT;
PASS_NO_ADD 
--------------
1           
1 row selected.

$T0> SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_ALIAS_UNREGISTERED
      FROM V$DATAFILES
     WHERE NAME LIKE '%sdpte_ata_create_alias.dbf'
        OR NAME LIKE '%sdpte_ata_add_alias.dbf';
PASS_ALIAS_UNREGISTERED 
--------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTE_ATA_CREATE INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_ATA_TARGET INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_ATA_CREATE_SOURCE INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_ATA_ADD_SOURCE INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_create_alias.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_add_alias.dbf";

