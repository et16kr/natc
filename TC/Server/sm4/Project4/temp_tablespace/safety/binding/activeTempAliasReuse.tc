###########################################################################
# TestCase Description = Reject hard-link aliases of active TEMP files from TEMP CREATE and ADD.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = Active TEMP path/inode collision, non-REUSE and explicit REUSE.
# Regression Focus     = A TEMP binding must never adopt an inode owned by another active TEMP file.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ATA_CREATE INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_ATA_TARGET INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_ATA_CREATE_SOURCE INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_ATA_ADD_SOURCE INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_create_alias.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_add_alias.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_ATA_CREATE_SOURCE
        TEMPFILE 'sdpte_ata_create_source.dbf' SIZE 8M AUTOEXTEND OFF;

    CREATE TEMPORARY TABLESPACE SDPTE_ATA_ADD_SOURCE
        TEMPFILE 'sdpte_ata_add_source.dbf' SIZE 8M AUTOEXTEND OFF;

    CREATE TEMPORARY TABLESPACE SDPTE_ATA_TARGET
        TEMPFILE 'sdpte_ata_target.dbf' SIZE 8M AUTOEXTEND OFF;

    LN "${ALTIBASE_HOME}/dbs/sdpte_ata_create_source.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ata_create_alias.dbf";
    LN "${ALTIBASE_HOME}/dbs/sdpte_ata_add_source.dbf" "${ALTIBASE_HOME}/dbs/sdpte_ata_add_alias.dbf";

##################################
SECTOR; ACTIVE TEMP ALIAS REJECTION
##################################
    # Expected error: an existing active inode is never a CREATE target.
    CREATE TEMPORARY TABLESPACE SDPTE_ATA_CREATE
        TEMPFILE 'sdpte_ata_create_alias.dbf' SIZE 4M AUTOEXTEND OFF;

    # Expected error: explicit REUSE must not authorize the active TEMP inode.
    CREATE TEMPORARY TABLESPACE SDPTE_ATA_CREATE
        TEMPFILE 'sdpte_ata_create_alias.dbf'
            SIZE 4M REUSE AUTOEXTEND OFF;

    # Expected error: ADD applies the same active-inode rule without REUSE.
    ALTER TABLESPACE SDPTE_ATA_TARGET ADD TEMPFILE
        'sdpte_ata_add_alias.dbf' SIZE 4M AUTOEXTEND OFF;

    # Expected error: explicit REUSE must not bypass the ADD collision check.
    ALTER TABLESPACE SDPTE_ATA_TARGET ADD TEMPFILE
        'sdpte_ata_add_alias.dbf' SIZE 4M REUSE AUTOEXTEND OFF;

##################################
SECTOR; VERIFY ACTIVE TEMP UNCHANGED
##################################
    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_NO_CREATE
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_ATA_CREATE';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND COUNT(D.ID) = 1
                AND MIN(D.CURRSIZE) = 1024
               THEN 1 ELSE 0
           END AS PASS_CREATE_SOURCE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_ATA_CREATE_SOURCE'
     GROUP BY T.DATAFILE_COUNT;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND COUNT(D.ID) = 1
                AND MIN(D.CURRSIZE) = 1024
               THEN 1 ELSE 0
           END AS PASS_ADD_SOURCE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_ATA_ADD_SOURCE'
     GROUP BY T.DATAFILE_COUNT;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND COUNT(D.ID) = 1
                AND MIN(D.CURRSIZE) = 1024
               THEN 1 ELSE 0
           END AS PASS_NO_ADD
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_ATA_TARGET'
     GROUP BY T.DATAFILE_COUNT;

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_ALIAS_UNREGISTERED
      FROM V$DATAFILES
     WHERE NAME LIKE '%sdpte_ata_create_alias.dbf'
        OR NAME LIKE '%sdpte_ata_add_alias.dbf';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ATA_CREATE INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_ATA_TARGET INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_ATA_CREATE_SOURCE INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_ATA_ADD_SOURCE INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_create_alias.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_ata_add_alias.dbf";
}
