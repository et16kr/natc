###########################################################################
# TestCase Description = Independent AUTO TEMP case 05.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_AUTO_05
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_AUT05 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_AUT05 TEMPFILE 'sdpte_auto_05_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_AUT05 ALTER TEMPFILE 'sdpte_auto_05_01.dbf' AUTOEXTEND ON NEXT 4M MAXSIZE 32M; ALTER TABLESPACE SDPTE_AUT05 ALTER TEMPFILE 'sdpte_auto_05_01.dbf' AUTOEXTEND ON NEXT 4M MAXSIZE 32M;
    SELECT CASE WHEN F.NEXTSIZE=512 THEN 1 ELSE 0 END AS PASS_AUTO_05 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_AUT05' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_AUT05 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

