###########################################################################
# TestCase Description = Independent AUTO TEMP case 03.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_AUTO_03
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_AUT03 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_AUT03 TEMPFILE 'sdpte_auto_03_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_AUT03 ALTER TEMPFILE 'sdpte_auto_03_01.dbf' AUTOEXTEND ON NEXT 1M MAXSIZE 16M;
    SELECT CASE WHEN F.MAXSIZE=2048 THEN 1 ELSE 0 END AS PASS_AUTO_03 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_AUT03' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_AUT03 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

