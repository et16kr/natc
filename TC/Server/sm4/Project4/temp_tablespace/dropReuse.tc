###########################################################################
# TestCase Description = Preserve a tempfile on ordinary DROP and adopt it only with explicit REUSE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = DROP touch mode, existing-file rejection, explicit REUSE binding, AND DATAFILES unlink.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTE_DR_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTE_DR_TS
        TEMPFILE 'sdpte_dr_01.dbf' SIZE 8M AUTOEXTEND OFF;

##################################
SECTOR; ORDINARY DROP AND REUSE TEST
##################################
    DROP TABLESPACE SDPTE_DR_TS;

    # Expected error: ordinary DROP leaves the physical tempfile, so CREATE
    # without REUSE must not overwrite it.
    CREATE TEMPORARY TABLESPACE SDPTE_DR_TS
        TEMPFILE 'sdpte_dr_01.dbf' SIZE 8M AUTOEXTEND OFF;

    CREATE TEMPORARY TABLESPACE SDPTE_DR_TS
        TEMPFILE 'sdpte_dr_01.dbf' SIZE 8M REUSE AUTOEXTEND OFF;

    SELECT CASE
               WHEN T.TYPE = 6
                AND T.DATAFILE_COUNT = 1
                AND D.ID = 0
                AND D.CURRSIZE = 1024
               THEN 1 ELSE 0
           END AS PASS_EXPLICIT_REUSE
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_DR_TS';

##################################
SECTOR; DROP INCLUDING DATAFILES
##################################
    DROP TABLESPACE SDPTE_DR_TS INCLUDING CONTENTS AND DATAFILES;

    # The same path must now be available without REUSE.
    CREATE TEMPORARY TABLESPACE SDPTE_DR_TS
        TEMPFILE 'sdpte_dr_01.dbf' SIZE 8M AUTOEXTEND OFF;

    SELECT CASE WHEN COUNT(*) = 1 THEN 1 ELSE 0 END AS PASS_DATAFILES_UNLINK
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_DR_TS'
       AND TYPE = 6
       AND DATAFILE_COUNT = 1;

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_DR_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
