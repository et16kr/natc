###########################################################################
# TestCase Description = Independent RESTART TEMP case 02.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_RESTART_02
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_RST02 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_RST02 TEMPFILE 'sdpte_restart_02_01.dbf' SIZE 8M AUTOEXTEND OFF;
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_restart_02_01.dbf"; NODISPLAY ON; CALL stdServerStop(); CALL stdServerStart(); NODISPLAY OFF; CONNECT SYS/MANAGER;
    SELECT CASE WHEN D.TOTAL_PAGE_COUNT=1024 THEN 1 ELSE 0 END AS PASS_RESTART_02 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_RST02' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_RST02 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_restart_02_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_restart_02_02.dbf";
}
