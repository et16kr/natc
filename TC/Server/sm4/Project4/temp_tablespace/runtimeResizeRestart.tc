###########################################################################
# TestCase Description = Reconcile runtime-grown R with ALTER SIZE and restart.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T==D<R, D<T<R, R-based MAX validation, restart R=P reuse.
# Regression Focus     = SERVICE resize driver, D/R/P reconciliation, all-FREE restart state.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
# TC Shape Reference   = /home/et16/work/ataf_mini/tests/disk_temp_table
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_RR_U CASCADE;
    DROP TABLESPACE SDPTE_RR_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_RR_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_RR_DATA
        DATAFILE 'sdpte_rr_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_RR_TS
        TEMPFILE 'sdpte_rr_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_RR_U IDENTIFIED BY SDPTE_RR_U
        DEFAULT TABLESPACE SDPTE_RR_DATA
        TEMPORARY TABLESPACE SDPTE_RR_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_RR_U/SDPTE_RR_U;

    CREATE TABLE SDPTE_RR_SOURCE
    (
        ID      INTEGER,
        K1      VARCHAR(2200)
    ) TABLESPACE SDPTE_RR_DATA;

    INSERT INTO SDPTE_RR_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1990, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;

##################################
SECTOR; R-BASED VALIDATION
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_FIRST_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_RR_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.CURRSIZE > 1024
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 16384
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_R_GT_8M
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

    # MAXSIZE is above committed D=1M but below runtime R, so it must fail.
    ALTER TABLESPACE SDPTE_RR_TS
        ALTER TEMPFILE 'sdpte_rr_01.dbf'
            AUTOEXTEND ON NEXT 1M MAXSIZE 2M;

    SELECT CASE
               WHEN D.CURRSIZE > 1024
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 16384
               THEN 1 ELSE 0
           END AS PASS_REJECT_MAX_BELOW_R
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

##################################
SECTOR; T EQUALS D BELOW R
##################################
    # D is still 1M while R is greater than 8M.  This same-definition ALTER
    # must nevertheless drive the physical shrink from R back to D.
    ALTER TABLESPACE SDPTE_RR_TS
        ALTER TEMPFILE 'sdpte_rr_01.dbf' SIZE 1M;

    SELECT CASE
               WHEN D.CURRSIZE = 128
                AND T.TOTAL_PAGE_COUNT = 128
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_T_EQ_D_LT_R
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

##################################
SECTOR; D BELOW T BELOW R
##################################
    CONNECT SDPTE_RR_U/SDPTE_RR_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SECOND_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_RR_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE WHEN D.CURRSIZE > 1024 THEN 1 ELSE 0 END AS PASS_SECOND_R_GT_8M
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

    # D=1M, T=8M, and the preceding spill established R>8M.
    ALTER TABLESPACE SDPTE_RR_TS
        ALTER TEMPFILE 'sdpte_rr_01.dbf' SIZE 8M;

    SELECT CASE
               WHEN D.CURRSIZE = 1024
                AND T.TOTAL_PAGE_COUNT = 1024
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_D_LT_T_LT_R
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

##################################
SECTOR; RESTART WITH R ABOVE D
##################################
    CONNECT SDPTE_RR_U/SDPTE_RR_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_THIRD_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_RR_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE WHEN D.CURRSIZE > 1024 THEN 1 ELSE 0 END AS PASS_PRE_RESTART_SURPLUS
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    # Existing physical surplus is reusable.  Startup must not truncate it to
    # D=8M, and all transient allocation ownership must be reset to FREE.
    SELECT CASE
               WHEN D.CURRSIZE > 1024
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RESTART_REUSES_R
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RR_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_RR_U CASCADE;
    DROP TABLESPACE SDPTE_RR_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_RR_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
