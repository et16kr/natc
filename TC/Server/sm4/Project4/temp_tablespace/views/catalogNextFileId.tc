###########################################################################
# TestCase Description = Keep the TEMP next-file-ID cursor monotonic across ADD and DROP TEMPFILE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 3.4 committed file IDs are never reused; design 3.1 the TEMP
#                        definition uses the existing Log Anchor `mNewFileID`; design 15.1 exposes
#                        it through the existing NEXT_FILE_ID column.
# Product Reference    = src/sm/sct/sctFT.cpp sctFT::getDiskTBSInfo mNewFileID
#                        src/sm/sdp/sdpte/sdpteAddTempFile.cpp, sdpteDropTempFile.cpp
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_NF_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_nf_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_nf_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_nf_03.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_nf_04.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_NF_TS
        TEMPFILE 'sdptec_nf_01.dbf' SIZE 2M AUTOEXTEND OFF
        EXTENTSIZE 512K
        SEGMENT MANAGEMENT AUTO;

    SELECT CASE
               WHEN TYPE = 6
                AND STATE = 2
                AND NEXT_FILE_ID = 1
                AND DATAFILE_COUNT = 1
                AND EXTENT_MANAGEMENT = 'BITMAP'
                AND SEGMENT_MANAGEMENT = 'AUTO'
                AND EXTENT_PAGE_COUNT = 64
                AND PAGE_SIZE = 8192
                AND ATTR_LOG_COMPRESS = 1
               THEN 1 ELSE 0
           END AS PASS_CREATE_CATALOG
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_NF_TS';

##################################
SECTOR; ADD, DROP AND ADD AGAIN
##################################
    ALTER TABLESPACE SDPTEC_NF_TS ADD TEMPFILE
        'sdptec_nf_02.dbf' SIZE 2M AUTOEXTEND OFF,
        'sdptec_nf_03.dbf' SIZE 2M AUTOEXTEND OFF;

    SELECT CASE
               WHEN NEXT_FILE_ID = 3
                AND DATAFILE_COUNT = 3
               THEN 1 ELSE 0
           END AS PASS_ADD_ADVANCES_CURSOR
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_NF_TS';

    ALTER TABLESPACE SDPTEC_NF_TS
        DROP TEMPFILE 'sdptec_nf_02.dbf', 'sdptec_nf_03.dbf';

    SELECT CASE
               WHEN NEXT_FILE_ID = 3
                AND DATAFILE_COUNT = 1
               THEN 1 ELSE 0
           END AS PASS_DROP_KEEPS_CURSOR
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_NF_TS';

    ALTER TABLESPACE SDPTEC_NF_TS ADD TEMPFILE
        'sdptec_nf_04.dbf' SIZE 2M AUTOEXTEND OFF;

    SELECT CASE
               WHEN T.NEXT_FILE_ID = 4
                AND T.DATAFILE_COUNT = 2
                AND F.MAX_ID = 3
                AND F.MIN_ID = 0
               THEN 1 ELSE 0
           END AS PASS_READD_TAKES_FRESH_ID
      FROM V$TABLESPACES T,
           ( SELECT MAX(D.ID) AS MAX_ID, MIN(D.ID) AS MIN_ID
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_NF_TS' ) F
     WHERE T.NAME = 'SDPTEC_NF_TS';

##################################
SECTOR; THE CURSOR IS DURABLE
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.NEXT_FILE_ID = 4
                AND T.DATAFILE_COUNT = 2
                AND T.SEGMENT_MANAGEMENT = 'AUTO'
                AND T.EXTENT_PAGE_COUNT = 64
                AND F.MAX_ID = 3
               THEN 1 ELSE 0
           END AS PASS_CURSOR_SURVIVES_RESTART
      FROM V$TABLESPACES T,
           ( SELECT MAX(D.ID) AS MAX_ID
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_NF_TS' ) F
     WHERE T.NAME = 'SDPTEC_NF_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_NF_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    # DROP TEMPFILE intentionally detached these files without unlinking them.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_nf_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_nf_03.dbf";
}
