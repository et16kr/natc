 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Verify stable public TEMP file columns before and after runtime spill.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = T-DRP-02, T-DRP-03, T-DRP-08, F-03, F-06.
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> # iSQL Manual          = /home/et16/work/altidev4_gi/docs/manuals/altibase/Altibase_7.1/eng/iSQL User's Manual.md
$T0> # Tuning Manual        = /home/et16/work/altidev4_gi/docs/manuals/altibase/Altibase_7.1/eng/Performance Tuning Guide.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTE_VP_U CASCADE;
$T0> DROP TABLESPACE SDPTE_VP_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_VP_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE SDPTE_VP_DATA
        DATAFILE 'sdpte_vp_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTE_VP_TS
        TEMPFILE 'sdpte_vp_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;
Create success.

$T0> CREATE USER SDPTE_VP_U IDENTIFIED BY SDPTE_VP_U
        DEFAULT TABLESPACE SDPTE_VP_DATA
        TEMPORARY TABLESPACE SDPTE_VP_TS;
Create success.

$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;
Alter success.

$T0> ##################################
$T0> SECTOR 2; INITIAL VIEW
$T0> ##################################
$T0> SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 128
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 16384
                AND D.AUTOEXTEND = 1
                AND D.OPENED = 0
                AND D.IOCOUNT = 0
                AND D.OLDEST_LSN_FILENO = 0
                AND D.OLDEST_LSN_OFFSET = 0
                AND D.CREATE_LSN_FILENO = 0
                AND D.CREATE_LSN_OFFSET = 0
                AND D.SM_VERSION = 0
               THEN 1 ELSE 0
           END AS PASS_INITIAL_FILE_PROJECTION
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_VP_TS';
PASS_INITIAL_FILE_PROJECTION 
-------------------------------
1           
1 row selected.

$T0> CONNECT SDPTE_VP_U/SDPTE_VP_U;
Connect success.

$T0> CREATE TABLE SDPTE_VP_SOURCE
    (
        ID INTEGER,
        K1 VARCHAR(2000)
    ) TABLESPACE SDPTE_VP_DATA;
Create success.

$T0> INSERT INTO SDPTE_VP_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
30000 rows inserted.

$T0> ##################################
$T0> SECTOR 3; RUNTIME VIEW
$T0> ##################################
$T0> SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_VIEW_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_VP_SOURCE
           ) D;
PASS_VIEW_SPILL 
------------------
1           
1 row selected.

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SELECT CASE
               WHEN D.CURRSIZE > D.INITSIZE
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 16384
                AND D.AUTOEXTEND = 1
                AND D.OLDEST_LSN_FILENO = 0
                AND D.OLDEST_LSN_OFFSET = 0
                AND D.CREATE_LSN_FILENO = 0
                AND D.CREATE_LSN_OFFSET = 0
                AND D.SM_VERSION = 0
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_FILE_PROJECTION
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_VP_TS';
PASS_RUNTIME_FILE_PROJECTION 
-------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;
Alter success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTE_VP_U CASCADE;
$T0> DROP TABLESPACE SDPTE_VP_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_VP_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

