###########################################################################
# TestCase Description = Project TEMP extent capacity and free extents from the runtime current.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 6.1 `extent capacity = floor(runtimeLogicalPages / extentPages)`
#                        with the header page and the sub-extent tail excluded, and design 15.1
#                        publishing the free/allocated extent counts through the existing columns.
# Product Reference    = src/sm/sdp/sdpte/sdpteExtent.cpp sdpteExtent::getSpaceStats
#                        src/sm/sdp/sdpte/sdpteHandler.cpp sdpteHandlerGetCachedFreeExtCount
#                        src/sm/sct/sctFT.cpp CACHED_FREE_EXTENT_COUNT / ALLOCATED_PAGE_COUNT
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_XC_EVEN INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_XC_TAIL INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_xc_even_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_xc_even_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_xc_even_03.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_xc_tail_01.dbf";

##################################
SECTOR; PREPARATION
##################################
    # 64-page extents divide 1024, 512 and 256 logical pages exactly:
    # 16 + 8 + 4 = 28 complete extents. File ID 0 reserves its first extent
    # because its first page would otherwise encode the null page ID, so 27
    # extents are usable.
    CREATE TEMPORARY TABLESPACE SDPTEC_XC_EVEN
        TEMPFILE 'sdptec_xc_even_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_xc_even_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_xc_even_03.dbf' SIZE 2M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    # 38-page extents leave a 36-page tail inside a 1024-page file:
    # floor(1024 / 38) = 26 complete extents, 25 of them usable after the
    # file-ID-0 null-page reservation.
    CREATE TEMPORARY TABLESPACE SDPTEC_XC_TAIL
        TEMPFILE 'sdptec_xc_tail_01.dbf' SIZE 8M AUTOEXTEND OFF
        EXTENTSIZE 304K;

##################################
SECTOR; EXACT DIVISION
##################################
    SELECT CASE
               WHEN T.EXTENT_PAGE_COUNT = 64
                AND T.PAGE_SIZE = 8192
                AND T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 1792
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 27
                AND F.TOTAL_CURRENT = 1792
               THEN 1 ELSE 0
           END AS PASS_EXACT_EXTENT_CAPACITY
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_XC_EVEN' ) F
     WHERE T.NAME = 'SDPTEC_XC_EVEN';

##################################
SECTOR; SUB EXTENT TAIL IS NOT CAPACITY
##################################
    SELECT CASE
               WHEN T.EXTENT_PAGE_COUNT = 38
                AND T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 25
               THEN 1 ELSE 0
           END AS PASS_TAIL_EXCLUDED_FROM_CAPACITY
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_XC_TAIL';

##################################
SECTOR; CAPACITY FOLLOWS AN EXPLICIT RESIZE
##################################
    ALTER TABLESPACE SDPTEC_XC_EVEN
        ALTER TEMPFILE 'sdptec_xc_even_03.dbf' SIZE 6M;

    SELECT CASE
               WHEN T.TOTAL_PAGE_COUNT = 2304
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 35
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_CAPACITY_AFTER_GROW
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_XC_EVEN';

    ALTER TABLESPACE SDPTEC_XC_EVEN
        DROP TEMPFILE 'sdptec_xc_even_02.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1792
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 27
               THEN 1 ELSE 0
           END AS PASS_CAPACITY_AFTER_DROP
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_XC_EVEN';

##################################
SECTOR; RESTART REBUILDS THE SAME CAPACITY
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.TOTAL_PAGE_COUNT = 1792
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 27
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_CAPACITY_AFTER_RESTART
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_XC_EVEN';

    SELECT CASE
               WHEN T.TOTAL_PAGE_COUNT = 1024
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 25
               THEN 1 ELSE 0
           END AS PASS_TAIL_CAPACITY_AFTER_RESTART
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_XC_TAIL';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_XC_EVEN INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_XC_TAIL INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    # DROP TEMPFILE intentionally detached this file without unlinking it.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_xc_even_02.dbf";
}
