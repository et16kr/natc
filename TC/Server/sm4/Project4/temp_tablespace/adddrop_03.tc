###########################################################################
# TestCase Description = Independent ADDDROP TEMP case 03.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_ADDDROP_03
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ADD03 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_ADD03 TEMPFILE 'sdpte_adddrop_03_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_ADD03 ADD TEMPFILE 'sdpte_adddrop_03_02.dbf' SIZE 4M AUTOEXTEND OFF, 'sdpte_adddrop_03_03.dbf' SIZE 8M AUTOEXTEND OFF;
    SELECT CASE WHEN D.DATAFILE_COUNT=3 THEN 1 ELSE 0 END AS PASS_ADDDROP_03 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_ADD03' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_ADD03 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
