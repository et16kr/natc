###########################################################################
# TestCase Description = Independent REJECT TEMP case 06.
# Project ID           = workspace/simple_temp_tablespace
# Coverage             = One isolated implementation and catalog assertion.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
SECTOR; INITIALIZATION
    CONNECT SYS/MANAGER;

SECTOR; TEST_REJECT_06
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_REJ06 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
    CREATE TEMPORARY TABLESPACE SDPTE_REJ06 TEMPFILE 'sdpte_reject_06_01.dbf' SIZE 8M AUTOEXTEND OFF;
    ALTER TABLESPACE SDPTE_REJ06 ALTER DATAFILE 'sdpte_reject_06_01.dbf' SIZE 16M;
    SELECT CASE WHEN F.CURRSIZE=1024 THEN 1 ELSE 0 END AS PASS_REJECT_06 FROM V$TABLESPACES D, V$DATAFILES F WHERE D.ID=F.SPACEID AND D.NAME='SDPTE_REJ06' AND F.ID=0;
SECTOR; FINALIZATION
    SKIP BEGIN;
    DROP TABLESPACE SDPTE_REJ06 INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

