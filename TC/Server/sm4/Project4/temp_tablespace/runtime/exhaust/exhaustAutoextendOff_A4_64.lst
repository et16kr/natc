 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Refuse a spill that outgrows an AUTOEXTEND OFF TEMP tablespace and
$T0> #                        leave the space reusable.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = work-area reservation failure is an ordinary statement error, not a
$T0> #                        runtime fault; the failed statement releases every extent it took.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteExtentFacade.cpp smERR_ABORT_NOT_ENOUGH_WORKAREA
$T0> #                        src/sm/smi/smiTempTable.cpp checkAndDump benign error list
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> # Tuning Manual        = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Performance Tuning Guide.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTE_XA_U CASCADE;
$T0> DROP TABLESPACE SDPTE_XA_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_XA_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE SDPTE_XA_DATA
        DATAFILE 'sdpte_xa_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;
Create success.

$T0> # 4M with AUTOEXTEND OFF cannot hold the work area the query below needs.
$T0> CREATE TEMPORARY TABLESPACE SDPTE_XA_TS
        TEMPFILE 'sdpte_xa_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> CREATE USER SDPTE_XA_U IDENTIFIED BY SDPTE_XA_U
        DEFAULT TABLESPACE SDPTE_XA_DATA
        TEMPORARY TABLESPACE SDPTE_XA_TS;
Create success.

$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;
Alter success.

$T0> CONNECT SDPTE_XA_U/SDPTE_XA_U;
Connect success.

$T0> CREATE TABLE SDPTE_XA_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_XA_DATA;
Create success.

$T0> INSERT INTO SDPTE_XA_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 5000;
5000 rows inserted.

$T0> COMMIT;
Commit success.

$T0> ##################################
$T0> SECTOR 2; THE OVERSIZED SPILL IS AN ORDINARY STATEMENT ERROR
$T0> ##################################
$T0> # ERR-11184 is the reservation refusal. It must arrive as a statement error,
$T0> # not as a server-side fault.
$T0> SELECT COUNT(*) AS EXHAUSTED_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XA_SOURCE
           ) D;
[ERR-11184 : Insufficient free space in work area]

$T0> ##################################
$T0> SECTOR 3; THE SESSION AND THE SPACE BOTH SURVIVE
$T0> ##################################
$T0> SELECT 'SESSION_ALIVE' AS PASS_SESSION_SURVIVES FROM DUAL;
PASS_SESSION_SURVIVES  
-------------------------
SESSION_ALIVE  
1 row selected.

$T0> # A work area that fits still succeeds on the same session and the same space.
$T0> SELECT CASE WHEN COUNT(*) = 100 THEN 1 ELSE 0 END AS PASS_SMALL_SPILL_AFTER_REFUSAL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XA_SOURCE
             WHERE ID <= 100
           ) D;
PASS_SMALL_SPILL_AFTER_REFUSAL 
---------------------------------
1           
1 row selected.

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> # The refused statement released every extent it had taken and the AUTOEXTEND OFF
$T0> # definition is untouched.
$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND D.AUTOEXTEND = 0
                AND D.NEXTSIZE = 0
                AND D.MAXSIZE = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_RELEASED_AND_DEFINITION_INTACT
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_XA_TS';
PASS_RUNTIME_RELEASED_AND_DEFINITION_INTAC 
---------------------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;
Alter success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTE_XA_U CASCADE;
$T0> DROP TABLESPACE SDPTE_XA_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_XA_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

