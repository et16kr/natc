###########################################################################
# TestCase Description = Make a refused spill succeed by growing the TEMP file.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = a work-area refusal is recoverable by operator action alone; the resize
#                        lane publishes capacity the runtime can use without a restart, and
#                        shrinking back restores the refusal.
# Product Reference    = src/sm/sdp/sdpte/sdpteAlterSize.cpp
#                        src/sm/sdp/sdpte/sdpteExtentFacade.cpp smERR_ABORT_NOT_ENOUGH_WORKAREA
# Companion Case       = the ADD TEMPFILE recovery path is exhaustThenAddTempfileRecovers.tc,
#                        which is commented out of exhaust.ts because that lane is currently
#                        broken after a refusal. See the README section
#                        "File-set DDL is blocked after a work-area refusal (2026-08-20)".
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_XG_U CASCADE;
    DROP TABLESPACE SDPTE_XG_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_XG_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_XG_DATA
        DATAFILE 'sdpte_xg_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_XG_TS
        TEMPFILE 'sdpte_xg_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE USER SDPTE_XG_U IDENTIFIED BY SDPTE_XG_U
        DEFAULT TABLESPACE SDPTE_XG_DATA
        TEMPORARY TABLESPACE SDPTE_XG_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_XG_U/SDPTE_XG_U;

    CREATE TABLE SDPTE_XG_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_XG_DATA;

    INSERT INTO SDPTE_XG_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('G', 1790, 'G')
      FROM DUAL
    CONNECT BY LEVEL <= 5000;

    COMMIT;

##################################
SECTOR; THE SPILL IS REFUSED AT THE ORIGINAL SIZE
##################################
    SELECT COUNT(*) AS REFUSED_BEFORE_GROW
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XG_SOURCE
           ) D;

##################################
SECTOR; RESIZE PUBLISHES CAPACITY THE SAME SESSION CAN USE
##################################
    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_XG_TS
        ALTER TEMPFILE 'sdpte_xg_01.dbf' SIZE 32M;

    CONNECT SDPTE_XG_U/SDPTE_XG_U;

    SELECT CASE WHEN COUNT(*) = 5000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_RESIZE
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XG_SOURCE
           ) D;

##################################
SECTOR; SHRINKING BACK RESTORES THE REFUSAL
##################################
    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_XG_TS
        ALTER TEMPFILE 'sdpte_xg_01.dbf' SIZE 4M;

    SELECT CASE
               WHEN D.CURRSIZE = 512
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_SHRUNK_BACK
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_XG_TS';

    CONNECT SDPTE_XG_U/SDPTE_XG_U;

    SELECT COUNT(*) AS REFUSED_AFTER_SHRINK
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XG_SOURCE
           ) D;

##################################
SECTOR; GROWING AGAIN RECOVERS IT AGAIN
##################################
    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_XG_TS
        ALTER TEMPFILE 'sdpte_xg_01.dbf' SIZE 32M;

    CONNECT SDPTE_XG_U/SDPTE_XG_U;

    SELECT CASE WHEN COUNT(*) = 5000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_SECOND_RESIZE
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XG_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND D.CURRSIZE = 4096
               THEN 1 ELSE 0
           END AS PASS_DEFINITION_CONSISTENT_AFTER_RECOVERY
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_XG_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_XG_U CASCADE;
    DROP TABLESPACE SDPTE_XG_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_XG_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
