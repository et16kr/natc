###########################################################################
# TestCase Description = Make a refused spill succeed by adding a TEMP file to the tablespace.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = a work-area refusal must be recoverable by adding capacity, not only by
#                        resizing the file that ran out. ADD TEMPFILE and DROP TEMPFILE must keep
#                        working on a tablespace whose last spill was refused.
# Product Reference    = src/sm/sdp/sdpte/sdpteAddTempFile.cpp, sdpteDropTempFile.cpp
#                        src/sm/sdp/sdpte/sdpteExtentFacade.cpp smERR_ABORT_NOT_ENOUGH_WORKAREA
# Regression Origin     = Before the deferred rollback-image fix, ADD/DROP TEMPFILE failed after
#                        this case's ERR-11184 refusal. Keep the case registered so the operator's
#                        natural recovery path cannot regress silently.
# Manual Reference      = ALTIBASE/Documents/Manuals/Altibase_7.1/eng/SQL Reference.md,
#                        ALTER TABLESPACE (datafile_tempfile_clause).
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_XT_U CASCADE;
    DROP TABLESPACE SDPTE_XT_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_XT_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_xt_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_xt_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_XT_DATA
        DATAFILE 'sdpte_xt_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_XT_TS
        TEMPFILE 'sdpte_xt_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE USER SDPTE_XT_U IDENTIFIED BY SDPTE_XT_U
        DEFAULT TABLESPACE SDPTE_XT_DATA
        TEMPORARY TABLESPACE SDPTE_XT_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_XT_U/SDPTE_XT_U;

    CREATE TABLE SDPTE_XT_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_XT_DATA;

    INSERT INTO SDPTE_XT_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('T', 1790, 'T')
      FROM DUAL
    CONNECT BY LEVEL <= 5000;

    COMMIT;

##################################
SECTOR; ADD TEMPFILE WORKS BEFORE ANY REFUSAL
##################################
    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_XT_TS ADD TEMPFILE
        'sdpte_xt_02.dbf' SIZE 2M AUTOEXTEND OFF;

    SELECT CASE
               WHEN DATAFILE_COUNT = 2
                AND TOTAL_PAGE_COUNT = 768
               THEN 1 ELSE 0
           END AS PASS_ADD_BEFORE_REFUSAL
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_XT_TS';

##################################
SECTOR; THE SPILL IS REFUSED AT THIS CAPACITY
##################################
    CONNECT SDPTE_XT_U/SDPTE_XT_U;

    SELECT COUNT(*) AS REFUSED_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XT_SOURCE
           ) D;

##################################
SECTOR; ADD TEMPFILE MUST STILL WORK AFTER THE REFUSAL
##################################
    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_XT_TS ADD TEMPFILE
        'sdpte_xt_03.dbf' SIZE 32M AUTOEXTEND OFF;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.DATAFILE_COUNT = F.FILE_COUNT
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.HAS_NEW_FILE = 1
               THEN 1 ELSE 0
           END AS PASS_ADD_AFTER_REFUSAL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.NAME LIKE '%sdpte_xt_03.dbf'
                              AND D.CURRSIZE = 4096 THEN 1 ELSE 0 END) AS HAS_NEW_FILE
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_XT_TS' ) F
     WHERE T.NAME = 'SDPTE_XT_TS';

##################################
SECTOR; THE ADDED CAPACITY MAKES THE SAME SPILL SUCCEED
##################################
    CONNECT SDPTE_XT_U/SDPTE_XT_U;

    SELECT CASE WHEN COUNT(*) = 5000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_ADD_TEMPFILE
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XT_SOURCE
           ) D;

##################################
SECTOR; DROP TEMPFILE MUST ALSO STILL WORK
##################################
    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTE_XT_TS DROP TEMPFILE 'sdpte_xt_02.dbf';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND T.DATAFILE_COUNT = F.FILE_COUNT
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DROP_AFTER_REFUSAL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTE_XT_TS' ) F
     WHERE T.NAME = 'SDPTE_XT_TS';

    CONNECT SDPTE_XT_U/SDPTE_XT_U;

    SELECT CASE WHEN COUNT(*) = 5000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_DROP_TEMPFILE
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_XT_SOURCE
           ) D;

##################################
SECTOR; FINALIZATION
##################################
    CONNECT SYS/MANAGER;
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_XT_U CASCADE;
    DROP TABLESPACE SDPTE_XT_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_XT_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_xt_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdpte_xt_03.dbf";
}
