###########################################################################
# TestCase Description = Preserve the runtime state of retained tempfiles across DROP TEMPFILE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.4 DROP gates only the target file; F-03 retained-file extent and
#                        AUTOEXTEND state survive; F-04 recomputes the standard TEMP total.
# Product Reference    = src/sm/sdp/sdpte/sdpteDropTempFile.cpp (commits 15059300, 51c9238e)
#                        src/sm/sdp/sdpte/sdpteExtent.cpp per-file drain
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTEC_DF_U CASCADE;
    DROP TABLE SDPTEC_DF_SNAP;
    DROP TABLESPACE SDPTEC_DF_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_DF_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_df_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_DF_DATA
        DATAFILE 'sdptec_df_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTEC_DF_TS
        TEMPFILE 'sdptec_df_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M,
                 'sdptec_df_02.dbf' SIZE 2M AUTOEXTEND OFF,
                 'sdptec_df_03.dbf' SIZE 2M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE TABLE SDPTEC_DF_SNAP ( TAG VARCHAR(32), V INTEGER )
        TABLESPACE SDPTEC_DF_DATA;

    CREATE USER SDPTEC_DF_U IDENTIFIED BY SDPTEC_DF_U
        DEFAULT TABLESPACE SDPTEC_DF_DATA
        TEMPORARY TABLESPACE SDPTEC_DF_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTEC_DF_U/SDPTEC_DF_U;

    CREATE TABLE SDPTEC_DF_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_DF_DATA;

    INSERT INTO SDPTEC_DF_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('D', 1790, 'D')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

##################################
SECTOR; RUNTIME GROWTH BEFORE THE FILE DDL
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_BEFORE_DROP
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_DF_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    INSERT INTO SDPTEC_DF_SNAP
    SELECT 'R_FILE0', D.CURRSIZE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_DF_TS'
       AND D.ID = 0;
    COMMIT;

    SELECT CASE
               WHEN ( SELECT V FROM SDPTEC_DF_SNAP WHERE TAG = 'R_FILE0' ) > 128
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_GREW
      FROM DUAL;

##################################
SECTOR; DROP ONE FILE AND KEEP THE OTHERS INTACT
##################################
    ALTER TABLESPACE SDPTEC_DF_TS
        DROP TEMPFILE 'sdptec_df_03.dbf';

    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(CASE WHEN D.ID = 0
                              AND D.CURRSIZE = ( SELECT V FROM SDPTEC_DF_SNAP
                                                  WHERE TAG = 'R_FILE0' )
                              AND D.INITSIZE = 128
                              AND D.AUTOEXTEND = 1
                              AND D.MAXSIZE = 16384
                             THEN 1 ELSE 0 END) = 1
                AND SUM(CASE WHEN D.ID = 1
                              AND D.CURRSIZE = 256
                              AND D.AUTOEXTEND = 0
                             THEN 1 ELSE 0 END) = 1
               THEN 1 ELSE 0
           END AS PASS_RETAINED_FILES_UNCHANGED
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_DF_TS';

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.TOTAL_PAGE_COUNT = ( SELECT V FROM SDPTEC_DF_SNAP
                                            WHERE TAG = 'R_FILE0' ) + 256
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_TOTAL_RECOMPUTED_AFTER_DROP
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DF_TS' ) F
     WHERE T.NAME = 'SDPTEC_DF_TS';

##################################
SECTOR; THE SURVIVING FILE SET STILL SERVES SPILLS
##################################
    CONNECT SDPTEC_DF_U/SDPTEC_DF_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_DROP
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_DF_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_TOTAL_TRACKS_SURVIVORS
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DF_TS' ) F
     WHERE T.NAME = 'SDPTEC_DF_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTEC_DF_U CASCADE;
    DROP TABLE SDPTEC_DF_SNAP;
    DROP TABLESPACE SDPTEC_DF_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_DF_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_df_03.dbf";
}
