###########################################################################
# TestCase Description = Isolate a 64-page TEMP extent through runtime spill.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T-RUN-01, T-RUN-10, T-RUN-14, F-07.
# SQL/iSQL Manual      = /home/et16/work/altidev4_gi/docs/manuals/altibase/Altibase_7.1/eng/iSQL User's Manual.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_E64_U CASCADE;
    DROP TABLESPACE SDPTE_E64_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_E64_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_E64_DATA
        DATAFILE 'sdpte_e64_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_E64_TS
        TEMPFILE 'sdpte_e64_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_E64_U IDENTIFIED BY SDPTE_E64_U
        DEFAULT TABLESPACE SDPTE_E64_DATA
        TEMPORARY TABLESPACE SDPTE_E64_TS;

    CONNECT SDPTE_E64_U/SDPTE_E64_U;

    CREATE TABLE SDPTE_E64_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_E64_DATA;

    INSERT INTO SDPTE_E64_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

##################################
SECTOR; TEST 64 PAGE EXTENT
##################################
    SELECT CASE
               WHEN COUNT(*) = 30000 AND COUNT(DISTINCT K1) = 30000
               THEN 1 ELSE 0
           END AS PASS_EXTENT_64_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_E64_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.EXTENT_PAGE_COUNT = 64
                AND D.CURRSIZE > D.INITSIZE
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_EXTENT_64_RUNTIME
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_E64_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP USER SDPTE_E64_U CASCADE;
    DROP TABLESPACE SDPTE_E64_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_E64_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
