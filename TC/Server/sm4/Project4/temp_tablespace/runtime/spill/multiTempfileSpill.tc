###########################################################################
# TestCase Description = Spill across two TEMP files, drop one, and reattach the preserved file with REUSE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T-RUN-03, T-RUN-05, T-RUN-14, T-DDL-02.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_MF_U CASCADE;
    DROP TABLESPACE SDPTE_MF_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_MF_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdpte_mf_02.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_MF_DATA
        DATAFILE 'sdpte_mf_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_MF_TS
        TEMPFILE 'sdpte_mf_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M,
                 'sdpte_mf_02.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_MF_U IDENTIFIED BY SDPTE_MF_U
        DEFAULT TABLESPACE SDPTE_MF_DATA
        TEMPORARY TABLESPACE SDPTE_MF_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_MF_U/SDPTE_MF_U;

    CREATE TABLE SDPTE_MF_SOURCE
    (
        ID INTEGER,
        K1 VARCHAR(2000)
    ) TABLESPACE SDPTE_MF_DATA;

    INSERT INTO SDPTE_MF_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;

##################################
SECTOR; MULTI FILE SPILL AND REATTACH
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_MULTI_FILE_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_MF_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(D.CURRSIZE) > SUM(D.INITSIZE)
                AND T.DATAFILE_COUNT = 2
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_BOTH_FILES_USED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_MF_TS'
     GROUP BY T.DATAFILE_COUNT, T.ALLOCATED_PAGE_COUNT;

    ALTER TABLESPACE SDPTE_MF_TS DROP TEMPFILE 'sdpte_mf_02.dbf';

    SELECT CASE WHEN DATAFILE_COUNT = 1 THEN 1 ELSE 0 END AS PASS_SECONDARY_DROPPED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_MF_TS';

    # Ordinary DROP TEMPFILE preserves the physical file, so REUSE is required.
    ALTER TABLESPACE SDPTE_MF_TS ADD TEMPFILE
        'sdpte_mf_02.dbf' SIZE 1M REUSE
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M;

    SELECT CASE
               WHEN DATAFILE_COUNT = 2
                AND ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_SECONDARY_REATTACHED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTE_MF_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_MF_U CASCADE;
    DROP TABLESPACE SDPTE_MF_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_MF_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
