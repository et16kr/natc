###########################################################################
# TestCase Description = Reuse a grown TEMP runtime area for a second spill in the same boot.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T-RUN-10, T-RUN-14, F-02, F-03.
# SQL/iSQL Manual      = /home/et16/work/altidev4_gi/docs/manuals/altibase/Altibase_7.1/eng/iSQL User's Manual.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_RB_U CASCADE;
    DROP TABLESPACE SDPTE_RB_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_RB_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_RB_DATA
        DATAFILE 'sdpte_rb_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_RB_TS
        TEMPFILE 'sdpte_rb_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_RB_U IDENTIFIED BY SDPTE_RB_U
        DEFAULT TABLESPACE SDPTE_RB_DATA
        TEMPORARY TABLESPACE SDPTE_RB_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_RB_U/SDPTE_RB_U;

    CREATE TABLE SDPTE_RB_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_RB_DATA;

    INSERT INTO SDPTE_RB_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

##################################
SECTOR; REPEATED RUNTIME SPILL
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_FIRST_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_RB_SOURCE
           ) D;

    SELECT CASE
               WHEN COUNT(*) = 1000
                AND MIN(CNT) = 30
                AND MAX(CNT) = 30
                AND SUM(CNT) = 30000
               THEN 1 ELSE 0
           END AS PASS_SECOND_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK GROUP_HASH */ MOD(ID, 1000) AS GID,
                   COUNT(*) AS CNT
              FROM SDPTE_RB_SOURCE
             GROUP BY MOD(ID, 1000)
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.EXTENT_PAGE_COUNT = 64
                AND D.CURRSIZE > D.INITSIZE
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_REUSE_PROJECTION
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RB_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_RB_U CASCADE;
    DROP TABLESPACE SDPTE_RB_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_RB_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
