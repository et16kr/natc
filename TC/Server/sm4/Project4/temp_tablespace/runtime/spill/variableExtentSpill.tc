###########################################################################
# TestCase Description = Preserve 38-page and 67-page TEMP extents through spill and restart.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = T-RUN-01, T-RUN-10, T-RUN-14, F-02, F-07.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_VE38_U CASCADE;
    DROP USER SDPTE_VE67_U CASCADE;
    DROP TABLE SDPTE_VE_SOURCE;
    DROP TABLESPACE SDPTE_VE38_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_VE67_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_VE_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_VE_DATA
        DATAFILE 'sdpte_ve_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TABLE SDPTE_VE_SOURCE
    (
        ID INTEGER,
        K1 VARCHAR(2000)
    ) TABLESPACE SDPTE_VE_DATA;

    INSERT INTO SDPTE_VE_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

    CREATE TEMPORARY TABLESPACE SDPTE_VE38_TS
        TEMPFILE 'sdpte_ve38_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 304K;

    CREATE TEMPORARY TABLESPACE SDPTE_VE67_TS
        TEMPFILE 'sdpte_ve67_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 536K;

    CREATE USER SDPTE_VE38_U IDENTIFIED BY SDPTE_VE38_U
        DEFAULT TABLESPACE SDPTE_VE_DATA
        TEMPORARY TABLESPACE SDPTE_VE38_TS;

    CREATE USER SDPTE_VE67_U IDENTIFIED BY SDPTE_VE67_U
        DEFAULT TABLESPACE SDPTE_VE_DATA
        TEMPORARY TABLESPACE SDPTE_VE67_TS;

    GRANT SELECT ON SDPTE_VE_SOURCE TO SDPTE_VE38_U;
    GRANT SELECT ON SDPTE_VE_SOURCE TO SDPTE_VE67_U;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

##################################
SECTOR; VARIABLE EXTENT SPILL
##################################
    CONNECT SDPTE_VE38_U/SDPTE_VE38_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_EXTENT_38_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SYS.SDPTE_VE_SOURCE
           ) D;

    CONNECT SDPTE_VE67_U/SDPTE_VE67_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_EXTENT_67_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SYS.SDPTE_VE_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN SUM(CASE WHEN T.NAME = 'SDPTE_VE38_TS'
                                   AND T.EXTENT_PAGE_COUNT = 38
                                   AND D.CURRSIZE > D.INITSIZE
                              THEN 1 ELSE 0 END) = 1
                AND SUM(CASE WHEN T.NAME = 'SDPTE_VE67_TS'
                                   AND T.EXTENT_PAGE_COUNT = 67
                                   AND D.CURRSIZE > D.INITSIZE
                              THEN 1 ELSE 0 END) = 1
                AND SUM(T.ALLOCATED_PAGE_COUNT) = 0
               THEN 1 ELSE 0
           END AS PASS_VARIABLE_EXTENT_RUNTIME
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME IN ('SDPTE_VE38_TS', 'SDPTE_VE67_TS');

    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN SUM(CASE WHEN NAME = 'SDPTE_VE38_TS'
                                   AND EXTENT_PAGE_COUNT = 38
                                   AND ALLOCATED_PAGE_COUNT = 0
                              THEN 1 ELSE 0 END) = 1
                AND SUM(CASE WHEN NAME = 'SDPTE_VE67_TS'
                                   AND EXTENT_PAGE_COUNT = 67
                                   AND ALLOCATED_PAGE_COUNT = 0
                              THEN 1 ELSE 0 END) = 1
               THEN 1 ELSE 0
           END AS PASS_VARIABLE_EXTENT_RESTART
      FROM V$TABLESPACES
     WHERE NAME IN ('SDPTE_VE38_TS', 'SDPTE_VE67_TS');

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_VE38_U CASCADE;
    DROP USER SDPTE_VE67_U CASCADE;
    DROP TABLE SDPTE_VE_SOURCE;
    DROP TABLESPACE SDPTE_VE38_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_VE67_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_VE_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
