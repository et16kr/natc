###########################################################################
# TestCase Description = Spill a user query into the new TEMP allocator and force runtime AUTOEXTEND.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = ordinary TEMP I/O, extent alloc/free, runtime AUTOEXTEND, R-based public views.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
# TC Shape Reference   = /home/et16/work/ataf_mini/tests/disk_temp_table
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_RT_U CASCADE;
    DROP TABLESPACE SDPTE_RT_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_RT_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_RT_DATA
        DATAFILE 'sdpte_rt_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTE_RT_TS
        TEMPFILE 'sdpte_rt_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_RT_U IDENTIFIED BY SDPTE_RT_U
        DEFAULT TABLESPACE SDPTE_RT_DATA
        TEMPORARY TABLESPACE SDPTE_RT_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_RT_U/SDPTE_RT_U;

    CREATE TABLE SDPTE_RT_SOURCE
    (
        ID      INTEGER,
        K1      VARCHAR(2000)
    ) TABLESPACE SDPTE_RT_DATA;

    INSERT INTO SDPTE_RT_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;

##################################
SECTOR; TEST
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_DISTINCT_HASH
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_RT_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.CURRSIZE > 128
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_AUTOEXTEND
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_RT_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_RT_U CASCADE;
    DROP TABLESPACE SDPTE_RT_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_RT_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
