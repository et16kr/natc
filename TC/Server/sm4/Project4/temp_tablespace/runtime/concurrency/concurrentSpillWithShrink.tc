###########################################################################
# TestCase Description = Issue an ALTER TEMPFILE SIZE shrink while a session is spilling.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.6 step 3 gate close and drain before a shrink target is accepted,
#                        design 13 fixed lock order and re-check after wakeup.
# Regression Focus     = the shrink lane must not hold a file/resize mutex across a drain wait, and
#                        the spilling session must not deadlock against it (commit a0e0ad84).
# Oracle Note          = The shrink is allowed to be refused while extents inside the target-to-
#                        runtime interval are still live. Only the invariants after both sides
#                        finish are asserted, so the case has one stable expected output either way.
# Product Reference    = src/sm/sdp/sdpte/sdpteAlterSizeLane.cpp, src/sm/sdp/sdpte/sdpteExtent.cpp
# iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTEC_CS_U CASCADE;
    DROP TABLESPACE SDPTEC_CS_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_CS_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_CS_DATA
        DATAFILE 'sdptec_cs_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 512M;

    CREATE TEMPORARY TABLESPACE SDPTEC_CS_TS
        TEMPFILE 'sdptec_cs_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 256M,
                 'sdptec_cs_02.dbf' SIZE 8M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE USER SDPTEC_CS_U IDENTIFIED BY SDPTEC_CS_U
        DEFAULT TABLESPACE SDPTEC_CS_DATA
        TEMPORARY TABLESPACE SDPTEC_CS_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTEC_CS_U/SDPTEC_CS_U;

    CREATE TABLE SDPTEC_CS_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_CS_DATA;

    CREATE TABLE SDPTEC_CS_RESULT ( WORKER_ID INTEGER, PASS_VALUE INTEGER )
        TABLESPACE SDPTEC_CS_DATA;

    INSERT INTO SDPTEC_CS_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('S', 1790, 'S')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

##################################
SECTOR; SHRINK ATTEMPT UNDER A LIVE SPILL
##################################
    NODISPLAY ON;
    CALL runSpillWithShrink();
    NODISPLAY OFF;

    CONNECT SDPTEC_CS_U/SDPTEC_CS_U;

    SELECT CASE
               WHEN COUNT(*) = 1
                AND SUM(PASS_VALUE) = 1
               THEN 1 ELSE 0
           END AS PASS_SPILL_COMPLETED_UNDER_SHRINK
      FROM SDPTEC_CS_RESULT;

    CONNECT SYS/MANAGER;

    # Whether the shrink was accepted or refused, the published projection must
    # stay internally consistent and free of leaked allocation.
    SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.OPENED_COUNT = 2
                AND F.SIBLING_CURRENT IN ( 256, 1024 )
               THEN 1 ELSE 0
           END AS PASS_PROJECTION_CONSISTENT
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT,
                    SUM(CASE WHEN D.ID = 1 THEN D.CURRSIZE ELSE 0 END)
                        AS SIBLING_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_CS_TS' ) F
     WHERE T.NAME = 'SDPTEC_CS_TS';

##################################
SECTOR; THE SPACE STILL WORKS AFTERWARDS
##################################
    CONNECT SDPTEC_CS_U/SDPTEC_CS_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_SHRINK
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_CS_SOURCE
           ) D;

##################################
SECTOR; FINALIZATION
##################################
    CONNECT SYS/MANAGER;
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTEC_CS_U CASCADE;
    DROP TABLESPACE SDPTEC_CS_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_CS_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

DEF runSpillWithShrink()
{
    $sPrompt = "$$EOF$$";
    $sClient = "${ALTIBASE_HOME}/bin/isql -s localhost -u SDPTEC_CS_U -p SDPTEC_CS_U -silent -noprompt -ataf";

    EXEC SDPTEC_CS_W1 -t 1800 $sClient;

    SEND SDPTEC_CS_W1 "INSERT INTO SDPTEC_CS_RESULT SELECT 1, CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END FROM (SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1 FROM SDPTEC_CS_SOURCE);";

    CONNECT SYS/MANAGER;

    # Target the AUTOEXTEND OFF sibling so the outcome depends only on whether
    # the drain found live extents inside the shrink interval.
    SKIP BEGIN;
    ALTER TABLESPACE SDPTEC_CS_TS
        ALTER TEMPFILE 'sdptec_cs_02.dbf' SIZE 2M;
    SKIP END;

    P_WAIT SDPTEC_CS_W1 $sPrompt;

    SEND SDPTEC_CS_W1 "COMMIT;";
    P_WAIT SDPTEC_CS_W1 $sPrompt;

    SEND SDPTEC_CS_W1 "QUIT";
    P_WAIT SDPTEC_CS_W1;
}
