 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Run two concurrent spilling sessions through one TEMP autoextend owner.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = T-RUN-06, T-RUN-09, T-RUN-14, F-02, F-03.
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> # iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
$T0> # Repo Manual Fallback = /home/et16/work/altidev4_gi/docs/manuals/altibase/trunk/eng/iSQL User's Manual.md
$T0> # ATAF Process Ref     = TC/Server/sm4/Bugs/BUG-35443/initialize.tc
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTE_PC_U CASCADE;
$T0> DROP TABLESPACE SDPTE_PC_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_PC_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE SDPTE_PC_DATA
        DATAFILE 'sdpte_pc_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 512M;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTE_PC_TS
        TEMPFILE 'sdpte_pc_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 256M
        EXTENTSIZE 512K;
Create success.

$T0> CREATE USER SDPTE_PC_U IDENTIFIED BY SDPTE_PC_U
        DEFAULT TABLESPACE SDPTE_PC_DATA
        TEMPORARY TABLESPACE SDPTE_PC_TS;
Create success.

$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;
Alter success.

$T0> CONNECT SDPTE_PC_U/SDPTE_PC_U;
Connect success.

$T0> CREATE TABLE SDPTE_PC_SOURCE
    (
        ID INTEGER,
        K1 VARCHAR(2000)
    ) TABLESPACE SDPTE_PC_DATA;
Create success.

$T0> CREATE TABLE SDPTE_PC_RESULT
    (
        WORKER_ID INTEGER,
        PASS_VALUE INTEGER
    ) TABLESPACE SDPTE_PC_DATA;
Create success.

$T0> INSERT INTO SDPTE_PC_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('X', 1790, 'X')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
30000 rows inserted.
$T0> COMMIT;
Commit success.

$T0> ##################################
$T0> SECTOR 2; PARALLEL AUTOEXTEND
$T0> ##################################

$T0> CONNECT SDPTE_PC_U/SDPTE_PC_U;
Connect success.

$T0> SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(PASS_VALUE) = 2
                AND COUNT(DISTINCT WORKER_ID) = 2
               THEN 1 ELSE 0
           END AS PASS_PARALLEL_RESULTS
      FROM SDPTE_PC_RESULT;
PASS_PARALLEL_RESULTS 
------------------------
1           
1 row selected.

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SELECT CASE
               WHEN D.CURRSIZE > D.INITSIZE
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 32768
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_PARALLEL_RUNTIME_CLEAN
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_PC_TS';
PASS_PARALLEL_RUNTIME_CLEAN 
------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; FINALIZATION
$T0> ##################################
$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;
Alter success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTE_PC_U CASCADE;
$T0> DROP TABLESPACE SDPTE_PC_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTE_PC_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

