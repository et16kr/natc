 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Run TEMP file DDL while a spilling session holds the TEMP runtime.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 13 lock order and gate/drain rules; F-01 reader leases keep a
$T0> #                        retired runtime bundle alive; F-02 old-or-new publication.
$T0> # Regression Focus     = the TEMP page-lookup and reopen paths must resolve a runtime owner without
$T0> #                        re-entering the tablespace registry latch that their caller already holds
$T0> #                        (commits 6ea851df, 6bee37ee, a0e0ad84).
$T0> # Product Reference    = src/sm/sdd/sddTableSpace.cpp getDataFileNodeByPageID TEMP branch
$T0> #                        src/sm/sdd/sddDataFile.cpp sddDataFile::open reopen validation
$T0> #                        src/sm/sdp/sdpte/sdpteAddTempFile.cpp, sdpteDropTempFile.cpp
$T0> # iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
$T0> # ATAF Process Ref     = TC/Server/sm4/Project4/temp_tablespace/runtime/concurrency/parallelAutoextend.tc
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTEC_CF_U CASCADE;
$T0> DROP TABLESPACE SDPTEC_CF_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_CF_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_cf_02.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE SDPTEC_CF_DATA
        DATAFILE 'sdptec_cf_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 512M;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTEC_CF_TS
        TEMPFILE 'sdptec_cf_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 256M
        EXTENTSIZE 512K;
Create success.

$T0> CREATE USER SDPTEC_CF_U IDENTIFIED BY SDPTEC_CF_U
        DEFAULT TABLESPACE SDPTEC_CF_DATA
        TEMPORARY TABLESPACE SDPTEC_CF_TS;
Create success.

$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;
Alter success.
$T0> ALTER SYSTEM SET SORT_AREA_SIZE = 524288;
Alter success.

$T0> CONNECT SDPTEC_CF_U/SDPTEC_CF_U;
Connect success.

$T0> CREATE TABLE SDPTEC_CF_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_CF_DATA;
Create success.

$T0> CREATE TABLE SDPTEC_CF_RESULT ( WORKER_ID INTEGER, PASS_VALUE INTEGER )
        TABLESPACE SDPTEC_CF_DATA;
Create success.

$T0> INSERT INTO SDPTEC_CF_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('C', 1790, 'C')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
30000 rows inserted.
$T0> COMMIT;
Commit success.

$T0> ##################################
$T0> SECTOR 2; FILE DDL UNDER A LIVE SPILL
$T0> ##################################

$T0> CONNECT SDPTEC_CF_U/SDPTEC_CF_U;
Connect success.

$T0> SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(PASS_VALUE) = 2
               THEN 1 ELSE 0
           END AS PASS_SPILLS_COMPLETED
      FROM SDPTEC_CF_RESULT;
PASS_SPILLS_COMPLETED 
------------------------
1           
1 row selected.

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> # The added file was dropped again, so the definition is back to one file
$T0> # and the published total still equals the live file set.
$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.FILE_COUNT = 1
                AND F.MIN_ID = 0
                AND F.OPENED_COUNT = 1
               THEN 1 ELSE 0
           END AS PASS_CONCURRENT_DDL_CONSISTENT
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    MIN(D.ID) AS MIN_ID,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_CF_TS' ) F
     WHERE T.NAME = 'SDPTEC_CF_TS';
PASS_CONCURRENT_DDL_CONSISTENT 
---------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; THE SPACE STILL WORKS AFTER THE DDL BURST
$T0> ##################################
$T0> CONNECT SDPTEC_CF_U/SDPTEC_CF_U;
Connect success.

$T0> SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_DDL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_CF_SOURCE
           ) D;
PASS_SPILL_AFTER_DDL 
-----------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.
$T0> ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;
Alter success.
$T0> ALTER SYSTEM SET SORT_AREA_SIZE = 1048576;
Alter success.

$T0> SKIP BEGIN;
$T0> DROP USER SDPTEC_CF_U CASCADE;
$T0> DROP TABLESPACE SDPTEC_CF_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_CF_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

