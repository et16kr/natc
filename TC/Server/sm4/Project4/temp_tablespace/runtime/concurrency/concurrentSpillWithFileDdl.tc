###########################################################################
# TestCase Description = Run TEMP file DDL while a spilling session holds the TEMP runtime.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 13 registry-to-lifecycle lock order and replacement gate/drain
#                        rules; F-02 readers observe only the old or the new file-set publication.
# Regression Focus     = the TEMP page-lookup and reopen paths must resolve a runtime owner without
#                        re-entering the tablespace registry latch that their caller already holds
#                        (commits 6ea851df, 6bee37ee, a0e0ad84). For page I/O, a file-set publication
#                        is transient contention rather than a missing page: treating it as gone
#                        raised smERR_FATAL_NotFoundDataFile and took the server down.
# Coverage Limit       = this case does not force the REPLACING window open. It is a crash guard for
#                        the outer page-I/O path, while unittestSdpteWiring deterministically proves
#                        the facade's typed REPLACING/no-error handoff. The sdd retry loop itself and
#                        reopen during REPLACING are not forced by this case.
# Product Reference    = src/sm/sdd/sddDiskMgr.cpp TEMP-aware page-node resolution retry
#                        src/sm/sdp/sdpte/sdpteFileFacade.cpp typed owner classification
#                        src/sm/sdd/sddDataFile.cpp sddDataFile::open reopen validation
#                        src/sm/sdp/sdpte/sdpteAddTempFile.cpp, sdpteDropTempFile.cpp
# iSQL Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/iSQL User's Manual.md
# ATAF Process Ref     = TC/Server/sm4/Project4/temp_tablespace/runtime/concurrency/parallelAutoextend.tc
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTEC_CF_U CASCADE;
    DROP TABLESPACE SDPTEC_CF_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_CF_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_cf_02.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_CF_DATA
        DATAFILE 'sdptec_cf_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 512M;

    CREATE TEMPORARY TABLESPACE SDPTEC_CF_TS
        TEMPFILE 'sdptec_cf_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 256M
        EXTENTSIZE 512K;

    CREATE USER SDPTEC_CF_U IDENTIFIED BY SDPTEC_CF_U
        DEFAULT TABLESPACE SDPTEC_CF_DATA
        TEMPORARY TABLESPACE SDPTEC_CF_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;
    ALTER SYSTEM SET SORT_AREA_SIZE = 524288;

    CONNECT SDPTEC_CF_U/SDPTEC_CF_U;

    CREATE TABLE SDPTEC_CF_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_CF_DATA;

    CREATE TABLE SDPTEC_CF_RESULT ( WORKER_ID INTEGER, PASS_VALUE INTEGER )
        TABLESPACE SDPTEC_CF_DATA;

    INSERT INTO SDPTEC_CF_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('C', 1790, 'C')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

##################################
SECTOR; FILE DDL UNDER A LIVE SPILL
##################################
    NODISPLAY ON;
    CALL runSpillWithFileDdl();
    NODISPLAY OFF;

    CONNECT SDPTEC_CF_U/SDPTEC_CF_U;

    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(PASS_VALUE) = 2
               THEN 1 ELSE 0
           END AS PASS_SPILLS_COMPLETED
      FROM SDPTEC_CF_RESULT;

    CONNECT SYS/MANAGER;

    # The added file was dropped again, so the definition is back to one file
    # and the published total still equals the live file set.
    SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.FILE_COUNT = 1
                AND F.MIN_ID = 0
                AND F.OPENED_COUNT = 1
               THEN 1 ELSE 0
           END AS PASS_CONCURRENT_DDL_CONSISTENT
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    MIN(D.ID) AS MIN_ID,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_CF_TS' ) F
     WHERE T.NAME = 'SDPTEC_CF_TS';

##################################
SECTOR; THE SPACE STILL WORKS AFTER THE DDL BURST
##################################
    CONNECT SDPTEC_CF_U/SDPTEC_CF_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_DDL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_CF_SOURCE
           ) D;

##################################
SECTOR; FINALIZATION
##################################
    CONNECT SYS/MANAGER;
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;
    ALTER SYSTEM SET SORT_AREA_SIZE = 1048576;

    SKIP BEGIN;
    DROP USER SDPTEC_CF_U CASCADE;
    DROP TABLESPACE SDPTEC_CF_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_CF_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}

DEF runSpillWithFileDdl()
{
    $sPrompt = "$$EOF$$";
    $sClient = "${ALTIBASE_HOME}/bin/isql -s localhost -u SDPTEC_CF_U -p SDPTEC_CF_U -silent -noprompt -ataf";

    EXEC SDPTEC_CF_W1 -t 1800 $sClient;
    EXEC SDPTEC_CF_W2 -t 1800 $sClient;

    # Both workers keep the TEMP runtime busy while the DDL below runs.
    SEND SDPTEC_CF_W1 "INSERT INTO SDPTEC_CF_RESULT SELECT 1, CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END FROM (SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1 FROM SDPTEC_CF_SOURCE);";
    SEND SDPTEC_CF_W2 "INSERT INTO SDPTEC_CF_RESULT SELECT 2, CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END FROM (SELECT /*+ TEMP_TBS_DISK DISTINCT_SORT */ DISTINCT K1 FROM SDPTEC_CF_SOURCE);";

    CONNECT SYS/MANAGER;

    ALTER TABLESPACE SDPTEC_CF_TS ADD TEMPFILE
        'sdptec_cf_02.dbf' SIZE 2M AUTOEXTEND OFF;

    ALTER TABLESPACE SDPTEC_CF_TS
        ALTER TEMPFILE 'sdptec_cf_02.dbf' SIZE 4M;

    ALTER TABLESPACE SDPTEC_CF_TS
        ALTER TEMPFILE 'sdptec_cf_01.dbf'
            AUTOEXTEND ON NEXT 2M MAXSIZE 256M;

    P_WAIT SDPTEC_CF_W1 $sPrompt;
    P_WAIT SDPTEC_CF_W2 $sPrompt;

    SEND SDPTEC_CF_W1 "COMMIT;";
    SEND SDPTEC_CF_W2 "COMMIT;";
    P_WAIT SDPTEC_CF_W1 $sPrompt;
    P_WAIT SDPTEC_CF_W2 $sPrompt;

    SEND SDPTEC_CF_W1 "QUIT";
    SEND SDPTEC_CF_W2 "QUIT";
    P_WAIT SDPTEC_CF_W1;
    P_WAIT SDPTEC_CF_W2;

    ALTER TABLESPACE SDPTEC_CF_TS
        DROP TEMPFILE 'sdptec_cf_02.dbf';

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_cf_02.dbf";
}
