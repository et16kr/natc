###########################################################################
# TestCase Description = Keep a TEMP file at one working size across repeated identical spills.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = extents freed at statement end return to the space rather than being
#                        abandoned, so the physical file converges instead of growing per statement.
# Product Reference    = src/sm/sdp/sdpte/sdpteExtent.cpp free-extent return path
#                        src/sm/sdp/sdpte/sdpteAutoExtend.cpp grow-only-when-short policy
# Regression Focus     = a leak in the free-extent return path shows up here as CURRSIZE climbing
#                        with each repetition while ALLOCATED_PAGE_COUNT still reads zero.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTE_LR_U CASCADE;
    DROP TABLESPACE SDPTE_LR_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_LR_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTE_LR_DATA
        DATAFILE 'sdpte_lr_data.dbf' SIZE 16M
            AUTOEXTEND ON NEXT 16M MAXSIZE 512M;

    CREATE TEMPORARY TABLESPACE SDPTE_LR_TS
        TEMPFILE 'sdpte_lr_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M
        EXTENTSIZE 512K;

    CREATE USER SDPTE_LR_U IDENTIFIED BY SDPTE_LR_U
        DEFAULT TABLESPACE SDPTE_LR_DATA
        TEMPORARY TABLESPACE SDPTE_LR_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTE_LR_U/SDPTE_LR_U;

    CREATE TABLE SDPTE_LR_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTE_LR_DATA;

    INSERT INTO SDPTE_LR_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('L', 1790, 'L')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;

    COMMIT;

##################################
SECTOR; THE FIRST SPILL ESTABLISHES THE WORKING SIZE
##################################
    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_01
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_LR_SOURCE
           ) D;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_02
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_LR_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT D.INITSIZE,
           D.CURRSIZE,
           T.TOTAL_PAGE_COUNT,
           T.ALLOCATED_PAGE_COUNT
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_LR_TS';

    # 7808 pages is the size this work-area shape settles on. It is recorded here
    # so a later drift in the growth policy is visible rather than silent.
    SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 7808
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_WORKING_SIZE_ESTABLISHED
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_LR_TS';

##################################
SECTOR; FOUR MORE IDENTICAL SPILLS DO NOT GROW THE FILE
##################################
    CONNECT SDPTE_LR_U/SDPTE_LR_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_03
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_LR_SOURCE
           ) D;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_04
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_LR_SOURCE
           ) D;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_05
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_LR_SOURCE
           ) D;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_06
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTE_LR_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT D.INITSIZE,
           D.CURRSIZE,
           T.TOTAL_PAGE_COUNT,
           T.ALLOCATED_PAGE_COUNT
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_LR_TS';

    SELECT CASE
               WHEN D.CURRSIZE = 7808
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_SIZE_STABLE_ACROSS_REPEATS
      FROM V$TABLESPACES T,
           V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTE_LR_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTE_LR_U CASCADE;
    DROP TABLESPACE SDPTE_LR_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTE_LR_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
