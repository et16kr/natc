###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/design/selectivity.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;
alter session set trclog_explain_graph = 0;

SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF INSERT_DATA( @aTable, @aI2, @aI3, @aI4, @aI5 )
{
NODISPLAY ON;

truncate table @{aTable};

$i = 1;
$i1 = 0;
$i2 = 0;
$i3 = 0;
$i4 = 0;

LOOP 100
{
  $i1 = $i;

  if ( $i <= @aI2 )
  {
    $i2 = $i;
  }
  if ( $i <= @aI3 )
  {
    $i3 = $i;
  }
  if ( $i <= @aI4 )
  {
    $i4 = $i;
  }
  if ( $i <= @aI5 )
  {
    $i5 = $i;
  }
    
  insert into @{aTable} values ( ${i1}, ${i2}, ${i3}, ${i4}, ${i5} );

  $i = $i + 1;
}

drop index t1_idx2;
drop index t1_idx3;
drop index t1_idx4;
drop index t1_idx5;

create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i3) local;
create index t1_idx4 on t1(i4);
create index t1_idx5 on t1(i5);

NODISPLAY OFF;

EXEC GATHER_TABLE_STATS('SYS','@{aTable}');

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;

select count(distinct i1) from @{aTable}
union all
select count(distinct i2) from @{aTable}
union all
select count(distinct i3) from @{aTable}
union all
select count(distinct i4) from @{aTable}
union all
select count(distinct i5) from @{aTable};

}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer,
  i5 integer
)
partition by range(i1)
(
  partition p1 values less than (50),
  partition pd values default
)
tablespace sys_tbs_disk_data;

create index t1_idx2 on t1(i2) local;
create index t1_idx3 on t1(i3) local;
create index t1_idx4 on t1(i4);
create index t1_idx5 on t1(i5);

desc t1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 30
# idx3: i3, local index, ndv = 20
# idx4: i4, global index, ndv = 20
# idx5: i5, global index, ndv = 20

CALL INSERT_DATA( "T1", 30, 20, 20, 20 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 20
# idx3: i3, local index, ndv = 30
# idx4: i4, global index, ndv = 20
# idx5: i5, global index, ndv = 20

CALL INSERT_DATA( "T1", 20, 30, 20, 20 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 20
# idx3: i3, local index, ndv = 20
# idx4: i4, global index, ndv = 30
# idx5: i5, global index, ndv = 20

CALL INSERT_DATA( "T1", 20, 20, 30, 20 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 20
# idx3: i3, local index, ndv = 20
# idx4: i4, global index, ndv = 20
# idx5: i5, global index, ndv = 30

CALL INSERT_DATA( "T1", 20, 20, 20, 30 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 30
# idx3: i3, local index, ndv = 30
# idx4: i4, global index, ndv = 20
# idx5: i5, global index, ndv = 20

CALL INSERT_DATA( "T1", 30, 30, 20, 20 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 20
# idx3: i3, local index, ndv = 20
# idx4: i4, global index, ndv = 30
# idx5: i5, global index, ndv = 30

CALL INSERT_DATA( "T1", 20, 20, 30, 30 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 30
# idx3: i3, local index, ndv = 20
# idx4: i4, global index, ndv = 30
# idx5: i5, global index, ndv = 20

CALL INSERT_DATA( "T1", 30, 20, 30, 20 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; BEST ACCESS METHOD
##################################

# idx2: i2, local index, ndv = 20
# idx3: i3, local index, ndv = 30
# idx4: i4, global index, ndv = 20
# idx5: i5, global index, ndv = 30

CALL INSERT_DATA( "T1", 20, 30, 20, 30 );

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

select * from t1 where i2 = 1 and i3 = 1 and i4 = 1 and i5 = 1;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
