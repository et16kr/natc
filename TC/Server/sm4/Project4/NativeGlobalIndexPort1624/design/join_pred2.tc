###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/design/join_pred2.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;

alter session set explain plan = off;
alter session set trclog_detail_predicate = 0;
alter system set trclog_explain_graph = 0;

SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

set linesize 200;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

create table t1(i1 integer, i2 integer, i3 integer)
partition by range(i1)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;

insert into t1 values (1, 1, 1);
insert into t1 values (2, 1, 2);
insert into t1 values (3, 3, 3);
insert into t1 values (4, 3, 4);

create index t1_i2 on t1(i2);

create table t2(i1 integer, i2 integer, i3 integer)
partition by range(i1)
(
  partition p1 values less than (3),
  partition p2 values default
)
tablespace sys_tbs_disk_data;

insert into t2 values (1, 1, 1);
insert into t2 values (2, 1, 2);
insert into t2 values (3, 3, 3);
insert into t2 values (4, 3, 4);

create index t2_i1 on t2(i1);

alter session set explain plan = on;
alter session set trclog_detail_predicate = 1;

##################################
# SECTOR; JOIN
##################################

select 1 from t1,t2 where t1.i1=t2.i1;

##################################
# SECTOR; JOIN FILTER
##################################

select 1 from t1,t2 where t1.i1=t2.i1 and t1.i2=t2.i2;

##################################
# SECTOR; JOIN + LEFT ORDER
##################################

select 1 from t1,t2 where t1.i1=t2.i1 order by t1.i2;
select 1 from t1,t2 where t1.i1=t2.i1 order by t1.i2 desc;

##################################
# SECTOR; JOIN FILTER + LEFT ORDER
##################################

select 1 from t1,t2 where t1.i1=t2.i1 and t1.i2=t2.i2 order by t1.i2;
select 1 from t1,t2 where t1.i1=t2.i1 and t1.i2=t2.i2 order by t1.i2 desc;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
