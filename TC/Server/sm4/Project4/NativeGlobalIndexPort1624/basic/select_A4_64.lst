$T0> alter session set explain plan = off;
Alter success.

$T0> ##################################
$T0> # SECTOR; HASH PARTITION
$T0> ##################################

$T0> create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3,
  partition p4,
  partition p5
)
tablespace sys_tbs_disk_data;
Create success.

$T0> insert into t2 select level, level/3, mod(level,3), 1 from dual connect by level <= 100;
100 rows inserted.

$T0> create index t2_idx1 on t2(i2, i3);
Create success.
$T0> create index t2_idx2 on t2(i2, i3 desc);
Create success.

$T0> desc t2;
[ TABLESPACE : SYS_TBS_DISK_DATA ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T2_IDX1                                  BTREE                  I2 ASC,
                                                                I3 ASC
T2_IDX2                                  BTREE                  I2 ASC,
                                                                I3 DESC
T2 has no primary key

$T0> select cast(i.index_name as varchar(20)) index_name,
         cast( case when i.index_table_id != 0          then 'GIT-HIDDEN-TABLE'
                    when i.is_partitioned = 'T'         then 'LOCAL'
                    when nvl(p.partition_type,-1) = 101 then 'NATIVE-GLOBAL'
                    else 'UNKNOWN' end as varchar(16) ) kind,
         i.index_table_id,
         cast(i.is_partitioned as varchar(1)) is_part,
         nvl(p.partition_type,-1) part_type
  from system_.sys_indices_ i,
       system_.sys_tables_ t,
       ( select index_id, max(partition_type) partition_type
         from system_.sys_part_indices_ group by index_id ) p
  where i.table_id = t.table_id
    and t.table_name = upper('t2')
    and t.user_id = user_id()
    and i.index_id = p.index_id(+)
  order by 1;
INDEX_NAME            KIND              INDEX_TABLE_ID IS_PART  PART_TYPE   
----------------------------------------------------------------------------------
T2_IDX1               NATIVE-GLOBAL     0           F  101         
T2_IDX2               NATIVE-GLOBAL     0           F  101         
