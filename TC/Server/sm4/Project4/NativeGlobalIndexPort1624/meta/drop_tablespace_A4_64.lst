$T0> # SECTOR; CREATE TABLE
$T0> ##################################

$T0> create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  constraint t2_pk primary key (i3) using index tablespace data1,
  constraint t2_uk unique (i4)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace data2;
Create success.

$T0> create index idx3 on t2(i2) tablespace sys_tbs_disk_data;
Create success.
$T0> create index idx4 on t2(i2 desc, i3 desc) tablespace data2;
Create success.

$T0> desc t2;
[ TABLESPACE : DATA2 ]
[ ATTRIBUTE ]                                                         
------------------------------------------------------------------------------
NAME                                     TYPE                        IS NULL 
------------------------------------------------------------------------------
I1                                       INTEGER                     
I2                                       INTEGER                     
I3                                       INTEGER                     NOT NULL
I4                                       INTEGER                     
[ INDEX ]                                                       
------------------------------------------------------------------------------
NAME                                     TYPE     IS UNIQUE     COLUMN
------------------------------------------------------------------------------
T2_PK                                    BTREE    UNIQUE        I3 ASC
T2_UK                                    BTREE    UNIQUE        I4 ASC
IDX3                                     BTREE                  I2 ASC
IDX4                                     BTREE                  I2 DESC,
                                                                I3 DESC
[ PRIMARY KEY ]                                                 
------------------------------------------------------------------------------
I3
