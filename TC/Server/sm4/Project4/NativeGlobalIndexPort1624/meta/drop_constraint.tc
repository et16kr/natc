###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/meta/drop_constraint.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;
INCLUDE select_meta.i

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop user user1 cascade;
drop tablespace data1 including contents and datafiles;
drop tablespace data2 including contents and datafiles;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;

create user user1 identified by user1;

grant all privileges to user1;
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; CREATE TABLE
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

connect user1/user1;

create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

connect sys/manager;

##################################
# SECTOR; BACKUP META
##################################

CALL CREATE_BACKUP_META();

##################################
# SECTOR; CREATE CONSTRAINT
##################################

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

CALL SELECT_META();

connect user1/user1;

alter table t2 add constraint t2_pk primary key (i3, i4) using index tablespace data1;
alter table t2 add constraint t2_uk unique (i5, i6) using index tablespace data2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "T2_UK" );

connect sys/manager;

CALL SELECT_META();

##################################
# SECTOR; DROP CONSTRAINT
##################################

alter table t1 drop constraint t1_pk;
alter table t1 drop constraint t1_uk;

connect user1/user1;

alter table t2 drop constraint t2_pk;
alter table t2 drop constraint t2_uk;

connect sys/manager;

##################################
# SECTOR; COMPARE META
##################################

CALL COMPARE_META();

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
