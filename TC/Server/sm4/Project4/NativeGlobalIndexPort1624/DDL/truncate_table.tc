###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/DDL/truncate_table.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
drop tablespace data1 including contents and datafiles;
drop tablespace data2 including contents and datafiles;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

create tablespace data1 datafile 'data1.dbf' size 10M autoextend on;
create tablespace data2 datafile 'data2.dbf' size 10M autoextend on;
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; TRUNCATE TABLE
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  constraint t1_pk primary key (i3),
  constraint t1_uk unique (i4)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index idx1 on t1(i1) local;
create index idx2 on t1(i2);

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "IDX2" );

truncate table t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "IDX2" );

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer,
  i7 integer,
  i8 integer,
  constraint t1_pk primary key (i3, i5),
  constraint t1_uk unique (i6, i7)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

create index idx1 on t1(i1, i2 desc) local;
create index idx2 on t1(i4 desc, i8 desc);
create index idx3 on t1(i3 desc, i6, i2 desc);

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "IDX2" );
CALL DESC_INDEX( "IDX3" );

truncate table t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "IDX2" );
CALL DESC_INDEX( "IDX3" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
