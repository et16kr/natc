###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/DDL/add_constraint.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

INCLUDE desc_global_index.i;

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
drop table t2;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF DROP_TABLE()
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
drop table t2;
drop table t1;
drop table t2;
SKIP END;
NODISPLAY OFF;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; PRIMARY KEY, UNIQUE
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

# success
insert into t1 values (1, 1, 1, 1);
# pk error
insert into t1 values (1, 1, 1, 2);
insert into t1 values (1, 1, null, 3);
# uk error
insert into t1 values (1, 1, 2, 1);

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

##################################
# SECTOR; PRIMARY KEY, UNIQUE
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 integer,
  i5 integer,
  i6 integer
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3, i4);
alter table t1 add constraint t1_uk unique (i5, i6);

# success
insert into t1 values (1, 1, 1, 1, 1, 1);
# pk error
insert into t1 values (1, 1, 1, 2, 2, 2);
insert into t1 values (1, 1, 2, null, 3, 3);
# uk error
insert into t1 values (1, 1, 2, 2, 1, 1);

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

##################################
# SECTOR; FOREIGN KEY
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 varchar(10)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3);
alter table t1 add constraint t1_uk unique (i4);

insert into t1 values ( 1, 1, 1, 'abc');
insert into t1 values (11, 1, 2, 'def');
insert into t1 values (21, 1, 3, 'ghi');
insert into t1 values (31, 1, 4, 'zyx');

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 varchar(10)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t2 add constraint t2_pk primary key (i3);
alter table t2 add constraint t2_fk foreign key (i4) references t1 (i4) on delete cascade;

create index idx1 on t2(i2);

# success
insert into t2 values ( 1, 1, 1, 'abc');
insert into t2 values (11, 2, 2, 'def');
insert into t2 values (21, 3, 3, 'ghi');
# fail
insert into t2 values (31, 4, 'xxx');

select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

delete from t1 where i3 = 1;

select * from t1;
select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

update t1 set i4 = 'xxx' where i3 = 3;

select * from t1;
select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

##################################
# SECTOR; FOREIGN KEY
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 varchar(10),
  i5 integer,
  i6 varchar(10)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3, i4);
alter table t1 add constraint t1_uk unique (i5, i6);

insert into t1 values ( 1, 1, 1, 'abc', 1, 'abc');
insert into t1 values (11, 1, 2, 'def', 2, 'def');
insert into t1 values (21, 1, 3, 'ghi', 3, 'ghi');
insert into t1 values (31, 1, 4, 'zyx', 4, 'zyx');

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 varchar(10),
  i5 integer,
  i6 varchar(10)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t2 add constraint t2_pk primary key (i3, i4);
alter table t2 add constraint t2_fk foreign key (i5, i6) references t1 (i5, i6) on delete set null;

create index idx1 on t2( i2, i1 );

# success
insert into t2 values ( 1, 1, 1, 'abc', 1, 'abc');
insert into t2 values (11, 2, 2, 'def', 2, 'def');
insert into t2 values (21, 3, 3, 'ghi', 3, 'ghi');
# fail
insert into t2 values (31, 4, 4, 'xxx', 4, 'xxx');

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

delete from t1 where i3 = 1;

select * from t1;
select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

update t1 set i6 = 'xxx' where i3 = 3;

select * from t1;
select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

##################################
# SECTOR; FOREIGN KEY
##################################

CALL DROP_TABLE();

create table t1
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 varchar(10),
  i5 integer,
  i6 varchar(10)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i3, i4);
alter table t1 add constraint t1_uk unique (i5, i6);

insert into t1 values ( 1, 1, 1, 'abc', 1, 'abc');
insert into t1 values (11, 1, 2, 'def', 2, 'def');
insert into t1 values (21, 1, 3, 'ghi', 3, 'ghi');
insert into t1 values (31, 1, 4, 'zyx', 4, 'zyx');

select * from t1;

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );

create table t2
( 
  i1 integer, 
  i2 integer,
  i3 integer,
  i4 varchar(10),
  i5 integer,
  i6 varchar(10)
)
partition by range(i1)
(
  partition p1 values less than (10),
  partition p2 values less than (20),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

alter table t2 add constraint t2_pk primary key (i3, i4);
alter table t2 add constraint t2_fk foreign key (i5, i6) references t1 (i5, i6);

create index idx1 on t2( i2, i1 );

# success
insert into t2 values ( 1, 1, 1, 'abc', 1, 'abc');
insert into t2 values (11, 2, 2, 'def', 2, 'def');
insert into t2 values (21, 3, 3, 'ghi', 3, 'ghi');
# fail
insert into t2 values (31, 4, 4, 'xxx', 4, 'xxx');

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

# fail
delete from t1 where i3 = 1;

select * from t1;
select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

# fail
update t1 set i6 = 'xxx' where i3 = 3;

select * from t1;
select * from t2;

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "IDX1" );

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
