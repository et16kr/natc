###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/DDL/index_name.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../include/globalIndexEnv.i;

###########################################################################
# Global Index Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
drop table t1;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();
}

DEF CREATE_TABLE( @aPartType, @aColType1, @aColType2 )
{
NODISPLAY ON;
SKIP BEGIN;
drop table t1;
SKIP END;
NODISPLAY OFF;

if ( @aPartType == 'range' )
{

create table t1( i1 @{aColType1}, i2 @{aColType2}, i3 @{aColType2} )
partition by range(i1)
(
  partition p1 values less than ('100'),
  partition p2 values less than ('200'),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

}
elsif ( @aPartType == 'hash' )
{

create table t1( i1 @{aColType1}, i2 @{aColType2}, i3 @{aColType2} )
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3
)
tablespace sys_tbs_disk_data;

}
elsif ( @aPartType == 'list' )
{

create table t1( i1 @{aColType1}, i2 @{aColType2}, i3 @{aColType2} )
partition by list(i1)
(
  partition p1 values ('100'),
  partition p2 values ('200'),
  partition p3 values default
)
tablespace sys_tbs_disk_data;

}
else
{
  print "error";
}

}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; PREPARATION
##################################

CALL PREPARE();

##################################
# SECTOR; INDEX NAME
##################################

for $sPartType in "range" "hash" "list"
{
  CALL CREATE_TABLE( $sPartType, "integer", "integer" );

  # 33 byte
  create index i23456789012345678901234567890123 on t1(i3, i1);
  # 34 byte
  create index i234567890123456789012345678901234 on t1(i2, i1);
  # 35 byte
  create index i2345678901234567890123456789012345 on t1(i1);
  # 36 byte
  create index i23456789012345678901234567890123456 on t1(i2);
  # 37 byte
  create index i234567890123456789012345678901234567 on t1(i3);
  # 38 byte
  create index i2345678901234567890123456789012345678 on t1(i1, i2);
  # 39 byte
  create index i23456789012345678901234567890123456789 on t1(i2, i3);
  # 40 byte
  create index i234567890123456789012345678901234567890 on t1(i1, i3);
  # 41 byte
  create index i2345678901234567890123456789012345678901 on t1(i1, i2, i3);

  desc t1;
}

##################################
# SECTOR; INDEX NAME
##################################

for $sPartType in "range" "hash" "list"
{
  CALL CREATE_TABLE( $sPartType, "integer", "integer" );

  # 33 byte
  create index i23456789012345678901234567890123 on t1(i3, i1) local;
  # 34 byte
  create index i234567890123456789012345678901234 on t1(i2, i1) local;
  # 35 byte
  create index i2345678901234567890123456789012345 on t1(i1) local;
  # 36 byte
  create index i23456789012345678901234567890123456 on t1(i2) local;
  # 37 byte
  create index i234567890123456789012345678901234567 on t1(i3) local;
  # 38 byte
  create index i2345678901234567890123456789012345678 on t1(i1, i2) local;
  # 39 byte
  create index i23456789012345678901234567890123456789 on t1(i2, i3) local;
  # 40 byte
  create index i234567890123456789012345678901234567890 on t1(i1, i3) local;
  # 41 byte
  create index i2345678901234567890123456789012345678901 on t1(i1, i2, i3) local;

  desc t1;
}

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();
}
