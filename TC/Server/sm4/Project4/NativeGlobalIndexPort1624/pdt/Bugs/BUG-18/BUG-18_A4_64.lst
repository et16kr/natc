$P0> CREATE TABLE T1
     (
         I1 INTEGER, 
         I2 INTEGER
     ) 
     PARTITION BY RANGE( I1 ) 
     ( 
         PARTITION P1 VALUES DEFAULT 
     ) TABLESPACE SYS_TBS_DISK_DATA;
Create success.

$P0> CREATE INDEX T1_IDX1 ON T1(I1 ASC);
Create success.

$P0> CREATE INDEX T1_IDX2 ON T1(I1 DESC) INDEXTYPE IS BTREE;
Create success.

