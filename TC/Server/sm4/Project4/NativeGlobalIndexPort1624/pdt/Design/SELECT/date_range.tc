###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/PROJ-1624-QC/PDT/Design/SELECT/date_range.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../../../include/globalIndexEnv.i;

########################################################
## SELECT RANGE PARTITIOIN ( PK:DATE, INDEX:PREFIXED )
########################################################

#####################################
##SECTOR; INTIALIZE
#####################################

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

SKIP BEGIN;
DROP TABLE PDT_RANGE;
SKIP END;

###########################################
##+SECTOR; DO JOB #1 (1. Basic Test)
###########################################

CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') ),
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );

INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

## should be ['2007-3-30']
SELECT F1 FROM PDT_RANGE PARTITION( P1 );
## should be ['2007-4-10']
SELECT F1 FROM PDT_RANGE PARTITION( P2 );
## should be ['2007-4-20']
SELECT F1 FROM PDT_RANGE PARTITION( P3 );
## should be ['2007-4-30']
SELECT F1 FROM PDT_RANGE PARTITION( P4 );

## should be 4
SELECT COUNT(*) FROM PDT_RANGE;

## should be ['2007-3-30', '2007-4-10', '2007-4-20', '2007-4-30']
SELECT F1 FROM PDT_RANGE;


###########################################
##+SECTOR; DO JOB #2 (2. Validation Test)
###########################################

DROP TABLE PDT_RANGE;
CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') ),
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );

INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

## should be fail
SELECT COUNT(*) FROM PDT_RANGE PARTITION( P5 );


###########################################
##+SECTOR; DO JOB #3 (3. Execution Test)
###########################################

####################################-
## 3.1 Partition Ordering
####################################-
DROP TABLE PDT_RANGE;
CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT,
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') )
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );

INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

## should be ['2007-3-30']
SELECT F1 FROM PDT_RANGE PARTITION( P1 );
## should be ['2007-4-10']
SELECT F1 FROM PDT_RANGE PARTITION( P2 );
## should be ['2007-4-20']
SELECT F1 FROM PDT_RANGE PARTITION( P3 );
## should be ['2007-4-30']
SELECT F1 FROM PDT_RANGE PARTITION( P4 );

##########################################
## 3.2 Static Partition Pruning ( System )
##########################################
DROP TABLE PDT_RANGE;
CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') ),
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );

INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=1;

## less than 
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 < TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 < TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 < TO_DATE('2007-4-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 < TO_DATE('2007-5-10', 'YYYY-MM-DD');
## equal than 
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 = TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 = TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 = TO_DATE('2007-4-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 = TO_DATE('2007-5-10', 'YYYY-MM-DD');
## greater than 
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 > TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 > TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 > TO_DATE('2007-4-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 > TO_DATE('2007-5-10', 'YYYY-MM-DD');
## less equal than 
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 <= TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 <= TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 <= TO_DATE('2007-4-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 <= TO_DATE('2007-5-10', 'YYYY-MM-DD');
## greater equal than 
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 >= TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 >= TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 >= TO_DATE('2007-4-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 >= TO_DATE('2007-5-10', 'YYYY-MM-DD');
## not equal
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 != TO_DATE('2007-4-10', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 != TO_DATE('2007-4-20', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 != TO_DATE('2007-4-30', 'YYYY-MM-DD');
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 != TO_DATE('2007-5-10', 'YYYY-MM-DD');
ALTER SESSION SET EXPLAIN PLAN = OFF;

##########################################
## 3.3 Static Partition Pruning ( User )
##########################################
DROP TABLE PDT_RANGE;
CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') ),
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );

INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

## please check plan
ALTER SESSION SET EXPLAIN PLAN = ON;
## no need execution
SELECT COUNT(*) FROM PDT_RANGE PARTITION( P1 ) WHERE F1 >= TO_DATE('2007-4-10', 'YYYY-MM-DD');
ALTER SESSION SET EXPLAIN PLAN = OFF;

####################################-
## 3.4 Partition filtering
####################################-
DROP TABLE PDT_RANGE;
CREATE TABLE PDT_RANGE
(
    F1   DATE,
    F2   INTEGER
) 
PARTITION BY RANGE( F1 )
(
    PARTITION P1 VALUES LESS THAN ( TO_DATE('2007-4-10', 'YYYY-MM-DD') ),
    PARTITION P2 VALUES LESS THAN ( TO_DATE('2007-4-20', 'YYYY-MM-DD') ),
    PARTITION P3 VALUES LESS THAN ( TO_DATE('2007-4-30', 'YYYY-MM-DD') ),
    PARTITION P4 VALUES DEFAULT
) TABLESPACE PDT_TBS;

CREATE UNIQUE INDEX PDT_RANGE_IDX ON PDT_RANGE( F1 );

INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-3-30', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-10', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-20', 'YYYY-MM-DD'), 0 );
INSERT INTO PDT_RANGE VALUES( TO_DATE('2007-4-30', 'YYYY-MM-DD'), 0 );

ALTER SESSION SET EXPLAIN PLAN = ON;
SELECT F1 FROM PDT_RANGE;
SELECT COUNT(*) FROM PDT_RANGE WHERE F2 = 0;
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 = F1;
SELECT COUNT(*) FROM PDT_RANGE WHERE F1 = F2;

ALTER SESSION SET EXPLAIN PLAN = OFF;
ALTER SESSION SET TRCLOG_DETAIL_PREDICATE=0;
#####################################
##+SECTOR; FINALIZE
#####################################

DROP TABLE PDT_RANGE;
}