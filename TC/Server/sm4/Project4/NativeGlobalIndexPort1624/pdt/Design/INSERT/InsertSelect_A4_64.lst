1 row inserted.
$T0> CREATE INDEX IDX3 ON PT_RANGE(I1, I2, I4);
Create success.


$T0> CREATE TABLE PT_LIST ( I1 INTEGER, I2 VARCHAR(1000), I3 BLOB, I4 NUMERIC(10, 5), I5 DATE )
PARTITION BY LIST(I1)
( PARTITION P1 VALUES (100, 150)
                   TABLESPACE PDT_TBS2 LOB STORE AS ( TABLESPACE PDT_TBS3 ),
  PARTITION P2 VALUES (200, 250)
                   TABLESPACE PDT_TBS3 LOB STORE AS ( TABLESPACE PDT_TBS4 ),
  PARTITION P3 VALUES (300, 350)
                   TABLESPACE PDT_TBS4 LOB STORE AS ( TABLESPACE PDT_TBS5 ),
  PARTITION P4 VALUES DEFAULT TABLESPACE PDT_TBS5
) TABLESPACE PDT_TBS;
