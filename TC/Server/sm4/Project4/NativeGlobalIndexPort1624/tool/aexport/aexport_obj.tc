###########################################################################
# TestCase Description = ported from qp4/Project3/PROJ-1624-GlobalIndex/tool/aexport/aexport_obj.tc
#
# Body below is byte-identical to the original. What this port adds is the
# premise: PIN_DISK_NATIVE() pins DISK_GLOBAL_INDEX_ENABLE = 1 and writes
# the value into the transcript, so the case states what it measures
# instead of inheriting it (F07 -- see include/globalIndexEnv.i).
#
# Project ID           = Native Global Index (disk) - PROJ-1624 port
###########################################################################
INCLUDE ../../include/globalIndexEnv.i;
INCLUDE ../../include/descIndex.i;

###########################################################################
# Set Null Test
###########################################################################

DEF FINALIZE()
{
SKIP BEGIN;
SQL BEGIN;
connect sys/manager;
drop user user1 cascade;
drop table t1;
drop table t2;
drop table t3;
SQL END;
SKIP END;
}

DEF PREPARE()
{
CALL FINALIZE();

SQL BEGIN;

connect sys/manager;

create user user1 identified by user1 default tablespace sys_tbs_disk_data;
connect user1/user1;

create table t1
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by range(i1)
(
  partition p1 values less than (20),
  partition p2 values less than (40),
  partition p3 values less than (60),
  partition p4 values less than (80),
  partition pd values default
)
tablespace sys_tbs_disk_data;

alter table t1 add constraint t1_pk primary key (i2, i1);
alter table t1 add constraint t1_uk unique (i3, i2, i1);

create index t1_idx1 on t1(i2);
create index t1_idx2 on t1(i2, i3 desc, i4);
create index t1_idx3 on t1(i3, i2 desc);

create index t1_idx4 on t1(i4 desc, i3) local;
create index t1_idx5 on t1(i4) local;

create table t2
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by hash(i1)
(
  partition p1,
  partition p2,
  partition p3,
  partition p4,
  partition pd
)
tablespace sys_tbs_disk_data;

alter table t2 add constraint t2_pk primary key (i2, i1);
alter table t2 add constraint t2_uk unique (i3, i2, i1);

create index t2_idx1 on t2(i2);
create index t2_idx2 on t2(i2, i3 desc, i4);
create index t2_idx3 on t2(i3, i2 desc);

create index t2_idx4 on t2(i4 desc, i3) local;
create index t2_idx5 on t2(i4) local;

create table t3
( 
  i1 integer,
  i2 integer, 
  i3 integer,
  i4 integer
)
partition by list(i1)
(
  partition p1 values (1,6,11,16,21,26,31,36,41,46,51,56,61,66,71,76,81,86,91,96),
  partition p2 values (2,7,12,17,22,27,32,37,42,47,52,57,62,67,72,77,82,87,92,97),
  partition p3 values (3,8,13,18,23,28,33,38,43,48,53,58,63,68,73,78,83,88,93,98),
  partition p4 values (4,9,14,19,24,29,34,39,44,49,54,59,64,69,74,79,84,89,94,99),
  partition pd values default
)
tablespace sys_tbs_disk_data;

alter table t3 add constraint t3_pk primary key (i2, i1);
alter table t3 add constraint t3_uk unique (i3, i2, i1);

create index t3_idx1 on t3(i2);
create index t3_idx2 on t3(i2, i3 desc, i4);
create index t3_idx3 on t3(i3, i2 desc);

create index t3_idx4 on t3(i4 desc, i3) local;
create index t3_idx5 on t3(i4) local;

SQL END;
}

DEF MAIN()
{
CALL PIN_DISK_NATIVE();

##################################
# SECTOR; INITIALIZE
##################################

$ALTIBASE_HOME;

MV -f "${ALTIBASE_HOME}/conf/aexport.properties" "${ALTIBASE_HOME}/conf/aexport.properties.org";
CP "aexport.properties" "${ALTIBASE_HOME}/conf/aexport.properties";

CALL PREPARE();

##################################
# SECTOR; EXPORT
##################################

EXEC PROC1 "aexport -s 127.0.0.1 -u sys -p manager -object user1.t1";
P_WAIT PROC1;

CAT "USER1_T1_CRT.sql";

EXEC PROC1 "aexport -s 127.0.0.1 -u sys -p manager -object user1.t2";
P_WAIT PROC1;

CAT "USER1_T2_CRT.sql";

EXEC PROC1 "aexport -s 127.0.0.1 -u sys -p manager -object user1.t3";
P_WAIT PROC1;

CAT "USER1_T3_CRT.sql";

##################################
# SECTOR; IMPORT
##################################

CALL FINALIZE();

connect sys/manager;

EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f USER1_T1_CRT.sql";
P_WAIT PROC1;

EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f USER1_T2_CRT.sql";
P_WAIT PROC1;

EXEC PROC1 "isql -s 127.0.0.1 -u sys -p manager -f USER1_T3_CRT.sql";
P_WAIT PROC1;

SQL BEGIN;

##########################################################################
# PORT EDIT: describe the indexes the export rebuilt, not the tables the
#            $GIT_ implementation kept them in
#
# The original asked, after the round trip:
#
#   desc t1;                  desc t2;                  desc t3;
#   desc "$GIT_T1_PK";        desc "$GIT_T2_PK";        desc "$GIT_T3_PK";
#   desc "$GIT_T1_UK";        ...                       ...
#   desc "$GIT_T1_IDX1..3";
#
# -- fifteen hidden tables. The native path builds none of them, and
# "[ERR-91014] does not exist" fifteen times is the shape of expectation
# this port refuses to record: it goes green for any reason at all, and
# six of the fifteen were ALREADY green for the wrong reason in the
# original (aexport_all_A4_64.lst has six ERR-91014, not fifteen).
#
# Those six are T1/T2/T3 _PK and _UK. Both carry the partition key I1, so
# they are LOCAL under BOTH implementations and the $GIT_ table never
# existed for them either -- the same mistake the original made in
# check_global_index.i (v3-natc-port.md 3.2) and in BUG-35460
# (v4-natc-port-2.md 5.1).
#
# So the port asks what this case is actually about: after export and
# re-import, is each index back, and is it back as the SAME KIND it was?
# DESC_INDEX (include/descIndex.i, the four-layer definition batch 5 built)
# prints the discriminator, so this block distinguishes
#
#   T1_PK / T1_UK        LOCAL          (partition key in the key)
#   T1_IDX1 / 2 / 3      NATIVE-GLOBAL  (no partition key -- the point)
#
# and it is that split, not an error message, that says the export did not
# quietly turn a global index into a local one. aexport writes LOCAL only
# for the local ones; measured in v4-natc-port-4.md 6.
#
# TEETH: with DISK_GLOBAL_INDEX_ENABLE = 0 the re-import builds T*_IDX1..3
# as hidden tables, KIND reads GIT-HIDDEN-TABLE for nine indexes and
# THIS_GIT_TABLE reads 1 instead of 0.
##########################################################################

desc t1;
CALL DESC_INDEX( "T1_PK" );
CALL DESC_INDEX( "T1_UK" );
CALL DESC_INDEX( "T1_IDX1" );
CALL DESC_INDEX( "T1_IDX2" );
CALL DESC_INDEX( "T1_IDX3" );

desc t2;
CALL DESC_INDEX( "T2_PK" );
CALL DESC_INDEX( "T2_UK" );
CALL DESC_INDEX( "T2_IDX1" );
CALL DESC_INDEX( "T2_IDX2" );
CALL DESC_INDEX( "T2_IDX3" );

desc t3;
CALL DESC_INDEX( "T3_PK" );
CALL DESC_INDEX( "T3_UK" );
CALL DESC_INDEX( "T3_IDX1" );
CALL DESC_INDEX( "T3_IDX2" );
CALL DESC_INDEX( "T3_IDX3" );
##########################################################################
# PORT EDIT END
##########################################################################

SQL END;

##################################
# SECTOR; FINALIZATION
##################################

CALL FINALIZE();

RM "ALL_*" "USER1_*" "user1_*" "run_*";
RM "${ALTIBASE_HOME}/conf/aexport.properties";
MV -f "${ALTIBASE_HOME}/conf/aexport.properties.org" "${ALTIBASE_HOME}/conf/aexport.properties";
}
