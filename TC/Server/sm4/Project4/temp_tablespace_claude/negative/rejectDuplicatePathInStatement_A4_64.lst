 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Refuse duplicated and already-registered tempfile paths inside one statement.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 6.4 path/identity safety and design 9.2/9.3 all-or-nothing multi-file
$T0> #                        publication: a refused statement leaves no partial definition and no file.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteBinding.cpp, src/sm/sdp/sdpte/sdpteCreate.cpp
$T0> #                        src/sm/sdp/sdpte/sdpteAddTempFile.cpp
$T0> #                        src/qp/qdt/qdtCreate.cpp validateDiskTemporaryTBS
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DUP_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_DUP_TWIN INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_DUP_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dup_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dup_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dup_twin.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE DISK TABLESPACE SDPTEC_DUP_DATA
        DATAFILE 'sdptec_dup_data.dbf' SIZE 4M AUTOEXTEND OFF;
Create success.

$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DUP_TS
        TEMPFILE 'sdptec_dup_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> ##################################
$T0> SECTOR 2; DUPLICATED PATH INSIDE ONE STATEMENT
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DUP_TWIN
        TEMPFILE 'sdptec_dup_twin.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dup_twin.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdptec_dup_twin.dbf )]

$T0> ALTER TABLESPACE SDPTEC_DUP_TS ADD TEMPFILE
        'sdptec_dup_02.dbf' SIZE 4M AUTOEXTEND OFF,
        'sdptec_dup_02.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdptec_dup_02.dbf )]

$T0> ##################################
$T0> SECTOR 3; ALREADY REGISTERED PATHS
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_DUP_TS ADD TEMPFILE
        'sdptec_dup_01.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-311EA : The specified file is already in use by another tablespace.]

$T0> ALTER TABLESPACE SDPTEC_DUP_TS ADD TEMPFILE
        'sdptec_dup_data.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-311EA : The specified file is already in use by another tablespace.]

$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DUP_TWIN
        TEMPFILE 'sdptec_dup_01.dbf' SIZE 4M REUSE AUTOEXTEND OFF
        EXTENTSIZE 512K;
[ERR-311EA : The specified file is already in use by another tablespace.]

$T0> ##################################
$T0> SECTOR 4; VERIFY NO PARTIAL DEFINITION
$T0> ##################################
$T0> SELECT CASE
               WHEN COUNT(*) = 0
               THEN 1 ELSE 0
           END AS PASS_TWIN_NEVER_CREATED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DUP_TWIN';
PASS_TWIN_NEVER_CREATED 
--------------------------
1           
1 row selected.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.NEXT_FILE_ID = 1
                AND F.FILE_COUNT = 1
               THEN 1 ELSE 0
           END AS PASS_TEMP_DEFINITION_UNCHANGED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DUP_TS' ) F
     WHERE T.NAME = 'SDPTEC_DUP_TS';
PASS_TEMP_DEFINITION_UNCHANGED 
---------------------------------
1           
1 row selected.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND F.FILE_COUNT = 1
                AND F.TOTAL_CURRENT = 512
               THEN 1 ELSE 0
           END AS PASS_DATA_TABLESPACE_UNCHANGED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DUP_DATA' ) F
     WHERE T.NAME = 'SDPTEC_DUP_DATA';
PASS_DATA_TABLESPACE_UNCHANGED 
---------------------------------
1           
1 row selected.

$T0> PASS_REFUSED_TWIN_FILE_ABSENT

$T0> PASS_REFUSED_ADD_FILE_ABSENT

$T0> ##################################
$T0> SECTOR 5; THE SURVIVING DEFINITION STILL ACCEPTS A VALID ADD
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_DUP_TS ADD TEMPFILE
        'sdptec_dup_02.dbf' SIZE 2M AUTOEXTEND OFF;
Alter success.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 768
                AND T.NEXT_FILE_ID = 2
               THEN 1 ELSE 0
           END AS PASS_VALID_ADD_ACCEPTED
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_DUP_TS';
PASS_VALID_ADD_ACCEPTED 
--------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 6; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DUP_TS INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_DUP_TWIN INCLUDING CONTENTS AND DATAFILES;
$T0> DROP TABLESPACE SDPTEC_DUP_DATA INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dup_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dup_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dup_twin.dbf";

