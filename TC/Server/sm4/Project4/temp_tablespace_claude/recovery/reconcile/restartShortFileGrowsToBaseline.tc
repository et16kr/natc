###########################################################################
# TestCase Description = Extend a short but identity-valid tempfile back to its committed baseline.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 8.3: a valid matching file with `P < D` is grown to `D` with a
#                        no-sync extend and re-stat, and design 11.3 gives that repair to the
#                        post-recovery reconcile rather than to the pre-recovery identify pass.
# Product Reference    = src/sm/sdp/sdpte/sdpteReconcile.cpp, src/sm/sdp/sdpte/sdpteStartup.cpp
#                        src/sm/sdd/sddDiskMgr.cpp doActIdentifyAllDBFiles TEMP defer
# Method Note          = The short file is a byte copy of the same inode taken while `D` was still
#                        4M, so its identity header matches and only its length is behind.
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_SF_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_sf_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_sf_01.short";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_SF_TS
        TEMPFILE 'sdptec_sf_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND T.TOTAL_PAGE_COUNT = 512
               THEN 1 ELSE 0
           END AS PASS_CREATE_BASELINE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SF_TS';

    # Keep a byte copy of this inode while D is still 4M.
    NODISPLAY ON;
    CALL stdServerStop();
    NODISPLAY OFF;

    CP "${ALTIBASE_HOME}/dbs/sdptec_sf_01.dbf" "${ALTIBASE_HOME}/dbs/sdptec_sf_01.short";

    NODISPLAY ON;
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

##################################
SECTOR; COMMIT A LARGER BASELINE
##################################
    ALTER TABLESPACE SDPTEC_SF_TS
        ALTER TEMPFILE 'sdptec_sf_01.dbf' SIZE 12M;

    SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 1536
                AND T.TOTAL_PAGE_COUNT = 1536
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 23
               THEN 1 ELSE 0
           END AS PASS_COMMITTED_GROW
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SF_TS';

##################################
SECTOR; RESTART OVER A SHORT VALID FILE
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    NODISPLAY OFF;

    # Put the 4M image back at the registered path. The identity header is the
    # same inode's, so the file is valid and only its length is behind D.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_sf_01.dbf";
    CP "${ALTIBASE_HOME}/dbs/sdptec_sf_01.short" "${ALTIBASE_HOME}/dbs/sdptec_sf_01.dbf";

    NODISPLAY ON;
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 1536
                AND D.AUTOEXTEND = 0
                AND D.OPENED = 0
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 23
               THEN 1 ELSE 0
           END AS PASS_SHORT_FILE_GROWN_TO_D
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SF_TS';

##################################
SECTOR; THE REPAIR IS IDEMPOTENT
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.CURRSIZE = 1536
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_REPAIR_IDEMPOTENT
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SF_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_SF_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_sf_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_sf_01.short";
}
