###########################################################################
# TestCase Description = Keep a discarded USER TEMP definition cache-null across repeated restarts.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.11: a DISCARDED TEMP is never identified, recreated, opened or
#                        published again, its public projection stays the standard `sum(D)` with a
#                        zero allocated count, and only DROP TABLESPACE is accepted.
# Product Reference    = src/sm/sdp/sdpte/sdpteCacheNull.cpp, src/sm/sdp/sdpte/sdpteBoot.cpp
#                        src/sm/sdd/sddDiskMgr.cpp doActIdentifyAllDBFiles TEMP branch
#                        src/sm/sdp/sdpTableSpace.cpp doActFreeSpaceCache cache-null teardown
# Admin Manual         = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Administrator's Manual.md
# ATAF Process Ref     = TC/Server/sm4/Project4/temp_tablespace/control/discardLifecycle.tc
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DS_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_DS_TS
        TEMPFILE 'sdptec_ds_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_ds_02.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    NODISPLAY ON;
    CALL stdServerStop();
    NODISPLAY OFF;

##################################
SECTOR; CONTROL DISCARD
##################################
    $sPrompt = "$$EOF$$";

    NODISPLAY ON;
    EXEC SDPTEC_DS_CONTROL -t 1800 $gStdIsqlSys;
    SEND SDPTEC_DS_CONTROL "startup control";
    P_WAIT SDPTEC_DS_CONTROL $sPrompt;
    SEND SDPTEC_DS_CONTROL "ALTER TABLESPACE SDPTEC_DS_TS DISCARD;";
    P_WAIT SDPTEC_DS_CONTROL $sPrompt;
    SEND SDPTEC_DS_CONTROL "quit";
    P_WAIT SDPTEC_DS_CONTROL;
    NODISPLAY OFF;

    # A discarded definition has no startup binding, so removing one of its
    # files must not affect the next startup at all.
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf";

    NODISPLAY ON;
    EXEC SDPTEC_DS_SERVICE -t 1800 $gStdIsqlSys;
    SEND SDPTEC_DS_SERVICE "ALTER DATABASE MYDB SERVICE;";
    P_WAIT SDPTEC_DS_SERVICE $sPrompt;
    SEND SDPTEC_DS_SERVICE "quit";
    P_WAIT SDPTEC_DS_SERVICE;
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

##################################
SECTOR; CACHE NULL PROJECTION
##################################
    SELECT CASE
               WHEN T.STATE = 1024
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 0
                AND F.TOTAL_CURRENT = 1536
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DISCARDED_PROJECTION
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DS_TS' ) F
     WHERE T.NAME = 'SDPTEC_DS_TS';

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf" )
    {
        PRINT "FAIL_DISCARDED_FILE_RECREATED";
    }
    ELSE
    {
        PRINT "PASS_DISCARDED_FILE_NOT_RECREATED";
    }

##################################
SECTOR; DISCARDED STATE IS DURABLE
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.STATE = 1024
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DISCARDED_AFTER_RESTART
      FROM V$TABLESPACES T,
           ( SELECT SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DS_TS' ) F
     WHERE T.NAME = 'SDPTEC_DS_TS';

##################################
SECTOR; ONLY DROP IS ACCEPTED
##################################
    ALTER TABLESPACE SDPTEC_DS_TS
        ALTER TEMPFILE 'sdptec_ds_01.dbf' SIZE 4M;

    ALTER TABLESPACE SDPTEC_DS_TS ADD TEMPFILE
        'sdptec_ds_03.dbf' SIZE 4M AUTOEXTEND OFF;

    ALTER TABLESPACE SDPTEC_DS_TS
        DROP TEMPFILE 'sdptec_ds_02.dbf';

    SELECT CASE
               WHEN T.STATE = 1024
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
               THEN 1 ELSE 0
           END AS PASS_DISCARDED_DDL_REFUSED
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_DS_TS';

    DROP TABLESPACE SDPTEC_DS_TS INCLUDING CONTENTS AND DATAFILES;

    SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_DISCARDED_DROP_ACCEPTED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DS_TS';

    IF ( FEXIST "${ALTIBASE_HOME}/dbs/sdptec_ds_01.dbf" )
    {
        PRINT "FAIL_DISCARDED_DROP_LEFT_FILE";
    }
    ELSE
    {
        PRINT "PASS_DISCARDED_DROP_UNLINKED_FILE";
    }

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DS_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_03.dbf";
}
