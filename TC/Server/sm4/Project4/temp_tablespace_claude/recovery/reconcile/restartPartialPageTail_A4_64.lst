 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Exclude a sub-page physical tail from the published TEMP capacity.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 6.1 and 8.3: only complete pages count as `P`, a sub-page tail is a
$T0> #                        diagnostic value that startup must neither publish nor truncate away.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteFile.cpp physical page accounting
$T0> #                        src/sm/sdp/sdpte/sdpteReconcile.cpp startup size reconcile
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_TL_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_tl_01.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTEC_TL_TS
        TEMPFILE 'sdptec_tl_01.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND T.TOTAL_PAGE_COUNT = 512
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 7
               THEN 1 ELSE 0
           END AS PASS_CREATE_BASELINE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';
PASS_CREATE_BASELINE 
-----------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 2; APPEND A SUB PAGE TAIL
$T0> ##################################

$T0> # Fewer bytes than one disk page, so the file length is no longer a whole
$T0> # number of pages.
$T0> OPEN SDPTEC_TL_APPEND -m a "${ALTIBASE_HOME}/dbs/sdptec_tl_01.dbf";
$T0> WRITE SDPTEC_TL_APPEND "SDPTEC-PARTIAL-PAGE-TAIL";
$T0> CLOSE SDPTEC_TL_APPEND;


$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SELECT CASE
               WHEN D.INITSIZE = 512
                AND D.CURRSIZE = 512
                AND D.OPENED = 0
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 7
               THEN 1 ELSE 0
           END AS PASS_TAIL_NOT_PUBLISHED
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';
PASS_TAIL_NOT_PUBLISHED 
--------------------------
1           
1 row selected.

$T0> # The tail must not stop ordinary DDL either.
$T0> ALTER TABLESPACE SDPTEC_TL_TS
        ALTER TEMPFILE 'sdptec_tl_01.dbf' SIZE 8M;
Alter success.

$T0> SELECT CASE
               WHEN D.CURRSIZE = 1024
                AND T.TOTAL_PAGE_COUNT = 1024
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 15
               THEN 1 ELSE 0
           END AS PASS_RESIZE_OVER_TAIL
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';
PASS_RESIZE_OVER_TAIL 
------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; RESTART AFTER THE AUTHORIZED RESIZE
$T0> ##################################

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SELECT CASE
               WHEN D.CURRSIZE = 1024
                AND D.OPENED = 0
                AND T.TOTAL_PAGE_COUNT = 1024
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 15
               THEN 1 ELSE 0
           END AS PASS_RESTART_AFTER_RESIZE
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_TL_TS';
PASS_RESTART_AFTER_RESIZE 
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_TL_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_tl_01.dbf";

