 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Keep a discarded USER TEMP definition cache-null across repeated restarts.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 9.11: a DISCARDED TEMP is never identified, recreated, opened or
$T0> #                        published again, its public projection stays the standard `sum(D)` with a
$T0> #                        zero allocated count, and only DROP TABLESPACE is accepted.
$T0> # Product Reference    = src/sm/sdp/sdpte/sdpteCacheNull.cpp, src/sm/sdp/sdpte/sdpteBoot.cpp
$T0> #                        src/sm/sdd/sddDiskMgr.cpp doActIdentifyAllDBFiles TEMP branch
$T0> #                        src/sm/sdp/sdpTableSpace.cpp doActFreeSpaceCache cache-null teardown
$T0> # Admin Manual         = /home/et16/work/manual/Manuals/Altibase_7.1/eng/Administrator's Manual.md
$T0> # ATAF Process Ref     = TC/Server/sm4/Project4/temp_tablespace/control/discardLifecycle.tc
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DS_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DS_TS
        TEMPFILE 'sdptec_ds_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_ds_02.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.


$T0> ##################################
$T0> SECTOR 2; CONTROL DISCARD
$T0> ##################################


$T0> # A discarded definition has no startup binding, so removing one of its
$T0> # files must not affect the next startup at all.
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf";


$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> ##################################
$T0> SECTOR 3; CACHE NULL PROJECTION
$T0> ##################################
$T0> SELECT CASE
               WHEN T.STATE = 1024
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND ( SELECT X.CACHED_FREE_EXTENT_COUNT
                        FROM X$TABLESPACES X
                       WHERE X.ID = T.ID ) = 0
                AND F.TOTAL_CURRENT = 1536
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DISCARDED_PROJECTION
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DS_TS' ) F
     WHERE T.NAME = 'SDPTEC_DS_TS';
PASS_DISCARDED_PROJECTION 
----------------------------
1           
1 row selected.

$T0> PASS_DISCARDED_FILE_NOT_RECREATED

$T0> ##################################
$T0> SECTOR 4; DISCARDED STATE IS DURABLE
$T0> ##################################

$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SELECT CASE
               WHEN T.STATE = 1024
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_DISCARDED_AFTER_RESTART
      FROM V$TABLESPACES T,
           ( SELECT SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DS_TS' ) F
     WHERE T.NAME = 'SDPTEC_DS_TS';
PASS_DISCARDED_AFTER_RESTART 
-------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 5; ONLY DROP IS ACCEPTED
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_DS_TS
        ALTER TEMPFILE 'sdptec_ds_01.dbf' SIZE 4M;
[ERR-110FC : Unable to use a discarded tablespace. (NAME=SDPTEC_DS_TS)]

$T0> ALTER TABLESPACE SDPTEC_DS_TS ADD TEMPFILE
        'sdptec_ds_03.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-110FC : Unable to use a discarded tablespace. (NAME=SDPTEC_DS_TS)]

$T0> ALTER TABLESPACE SDPTEC_DS_TS
        DROP TEMPFILE 'sdptec_ds_02.dbf';
[ERR-110FC : Unable to use a discarded tablespace. (NAME=SDPTEC_DS_TS)]

$T0> SELECT CASE
               WHEN T.STATE = 1024
                AND T.DATAFILE_COUNT = 2
                AND T.TOTAL_PAGE_COUNT = 1536
               THEN 1 ELSE 0
           END AS PASS_DISCARDED_DDL_REFUSED
      FROM V$TABLESPACES T
     WHERE T.NAME = 'SDPTEC_DS_TS';
PASS_DISCARDED_DDL_REFUSED 
-----------------------------
1           
1 row selected.

$T0> DROP TABLESPACE SDPTEC_DS_TS INCLUDING CONTENTS AND DATAFILES;
Drop success.

$T0> SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS PASS_DISCARDED_DROP_ACCEPTED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DS_TS';
PASS_DISCARDED_DROP_ACCEPTED 
-------------------------------
1           
1 row selected.

$T0> PASS_DISCARDED_DROP_UNLINKED_FILE

$T0> ##################################
$T0> SECTOR 6; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DS_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_ds_03.dbf";

