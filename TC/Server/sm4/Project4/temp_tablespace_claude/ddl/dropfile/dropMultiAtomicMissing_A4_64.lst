 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Refuse a multi-file DROP TEMPFILE whose second target does not exist.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 9.4 statement boundary, one-target-set validation before mutation.
$T0> # Product Reference    = src/qp/qdt/qdtAlter.cpp qdtAlter::executeDropFile
$T0> #                        src/sm/smi/smiTableSpace.cpp smiTableSpace::removeDataFiles
$T0> #                        src/sm/sdp/sdpTableSpace.cpp sdpTableSpace::removeDataFiles
$T0> #                        src/sm/sdp/sdpte/sdpteDropTempFile.cpp sdpteDropTempFileValidateTargets
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DM_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_03.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DM_TS
        TEMPFILE 'sdptec_dm_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dm_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dm_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> ##################################
$T0> SECTOR 2; REJECT THE WHOLE TARGET SET
$T0> ##################################
$T0> # The first target is valid and the second is not registered. The single
$T0> # statement must publish no definition at all, not the first target alone.
$T0> ALTER TABLESPACE SDPTEC_DM_TS
        DROP TEMPFILE 'sdptec_dm_02.dbf', 'sdptec_dm_absent.dbf';
[ERR-1113D : Data file not found  '/home/et16/work/altidev4/altibase_home/dbs/sdptec_dm_absent.dbf'.]

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
               THEN 1 ELSE 0
           END AS PASS_MISSING_TARGET_KEPT_ALL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DM_TS' ) F
     WHERE T.NAME = 'SDPTEC_DM_TS';
PASS_MISSING_TARGET_KEPT_ALL 
-------------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; ACCEPT THE WHOLE TARGET SET
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_DM_TS
        DROP TEMPFILE 'sdptec_dm_02.dbf', 'sdptec_dm_03.dbf';
Alter success.

$T0> SELECT CASE
               WHEN T.DATAFILE_COUNT = 1
                AND T.TOTAL_PAGE_COUNT = 1024
                AND F.FILE_COUNT = 1
                AND F.TOTAL_CURRENT = 1024
                AND F.PRIMARY_ID = 0
               THEN 1 ELSE 0
           END AS PASS_MULTI_DROP_COMMITTED
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    MIN(D.ID) AS PRIMARY_ID
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DM_TS' ) F
     WHERE T.NAME = 'SDPTEC_DM_TS';
PASS_MULTI_DROP_COMMITTED 
----------------------------
1           
1 row selected.

$T0> # Design 9.4: an ordinary DROP TEMPFILE leaves the physical file behind.
$T0> PASS_DROPPED_FILE_02_PRESERVED

$T0> PASS_DROPPED_FILE_03_PRESERVED

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DM_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dm_03.dbf";

