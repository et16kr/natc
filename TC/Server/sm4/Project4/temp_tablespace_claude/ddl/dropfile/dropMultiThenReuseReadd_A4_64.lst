 
+----------------------------------------------------------------------+
SECTOR 0; BY ATC
+----------------------------------------------------------------------+
 
$T0> THREAD T0 C0;


$T0> ###########################################################################
$T0> # TestCase Description = Re-adopt both files of a committed multi-file DROP TEMPFILE with REUSE.
$T0> # Project ID           = workspace/simple_temp_tablespace
$T0> # Design Coverage      = design 9.4 file preservation, design 3.4 monotonic file IDs,
$T0> #                        design 15.1 total is recomputed from the live file set.
$T0> # Product Reference    = src/sm/sdp/sdpTableSpace.cpp sdpTableSpace::removeDataFiles
$T0> #                        src/sm/sdp/sdpte/sdpteAddTempFile.cpp
$T0> #                        src/sm/sct/sctFT.cpp sctFT::getDiskTBSInfo TEMP total projection
$T0> # SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
$T0> ###########################################################################

$T0> ##################################
$T0> SECTOR 0; INITIALIZATION
$T0> ##################################
$T0> CONNECT SYS/MANAGER;
Connect success.

$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DR_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_03.dbf";

$T0> ##################################
$T0> SECTOR 1; PREPARATION
$T0> ##################################
$T0> CREATE TEMPORARY TABLESPACE SDPTEC_DR_TS
        TEMPFILE 'sdptec_dr_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dr_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dr_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;
Create success.

$T0> SELECT CASE
               WHEN NEXT_FILE_ID = 3
                AND DATAFILE_COUNT = 3
                AND TOTAL_PAGE_COUNT = 2048
               THEN 1 ELSE 0
           END AS PASS_CREATE_BASELINE
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DR_TS';
PASS_CREATE_BASELINE 
-----------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 2; DROP THE SECONDARY FILE SET
$T0> ##################################
$T0> ALTER TABLESPACE SDPTEC_DR_TS
        DROP TEMPFILE 'sdptec_dr_02.dbf', 'sdptec_dr_03.dbf';
Alter success.

$T0> # DROP retires the two file IDs. Design 3.4 forbids reusing them, so the
$T0> # next file ID must not move back down to 1.
$T0> SELECT CASE
               WHEN NEXT_FILE_ID = 3
                AND DATAFILE_COUNT = 1
                AND TOTAL_PAGE_COUNT = 1024
               THEN 1 ELSE 0
           END AS PASS_DROP_KEEPS_ID_CURSOR
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DR_TS';
PASS_DROP_KEEPS_ID_CURSOR 
----------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 3; RE-ADOPT BOTH PRESERVED FILES
$T0> ##################################
$T0> # The preserved inodes carry the identity of their retired file IDs, so a
$T0> # non-REUSE ADD must refuse them.
$T0> ALTER TABLESPACE SDPTEC_DR_TS ADD TEMPFILE
        'sdptec_dr_02.dbf' SIZE 4M AUTOEXTEND OFF;
[ERR-11034 : Data file node not found ( /home/et16/work/altidev4/altibase_home/dbs/sdptec_dr_02.dbf )]

$T0> SELECT CASE
               WHEN DATAFILE_COUNT = 1
                AND NEXT_FILE_ID = 3
               THEN 1 ELSE 0
           END AS PASS_NON_REUSE_ADD_REFUSED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DR_TS';
PASS_NON_REUSE_ADD_REFUSED 
-----------------------------
1           
1 row selected.

$T0> ALTER TABLESPACE SDPTEC_DR_TS ADD TEMPFILE
        'sdptec_dr_02.dbf' SIZE 4M REUSE AUTOEXTEND OFF,
        'sdptec_dr_03.dbf' SIZE 4M REUSE AUTOEXTEND OFF;
Alter success.

$T0> SELECT CASE
               WHEN T.NEXT_FILE_ID = 5
                AND T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
                AND F.ID_SUM = 7
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
               THEN 1 ELSE 0
           END AS PASS_REUSE_READD_AND_TOTAL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(D.ID) AS ID_SUM
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DR_TS' ) F
     WHERE T.NAME = 'SDPTEC_DR_TS';
PASS_REUSE_READD_AND_TOTAL 
-----------------------------
1           
1 row selected.

$T0> ##################################
$T0> SECTOR 4; FINALIZATION
$T0> ##################################
$T0> SKIP BEGIN;
$T0> DROP TABLESPACE SDPTEC_DR_TS INCLUDING CONTENTS AND DATAFILES;
$T0> SKIP END;

$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_01.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_02.dbf";
$T0> RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_03.dbf";

