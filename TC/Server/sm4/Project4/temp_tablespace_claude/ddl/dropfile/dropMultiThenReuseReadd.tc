###########################################################################
# TestCase Description = Re-adopt both files of a committed multi-file DROP TEMPFILE with REUSE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.4 file preservation, design 3.4 monotonic file IDs,
#                        design 15.1 total is recomputed from the live file set.
# Product Reference    = src/sm/sdp/sdpTableSpace.cpp sdpTableSpace::removeDataFiles
#                        src/sm/sdp/sdpte/sdpteAddTempFile.cpp
#                        src/sm/sct/sctFT.cpp sctFT::getDiskTBSInfo TEMP total projection
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DR_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_DR_TS
        TEMPFILE 'sdptec_dr_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_dr_02.dbf' SIZE 4M AUTOEXTEND OFF,
                 'sdptec_dr_03.dbf' SIZE 4M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    SELECT CASE
               WHEN NEXT_FILE_ID = 3
                AND DATAFILE_COUNT = 3
                AND TOTAL_PAGE_COUNT = 2048
               THEN 1 ELSE 0
           END AS PASS_CREATE_BASELINE
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DR_TS';

##################################
SECTOR; DROP THE SECONDARY FILE SET
##################################
    ALTER TABLESPACE SDPTEC_DR_TS
        DROP TEMPFILE 'sdptec_dr_02.dbf', 'sdptec_dr_03.dbf';

    # DROP retires the two file IDs. Design 3.4 forbids reusing them, so the
    # next file ID must not move back down to 1.
    SELECT CASE
               WHEN NEXT_FILE_ID = 3
                AND DATAFILE_COUNT = 1
                AND TOTAL_PAGE_COUNT = 1024
               THEN 1 ELSE 0
           END AS PASS_DROP_KEEPS_ID_CURSOR
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DR_TS';

##################################
SECTOR; RE-ADOPT BOTH PRESERVED FILES
##################################
    # The preserved inodes carry the identity of their retired file IDs, so a
    # non-REUSE ADD must refuse them.
    ALTER TABLESPACE SDPTEC_DR_TS ADD TEMPFILE
        'sdptec_dr_02.dbf' SIZE 4M AUTOEXTEND OFF;

    SELECT CASE
               WHEN DATAFILE_COUNT = 1
                AND NEXT_FILE_ID = 3
               THEN 1 ELSE 0
           END AS PASS_NON_REUSE_ADD_REFUSED
      FROM V$TABLESPACES
     WHERE NAME = 'SDPTEC_DR_TS';

    ALTER TABLESPACE SDPTEC_DR_TS ADD TEMPFILE
        'sdptec_dr_02.dbf' SIZE 4M REUSE AUTOEXTEND OFF,
        'sdptec_dr_03.dbf' SIZE 4M REUSE AUTOEXTEND OFF;

    SELECT CASE
               WHEN T.NEXT_FILE_ID = 5
                AND T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 2048
                AND F.FILE_COUNT = 3
                AND F.TOTAL_CURRENT = 2048
                AND F.ID_SUM = 7
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
               THEN 1 ELSE 0
           END AS PASS_REUSE_READD_AND_TOTAL
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(D.ID) AS ID_SUM
               FROM V$TABLESPACES T2,
                    V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_DR_TS' ) F
     WHERE T.NAME = 'SDPTEC_DR_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_DR_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_dr_03.dbf";
}
