###########################################################################
# TestCase Description = Keep configured AUTOEXTEND ON after the runtime current reaches MAXSIZE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 8.1: runtime AT_MAX is derived state and must never be materialized
#                        as configured OFF, not by a later unrelated DDL and not by a restart.
# Product Reference    = src/sm/sdp/sdpte/sdpteView.cpp public projection uses the configured triple
#                        src/sm/sdd/sddDiskFT.cpp buildFT4DATAFILES TEMP branch
#                        src/sm/sdp/sdpte/sdpteAutoExtend.cpp runtime extension
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTEC_AM_U CASCADE;
    DROP TABLESPACE SDPTEC_AM_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_AM_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_AM_DATA
        DATAFILE 'sdptec_am_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTEC_AM_TS
        TEMPFILE 'sdptec_am_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 4M
        EXTENTSIZE 512K;

    CREATE USER SDPTEC_AM_U IDENTIFIED BY SDPTEC_AM_U
        DEFAULT TABLESPACE SDPTEC_AM_DATA
        TEMPORARY TABLESPACE SDPTEC_AM_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

    CONNECT SDPTEC_AM_U/SDPTEC_AM_U;

    CREATE TABLE SDPTEC_AM_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_AM_DATA;

    INSERT INTO SDPTEC_AM_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('M', 1790, 'M')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

##################################
SECTOR; DRIVE THE RUNTIME TO THE CONFIGURED MAX
##################################
    # The 4M cap cannot hold this spill. The statement outcome is not the
    # subject of this case; the configured metadata it leaves behind is.
    SKIP BEGIN;
    SELECT COUNT(*) AS SPILL_ROWS
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_AM_SOURCE
           ) D;
    SKIP END;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 512
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 512
                AND T.TOTAL_PAGE_COUNT = 512
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_AT_MAX_KEEPS_CONFIGURED_ON
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_AM_TS';

##################################
SECTOR; UNRELATED DDL MUST NOT MATERIALIZE AT_MAX
##################################
    ALTER TABLESPACE SDPTEC_AM_TS UNCOMPRESSED LOGGING;

    SELECT CASE
               WHEN T.ATTR_LOG_COMPRESS = 0
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 512
                AND D.CURRSIZE = 512
               THEN 1 ELSE 0
           END AS PASS_LOGGING_DDL_KEEPS_CONFIGURED
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_AM_TS';

##################################
SECTOR; RESTART RECOMPUTES EFFECTIVE STATE FROM R
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.INITSIZE = 128
                AND D.CURRSIZE = 512
                AND D.AUTOEXTEND = 1
                AND D.NEXTSIZE = 128
                AND D.MAXSIZE = 512
                AND D.OPENED = 0
                AND T.ATTR_LOG_COMPRESS = 0
                AND T.TOTAL_PAGE_COUNT = 512
               THEN 1 ELSE 0
           END AS PASS_RESTART_KEEPS_CONFIGURED_ON
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_AM_TS';

##################################
SECTOR; GROWTH RESUMES ONCE MAXSIZE IS RAISED
##################################
    ALTER TABLESPACE SDPTEC_AM_TS
        ALTER TEMPFILE 'sdptec_am_01.dbf'
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M;

    SELECT CASE
               WHEN D.AUTOEXTEND = 1
                AND D.MAXSIZE = 16384
                AND D.CURRSIZE = 512
               THEN 1 ELSE 0
           END AS PASS_RAISED_MAX_KEEPS_R
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_AM_TS';

    CONNECT SDPTEC_AM_U/SDPTEC_AM_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SPILL_AFTER_RAISED_MAX
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_AM_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN D.CURRSIZE > 512
                AND D.AUTOEXTEND = 1
                AND T.TOTAL_PAGE_COUNT = D.CURRSIZE
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_RUNTIME_RESUMED
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_AM_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTEC_AM_U CASCADE;
    DROP TABLESPACE SDPTEC_AM_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_AM_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
