###########################################################################
# TestCase Description = Keep every sibling tempfile untouched by a same-size ALTER TEMPFILE SIZE.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.6 row `T == B == R` success no-op with no WAL record, and the
#                        design 15.1 rule that the tablespace total stays `sum(R)` of the file set.
# Product Reference    = src/sm/sdp/sdpte/sdpteAlterSize.cpp same-size early return
#                        src/sm/sct/sctFT.cpp sctFT::getDiskTBSInfo TEMP total projection
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_NP_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_np_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_np_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_np_03.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_NP_TS
        TEMPFILE 'sdptec_np_01.dbf' SIZE 8M AUTOEXTEND OFF,
                 'sdptec_np_02.dbf' SIZE 4M
                     AUTOEXTEND ON NEXT 1M MAXSIZE 32M,
                 'sdptec_np_03.dbf' SIZE 2M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 1792
                AND F.TOTAL_CURRENT = 1792
               THEN 1 ELSE 0
           END AS PASS_CREATE_BASELINE
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_NP_TS' ) F
     WHERE T.NAME = 'SDPTEC_NP_TS';

##################################
SECTOR; REPEATED SAME SIZE STATEMENTS
##################################
    ALTER TABLESPACE SDPTEC_NP_TS
        ALTER TEMPFILE 'sdptec_np_02.dbf' SIZE 4M;

    ALTER TABLESPACE SDPTEC_NP_TS
        ALTER TEMPFILE 'sdptec_np_02.dbf' SIZE 4M;

    SELECT CASE
               WHEN COUNT(*) = 3
                AND SUM(CASE WHEN D.NAME LIKE '%sdptec_np_01.dbf'
                              AND D.INITSIZE = 1024 AND D.CURRSIZE = 1024
                              AND D.AUTOEXTEND = 0
                             THEN 1 ELSE 0 END) = 1
                AND SUM(CASE WHEN D.NAME LIKE '%sdptec_np_02.dbf'
                              AND D.INITSIZE = 512 AND D.CURRSIZE = 512
                              AND D.AUTOEXTEND = 1 AND D.NEXTSIZE = 128
                              AND D.MAXSIZE = 4096
                             THEN 1 ELSE 0 END) = 1
                AND SUM(CASE WHEN D.NAME LIKE '%sdptec_np_03.dbf'
                              AND D.INITSIZE = 256 AND D.CURRSIZE = 256
                              AND D.AUTOEXTEND = 0
                             THEN 1 ELSE 0 END) = 1
               THEN 1 ELSE 0
           END AS PASS_NOOP_KEEPS_SIBLINGS
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_NP_TS';

##################################
SECTOR; RESTART SHOWS NO DEFINITION DRIFT
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.DATAFILE_COUNT = 3
                AND T.TOTAL_PAGE_COUNT = 1792
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND F.TOTAL_CURRENT = 1792
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_NOOP_NO_DRIFT_AFTER_RESTART
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SDPTEC_NP_TS' ) F
     WHERE T.NAME = 'SDPTEC_NP_TS';

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_NP_TS INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_np_01.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_np_02.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_np_03.dbf";
}
