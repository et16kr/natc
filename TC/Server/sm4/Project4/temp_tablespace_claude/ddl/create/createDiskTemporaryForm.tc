###########################################################################
# TestCase Description = Produce one TEMP catalog from both CREATE TEMPORARY TABLESPACE spellings.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 2.3 keeps the whole existing CREATE surface, and design 4.1 routes
#                        both parser branches to the same single owner, so the two forms must be
#                        indistinguishable in the catalog and in the runtime projection.
# Product Reference    = src/qp/qcp/qcply.y create_temp_tablespace_statement (both branches)
#                        src/sm/sdp/sdpTableSpace.cpp createTBS TEMP dispatch
# SQL Manual           = /home/et16/work/manual/Manuals/Altibase_7.1/eng/SQL Reference.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_FM_PLAIN INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_FM_DISK INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_fm_plain.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_fm_disk.dbf";

##################################
SECTOR; PREPARATION
##################################
    CREATE TEMPORARY TABLESPACE SDPTEC_FM_PLAIN
        TEMPFILE 'sdptec_fm_plain.dbf' SIZE 4M
            AUTOEXTEND ON NEXT 1M MAXSIZE 32M
        EXTENTSIZE 512K
        SEGMENT MANAGEMENT MANUAL;

    CREATE DISK TEMPORARY TABLESPACE SDPTEC_FM_DISK
        TEMPFILE 'sdptec_fm_disk.dbf' SIZE 4M
            AUTOEXTEND ON NEXT 1M MAXSIZE 32M
        EXTENTSIZE 512K
        SEGMENT MANAGEMENT MANUAL;

##################################
SECTOR; THE TWO CATALOG ROWS MUST MATCH
##################################
    SELECT CASE
               WHEN COUNT(*) = 2
                AND COUNT(DISTINCT TYPE) = 1
                AND COUNT(DISTINCT STATE) = 1
                AND COUNT(DISTINCT EXTENT_MANAGEMENT) = 1
                AND COUNT(DISTINCT SEGMENT_MANAGEMENT) = 1
                AND COUNT(DISTINCT EXTENT_PAGE_COUNT) = 1
                AND COUNT(DISTINCT PAGE_SIZE) = 1
                AND COUNT(DISTINCT TOTAL_PAGE_COUNT) = 1
                AND COUNT(DISTINCT ALLOCATED_PAGE_COUNT) = 1
                AND COUNT(DISTINCT NEXT_FILE_ID) = 1
                AND COUNT(DISTINCT ATTR_LOG_COMPRESS) = 1
                AND MIN(TYPE) = 6
                AND MIN(SEGMENT_MANAGEMENT) = 'MANUAL'
                AND MIN(TOTAL_PAGE_COUNT) = 512
               THEN 1 ELSE 0
           END AS PASS_BOTH_FORMS_SAME_CATALOG
      FROM V$TABLESPACES
     WHERE NAME IN ( 'SDPTEC_FM_PLAIN', 'SDPTEC_FM_DISK' );

    SELECT CASE
               WHEN COUNT(*) = 2
                AND COUNT(DISTINCT X.CACHED_FREE_EXTENT_COUNT) = 1
                AND MIN(X.CACHED_FREE_EXTENT_COUNT) = 7
               THEN 1 ELSE 0
           END AS PASS_BOTH_FORMS_SAME_RUNTIME
      FROM V$TABLESPACES T, X$TABLESPACES X
     WHERE T.ID = X.ID
       AND T.NAME IN ( 'SDPTEC_FM_PLAIN', 'SDPTEC_FM_DISK' );

    SELECT CASE
               WHEN COUNT(*) = 2
                AND COUNT(DISTINCT D.INITSIZE) = 1
                AND COUNT(DISTINCT D.CURRSIZE) = 1
                AND COUNT(DISTINCT D.NEXTSIZE) = 1
                AND COUNT(DISTINCT D.MAXSIZE) = 1
                AND COUNT(DISTINCT D.AUTOEXTEND) = 1
                AND COUNT(DISTINCT D.OPENED) = 1
                AND MIN(D.CURRSIZE) = 512
                AND MIN(D.NEXTSIZE) = 128
                AND MIN(D.MAXSIZE) = 4096
                AND MIN(D.AUTOEXTEND) = 1
               THEN 1 ELSE 0
           END AS PASS_BOTH_FORMS_SAME_FILE_ROW
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME IN ( 'SDPTEC_FM_PLAIN', 'SDPTEC_FM_DISK' );

##################################
SECTOR; BOTH SURVIVE A RESTART IDENTICALLY
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 2
                AND COUNT(DISTINCT TOTAL_PAGE_COUNT) = 1
                AND SUM(ALLOCATED_PAGE_COUNT) = 0
               THEN 1 ELSE 0
           END AS PASS_BOTH_FORMS_AFTER_RESTART
      FROM V$TABLESPACES
     WHERE NAME IN ( 'SDPTEC_FM_PLAIN', 'SDPTEC_FM_DISK' );

##################################
SECTOR; FINALIZATION
##################################
    SKIP BEGIN;
    DROP TABLESPACE SDPTEC_FM_PLAIN INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_FM_DISK INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

    RM -f "${ALTIBASE_HOME}/dbs/sdptec_fm_plain.dbf";
    RM -f "${ALTIBASE_HOME}/dbs/sdptec_fm_disk.dbf";
}
