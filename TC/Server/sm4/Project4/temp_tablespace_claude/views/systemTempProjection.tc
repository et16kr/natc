###########################################################################
# TestCase Description = Project the bootstrapped SYSTEM TEMP tablespace through the same TEMP owner.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 9.2 last bullet: the database-creation SYSTEM TEMP bootstrap uses the
#                        same definition lane, so `SYS_TBS_DISK_TEMP` gets an ordinary published
#                        runtime, an `sum(R)` total and a zero allocated count like any USER TEMP.
# Product Reference    = src/sm/sdp/sdpTableSpace.cpp createTBS TEMP dispatch
#                        src/sm/smi/smiMain.cpp sdpteBoot::reconcileAfterRecovery
#                        src/sm/sct/sctFT.cpp SYSTEM TEMP branch of getDiskTBSInfo
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTEC_ST_U CASCADE;
    DROP TABLESPACE SDPTEC_ST_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_ST_DATA
        DATAFILE 'sdptec_st_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    # No TEMPORARY TABLESPACE clause, so this user spills into SYSTEM TEMP.
    CREATE USER SDPTEC_ST_U IDENTIFIED BY SDPTEC_ST_U
        DEFAULT TABLESPACE SDPTEC_ST_DATA;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

##################################
SECTOR; SYSTEM TEMP CATALOG SHAPE
##################################
    SELECT CASE
               WHEN T.TYPE = 5
                AND T.STATE = 2
                AND T.EXTENT_MANAGEMENT = 'BITMAP'
                AND T.PAGE_SIZE = 8192
                AND T.EXTENT_PAGE_COUNT > 0
                AND T.DATAFILE_COUNT >= 1
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND F.SENTINEL_SUM = 0
               THEN 1 ELSE 0
           END AS PASS_SYSTEM_TEMP_PROJECTION
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(D.SM_VERSION + D.CREATE_LSN_FILENO
                        + D.CREATE_LSN_OFFSET + D.OLDEST_LSN_FILENO
                        + D.OLDEST_LSN_OFFSET) AS SENTINEL_SUM
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SYS_TBS_DISK_TEMP' ) F
     WHERE T.NAME = 'SYS_TBS_DISK_TEMP';

##################################
SECTOR; SYSTEM TEMP SERVES A REAL SPILL
##################################
    CONNECT SDPTEC_ST_U/SDPTEC_ST_U;

    CREATE TABLE SDPTEC_ST_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_ST_DATA;

    INSERT INTO SDPTEC_ST_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('T', 1790, 'T')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SYSTEM_TEMP_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_ST_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND T.ALLOCATED_PAGE_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_SYSTEM_TEMP_RUNTIME_CLEAN
      FROM V$TABLESPACES T,
           ( SELECT SUM(D.CURRSIZE) AS TOTAL_CURRENT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SYS_TBS_DISK_TEMP' ) F
     WHERE T.NAME = 'SYS_TBS_DISK_TEMP';

##################################
SECTOR; RESTART REBUILDS SYSTEM TEMP
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN T.TYPE = 5
                AND T.STATE = 2
                AND T.ALLOCATED_PAGE_COUNT = 0
                AND T.TOTAL_PAGE_COUNT = F.TOTAL_CURRENT
                AND F.OPENED_COUNT = 0
               THEN 1 ELSE 0
           END AS PASS_SYSTEM_TEMP_AFTER_RESTART
      FROM V$TABLESPACES T,
           ( SELECT COUNT(*) AS FILE_COUNT,
                    SUM(D.CURRSIZE) AS TOTAL_CURRENT,
                    SUM(CASE WHEN D.OPENED = 1 THEN 1 ELSE 0 END) AS OPENED_COUNT
               FROM V$TABLESPACES T2, V$DATAFILES D
              WHERE T2.ID = D.SPACEID
                AND T2.NAME = 'SYS_TBS_DISK_TEMP' ) F
     WHERE T.NAME = 'SYS_TBS_DISK_TEMP';

    CONNECT SDPTEC_ST_U/SDPTEC_ST_U;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SYSTEM_TEMP_SPILL_AFTER_RESTART
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_ST_SOURCE
           ) D;

##################################
SECTOR; FINALIZATION
##################################
    CONNECT SYS/MANAGER;
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTEC_ST_U CASCADE;
    DROP TABLESPACE SDPTEC_ST_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
