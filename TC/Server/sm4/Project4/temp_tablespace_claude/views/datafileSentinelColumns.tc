###########################################################################
# TestCase Description = Keep the recovery and version columns of a TEMP file at their zero sentinel.
# Project ID           = workspace/simple_temp_tablespace
# Design Coverage      = design 15.1 and A-16: `sdpte` never synthesizes an LSN it does not own and
#                        never borrows a DATA/UNDO value, so a TEMP row keeps the zero sentinel the
#                        standard node was initialized with, before and after runtime I/O.
# Product Reference    = src/sm/sdd/sddDiskFT.cpp buildFT4DATAFILES TEMP branch
#                        src/sm/sdd/sddDataFile.cpp sddDataFile::initialize
#                        src/sm/sdd/sddDiskMgr.cpp doActIdentifyAllDBFiles TEMP identify skip
# View Manual          = /home/et16/work/manual/Manuals/Altibase_7.1/eng/General Reference-2.The Data Dictionary.md
###########################################################################
INCLUDE stdFunc.i;

DEF MAIN()
{
##################################
SECTOR; INITIALIZATION
##################################
    CONNECT SYS/MANAGER;

    SKIP BEGIN;
    DROP USER SDPTEC_SC_U CASCADE;
    DROP TABLESPACE SDPTEC_SC_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_SC_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;

##################################
SECTOR; PREPARATION
##################################
    CREATE DISK TABLESPACE SDPTEC_SC_DATA
        DATAFILE 'sdptec_sc_data.dbf' SIZE 8M
            AUTOEXTEND ON NEXT 8M MAXSIZE 256M;

    CREATE TEMPORARY TABLESPACE SDPTEC_SC_TS
        TEMPFILE 'sdptec_sc_01.dbf' SIZE 1M
            AUTOEXTEND ON NEXT 1M MAXSIZE 128M,
                 'sdptec_sc_02.dbf' SIZE 1M AUTOEXTEND OFF
        EXTENTSIZE 512K;

    CREATE USER SDPTEC_SC_U IDENTIFIED BY SDPTEC_SC_U
        DEFAULT TABLESPACE SDPTEC_SC_DATA
        TEMPORARY TABLESPACE SDPTEC_SC_TS;

    ALTER SYSTEM SET HASH_AREA_SIZE = 3145728;

##################################
SECTOR; SENTINELS BEFORE ANY RUNTIME I/O
##################################
    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(D.OLDEST_LSN_FILENO) = 0
                AND SUM(D.OLDEST_LSN_OFFSET) = 0
                AND SUM(D.CREATE_LSN_FILENO) = 0
                AND SUM(D.CREATE_LSN_OFFSET) = 0
                AND SUM(D.SM_VERSION) = 0
                AND SUM(D.OPENED) = 0
               THEN 1 ELSE 0
           END AS PASS_TEMP_ZERO_SENTINELS
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SC_TS';

    # The same columns of an ordinary DATA file are not zero, so the assertion
    # above is about the TEMP branch and not about an empty view.
    SELECT CASE
               WHEN COUNT(*) = 1
                AND MIN(D.SM_VERSION) > 0
               THEN 1 ELSE 0
           END AS PASS_DATA_VERSION_NOT_SENTINEL
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SC_DATA';

##################################
SECTOR; SENTINELS AFTER RUNTIME I/O
##################################
    CONNECT SDPTEC_SC_U/SDPTEC_SC_U;

    CREATE TABLE SDPTEC_SC_SOURCE ( ID INTEGER, K1 VARCHAR(2000) )
        TABLESPACE SDPTEC_SC_DATA;

    INSERT INTO SDPTEC_SC_SOURCE
    SELECT LEVEL,
           'K' || LPAD(TO_CHAR(LEVEL), 8, '0') || RPAD('C', 1790, 'C')
      FROM DUAL
    CONNECT BY LEVEL <= 30000;
    COMMIT;

    SELECT CASE WHEN COUNT(*) = 30000 THEN 1 ELSE 0 END AS PASS_SENTINEL_SPILL
      FROM (
            SELECT /*+ TEMP_TBS_DISK DISTINCT_HASH */ DISTINCT K1
              FROM SDPTEC_SC_SOURCE
           ) D;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(D.OLDEST_LSN_FILENO) = 0
                AND SUM(D.OLDEST_LSN_OFFSET) = 0
                AND SUM(D.CREATE_LSN_FILENO) = 0
                AND SUM(D.CREATE_LSN_OFFSET) = 0
                AND SUM(D.SM_VERSION) = 0
               THEN 1 ELSE 0
           END AS PASS_SENTINELS_AFTER_SPILL
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SC_TS';

    # A checkpoint must not promote a TEMP body page or a TEMP header LSN.
    ALTER SYSTEM CHECKPOINT;

    SELECT CASE
               WHEN SUM(D.OLDEST_LSN_FILENO) = 0
                AND SUM(D.OLDEST_LSN_OFFSET) = 0
                AND SUM(D.SM_VERSION) = 0
               THEN 1 ELSE 0
           END AS PASS_SENTINELS_AFTER_CHECKPOINT
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SC_TS';

##################################
SECTOR; SENTINELS AFTER RESTART
##################################
    NODISPLAY ON;
    CALL stdServerStop();
    CALL stdServerStart();
    NODISPLAY OFF;

    CONNECT SYS/MANAGER;

    SELECT CASE
               WHEN COUNT(*) = 2
                AND SUM(D.OLDEST_LSN_FILENO) = 0
                AND SUM(D.OLDEST_LSN_OFFSET) = 0
                AND SUM(D.CREATE_LSN_FILENO) = 0
                AND SUM(D.CREATE_LSN_OFFSET) = 0
                AND SUM(D.SM_VERSION) = 0
                AND SUM(D.OPENED) = 0
               THEN 1 ELSE 0
           END AS PASS_SENTINELS_AFTER_RESTART
      FROM V$TABLESPACES T, V$DATAFILES D
     WHERE T.ID = D.SPACEID
       AND T.NAME = 'SDPTEC_SC_TS';

##################################
SECTOR; FINALIZATION
##################################
    ALTER SYSTEM SET HASH_AREA_SIZE = 4194304;

    SKIP BEGIN;
    DROP USER SDPTEC_SC_U CASCADE;
    DROP TABLESPACE SDPTEC_SC_TS INCLUDING CONTENTS AND DATAFILES;
    DROP TABLESPACE SDPTEC_SC_DATA INCLUDING CONTENTS AND DATAFILES;
    SKIP END;
}
